&НаКлиенте
Процедура СгенерироватьOTP(Команда)
	
	Если ПустаяСтрока(СекретныйКлюч) Тогда
		ПоказатьПредупреждение(, "Введіть секретний ключ (TOTP_SECRET)!");
		Возврат;
	КонецЕсли;
	
	// Генеруємо TOTP
	OTPКод = СгенерироватьTOTPНаСервере(СекретныйКлюч);
	
	// Получаем диагностическую информацию
	ДиагностикаИнфо = ПолучитьДиагностикуВремени();
	
	ПоказатьОповещениеПользователя(
		"TOTP код згенеровано",
		,
		"Ваш OTP код: " + OTPКод,
		БиблиотекаКартинок.Информация
	);
	
	// Выводим диагностику в сообщение
	Сообщить("=== ДІАГНОСТИКА ===");
	Сообщить("Unix час (секунди): " + ДиагностикаИнфо.UnixВремя);
	Сообщить("Часовий крок (epoch/30): " + ДиагностикаИнфо.ВременнойШаг);
	Сообщить("Поточний UTC час: " + ДиагностикаИнфо.ТекущаяДатаUTC);
	Сообщить("Base32 байти (перші 10): " + ДиагностикаBase32(СекретныйКлюч));
	Сообщить("OTP код: " + OTPКод);
	
	// Додатково копіюємо в буфер обміну (якщо потрібно)
	// ПоместитьВБуферОбмена(OTPКод);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ТестSHA1()
	
	// Тест 1: SHA1("abc") повинен бути A9993E364706816ABA3E25717850C26C9CD0D89D
	ТестовыеБайты = Новый Массив;
	ТестовыеБайты.Добавить(97);  // 'a'
	ТестовыеБайты.Добавить(98);  // 'b'
	ТестовыеБайты.Добавить(99);  // 'c'
	
	ДвоичныеДанные = МассивБайтовВДвоичныеДанные(ТестовыеБайты);
	
	// Перевіряємо що HEX правильний
	HexВхід = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные);
	Сообщить("ТЕСТ SHA1: вхід HEX = " + HexВхід + " (очікується 616263)");
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(ДвоичныеДанные);
	ХешДвоичныеДанные = Хеширование.ХешСумма;
	
	HexРезультат = ПолучитьHexСтрокуИзДвоичныхДанных(ХешДвоичныеДанные);
	Сообщить("ТЕСТ SHA1: результат = " + HexРезультат);
	Сообщить("ТЕСТ SHA1: очікується = A9993E364706816ABA3E25717850C26C9CD0D89D");
	
	// Тест 2: Перевірка конкретного HEX який відрізнявся
	Сообщить("--- ТЕСТ 2: Фіксований HEX ---");
	ФіксHex = "535053540F0E52555703010102020F010F53040350500604520E5252000302013636363636363636363636363636363636363636363636363636363636363636000000000383280D";
	ДвДані2 = ПолучитьДвоичныеДанныеИзHexСтроки(ФіксHex);
	
	Хеш2 = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеш2.Добавить(ДвДані2);
	Результат2 = ПолучитьHexСтрокуИзДвоичныхДанных(Хеш2.ХешСумма);
	
	Сообщить("ТЕСТ 2: SHA1 результат = " + Результат2);
	Сообщить("ТЕСТ 2: JS очікує     = A415D313F9273B795BFD1A5830E8E11EAB924310");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДиагностикуВремени()
	
	ТекущаяДатаUTC = ТекущаяУниверсальнаяДата();
	UnixВремя = ТекущаяДатаUTC - Дата(1970, 1, 1, 0, 0, 0);
	ВременнойШаг = Цел(UnixВремя / 30);
	
	Результат = Новый Структура;
	Результат.Вставить("UnixВремя", UnixВремя);
	Результат.Вставить("ВременнойШаг", ВременнойШаг);
	Результат.Вставить("ТекущаяДатаUTC", ТекущаяДатаUTC);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДиагностикаBase32(СекретныйКлюч)
	
	КлючБайты = Base32Декодировать(СокрЛП(СекретныйКлюч));
	
	// Перші 10 байтів для порівняння
	СтрокаБайтов = "";
	Для Индекс = 0 По Мин(9, КлючБайты.Количество() - 1) Цикл
		Если Индекс > 0 Тогда
			СтрокаБайтов = СтрокаБайтов + ", ";
		КонецЕсли;
		СтрокаБайтов = СтрокаБайтов + Строка(КлючБайты[Индекс]);
	КонецЦикла;
	
	Возврат СтрокаБайтов;
	
КонецФункции

&НаСервереБезКонтекста
Функция СгенерироватьTOTPНаСервере(СекретныйКлюч)
	
	// Декодируем Base32 в массив байтов
	КлючБайты = Base32Декодировать(СокрЛП(СекретныйКлюч));
	
	// Получаем текущий временной шаг (30 секунд)
	// В 1С разница дат возвращает секунды
	ТекущаяДатаUTC = ТекущаяУниверсальнаяДата();
	UnixВремя = ТекущаяДатаUTC - Дата(1970, 1, 1, 0, 0, 0);
	ВременнойШаг = Цел(UnixВремя / 30);
	
	// Конвертируем временной шаг в 8-байтовый массив (Big Endian)
	ВремяБайты = ЧислоВБайты8(ВременнойШаг);
	
	// DEBUG: Выводим время байты
	СтрВремяБайты = "";
	Для Индекс = 0 По 7 Цикл
		Если Индекс > 0 Тогда СтрВремяБайты = СтрВремяБайты + ", "; КонецЕсли;
		СтрВремяБайты = СтрВремяБайты + Строка(ВремяБайты[Индекс]);
	КонецЦикла;
	Сообщить("DEBUG ВремяБайты: " + СтрВремяБайты);
	
	// Вычисляем HMAC-SHA1
	HMAC = ВычислитьHMAC_SHA1(КлючБайты, ВремяБайты);
	
	// DEBUG: Выводим HMAC
	СтрHMAC = "";
	Для Индекс = 0 По HMAC.Количество() - 1 Цикл
		Если Индекс > 0 Тогда СтрHMAC = СтрHMAC + ", "; КонецЕсли;
		СтрHMAC = СтрHMAC + Строка(HMAC[Индекс]);
	КонецЦикла;
	Сообщить("DEBUG HMAC (все 20 байт): " + СтрHMAC);
	
	// Извлекаем TOTP из HMAC
	Смещение = ПобитовоеИ(HMAC[19], 15);
	
	Двоичное = ПобитовоеИли(
		ПобитовыйСдвигВлево(ПобитовоеИ(HMAC[Смещение], 127), 24),
		ПобитовоеИли(
			ПобитовыйСдвигВлево(HMAC[Смещение + 1], 16),
			ПобитовоеИли(
				ПобитовыйСдвигВлево(HMAC[Смещение + 2], 8),
				HMAC[Смещение + 3]
			)
		)
	);
	
	OTP = Двоичное % 1000000;
	
	Возврат Формат(OTP, "ЧЦ=6; ЧВН=; ЧГ=0");
	
КонецФункции

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция Base32Декодировать(Base32Строка)
	
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
	ОчищеннаяСтрока = ВРег(СтрЗаменить(Base32Строка, " ", ""));
	
	Биты = "";
	Для Позиция = 1 По СтрДлина(ОчищеннаяСтрока) Цикл
		Символ = Сред(ОчищеннаяСтрока, Позиция, 1);
		Индекс = СтрНайти(Алфавит, Символ) - 1;
		Если Индекс < 0 Тогда
			Продолжить;
		КонецЕсли;
		Биты = Биты + ЧислоВДвоичнуюСтроку(Индекс, 5);
	КонецЦикла;
	
	Байты = Новый Массив;
	Для Позиция = 1 По СтрДлина(Биты) - 7 Цикл
		Если (Позиция - 1) % 8 = 0 Тогда
			ОктетСтрока = Сред(Биты, Позиция, 8);
			Если СтрДлина(ОктетСтрока) = 8 Тогда
				Байты.Добавить(ДвоичнаяСтрокаВЧисло(ОктетСтрока));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Байты;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоВДвоичнуюСтроку(Число, Длина)
	
	Результат = "";
	ТекущееЧисло = Число;
	
	Для Счетчик = 1 По Длина Цикл
		Результат = Строка(ТекущееЧисло % 2) + Результат;
		ТекущееЧисло = Цел(ТекущееЧисло / 2);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ДвоичнаяСтрокаВЧисло(ДвоичнаяСтрока)
	
	Результат = 0;
	
	Для Позиция = 1 По СтрДлина(ДвоичнаяСтрока) Цикл
		Результат = Результат * 2 + Число(Сред(ДвоичнаяСтрока, Позиция, 1));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЧислоВБайты8(Число)
	
	// Создаем массив и заполняем нулями
	Байты = Новый Массив;
	Для Счетчик = 1 По 8 Цикл
		Байты.Добавить(0);
	КонецЦикла;
	
	ТекущееЧисло = Число;
	
	// В 1С цикл "Для...По" работает только вперед, поэтому используем обратный отсчет вручную
	Для ОбратныйСчетчик = 0 По 7 Цикл
		Индекс = 7 - ОбратныйСчетчик;
		Байты[Индекс] = ПобитовоеИ(ТекущееЧисло, 255);
		ТекущееЧисло = Цел(ТекущееЧисло / 256);
	КонецЦикла;
	
	Возврат Байты;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВычислитьHMAC_SHA1(Ключ, Сообщение)
	
	РазмерБлока = 64;
	КлючПодготовленный = Новый Массив;
	
	Если Ключ.Количество() > РазмерБлока Тогда
		КлючПодготовленный = SHA1(Ключ);
	Иначе
		Для Каждого Байт Из Ключ Цикл
			КлючПодготовленный.Добавить(Байт);
		КонецЦикла;
	КонецЕсли;
	
	Пока КлючПодготовленный.Количество() < РазмерБлока Цикл
		КлючПодготовленный.Добавить(0);
	КонецЦикла;
	
	ipad = Новый Массив;
	opad = Новый Массив;
	
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		ipad.Добавить(ПобитовоеИсключительноеИли(КлючПодготовленный[Индекс], 54));
		opad.Добавить(ПобитовоеИсключительноеИли(КлючПодготовленный[Индекс], 92));
	КонецЦикла;
	
	ВнутренниеДанные = Новый Массив;
	Для Каждого Байт Из ipad Цикл
		ВнутренниеДанные.Добавить(Байт);
	КонецЦикла;
	Для Каждого Байт Из Сообщение Цикл
		ВнутренниеДанные.Добавить(Байт);
	КонецЦикла;
	
	ВнутреннийХеш = SHA1(ВнутренниеДанные);
	
	ВнешниеДанные = Новый Массив;
	Для Каждого Байт Из opad Цикл
		ВнешниеДанные.Добавить(Байт);
	КонецЦикла;
	Для Каждого Байт Из ВнутреннийХеш Цикл
		ВнешниеДанные.Добавить(Байт);
	КонецЦикла;
	
	Возврат SHA1(ВнешниеДанные);
	
КонецФункции

&НаСервереБезКонтекста
Функция SHA1(МассивБайтов)
	
	ДвоичныеДанные = МассивБайтовВДвоичныеДанные(МассивБайтов);
	
	// DEBUG: Проверяем HEX представление
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные);
	Сообщить("DEBUG SHA1 вход ПОЛНЫЙ HEX: " + HexСтрока);
	Сообщить("DEBUG SHA1 вход размер байт: " + МассивБайтов.Количество());
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(ДвоичныеДанные);
	ХешДвоичныеДанные = Хеширование.ХешСумма;
	
	// DEBUG: Результат хеша
	HexХеш = ПолучитьHexСтрокуИзДвоичныхДанных(ХешДвоичныеДанные);
	Сообщить("DEBUG SHA1 результат HEX: " + HexХеш);
	
	Возврат ДвоичныеДанныеВМассивБайтов(ХешДвоичныеДанные);
	
КонецФункции

&НаСервереБезКонтекста
Функция МассивБайтовВДвоичныеДанные(МассивБайтов)
	
	// Конвертируем массив байтов в HEX-строку
	HexСтрока = "";
	Для Индекс = 0 По МассивБайтов.Количество() - 1 Цикл
		ЭлементМассива = МассивБайтов[Индекс];
		Если ЭлементМассива = Неопределено Тогда
			Байт = 0;
		ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("Число") Тогда
			Байт = ЭлементМассива;
		Иначе
			Байт = 0;
		КонецЕсли;
		HexБайт = ПолучитьHexСимвол(Цел(Байт / 16)) + ПолучитьHexСимвол(Байт % 16);
		HexСтрока = HexСтрока + HexБайт;
	КонецЦикла;
	
	// Используем встроенную функцию для преобразования HEX в двоичные данные
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(HexСтрока);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДвоичныеДанныеВМассивБайтов(ДвоичныеДанные)
	
	// Преобразуем двоичные данные в HEX-строку
	HexСтрока = ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные);
	
	МассивБайтов = Новый Массив;
	
	// Разбираем HEX-строку по 2 символа (1 байт)
	Для Позиция = 1 По СтрДлина(HexСтрока) Цикл
		Если (Позиция - 1) % 2 = 0 Тогда
			HexБайт = Сред(HexСтрока, Позиция, 2);
			МассивБайтов.Добавить(HexВЧисло(HexБайт));
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивБайтов;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьHexСимвол(Число)
	
	HexСимволы = "0123456789ABCDEF";
	Возврат Сред(HexСимволы, Число + 1, 1);
	
КонецФункции

&НаСервереБезКонтекста
Функция HexВЧисло(HexСтрока)
	
	HexСимволы = "0123456789ABCDEF";
	Результат = 0;
	
	Для Позиция = 1 По СтрДлина(HexСтрока) Цикл
		Символ = ВРег(Сред(HexСтрока, Позиция, 1));
		Значение = СтрНайти(HexСимволы, Символ) - 1;
		Результат = Результат * 16 + Значение;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
