# Вендорські конфігурації (truth: vendor) ігноруються ЯВНИМИ рядками під фактичні шляхи з v8project.yaml —
# їх дописує v8storagekit:onboarding, наприклад:
#   SMP_BankExchange_SMB/cf/src/**
# Загального **/cf/** тут немає навмисно: у клієнтському репозиторії cf/src під truth: storage лежить у git.

# Робочі каталоги
build/
.build/

# Локальні перевизначення з підключеннями й логінами: накладка kit і накладка Уніки.
# Глоб — перший рядок і саме він несе гарантію: дослівних імен було досить рівно доти, доки
# накладок дві. Будь-який третій *.local.yaml (свій, Унічин, майбутній) інакше пройшов би повз
# і поїхав у публічний репозиторій разом із рядком підключення (знахідка пілота 2026-09-10).
# Два імені нижче лишені навмисно — як документація того, що саме тут очікується.
*.local.yaml
v8storagekit.local.yaml
v8project.local.yaml

# Стан редактора
.vscode/

# Побічні файли платформи
ConfigDumpInfo.xml
DumpFilesIndex.txt

# Базові конфігурації вендора (truth: vendor) — фактичні шляхи з v8project.yaml.
# Це код вендора, ліцензія не дозволяє його комітити, а репозиторій публічний.
# cf/README.md НЕ ігнорується (правило на cf/src/**, не на cf/**) і лишається в git.
SMP_BankExchange_SMB/cf/src/**
SMP_BankExchange_ACC/cf/src/**
SMP_BankExchange_SMBru/cf/src/**

# Зібрані .epf: артефакт, що відтворюється kit build, у git не тримаємо
# (рішення 2026-09-10). Сам kit кладе артефакти в build/artifacts, покритий вище;
# dist/ — конвенція цього репозиторію зі спадку 0.6.0.
dist/

# Робоча тека superpowers
.superpowers/
