// Дублер внешней обработки-читателя для тестов платформы (план 03, задача 5).
// Выполняет контракт читателя (docs/architecture/reader-contract.md), а поведением управляют
// экспортные переменные ниже, чтобы не плодить обработки. Синтетика: ни одного обращения к
// объектам конфигурации и реальных данных.

// Описание читателя: значения полей, которые тест может испортить.
Перем ВерсияКонтракта Экспорт;
Перем Кодировка Экспорт;

// Что вернет Прочитать: Массив из Структура (НомерСчета, Сумма - необязательная, по умолчанию 100).
Перем Строки Экспорт;

// Исключение в Прочитать: если не пусто, его текст бросается как исключение.
Перем ТекстИсключения Экспорт;

// Порча конверта после чтения: "Версия" - читатель меняет ВерсияКонтракта конверта.
Перем ПорчаКонверта Экспорт;

// Наблюдения теста: сколько раз вызвали Прочитать и что платформа передала в параметрах.
Перем ВызововПрочитать Экспорт;
Перем ПереданныйНомерСчета Экспорт;
Перем ПереданнаяКодировка Экспорт;

#Область ПрограммныйИнтерфейс

Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ТестЧитатель");
	Описание.Вставить("ВерсияКонтракта", ВерсияКонтракта);
	Описание.Вставить("Наименование", "Тестовый читатель");
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", Кодировка);
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	ВызововПрочитать = ВызововПрочитать + 1;
	ПереданныйНомерСчета = Параметры.НомерСчета;
	ПереданнаяКодировка = Параметры.Кодировка;

	// Читатель, упавший посередине, мог успеть поставить ЧтениеПолное: платформа не должна ему верить.
	Выписка.ЧтениеПолное = Истина;

	Если Не ПустаяСтрока(ТекстИсключения) Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	Номер = 0;
	Для Каждого Описание Из Строки Цикл
		Номер = Номер + 1;
		Операция = Выписка.Операции.Добавить();
		Операция.ПорядковыйНомер = Номер;
		Операция.НомерСчета = Описание.НомерСчета;
		Операция.ДатаОперации = Дата(2024, 1, 2, 3, 4, 5);
		Операция.ДатаДокумента = Дата(2024, 1, 2);
		Операция.Сумма = ?(Описание.Свойство("Сумма"), Описание.Сумма, 100);
		Операция.Направление = "Поступило";
		Операция.НазначениеПлатежа = "Строка " + Номер;
	КонецЦикла;

	Выписка.НачалоПериода = Дата(2024, 1, 1);
	Выписка.КонецПериода = Дата(2024, 1, 31);

	Если ПорчаКонверта = "Версия" Тогда
		Выписка.ВерсияКонтракта = 99;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Инициализация

ВерсияКонтракта = 1;
Кодировка = "windows-1251";
Строки = Новый Массив;
ТекстИсключения = "";
ПорчаКонверта = "";
ВызововПрочитать = 0;
ПереданныйНомерСчета = Неопределено;
ПереданнаяКодировка = Неопределено;

#КонецОбласти
