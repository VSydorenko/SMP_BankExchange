// Дублер конектора API для тестов платформы (план 05а, задача 3).
//
// Выполняет контракт читателя (docs/architecture/reader-contract.md), как конектор: Данные -
// Неопределено, в Параметры приходят период, УчетныеДанные и Транспорт. Поведением управляет
// экспортная переменная Режим, чтобы не плодить обработки. Дублер живет в тестовом расширении:
// в продуктовом реестре конекторов строк-дублеров нет, а точка чтения принимает объект конектора
// значением (СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора), как для внешних читателей.
// Синтетика: ни одного обращения к объектам конфигурации и реальных данных.

// Поведение: "" - обычное чтение; "Исключение" - исключение сразу; "ИсключениеПослеОперации" - строки
// и сообщение уже записаны, потом исключение; "ПодменаВыписки" - присваивает параметру другую
// структуру; "КлассОтказа" - ставит КлассОтказа = ЗначениеКласса (и, если ПолноеЧтение, ЧтениеПолное);
// "ТокенВТексте" - сообщение и исключение с токеном; "ЗапросыЧерезТранспорт" - ходит по Адреса через
// Параметры.Транспорт (каждый обмен - GET), после первого делает паузу 60 с.
Перем Режим Экспорт;

// Что вернет Прочитать: Массив из Структура (НомерСчета, Сумма - необязательная, по умолчанию 100).
Перем Строки Экспорт;

// Текст исключения (режимы с исключением).
Перем ТекстИсключения Экспорт;

// Значение КлассОтказа (режим "КлассОтказа").
Перем ЗначениеКласса Экспорт;

// ЧтениеПолное, которое дублер ставит в режимах чтения (по умолчанию Истина).
Перем ПолноеЧтение Экспорт;

// ГраницаДоверия, которую дублер ставит (если заполнена).
Перем ГраницаКоннектора Экспорт;

// Адреса для режима "ЗапросыЧерезТранспорт".
Перем Адреса Экспорт;

// Токен, который дублер подставляет в заголовок запроса и (режим "ТокенВТексте") в текст.
Перем ТокенДляТекста Экспорт;

// Наблюдения теста: что платформа передала в параметрах.
Перем ВызововПрочитать Экспорт;
Перем ПереданныеДанные Экспорт;
Перем ПереданныеПараметры Экспорт;
Перем СтатусыОтветов Экспорт;
Перем МоментПослеЗапросов Экспорт;

#Область ПрограммныйИнтерфейс

Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ТестКоннектор");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", "Тестовый конектор");
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "");
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	ВызововПрочитать = ?(ВызововПрочитать = Неопределено, 0, ВызововПрочитать) + 1;
	ПереданныеДанные = Данные;
	ПереданныеПараметры = Новый Структура;
	Для Каждого Элемент Из Параметры Цикл
		ПереданныеПараметры.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Если Режим = "Исключение" Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	Если Режим = "ПодменаВыписки" Тогда
		Подмена = Новый Структура;
		Для Каждого Элемент Из Выписка Цикл
			Значение = Элемент.Значение;
			Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
				Значение = Значение.СкопироватьКолонки();
			КонецЕсли;
			Подмена.Вставить(Элемент.Ключ, Значение);
		КонецЦикла;
		Выписка = Подмена;
		Возврат;
	КонецЕсли;

	Если Режим = "ЗапросыЧерезТранспорт" Тогда
		ЧитатьЧерезТранспорт(Параметры);
		Выписка.ЧтениеПолное = Истина;
		Возврат;
	КонецЕсли;

	ДобавитьСтрокиОпераций(Выписка);
	Выписка.НачалоПериода = Параметры.НачалоПериода;
	Выписка.КонецПериода = Параметры.КонецПериода;

	Если ЗначениеЗаполнено(ГраницаКоннектора) Тогда
		Выписка.ГраницаДоверия = ГраницаКоннектора;
	КонецЕсли;

	Если Режим = "ИсключениеПослеОперации" Тогда
		Сообщение = Выписка.Диагностика.Добавить();
		Сообщение.Уровень = "Предупреждение";
		Сообщение.ПорядковыйНомер = 0;
		Сообщение.Текст = "Сообщение до исключения";
		Выписка.ЧтениеПолное = Истина;
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	Если Режим = "ТокенВТексте" Тогда
		Сообщение = Выписка.Диагностика.Добавить();
		Сообщение.Уровень = "Предупреждение";
		Сообщение.ПорядковыйНомер = 0;
		Сообщение.Текст = "Банк ответил отказом, токен " + ТокенДляТекста + " недействителен";
		ВызватьИсключение "Сбой запроса с токеном " + ТокенДляТекста;
	КонецЕсли;

	Выписка.ЧтениеПолное = ?(ПолноеЧтение = Ложь, Ложь, Истина);

	Если Режим = "КлассОтказа" Тогда
		Выписка.КлассОтказа = ЗначениеКласса;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСтрокиОпераций(Выписка)

	Если Строки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Номер = 0;
	Для Каждого Описание Из Строки Цикл
		Номер = Номер + 1;
		Операция = Выписка.Операции.Добавить();
		Операция.ПорядковыйНомер = Номер;
		Операция.НомерСчета = Описание.НомерСчета;
		Операция.ДатаОперации = Дата(2026, 1, 15, 0, 30, 0);
		Операция.ДатаДокумента = Дата(2026, 1, 15);
		Операция.Сумма = ?(Описание.Свойство("Сумма"), Описание.Сумма, 100);
		Операция.Направление = "Поступило";
		Операция.НазначениеПлатежа = "Строка " + Номер;
		Операция.СырыеДанные = ?(Режим = "ТокенВТексте", "сырые данные с токеном " + ТокенДляТекста, "");
	КонецЦикла;

КонецПроцедуры

Процедура ЧитатьЧерезТранспорт(Параметры)

	Транспорт = Параметры.Транспорт;
	СтатусыОтветов = Новый Массив;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", ТокенДляТекста);
	Первый = Истина;
	Для Каждого Адрес Из Адреса Цикл
		Ответ = Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки);
		СтатусыОтветов.Добавить(Ответ.Статус);
		Если Первый Тогда
			Транспорт.Пауза(60);
			Первый = Ложь;
		КонецЕсли;
	КонецЦикла;
	МоментПослеЗапросов = Транспорт.ТекущийМомент();

КонецПроцедуры

#КонецОбласти
