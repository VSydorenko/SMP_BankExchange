// Обертка конектора monobank юросіб для тестів (план 05а, задача 4): читає з заданим розміром сторінки.
//
// Записи run1 зняті рекордером з іншими limit (5, 10, 500), ніж робочий ліміт конектора, а транспорт відтворення
// звіряє запит з записаним. Тому ці записи читаються через внутрішню точку читання, що приймає конектор значенням
// (СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора), а розмір сторінки задає ця обертка. Продукт кличеться лише
// через СМП_ТестыВызовПродукта (прямий виклик модуля сусіднього розширення не компілюється).

// Розмір сторінки (limit), з яким читається запис.
Перем РазмерСтраницы Экспорт;

// Стеля сторінок читання для тесту (лише менша за робочу); Неопределено - робоча стеля конектора.
Перем ПотолокСтраниц Экспорт;

#Область ПрограммныйИнтерфейс

Функция ОписаниеЧитателя() Экспорт

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_КоннекторБанкаМонобанкЮр.ОписаниеЧитателя");

КонецФункции

Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Параметры);
	Аргументы.Добавить(Выписка);
	Аргументы.Добавить(РазмерСтраницы);
	Если ПотолокСтраниц <> Неопределено Тогда
		Аргументы.Добавить(ПотолокСтраниц);
	КонецЕсли;
	СМП_ТестыВызовПродукта.ВызватьПроцедуру("СМП_КоннекторБанкаМонобанкЮр.ПрочитатьСРазмеромСтраницы", Аргументы);

КонецПроцедуры

#КонецОбласти
