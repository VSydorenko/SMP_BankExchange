// Обертка конектора monobank ФОП для тестов (план 05а, задача 5): читает с заданным порогом «полной страницы».
//
// В запросе выписки ФОП лимита нет, страницу ограничивает банк (документальная гипотеза - 500). Синтетика пагинации (D36 п. 11)
// записана на модели банка с меньшей страницей, поэтому такие записи читаются через внутреннюю точку чтения, которая принимает
// конектор значением (СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора), а порог задает эта обертка. Продукт вызывается лишь через
// СМП_ТестыВызовПродукта (прямой вызов модуля соседнего расширения не компилируется).

// Порог «полной страницы», с которым читается запись.
Перем РазмерСтраницы Экспорт;

// Стеля сторінок читання для тесту (лише менша за робочу); Неопределено - робоча стеля конектора.
Перем ПотолокСтраниц Экспорт;

#Область ПрограммныйИнтерфейс

Функция ОписаниеЧитателя() Экспорт

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_КоннекторБанкаМонобанк.ОписаниеЧитателя");

КонецФункции

Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Параметры);
	Аргументы.Добавить(Выписка);
	Аргументы.Добавить(РазмерСтраницы);
	Если ПотолокСтраниц <> Неопределено Тогда
		Аргументы.Добавить(ПотолокСтраниц);
	КонецЕсли;
	СМП_ТестыВызовПродукта.ВызватьПроцедуру("СМП_КоннекторБанкаМонобанк.ПрочитатьСРазмеромСтраницы", Аргументы);

КонецПроцедуры

#КонецОбласти
