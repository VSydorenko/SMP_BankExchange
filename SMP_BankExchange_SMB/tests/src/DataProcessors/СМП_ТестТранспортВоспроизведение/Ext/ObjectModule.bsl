// Транспорт воспроизведения записи ответов API для тестов конекторов (план 05а, задача 3, D36 п. 1).
//
// Те же экспортные методы, что у справочного транспорта продукта СМП_ТранспортHTTP: ВыполнитьЗапрос, Пауза,
// ТекущийМомент. Состояние воспроизведения живет в самом значении (экспортные переменные ниже),
// поэтому транспорт передается конектору явно как значение, а флага "тестовый режим" в продукте нет.
//
// Читает записи ровно формата tools/api-recorder/FORMAT.md, версия 1: один обмен - один JSON-текст
// ("smp-api-exchange"), порядок - порядок массива (или manifest "recording.json" по полю exchanges).
// Ничего не ждет и сети не открывает: паузы только фиксируются.
//
// Расхождение с записью (запрос вне записи, запрос не в записанном порядке, лишний запрос после
// исчерпания записи) транспорт исключением не сообщает - как и справочный, он исключений наружу не
// бросает: конектору возвращается ответ со сбоем, а расхождение копится в Расхождения. Тест обязан
// вызвать Проверить() в конце и утвердить пустой результат: так тест падает с текстом запроса, а
// остановка конектора раньше времени (невостребованный обмен) видна так же.

// Загруженные обмены в порядке воспроизведения: Массив из Структура (Метод, Хост, Путь, Запрос,
// Сценарий, ЗапущенUTC, Статус, Заголовки, Тело, Сбой).
Перем Обмены Экспорт;

// Сколько обменов уже воспроизведено.
Перем Индекс Экспорт;

// Тексты расхождений с записью (без заголовков запроса: в них учетные данные).
Перем Расхождения Экспорт;

// Паузы в секундах, в порядке вызова. Транспорт их не ждет.
Перем Паузы Экспорт;

// Воспроизведенные запросы в порядке вызова: Массив из Строка "<Метод> <Адрес>".
Перем Запросы Экспорт;

// Момент для ТекущийМомент: если задан, возвращается он плюс сумма зафиксированных пауз; если не
// задан, момент берется из записи (startedUtc следующего обмена).
Перем ЗаданныйМомент Экспорт;

#Область ПрограммныйИнтерфейс

// Загружает обмены из JSON-текстов по одному на обмен, в порядке воспроизведения.
//
// Параметры:
//  Тексты - Массив из Строка - содержимое файлов NNNN.json записи.
Процедура ЗагрузитьОбмены(Тексты) Экспорт

	Начать();
	Для Каждого Текст Из Тексты Цикл
		Обмены.Добавить(ОбменИзТекста(Текст));
	КонецЦикла;

КонецПроцедуры

// Загружает запись целиком: манифест recording.json и тексты обменов по имени файла.
//
// Параметры:
//  ТекстМанифеста - Строка - содержимое recording.json.
//  ТекстыОбменов - Соответствие - имя файла обмена (например "0001.json") -> содержимое.
Процедура ЗагрузитьЗапись(ТекстМанифеста, ТекстыОбменов) Экспорт

	Начать();
	Манифест = РазобратьJSON(ТекстМанифеста);
	Для Каждого Запись Из Манифест["exchanges"] Цикл
		ИмяФайла = Запись["file"];
		Если ТекстыОбменов[ИмяФайла] = Неопределено Тогда
			ВызватьИсключение "В записи нет файла обмена " + ИмяФайла;
		КонецЕсли;
		Обмены.Добавить(ОбменИзТекста(ТекстыОбменов[ИмяФайла]));
	КонецЦикла;

КонецПроцедуры

// Один обмен: запрос конектора сверяется со следующим записанным.
//
// Параметры:
//  Метод - Строка - HTTP-метод.
//  Адрес - Строка - полный адрес с запросом.
//  Заголовки - Соответствие - заголовки запроса; в расхождения и текст сбоя не попадают.
//  Тело - ДвоичныеДанные, Неопределено - тело запроса.
//
// Возвращаемое значение:
//  Структура - Сбой, ВидСбоя, ТекстСбоя, Статус, Заголовки (Соответствие, имена малыми), Тело (ДвоичныеДанные).
Функция ВыполнитьЗапрос(Метод, Адрес, Заголовки, Тело = Неопределено) Экспорт

	Начать();
	Запросы.Добавить(Метод + " " + Адрес);
	Части = РазобратьАдрес(Адрес);

	Если Индекс >= Обмены.Количество() Тогда
		Текст = "Запрос вне записи (запись исчерпана): " + Метод + " " + Адрес;
		Расхождения.Добавить(Текст);
		Возврат ОтветСбой("other", Текст);
	КонецЕсли;

	Обмен = Обмены[Индекс];
	Если Обмен.Метод <> Метод Или Обмен.Хост <> Части.Хост Или Обмен.Путь <> Части.Путь Или Обмен.Запрос <> Части.Запрос Тогда
		Текст = "Запрос не совпадает с записанным обменом " + Формат(Индекс + 1, "ЧН=0; ЧГ=") + ": запрос " + Метод + " " + Адрес
			+ ", в записи " + Обмен.Метод + " https://" + Обмен.Хост + Обмен.Путь + ?(ПустаяСтрока(Обмен.Запрос), "", "?" + Обмен.Запрос);
		Расхождения.Добавить(Текст);
		Возврат ОтветСбой("other", Текст);
	КонецЕсли;

	Индекс = Индекс + 1;

	Если Обмен.Сбой <> Неопределено Тогда
		Возврат ОтветСбой(Обмен.Сбой.Вид, Обмен.Сбой.Текст);
	КонецЕсли;

	Ответ = НовыйОтвет();
	Ответ.Статус = Обмен.Статус;
	Ответ.Заголовки = Обмен.Заголовки;
	Ответ.Тело = Обмен.Тело;
	Возврат Ответ;

КонецФункции

// Пауза только фиксируется, никто не ждет.
//
// Параметры:
//  Секунды - Число - длительность паузы.
Процедура Пауза(Секунды) Экспорт

	Начать();
	Паузы.Добавить(Секунды);

КонецПроцедуры

// Текущий момент в UTC: заданный тестом плюс паузы либо из записи.
//
// Возвращаемое значение:
//  Дата - момент UTC.
Функция ТекущийМомент() Экспорт

	Начать();
	Если ЗначениеЗаполнено(ЗаданныйМомент) Тогда
		Сумма = 0;
		Для Каждого Секунды Из Паузы Цикл
			Сумма = Сумма + Секунды;
		КонецЦикла;
		Возврат ЗаданныйМомент + Сумма;
	КонецЕсли;

	Если Обмены.Количество() = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат Обмены[Мин(Индекс, Обмены.ВГраница())].ЗапущенUTC;

КонецФункции

// Что не так с воспроизведением: накопленные расхождения и невостребованные обмены в конце записи.
//
// Возвращаемое значение:
//  Массив из Строка - тексты; пустой массив - все обмены воспроизведены в записанном порядке.
Функция Проверить() Экспорт

	Начать();
	Итог = Новый Массив;
	Для Каждого Текст Из Расхождения Цикл
		Итог.Добавить(Текст);
	КонецЦикла;
	Для Номер = Индекс По Обмены.ВГраница() Цикл
		Обмен = Обмены[Номер];
		Итог.Добавить("Невостребованный обмен " + Формат(Номер + 1, "ЧН=0; ЧГ=") + " в конце записи (конектор остановился раньше): "
			+ Обмен.Метод + " https://" + Обмен.Хост + Обмен.Путь + ?(ПустаяСтрока(Обмен.Запрос), "", "?" + Обмен.Запрос));
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Начать()

	Если Обмены = Неопределено Тогда
		Обмены = Новый Массив;
		Индекс = 0;
		Расхождения = Новый Массив;
		Паузы = Новый Массив;
		Запросы = Новый Массив;
	КонецЕсли;

КонецПроцедуры

Функция НовыйОтвет()

	Ответ = Новый Структура;
	Ответ.Вставить("Сбой", Ложь);
	Ответ.Вставить("ВидСбоя", "");
	Ответ.Вставить("ТекстСбоя", "");
	Ответ.Вставить("Статус", 0);
	Ответ.Вставить("Заголовки", Новый Соответствие);
	Ответ.Вставить("Тело", Base64Значение(""));
	Возврат Ответ;

КонецФункции

Функция ОтветСбой(Вид, Текст)

	Ответ = НовыйОтвет();
	Ответ.Сбой = Истина;
	Ответ.ВидСбоя = Вид;
	Ответ.ТекстСбоя = Текст;
	Возврат Ответ;

КонецФункции

Функция РазобратьJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ОбменИзТекста(Текст)

	Данные = РазобратьJSON(Текст);
	Если Данные["format"] <> "smp-api-exchange" Или Данные["formatVersion"] <> 1 Тогда
		ВызватьИсключение "Не обмен формата smp-api-exchange версии 1";
	КонецЕсли;

	Запрос = Данные["request"];
	Обмен = Новый Структура;
	Обмен.Вставить("Метод", Запрос["method"]);
	Обмен.Вставить("Хост", Запрос["host"]);
	Обмен.Вставить("Путь", Запрос["path"]);
	Обмен.Вставить("Запрос", ?(Запрос["query"] = Неопределено, "", Запрос["query"]));
	Обмен.Вставить("Сценарий", Данные["scenario"]);
	Обмен.Вставить("ЗапущенUTC", МоментИзТекста(Данные["startedUtc"]));
	Обмен.Вставить("Статус", 0);
	Обмен.Вставить("Заголовки", Новый Соответствие);
	Обмен.Вставить("Тело", Base64Значение(""));
	Обмен.Вставить("Сбой", Неопределено);

	Сбой = Данные["failure"];
	Если ТипЗнч(Сбой) = Тип("Соответствие") Тогда
		Обмен.Сбой = Новый Структура("Вид, Текст", Сбой["kind"], Сбой["text"]);
		Возврат Обмен;
	КонецЕсли;

	Ответ = Данные["response"];
	Обмен.Статус = Ответ["status"];
	Для Каждого Пара Из Ответ["headers"] Цикл
		Обмен.Заголовки.Вставить(НРег(Пара[0]), Пара[1]);
	КонецЦикла;
	Обмен.Тело = Base64Значение(Ответ["bodyBase64"]);
	Возврат Обмен;

КонецФункции

// "2026-10-15T18:53:23.575Z" -> дата UTC (доли секунды отбрасываются).
Функция МоментИзТекста(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(Текст, 19), "-", ""), "T", ""), ":", "");
	Возврат Дата(Цифры);

КонецФункции

// Адрес "схема://хост/путь?запрос" -> Хост, Путь, Запрос (без "?", как в записи).
Функция РазобратьАдрес(Адрес)

	Остаток = Адрес;
	Позиция = СтрНайти(Остаток, "://");
	Если Позиция > 0 Тогда
		Остаток = Сред(Остаток, Позиция + 3);
	КонецЕсли;

	Запрос = "";
	Позиция = СтрНайти(Остаток, "?");
	Если Позиция > 0 Тогда
		Запрос = Сред(Остаток, Позиция + 1);
		Остаток = Лев(Остаток, Позиция - 1);
	КонецЕсли;

	Путь = "";
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция > 0 Тогда
		Путь = Сред(Остаток, Позиция);
		Остаток = Лев(Остаток, Позиция - 1);
	КонецЕсли;

	Возврат Новый Структура("Хост, Путь, Запрос", Остаток, Путь, Запрос);

КонецФункции

#КонецОбласти
