				.СПараметрами("списание", "РасходСоСчета")
			// Пустое поле контекста - ошибка вызывающего кода: исключение с именем поля до разбора строк.
			.ДобавитьСерверныйТест("Контекст_ПустоеПолеДаетИсключениеСИменемПоля")
				.СПараметрами("пустая организация", "Организация")
				.СПараметрами("пустой банковский счет", "БанковскийСчет")
