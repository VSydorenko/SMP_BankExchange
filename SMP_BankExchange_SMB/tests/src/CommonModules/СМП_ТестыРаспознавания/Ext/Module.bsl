// Тесты распознавания банковской выписки (платформа загрузки, план 02).
//
// Правила - docs/architecture/testing.md. Каждый тест с данными работает в СВОЕЙ транзакции
// (.ВТранзакции() на тесте) и сам создает свою фикстуру через СМП_ТестыДанныеУНФ. Реквизиты
// продуктового расширения (СМП_ВидНалога) тестовое расширение не видит: читаются запросом.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Вид налога в правиле назначения")
			.ДобавитьСерверныйТест("ВидНалогаЗаписываетсяИЧитаетсяЗапросом").ВТранзакции()
				.СПараметрами("Взносы", "Взносы")
				.СПараметрами("ВоенныйСбор", "ВоенныйСбор")
			// Пара к предыдущему: правило без вида налога читается с пустой ссылкой, а не с чужим значением.
			.ДобавитьСерверныйТест("ПравилоБезВидаНалогаЧитаетсяПустым").ВТранзакции()
		// План загрузки - интерфейс этапов 3, 4, 6. Тест схемы здесь является спецификацией интерфейса:
		// изменение колонки плана видно в diff этого модуля. Колонки конверта сверяются со свежим НоваяВыписка().
		.ДобавитьТестовыйНабор("План загрузки: схема")
			.ДобавитьСерверныйТест("СхемаПлана_КолонкиКонвертаКакВНоваяВыписка")
			.ДобавитьСерверныйТест("СхемаПлана_КолонкиРешений")
			.ДобавитьСерверныйТест("СхемаПлана_ТипДокументаПоНомеруСобранИзМетаданных")
			.ДобавитьСерверныйТест("СхемаПлана_Замечания")
			.ДобавитьСерверныйТест("СхемаПлана_КонтекстРаспознавания")
			.ДобавитьСерверныйТест("СхемаПлана_ДваПланаНезависимы")
			.ДобавитьСерверныйТест("СхемаПлана_Литералы")
				.СПараметрами("ВидДокументаПоступлениеНаСчет", "ПоступлениеНаСчет")
				.СПараметрами("ВидДокументаРасходСоСчета", "РасходСоСчета")
				.СПараметрами("ИсточникЗагруженныйДокумент", "ЗагруженныйДокумент")
				.СПараметрами("ИсточникСвойСчет", "СвойСчет")
				.СПараметрами("ИсточникНашаОрганизация", "НашаОрганизация")
				.СПараметрами("ИсточникСотрудник", "Сотрудник")
				.СПараметрами("ИсточникПлатежноеПоручение", "ПлатежноеПоручение")
				.СПараметрами("ИсточникПравилоНазначения", "ПравилоНазначения")
				.СПараметрами("ИсточникДокументПоНомеру", "ДокументПоНомеру")
				.СПараметрами("ИсточникПоУмолчанию", "ПоУмолчанию")
				.СПараметрами("ДействиеНайден", "Найден")
				.СПараметрами("ДействиеСоздать", "Создать")
				.СПараметрами("ДействиеНеТребуется", "НеТребуется")
				.СПараметрами("ДействиеНевозможно", "Невозможно")
				.СПараметрами("ИсточникСтатьиПлатежноеПоручение", "ПлатежноеПоручение")
				.СПараметрами("ИсточникСтатьиПравилоНазначения", "ПравилоНазначения")
				.СПараметрами("ИсточникСтатьиДоговор", "Договор")
				.СПараметрами("ИсточникСтатьиКонтрагент", "Контрагент")
				.СПараметрами("ИсточникСтатьиПоВидуОперации", "ПоВидуОперации")
		.ДобавитьТестовыйНабор("Распознавание: факты конверта")
			.ДобавитьСерверныйТест("ФактыКонвертаВПланеСовпадаютСВходными")
			.ДобавитьСерверныйТест("ВходнаяТаблицаНеМеняется")
			.ДобавитьСерверныйТест("ПустойВходДаетПустойПлан")
			.ДобавитьСерверныйТест("НаправлениеНеИзКонтрактаДаетОшибкуВЗамечаниях")
		.ДобавитьТестовыйНабор("Распознавание: значение по умолчанию (шаг 6)")
			.ДобавитьСерверныйТест("ПоУмолчанию_ВидОперацииПоНаправлению")
				.СПараметрами("поступление", "НаправлениеПоступило", "ПоступлениеНаСчет", "Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя")
				.СПараметрами("списание", "НаправлениеСписано", "РасходСоСчета", "Перечисление.ВидыОперацийРасходСоСчета.Поставщику")
			.ДобавитьСерверныйТест("ПоУмолчанию_ПакетСоСмешаннымиНаправлениями")
		.ДобавитьТестовыйНабор("Банковский счет организации по номеру")
			.ДобавитьСерверныйТест("СчетПоТекущемуНомеру").ВТранзакции()
			.ДобавитьСерверныйТест("СчетПоУстаревшемуНомеру").ВТранзакции()
			// Пары к предыдущим: чужой владелец, пометка удаления, пустой и неизвестный номер дают пустую ссылку.
			.ДобавитьСерверныйТест("СчетКонтрагентаСТемЖеНомеромНеВозвращается").ВТранзакции()
			.ДобавитьСерверныйТест("СчетПомеченныйНаУдалениеНеВозвращается").ВТранзакции()
			.ДобавитьСерверныйТест("СчетПоТекущемуНомеруПредпочитаетсяУстаревшему").ВТранзакции()
			.ДобавитьСерверныйТест("ПустойИНеизвестныйНомерДаютПустуюСсылку").ВТранзакции()
		// Шаг 0 (D5, D17, D35.4, D35.5). Тесты "не найден" доводят предусловие до вызова: документ ЕСТЬ в базе и
		// несет проверяемый ключ (читается обратно запросом), иначе зеленый "не найден" означал бы пустую базу.
		.ДобавитьТестовыйНабор("Шаг 0: загруженный документ, идентификатор")
			.ДобавитьСерверныйТест("Шаг0_ПоИдентификаторуПриРазбежныхСуммеИНомере").ВТранзакции()
				.СПараметрами("поступление, не проведен", "ПоступлениеНаСчет", Ложь)
				.СПараметрами("списание, не проведен", "РасходСоСчета", Ложь)
				.СПараметрами("поступление, проведен", "ПоступлениеНаСчет", Истина)
			// Пара к предыдущему: тот же идентификатор у документа ДРУГОГО вида (правило 1) - не найден.
			.ДобавитьСерверныйТест("Шаг0_ИдентификаторДокументаДругогоВида_НеНаходится").ВТранзакции()
				.СПараметрами("поступление-документ, списание-операция", "ПоступлениеНаСчет")
				.СПараметрами("расход-документ, поступление-операция", "РасходСоСчета")
			.ДобавитьСерверныйТест("Шаг0_ВидКонтрагентДоговорБерутсяИзДокумента").ВТранзакции()
				.СПараметрами("поступление", "ПоступлениеНаСчет")
				.СПараметрами("списание", "РасходСоСчета")
		.ДобавитьТестовыйНабор("Шаг 0: загруженный документ, составной ключ")
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДокументБезИдентификатора_Находится").ВТранзакции()
				.СПараметрами("поступление", "ПоступлениеНаСчет")
				.СПараметрами("списание", "РасходСоСчета")
			// D17 "и наоборот": документ несет идентификатор, операция идет без него.
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДокументСИдентификаторомОперацияБез_Находится").ВТранзакции()
			// Review Focus 1: пара. Документ с ДРУГИМ идентификатором составным ключом не находится, а с пустым - находится.
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДругойИдентификаторВДокументе_НеНаходится").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ПустойИдентификаторВДокументе_Находится").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДокументЗанятыйИдентификаторомДругойОперации_НеБерется").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДваПлатежаСРазнымиИдентификаторами_ВторойНеНаходит").ВТранзакции()
			// Пара: все компоненты ключа совпали - найден; по одному несовпадению - нет.
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ВсеКомпонентыСовпали_Находится").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ОдноНесовпадение_НеНаходится").ВТранзакции()
				.СПараметрами("другая сумма", "сумма")
				.СПараметрами("другой день", "день")
				.СПараметрами("другой номер", "номер")
				.СПараметрами("номер операции пуст, у документа есть", "номерОперацииПуст")
				.СПараметрами("номер документа пуст, у операции есть", "номерДокументаПуст")
				.СПараметрами("другой счет контрагента", "счет")
				.СПараметрами("дата документа пуста, день операции другой", "деньОперации")
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_СчетКонтрагентаПустойВДокументе_Находится").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_СчетКонтрагентаРавный_Находится").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ПустаяДатаДокумента_ДеньИзДатыОперации").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_СоставнойКлюч_ДокументДругогоВида_НеНаходится").ВТранзакции()
		.ДобавитьТестовыйНабор("Шаг 0: количественное сопоставление (D35.4б)")
			.ДобавитьСерверныйТест("Шаг0_Количественно_ПустаяБаза_ОбеНовые").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ПовторныйКонвертПослеДвухДокументов").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ТриОперацииДваДокумента_ОднаНовая").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ПорядокПоПорядковомуНомеруИДате").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ПриОдинаковойДатеПорядокПоНомеруДокумента").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ДваДокументаСИдентификаторами_ДвеОперацииБезИдентификатора").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_ДокументовБольшеОпераций_Предупреждение").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_Количественно_НепустойНомер_ДваОдинаковых").ВТранзакции()
		.ДобавитьТестовыйНабор("Шаг 0: область поиска и результат")
			// Правило 1: документ другого банковского счета организации не находится ни тем, ни другим способом.
