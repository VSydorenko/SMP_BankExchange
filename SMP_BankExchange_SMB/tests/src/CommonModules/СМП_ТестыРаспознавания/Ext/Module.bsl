Процедура СчетКонтрагентаСТемЖеНомеромНеВозвращается() Экспорт

	СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(ОсновнойКонтрагент());
	Номер = НомерСчета(СчетКонтрагента);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Номер), "Предусловие: у счета контрагента есть номер").ЭтоЛожь();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СчетПоНомеру(Номер)), "Счет контрагента не возвращается как счет организации")
		.ЭтоЛожь();

	// Пара: счет организации с этим же номером находится, значит, пусто было из-за владельца, а не из-за номера.
	СчетОрганизации = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация(),
		Новый Структура("НомерСчета", Номер));
	ЮТест.ОжидаетЧто(СчетПоНомеру(Номер), "При счете организации с тем же номером возвращается он, не счет контрагента")
		.Равно(СчетОрганизации);

КонецПроцедуры

Процедура СчетПомеченныйНаУдалениеНеВозвращается() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Живой = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	Удаленный = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация, Новый Структура("ПометкаУдаления", Истина));

	ЮТест.ОжидаетЧто(СчетПоНомеру(НомерСчета(Живой)), "Живой счет находится").Равно(Живой);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СчетПоНомеру(НомерСчета(Удаленный))), "Счет, помеченный на удаление, не возвращается")
		.ЭтоЛожь();

КонецПроцедуры

// Два счета организации с одним номером X: у A он текущий, у B - устаревший. Возвращается A. B создается
// ПЕРВЫМ: при равенстве приоритетов запрос упорядочил бы по Коду и вернул B, поэтому без приоритета
// в УПОРЯДОЧИТЬ ПО тест красный всегда (порядок по Коду детерминирован), а не случайно.
Процедура СчетПоТекущемуНомеруПредпочитаетсяУстаревшему() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN();
	СчетСУстаревшим = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация,
		Новый Структура("НомерСчетаУстаревший", Номер));
	СчетСТекущим = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация,
		Новый Структура("НомерСчета", Номер));

	ЮТест.ОжидаетЧто(СчетПоНомеру(Номер), "Совпадение по текущему номеру предпочитается совпадению по устаревшему")
		.Равно(СчетСТекущим);
	ЮТест.ОжидаетЧто(СчетСТекущим <> СчетСУстаревшим, "Предусловие: это два разных счета").ЭтоИстина();

КонецПроцедуры

// Защита порожнего номера доказывается ЖИВЫМ счетом организации без устаревшего номера: без раннего выхода
// запрос "НомерСчетаУстаревший = ''" совпал бы с ним. Без такого счета в базе тест прошел бы и без защиты.
Процедура ПустойИНеизвестныйНомерДаютПустуюСсылку() Экспорт

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(ПустаяСтрока(УстаревшийНомерСчета(Счет)), "Предусловие: у счета нет устаревшего номера").ЭтоИстина();
	ЮТест.ОжидаетЧто(СчетПоНомеру(НомерСчета(Счет)), "Предусловие: счет находится по своему номеру").Равно(Счет);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СчетПоНомеру("")), "Пустой номер - пустая ссылка").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СчетПоНомеру("   ")), "Номер из пробелов - пустая ссылка").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СчетПоНомеру(СМП_ТестыДанныеУНФ.НовыйIBAN())), "Неизвестный номер - пустая ссылка")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЗагруженныйДокумент

// Правило 2: сначала по идентификатору, номер, сумма и день тогда не сверяются. Проведен или нет - не важно.
Процедура Шаг0_ПоИдентификаторуПриРазбежныхСуммеИНомере(Описание, Вид, Проведен) Экспорт

	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка, Проведен", Идентификатор, Проведен));

	// Операция: тот же идентификатор, но другие номер, сумма и день.
	Другой = КлючСИзменением(КлючСИзменением(КлючСИзменением(Ключ, "номер"), "сумма"), "день");
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.Идентификатор, Описание + ": предусловие - документ несет идентификатор").Равно(Идентификатор);
	ЮТест.ОжидаетЧто(Прочитано.Проведен, Описание + ": предусловие - признак проведения как заказан").Равно(Проведен);
	ЮТест.ОжидаетЧто(Прочитано.НомерВходящегоДокумента <> Другой.Номер Или Прочитано.Сумма <> Другой.Сумма, Описание
		+ ": предусловие - ключ операции с документом не совпадает").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Другой, Вид, Идентификатор)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, Описание);
	ЮТест.ОжидаетЧто(План.Замечания.Количество(), Описание + ": замечаний нет").Равно(0);

КонецПроцедуры

// Правило 1: вид документа. Идентификатор есть, но у документа другого вида - не найден.
Процедура Шаг0_ИдентификаторДокументаДругогоВида_НеНаходится(Описание, ВидДокумента) Экспорт

	ВидОперации = ?(ВидДокумента = "ПоступлениеНаСчет", "РасходСоСчета", "ПоступлениеНаСчет");
	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, ВидДокумента, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.Идентификатор, Описание + ": предусловие - документ несет идентификатор").Равно(Идентификатор);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, ВидОперации, Идентификатор)), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, Описание);

КонецПроцедуры

// Результат шага: вид операции, контрагент и договор берутся из найденного документа.
Процедура Шаг0_ВидКонтрагентДоговорБерутсяИзДокумента(Описание, Вид) Экспорт

	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	ВидОперации = ?(Вид = "ПоступлениеНаСчет",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПоставщика"),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Покупателю"));
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка, ВидОперации", Идентификатор, ВидОперации));

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, Описание);
	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ВидОперации, Описание + ": вид операции из документа").Равно(ВидОперации);
	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, Описание + ": контрагент из документа").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, Описание + ": договор из документа").Равно(Основа.Договор);

КонецПроцедуры

// Правило 3, D17: документ загружен файлом (идентификатора нет), операция пришла по API (идентификатор есть).
Процедура Шаг0_СоставнойКлюч_ДокументБезИдентификатора_Находится(Описание, Вид) Экспорт

	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, Вид);
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Прочитано.Идентификатор), Описание + ": предусловие - у документа идентификатора нет").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, НовыйИдентификатор())), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, Описание);

КонецПроцедуры

// D17 "и наоборот": документ загружен по API (идентификатор есть), та же операция пришла файлом (идентификатора нет).
Процедура Шаг0_СоставнойКлюч_ДокументСИдентификаторомОперацияБез_Находится() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.Идентификатор, "Предусловие - документ несет идентификатор").Равно(Идентификатор);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, "")), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Операция без идентификатора");

КонецПроцедуры

// Review Focus 1, D35.4а. Документ с ДРУГИМ идентификатором тем же составным ключом не находится: иначе вторая
// из двух одинаковых платежей одного дня без номера стала бы "уже загруженной" через документ первой.
Процедура Шаг0_СоставнойКлюч_ДругойИдентификаторВДокументе_НеНаходится() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	ИдентификаторДокумента = НовыйИдентификатор();
	ИдентификаторОперации = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", ИдентификаторДокумента));
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, ИдентификаторДокумента, "Предусловие");
	ЮТест.ОжидаетЧто(ИдентификаторДокумента <> ИдентификаторОперации, "Предусловие - идентификаторы разные").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, ИдентификаторОперации)), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, "Документ с другим идентификатором");

КонецПроцедуры

// Симметричная пара: те же ключ и операция, но у документа идентификатор пуст - находится.
Процедура Шаг0_СоставнойКлюч_ПустойИдентификаторВДокументе_Находится() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	ИдентификаторОперации = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид);
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, "", "Предусловие");

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, ИдентификаторОперации)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Документ с пустым идентификатором");

КонецПроцедуры

// D35.4: документ, уже сопоставленный по идентификатору с одной операцией, в составном ключе другой не участвует.
// У второй операции идентификатора нет, поэтому ее не останавливает правило "другой идентификатор": останавливает занятость.
Процедура Шаг0_СоставнойКлюч_ДокументЗанятыйИдентификаторомДругойОперации_НеБерется() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, Идентификатор, "Предусловие");

	План = Распознать(ТаблицаОпераций(
		ОперацияПоКлючу(1, Ключ, Вид, Идентификатор),
		ОперацияПоКлючу(2, Ключ, Вид, "")), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Операция с идентификатором");
	ПроверитьНеНайден(План, 2, "Операция без идентификатора, документ занят первой");

КонецПроцедуры

// Review Focus 1, дословно: два одинаковых платежа одного дня без номера, идентификаторы банка разные, в базе документ
// первого. Первая найдена по идентификатору, вторая НЕ становится "уже загруженной" через тот же документ.
Процедура Шаг0_СоставнойКлюч_ДваПлатежаСРазнымиИдентификаторами_ВторойНеНаходит() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	ПервыйИдентификатор = НовыйИдентификатор();
	ВторойИдентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", ПервыйИдентификатор));
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, ПервыйИдентификатор, "Предусловие");

	План = Распознать(ТаблицаОпераций(
		ОперацияПоКлючу(1, Ключ, Вид, ПервыйИдентификатор),
		ОперацияПоКлючу(2, Ключ, Вид, ВторойИдентификатор)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Первая операция");
	ПроверитьНеНайден(План, 2, "Вторая операция с другим идентификатором");

КонецПроцедуры

// Пара к ОдноНесовпадение: все компоненты ключа (вид, день, номер, счет контрагента, сумма) совпали - найден.
Процедура Шаг0_СоставнойКлюч_ВсеКомпонентыСовпали_Находится() Экспорт

	Сценарий = СценарийСоставногоКлюча("");

	План = Распознать(ТаблицаОпераций(Сценарий.Операция), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Сценарий.Документ.Ссылка, "Все компоненты ключа совпали");

КонецПроцедуры

// Один компонент ключа не совпал - документ не находится. Документ ЕСТЬ в базе и совпадает со всеми остальными
// компонентами (предусловие читается обратно), поэтому красный/зеленый зависит именно от этого компонента.
Процедура Шаг0_СоставнойКлюч_ОдноНесовпадение_НеНаходится(Описание, Режим) Экспорт

	Сценарий = СценарийСоставногоКлюча(Режим);
	Прочитано = ПрочитатьБанковскийДокумент(Сценарий.Документ.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.БанковскийСчет, Описание + ": предусловие - документ на банковском счете контекста")
		.Равно(КонтекстСОрганизацией().БанковскийСчет);
	ЮТест.ОжидаетЧто(Прочитано.Идентификатор, Описание + ": предусловие - у документа идентификатора нет").Равно("");

	План = Распознать(ТаблицаОпераций(Сценарий.Операция), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, Описание);

КонецПроцедуры

Процедура Шаг0_СоставнойКлюч_СчетКонтрагентаПустойВДокументе_Находится() Экспорт

	Вид = "РасходСоСчета";
	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, Вид);
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Прочитано.СчетКонтрагента), "Предусловие - в документе счета контрагента нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ключ.СчетКонтрагента), "Предусловие - у операции счет контрагента есть").ЭтоЛожь();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Пустой счет контрагента в документе");

КонецПроцедуры

Процедура Шаг0_СоставнойКлюч_СчетКонтрагентаРавный_Находится() Экспорт

	Вид = "РасходСоСчета";
	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СоСчетомКонтрагента", Истина));
	Ключ.СчетКонтрагента = Основа.НомерСчета;
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Прочитано.СчетКонтрагента), "Предусловие - в документе счет контрагента заполнен").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Равный счет контрагента");

КонецПроцедуры

// День сравнивается как НачалоДня: дата документа операции пуста, берется ДатаОперации со временем внутри суток,
// а входящая дата документа - без времени.
Процедура Шаг0_СоставнойКлюч_ПустаяДатаДокумента_ДеньИзДатыОперации() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, Вид);
	Операция = ОперацияПоКлючу(1, Ключ, Вид, "", Новый Структура("ДатаДокумента", '00010101'));
	ЮТест.ОжидаетЧто(Операция.ДатаОперации <> НачалоДня(Операция.ДатаОперации), "Предусловие - у даты операции есть время").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Операция.ДатаДокумента), "Предусловие - дата документа операции пуста").ЭтоЛожь();

	План = Распознать(ТаблицаОпераций(Операция), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Пустая дата документа, день операции");

КонецПроцедуры

// Вид документа в составном ключе: документ поступления не находится для операции списания с тем же ключом.
Процедура Шаг0_СоставнойКлюч_ДокументДругогоВида_НеНаходится() Экспорт

	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, "ПоступлениеНаСчет");
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, "", "Предусловие");

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, "РасходСоСчета")), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, "Документ другого вида");

КонецПроцедуры

// D35.4б, тест архитектора 1: две одинаковые операции в пустой базе - обе новые.
Процедура Шаг0_Количественно_ПустаяБаза_ОбеНовые() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу(Вид, Ключ), "Предусловие - документов с этим ключом в базе нет").Равно(0);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, "Первая операция в пустой базе");
	ПроверитьНеНайден(План, 2, "Вторая операция в пустой базе");

КонецПроцедуры

// D35.4б, тест архитектора 2: тот же конверт повторно после двух наявных документов - новых нет, каждая операция
// сопоставлена с РАЗНЫМ документом. Документы созданы в обратном порядке дат: порядок по дате, а не по созданию.
Процедура Шаг0_Количественно_ПовторныйКонвертПослеДвухДокументов() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	Поздний = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	Ранний = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу(Вид, Ключ), "Предусловие - два документа с этим ключом").Равно(2);
	ЮТест.ОжидаетЧто(Поздний <> Ранний, "Предусловие - документы разные").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Ранний, "Первая операция получает первый (по дате) документ");
	ПроверитьНайден(План, 2, Поздний, "Вторая операция получает второй документ");
	Первая = СтрокаПланаПоНомеру(План, 1).ЗагруженныйДокумент;
	Вторая = СтрокаПланаПоНомеру(План, 2).ЗагруженныйДокумент;
	ЮТест.ОжидаетЧто(Первая <> Вторая, "Операции сопоставлены с РАЗНЫМИ документами").ЭтоИстина();
	ЮТест.ОжидаетЧто(План.Замечания.Количество(), "Документов столько же, сколько операций - замечаний нет").Равно(0);

КонецПроцедуры

// D35.4б, тест архитектора 3: три одинаковые операции при двух наявных документах - одна новая.
Процедура Шаг0_Количественно_ТриОперацииДваДокумента_ОднаНовая() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	Второй = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	Первый = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу(Вид, Ключ), "Предусловие - два документа с этим ключом").Равно(2);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид),
		ОперацияПоКлючу(3, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Первый, "Первая операция");
	ПроверитьНайден(План, 2, Второй, "Вторая операция");
	ПроверитьНеНайден(План, 3, "Третья операция - сверх наличных документов");
	Первая = СтрокаПланаПоНомеру(План, 1).ЗагруженныйДокумент;
	Вторая = СтрокаПланаПоНомеру(План, 2).ЗагруженныйДокумент;
	ЮТест.ОжидаетЧто(Первая <> Вторая, "Первые две сопоставлены с разными документами").ЭтоИстина();

КонецПроцедуры

// Детерминированный порядок с обеих сторон: операции - по ПорядковыйНомер (в таблице строка №2 идет ПЕРВОЙ),
// документы - по дате (позднее создан раньше). Первая операция получает первый документ.
Процедура Шаг0_Количественно_ПорядокПоПорядковомуНомеруИДате() Экспорт

	Вид = "РасходСоСчета";
	Ключ = НовыйКлюч("");
	Поздний = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	Ранний = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(2, Ключ, Вид), ОперацияПоКлючу(1, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Ранний, "Операция №1 (стоит в таблице второй) получает первый документ");
	ПроверитьНайден(План, 2, Поздний, "Операция №2 (стоит в таблице первой) получает второй документ");

КонецПроцедуры

// При одной дате порядок документов - по номеру. Номера: общий префикс, последняя буква А/Б; документ "Б" создан первым.
Процедура Шаг0_Количественно_ПриОдинаковойДатеПорядокПоНомеруДокумента() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	МоментДокументов = ТекущаяДатаСеанса() - 900;
	Основание = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 9);
	Б = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата, Номер", МоментДокументов, Основание + "Б")).Ссылка;
	А = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата, Номер", МоментДокументов, Основание + "А")).Ссылка;

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, А, "Первая операция получает документ с меньшим номером");
	ПроверитьНайден(План, 2, Б, "Вторая операция получает документ с большим номером");

КонецПроцедуры

// Один конверт: поступление (№1) и списание (№2) с ОДНИМ составным ключом (день, номер, сумма, счет контрагента);
// в базе по одному документу каждого вида. Документ списания создан и датирован РАНЬШЕ документа поступления:
// без учета вида первая операция взяла бы первый по дате документ, то есть чужого вида.
Процедура Шаг0_РазныеВидыВОдномКонверте_КаждаяОперацияСДокументомСвоегоВида() Экспорт

	Ключ = НовыйКлюч("А-1");
	Расход = ДокументПоКлючу(Ключ, "РасходСоСчета", Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;
	Приход = ДокументПоКлючу(Ключ, "ПоступлениеНаСчет", Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу("ПоступлениеНаСчет", Ключ), "Предусловие - один документ поступления с ключом").Равно(1);
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу("РасходСоСчета", Ключ), "Предусловие - один документ списания с ключом").Равно(1);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, "ПоступлениеНаСчет"), ОперацияПоКлючу(2, Ключ, "РасходСоСчета")),
		КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Приход, "Поступление получает документ поступления");
	ПроверитьНайден(План, 2, Расход, "Списание получает документ списания");
	ЮТест.ОжидаетЧто(План.Замечания.Количество(), "Документов столько же, сколько операций каждого вида - замечаний нет").Равно(0);

КонецПроцедуры

// Пара к предыдущему: у вида "поступление" в базе два документа с ключом, у "списание" один. Предупреждение о лишнем
// документе только на операции поступления; у операции списания его нет (ключ группы учитывает вид).
Процедура Шаг0_РазныеВидыВОдномКонверте_ЛишнийДокументОдногоВида_ПредупреждениеТолькоЕгоОперации() Экспорт

	Ключ = НовыйКлюч("А-1");
	Расход = ДокументПоКлючу(Ключ, "РасходСоСчета", Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;
	ПозднийПриход = ДокументПоКлючу(Ключ, "ПоступлениеНаСчет", Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	РанийПриход = ДокументПоКлючу(Ключ, "ПоступлениеНаСчет", Новый Структура("Дата", ТекущаяДатаСеанса() - 1800)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу("ПоступлениеНаСчет", Ключ), "Предусловие - два документа поступления").Равно(2);
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу("РасходСоСчета", Ключ), "Предусловие - один документ списания").Равно(1);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, "ПоступлениеНаСчет"), ОперацияПоКлючу(2, Ключ, "РасходСоСчета")),
		КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, РанийПриход, "Поступление получает первый (по дате) документ поступления");
	ПроверитьНайден(План, 2, Расход, "Списание получает документ списания");
	ЮТест.ОжидаетЧто(ПозднийПриход <> РанийПриход, "Предусловие - документы поступления разные").ЭтоИстина();
	ПредупрежденияПоступления = ЗамечанияСтроки(План, 1);
	ЮТест.ОжидаетЧто(ПредупрежденияПоступления.Количество(), "Операция поступления: одно предупреждение о лишнем документе").Равно(1);
	Если ПредупрежденияПоступления.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(ПредупрежденияПоступления[0].Текст, "В предупреждении число документов поступления (2), не всех видов (3)")
			.Содержит("2");
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЗамечанияСтроки(План, 2).Количество(), "Операция списания: предупреждения нет").Равно(0);

КонецПроцедуры

// Правило 6: документов больше, чем операций с ключом. Зайвый не сопоставляется, на операциях ключа -
// "Предупреждение" с количеством наличных документов.
Процедура Шаг0_Количественно_ДокументовБольшеОпераций_Предупреждение() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	Третий = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 600)).Ссылка;
	Второй = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 1200)).Ссылка;
	Первый = ДокументПоКлючу(Ключ, Вид, Новый Структура("Дата", ТекущаяДатаСеанса() - 1800)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу(Вид, Ключ), "Предусловие - три документа с этим ключом").Равно(3);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Первый, "Первая операция");
	ПроверитьНайден(План, 2, Второй, "Вторая операция");
	ЮТест.ОжидаетЧто(План.Замечания.Количество(), "Предупреждение на каждой из двух операций").Равно(2);
	Для Каждого Номер Из СтрРазделить("1,2", ",") Цикл
		Замечания = ЗамечанияСтроки(План, Число(Номер));
		ЮТест.ОжидаетЧто(Замечания.Количество(), "Операция №" + Номер + ": одно замечание").Равно(1);
		Если Замечания.Количество() = 1 Тогда
			ЮТест.ОжидаетЧто(Замечания[0].Уровень, "Операция №" + Номер + ": уровень").Равно(Продукт("СМП_ВыпискаБанка.УровеньПредупреждение"));
			ЮТест.ОжидаетЧто(Замечания[0].Поле, "Операция №" + Номер + ": поле").Равно("ЗагруженныйДокумент");
			ЮТест.ОжидаетЧто(Замечания[0].Текст, "Операция №" + Номер + ": в тексте количество наличных документов").Содержит("3");
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Третий <> Первый И Третий <> Второй, "Предусловие - третий документ отличается").ЭтоИстина();
	Использованные = Новый Массив;
	Использованные.Добавить(СтрокаПланаПоНомеру(План, 1).ЗагруженныйДокумент);
	Использованные.Добавить(СтрокаПланаПоНомеру(План, 2).ЗагруженныйДокумент);
	ЮТест.ОжидаетЧто(Использованные.Найти(Третий), "Лишний (третий) документ не сопоставлен").Равно(Неопределено);

КонецПроцедуры

// Принцип тот же для НЕпустого номера: одна операция из двух одинаковых получает единственный документ, вторая - нет.
Процедура Шаг0_Количественно_НепустойНомер_ДваОдинаковых() Экспорт

	Вид = "РасходСоСчета";
	Ключ = НовыйКлюч("А-1");
	Основа = ДокументПоКлючу(Ключ, Вид);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид), ОперацияПоКлючу(2, Ключ, Вид)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Первая операция");
	ПроверитьНеНайден(План, 2, "Вторая такая же операция: единственный документ уже занят");

КонецПроцедуры

// Правило 1: банковский счет организации. Режим "идентификатор" - ищем по идентификатору, "ключ" - составным ключом.
Процедура Шаг0_ДокументДругогоБанковскогоСчета_НеНаходится(Описание, Режим) Экспорт

	Контекст = КонтекстСОрганизацией();
	ДругойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Контекст.Организация);
	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = ?(Режим = "идентификатор", НовыйИдентификатор(), "");
	Настройки = Новый Структура("БанковскийСчет", ДругойСчет);
	Если Режим = "идентификатор" Тогда
		Настройки.Вставить("СМП_ИДТранзакцииБанка", Идентификатор);
	КонецЕсли;
	Основа = ДокументПоКлючу(Ключ, Вид, Настройки);
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, Идентификатор, Описание + ": предусловие");
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.БанковскийСчет, Описание + ": предусловие - документ на другом счете").Равно(ДругойСчет);
	ЮТест.ОжидаетЧто(Прочитано.БанковскийСчет <> Контекст.БанковскийСчет, Описание + ": предусловие - счет не счет контекста")
		.ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), Контекст);

	ПроверитьНеНайден(План, 1, Описание);

КонецПроцедуры

// Пара к предыдущему: тот же документ на банковском счете контекста находится.
Процедура Шаг0_ДокументТогоЖеБанковскогоСчета_Находится(Описание, Режим) Экспорт

	Контекст = КонтекстСОрганизацией();
	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = ?(Режим = "идентификатор", НовыйИдентификатор(), "");
	Настройки = Новый Структура;
	Если Режим = "идентификатор" Тогда
		Настройки.Вставить("СМП_ИДТранзакцииБанка", Идентификатор);
	КонецЕсли;
	Основа = ДокументПоКлючу(Ключ, Вид, Настройки);
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.БанковскийСчет, Описание + ": предусловие - документ на счете контекста").Равно(Контекст.БанковскийСчет);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), Контекст);

	ПроверитьНайден(План, 1, Основа.Ссылка, Описание);

КонецПроцедуры

// D5: документ, помеченный на удаление, "уже загружен"; вид, контрагент и договор берутся из него.
Процедура Шаг0_ПомеченныйНаУдалениеНаходится(Описание, Режим) Экспорт

	Вид = "РасходСоСчета";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = ?(Режим = "идентификатор", НовыйИдентификатор(), "");
	ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Покупателю");
	Настройки = Новый Структура("ПометкаУдаления, ВидОперации", Истина, ВидОперации);
	Если Режим = "идентификатор" Тогда
		Настройки.Вставить("СМП_ИДТранзакцииБанка", Идентификатор);
	КонецЕсли;
	Основа = ДокументПоКлючу(Ключ, Вид, Настройки);
	ПроверитьКлючДокумента(Основа.Ссылка, Ключ, Идентификатор, Описание + ": предусловие");
	Прочитано = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Прочитано.ПометкаУдаления, Описание + ": предусловие - документ помечен на удаление").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, Описание);
	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ВидОперации, Описание + ": вид операции из помеченного документа").Равно(ВидОперации);
	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, Описание + ": контрагент из помеченного документа").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, Описание + ": договор из помеченного документа").Равно(Основа.Договор);

КонецПроцедуры

// Операции без совпадения идут дальше по шагам: ЗагруженныйДокумент пуст, вид решает следующий источник.
Процедура Шаг0_БезСовпадения_ИдетДальшеПоШагам() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	// В базе есть документ с другой суммой и другим идентификатором: ничего общего с операцией.
	Чужой = КлючСИзменением(Ключ, "сумма");
	ДокументПоКлючу(Чужой, Вид, Новый Структура("СМП_ИДТранзакцииБанка", НовыйИдентификатор()));

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, НовыйИдентификатор())), КонтекстСОрганизацией());

	ПроверитьНеНайден(План, 1, "Операция без совпадения");
	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, "Дальше сработал шаг 6 (значение по умолчанию)").Равно("ПоУмолчанию");
	ЮТест.ОжидаетЧто(СтрокаПлана.ВидОперации, "Вид операции - по умолчанию")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"));

КонецПроцедуры

// Следующие шаги строку с найденным документом не трогают: вид остается из документа, а не по умолчанию.
Процедура Шаг0_НайденныйДокументНеПереопределяетсяСледующимиШагами(Описание, Вид) Экспорт

	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	ВидПоУмолчанию = ?(Вид = "ПоступлениеНаСчет",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	ВидДокумента = ?(Вид = "ПоступлениеНаСчет",
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПоставщика"),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Покупателю"));
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка, ВидОперации", Идентификатор, ВидДокумента));
	ЮТест.ОжидаетЧто(ВидДокумента <> ВидПоУмолчанию, Описание + ": предусловие - вид документа отличается от вида по умолчанию")
		.ЭтоИстина();

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), КонтекстСОрганизацией());

	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, Описание + ": источник остался ЗагруженныйДокумент").Равно("ЗагруженныйДокумент");
	ЮТест.ОжидаетЧто(СтрокаПлана.ВидОперации, Описание + ": вид операции из документа, не по умолчанию").Равно(ВидДокумента);
	ЮТест.ОжидаетЧто(СтрокаПлана.ПроверьтеОперацию, Описание + ": ПроверьтеОперацию не выставлено").ЭтоЛожь();

КонецПроцедуры

// Пустая организация или банковский счет в контексте - ошибка вызывающего кода, не данных: Распознать сразу
// отказывает исключением с именем поля и не разбирает ни одной строки.
Процедура Контекст_ПустоеПолеДаетИсключениеСИменемПоля(Описание, Поле) Экспорт

	Контекст = КонтекстСОрганизацией();
	Контекст[Поле] = ПредопределенноеЗначение(?(Поле = "Организация", "Справочник.Организации.ПустаяСсылка",
		"Справочник.БанковскиеСчета.ПустаяСсылка"));
	Операции = ТаблицаОпераций(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 1)));

	// Берется описание первопричины (текст самого исключения продукта), а не подробное представление со стеком:
	// в стеке есть исходные строки модуля, где названы оба поля контекста.
	ТекстОшибки = Неопределено;
	Попытка
		Распознать(Операции, Контекст);
	Исключение
		Информация = ИнформацияОбОшибке();
		Пока Информация.Причина <> Неопределено Цикл
			Информация = Информация.Причина;
		КонецЦикла;
		ТекстОшибки = Информация.Описание;
	КонецПопытки;

	ДругоеПоле = ?(Поле = "Организация", "БанковскийСчет", "Организация");
	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": пустое поле контекста дало исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": в исключении названо пустое поле контекста").Содержит(Поле);
	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": в исключении НЕ названо заполненное поле контекста (" + ДругоеПоле + ")")
		.НеСодержит(ДругоеПоле);

КонецПроцедуры

// Пара к предыдущему: заполненный контекст исключения не дает.
Процедура Контекст_ЗаполненныйКонтекстБезИсключения() Экспорт

	Операции = ТаблицаОпераций(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 1)));

	ТекстОшибки = Неопределено;
	План = Неопределено;
	Попытка
		План = Распознать(Операции, КонтекстСОрганизацией());
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Заполненный контекст: исключения нет").Равно(Неопределено);
	ЮТест.ОжидаетЧто(План.Операции.Количество(), "Строка разобрана").Равно(1);

КонецПроцедуры

// D17 в обе стороны, количественно: два документа с РАЗНЫМИ идентификаторами (загружены по API) и две одинаковые
// операции файла без идентификатора. Обе сопоставляются, каждая со СВОИМ документом (сравнение ссылок).
Процедура Шаг0_Количественно_ДваДокументаСИдентификаторами_ДвеОперацииБезИдентификатора() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("");
	Второй = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка, Дата", НовыйИдентификатор(),
		ТекущаяДатаСеанса() - 600)).Ссылка;
	Первый = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка, Дата", НовыйИдентификатор(),
		ТекущаяДатаСеанса() - 1200)).Ссылка;
	ЮТест.ОжидаетЧто(КоличествоДокументовПоКлючу(Вид, Ключ), "Предусловие - два документа с этим ключом").Равно(2);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, ""), ОперацияПоКлючу(2, Ключ, Вид, "")),
		КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Первый, "Первая операция файла");
	ПроверитьНайден(План, 2, Второй, "Вторая операция файла");
	Первая = СтрокаПланаПоНомеру(План, 1).ЗагруженныйДокумент;
	Вторая = СтрокаПланаПоНомеру(План, 2).ЗагруженныйДокумент;
	ЮТест.ОжидаетЧто(Первая <> Вторая, "Операции сопоставлены с РАЗНЫМИ документами").ЭтоИстина();

КонецПроцедуры

// D5: шаг только читает. Версия данных найденного документа до и после не меняется. Пара внутри теста: запись
// документа версию меняет, то есть инструмент вообще видит запись.
Процедура Шаг0_НайденныйДокументНеМеняется() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	До = ПрочитатьБанковскийДокумент(Основа.Ссылка);

	План = Распознать(ТаблицаОпераций(ОперацияПоКлючу(1, Ключ, Вид, Идентификатор)), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Предусловие");
	После = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(После.ВерсияДанных, "Версия данных найденного документа после шага").Равно(До.ВерсияДанных);

	Объект = Основа.Ссылка.ПолучитьОбъект();
	Объект.Комментарий = Объект.Комментарий + "_изм";
	Объект.Записать(РежимЗаписиДокумента.Запись);
	Измененный = ПрочитатьБанковскийДокумент(Основа.Ссылка);
	ЮТест.ОжидаетЧто(Измененный.ВерсияДанных, "Контроль: после записи документа версия данных меняется").НеРавно(До.ВерсияДанных);

КонецПроцедуры

#КонецОбласти

#Область КодКонтрагента

// Вход нормализации по имени режима: так код приходит от читателей (разделители, нерозривные пробелы).
Функция ВходКода(Режим)

	Если Режим = "чисто" Тогда
		Возврат "12345678";
	ИначеЕсли Режим = "пробелы" Тогда
		Возврат "12 345 678";
	ИначеЕсли Режим = "краевыеПробелы" Тогда
		Возврат "  12345678  ";
	ИначеЕсли Режим = "НПП" Тогда
		Возврат "12" + Символы.НПП + "345" + Символы.НПП + "678";
	ИначеЕсли Режим = "краевыеНПП" Тогда
		Возврат Символы.НПП + "12345678" + Символы.НПП;
	ИначеЕсли Режим = "узкийНПП" Тогда
		Возврат "12" + Символ(8239) + "345678";
	ИначеЕсли Режим = "дефисы" Тогда
		Возврат "12-345-678";
	ИначеЕсли Режим = "точки" Тогда
		Возврат "12.345.678";
	ИначеЕсли Режим = "табуляция" Тогда
		Возврат "12" + Символы.Таб + "345678";
	ИначеЕсли Режим = "чистоДесять" Тогда
		Возврат "1234567890";
	ИначеЕсли Режим = "пробелыДесять" Тогда
		Возврат "12 3456 7890";
	ИначеЕсли Режим = "пусто" Тогда
		Возврат "";
	ИначеЕсли Режим = "пробелы3" Тогда
		Возврат "   ";
	ИначеЕсли Режим = "пустоНПП" Тогда
		Возврат Символы.НПП + Символы.НПП;
	ИначеЕсли Режим = "разделители" Тогда
		Возврат " - . ";
	КонецЕсли;

	ВызватьИсключение "Тест не знает режим входа кода: " + Режим;

КонецФункции

Функция НормализоватьКод(Код)

	Аргументы = Новый Массив;
	Аргументы.Добавить(Код);
	Возврат Продукт("СМП_РаспознаваниеОпераций.НормализоватьКодКонтрагента", Аргументы);

КонецФункции

Процедура НормКода_ДопустимыйКод(Название, Режим, Ожидаемый) Экспорт

	Результат = НормализоватьКод(ВходКода(Режим));

	ЮТест.ОжидаетЧто(Результат.Использовать, Название + ": код используется для поиска").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Нормализованный, Название + ": нормализованный код - только цифры").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(Результат.Предупреждение, Название + ": допустимый код без предупреждения").Равно("");

КонецПроцедуры

// Дополнение нулем - только с предупреждением, где ОБА значения. Оракул "как пришло": после удаления из текста нового
// значения (оно содержит старое как подстроку) старое все еще должно быть в тексте, иначе в тексте только одно значение.
Процедура НормКода_ПотерянныйВедущийНоль_ДополняетсяСПредупреждением(Название, Вход, Ожидаемый) Экспорт

	Результат = НормализоватьКод(Вход);

	ЮТест.ОжидаетЧто(Результат.Использовать, Название + ": дополненный код используется для поиска").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Нормализованный, Название + ": код дополнен нулем").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.Предупреждение), Название + ": предупреждение есть (дополнять молча нельзя)").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Предупреждение, Название + ": в предупреждении значение как стало").Содержит(Ожидаемый);
	БезНового = СтрЗаменить(Результат.Предупреждение, Ожидаемый, "");
	ЮТест.ОжидаетЧто(БезНового, Название + ": в предупреждении значение как пришло (кроме вхождения в новое)").Содержит(СокрЛП(Вход));

КонецПроцедуры

Процедура НормКода_НеподходящаяДлина_НеИспользуетсяСПредупреждением(Название, Вход) Экспорт

	Результат = НормализоватьКод(Вход);

	ЮТест.ОжидаетЧто(Результат.Использовать, Название + ": код не используется для поиска").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.Предупреждение), Название + ": предупреждение есть").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Предупреждение, Название + ": предупреждение называет код").Содержит(СокрЛП(Вход));

КонецПроцедуры

Процедура НормКода_НеЦифры_НеИспользуетсяСПредупреждением(Название, Вход) Экспорт

	Результат = НормализоватьКод(Вход);

	ЮТест.ОжидаетЧто(Результат.Использовать, Название + ": код с нецифровыми знаками не используется").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Результат.Предупреждение), Название + ": предупреждение есть").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Предупреждение, Название + ": предупреждение называет код").Содержит(СокрЛП(Вход));

КонецПроцедуры

Процедура НормКода_ПустойКод_НеПодозрителен(Название, Режим) Экспорт

	Результат = НормализоватьКод(ВходКода(Режим));

	ЮТест.ОжидаетЧто(Результат.Использовать, Название + ": пустой код не используется").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Предупреждение, Название + ": отсутствие кода - не подозрительный код, предупреждения нет").Равно("");

КонецПроцедуры

// Контрагент находится по коду. Номер счета в операции случайный (в базе его нет), название не совпадает.
Процедура Контрагент_ПоКоду_Находится(Название, ИмяНаправления) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Код = ДанныеКонтрагента(Контрагент).Код;

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование, Направление",
		Код, "", Продукт("СМП_ВыпискаБанка." + ИмяНаправления)));

	ПроверитьКонтрагента(Результат.Строка, Название, Контрагент, "Найден");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.СчетКонтрагента), Название + ": счета в базе нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеСчет, Название + ": счет с номером из операции создается").Равно("Создать");
	ЮТест.ОжидаетЧто(ЗамечанияКонтрагента(Результат.Замечания).Количество(), Название + ": замечаний по контрагенту нет").Равно(0);

КонецПроцедуры

// R25: расхождение названия при совпавшем коде - не замечание. Предусловие: название операции и название контрагента
// в базе различаются (читается из базы).
Процедура Контрагент_РазныеНазванияПриСовпавшемКоде_БезЗамечаний() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Данные = ДанныеКонтрагента(Контрагент);
	НазваниеВыписки = "Совсем другое название " + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);
	ЮТест.ОжидаетЧто(НазваниеВыписки, "Предусловие: название в выписке отличается от названия контрагента в базе")
		.НеРавно(Данные.Наименование);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", Данные.Код, НазваниеВыписки));

	ПроверитьКонтрагента(Результат.Строка, "Код совпал, названия разные", Контрагент, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияКонтрагента(Результат.Замечания).Количество(),
		"Расхождение названия при совпавшем коде не дает замечаний по контрагенту").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Замечания.Количество(), "Строка плана вообще без замечаний").Равно(0);

КонецПроцедуры

Процедура Контрагент_КодСРазделителями_НаходитТогоЖе(Название, Режим) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Код = ДанныеКонтрагента(Контрагент).Код;
	Разделитель = ?(Режим = "НПП", Символы.НПП, " ");
	КодСРазделителями = Сред(Код, 1, 2) + Разделитель + Сред(Код, 3, 3) + Разделитель + Сред(Код, 6, 3);
	ЮТест.ОжидаетЧто(КодСРазделителями, Название + ": предусловие - код в операции отличается от кода в базе").НеРавно(Код);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", КодСРазделителями, ""));

	ПроверитьКонтрагента(Результат.Строка, Название, Контрагент, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияКонтрагента(Результат.Замечания).Количество(), Название + ": разделители - не замечание").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Строка.КонтрагентКод, Название + ": КонтрагентКод в плане - как пришел от банка, с разделителями").Равно(КодСРазделителями);

КонецПроцедуры

// Контрагент в базе с кодом БЕЗ ведущего нуля (7 цифр): находится операцией с тем же 7-значным кодом, с предупреждением
// о дополнении (поиск ищет и код как пришел, и дополненный). Пара - КодБезВедущегоНуля_НаходитсяСПредупреждением: там в
// базе 8-значный код, в операции 7-значный.
Процедура Контрагент_КодБезНуляВБазе_НаходитсяТакимЖеКодом() Экспорт

	КодВБазе = Сред(СМП_ТестыДанныеУНФ.НовыйЕДРПОУСВедущимНулем(), 2);
	Контрагент = НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", КодВБазе));
	ЮТест.ОжидаетЧто(СтрДлина(ДанныеКонтрагента(Контрагент).Код), "Предусловие: в базе код из 7 цифр").Равно(7);
	ЮТест.ОжидаетЧто(КонтрагентовСКодом("0" + КодВБазе), "Предусловие: с дополненным кодом контрагентов нет").Равно(0);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", КодВБазе, ""));

	ПроверитьКонтрагента(Результат.Строка, "Код без нуля в базе и в операции", Контрагент, "Найден");
	ЮТест.ОжидаетЧто(Результат.Строка.КонтрагентКод, "КонтрагентКод в плане - как пришел").Равно(КодВБазе);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение()).Количество(),
		"Предупреждение о дополнении кода есть и тут").Равно(1);

КонецПроцедуры

// Счет, номер которого сохранен в базе с пробелами, находится операцией с тем же номером: поиск ищет и нормализованный номер,
// и номер как пришел. (Обратное - номер без пробелов против номера с пробелами в базе - известное ограничение.)
Процедура Счет_НомерСПробеламиВБазе_НаходитсяТакимЖеНомером() Экспорт

	Владелец = НовыйКонтрагентТеста();
	Номер = НовыйНомерСПробелами();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Владелец, Новый Структура("НомерСчета", Номер));
	ЮТест.ОжидаетЧто(ДанныеСчета(Счет).НомерСчета, "Предусловие: в базе номер с пробелами").Равно(Номер);
	ЮТест.ОжидаетЧто(Найти(Номер, " ") > 0, "Предусловие: пробелы в номере есть").ЭтоИстина();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование", Номер, "", ""));

	ПроверитьСчет(Результат.Строка, "Номер с пробелами в базе и в операции", Счет, "Найден");

КонецПроцедуры

// Консультант: код 7 (9) цифр находит контрагента с кодом 8 (10) цифр и ОБЯЗАТЕЛЬНО дает предупреждение с обоими
// значениями. Контрагент с ведущим нулем создается фикстурой; код операции - его же без ведущего нуля.
Процедура Контрагент_КодБезВедущегоНуля_НаходитсяСПредупреждением(Название, Цифр) Экспорт

	Если Цифр = 7 Тогда
		КодВБазе = СМП_ТестыДанныеУНФ.НовыйЕДРПОУСВедущимНулем();
	Иначе
		КодВБазе = "0" + Лев(СМП_ТестыДанныеУНФ.НовыйЕДРПОУ() + СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), 9);
	КонецЕсли;
	Контрагент = НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", КодВБазе));
	ЮТест.ОжидаетЧто(ДанныеКонтрагента(Контрагент).Код, Название + ": предусловие - в базе код с ведущим нулем").Равно(КодВБазе);
	КодВыписки = Сред(КодВБазе, 2);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", КодВыписки, ""));

	ПроверитьКонтрагента(Результат.Строка, Название, Контрагент, "Найден");
	// Код банка - факт: колонка плана остается такой, как пришла (нормализованный код нужен только поиску).
	ЮТест.ОжидаетЧто(Результат.Строка.КонтрагентКод, Название + ": КонтрагентКод в плане - как пришел от банка").Равно(КодВыписки);
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": ровно одно предупреждение о коде (молча дополнять нельзя)").Равно(1);
	Текст = Предупреждения[0].Текст;
	ЮТест.ОжидаетЧто(Текст, Название + ": в предупреждении значение как стало").Содержит(КодВБазе);
	ЮТест.ОжидаетЧто(СтрЗаменить(Текст, КодВБазе, ""), Название + ": в предупреждении значение как пришло").Содержит(КодВыписки);

КонецПроцедуры

// Пара: предупреждение о дополнении относится к данным операции, а не к находке. Контрагента с дополненным кодом нет
// в базе (предусловие доведено до вызова запросом) - предупреждение все равно есть, действие "Создать".
Процедура Контрагент_КодБезВедущегоНуля_НеНайден_ПредупреждениеВсеРавноЕсть() Экспорт

	КодВыписки = Сред(СМП_ТестыДанныеУНФ.НовыйЕДРПОУСВедущимНулем(), 2);
	Дополненный = "0" + КодВыписки;
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Дополненный), "Предусловие: контрагента с дополненным кодом в базе нет").Равно(0);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", КодВыписки,
		"СМП_ТЕСТ_Новый_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8)));

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.Контрагент), "Контрагент не найден").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, "Контрагент создается").Равно("Создать");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Предупреждение о дополнении кода есть и без находки").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Предупреждение называет дополненное значение").Содержит(Дополненный);

КонецПроцедуры

// Review Focus 2: код неподходящей длины не используется для поиска. Предусловие доведено до вызова: контрагент с
// таким кодом, как он записан в выписке, в базе ЕСТЬ (читается из базы), и именно поэтому не найден.
Процедура Контрагент_КодНеподходящейДлины_НеИспользуется(Название, Код) Экспорт

	Контрагент = НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", Код));
	ЮТест.ОжидаетЧто(ДанныеКонтрагента(Контрагент).Код, Название + ": предусловие - контрагент с этим кодом есть в базе").Равно(Код);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", Код,
		"СМП_ТЕСТ_Новый_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8)));

	ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, Название + ": по коду неподходящей длины контрагент не найден")
		.НеРавно(Контрагент);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.Контрагент), Название + ": контрагент не заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, Название + ": есть название - контрагент создается").Равно("Создать");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": предупреждение о подозрительном коде").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": предупреждение называет код").Содержит(Код);

КонецПроцедуры

// Код непригоден - значит, его нет: название становится запасным ключом.
Процедура Контрагент_КодНеподходящейДлины_НазваниеЗапаснымКлючом() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Данные = ДанныеКонтрагента(Контрагент);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", "12345", Данные.Наименование));

	ПроверитьКонтрагента(Результат.Строка, "Код непригоден, название совпало", Контрагент, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение()).Количество(),
		"Предупреждение о непригодном коде есть").Равно(1);

КонецПроцедуры

// Несколько контрагентов с одним кодом: предупреждение и первый по коду справочника. Код справочника платформа
// выдает не по порядку создания (номера переиспользуются), поэтому первый определяется чтением кодов из базы, а не
// порядком создания; предусловие - коды различаются.
Процедура Контрагент_НесколькоСТемЖеКодом_ПерваяПоКодуПредупреждение() Экспорт

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Первый = НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", Код));
	Второй = НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", Код));
	ЮТест.ОжидаетЧто(ДанныеКонтрагента(Второй).Код, "Предусловие: оба контрагента с одним ЕДРПОУ").Равно(ДанныеКонтрагента(Первый).Код);
	Ожидаемый = МеньшийПоКодуСправочника(Первый, Второй);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", Код, ""));

	ПроверитьКонтрагента(Результат.Строка, "Два контрагента с одним кодом", Ожидаемый, "Найден");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентКод", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Предупреждение о нескольких контрагентах с кодом").Равно(1);

КонецПроцедуры

// Пометка удаления: контрагент, помеченный на удаление, по коду не находится (предусловие - он в базе есть и помечен).
Процедура Контрагент_ПомеченныйНаУдаление_ПоКодуНеНаходится() Экспорт

	Контрагент = НовыйКонтрагентТеста(Новый Структура("ПометкаУдаления", Истина));
	Данные = ДанныеКонтрагента(Контрагент);
	ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, "Предусловие: контрагент с этим кодом есть в базе и помечен на удаление").ЭтоИстина();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", Данные.Код,
		"СМП_ТЕСТ_Новый_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8)));

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.Контрагент), "Помеченный на удаление контрагент не находится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, "Контрагент создается").Равно("Создать");
	// Решение планировщика, п. 3: не молча - предупреждение с названием и кодом помеченного контрагента.
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "Контрагент", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о контрагенте, помеченном на удаление").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Предупреждение называет помеченного контрагента (название)").Содержит(Данные.Наименование);
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Предупреждение называет помеченного контрагента (код)").Содержит(Данные.Код);
	КонецЕсли;

КонецПроцедуры

// Симметричная пара к предыдущему: помеченный на удаление контрагент есть, но с ДРУГИМ кодом - операции он не касается,
// предупреждения нет. Пара доказывает, что предупреждение держится на совпадении кода, а не на самом наличии
// помеченных контрагентов в базе.
Процедура Контрагент_ПомеченныйСДругимКодом_ПредупрежденияНет() Экспорт

	Помеченный = НовыйКонтрагентТеста(Новый Структура("ПометкаУдаления", Истина));
	ДанныеПомеченного = ДанныеКонтрагента(Помеченный);
	КодОперации = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	ЮТест.ОжидаетЧто(ДанныеПомеченного.ПометкаУдаления, "Предусловие: помеченный контрагент в базе есть").ЭтоИстина();
	ЮТест.ОжидаетЧто(КодОперации, "Предусловие: код операции отличается от кода помеченного").НеРавно(ДанныеПомеченного.Код);
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(КодОперации), "Предусловие: с кодом операции контрагентов нет").Равно(0);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", КодОперации,
		"СМП_ТЕСТ_Новый_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8)));

	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, "Контрагент создается").Равно("Создать");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "Контрагент").Количество(), "Предупреждения о помеченном контрагенте нет").Равно(0);

КонецПроцедуры

// Рядки с уже определенным контрагентом (шаги 1-2 задачи 5 ставят его до завершения; здесь он задан вручную) часть
// "поиск" не меняет, действие над ним не пересматривается: код операции указывает на ДРУГОГО контрагента.
Процедура Контрагент_УжеОпределенный_НеМеняется() Экспорт

	Определенный = НовыйКонтрагентТеста();
	Другой = НовыйКонтрагентТеста();
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Другой).Код, "", ""));
	Контекст = КонтекстСОрганизацией();
	План = НовыйПлан();
	СтрокаПлана = План.Операции.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПлана, Операция);
	СтрокаПлана.Организация = Контекст.Организация;
	СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;
	СтрокаПлана.ВидДокумента = "РасходСоСчета";
	СтрокаПлана.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику");
	СтрокаПлана.ИсточникВидаОперации = "ПравилоНазначения";
	СтрокаПлана.Контрагент = Определенный;
	СтрокаПлана.ДействиеКонтрагент = "Найден";

	ВызватьШаги(План, Контекст);

	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, "Определенный контрагент не заменен найденным по коду").Равно(Определенный);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеКонтрагент, "Действие над определенным контрагентом не изменено").Равно("Найден");

КонецПроцедуры

#КонецОбласти

