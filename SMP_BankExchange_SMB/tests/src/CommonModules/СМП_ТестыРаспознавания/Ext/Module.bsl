Процедура Договор_ТолькоДругойОрганизации_Создать() Экспорт

	Другая = СМП_ТестыДанныеУНФ.ДругаяОрганизация();
	Если Не ЗначениеЗаполнено(Другая) Тогда
		ЮТест.Пропустить("В базе нет второй организации: договор чужой организации воспроизвести не на чем");
		Возврат;
	КонецЕсли;
	Контрагент = НовыйКонтрагентТеста();
	Чужой = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация", Другая));
	Данные = ДанныеДоговора(Чужой);
	ЮТест.ОжидаетЧто(Данные.Организация, "Предусловие: договор другой организации").Равно(Другая);
	ЮТест.ОжидаетЧто(Данные.ПометкаУдаления Или Данные.Недействителен, "Предусловие: договор живой").ЭтоЛожь();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""));

	ПроверитьДоговор(Результат.Строка, "Договор только другой организации", Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), "Создать");

