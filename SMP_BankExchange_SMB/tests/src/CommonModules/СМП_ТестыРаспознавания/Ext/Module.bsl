КонецПроцедуры

// Виды без договора (переказ, зарплата, налоги, "Прочее"): договор не нужен, даже если он у найденного контрагента есть.
// Предусловие доведено до вызова: у контрагента живой договор организации (читается из базы), и пара ниже находит его.
Процедура Договор_ВидБезДоговора_НеТребуется(Название, ВидДокумента, ИмяВида) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Договор = НастроитьДоговорПокупателя(Контрагент,
		Новый Структура("Организация, Основной", СМП_ТестыДанныеУНФ.Организация(), Истина));
	Данные = ДанныеДоговора(Договор);
	ЮТест.ОжидаетЧто(Данные.Организация, Название + ": предусловие - договор организации распознавания").Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(Данные.ПометкаУдаления Или Данные.Недействителен, Название + ": предусловие - договор живой").ЭтоЛожь();

	Результат = РезультатШага(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""), ВидДокумента, ИмяВида);

	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеДоговор, Название + ": договор не нужен").Равно("НеТребуется");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.Договор), Название + ": договор в плане не заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, Название + ": контрагент при этом найден").Равно(Контрагент);

КонецПроцедуры

Процедура Договор_ВидСДоговором_Находится(Название, ВидДокумента, ИмяВида, ИмяВидаДоговора) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Договор = НастроитьДоговорПокупателя(Контрагент,
		Новый Структура("Организация, Основной, ВидДоговора", СМП_ТестыДанныеУНФ.Организация(), Истина,
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяВидаДоговора)));

	Результат = РезультатШага(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""), ВидДокумента, ИмяВида);

	ПроверитьДоговор(Результат.Строка, Название, Договор, "Найден");

КонецПроцедуры

// Контрагент с основным договором КАЖДОГО из двух видов (покупатель и поставщик, обе записи в регистре основных
// договоров - ключ регистра включает вид). Договор берется по виду операции; без отбора по виду было бы "два основных":
// предупреждение и первый по коду, то есть в половине случаев не тот.
Процедура Договор_ВидДоговораСоответствуетВидуОперации(Название, ВидДокумента, ИмяВида, ИмяВидаДоговора) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Покупатель = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, Основной", СМП_ТестыДанныеУНФ.Организация(), Истина));
	Поставщик = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("Основной, ВидДоговора", Истина,
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком")));
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Покупатель) И ЕстьВРегистреОсновных(Поставщик),
		Название + ": предусловие - оба договора числятся основными (каждый своего вида)").ЭтоИстина();
	ЮТест.ОжидаетЧто(ДанныеДоговора(Покупатель).ВидДоговора, Название + ": предусловие - вид первого договора")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем"));
	Ожидаемый = ?(ИмяВидаДоговора = "СПокупателем", Покупатель, Поставщик);

	Результат = РезультатШага(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""), ВидДокумента, ИмяВида);

	ПроверитьДоговор(Результат.Строка, Название, Ожидаемый, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "Договор").Количество(), Название + ": предупреждений по договору нет").Равно(0);

КонецПроцедуры

// Решение планировщика, п. 1: нужного вида нет, а другой есть - "Создать" и предупреждение с перечнем наявных договоров
// другого вида (в тексте - наименование наявного договора). Договор другого вида при этом НЕ подставляется.
Процедура Договор_НужногоВидаНет_ЕстьДругой_СоздатьСПредупреждением(Название, ВидДокумента, ИмяВида, ИмяНаявногоВида) Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Наявный = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, Основной, ВидДоговора",
		СМП_ТестыДанныеУНФ.Организация(), Истина, ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяНаявногоВида)));
	ДанныеНаявного = ДанныеДоговора(Наявный);
	ЮТест.ОжидаетЧто(ДанныеНаявного.ВидДоговора, Название + ": предусловие - наявный договор другого вида")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяНаявногоВида));
	ЮТест.ОжидаетЧто(ДанныеНаявного.ПометкаУдаления Или ДанныеНаявного.Недействителен, Название + ": предусловие - наявный договор живой").ЭтоЛожь();

	Результат = РезультатШага(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""), ВидДокумента, ИмяВида);

	ПроверитьДоговор(Результат.Строка, Название, Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), "Создать");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "Договор", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": одно предупреждение о договоре другого вида").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": предупреждение называет наявный договор").Содержит(ДанныеНаявного.Наименование);
	КонецЕсли;

КонецПроцедуры

// Пара к предыдущему: никаких договоров организации нет (единственный помечен на удаление) - "Создать" без предупреждения.
Процедура Договор_НикакихДоговоров_СоздатьБезПредупреждения() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Помеченный = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, ПометкаУдаления", СМП_ТестыДанныеУНФ.Организация(), Истина));
	ЮТест.ОжидаетЧто(ДанныеДоговора(Помеченный).ПометкаУдаления, "Предусловие: единственный договор помечен на удаление").ЭтоИстина();

	Результат = РезультатШага(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""), "ПоступлениеНаСчет", "ОтПокупателя");

	ПроверитьДоговор(Результат.Строка, "Договоров нет", Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), "Создать");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "Договор").Количество(), "Предупреждений по договору нет").Равно(0);

КонецПроцедуры

// Решение планировщика, п. 2: контрагент не ведет расчеты по договорам - берется ДоговорПоУмолчанию контрагента
// (вендорская функция менеджера справочника), организация договора не фильтрует. Договор по умолчанию отнесен к
// ДРУГОЙ организации (предусловие читается из базы): отбор по организации дал бы "Создать".
Процедура Договор_БезУчетаПоДоговорам_БеретсяДоговорПоУмолчаниюЛюбойОрганизации() Экспорт

	Другая = СМП_ТестыДанныеУНФ.ДругаяОрганизация();
	Если Не ЗначениеЗаполнено(Другая) Тогда
		ЮТест.Пропустить("В базе нет второй организации: договор по умолчанию чужой организации воспроизвести не на чем");
		Возврат;
	КонецЕсли;
	Контрагент = НовыйКонтрагентТеста(Новый Структура("ВестиРасчетыПоДоговорам", Ложь));
	Договор = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, Основной", Другая, Истина));
	ЮТест.ОжидаетЧто(ДанныеДоговора(Договор).Организация, "Предусловие: договор по умолчанию - другой организации").Равно(Другая);
	ЮТест.ОжидаетЧто(Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент), "Предусловие: вендорская функция возвращает этот договор")
		.Равно(Договор);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""));

	ПроверитьДоговор(Результат.Строка, "Расчеты по договорам не ведутся", Договор, "Найден");

КонецПроцедуры

// Пара: расчеты по договорам не ведутся, но договора по умолчанию нет (снят признак основного) - "Создать".
Процедура Договор_БезУчетаПоДоговорам_НетДоговораПоУмолчанию_Создать() Экспорт

	Контрагент = НовыйКонтрагентТеста(Новый Структура("ВестиРасчетыПоДоговорам", Ложь));
	Договор = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, Основной", СМП_ТестыДанныеУНФ.Организация(), Ложь));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент)),
		"Предусловие: договора по умолчанию у контрагента нет (договор есть, но не основной)").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ДанныеДоговора(Договор).ПометкаУдаления, "Предусловие: сам договор не помечен").ЭтоЛожь();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""));

	ПроверитьДоговор(Результат.Строка, "Нет договора по умолчанию", Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), "Создать");

КонецПроцедуры

// Договор не выбирается там, где его уже дали предыдущие шаги (0, 3, 5): строка с заполненным договором не меняется,
// даже когда у контрагента есть другой договор нужного вида.
Процедура Договор_УжеЗаданный_НеМеняется() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Заданный = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент);
	Автоматический = НастроитьДоговорПокупателя(Контрагент, Новый Структура("Организация, Основной", СМП_ТестыДанныеУНФ.Организация(), Истина));
	ЮТест.ОжидаетЧто(Заданный <> Автоматический, "Предусловие: у контрагента два разных договора").ЭтоИстина();

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("КонтрагентКод, КонтрагентНомерСчета, КонтрагентНаименование",
		ДанныеКонтрагента(Контрагент).Код, "", ""));
	Контекст = КонтекстСОрганизацией();
	План = НовыйПлан();
	СтрокаПлана = План.Операции.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПлана, Операция);
	СтрокаПлана.Организация = Контекст.Организация;
	СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;
	СтрокаПлана.ВидДокумента = "ПоступлениеНаСчет";
	СтрокаПлана.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя");
	СтрокаПлана.ИсточникВидаОперации = "ДокументПоНомеру";
	СтрокаПлана.Договор = Заданный;
	СтрокаПлана.ДействиеДоговор = "Найден";

	ВызватьШаги(План, Контекст);

	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, "Заданный договор не заменен").Равно(Заданный);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеДоговор, "Действие над заданным договором не изменено").Равно("Найден");

КонецПроцедуры

#КонецОбласти

#Область ПакетИНайденныйДокумент

// Четыре строки одного конверта находятся каждая своим способом (по счету, по коду, по названию, не находится):
// результаты не перемешиваются между строками.
Процедура Пакет_РазныеСпособыПоиска_КаждаяСтрокаСвой() Экспорт

	ПоСчету = НовыйКонтрагентТеста();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(ПоСчету);
	ПоКоду = НовыйКонтрагентТеста();
	ПоНазванию = НовыйКонтрагентТеста();

	Операции = ТаблицаОпераций(
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование",
			1, ДанныеСчета(Счет).НомерСчета, "", "")),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентКод, КонтрагентНаименование",
			2, ДанныеКонтрагента(ПоКоду).Код, "")),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентКод, КонтрагентНаименование, Направление",
			3, "", ДанныеКонтрагента(ПоНазванию).Наименование, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 4)));

	План = Распознать(Операции, КонтекстСОрганизацией());

	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 1), "Строка 1, по счету", ПоСчету, "Найден");
	ПроверитьСчет(СтрокаПланаПоНомеру(План, 1), "Строка 1, по счету", Счет, "Найден");
	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 2), "Строка 2, по коду", ПоКоду, "Найден");
	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 3), "Строка 3, по названию", ПоНазванию, "Найден");
	// Колонка Контрагент составного типа: пустое значение в ней - Неопределено, а не пустая ссылка Контрагенты.
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаПланаПоНомеру(План, 4).Контрагент), "Строка 4, не находится: контрагент не заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 4).ДействиеКонтрагент, "Строка 4, не находится: действие над контрагентом").Равно("Создать");

КонецПроцедуры

// Найденная шагом 0 строка: контрагент и договор берутся из документа и не пересматриваются, колонки действий пусты,
// даже если код операции указывает на другого контрагента.
Процедура Шаг4_ЗагруженныйДокумент_КонтрагентИДоговорНеТрогаются() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("А-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Другой = НовыйКонтрагентТеста();
	КодДругого = ДанныеКонтрагента(Другой).Код;
	ЮТест.ОжидаетЧто(Основа.Контрагент <> Другой, "Предусловие: код операции указывает не на контрагента документа").ЭтоИстина();

	Операция = ОперацияПоКлючу(1, Ключ, Вид, Идентификатор, Новый Структура("КонтрагентКод, КонтрагентНаименование", КодДругого, ""));
	План = Распознать(ТаблицаОпераций(Операция), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Найденный документ");
	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, "Контрагент из документа").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, "Договор из документа").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеКонтрагент, "Действие над контрагентом не выставляется").Равно("");
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеСчет, "Действие над счетом не выставляется").Равно("");
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеДоговор, "Действие над договором не выставляется").Равно("");
	ЮТест.ОжидаетЧто(ЗамечанияСтроки(План, 1).Количество(), "Замечаний по найденному документу нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеКонтрагента

Функция УровеньПредупреждение()

	Возврат Продукт("СМП_ВыпискаБанка.УровеньПредупреждение");

КонецФункции

Функция УровеньОшибка()

	Возврат Продукт("СМП_ВыпискаБанка.УровеньОшибка");

КонецФункции

// Контрагент для тестов распознавания: учет по договорам, документам, заказам; Дополнительно - ключи НовыйКонтрагент.
Функция НовыйКонтрагентТеста(Дополнительно = Неопределено)

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

КонецФункции

// Из двух однотипных объектов (контрагенты, договоры) тот, у которого меньший код справочника. Код платформа выдает
// не по порядку создания, поэтому "первый по коду" определяется чтением кодов из базы. Предусловие: коды различаются.
Функция МеньшийПоКодуСправочника(Первый, Второй)

	КодПервого = ЧитатьРеквизиты(Первый, "Код").Код;
	КодВторого = ЧитатьРеквизиты(Второй, "Код").Код;
	ЮТест.ОжидаетЧто(КодПервого, "Предусловие: коды справочника двух объектов различаются").НеРавно(КодВторого);

	Возврат ?(КодПервого < КодВторого, Первый, Второй);

КонецФункции

// Новый IBAN, разбитый пробелами на группы (так номер иногда сохраняют в базе).
Функция НовыйНомерСПробелами()

	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN();

	Возврат Лев(Номер, 4) + " " + Сред(Номер, 5, 5) + " " + Сред(Номер, 10);

КонецФункции

// Меняет наименование записанного контрагента (для тестов "несколько с одним названием"): фикстура дает уникальные.
Процедура ИзменитьНаименованиеКонтрагента(Контрагент, Наименование)

	Объект = Контрагент.ПолучитьОбъект();
	Объект.Наименование = Наименование;
	Объект.НаименованиеПолное = Наименование;
	Объект.Записать();

КонецПроцедуры

// Читает реквизиты ссылки запросом: Код справочника, Владелец и прочее - по списку имен через запятую.
Функция ЧитатьРеквизиты(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Данные контрагента из базы: Код (ЕДРПОУ), Наименование, ПометкаУдаления, КодСправочника (Код элемента).
Функция ДанныеКонтрагента(Контрагент)

	Данные = ЧитатьРеквизиты(Контрагент, "КодПоЕДРПОУ, Наименование, ПометкаУдаления, Код");
	Возврат Новый Структура("Код, Наименование, ПометкаУдаления, КодСправочника",
		Данные.КодПоЕДРПОУ, Данные.Наименование, Данные.ПометкаУдаления, Данные.Код);

КонецФункции

// Данные банковского счета из базы.
Функция ДанныеСчета(Счет)

	Данные = ЧитатьРеквизиты(Счет, "Владелец, НомерСчета, НомерСчетаУстаревший, ПометкаУдаления, Недействителен, Код");
	Данные.Вставить("КодСправочника", Данные.Код);
	Возврат Данные;

КонецФункции

// Данные договора из базы.
Функция ДанныеДоговора(Договор)

	Данные = ЧитатьРеквизиты(Договор, "Владелец, Организация, ПометкаУдаления, Недействителен, Код, ВидДоговора, Наименование");
	Данные.Вставить("КодСправочника", Данные.Код);
	Возврат Данные;

КонецФункции

// Сколько контрагентов (всех, в том числе помеченных) имеют ровно такой код по ЕДРПОУ.
Функция КонтрагентовСКодом(Код)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.КодПоЕДРПОУ = &Код");
	Запрос.УстановитьПараметр("Код", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Числится ли договор в регистре основных договоров контрагентов.
Функция ЕстьВРегистреОсновных(Договор)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Т ГДЕ Т.Договор = &Договор");
	Запрос.УстановитьПараметр("Договор", Договор);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество > 0;

КонецФункции

// Распознает одну операцию (контекст по правилу known-state). Результат: План, Строка (строка плана), Замечания (ее).
Функция РаспознатьОперацию(Настройки)

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки);
	План = Распознать(ТаблицаОпераций(Операция), КонтекстСОрганизацией());

	Результат = Новый Структура("План, Строка, Замечания");
	Результат.План = План;
	Результат.Строка = СтрокаПланаПоНомеру(План, Операция.ПорядковыйНомер);
	Результат.Замечания = ЗамечанияСтроки(План, Операция.ПорядковыйНомер);

	Возврат Результат;

КонецФункции

// Вызывает шаг "контрагент, счет, договор" на плане с ОДНОЙ строкой заданного вида операции. Вид задан вручную: в
// Распознать его пока выдают только шаги 0 и 6 (виды без договора выдадут шаги 5 и 7 следующих задач).
Функция РезультатШага(Настройки, ВидДокумента, ИмяВида)

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки);
	Контекст = КонтекстСОрганизацией();
	План = НовыйПлан();
	СтрокаПлана = План.Операции.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПлана, Операция);
	СтрокаПлана.Организация = Контекст.Организация;
	СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;
	СтрокаПлана.ВидДокумента = ВидДокумента;
	СтрокаПлана.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ВидДокумента + "." + ИмяВида);
	СтрокаПлана.ИсточникВидаОперации = "ПравилоНазначения";

	ВызватьШаги(План, Контекст);

	Возврат Новый Структура("План, Строка, Замечания", План, СтрокаПлана, ЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер));

КонецФункции

// Обе части задачи 4 на готовом плане: поиск счета и контрагента (до шагов 1-2), затем завершение (после шага 6).
Процедура ВызватьШаги(План, Контекст)

	Аргументы = Новый Массив;
	Аргументы.Добавить(План);
	Аргументы.Добавить(Контекст);
	Продукт("СМП_РаспознаваниеОпераций.ШагКонтрагентСчет", Аргументы);
	Продукт("СМП_РаспознаваниеОпераций.ШагЗавершение", Аргументы);

КонецПроцедуры

// Договор по умолчанию нового контрагента с видом "с покупателем" (если вид не задан): вид автоматического договора
// платформа заполняет сама, а тесты выбора договора по виду должны знать его точно.
Функция НастроитьДоговорПокупателя(Контрагент, Настройки)

	Если Не Настройки.Свойство("ВидДоговора") Тогда
		Настройки.Вставить("ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем"));
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Настройки);

КонецФункции

// Замечания строки по ровно такому полю плана; Уровень необязателен.
Функция ЗамечанияПоПолю(Замечания, Поле, Уровень = Неопределено)

	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если Замечание.Поле = Поле И (Уровень = Неопределено Или Замечание.Уровень = Уровень) Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗамечанияПоУровню(Замечания, Уровень)

	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если Замечание.Уровень = Уровень Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Замечания, относящиеся к контрагенту операции: поле начинается с "Контрагент" (Контрагент, КонтрагентКод, ...).
Функция ЗамечанияКонтрагента(Замечания)

	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Если СтрНачинаетсяС(Замечание.Поле, "Контрагент") Тогда
			Результат.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьКонтрагента(СтрокаПлана, Описание, ОжидаемыйКонтрагент, ОжидаемоеДействие)

	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, Описание + ": контрагент").Равно(ОжидаемыйКонтрагент);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеКонтрагент, Описание + ": действие над контрагентом").Равно(ОжидаемоеДействие);

КонецПроцедуры

Процедура ПроверитьСчет(СтрокаПлана, Описание, ОжидаемыйСчет, ОжидаемоеДействие)

	ЮТест.ОжидаетЧто(СтрокаПлана.СчетКонтрагента, Описание + ": счет контрагента").Равно(ОжидаемыйСчет);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеСчет, Описание + ": действие над счетом").Равно(ОжидаемоеДействие);

КонецПроцедуры

Процедура ПроверитьДоговор(СтрокаПлана, Описание, ОжидаемыйДоговор, ОжидаемоеДействие)

	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, Описание + ": договор").Равно(ОжидаемыйДоговор);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеДоговор, Описание + ": действие над договором").Равно(ОжидаемоеДействие);

КонецПроцедуры

#КонецОбласти

#Область Шаги12СвойСчетИСотрудник

// Шаг 1, перевод между своими счетами: счет контрагента операции принадлежит ТОЙ ЖЕ организации (это другой ее счет).
// Контрагента нет ("НеТребуется"), договор "НеТребуется", в счет контрагента встает наш другой счет.
Процедура Шаг1_СвойСчет_ТаЖеОрганизация_Перевод(Название, ИмяНаправления, ВидДокумента, ИмяВида) Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	Данные = ДанныеСчета(Счет);
	ЮТест.ОжидаетЧто(Данные.Владелец, Название + ": предусловие - владелец счета наша организация").Равно(Организация);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета,
		Продукт("СМП_ВыпискаБанка." + ИмяНаправления)));

	ПроверитьПереводМеждуСвоими(Результат, Название, ВидДокумента, ИмяВида, Счет);

КонецПроцедуры

// Тот же счет, найденный по устаревшему номеру.
Процедура Шаг1_СвойСчет_ПоУстаревшемуНомеру() Экспорт

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация(),
		Новый Структура("НомерСчетаУстаревший", СМП_ТестыДанныеУНФ.НовыйIBAN()));

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", УстаревшийНомерСчета(Счет)));

	ПроверитьПереводМеждуСвоими(Результат, "По устаревшему номеру", "ПоступлениеНаСчет", "ПереводСДругогоСчета", Счет);

КонецПроцедуры

// Свой счет побеждает контрагента, найденного по коду: в операции и код существующего контрагента, и номер нашего счета.
// Пара - те же данные без нашего счета: контрагент по коду находится (ШагКонтрагентСчет).
Процедура Шаг1_СвойСчет_ПобеждаетКонтрагентаПоКоду() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Код = ДанныеКонтрагента(Контрагент).Код;
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());

	Пара = РаспознатьОперацию(Новый Структура("КонтрагентКод, КонтрагентНаименование", Код, ""));
	ПроверитьКонтрагента(Пара.Строка, "Пара: без своего счета контрагент по коду находится", Контрагент, "Найден");

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование",
		НомерСчета(Счет), Код, ""));

	ПроверитьПереводМеждуСвоими(Результат, "Свой счет и код контрагента", "ПоступлениеНаСчет", "ПереводСДругогоСчета", Счет);
	ЮТест.ОжидаетЧто(ЗамечанияКонтрагента(Результат.Замечания).Количество(), "Замечаний о контрагенте, от которого отказались, нет").Равно(0);

КонецПроцедуры

// Антипаттерн "свой счет по префиксу номера": счет КОНТРАГЕНТА, номер которого начинается так же, как номер нашего
// счета, не становится переводом между своими счетами; владелец счета проверяется запросом.
Процедура Шаг1_ЧужойСчетСПохожимНомером_НеПеревод() Экспорт

	Свой = НомерСчета(СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация()));
	Хвост = ?(Прав(Свой, 4) = "0000", "1111", "0000");
	Похожий = Лев(Свой, СтрДлина(Свой) - 4) + Хвост;
	Контрагент = НовыйКонтрагентТеста();
	СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Контрагент, Новый Структура("НомерСчета", Похожий));

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", Похожий));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Счет контрагента - не свой счет").НеРавно("СвойСчет");
	ПроверитьКонтрагента(Результат.Строка, "Владелец счета - контрагент", Контрагент, "Найден");
	ПроверитьСчет(Результат.Строка, "Владелец счета - контрагент", СчетКонтрагента, "Найден");

КонецПроцедуры

// Счет организации, помеченный на удаление, своим не считается.
Процедура Шаг1_СвойСчетПомеченНаУдаление_НеПеревод() Экспорт

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация(), Новый Структура("ПометкаУдаления", Истина));
	ЮТест.ОжидаетЧто(ДанныеСчета(Счет).ПометкаУдаления, "Предусловие: счет помечен на удаление").ЭтоИстина();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", НомерСчета(Счет)));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Помеченный счет - не свой").НеРавно("СвойСчет");

КонецПроцедуры

// Счет контрагента операции - сам банковский счет выписки: перевода "на другой счет" нет, предупреждение.
Процедура Шаг1_СчетСамойВыписки_НеПеревод_Предупреждение() Экспорт

	Контекст = КонтекстСОрганизацией();
	Номер = НомерСчета(Контекст.БанковскийСчет);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Номер), "Предусловие: у счета выписки есть номер").ЭтоЛожь();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", Номер));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Счет самой выписки - не перевод между счетами").НеРавно("СвойСчет");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентНомерСчета", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Предупреждение о счете самой выписки").Равно(1);

КонецПроцедуры

// Шаг 1, другая наша организация: вид ОтНашейОрганизации / НашейОрганизации, контрагент - КонтрагентИнтеркампани этой
// организации (реквизит Контрагент банковских документов - только Контрагенты). Это НЕ перевод между своими счетами.
// Договор - по правилам завершения: вид требует договор, находится основной договор контрагента интеркампани.
Процедура Шаг1_ДругаяОрганизация_КонтрагентИнтеркампани(Название, ИмяНаправления, ВидДокумента, ИмяВида) Экспорт

	Интеркампани = НовыйКонтрагентТеста();
	Договор = НастроитьДоговорПокупателя(Интеркампани, Новый Структура("Организация, Основной", СМП_ТестыДанныеУНФ.Организация(), Истина));
	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Интеркампани));
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
	ЮТест.ОжидаетЧто(Другая <> СМП_ТестыДанныеУНФ.Организация(), Название + ": предусловие - организация другая").ЭтоИстина();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", НомерСчета(Счет),
		Продукт("СМП_ВыпискаБанка." + ИмяНаправления)));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид операции")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ВидДокумента + "." + ИмяВида));
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("НашаОрганизация");
	ЮТест.ОжидаетЧто(ТипЗнч(Строка.Контрагент), Название + ": контрагент - тип Контрагенты, не Организации")
		.Равно(Тип("СправочникСсылка.Контрагенты"));
	ПроверитьКонтрагента(Строка, Название + ": контрагент интеркампани", Интеркампани, "Найден");
	// У контрагента интеркампани нет счета с этим номером: берется счет самой организации, и об этом предупреждение.
	ПроверитьСчет(Строка, Название + ": счет другой организации", Счет, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "КонтрагентНомерСчета", УровеньПредупреждение()).Количество(),
		Название + ": предупреждение, что счет принадлежит организации, а не ее контрагенту интеркампани").Равно(1);
	ПроверитьДоговор(Строка, Название + ": договор контрагента интеркампани", Договор, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка()).Количество(), Название + ": ошибок нет").Равно(0);

КонецПроцедуры

// Власник счета - организация с ПУСТЫМ КонтрагентомИнтеркампани: контрагента платформа не создает - "Невозможно" и
// ошибка с названием организации; договор тоже "Невозможно"; вид остается видом "наша организация".
Процедура Шаг1_ДругаяОрганизация_ИнтеркампаниПуст_НевозможноИОшибка(Название, ИмяНаправления, ИмяВида) Экспорт

	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ЧитатьРеквизиты(Другая, "КонтрагентИнтеркампани").КонтрагентИнтеркампани),
		Название + ": предусловие - контрагент интеркампани пуст").ЭтоЛожь();

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", НомерСчета(Счет),
		Продукт("СМП_ВыпискаБанка." + ИмяНаправления)));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("НашаОрганизация");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид операции")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ?(ИмяНаправления = "НаправлениеПоступило", "ПоступлениеНаСчет", "РасходСоСчета") + "." + ИмяВида));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Контрагент), Название + ": контрагента нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Название + ": контрагент создать нельзя").Равно("Невозможно");
	ЮТест.ОжидаетЧто(Строка.ДействиеДоговор, Название + ": договор тоже невозможен").Равно("Невозможно");
	Ошибки = ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка());
	ЮТест.ОжидаетЧто(Ошибки.Количество(), Название + ": одна ошибка").Равно(1);
	ЮТест.ОжидаетЧто(Ошибки[0].Поле, Название + ": ошибка по полю Контрагент").Равно("Контрагент");
	ЮТест.ОжидаетЧто(Ошибки[0].Текст, Название + ": в ошибке названа организация").Содержит(ЧитатьРеквизиты(Другая, "Наименование").Наименование);

КонецПроцедуры

// Власник счета - ДРУГАЯ организация никогда не дает перевод между своими счетами (тот же счет, но чужая организация).
Процедура Шаг1_СчетДругойОрганизации_НеПереводМеждуСвоими() Экспорт

	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", НомерСчета(Счет)));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Чужая организация - не 'свой счет'").НеРавно("СвойСчет");
	ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, "Не ПереводСДругогоСчета")
		.НеРавно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ПереводСДругогоСчета"));

КонецПроцедуры

// Шаг 2: списание на счет ДЕЙСТВУЮЩЕГО сотрудника - зарплата сотруднику; контрагент - сотрудник, договор не нужен.
Процедура Шаг2_ДействующийСотрудник_ЗарплатаСотруднику() Экспорт

	Данные = НовыйСотрудникСоСчетом("Работает");

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано")));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ВидОперации, "Вид операции").Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ЗарплатаСотруднику"));
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, "Источник вида").Равно("Сотрудник");
	ЮТест.ОжидаетЧто(ТипЗнч(Строка.Контрагент), "Контрагент - сотрудник").Равно(Тип("СправочникСсылка.Сотрудники"));
	ПроверитьКонтрагента(Строка, "Сотрудник", Данные.Сотрудник, "Найден");
	ПроверитьСчет(Строка, "Счет физлица", Данные.Счет, "Найден");
	ПроверитьДоговор(Строка, "Договор не нужен", Справочники_ПустойДоговор(), "НеТребуется");
	ЮТест.ОжидаетЧто(Результат.Замечания.Количество(), "Замечаний нет").Равно(0);

КонецПроцедуры

// Review Focus 5: физлицо без действующего сотрудника - шаг не срабатывает, предупреждение (не молчание). Пара -
// действующий сотрудник тех же данных срабатывает (Шаг2_ДействующийСотрудник_ЗарплатаСотруднику).
Процедура Шаг2_НетДействующегоСотрудника_ШагНеСрабатывает(Название, Состояние, Дополнительно) Экспорт

	Настройки = Новый Структура;
	Если Дополнительно = "ДругаяОрганизация" Тогда
		Настройки.Вставить("Организация", СМП_ТестыДанныеУНФ.НоваяОрганизация());
	ИначеЕсли Дополнительно = "Недействителен" Тогда
		Настройки.Вставить("Недействителен", Истина);
	ИначеЕсли Дополнительно = "ПометкаУдаления" Тогда
		Настройки.Вставить("ПометкаУдаления", Истина);
	КонецЕсли;
	Данные = НовыйСотрудникСоСчетом(Состояние, Настройки);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано")));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": зарплатой операция не считается").НеРавно("Сотрудник");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид не ЗарплатаСотруднику")
		.НеРавно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ЗарплатаСотруднику"));
	ЮТест.ОжидаетЧто(ТипЗнч(Строка.Контрагент) = Тип("СправочникСсылка.Сотрудники"), Название + ": сотрудник контрагентом не ставится").ЭтоЛожь();
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентНомерСчета", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": одно предупреждение").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": названо физлицо").Содержит(Данные.Наименование);

КонецПроцедуры

// Поступление на счет физлица зарплатой не является, даже если оно действующий сотрудник.
Процедура Шаг2_ПоступлениеНаСчетФизлица_НеЗарплата() Экспорт

	Данные = НовыйСотрудникСоСчетом("Работает");

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеПоступило")));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Поступление - не зарплата").НеРавно("Сотрудник");
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Строка.Контрагент) = Тип("СправочникСсылка.Сотрудники"), "Сотрудник контрагентом не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка()).Количество(), "Ошибок нет").Равно(0);

КонецПроцедуры

// Счет физлица, помеченный на удаление, шагом не используется.
Процедура Шаг2_СчетФизлицаПомеченНаУдаление_ШагНеСрабатывает() Экспорт

	Данные = НовыйСотрудникСоСчетом("Работает", Неопределено, Новый Структура("ПометкаУдаления", Истина));

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано")));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Помеченный счет физлица - не основание").НеРавно("Сотрудник");

КонецПроцедуры

// Несколько действующих сотрудников одного физлица (совместительство) в организации: первый по коду справочника и
// предупреждение.
Процедура Шаг2_НесколькоДействующих_ПервыйПоКодуПредупреждение() Экспорт

	Данные = НовыйСотрудникСоСчетом("Работает");
	Второй = СМП_ТестыДанныеУНФ.НовыйСотрудник(Данные.ФизЛицо);
	Первый = МеньшийПоКодуСправочника(Данные.Сотрудник, Второй);

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано")));

	ПроверитьКонтрагента(Результат.Строка, "Первый по коду", Первый, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "Контрагент", УровеньПредупреждение()).Количество(), "Предупреждение о нескольких сотрудниках").Равно(1);

КонецПроцедуры

// Шаг 0 главнее шагов 1-2: операция уже загружена - вид, контрагент и договор из документа, свой счет их не меняет.
Процедура Шаг1_ЗагруженныйДокумент_НеПереопределяется() Экспорт

	Вид = "ПоступлениеНаСчет";
	Ключ = НовыйКлюч("С-1");
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, Вид, Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Свой = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());

	Операция = ОперацияПоКлючу(1, Ключ, Вид, Идентификатор, Новый Структура("КонтрагентНомерСчета", НомерСчета(Свой)));
	План = Распознать(ТаблицаОпераций(Операция), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Найденный документ");
	СтрокаПлана = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ВидОперации, "Вид операции из документа (по умолчанию фикстуры - от покупателя)")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"));
	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, "Контрагент из документа").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(СтрокаПлана.СчетКонтрагента, "Счет контрагента шагом 1 не ставится").Равно(Справочники_ПустойСчет());

КонецПроцедуры

// Конверт из строк разных видов: каждая строка получает свой результат, строки не смешиваются.
Процедура Шаги12_Пакет_КаждаяСтрокаСвой() Экспорт

	Свой = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
	Интеркампани = НовыйКонтрагентТеста();
	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Интеркампани));
	ЧужойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
	Сотрудник = НовыйСотрудникСоСчетом("Работает");
	Контрагент = НовыйКонтрагентТеста();
	СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Контрагент);
	Списано = Продукт("СМП_ВыпискаБанка.НаправлениеСписано");

	Операции = ТаблицаОпераций(
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", 1, НомерСчета(Свой))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", 2, НомерСчета(ЧужойСчет))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, Направление", 3, Сотрудник.НомерСчета, Списано)),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", 4, НомерСчета(СчетКонтрагента))));

	План = Распознать(Операции, КонтекстСОрганизацией());

	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 1).ИсточникВидаОперации, "Строка 1").Равно("СвойСчет");
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 1).СчетКонтрагента, "Строка 1: счет").Равно(Свой);
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 2).ИсточникВидаОперации, "Строка 2").Равно("НашаОрганизация");
	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 2), "Строка 2", Интеркампани, "Найден");
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 3).ИсточникВидаОперации, "Строка 3").Равно("Сотрудник");
	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 3), "Строка 3", Сотрудник.Сотрудник, "Найден");
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 4).ИсточникВидаОперации, "Строка 4: контрагент по счету").Равно("ПоУмолчанию");
	ПроверитьКонтрагента(СтрокаПланаПоНомеру(План, 4), "Строка 4", Контрагент, "Найден");

КонецПроцедуры

// Шаги 1-2 тоже ничего не пишут (Review Focus 3): конверт со строками всех трех видов; снимок количеств равен.
// Сначала доказывается, что шаги сработали (иначе равенство снимков ничего не значило бы).
Процедура Шаги12_НеПишутВБазу() Экспорт

	Свой = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	ЧужойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
	Сотрудник = НовыйСотрудникСоСчетом("Работает");
	Операции = ТаблицаОпераций(
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", 1, НомерСчета(Свой))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", 2, НомерСчета(ЧужойСчет))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, Направление", 3, Сотрудник.НомерСчета,
			Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))));
	Контекст = КонтекстСОрганизацией();

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	ДоФикстуры = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	План = Распознать(Операции, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	ПослеФикстуры = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 1).ИсточникВидаОперации, "Строка 1 сработала").Равно("СвойСчет");
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 2).ИсточникВидаОперации, "Строка 2 сработала").Равно("НашаОрганизация");
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 3).ИсточникВидаОперации, "Строка 3 сработала").Равно("Сотрудник");
	ЮТест.ОжидаетЧто(ПредставлениеКоличеств(После), "Количества объектов до и после шагов 1-2").Равно(ПредставлениеКоличеств(До));
	ЮТест.ОжидаетЧто(ПредставлениеКоличеств(ПослеФикстуры), "Объекты фикстуры (организации, физлица, сотрудники) до и после").Равно(ПредставлениеКоличеств(ДоФикстуры));

КонецПроцедуры

// Решение консультанта: счет другой организации ищется среди счетов ЕЕ КонтрагентаИнтеркампани по тому же номеру
// (текущему или устаревшему). Найден - он и есть СчетКонтрагента, без замечаний; счет контрагента с таким номером,
// но ДРУГОГО владельца, не берется (тогда счет самой организации и предупреждение).
Процедура Шаг1_ДругаяОрганизация_СчетКонтрагентаИнтеркампани(Название, КакойСчет, Найден) Экспорт

	Интеркампани = НовыйКонтрагентТеста();
	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Интеркампани));
	СчетОрганизации = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
	Номер = НомерСчета(СчетОрганизации);

	Если КакойСчет = "текущий номер" Тогда
		СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Интеркампани, Новый Структура("НомерСчета", Номер));
	ИначеЕсли КакойСчет = "устаревший номер" Тогда
		СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Интеркампани, Новый Структура("НомерСчетаУстаревший", Номер));
	Иначе
		// Счет с тем же номером у ДРУГОГО контрагента: не счет контрагента интеркампани.
		СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(НовыйКонтрагентТеста(), Новый Структура("НомерСчета", Номер));
	КонецЕсли;

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета", Номер));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("НашаОрганизация");
	ПроверитьКонтрагента(Строка, Название + ": контрагент интеркампани", Интеркампани, "Найден");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентНомерСчета", УровеньПредупреждение());
	Если Найден Тогда
		ПроверитьСчет(Строка, Название + ": счет контрагента интеркампани", СчетКонтрагента, "Найден");
		ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": предупреждений нет").Равно(0);
	Иначе
		ПроверитьСчет(Строка, Название + ": счет организации", СчетОрганизации, "Найден");
		ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": предупреждение о счете организации").Равно(1);
	КонецЕсли;

КонецПроцедуры

// Сотрудник ДРУГОЙ нашей организации: шаг не срабатывает, предупреждение называет ту организацию (не нашу).
Процедура Шаг2_СотрудникДругойОрганизации_ПредупреждениеНазываетОрганизацию() Экспорт

	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	Данные = НовыйСотрудникСоСчетом("Работает", Новый Структура("Организация", Другая));

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление", Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано")));

	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "КонтрагентНомерСчета", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "В тексте названа организация сотрудника")
		.Содержит(ЧитатьРеквизиты(Другая, "Наименование").Наименование);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Зарплатой операция не считается").НеРавно("Сотрудник");

КонецПроцедуры

// Перевыбор своим счетом сбрасывает ТОЛЬКО замечания поиска контрагента (КонтрагентКод и т.п.): предупреждение о коде
// из 7 цифр (ШагКонтрагентСчет) исчезает, замечание другого поля (здесь - шага 0, добавленное вручную) остается.
Процедура Шаг1_СвойСчет_СбрасываетЗамечанияПоискаКонтрагентаТолькоЕго() Экспорт

	Свой = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование",
		НомерСчета(Свой), Сред(СМП_ТестыДанныеУНФ.НовыйЕДРПОУСВедущимНулем(), 2), ""));
	Контекст = КонтекстСОрганизацией();
	План = НовыйПлан();
	СтрокаПлана = План.Операции.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПлана, Операция);
	СтрокаПлана.Организация = Контекст.Организация;
	СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;
	СтрокаПлана.ВидДокумента = "ПоступлениеНаСчет";

	Аргументы = Новый Массив;
	Аргументы.Добавить(План);
	Аргументы.Добавить(Контекст);
	Продукт("СМП_РаспознаваниеОпераций.ШагКонтрагентСчет", Аргументы);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(ЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер), "КонтрагентКод").Количество(),
		"Предусловие: поиск контрагента предупредил о коде из 7 цифр").Равно(1);
	Замечание = План.Замечания.Добавить();
	Замечание.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер;
	Замечание.Поле = "ЗагруженныйДокумент";
	Замечание.Уровень = УровеньПредупреждение();
	Замечание.Текст = "замечание другого шага";

	Продукт("СМП_РаспознаваниеОпераций.ШагСвойСчетИСотрудник", Аргументы);

	Замечания = ЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер);
	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, "Шаг 1 сработал").Равно("СвойСчет");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Замечания, "КонтрагентКод").Количество(), "Замечание о коде контрагента сброшено").Равно(0);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Замечания, "ЗагруженныйДокумент").Количество(), "Замечание другого шага осталось").Равно(1);

КонецПроцедуры

// Сброс замечаний при перевыборе шагами 1-2 (Review Important 1): на каждом из трех путей (свой счет, другая организация,
// сотрудник) замечание КАЖДОГО поля из списка сброса (Контрагент, КонтрагентКод, КонтрагентНаименование, СчетКонтрагента,
// Договор) исчезает, а замечание поля вне списка (КонтрагентНомерСчета, Направление) остается. Замечание добавляется в план
// вручную после подготовки строки: тест не зависит от того, какой шаг в продукте его порождает.
Процедура Шаги12_СбросЗамечаний_ПоПолямИПутям(Название, Путь, Поле, Сбрасывается) Экспорт

	Если Путь = "свой счет" Тогда
		НомерСчетаОперации = НомерСчета(СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация()));
		ИмяНаправления = "НаправлениеПоступило";
		ВидДокумента = "ПоступлениеНаСчет";
		ОжидаемыйИсточник = "СвойСчет";
	ИначеЕсли Путь = "другая организация" Тогда
		Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", НовыйКонтрагентТеста()));
		НомерСчетаОперации = НомерСчета(СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая));
		ИмяНаправления = "НаправлениеПоступило";
		ВидДокумента = "ПоступлениеНаСчет";
		ОжидаемыйИсточник = "НашаОрганизация";
	Иначе
		НомерСчетаОперации = НовыйСотрудникСоСчетом("Работает").НомерСчета;
		ИмяНаправления = "НаправлениеСписано";
		ВидДокумента = "РасходСоСчета";
		ОжидаемыйИсточник = "Сотрудник";
	КонецЕсли;

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("КонтрагентНомерСчета, Направление",
		НомерСчетаОперации, Продукт("СМП_ВыпискаБанка." + ИмяНаправления)));
	Контекст = КонтекстСОрганизацией();
	План = НовыйПлан();
	СтрокаПлана = План.Операции.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаПлана, Операция);
	СтрокаПлана.Организация = Контекст.Организация;
	СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;
	СтрокаПлана.ВидДокумента = ВидДокумента;
	Замечание = План.Замечания.Добавить();
	Замечание.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер;
	Замечание.Поле = Поле;
	Замечание.Уровень = УровеньПредупреждение();
	Замечание.Текст = "замечание прежнего шага";

	Аргументы = Новый Массив;
	Аргументы.Добавить(План);
	Аргументы.Добавить(Контекст);
	Продукт("СМП_РаспознаваниеОпераций.ШагСвойСчетИСотрудник", Аргументы);

	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, Название + ": шаг сработал (предусловие)").Равно(ОжидаемыйИсточник);
	// Считается именно добавленное вручную замечание (по тексту): сам шаг на пути "другая организация" добавляет свое
	// предупреждение по полю КонтрагентНомерСчета.
	Осталось = 0;
	Для Каждого Остаток Из ЗамечанияПоПолю(ЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер), Поле, УровеньПредупреждение()) Цикл
		Если Остаток.Текст = "замечание прежнего шага" Тогда
			Осталось = Осталось + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Осталось, Название + ": замечание поля " + Поле + ?(Сбрасывается, " сброшено", " осталось")).Равно(?(Сбрасывается, 0, 1));

КонецПроцедуры

// Фикстура конфликта "свой счет против правила" (для задачи 9): правило с этой фразой существует и подошло бы по
// тексту, но счет контрагента - наш другой счет, и перевод между своими счетами побеждает. Сейчас шага правил нет;
// тест станет значимым, когда он появится (и обязан остаться зеленым).
Процедура Шаг1_СвойСчет_ПобеждаетПравилоНазначения(Название, ВидДокумента, ИмяВида) Экспорт

	Конфликт = СМП_ТестыДанныеУНФ.НовыйКонфликтСвойСчетИПравило(ВидДокумента);
	ЮТест.ОжидаетЧто(СтрНайти(Конфликт.Операция.НазначениеПлатежа, Конфликт.Фраза) > 0, Название + ": предусловие - текст содержит фразу правила").ЭтоИстина();

	План = Распознать(ТаблицаОпераций(Конфликт.Операция), КонтекстСОрганизацией());

	Строка = СтрокаПланаПоНомеру(План, Конфликт.Операция.ПорядковыйНомер);
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник - свой счет, не правило").Равно("СвойСчет");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид - перевод между своими счетами")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ВидДокумента + "." + ИмяВида));
	ЮТест.ОжидаетЧто(Строка.СчетКонтрагента, Название + ": счет контрагента").Равно(Конфликт.СвойСчет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеШагов12

Функция Справочники_ПустойДоговор()

	Возврат ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");

КонецФункции

Функция Справочники_ПустойСчет()

	Возврат ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");

КонецФункции

// Результат перевода между своими счетами: вид, источник, пустой контрагент, наш другой счет, договор не нужен, замечаний нет.
Процедура ПроверитьПереводМеждуСвоими(Результат, Описание, ВидДокумента, ИмяВида, ОжидаемыйСчет)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ВидДокумента + "." + ИмяВида));
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида").Равно("СвойСчет");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Контрагент), Описание + ": контрагент не заполняется").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": контрагент не требуется").Равно("НеТребуется");
	ПроверитьСчет(Строка, Описание + ": наш другой счет", ОжидаемыйСчет, "Найден");
	ПроверитьДоговор(Строка, Описание + ": договор не нужен", Справочники_ПустойДоговор(), "НеТребуется");
	ЮТест.ОжидаетЧто(ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка()).Количество(), Описание + ": ошибок нет").Равно(0);

КонецПроцедуры

// Физлицо, его банковский счет и сотрудник (Состояние - см. СМП_ТестыДанныеУНФ.НовыйСотрудник). Дополнительно - ключи
// НовыйСотрудник (кроме Состояния); ДополнительноСчет - ключи НовыйБанковскийСчетФизЛица.
Функция НовыйСотрудникСоСчетом(Состояние, Дополнительно = Неопределено, ДополнительноСчет = Неопределено)

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();
	Настройки = Новый Структура("Состояние", Состояние);
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудник(ФизЛицо, Настройки);
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(ФизЛицо, ДополнительноСчет);

	Возврат Новый Структура("ФизЛицо, Сотрудник, Счет, НомерСчета, Наименование",
		ФизЛицо, Сотрудник, Счет, НомерСчета(Счет), ЧитатьРеквизиты(ФизЛицо, "Наименование").Наименование);

КонецФункции

#КонецОбласти

#Область Шаг3ПлатежноеПоручение

// Шаг 3 (D25), только списание: операция берет вид, статью и корреспонденцию из платежного поручения того же
// контрагента и организации, с той же суммой, датой не позже конца дня операции, не помеченного на удаление, не
// оплаченного (признак Оплачено, который вендор ставит при проведении РасходСоСчета на основании поручения) и с тем же
// номером без ведущих нулей и префикса. Все тесты "не берется" сначала доказывают, что те же данные БЕЗ отличия берутся.

// Все поля поручения, которые берет шаг, и источники. Вид операции Прочее выбран потому, что шаг 6 дал бы Поставщику.
Процедура Шаг3_Совпало_ВидСтатьяКорреспонденцияИзПоручения(Название, ШаблонПоручения, ШаблонОперации) Экспорт

	Подготовка = ПодготовкаПоручения("", 1, ШаблонПоручения, ШаблонОперации);
	Реквизиты = ЧитатьРеквизиты(Подготовка.Поручение, "Номер");
	ЮТест.ОжидаетЧто(Реквизиты.Номер, Название + ": предусловие - номер поручения записан по шаблону")
		.Равно(СтрЗаменить(ШаблонПоручения, "%", Подготовка.Номер));
	ЮТест.ОжидаетЧто(Подготовка.Операция.НомерДокумента, Название + ": предусловие - номер операции по шаблону")
		.Равно(СтрЗаменить(ШаблонОперации, "%", Подготовка.Номер));

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, Название);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение").Количество(), Название + ": замечаний о поручении нет").Равно(0);

КонецПроцедуры

// Вид операции списания - по вендорскому соответствию (РасходСоСчета.ЗаполнитьПоПлатежноеПоручение, запрос ВЫБОР ...
// КОГДА ТаблицаДокумента.ВидОперации = ...; Оплата и все остальное - Поставщику). Ожидаемые пары записаны в тест
// независимо от таблицы в модуле: сверка с вендорским кодом, а не с самим собой.
Процедура Шаг3_ВидОперации_ПоВендорскомуСоответствию(Название, ВидПоручения, ВидСписания) Экспорт

	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение." + ВидПоручения)));

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, Название + ": источник вида - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, Название + ": вид списания")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета." + ВидСписания));
	ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, Название + ": поручение в строке").Равно(Подготовка.Поручение);

КонецПроцедуры

// Дата поручения: не позже конца дня операции - берется (включая последнюю секунду), позже - нет (см. "датаПозже").
Процедура Шаг3_ДатаПоручения_ГраницаДняВключается(Название, Граница) Экспорт

	Момент = ТекущаяДатаСеанса();
	Дата = ?(Граница = "конец дня", КонецДня(Момент), НачалоДня(Момент));
	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("Дата", Дата));
	Реквизиты = ЧитатьРеквизиты(Подготовка.Поручение, "Дата");
	ЮТест.ОжидаетЧто(Реквизиты.Дата, Название + ": предусловие - дата поручения записана").Равно(Дата);

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, Название);

КонецПроцедуры

// Одно отличие - поручение не берется. Для каждого: те же данные без отличия берутся (предусловие), и отличие
// действительно записано в данные (проверяется чтением поручения).
Процедура Шаг3_ОдноОтличие_ПоручениеНеБерется(Название, Отличие) Экспорт

	Базовая = ПодготовкаПоручения();
	ПроверитьВзятоИзПоручения(Базовая, РаспознатьПодготовку(Базовая), Название + ": предусловие - без отличия поручение берется");

	Подготовка = ПодготовкаПоручения(Отличие);
	ПроверитьОтличиеЗаписано(Подготовка, Отличие, Название);

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьНеВзятоИзПоручения(Результат, Название);

КонецПроцедуры

// Дата операции берется из ДатаОперации, а не из ДатаДокумента: поручение позже даты документа, но в день операции,
// берется. Пара - "датаПозже" в Шаг3_ОдноОтличие_ПоручениеНеБерется.
Процедура Шаг3_ДатаОперации_ВАдресеДня() Экспорт

	Момент = ТекущаяДатаСеанса();
	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("Дата", Момент));
	Подготовка.Операция.ДатаДокумента = НачалоДня(Момент) - 3 * 86400;
	ЮТест.ОжидаетЧто(Подготовка.Операция.ДатаДокумента < ЧитатьРеквизиты(Подготовка.Поручение, "Дата").Дата,
		"Предусловие: дата документа банка раньше даты поручения").ЭтоИстина();

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, "Дата поручения позже даты документа, в день операции");

КонецПроцедуры

// Два кандидата с одним номером: берется тот, у которого год даты поручения совпал с годом операции; порядок создания
// и код справочника роли не играют (проверяется обоими порядками).
Процедура Шаг3_ДваКандидата_Берется_ТотУКогоСовпалГод(Название, ПрошлогоднийПервым) Экспорт

	Сдвиги = ?(ПрошлогоднийПервым, Новый Структура("А, Б", -1, 0), Новый Структура("А, Б", 0, -1));
	Подготовка = ПодготовкаГодов(Сдвиги);
	ЮТест.ОжидаетЧто(Подготовка.Поручения.Количество(), Название + ": предусловие - два поручения").Равно(2);
	Одногодний = Подготовка.Поручения[?(ПрошлогоднийПервым, 1, 0)];
	Прошлогодний = Подготовка.Поручения[?(ПрошлогоднийПервым, 0, 1)];
	ЮТест.ОжидаетЧто(Год(ЧитатьРеквизиты(Прошлогодний, "Дата").Дата), Название + ": предусловие - год прошлогоднего другой")
		.НеРавно(Год(Подготовка.Операция.ДатаОперации));
	ЮТест.ОжидаетЧто(Год(ЧитатьРеквизиты(Одногодний, "Дата").Дата), Название + ": предусловие - год другого совпадает с годом операции")
		.Равно(Год(Подготовка.Операция.ДатаОперации));

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, Название + ": взято поручение того же года").Равно(Одногодний);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение").Количество(), Название + ": замечаний нет").Равно(0);

КонецПроцедуры

// Два кандидата, год не решает (совпал у обоих или ни у одного): не берется ни одно и одно предупреждение. Предусловие -
// каждый из кандидатов по отдельности подошел бы (проверяется строкой с единственным кандидатом того же года).
Процедура Шаг3_ДваКандидата_ГодНеРешает_ЖоденИПредупреждение(Название, ГодПервого, ГодВторого) Экспорт

	Одиночный = ПодготовкаГодов(Новый Структура("А", 0));
	Одиночная = РаспознатьПодготовку(Одиночный);
	ПроверитьВзятоИзПоручения(Одиночный, Одиночная, Название + ": предусловие - единственный кандидат берется");

	Подготовка = ПодготовкаГодов(Новый Структура("А, Б", ГодПервого, ГодВторого));
	ЮТест.ОжидаетЧто(Подготовка.Поручения.Количество(), Название + ": предусловие - два поручения").Равно(2);

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьНеВзятоИзПоручения(Результат, Название);
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": одно предупреждение о нескольких поручениях").Равно(1);
	// Решение консультанта 4: в предупреждении перечень номеров и дат кандидатов.
	Для Каждого Кандидат Из Подготовка.Поручения Цикл
		Данные = ЧитатьРеквизиты(Кандидат, "Номер, Дата");
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении номер кандидата " + Данные.Номер).Содержит(Данные.Номер);
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении дата кандидата").Содержит(Формат(Данные.Дата, "ДФ=dd.MM.yyyy"));
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка()).Количество(), Название + ": ошибок нет").Равно(0);

КонецПроцедуры

// Договор из поручения подставляется в строку и не пересматривается завершением: у контрагента основной договор
// того же вида, который завершение выбрало бы без поручения (пара - оплаченное поручение: берется основной).
Процедура Шаг3_Договор_ИзПоручения_НеОсновной() Экспорт

	Контрагент = НовыйКонтрагентТеста();
	Основной = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора, Основной",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком"), Истина));
	Заданный = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком")));
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Основной), "Предусловие: основной договор числится основным").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Заданный), "Предусловие: договор поручения основным не числится").ЭтоЛожь();

	// Пара: поручение оплачено - шаг не срабатывает, завершение выбирает основной договор.
	Оплаченное = ПодготовкаПоручения("оплачено", 1, , , Новый Структура("Контрагент, Договор, ВидОперации", Контрагент, Заданный,
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Оплата")));
	Пара = РаспознатьПодготовку(Оплаченное);
	ПроверитьДоговор(Пара.Строка, "Пара: поручение не взято, договор по правилам завершения", Основной, "Найден");

	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("Контрагент, Договор, ВидОперации", Контрагент, Заданный,
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Оплата")));
	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, "Поручение взято").Равно(Подготовка.Поручение);
	ПроверитьДоговор(Результат.Строка, "Договор из поручения", Заданный, "Найден");
	ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, "Оплата - Поставщику")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));

КонецПроцедуры

// Пакет: шаг работает по каждой строке отдельно; поручения не путаются между строками.
Процедура Шаг3_Пакет_КаждаяСтрокаСвоеПоручение() Экспорт

	Первая = ПодготовкаПоручения("", 1);
	Вторая = ПодготовкаПоручения("сумма", 2);
	Третья = ПодготовкаПоручения("", 3);
	Операции = ТаблицаОпераций(Первая.Операция, Вторая.Операция, Третья.Операция);

	План = Распознать(Операции, КонтекстСОрганизацией());

	ПроверитьВзятоИзПоручения(Первая, Новый Структура("Строка", СтрокаПланаПоНомеру(План, 1)), "Строка 1");
	ПроверитьНеВзятоИзПоручения(Новый Структура("Строка", СтрокаПланаПоНомеру(План, 2)), "Строка 2 (другая сумма)");
	ПроверитьВзятоИзПоручения(Третья, Новый Структура("Строка", СтрокаПланаПоНомеру(План, 3)), "Строка 3");

КонецПроцедуры

// Сравнение суммы и контрагента в памяти нужно, а не дублирует запрос: запрос берет поручения по МНОЖЕСТВАМ контрагентов и
// сумм всего конверта, поэтому строка с чужой суммой / чужим контрагентом не должна забрать поручение, найденное для другой
// строки пакета. Чужая строка стоит ПЕРВОЙ по ПорядковыйНомер: без проверки она заняла бы поручение раньше своей.
// Предусловие: своя строка по отдельности поручение берет.
Процедура Шаг3_Пакет_ПоручениеНеПереходитКЧужойСтроке(Название, Что) Экспорт

	Подготовка = ПодготовкаПоручения();
	ПроверитьВзятоИзПоручения(Подготовка, РаспознатьПодготовку(Подготовка), Название + ": предусловие - своя строка одна берет поручение");

	Своя = КопияОперации(Подготовка.Операция, 2);
	Чужая = КопияОперации(Подготовка.Операция, 1);
	Если Что = "сумма" Тогда
		Чужая.Сумма = Подготовка.Сумма + 1;
	Иначе
		Другой = НовыйКонтрагентТеста();
		Чужая.КонтрагентКод = ДанныеКонтрагента(Другой).Код;
		ЮТест.ОжидаетЧто(Другой <> Подготовка.Контрагент, Название + ": предусловие - контрагент чужой строки другой").ЭтоИстина();
	КонецЕсли;

	План = Распознать(ТаблицаОпераций(Своя, Чужая), КонтекстСОрганизацией());

	ПроверитьВзятоИзПоручения(Подготовка, Новый Структура("Строка", СтрокаПланаПоНомеру(План, 2)), Название + ": своя строка");
	ПроверитьНеВзятоИзПоручения(Новый Структура("Строка", СтрокаПланаПоНомеру(План, 1)), Название + ": чужая строка");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(ЗамечанияСтроки(План, 1), "ПлатежноеПоручение").Количество(), Название + ": у чужой строки замечаний о поручении нет")
		.Равно(0);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(ЗамечанияСтроки(План, 2), "ПлатежноеПоручение").Количество(), Название + ": у своей строки замечаний о поручении нет")
		.Равно(0);

КонецПроцедуры

// Загруженный документ (шаг 0) решает раньше: поручение в такой строке не ищется. Пара - вторая строка того же пакета
// без документа, поручение берется.
Процедура Шаг3_ЗагруженныйДокумент_ПобеждаетПоручение() Экспорт

	Номер = НовыйЦифровойНомер();
	Ключ = НовыйКлюч(Номер);
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, "РасходСоСчета", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Контрагент, Договор, Сумма, Номер, Дата",
		Основа.Контрагент, Основа.Договор, Ключ.Сумма, "ПП-00" + Номер, Ключ.День));
	Операция = ОперацияПоКлючу(1, Ключ, "РасходСоСчета", Идентификатор,
		Новый Структура("КонтрагентКод, КонтрагентНаименование", ДанныеКонтрагента(Основа.Контрагент).Код, ""));
	Пара = ПодготовкаПоручения("", 2);

	План = Распознать(ТаблицаОпераций(Операция, Пара.Операция), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Загруженный документ");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаПланаПоНомеру(План, 1).ПлатежноеПоручение), "Поручение в загруженной строке не ищется").ЭтоЛожь();
	ПроверитьВзятоИзПоручения(Пара, Новый Структура("Строка", СтрокаПланаПоНомеру(План, 2)), "Строка без документа (пара)");

КонецПроцедуры

// Шаг только читает: поручение (признак оплаты, пометка, версия данных) после распознавания не изменилось.
Процедура Шаг3_ПоручениеНеМеняется() Экспорт

	Подготовка = ПодготовкаПоручения();
	До = ЧитатьРеквизиты(Подготовка.Поручение, "Оплачено, ПометкаУдаления, ВерсияДанных");

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, "Предусловие: поручение взято");
	После = ЧитатьРеквизиты(Подготовка.Поручение, "Оплачено, ПометкаУдаления, ВерсияДанных");
	ЮТест.ОжидаетЧто(После.Оплачено, "Признак оплаты не поставлен").Равно(До.Оплачено);
	ЮТест.ОжидаетЧто(После.ПометкаУдаления, "Пометка удаления не поставлена").Равно(До.ПометкаУдаления);
	ЮТест.ОжидаетЧто(После.ВерсияДанных, "Версия данных поручения не изменилась (записи не было)").Равно(До.ВерсияДанных);

КонецПроцедуры

// Решение консультанта 3: номер поручения с префиксом и нулями "ОР00-000123" совпадает с номером операции "123" и не
// совпадает с "1230". Одно поручение, два распознавания; порядок "не совпал" -> "совпал" доказывает, что поручение подошло бы.
Процедура Шаг3_Номер_ПрефиксСНулямиПротивЦелогоНомера() Экспорт

	Подготовка = ПодготовкаПоручения("", 1, "ОР00-000123", "1230");
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Поручение, "Номер").Номер, "Предусловие: номер поручения записан").Равно("ОР00-000123");

	Длиннее = РаспознатьПодготовку(Подготовка);
	ПроверитьНеВзятоИзПоручения(Длиннее, "Номер операции 1230");

	Подготовка.Операция.НомерДокумента = "123";
	Совпал = РаспознатьПодготовку(Подготовка);
	ПроверитьВзятоИзПоручения(Подготовка, Совпал, "Номер операции 123 (то же поручение)");

КонецПроцедуры

// Решение консультанта 5: одно поручение - одна операция, первая по ПорядковыйНомер (не по месту в таблице). Остальные,
// которым оно подходило, идут дальше по шагам с предупреждением "поручение <номер> уже сопоставлено с операцией <N>".
// Предусловие: каждая из операций по отдельности поручение берет.
Процедура Шаг3_ОдноПоручение_ОднаОперация_ПерваяПоПорядковомуНомеру(Название, МеньшийНомерВТаблицеПервым) Экспорт

	Подготовка = ПодготовкаПоручения("", 1);
	Вторая = КопияОперации(Подготовка.Операция, 2);

	Один = РаспознатьПодготовку(Подготовка);
	ПроверитьВзятоИзПоручения(Подготовка, Один, Название + ": предусловие - операция 1 одна берет поручение");
	ПодготовкаВторой = Новый Структура("Операция, Поручение, Контрагент, Номер, Сумма", Вторая, Подготовка.Поручение, Подготовка.Контрагент, Подготовка.Номер, Подготовка.Сумма);
	ПроверитьВзятоИзПоручения(ПодготовкаВторой, РаспознатьПодготовку(ПодготовкаВторой), Название + ": предусловие - операция 2 одна берет поручение");

	Операции = ?(МеньшийНомерВТаблицеПервым, ТаблицаОпераций(Подготовка.Операция, Вторая), ТаблицаОпераций(Вторая, Подготовка.Операция));
	План = Распознать(Операции, КонтекстСОрганизацией());

	ПроверитьВзятоИзПоручения(Подготовка, Новый Структура("Строка", СтрокаПланаПоНомеру(План, 1)), Название + ": операция 1");
	ПроверитьНеВзятоИзПоручения(Новый Структура("Строка", СтрокаПланаПоНомеру(План, 2)), Название + ": операция 2");
	Предупреждения = ЗамечанияПоПолю(ЗамечанияСтроки(План, 2), "ПлатежноеПоручение", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Название + ": одно предупреждение у операции 2").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении номер поручения")
		.Содержит(ЧитатьРеквизиты(Подготовка.Поручение, "Номер").Номер);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении названа операция 1").Содержит("с операцией 1");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(ЗамечанияСтроки(План, 1), "ПлатежноеПоручение").Количество(), Название + ": у операции 1 замечаний о поручении нет").Равно(0);

КонецПроцедуры

// Решение консультанта 6: поручение с другого банковского счета организации берется, но с предупреждением "поручение
// выписано с другого счета <номер>". Симметричная пара - поручение со счета выписки: предупреждения нет (в
// Шаг3_Совпало_ВидСтатьяКорреспонденцияИзПоручения и других проверяется отсутствие замечаний о поручении).
Процедура Шаг3_ПоручениеСДругогоСчета_Берется_СПредупреждением() Экспорт

	ДругойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(ДругойСчет <> КонтекстСОрганизацией().БанковскийСчет, "Предусловие: счет поручения не счет выписки").ЭтоИстина();

	Пара = ПодготовкаПоручения();
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(РаспознатьПодготовку(Пара).Замечания, "ПлатежноеПоручение").Количество(),
		"Пара: поручение со счета выписки - замечаний о поручении нет").Равно(0);

	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("БанковскийСчет", ДругойСчет));
	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, "Поручение с другого счета");
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о другом счете").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "В предупреждении номер поручения").Содержит(ЧитатьРеквизиты(Подготовка.Поручение, "Номер").Номер);

КонецПроцедуры

// Решение консультанта 7: вида поручения нет в таблице соответствия (здесь - пустой вид) -> Поставщику и предупреждение с
// видом поручения. Пара - любой вид из таблицы: такого предупреждения нет (Шаг3_ВидОперации_ПоВендорскомуСоответствию +
// отсутствие замечаний в Шаг3_Совпало_...).
Процедура Шаг3_ВидПоручения_НеВТаблице_ПоставщикуИПредупреждение() Экспорт

	Пара = ПодготовкаПоручения();
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(РаспознатьПодготовку(Пара).Замечания, "ПлатежноеПоручение").Количество(), "Пара: вид из таблицы - предупреждения нет").Равно(0);

	Пустой = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПустаяСсылка");
	Подготовка = ПодготовкаПоручения("", 1, , , Новый Структура("ВидОперации", Пустой));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ЧитатьРеквизиты(Подготовка.Поручение, "ВидОперации").ВидОперации), "Предусловие: вид поручения не заполнен").ЭтоЛожь();

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, "Поручение взято").Равно(Подготовка.Поручение);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, "Вид по умолчанию вендора - Поставщику")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение", УровеньПредупреждение()).Количество(),
		"Одно предупреждение о виде поручения").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеШага3

// Сценарий шага 3: контрагент, найденный по коду, его списание и платежное поручение к нему. Отличие - одно из значений:
// "" (все совпадает), "сумма", "суммаМеньше", "датаПозже", "оплачено", "пометкаУдаления", "контрагент", "организация",
// "номерДругой", "номерПоручениеСлева", "номерПоручениеСправа", "номерОперацияДлиннее", "номерПуст", "номерНулевой",
// "поступление", "контрагентНеНайден". Шаблоны номеров - "%" заменяется цифровым номером сценария.
// Дополнительно - ключи НовоеПлатежноеПоручение, которые заменяют значения поручения по умолчанию.
Функция ПодготовкаПоручения(Отличие = "", ПорядковыйНомер = 1, ШаблонПоручения = "ПП-00%", ШаблонОперации = "%", Дополнительно = Неопределено)

	Контрагент = ?(Дополнительно <> Неопределено И Дополнительно.Свойство("Контрагент"), Дополнительно.Контрагент, НовыйКонтрагентТеста());
	Номер = НовыйЦифровойНомер();
	Сумма = УникальнаяСумма();
	Момент = ТекущаяДатаСеанса();

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", ПорядковыйНомер);
	Операция.Вставить("Направление", Продукт("СМП_ВыпискаБанка." + ?(Отличие = "поступление", "НаправлениеПоступило", "НаправлениеСписано")));
	Операция.Вставить("КонтрагентКод", ?(Отличие = "контрагентНеНайден", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), ДанныеКонтрагента(Контрагент).Код));
	Операция.Вставить("КонтрагентНаименование", "");
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("НомерДокумента", СтрЗаменить(ШаблонОперации, "%", Номер));
	Операция.Вставить("ДатаОперации", Момент);
	Операция.Вставить("ДатаДокумента", НачалоДня(Момент));

	Поручение = Новый Структура;
	Поручение.Вставить("Контрагент", Контрагент);
	Поручение.Вставить("Сумма", Сумма);
	Поручение.Вставить("Номер", СтрЗаменить(ШаблонПоручения, "%", Номер));
	Поручение.Вставить("Дата", НачалоДня(Момент));
	Поручение.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"));
	Поручение.Вставить("Статья", СтатьяПоручения());
	Поручение.Вставить("Корреспонденция", КорреспонденцияПоручения());

	Если Отличие = "сумма" Тогда
		Поручение.Сумма = Сумма + 1;
	ИначеЕсли Отличие = "суммаМеньше" Тогда
		Поручение.Сумма = Сумма - 1;
	ИначеЕсли Отличие = "датаПозже" Тогда
		Поручение.Дата = НачалоДня(Момент) + 86400;
	ИначеЕсли Отличие = "оплачено" Тогда
		Поручение.Вставить("Оплачено", Истина);
	ИначеЕсли Отличие = "пометкаУдаления" Тогда
		Поручение.Вставить("ПометкаУдаления", Истина);
	ИначеЕсли Отличие = "контрагент" Тогда
		Поручение.Контрагент = НовыйКонтрагентТеста();
	ИначеЕсли Отличие = "организация" Тогда
		Поручение.Вставить("Организация", СМП_ТестыДанныеУНФ.НоваяОрганизация());
	ИначеЕсли Отличие = "номерДругой" Тогда
		Поручение.Номер = "ПП-00" + Формат(Число(Номер) + 1, "ЧГ=0");
	ИначеЕсли Отличие = "номерПоручениеСлева" Тогда
		// Антипаттерн ПОДОБНО "%" + номер: "1N" оканчивается номером операции N.
		Поручение.Номер = "ПП-1" + Номер;
	ИначеЕсли Отличие = "номерПоручениеСправа" Тогда
		Поручение.Номер = "ПП-" + Номер + "0";
	ИначеЕсли Отличие = "номерОперацияДлиннее" Тогда
		Операция.НомерДокумента = "1" + Номер;
	ИначеЕсли Отличие = "номерПуст" Тогда
		Операция.НомерДокумента = "";
		Поручение.Номер = "ПП-0000";
	ИначеЕсли Отличие = "номерНулевой" Тогда
		Операция.НомерДокумента = "000";
		Поручение.Номер = "ПП-0000";
	ИначеЕсли Не ПустаяСтрока(Отличие) И Отличие <> "поступление" И Отличие <> "контрагентНеНайден" Тогда
		ВызватьИсключение "ПодготовкаПоручения: неизвестное отличие '" + Отличие + "'";
	КонецЕсли;

	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Если Элемент.Ключ = "Дата" Тогда
				Поручение.Дата = Элемент.Значение;
			ИначеЕсли Элемент.Ключ <> "Контрагент" Или Отличие <> "контрагент" Тогда
				Поручение.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура("Операция, Поручение, Контрагент, Номер, Сумма");
	Результат.Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Операция);
	Результат.Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Поручение);
	Результат.Контрагент = Контрагент;
	Результат.Номер = Номер;
	Результат.Сумма = Сумма;

	Возврат Результат;

КонецФункции

// Сценарий с несколькими поручениями одного номера: Сдвиги - структура "ключ -> сдвиг года даты поручения относительно
// года операции" (0 - год операции, -1 - прошлый). Номера поручений различаются написанием (префикс, нули), а не
// цифрами. Поручения возвращаются массивом в порядке сдвигов; каждое подошло бы по всем полям, кроме года.
Функция ПодготовкаГодов(Сдвиги)

	Контрагент = НовыйКонтрагентТеста();
	Номер = НовыйЦифровойНомер();
	Сумма = УникальнаяСумма();
	Момент = ТекущаяДатаСеанса();
	Шаблоны = СтрРазделить("ПП-00%,%,00%,ЦБ-%", ",");

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, КонтрагентКод, КонтрагентНаименование, Сумма, НомерДокумента, ДатаОперации, ДатаДокумента",
		1, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), ДанныеКонтрагента(Контрагент).Код, "", Сумма, Номер, Момент, НачалоДня(Момент)));

	Поручения = Новый Массив;
	Индекс = 0;
	Для Каждого Элемент Из Сдвиги Цикл
		Настройки = Новый Структура;
		Настройки.Вставить("Контрагент", Контрагент);
		Настройки.Вставить("Сумма", Сумма);
		Настройки.Вставить("Номер", СтрЗаменить(Шаблоны[Индекс], "%", Номер));
		Настройки.Вставить("Дата", ДобавитьМесяц(Момент, 12 * Элемент.Значение));
		Настройки.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"));
		Настройки.Вставить("Статья", СтатьяПоручения());
		Настройки.Вставить("Корреспонденция", КорреспонденцияПоручения());
		Поручения.Добавить(СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Настройки));
		Индекс = Индекс + 1;
	КонецЦикла;

	Результат = Новый Структура("Операция, Поручения, Поручение, Контрагент, Номер, Сумма");
	Результат.Операция = Операция;
	Результат.Поручения = Поручения;
	Результат.Поручение = ?(Поручения.Количество() > 0, Поручения[0], Неопределено);
	Результат.Контрагент = Контрагент;
	Результат.Номер = Номер;
	Результат.Сумма = Сумма;

	Возврат Результат;

КонецФункции

// Распознает одну операцию подготовки (контекст по правилу known-state). Результат: План, Строка, Замечания.
Функция РаспознатьПодготовку(Подготовка)

	// Подготовки шага 5 могут нести собственный контекст (организация документа расчетов не та организация); остальные -
	// контекст по правилу known-state.
	Контекст = ?(Подготовка.Свойство("Контекст") И Подготовка.Контекст <> Неопределено, Подготовка.Контекст, КонтекстСОрганизацией());
	План = Распознать(ТаблицаОпераций(Подготовка.Операция), Контекст);

	Результат = Новый Структура("План, Строка, Замечания");
	Результат.План = План;
	Результат.Строка = СтрокаПланаПоНомеру(План, Подготовка.Операция.ПорядковыйНомер);
	Результат.Замечания = ЗамечанияСтроки(План, Подготовка.Операция.ПорядковыйНомер);

	Возврат Результат;

КонецФункции

// Цифровой номер сценария: шесть цифр без ведущего нуля, уникальный в прогоне (по случайной сумме).
Функция НовыйЦифровойНомер()

	Возврат Формат(100000 + Цел(УникальнаяСумма() * 100) % 900000, "ЧГ=0");

КонецФункции

Функция СтатьяПоручения()

	Возврат ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.Прочее");

КонецФункции

Функция КорреспонденцияПоручения()

	Возврат ПредопределенноеЗначение("ПланСчетов.Управленческий.РасчетыСПоставщиками");

КонецФункции

// Копия операции конверта с другим порядковым номером и новым идентификатором операции.
Функция КопияОперации(Операция, ПорядковыйНомер)

	Копия = Новый Структура;
	Для Каждого Элемент Из Операция Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Копия.ПорядковыйНомер = ПорядковыйНомер;
	Копия.ИдентификаторОперации = НовыйИдентификатор();

	Возврат Копия;

КонецФункции

// Строка плана взята из поручения: поручение, источники, вид, статья, корреспонденция, "Проверьте операцию" снята.
// Результат - структура со Строка (и Замечания для проверок замечаний).
Процедура ПроверитьВзятоИзПоручения(Подготовка, Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ПлатежноеПоручение, Описание + ": платежное поручение в строке").Равно(Подготовка.Поручение);
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции из поручения (Прочее -> Прочее)")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Прочее"));
	ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Описание + ": статья из поручения").Равно(СтатьяПоручения());
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Описание + ": источник статьи - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.Корреспонденция, Описание + ": корреспонденция из поручения").Равно(КорреспонденцияПоручения());
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.Контрагент, Описание + ": контрагент остается найденным").Равно(Подготовка.Контрагент);
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": действие над контрагентом").Равно("Найден");

КонецПроцедуры

// Поручение строкой не взято: колонки поручения пусты, источник вида и статьи не платежное поручение.
Процедура ПроверитьНеВзятоИзПоручения(Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ПлатежноеПоручение), Описание + ": платежное поручение не взято").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида не платежное поручение").НеРавно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Описание + ": источник статьи не платежное поручение").НеРавно("ПлатежноеПоручение");

КонецПроцедуры

// Отличие действительно записано в данные (иначе "не берется" могло бы быть следствием ошибки сценария).
Процедура ПроверитьОтличиеЗаписано(Подготовка, Отличие, Название)

	Реквизиты = ЧитатьРеквизиты(Подготовка.Поручение, "СуммаДокумента, Дата, Оплачено, ПометкаУдаления, Контрагент, Организация");
	Операция = Подготовка.Операция;
	Если Отличие = "сумма" Или Отличие = "суммаМеньше" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, Название + ": предусловие - сумма поручения отличается").НеРавно(Операция.Сумма);
	ИначеЕсли Отличие = "датаПозже" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.Дата > КонецДня(Операция.ДатаОперации), Название + ": предусловие - поручение позже конца дня операции").ЭтоИстина();
	ИначеЕсли Отличие = "оплачено" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.Оплачено, Название + ": предусловие - поручение оплачено").ЭтоИстина();
	ИначеЕсли Отличие = "пометкаУдаления" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, Название + ": предусловие - поручение помечено на удаление").ЭтоИстина();
	ИначеЕсли Отличие = "контрагент" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.Контрагент, Название + ": предусловие - контрагент поручения другой").НеРавно(Подготовка.Контрагент);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.Контрагент), Название + ": предусловие - контрагент поручения заполнен").ЭтоИстина();
	ИначеЕсли Отличие = "организация" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.Организация, Название + ": предусловие - организация поручения другая").НеРавно(СМП_ТестыДанныеУНФ.Организация());
	ИначеЕсли Отличие = "контрагентНеНайден" Тогда
		ЮТест.ОжидаетЧто(ПредусловиеКонтрагентНеНайден(Подготовка), Название + ": предусловие - контрагент операции в базе не найден (будет создан)").ЭтоИстина();
	ИначеЕсли Отличие = "поступление" Тогда
		ЮТест.ОжидаетЧто(Операция.Направление, Название + ": предусловие - направление поступление")
			.Равно(Продукт("СМП_ВыпискаБанка.НаправлениеПоступило"));
	КонецЕсли;

КонецПроцедуры

// Контрагент операции с таким кодом в базе не найден: распознавание без поручения даст "Создать".
Функция ПредусловиеКонтрагентНеНайден(Подготовка)

	Результат = Распознать(ТаблицаОпераций(Подготовка.Операция), КонтекстСОрганизацией());

	Возврат СтрокаПланаПоНомеру(Результат, Подготовка.Операция.ПорядковыйНомер).ДействиеКонтрагент = "Создать";

КонецФункции

#КонецОбласти

#Область Шаг4ПравилаНазначения

// Шаг 4 (D24, D25, D35.1, D35.7, D12), правила справочника СоответствияНазначенийПлатежаИРеквизитовПлатежа.
//  - совпадение: фраза содержится в назначении без учета регистра, без границ слова, без регулярных выражений
//    (семантика не меняется: на ней стоят правила пользователей);
//  - порядок - по коду справочника, первое совпавшее выигрывает; пустая фраза (в том числе из пробелов) не совпадает;
//  - правило действует для направления, у которого заполнен вид операции; для другого направления пропускается;
//  - правило дает вид операции, статью (+ ИсточникСтатьи), корреспонденцию, вид налога, проект и подразделение -
//    каждое, если заполнено; вид "Налоги" без вида налога - "Ошибка" на поле ВидНалога;
//  - помеченные на удаление правила не действуют.
// Обозначение направления в параметрах тестов: "Поступило" / "Списано".

Процедура Правило_ВсеПоляПереносятся(Название, Направление) Экспорт

	Проект = СМП_ТестыДанныеУНФ.НовыйПроект();
	Значения = ЗначенияПолейПравила();
	Значения.Проект = Проект;
	Правило = НовоеПравило(НастройкиПравила(Направление, "Налоги", Значения));
	ПроверитьПолеПравилаЗаписано(Правило, Значения, Название);

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Правило.Фраза), Направление);

	Строка = Результат.Строка;
	ПроверитьПравилоПрименено(Результат, Название, Правило, Направление, "Налоги");
	ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья из правила").Равно(Значения.СтатьяДДС);
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - правило назначения").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(Строка.Корреспонденция, Название + ": корреспонденция из правила").Равно(Значения.Корреспонденция);
	ЮТест.ОжидаетЧто(Строка.ВидНалога, Название + ": вид налога из правила (СМП_ВидНалога)").Равно(Значения.СМП_ВидНалога);
	ЮТест.ОжидаетЧто(Строка.Проект, Название + ": проект из правила").Равно(Проект);
	ЮТест.ОжидаетЧто(Строка.Подразделение, Название + ": подразделение из правила").Равно(Значения.Подразделение);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ВидНалога").Количество(), Название + ": вид налога задан - замечаний о нем нет")
		.Равно(0);

	// Пара: то же направление, но в назначении нет фразы правила - правило не действует, значение по умолчанию.
	Пара = РаспознатьПоНазначению(НазначениеБезФраз(), Направление);
	ПроверитьПравилоНеПрименено(Пара, Название + " (пара: нет фразы в назначении)");

КонецПроцедуры

// Каждое поле правила переносится само по себе и ничего лишнего: правило с одним заполненным полем (кроме вида
// операции) дает именно его, остальные поля строки плана пусты, а ИсточникСтатьи - "ПравилоНазначения" только для статьи.
Процедура Правило_ОдноПоле_ПереноситсяТолькоОно(Название, КлючПравила, КолонкаПлана) Экспорт

	Значения = ЗначенияПолейПравила();
	Значения.Проект = СМП_ТестыДанныеУНФ.НовыйПроект();
	Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура(КлючПравила, Значения[КлючПравила])));
	Для Каждого Элемент Из Значения Цикл
		Если Элемент.Ключ = КлючПравила Тогда
			ЮТест.ОжидаетЧто(Правило.Данные[Элемент.Ключ], Название + ": предусловие - поле " + Элемент.Ключ + " записано в правило")
				.Равно(Элемент.Значение);
		Иначе
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные[Элемент.Ключ]), Название + ": предусловие - поле " + Элемент.Ключ + " в правиле пусто")
				.ЭтоЛожь();
		КонецЕсли;
	КонецЦикла;

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Правило.Фраза), "Списано");

	Строка = Результат.Строка;
	ПроверитьПравилоПрименено(Результат, Название, Правило, "Списано", "Прочее");
	Для Каждого Колонка Из СтрРазделить("СтатьяДДС,Корреспонденция,ВидНалога,Проект,Подразделение", ",") Цикл
		Если Колонка = КолонкаПлана Тогда
			ЮТест.ОжидаетЧто(Строка[Колонка], Название + ": колонка " + Колонка + " взята из правила").Равно(Значения[КлючПравила]);
		Иначе
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка[Колонка]), Название + ": колонка " + Колонка + " не заполняется (в правиле пусто)").ЭтоЛожь();
		КонецЕсли;
	КонецЦикла;
	Если КолонкаПлана = "СтатьяДДС" Тогда
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - правило назначения").Равно("ПравилоНазначения");
	Иначе
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": статьи в правиле нет - источник статьи не правило").НеРавно("ПравилоНазначения");
	КонецЕсли;

КонецПроцедуры

// Правило только с видом операции: вид берется, остальные поля пусты, источник статьи не "ПравилоНазначения".
Процедура Правило_БезЗаполненныхПолей_ТолькоВидОперации(Название, Направление) Экспорт

	Правило = НовоеПравило(НастройкиПравила(Направление, "Прочее"));
	Для Каждого Поле Из СтрРазделить("СтатьяДДС,Корреспонденция,СМП_ВидНалога,Проект,Подразделение", ",") Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные[Поле]), Название + ": предусловие - поле " + Поле + " в правиле пусто").ЭтоЛожь();
	КонецЦикла;

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Правило.Фраза), Направление);

	Строка = Результат.Строка;
	ПроверитьПравилоПрименено(Результат, Название, Правило, Направление, "Прочее");
	Для Каждого Колонка Из СтрРазделить("СтатьяДДС,Корреспонденция,ВидНалога,Проект,Подразделение", ",") Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка[Колонка]), Название + ": колонка " + Колонка + " пуста").ЭтоЛожь();
	КонецЦикла;
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи не правило назначения").НеРавно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ВидНалога").Количество(), Название + ": вид не 'Налоги' - замечаний о виде налога нет")
		.Равно(0);

КонецПроцедуры

Процедура Правило_РегистрФразыНеВажен(Название, Регистр) Экспорт

	Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("Фраза", "Банківська Комісія")));
	Точный = НазначениеСФразами(Правило.Фраза);
	Измененный = ?(Регистр = "нижний", НРег(Точный), ВРег(Точный));
	ЮТест.ОжидаетЧто(СтрНайти(Измененный, Правило.Фраза), Название + ": предусловие - в измененном тексте точной фразы (с учетом регистра) нет")
		.Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ВРег(Измененный), ВРег(Правило.Фраза)) > 0, Название + ": предусловие - без учета регистра фраза в тексте есть")
		.ЭтоИстина();

	// Контроль: тот же текст с точным регистром фразы - правило действует.
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Точный, "Списано"), Название + " (контроль: точный регистр)", Правило, "Списано", "Прочее");

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Измененный, "Списано"), Название, Правило, "Списано", "Прочее");

КонецПроцедуры

// Нет границ слова (антипаттерн - менять семантику пользовательских правил): фраза, приклеенная к соседним буквам,
// совпадает. Пара - фраза, разорванная пробелом, не совпадает.
Процедура Правило_Подстрока_БезГраницСлова() Экспорт

	Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее"));
	Склеенный = НазначениеБезФраз() + "а" + Правило.Фраза + "б";
	ЮТест.ОжидаетЧто(СтрНайти(Склеенный, " " + Правило.Фраза) + СтрНайти(Склеенный, Правило.Фраза + " "),
		"Предусловие: ни слева, ни справа от фразы нет границы слова").Равно(0);
	Разорванный = НазначениеБезФраз() + " " + Лев(Правило.Фраза, 10) + " " + Сред(Правило.Фраза, 11);
	ЮТест.ОжидаетЧто(СтрНайти(Разорванный, Правило.Фраза), "Предусловие: в разорванном тексте цельной фразы нет").Равно(0);

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Склеенный, "Списано"), "Фраза внутри слова", Правило, "Списано", "Прочее");
	ПроверитьПравилоНеПрименено(РаспознатьПоНазначению(Разорванный, "Списано"), "Пара: фраза разорвана пробелом");

КонецПроцедуры

// Фраза - не регулярное выражение и не шаблон ПОДОБНО: спецсимволы читаются буквально. Для каждого: назначение с
// фразой буквально - правило действует (контроль), назначение, которое подошло бы под регулярное выражение или
// шаблон, - нет.
Процедура Правило_Спецсимволы_ТолькоБуквально(Название, Часть, Замена) Экспорт

	Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("Фраза", "Ф" + Часть + "Б")));
	Фраза = Правило.Фраза;
	Окончание = Прав(Фраза, 32);
	Буквально = НазначениеСФразами(Фраза);
	ПодМаску = НазначениеСФразами(СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Ф" + Замена + "Б_" + Окончание);
	ЮТест.ОжидаетЧто(СтрНайти(Фраза, "Ф" + Часть + "Б") > 0, Название + ": предусловие - спецсимволы записаны в фразу").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ПодМаску, Фраза), Название + ": предусловие - текст 'под маску' не содержит фразу буквально").Равно(0);

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Буквально, "Списано"), Название + " (контроль: фраза буквально)", Правило, "Списано", "Прочее");

	ПроверитьПравилоНеПрименено(РаспознатьПоНазначению(ПодМаску, "Списано"), Название + " (текст под маску)");

КонецПроцедуры

// Пустая фраза (в том числе из пробелов и табуляции) не совпадает НИКОГДА - даже с назначением из пробелов или пустым.
// Контроль в том же тесте: правило с непустой фразой и тем же видом операции действует.
Процедура Правило_ПустаяФраза_НеСовпадает(Название, Фраза, ВидНазначения) Экспорт

	Пустое = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("ФразаДословно", Фраза)));
	ЮТест.ОжидаетЧто(Пустое.Фраза, Название + ": предусловие - фраза записана дословно").Равно(Фраза);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Пустое.Фраза), Название + ": предусловие - фраза пуста по ПустаяСтрока").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Пустое.Данные.ВидОперацииРасходаСоСчета), Название + ": предусловие - у правила есть вид операции списания")
		.ЭтоИстина();
	Рабочее = НовоеПравило(НастройкиПравила("Списано", "Прочее"));
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(Рабочее.Фраза), "Списано"),
		Название + " (контроль: правило с непустой фразой действует)", Рабочее, "Списано", "Прочее");

	Если ВидНазначения = "обычное" Тогда
		// Пробел и табуляция с пробелом в тексте есть: наивное "содержит" совпало бы.
		Назначение = НазначениеБезФраз() + " оплата за" + Символы.Таб + " период";
	ИначеЕсли ВидНазначения = "пробелы" Тогда
		Назначение = "   ";
	Иначе
		Назначение = "";
	КонецЕсли;

	Результат = РаспознатьПоНазначению(Назначение, "Списано");

	ПроверитьПравилоНеПрименено(Результат, Название);

КонецПроцедуры

// Пропуск пустой фразы - пропуск, а не остановка: правило с пустой фразой и меньшим кодом не мешает следующему.
Процедура Правило_ПустаяФразаПерваяПоКоду_СледующееРаботает(Название, Фраза) Экспорт

	Пустое = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("ФразаДословно, Код", Фраза, "ЯЯЯ01")));
	Рабочее = НовоеПравило(НастройкиПравила("Списано", "ПрочиеРасчеты", Новый Структура("Код", "ЯЯЯ02")));
	ЮТест.ОжидаетЧто(Пустое.Код < Рабочее.Код, Название + ": предусловие - у правила с пустой фразой код меньше").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Пустое.Фраза), Название + ": предусловие - фраза пуста").ЭтоИстина();

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Рабочее.Фраза), "Списано");

	ПроверитьПравилоПрименено(Результат, Название, Рабочее, "Списано", "ПрочиеРасчеты");

КонецПроцедуры

// Два и больше правил совпали: выигрывает меньший код справочника. Коды заданы тестом и НЕ в порядке создания
// (в трех из четырех вариантов), поэтому порядок создания, ссылки или платформы по умолчанию не подходят. Победитель
// определяется чтением кодов из базы. Контроль: каждое проигравшее правило по отдельности действует.
Процедура Правило_НесколькоСовпавших_ВыигрываетМеньшийКод(Название, Коды) Экспорт

	СписокКодов = СтрРазделить(Коды, ",");
	Виды = СтрРазделить("Прочее,ПрочиеРасчеты,НаРасходы", ",");
	Правила = Новый Массив;
	Для Индекс = 0 По СписокКодов.ВГраница() Цикл
		Правила.Добавить(НовоеПравило(НастройкиПравила("Списано", Виды[Индекс], Новый Структура("Код", СписокКодов[Индекс]))));
	КонецЦикла;

	ИндексПобедителя = 0;
	Фразы = Новый Массив;
	Для Индекс = 0 По Правила.ВГраница() Цикл
		Фразы.Добавить(Правила[Индекс].Фраза);
		Если Правила[Индекс].Код < Правила[ИндексПобедителя].Код Тогда
			ИндексПобедителя = Индекс;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Правила[ИндексПобедителя].Код, Название + ": предусловие - коды записаны как заданы, меньший - 'ЯЯЯ01'").Равно("ЯЯЯ01");

	// Контроль: каждое правило само по себе действует и дает свой вид.
	Для Индекс = 0 По Правила.ВГраница() Цикл
		ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(Правила[Индекс].Фраза), "Списано"),
			Название + " (контроль: правило " + Правила[Индекс].Код + " одно)", Правила[Индекс], "Списано", Виды[Индекс]);
	КонецЦикла;

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Фразы), "Списано");

	ПроверитьПравилоПрименено(Результат, Название, Правила[ИндексПобедителя], "Списано", Виды[ИндексПобедителя]);

КонецПроцедуры

// Правило без вида для направления операции пропускается; пара - то же правило для "своего" направления действует.
Процедура Правило_ДругоеНаправление_Пропускается(Название, Направление) Экспорт

	Другое = ДругоеНаправление(Направление);
	Правило = НовоеПравило(НастройкиПравила(Другое, "Прочее"));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные[КлючВидаПравила(Направление)]),
		Название + ": предусловие - у правила нет вида для направления операции").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные[КлючВидаПравила(Другое)]),
		Название + ": предусловие - вид есть для другого направления").ЭтоИстина();
	Назначение = НазначениеСФразами(Правило.Фраза);

	// Контроль: то же правило, тот же текст, направление, для которого вид заполнен, - действует.
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, Другое), Название + " (контроль: свое направление)", Правило, Другое, "Прочее");

	Результат = РаспознатьПоНазначению(Назначение, Направление);

	ПроверитьПравилоНеПрименено(Результат, Название);

КонецПроцедуры

// Пропуск чужого направления - пропуск, а не остановка: правило с меньшим кодом для другого направления не мешает
// следующему. Контроль: в другом направлении первое (меньший код) побеждает.
Процедура Правило_ДругоеНаправлениеПерваяПоКоду_СледующееПодходит(Название, Направление) Экспорт

	Другое = ДругоеНаправление(Направление);
	Первое = НовоеПравило(НастройкиПравила(Другое, "Прочее", Новый Структура("Код", "ЯЯЯ01")));
	Второе = НовоеПравило(НастройкиПравила(Направление, "ПрочиеРасчеты", Новый Структура("Код", "ЯЯЯ02")));
	ЮТест.ОжидаетЧто(Первое.Код < Второе.Код, Название + ": предусловие - у правила другого направления код меньше").ЭтоИстина();
	Назначение = НазначениеСФразами(Новый Структура("Первая, Вторая", Первое.Фраза, Второе.Фраза));

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, Другое), Название + " (контроль: в другом направлении побеждает первое по коду)",
		Первое, Другое, "Прочее");

	Результат = РаспознатьПоНазначению(Назначение, Направление);

	ПроверитьПравилоПрименено(Результат, Название, Второе, Направление, "ПрочиеРасчеты");

КонецПроцедуры

// Правило с видами для обоих направлений действует в обоих и в каждом дает вид этого направления.
Процедура Правило_ОбоихНаправлений_КаждомуСвойВид() Экспорт

	Правило = НовоеПравило(НастройкиПравила("Поступило", "ПрочиеРасчеты", НастройкиПравила("Списано", "Прочее")));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные.ВидОперацииПоступленияНаСчет) И ЗначениеЗаполнено(Правило.Данные.ВидОперацииРасходаСоСчета),
		"Предусловие: у правила оба вида").ЭтоИстина();
	Назначение = НазначениеСФразами(Правило.Фраза);

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, "Поступило"), "Поступление", Правило, "Поступило", "ПрочиеРасчеты");
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, "Списано"), "Списание", Правило, "Списано", "Прочее");

КонецПроцедуры

// Правило без вида операции не действует ни для какого направления, даже если в нем заполнены статья и корреспонденция.
// Контроль: то же правило с видом для направления действует.
Процедура Правило_БезВидаОперации_НеДействует(Название, Направление) Экспорт

	Значения = Новый Структура("СтатьяДДС, Корреспонденция", СтатьяПоручения(), КорреспонденцияПоручения());
	Без = НовоеПравило(Значения);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Без.Данные.ВидОперацииПоступленияНаСчет) Или ЗначениеЗаполнено(Без.Данные.ВидОперацииРасходаСоСчета),
		Название + ": предусловие - у правила нет ни одного вида операции").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Без.Данные.СтатьяДДС), Название + ": предусловие - статья в правиле заполнена").ЭтоИстина();
	С_Видом = НовоеПравило(НастройкиПравила(Направление, "Прочее", Значения));
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(С_Видом.Фраза), Направление),
		Название + " (контроль: то же с видом операции)", С_Видом, Направление, "Прочее");

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Без.Фраза), Направление);

	ПроверитьПравилоНеПрименено(Результат, Название);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.СтатьяДДС), Название + ": статья правила без вида не берется").ЭтоЛожь();

КонецПроцедуры

// Правило, помеченное на удаление, не действует и не мешает следующему. Контроль: то же правило без пометки (меньший код)
// побеждает.
Процедура Правило_ПомеченноеНаУдаление_НеДействует(Название, Направление) Экспорт

	Помеченное = НовоеПравило(НастройкиПравила(Направление, "Прочее", Новый Структура("Код, ПометкаУдаления", "ЯЯЯ01", Истина)));
	Живое = НовоеПравило(НастройкиПравила(Направление, "ПрочиеРасчеты", Новый Структура("Код", "ЯЯЯ02")));
	ЮТест.ОжидаетЧто(Помеченное.Данные.ПометкаУдаления, Название + ": предусловие - правило помечено на удаление").ЭтоИстина();
	ЮТест.ОжидаетЧто(Живое.Данные.ПометкаУдаления, Название + ": предусловие - второе правило не помечено").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Помеченное.Код < Живое.Код, Название + ": предусловие - у помеченного код меньше").ЭтоИстина();

	// Контроль: такая же пара, но без пометки у первого, - первое побеждает по меньшему коду.
	Непомеченное = НовоеПравило(НастройкиПравила(Направление, "Прочее", Новый Структура("Код", "ЯЯЯ03")));
	ЖивоеДва = НовоеПравило(НастройкиПравила(Направление, "ПрочиеРасчеты", Новый Структура("Код", "ЯЯЯ04")));
	ЮТест.ОжидаетЧто(Непомеченное.Данные.ПометкаУдаления, Название + ": предусловие контроля - пометки нет").ЭтоЛожь();
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(Новый Структура("Первая, Вторая", Непомеченное.Фраза, ЖивоеДва.Фраза)), Направление),
		Название + " (контроль: без пометки побеждает меньший код)", Непомеченное, Направление, "Прочее");

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Новый Структура("Первая, Вторая", Помеченное.Фраза, Живое.Фраза)), Направление);

	ПроверитьПравилоПрименено(Результат, Название, Живое, Направление, "ПрочиеРасчеты");

КонецПроцедуры

// D12: правило с видом "Налоги" без вида налога - "Ошибка" на поле ВидНалога (документ будет непроведенным); правило при
// этом применяется. Пары: с видом налога ошибки нет и вид налога переносится; с видом операции "Прочее" без вида налога
// ошибки нет.
Процедура Правило_Налоги_БезВидаНалога_Ошибка(Название, Направление) Экспорт

	ВидНалога = ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы");
	Без = НовоеПравило(НастройкиПравила(Направление, "Налоги"));
	С_Налогом = НовоеПравило(НастройкиПравила(Направление, "Налоги", Новый Структура("СМП_ВидНалога", ВидНалога)));
	НеНалог = НовоеПравило(НастройкиПравила(Направление, "Прочее"));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Без.Данные.СМП_ВидНалога), Название + ": предусловие - вида налога в правиле нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(С_Налогом.Данные.СМП_ВидНалога, Название + ": предусловие - в парном правиле вид налога есть").Равно(ВидНалога);

	// Пары (то же направление и текст, одно отличие).
	Пара1 = РаспознатьПоНазначению(НазначениеСФразами(С_Налогом.Фраза), Направление);
	ПроверитьПравилоПрименено(Пара1, Название + " (пара: вид налога задан)", С_Налогом, Направление, "Налоги");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Пара1.Замечания, "ВидНалога").Количество(), Название + " (пара: вид налога задан) - замечаний о виде налога нет")
		.Равно(0);
	ЮТест.ОжидаетЧто(Пара1.Строка.ВидНалога, Название + " (пара: вид налога задан) - вид налога перенесен").Равно(ВидНалога);
	Пара2 = РаспознатьПоНазначению(НазначениеСФразами(НеНалог.Фраза), Направление);
	ПроверитьПравилоПрименено(Пара2, Название + " (пара: вид операции не 'Налоги')", НеНалог, Направление, "Прочее");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Пара2.Замечания, "ВидНалога").Количество(), Название + " (пара: вид операции не 'Налоги') - замечаний о виде налога нет")
		.Равно(0);

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Без.Фраза), Направление);

	ПроверитьПравилоПрименено(Результат, Название, Без, Направление, "Налоги");
	Ошибки = ЗамечанияПоПолю(Результат.Замечания, "ВидНалога", УровеньОшибка());
	ЮТест.ОжидаетЧто(Ошибки.Количество(), Название + ": ровно одна ошибка на поле ВидНалога").Равно(1);
	Если Ошибки.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(ПустаяСтрока(Ошибки[0].Текст), Название + ": у ошибки есть текст").ЭтоЛожь();
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ВидНалога), Название + ": вид налога в строке пуст").ЭтоЛожь();

КонецПроцедуры

// Шаг 3 раньше шага 4: у списания есть платежное поручение и подходящее правило - берется поручение, правило не
// записывается. Пара: такая же операция без поручения - правило действует.
Процедура Правило_ПлатежноеПоручение_ПобеждаетПравило() Экспорт

	ВидНалога = ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы");
	Правило = НовоеПравило(НастройкиПравила("Списано", "Налоги", Новый Структура("СМП_ВидНалога", ВидНалога)));
	Назначение = НазначениеСФразами(Правило.Фраза);
	Подготовка = ПодготовкаПоручения();
	Подготовка.Операция.НазначениеПлатежа = Назначение;

	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, "Списано"), "Пара: операция без поручения", Правило, "Списано", "Налоги");

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьВзятоИзПоручения(Подготовка, Результат, "Поручение раньше правила");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ПравилоНазначения), "Правило в строке с поручением не записано").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ВидНалога), "Вид налога правила в строке с поручением не записан").ЭтоЛожь();

КонецПроцедуры

// Шаг 0 раньше шага 4: у найденного загруженного документа правило не записывается. Пара - вторая строка того же
// конверта (документа нет) с тем же назначением получает правило.
Процедура Правило_ЗагруженныйДокумент_ПобеждаетПравило() Экспорт

	Правило = НовоеПравило(НастройкиПравила("Списано", "Налоги", Новый Структура("СМП_ВидНалога", ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы"))));
	Назначение = НазначениеСФразами(Правило.Фраза);
	Номер = НовыйЦифровойНомер();
	Ключ = НовыйКлюч(Номер);
	Идентификатор = НовыйИдентификатор();
	Основа = ДокументПоКлючу(Ключ, "РасходСоСчета", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Операция = ОперацияПоКлючу(1, Ключ, "РасходСоСчета", Идентификатор,
		Новый Структура("КонтрагентКод, КонтрагентНаименование, НазначениеПлатежа", ДанныеКонтрагента(Основа.Контрагент).Код, "", Назначение));
	Вторая = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, НазначениеПлатежа",
		2, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), Назначение));

	План = Распознать(ТаблицаОпераций(Операция, Вторая), КонтекстСОрганизацией());

	ПроверитьНайден(План, 1, Основа.Ссылка, "Загруженный документ");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаПланаПоНомеру(План, 1).ПравилоНазначения), "Правило в строке с загруженным документом не записано").ЭтоЛожь();
	Строка2 = СтрокаПланаПоНомеру(План, 2);
	ЮТест.ОжидаетЧто(Строка2.ИсточникВидаОперации, "Пара: источник вида второй строки - правило").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(Строка2.ПравилоНазначения, "Пара: правило второй строки").Равно(Правило.Правило);

КонецПроцедуры

// Шаг 2 раньше шага 4: счет действующего сотрудника - зарплата сотруднику, правило не записывается. Пара - операция с
// другим контрагентом и тем же назначением получает правило.
Процедура Правило_Сотрудник_ПобеждаетПравило() Экспорт

	Данные = НовыйСотрудникСоСчетом("Работает");
	Правило = НовоеПравило(НастройкиПравила("Списано", "Налоги", Новый Структура("СМП_ВидНалога", ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы"))));
	Назначение = НазначениеСФразами(Правило.Фраза);
	ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, "Списано"), "Пара: обычный контрагент", Правило, "Списано", "Налоги");

	Результат = РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, Направление, НазначениеПлатежа",
		Данные.НомерСчета, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), Назначение));

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида - сотрудник, не правило").Равно("Сотрудник");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ПравилоНазначения), "Правило в строке сотрудника не записано").ЭтоЛожь();

КонецПроцедуры

// Пакет: у каждой строки свой результат; правило одного направления не забирает строку другого направления.
Процедура Правило_Пакет_КаждаяСтрокаСвоеПравило() Экспорт

	ПравилоА = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("СтатьяДДС", СтатьяПоручения())));
	ПравилоБ = НовоеПравило(НастройкиПравила("Поступило", "ПрочиеРасчеты", Новый Структура("Корреспонденция", КорреспонденцияПоручения())));

	Таблица = ТаблицаОпераций(
		ОперацияСНазначением(1, "Списано", НазначениеСФразами(ПравилоА.Фраза)),
		ОперацияСНазначением(2, "Поступило", НазначениеСФразами(ПравилоБ.Фраза)),
		ОперацияСНазначением(3, "Списано", НазначениеСФразами(ПравилоБ.Фраза)),
		ОперацияСНазначением(4, "Поступило", НазначениеСФразами(ПравилоА.Фраза)));

	План = Распознать(Таблица, КонтекстСОрганизацией());

	Строка1 = СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(Строка1.ПравилоНазначения, "Строка 1 (списание, фраза А): правило А").Равно(ПравилоА.Правило);
	ЮТест.ОжидаетЧто(Строка1.ВидОперации, "Строка 1: вид из правила А").Равно(ВидПоНаправлению("Списано", "Прочее"));
	ЮТест.ОжидаетЧто(Строка1.СтатьяДДС, "Строка 1: статья из правила А").Равно(СтатьяПоручения());
	Строка2 = СтрокаПланаПоНомеру(План, 2);
	ЮТест.ОжидаетЧто(Строка2.ПравилоНазначения, "Строка 2 (поступление, фраза Б): правило Б").Равно(ПравилоБ.Правило);
	ЮТест.ОжидаетЧто(Строка2.ВидОперации, "Строка 2: вид из правила Б").Равно(ВидПоНаправлению("Поступило", "ПрочиеРасчеты"));
	ЮТест.ОжидаетЧто(Строка2.Корреспонденция, "Строка 2: корреспонденция из правила Б").Равно(КорреспонденцияПоручения());
	Для Каждого НомерСтроки Из СтрРазделить("3,4", ",") Цикл
		Строка = СтрокаПланаПоНомеру(План, Число(НомерСтроки));
		ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, "Строка " + НомерСтроки + " (правило другого направления): значение по умолчанию")
			.Равно("ПоУмолчанию");
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ПравилоНазначения), "Строка " + НомерСтроки + ": правило не записано").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Распознавание правила не меняет и не создает: количество правил, версия данных правила и пометка удаления прежние.
// Пара: создание правила снимок количества видит.
Процедура Правило_НеПишетВБазу() Экспорт

	Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее"));
	ЧислоПравил = ПравилаВБазе().Количество();
	До = ЧитатьРеквизиты(Правило.Правило, "ВерсияДанных, ПометкаУдаления");

	Результат = РаспознатьПоНазначению(НазначениеСФразами(Правило.Фраза), "Списано");

	ПроверитьПравилоПрименено(Результат, "Предусловие: правило сработало", Правило, "Списано", "Прочее");
	ЮТест.ОжидаетЧто(ПравилаВБазе().Количество(), "Количество правил после распознавания").Равно(ЧислоПравил);
	После = ЧитатьРеквизиты(Правило.Правило, "ВерсияДанных, ПометкаУдаления");
	ЮТест.ОжидаетЧто(После.ВерсияДанных, "Версия данных правила не изменилась (записи не было)").Равно(До.ВерсияДанных);
	ЮТест.ОжидаетЧто(После.ПометкаУдаления, "Пометка удаления правила не изменилась").Равно(До.ПометкаУдаления);

	// Пара: снимок количества видит запись.
	НовоеПравило(Новый Структура);
	ЮТест.ОжидаетЧто(ПравилаВБазе().Количество(), "Пара: после создания правила количество на единицу больше").Равно(ЧислоПравил + 1);

КонецПроцедуры

#Область ТиповыеПравила

// ЗаполнитьТиповыеПравила пишет в базу: вызывается ТОЛЬКО внутри транзакции теста (все тесты ниже - .ВТранзакции()).
// Все они начинаются с предусловия: в базе нет живых правил с типовыми фразами (иначе "добавлено" и "распознано"
// измеряли бы правила пользователя, а не типовые). Предусловие падает громко, с названием фразы.

// Фразы комиссии из нынешнего кода (СМП_КлиентБанк, ПроверитьВидОперации: ЕстьСловаОРасчетномОбслуживании), русские и
// украинские. "Комiсiя за виконання платежiв" - с латинскими "i", как в банковском тексте и в нынешнем коде.
Функция ТиповыеФразыКомиссии()

	Фразы = Новый Массив;
	Фразы.Добавить("Розрахункове обслуговування");
	Фразы.Добавить("Расчетное обслуживание");
	Фразы.Добавить("Расчётное обслуживание");
	Фразы.Добавить("Розрахункові послуги");
	Фразы.Добавить("Расчетные услуги");
	Фразы.Добавить("Расчётные услуги");
	Фразы.Добавить("Розрахунково-касове обслуговування");
	Фразы.Добавить("Комiсiя за виконання платежiв");
	// Кириллический вариант (решение консультанта 2): стартовые данные рядом с латинским.
	Фразы.Добавить("Комісія за виконання платежів");
	Возврат Фразы;

КонецФункции

Функция ТиповыеФразыВозвратов()

	Фразы = Новый Массив;
	Фразы.Добавить("Повернення");
	Фразы.Добавить("Возврат");
	Возврат Фразы;

КонецФункции

Функция ВсеТиповыеФразы()

	Фразы = ТиповыеФразыКомиссии();
	Для Каждого Фраза Из ТиповыеФразыВозвратов() Цикл
		Фразы.Добавить(Фраза);
	КонецЦикла;
	Возврат Фразы;

КонецФункции

// Назначения платежа с комиссией банка. ВНИМАНИЕ: в репозитории и материалах исследования нет ни одного полного
// реального назначения платежа с комиссией (проверено поиском по docs, temp, epf, tests); единственный реальный
// банковский материал - формулировки из нынешнего кода (с латинскими "i"). Поэтому здесь ТОЛЬКО эти формулировки без
// придуманного окружения; замена на знеособлені назначения из выписок банка - задача владельца (вопрос в отчете).
Функция НазначенияКомиссии()

	Назначения = Новый Массив;
	Назначения.Добавить("Комiсiя за виконання платежiв");
	Назначения.Добавить("Розрахунково-касове обслуговування");
	Назначения.Добавить(ВРег("Комiсiя за виконання платежiв"));
	Назначения.Добавить("Комісія за виконання платежів");
	Возврат Назначения;

КонецФункции

Процедура ТиповыеПравила_ПервыйВызов_ДобавляетСтартовыеСтроки() Экспорт

	ПредусловиеНетТиповыхПравил("Первый вызов");
	Ожидаемо = ВсеТиповыеФразы().Количество();
	ДоВсего = ПравилаВБазе().Количество();

	Добавлено = ЗаполнитьТиповые();

	ЮТест.ОжидаетЧто(Добавлено, "Функция вернула количество добавленных строк").Равно(Ожидаемо);
	ЮТест.ОжидаетЧто(ПравилаВБазе().Количество() - ДоВсего, "В справочнике прибавилось столько же строк").Равно(Ожидаемо);
	Для Каждого Фраза Из ТиповыеФразыКомиссии() Цикл
		Живые = ЖивыеПравилаСФразой(Фраза);
		ЮТест.ОжидаетЧто(Живые.Количество(), "Комиссия '" + Фраза + "': одна строка").Равно(1);
		Если Живые.Количество() = 1 Тогда
			ЮТест.ОжидаетЧто(Живые[0].ВидРасхода, "Комиссия '" + Фраза + "': вид списания - Прочее")
				.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Прочее"));
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Живые[0].ВидПоступления), "Комиссия '" + Фраза + "': для поступления вида нет").ЭтоЛожь();
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Живые[0].СтатьяДДС) Или ЗначениеЗаполнено(Живые[0].Корреспонденция)
				Или ЗначениеЗаполнено(Живые[0].Проект) Или ЗначениеЗаполнено(Живые[0].Подразделение) Или ЗначениеЗаполнено(Живые[0].ВидНалога),
				"Комиссия '" + Фраза + "': остальные поля пусты (как зараз - только вид)").ЭтоЛожь();
		КонецЕсли;
	КонецЦикла;
	Для Каждого Фраза Из ТиповыеФразыВозвратов() Цикл
		Живые = ЖивыеПравилаСФразой(Фраза);
		ЮТест.ОжидаетЧто(Живые.Количество(), "Возврат '" + Фраза + "': одна строка").Равно(1);
		Если Живые.Количество() = 1 Тогда
			ЮТест.ОжидаетЧто(Живые[0].ВидПоступления, "Возврат '" + Фраза + "': вид поступления - ОтПоставщика")
				.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПоставщика"));
			ЮТест.ОжидаетЧто(Живые[0].ВидРасхода, "Возврат '" + Фраза + "': вид списания - Покупателю")
				.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Покупателю"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Идемпотентность по фразе: второй вызов добавляет 0 строк и ничего не меняет. Пара - первый вызов добавил > 0.
Процедура ТиповыеПравила_ПовторныйВызов_ДобавляетНоль() Экспорт

	ПредусловиеНетТиповыхПравил("Повторный вызов");

	Первый = ЗаполнитьТиповые();
	ВсегоПосле = ПравилаВБазе().Количество();
	Второй = ЗаполнитьТиповые();

	ЮТест.ОжидаетЧто(Первый > 0, "Пара: первый вызов добавил строки").ЭтоИстина();
	ЮТест.ОжидаетЧто(Второй, "Повторный вызов добавил 0 строк").Равно(0);
	ЮТест.ОжидаетЧто(ПравилаВБазе().Количество(), "Количество строк после повторного вызова не изменилось").Равно(ВсегоПосле);
	Для Каждого Фраза Из ВсеТиповыеФразы() Цикл
		ЮТест.ОжидаетЧто(ЖивыеПравилаСФразой(Фраза).Количество(), "Фраза '" + Фраза + "': по-прежнему одна строка").Равно(1);
	КонецЦикла;

КонецПроцедуры

// Строка с такой же фразой (в том числе в другом регистре - сравнение без учета регистра, как и совпадение при
// распознавании) не дублируется и не меняется: правило пользователя остается как было.
Процедура ТиповыеПравила_ПравилоСТойЖеФразой_НеДублируется(Название, Вариант) Экспорт

	ПредусловиеНетТиповыхПравил(Название);
	ФразаПользователя = ?(Вариант = "ТакаяЖе", "Повернення", ВРег("Повернення"));
	Пользовательское = НовоеПравило(Новый Структура("ФразаДословно, ВидОперацииРасходаСоСчета", ФразаПользователя,
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Прочее")));
	Ожидаемо = ВсеТиповыеФразы().Количество() - 1;

	Добавлено = ЗаполнитьТиповые();

	ЮТест.ОжидаетЧто(Добавлено, Название + ": добавлены все типовые фразы, кроме уже существующей").Равно(Ожидаемо);
	Живые = ЖивыеПравилаСФразой("Повернення");
	ЮТест.ОжидаетЧто(Живые.Количество(), Название + ": строка с этой фразой по-прежнему одна").Равно(1);
	Если Живые.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Живые[0].Ссылка, Название + ": это строка пользователя").Равно(Пользовательское.Правило);
		ЮТест.ОжидаетЧто(Живые[0].ВидРасхода, Название + ": вид списания пользователя не изменен")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Прочее"));
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Живые[0].ВидПоступления), Название + ": вид поступления пользователя не дописан").ЭтоЛожь();
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЖивыеПравилаСФразой("Возврат").Количество(), Название + ": остальные типовые фразы добавлены").Равно(1);

КонецПроцедуры

// Решение консультанта 4: правило с такой же фразой, помеченное на удаление, СЧИТАЕТСЯ существующим - пометка является
// решением человека, команда его не воскрешает. Типовая строка с этой фразой не добавляется, пользовательская остается
// помеченной и нетронутой; остальные типовые фразы добавляются (контроль: команда работала).
Процедура ТиповыеПравила_ПравилоСТойЖеФразойПомеченоНаУдаление_ТиповоеНеДобавляется() Экспорт

	ПредусловиеНетТиповыхПравил("Помеченное на удаление");
	Помеченное = НовоеПравило(Новый Структура("ФразаДословно, ПометкаУдаления, ВидОперацииРасходаСоСчета", "Повернення", Истина,
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Прочее")));
	ЮТест.ОжидаетЧто(Помеченное.Данные.ПометкаУдаления, "Предусловие: правило пользователя помечено на удаление").ЭтоИстина();

	Добавлено = ЗаполнитьТиповые();

	ЮТест.ОжидаетЧто(Добавлено, "Добавлены все типовые фразы, кроме фразы помеченного правила")
		.Равно(ВсеТиповыеФразы().Количество() - 1);
	ЮТест.ОжидаетЧто(ЖивыеПравилаСФразой("Повернення").Количество(), "Живой строки с фразой помеченного правила нет").Равно(0);
	ЮТест.ОжидаетЧто(ПравилаСФразойВключаяПомеченные("Повернення").Количество(), "Строка с этой фразой по-прежнему одна (пользовательская)").Равно(1);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Помеченное.Правило, "ПометкаУдаления").ПометкаУдаления, "Правило пользователя осталось помеченным").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЖивыеПравилаСФразой("Возврат").Количество(), "Контроль: остальные типовые фразы добавлены").Равно(1);

КонецПроцедуры

// Решение консультанта 7: ни фраза, ни назначение не обрезаются (нынешний запрос обрезал фразу до 1024 знаков -
// артефакт ВЫРАЗИТЬ, не семантика). Случай "назначение": фраза стоит после 1024-го знака назначения - совпадение есть.
// Случай "фраза": фраза длиннее 1024 знаков совпадает целиком, а назначение с ее первыми 1024 знаками - нет.
Процедура Правило_ДлинныеТексты_НеОбрезаются(Название, Что) Экспорт

	Если Что = "назначение" Тогда
		Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее"));
		Назначение = НазначениеБезФраз() + " " + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + ДлиннаяСтрока("ж", 1100) + " " + Правило.Фраза;
		ЮТест.ОжидаетЧто(СтрНайти(Назначение, Правило.Фраза) > 1024, Название + ": предусловие - фраза начинается после 1024-го знака назначения")
			.ЭтоИстина();
		// Контроль: то же правило с коротким назначением действует.
		ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(Правило.Фраза), "Списано"), Название + " (контроль: короткое назначение)",
			Правило, "Списано", "Прочее");

		ПроверитьПравилоПрименено(РаспознатьПоНазначению(Назначение, "Списано"), Название, Правило, "Списано", "Прочее");
	Иначе
		Фраза = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Длинная_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "") + ДлиннаяСтрока("ж", 1200);
		Правило = НовоеПравило(НастройкиПравила("Списано", "Прочее", Новый Структура("ФразаДословно", Фраза)));
		ЮТест.ОжидаетЧто(СтрДлина(Правило.Фраза), Название + ": предусловие - фраза записана целиком").Равно(СтрДлина(Фраза));
		ЮТест.ОжидаетЧто(СтрДлина(Правило.Фраза) > 1024, Название + ": предусловие - фраза длиннее 1024 знаков").ЭтоИстина();
		ПроверитьПравилоПрименено(РаспознатьПоНазначению(НазначениеСФразами(Фраза), "Списано"), Название + " (контроль: назначение с фразой целиком)",
			Правило, "Списано", "Прочее");

		ПроверитьПравилоНеПрименено(РаспознатьПоНазначению(НазначениеСФразами(Лев(Фраза, 1024)), "Списано"), Название + " (назначение с первыми 1024 знаками фразы)");
	КонецЕсли;

КонецПроцедуры

Функция ДлиннаяСтрока(Символ, Длина)

	Части = Новый Массив;
	Для Индекс = 1 По Длина Цикл
		Части.Добавить(Символ);
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Все строки справочника (в том числе помеченные на удаление) с фразой, равной заданной без учета регистра.
Функция ПравилаСФразойВключаяПомеченные(Фраза)

	Результат = Новый Массив;
	Для Каждого Правило Из ПравилаВБазе() Цикл
		Если ВРег(Правило.Фраза) = ВРег(Фраза) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Типовое правило комиссии распознает типичное назначение: списание, вид "Прочее", источник - правило назначения.
// Пары: то же назначение на поступлении (комиссия только для списания) и назначение без типовых фраз - по умолчанию.
Процедура ТиповыеПравила_Комиссия_РаспознаетсяТипичноеНазначение(Название, Номер) Экспорт

	Назначение = НазначенияКомиссии()[Номер];
	Для Каждого Правило Из ПравилаВБазе() Цикл
		ЮТест.ОжидаетЧто(Не Правило.ПометкаУдаления И ФразаСовпадает(Назначение, Правило.Фраза),
			Название + ": предусловие - в базе нет живого правила, которое совпало бы с этим назначением до типовых (правило "
			+ Правило.Код + ", фраза '" + Правило.Фраза + "')").ЭтоЛожь();
	КонецЦикла;
	ПредусловиеНетТиповыхПравил(Название);
	ЮТест.ОжидаетЧто(СодержитСловоВозврата(Назначение), Название + ": предусловие - в назначении нет фразы возврата").ЭтоЛожь();

	ЗаполнитьТиповые();

	Результат = РаспознатьПоНазначению(Назначение, "Списано");

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида - правило назначения").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид операции - Прочее").Равно(ВидПоНаправлению("Списано", "Прочее"));
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Название + ": 'Проверьте операцию' не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ПравилоНазначения), Название + ": сработавшее правило записано в строку").ЭтоИстина();
	Если ЗначениеЗаполнено(Строка.ПравилоНазначения) Тогда
		Фраза = ЧитатьРеквизиты(Строка.ПравилоНазначения, "ФразаДляПоискаВНазначенииПлатежа").ФразаДляПоискаВНазначенииПлатежа;
		ЮТест.ОжидаетЧто(ФразаСовпадает(Назначение, Фраза), Название + ": фраза сработавшего правила '" + Фраза + "' содержится в назначении")
			.ЭтоИстина();
		ЮТест.ОжидаетЧто(ЕстьВМассивеБезРегистра(ТиповыеФразыКомиссии(), Фраза),
			Название + ": сработала именно типовая фраза комиссии").ЭтоИстина();
	КонецЕсли;

	ПроверитьПравилоНеПрименено(РаспознатьПоНазначению(Назначение, "Поступило"), Название + " (пара: то же назначение на поступлении)");
	ПроверитьПравилоНеПрименено(РаспознатьПоНазначению(НазначениеБезФраз(), "Списано"), Название + " (пара: назначение без типовых фраз)");

КонецПроцедуры

// Возвраты: надходження - ОтПоставщика, списание - Покупателю. Назначение здесь - метка фикстуры + слово: проверяется
// соответствие направлений видам (реалистичность формулировок проверяется тестом комиссии).
Процедура ТиповыеПравила_Возврат_ВидыПоНаправлению(Название, Направление, Слово, ИмяВида) Экспорт

	ПредусловиеНетТиповыхПравил(Название);
	ЗаполнитьТиповые();
	Назначение = НазначениеСФразами(Слово);

	Результат = РаспознатьПоНазначению(Назначение, Направление);

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида - правило назначения").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид операции возврата").Равно(ВидПоНаправлению(Направление, ИмяВида));

КонецПроцедуры

// Распознать не создает типовых правил: без вызова ЗаполнитьТиповыеПравила количество строк прежнее, а назначение с
// фразой комиссии получает значение по умолчанию.
Процедура ТиповыеПравила_БезТиповыхПравил_РаспознатьИхНеСоздает() Экспорт

	ПредусловиеНетТиповыхПравил("Распознать не создает");
	ДоВсего = ПравилаВБазе().Количество();

	Результат = РаспознатьПоНазначению(НазначениеСФразами(ТиповыеФразыКомиссии()[0]), "Списано");

	ПроверитьПравилоНеПрименено(Результат, "Назначение с фразой комиссии без типовых правил в базе");
	ЮТест.ОжидаетЧто(ПравилаВБазе().Количество(), "Количество строк справочника после Распознать").Равно(ДоВсего);

КонецПроцедуры

Функция ЗаполнитьТиповые()

	Добавлено = Продукт("СМП_РаспознаваниеОпераций.ЗаполнитьТиповыеПравила");
	ЮТест.ОжидаетЧто(ТипЗнч(Добавлено), "ЗаполнитьТиповыеПравила возвращает число").Равно(Тип("Число"));

	Возврат Добавлено;

КонецФункции

// Предусловие: в базе нет ни одного живого правила с типовой фразой (без учета регистра).
Процедура ПредусловиеНетТиповыхПравил(Описание)

	Для Каждого Фраза Из ВсеТиповыеФразы() Цикл
		ЮТест.ОжидаетЧто(ЖивыеПравилаСФразой(Фраза).Количество(),
			Описание + ": предусловие - в базе нет живых правил с типовой фразой '" + Фраза + "' (иначе тест измерял бы правила пользователя)")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

Функция ЕстьВМассивеБезРегистра(Массив, Строка)

	Для Каждого Элемент Из Массив Цикл
		Если ВРег(Элемент) = ВРег(Строка) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Содержит ли назначение слово возврата (из типовых фраз возвратов): для предусловия "это назначение - не возврат".
Функция СодержитСловоВозврата(Назначение)

	Для Каждого Фраза Из ТиповыеФразыВозвратов() Цикл
		Если ФразаСовпадает(Назначение, Фраза) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеШага4

Функция ДокументНаправления(Направление)

	Возврат ?(Направление = "Поступило", "ПоступлениеНаСчет", "РасходСоСчета");

КонецФункции

Функция ДругоеНаправление(Направление)

	Возврат ?(Направление = "Поступило", "Списано", "Поступило");

КонецФункции

// Ключ настроек правила и реквизит справочника, где хранится вид операции этого направления.
Функция КлючВидаПравила(Направление)

	Возврат ?(Направление = "Поступило", "ВидОперацииПоступленияНаСчет", "ВидОперацииРасходаСоСчета");

КонецФункции

Функция ВидПоНаправлению(Направление, ИмяВида)

	Возврат ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ДокументНаправления(Направление) + "." + ИмяВида);

КонецФункции

// Настройки правила: вид операции для направления плюс ключи Дополнительно.
Функция НастройкиПравила(Направление, ИмяВида, Дополнительно = Неопределено)

	Настройки = Новый Структура;
	Настройки.Вставить(КлючВидаПравила(Направление), ВидПоНаправлению(Направление, ИмяВида));
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Значения полей правила, отличных от вида операции (проект подставляет тест: он создается в транзакции).
Функция ЗначенияПолейПравила()

	Значения = Новый Структура;
	Значения.Вставить("СтатьяДДС", СтатьяПоручения());
	Значения.Вставить("Корреспонденция", КорреспонденцияПоручения());
	Значения.Вставить("СМП_ВидНалога", ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы"));
	Значения.Вставить("Проект", Неопределено);
	Значения.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.СтруктурныеЕдиницы.ОсновноеПодразделение"));

	Возврат Значения;

КонецФункции

Процедура ПроверитьПолеПравилаЗаписано(Правило, Значения, Описание)

	Для Каждого Элемент Из Значения Цикл
		ЮТест.ОжидаетЧто(Правило.Данные[Элемент.Ключ], Описание + ": предусловие - поле " + Элемент.Ключ + " записано в правило")
			.Равно(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

// Создает правило фикстурой и читает его запросом. Результат: Правило (ссылка), Фраза, Код, Данные (прочитанные поля).
Функция НовоеПравило(Настройки)

	Правило = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Настройки);
	Данные = ЧитатьРеквизиты(Правило, "Код, ФразаДляПоискаВНазначенииПлатежа, ПометкаУдаления, ВидОперацииПоступленияНаСчет, "
		+ "ВидОперацииРасходаСоСчета, СтатьяДДС, Корреспонденция, СМП_ВидНалога, Проект, Подразделение");

	Возврат Новый Структура("Правило, Фраза, Код, Данные", Правило, Данные.ФразаДляПоискаВНазначенииПлатежа, Данные.Код, Данные);

КонецФункции

// Назначение платежа из одной метки фикстуры: ни одна фраза правил его не содержит.
Функция НазначениеБезФраз()

	Возврат СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Назначение_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 12);

КонецФункции

// Метка фикстуры и фразы через пробел. Фразы - строка или массив строк (или структура, значения которой - строки).
Функция НазначениеСФразами(Фразы)

	Части = Новый Массив;
	Части.Добавить(НазначениеБезФраз());
	Если ТипЗнч(Фразы) = Тип("Строка") Тогда
		Части.Добавить(Фразы);
	Иначе
		Для Каждого Элемент Из Фразы Цикл
			Если ТипЗнч(Элемент) = Тип("КлючИЗначение") Тогда
				Части.Добавить(Элемент.Значение);
			Иначе
				Части.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ОперацияСНазначением(ПорядковыйНомер, Направление, Назначение)

	Возврат СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, НазначениеПлатежа",
		ПорядковыйНомер, Продукт("СМП_ВыпискаБанка.Направление" + Направление), Назначение));

КонецФункции

// Распознает одну операцию с заданным назначением и направлением. Результат: План, Строка, Замечания.
Функция РаспознатьПоНазначению(Назначение, Направление)

	Настройки = Новый Структура;
	Настройки.Вставить("НазначениеПлатежа", Назначение);
	Настройки.Вставить("Направление", Продукт("СМП_ВыпискаБанка.Направление" + Направление));

	Возврат РаспознатьОперацию(Настройки);

КонецФункции

// Правило сработало: источник вида, ссылка на правило, вид операции направления, "Проверьте операцию" снята.
Процедура ПроверитьПравилоПрименено(Результат, Описание, Правило, Направление, ИмяВида)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - правило назначения").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(Строка.ПравилоНазначения, Описание + ": ссылка на сработавшее правило").Равно(Правило.Правило);
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции из правила").Равно(ВидПоНаправлению(Направление, ИмяВида));
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' не ставится").ЭтоЛожь();

КонецПроцедуры

// Правило не сработало: вид по умолчанию (шаг 6), правило в строку не записано, "Проверьте операцию" стоит.
Процедура ПроверитьПравилоНеПрименено(Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - значение по умолчанию").Равно("ПоУмолчанию");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ПравилоНазначения), Описание + ": правило в строку не записано").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' стоит").ЭтоИстина();

КонецПроцедуры

// Все строки справочника правил (в том числе помеченные на удаление): Ссылка, Код, Фраза, ПометкаУдаления, ВидПоступления,
// ВидРасхода, СтатьяДДС, Корреспонденция, Проект, Подразделение, ВидНалога.
Функция ПравилаВБазе()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Код КАК Код,
		|	Т.ФразаДляПоискаВНазначенииПлатежа КАК Фраза,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.ВидОперацииПоступленияНаСчет КАК ВидПоступления,
		|	Т.ВидОперацииРасходаСоСчета КАК ВидРасхода,
		|	Т.СтатьяДДС КАК СтатьяДДС,
		|	Т.Корреспонденция КАК Корреспонденция,
		|	Т.Проект КАК Проект,
		|	Т.Подразделение КАК Подразделение,
		|	Т.СМП_ВидНалога КАК ВидНалога
		|ИЗ
		|	Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа КАК Т");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правило = Новый Структура("Ссылка, Код, Фраза, ПометкаУдаления, ВидПоступления, ВидРасхода, СтатьяДДС, Корреспонденция, Проект, Подразделение, ВидНалога");
		ЗаполнитьЗначенияСвойств(Правило, Выборка);
		Результат.Добавить(Правило);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Живые (не помеченные на удаление) правила, фраза которых равна заданной без учета регистра.
Функция ЖивыеПравилаСФразой(Фраза)

	Результат = Новый Массив;
	Для Каждого Правило Из ПравилаВБазе() Цикл
		Если Не Правило.ПометкаУдаления И ВРег(Правило.Фраза) = ВРег(Фраза) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Содержится ли фраза в назначении без учета регистра; пустая фраза не содержится. Только для предусловий и измерений
// теста - продукт этой функцией не проверяется.
Функция ФразаСовпадает(Назначение, Фраза)

	Возврат Не ПустаяСтрока(Фраза) И СтрНайти(ВРег(Назначение), ВРег(Фраза)) > 0;

КонецФункции

#КонецОбласти

#КонецОбласти
#Область Шаг5ДокументПоНомеру

// Шаг 5 (D21, D35.3): заказ, счет или документ расчетов по номеру в назначении платежа. Номер документа (полный и "для печати" -
// хвост из цифр без ведущих нулей) должен стоять в назначении ОТДЕЛЬНЫМ числом: перед и после - не цифра. Каждый тест "не
// найден" сначала доказывает, что тот же документ без единственного отличия находится. Номера документов задаются явно
// (цифровой номер, уникальный в прогоне; платформа выдает номера и коды в этой базе не по порядку создания, поэтому порядок
// номеров нигде не предполагается). Назначение состоит из метки фикстуры и текста теста: правила пользователей не совпадут.

// Каждый вид документа находится по номеру в назначении. Пара: назначение без номера - документ не находится (вид операции
// по умолчанию), поэтому "находится" не могло быть следствием чего-то другого.
Процедура Шаг5_Найден_ПоВидуДокумента(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Название);

	БезНомера = Шаг5_Подготовка(Вид, Новый Структура("Назначение", "СМП_ТЕСТ_ Оплата без номера документа"));
	Шаг5_ПроверитьНеНайден(РаспознатьПодготовку(БезНомера), Название + ": пара - назначение без номера");

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, Название);

КонецПроцедуры

// Форма номера: границы "отдельного числа" и варианты номера (полный, без префикса и нулей). Строка таблицы: шаблон номера
// документа и шаблон назначения (% - цифровой номер сценария), ожидаемое - найден или нет. Каждая строка сначала доказывает, что
// тот же документ находится по назначению с его полным номером отдельным числом, и что номер записан в документ как задан.
Процедура Шаг5_Номер_Форма(Название, ШаблонНомера, ШаблонНазначения, Найден) Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера, ШаблонНазначения", ШаблонНомера, ШаблонНазначения));
	Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Название);
	НомерДокумента = СтрЗаменить(ШаблонНомера, "%", Подготовка.Номер);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, Название + ": предусловие - номер документа записан по шаблону")
		.Равно(НомерДокумента);
	Назначение = СтрЗаменить(ШаблонНазначения, "%", Подготовка.Номер);
	ЮТест.ОжидаетЧто(Подготовка.Операция.НазначениеПлатежа, Название + ": предусловие - назначение по шаблону").Равно(Назначение);

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунок № " + НомерДокумента;
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), Название + ": пара - полный номер документа в назначении");

	Подготовка.Операция.НазначениеПлатежа = Назначение;
	Результат = РаспознатьПодготовку(Подготовка);

	Если Найден Тогда
		Шаг5_ПроверитьНайден(Подготовка, Результат, Название);
	Иначе
		Шаг5_ПроверитьНеНайден(Результат, Название);
	КонецЕсли;

КонецПроцедуры

// Одно отличие - документ не кандидат: не проведен, помечен на удаление (платформа при этом отменяет проведение), другая
// организация, другой контрагент, другой напрям операции. Для каждого: те же данные без отличия находятся (предусловие), и отличие действительно
// записано в данные (чтением документа и регистра).
Процедура Шаг5_ОдноОтличие_ДокументНеКандидат(Название, Вид, Отличие) Экспорт

	Базовая = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьНайден(Базовая, РаспознатьПодготовку(Базовая), Название + ": предусловие - без отличия документ находится");

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("Отличие", Отличие));
	Шаг5_ПроверитьОтличиеЗаписано(Подготовка, Отличие, Название);

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Новый контрагент (в базе его нет): поиска документа нет. Предусловие - тот же документ с контрагентом, найденным по коду,
// находится; у контрагента операции из второго сценария действие "Создать".
Процедура Шаг5_НовыйКонтрагент_ПоискаНет(Название, Вид) Экспорт

	Базовая = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьНайден(Базовая, РаспознатьПодготовку(Базовая), Название + ": предусловие - найденный контрагент");

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("Отличие", "новыйКонтрагент"));
	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, Название + ": предусловие - контрагента в базе нет (будет создан)").Равно("Создать");
	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Документ расчетов только для контрагента с ВестиРасчетыПоДокументам: при Да находится (пара), при Нет - нет. Оба признака
// читаются из базы; остаток документа расчетов в обоих случаях не нулевой (читается из регистра).
Процедура Шаг5_ДокументРасчетов_ЗависитОтПризнакаКонтрагента(Название, Вид) Экспорт

	Да = Шаг5_Подготовка(Вид);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Да.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Название + ": предусловие - у контрагента ВестиРасчетыПоДокументам = Да").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Да), Название + ": предусловие - остаток документа расчетов не нулевой").НеРавно(0);
	Шаг5_ПроверитьНайден(Да, РаспознатьПодготовку(Да), Название + ": ВестиРасчетыПоДокументам = Да");

	Нет = Шаг5_Подготовка(Вид, Новый Структура("Отличие", "расчетыПоДокументамНет"));
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Нет.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Название + ": предусловие - у контрагента ВестиРасчетыПоДокументам = Нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Нет), Название + ": предусловие - остаток документа расчетов не нулевой и при Нет").НеРавно(0);

	Шаг5_ПроверитьНеНайден(РаспознатьПодготовку(Нет), Название + ": ВестиРасчетыПоДокументам = Нет");

КонецПроцедуры

// Акт с нулевым остатком (долг погашен) не кандидат. Предусловие: до погашения акт находится и остаток не нулевой; после
// погашения остаток по документу нулевой (читается из регистра), а сам акт по-прежнему проведен.
Процедура Шаг5_Акт_НулевойОстаток_НеКандидат() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: акт с долгом находится");
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: остаток акта не нулевой").НеРавно(0);

	СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента, Контрагент, Договор, Сумма, Проведен",
		"ПоступлениеНаСчет", Подготовка.Контрагент, Подготовка.Договор, Подготовка.Сумма, Истина));

	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: после оплаты остаток акта нулевой").Равно(0);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, "Предусловие: акт проведен").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(РаспознатьПодготовку(Подготовка), "Акт с нулевым остатком");

КонецПроцедуры

// Счет побеждает документ расчетов с тем же номером. Предусловие: акт сам по себе находится; счет того же контрагента с тем
// же номером добавлен (номер записан) - берется счет.
Процедура Шаг5_СчетИАктСТемЖеНомером_Счет() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: акт сам по себе находится");

	Счет = Шаг5_ДобавитьДокумент(Подготовка, "СчетНаОплату", Подготовка.Номер);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Счет, "Номер").Номер, "Предусловие: у счета номер акта").Равно(ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер);

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, "Взят счет, а не акт").Равно(Счет);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), "Замечаний о документе нет").Равно(0);

КонецПроцедуры

// Заказ и счет с одним номером у одного контрагента - два кандидата одного года: ни один и предупреждение с перечнем (общий
// пул кандидатов, приоритета заказа над счетом нет). Предусловие: заказ по отдельности находится.
Процедура Шаг5_ЗаказИСчетСТемЖеНомером_ЖоденИПредупреждение() Экспорт

	Подготовка = Шаг5_Подготовка("ЗаказПокупателя");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: заказ сам по себе находится");

	Счет = Шаг5_ДобавитьДокумент(Подготовка, "СчетНаОплату", Подготовка.Номер);
	ЮТест.ОжидаетЧто(Счет <> Подготовка.Документ, "Предусловие: это два разных документа").ЭтоИстина();

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, "Заказ и счет с одним номером");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Заказ и счет с одним номером", Подготовка.Номер);

КонецПроцедуры

// Два счета с одним номером в разные годы: решает год, найденный в назначении ОТДЕЛЬНЫМ числом (не порядок создания и не
// "последний": дефект B3). Оба порядка создания, оба года в назначении.
Процедура Шаг5_ДваСчета_РешаетГодВНазначении(Название, ПрошлогоднийПервым, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении);
	ЮТест.ОжидаетЧто(Год(ЧитатьРеквизиты(Подготовка.Прошлогодний, "Дата").Дата), Название + ": предусловие - год прошлогоднего другой")
		.НеРавно(Год(ЧитатьРеквизиты(Подготовка.Текущий, "Дата").Дата));
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Прошлогодний, "Номер").Номер, Название + ": предусловие - номера счетов равны")
		.Равно(ЧитатьРеквизиты(Подготовка.Текущий, "Номер").Номер);

	Результат = РаспознатьПодготовку(Подготовка);

	Ожидаемый = ?(ГодВНазначении = "текущий", Подготовка.Текущий, Подготовка.Прошлогодний);
	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, Название + ": взят счет года из назначения").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Название + ": замечаний нет").Равно(0);

КонецПроцедуры

// Год не решает: ни одного года в назначении, оба года, год третий, год внутри более длинного числа - ни один документ и
// одно предупреждение с перечнем кандидатов (номер и дата каждого). Предусловие: тот же номер при годе, который решает, дает
// документ (Шаг5_ДваСчета_РешаетГодВНазначении), и оба документа проведены, в одной организации и у одного контрагента.
Процедура Шаг5_ДваСчета_ГодНеРешает_ЖоденИПредупреждение(Название, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(Ложь, ГодВНазначении);
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		Данные = ЧитатьРеквизиты(Подготовка[Кандидат], "Проведен, ПометкаУдаления, Контрагент, Организация");
		ЮТест.ОжидаетЧто(Данные.Проведен, Название + ": предусловие - " + Кандидат + " проведен").ЭтоИстина();
		ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Название + ": предусловие - " + Кандидат + " не помечен").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Данные.Контрагент, Название + ": предусловие - " + Кандидат + " того же контрагента").Равно(Подготовка.Контрагент);
		ЮТест.ОжидаетЧто(Данные.Организация, Название + ": предусловие - " + Кандидат + " той же организации").Равно(СМП_ТестыДанныеУНФ.Организация());
	КонецЦикла;

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, Название, Подготовка.Номер);
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", УровеньПредупреждение());
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		Данные = ЧитатьРеквизиты(Подготовка[Кандидат], "Дата");
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении дата кандидата " + Кандидат)
			.Содержит(Формат(Данные.Дата, "ДФ=dd.MM.yyyy"));
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗамечанияПоУровню(Результат.Замечания, УровеньОшибка()).Количество(), Название + ": ошибок нет").Равно(0);

КонецПроцедуры

// Год - не условие поиска: единственный кандидат прошлого года находится, хотя в назначении стоит текущий год.
Процедура Шаг5_ГодНеУсловиеПоиска() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНазначения, ДатаДокумента",
		"СМП_ТЕСТ_ Оплата за рахунок № % від 15.03." + Формат(Год(ТекущаяДатаСеанса()), "ЧГ=0"), ДобавитьМесяц(ТекущаяДатаСеанса(), -12)));
	ЮТест.ОжидаетЧто(Год(ЧитатьРеквизиты(Подготовка.Документ, "Дата").Дата), "Предусловие: год документа не текущий")
		.НеРавно(Год(ТекущаяДатаСеанса()));
	ЮТест.ОжидаетЧто(СтрНайти(Подготовка.Операция.НазначениеПлатежа, Формат(Год(ТекущаяДатаСеанса()), "ЧГ=0")), "Предусловие: в назначении текущий год")
		.НеРавно(0);

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Год в назначении другой");

КонецПроцедуры

// Два счета №15 разных лет, в назначении "№15 від 12.10.<год>": год найден внутри даты дд.мм.рррр (для года межа - только "не
// цифра"), поэтому выбирается счет этого года; число 12 даты номером не считается. Оба порядка создания, оба года.
Процедура Шаг5_ДваСчета_ГодВнутриДаты(Название, ПрошлогоднийПервым, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении, "15");
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка[Кандидат], "Номер").Номер, Название + ": предусловие - номер " + Кандидат + " равен 15").Равно("15");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Год(ЧитатьРеквизиты(Подготовка.Прошлогодний, "Дата").Дата), Название + ": предусловие - годы документов разные")
		.НеРавно(Год(ЧитатьРеквизиты(Подготовка.Текущий, "Дата").Дата));

	Результат = РаспознатьПодготовку(Подготовка);

	Ожидаемый = ?(ГодВНазначении = "текущийВДате", Подготовка.Текущий, Подготовка.Прошлогодний);
	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, Название + ": взят счет года из даты в назначении").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Название + ": замечаний нет").Равно(0);

КонецПроцедуры

// Число 12 из даты "12.10.2026" номером 12 не считается ("цифра.цифра" - часть одного числа). Счет №12; в назначении только дата
// - не кандидат. Пара: в назначении "№12" отдельным числом (рядом та же дата) - находится.
Процедура Шаг5_КороткийНомер_ДатаНеНомер() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Номер, ШаблонНазначения", "12", "СМП_ТЕСТ_ Оплата за рахунок № % від 14.10.2026"));
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, "Предусловие: номер счета 12").Равно("12");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Пара: №12 отдельным числом рядом с датой");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата від 12.10.2026";
	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, "В назначении только дата 12.10.2026");

КонецПроцедуры

// Дефект B3 (выбор "последнего совпадения"): в назначении два номера двух разных счетов одного контрагента и года - ни один и
// предупреждение. Пара: назначение с одним из номеров находит свой счет (оба по очереди).
Процедура Шаг5_ДваНомераВНазначении_ЖоденИПредупреждение() Экспорт

	Первый = Шаг5_Подготовка("СчетНаОплату");
	Второй = Шаг5_ПодготовкаТогоЖеКонтрагента(Первый, "СчетНаОплату");
	ЮТест.ОжидаетЧто(Второй.Номер, "Предусловие: номера счетов различаются").НеРавно(Первый.Номер);
	Шаг5_ПроверитьНайден(Второй, РаспознатьПодготовку(Второй), "Предусловие: назначение с номером второго - второй счет");
	Шаг5_ПроверитьНайден(Первый, РаспознатьПодготовку(Первый), "Предусловие: назначение с номером первого - первый счет");

	Первый.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунки № " + Первый.Номер + " и № " + Второй.Номер;
	Результат = РаспознатьПодготовку(Первый);

	Шаг5_ПроверитьНеНайден(Результат, "Два номера в назначении");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Два номера в назначении", Первый.Номер);
	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "В предупреждении номер второго счета").Содержит(Второй.Номер);

КонецПроцедуры

// Два счета с одним цифровым хвостом, разные префиксы, один год: оба подходят (номер без префикса и нулей совпадает), год не
// решает - ни один и предупреждение. Предусловие: каждый по отдельности находится.
Процедура Шаг5_ДваСчетаСОдинаковымХвостом_ЖоденИПредупреждение() Экспорт

	Первый = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера", "НФ-00%"));
	Шаг5_ПроверитьНайден(Первый, РаспознатьПодготовку(Первый), "Предусловие: счет с префиксом находится сам по себе");
	Второй = Шаг5_ПодготовкаТогоЖеКонтрагента(Первый, "СчетНаОплату", "00%", Первый.Номер);
	Второй.Операция.НазначениеПлатежа = Первый.Операция.НазначениеПлатежа;
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Второй.Документ, "Номер").Номер, "Предусловие: номера счетов различаются записью")
		.НеРавно(ЧитатьРеквизиты(Первый.Документ, "Номер").Номер);

	Результат = РаспознатьПодготовку(Первый);

	Шаг5_ПроверитьНеНайден(Результат, "Одинаковый хвост номера у двух счетов");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Одинаковый хвост номера у двух счетов", Первый.Номер);

КонецПроцедуры

// Поставщик: номер документа поставщика - входящий номер, если он есть; свой номер при этом не ищется. Входящий пуст - ищется
// свой (Шаг5_Найден_ПоВидуДокумента для ЗаказПоставщику и СчетНаОплатуПоставщика).
Процедура Шаг5_Поставщик_ВходящийНомерЕсли(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("ВходящийНомер", Истина));
	Реквизиты = ЧитатьРеквизиты(Подготовка.Документ, "Номер, НомерВходящегоДокумента");
	ЮТест.ОжидаетЧто(Реквизиты.НомерВходящегоДокумента, Название + ": предусловие - входящий номер записан").Равно(Подготовка.Номер);
	ЮТест.ОжидаетЧто(Реквизиты.Номер, Название + ": предусловие - собственный номер другой").НеРавно(Подготовка.Номер);
	ЮТест.ОжидаетЧто(СтрНайти(Реквизиты.Номер, Подготовка.Номер), Название + ": предусловие - входящий номер не входит в собственный").Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Подготовка.Номер, Реквизиты.Номер), Название + ": предусловие - собственный номер не входит во входящий").Равно(0);

	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), Название + ": назначение с входящим номером");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата по счету № " + Реквизиты.Номер;
	Шаг5_ПроверитьНеНайден(РаспознатьПодготовку(Подготовка), Название + ": назначение с собственным номером при заполненном входящем");

КонецПроцедуры

// Дефект B4: договор берется из найденного поиском документа, а не из текущей записи. Документ с договором, который НЕ
// основной у контрагента: в плане договор документа, действие "Найден". Предусловие: основной договор существует, он другой, и
// без номера в назначении общий выбор дал бы именно его. Вид договора документа любой: фильтр вида не применяется.
Процедура Шаг5_Договор_ИзНайденногоДокумента(Название, Вид, ВидДоговораДокумента) Экспорт

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("ВидДоговораДокумента", ВидДоговораДокумента));
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Подготовка.Договор), Название + ": предусловие - договор документа не основной").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Подготовка.Основной), Название + ": предусловие - основной договор числится основным").ЭтоИстина();
	ЮТест.ОжидаетЧто(Подготовка.Основной, Название + ": предусловие - основной договор другой").НеРавно(Подготовка.Договор);
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Документ, "Договор").Договор, Название + ": предусловие - договор записан в документ")
		.Равно(Подготовка.Договор);
	ЮТест.ОжидаетЧто(ДанныеДоговора(Подготовка.Договор).ВидДоговора, Название + ": предусловие - вид договора документа")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + Подготовка.ВидДоговораДокумента));

	БезНомера = РаспознатьПодготовку(Шаг5_КопияСНазначением(Подготовка, "СМП_ТЕСТ_ Оплата без номера"));
	ПроверитьДоговор(БезНомера.Строка, Название + ": предусловие - без номера общий выбор дает основной", Подготовка.Основной, "Найден");

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, Название);
	ПроверитьДоговор(Результат.Строка, Название + ": договор найденного документа", Подготовка.Договор, "Найден");
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "Договор").Количество(), Название + ": замечаний о договоре нет").Равно(0);

КонецПроцедуры

// Договор найденного документа пуст: завершение выбирает договор как обычно (основной договор контрагента). Предусловие:
// договор в документе действительно пуст (читается из базы), документ по-прежнему проведен, основной договор существует.
Процедура Шаг5_Договор_УДокументаПуст_ОбычныйВыбор() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ПустойДоговорДокумента", Истина));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ЧитатьРеквизиты(Подготовка.Документ, "Договор").Договор),
		"Предусловие: договор в документе пуст").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, "Предусловие: документ без договора остался проведенным").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Подготовка.Основной), "Предусловие: основной договор числится основным").ЭтоИстина();

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Договор документа пуст");
	ПроверитьДоговор(Результат.Строка, "Договор документа пуст: обычный выбор", Подготовка.Основной, "Найден");

КонецПроцедуры

// Место среди шагов: шаг 4 (правило по назначению) побеждает номер документа. Предусловие: без правила документ находится, и
// номер документа не встречается в фразе правила.
Процедура Шаг5_Правило_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: без правила документ находится");

	Правило = НовоеПравило(НастройкиПравила("Поступило", "ПрочиеРасчеты"));
	ЮТест.ОжидаетЧто(СтрНайти(Правило.Фраза, Подготовка.Номер), "Предусловие: номер документа не входит в фразу правила").Равно(0);
	Подготовка.Операция.НазначениеПлатежа = НазначениеСФразами(Правило.Фраза) + " № " + Подготовка.Номер;

	Результат = РаспознатьПодготовку(Подготовка);

	ПроверитьПравилоПрименено(Результат, "Правило и номер в одном назначении", Правило, "Поступило", "ПрочиеРасчеты");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с правилом").ЭтоЛожь();

КонецПроцедуры

// Место среди шагов: платежное поручение (шаг 3) побеждает номер документа. Списание: поручение того же контрагента с номером
// операции и суммой; в назначении - номер счета поставщика. Предусловие: без поручения счет находится.
Процедура Шаг5_ПлатежноеПоручение_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплатуПоставщика");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: без поручения счет находится");

	Номер = НовыйЦифровойНомер();
	ЮТест.ОжидаетЧто(Номер, "Предусловие: номер поручения не совпадает с номером счета").НеРавно(Подготовка.Номер);
	Подготовка.Операция.НомерДокумента = Номер;
	СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Контрагент, Договор, Сумма, Номер, Дата, ВидОперации, Статья, Корреспонденция",
		Подготовка.Контрагент, Подготовка.Договор, Подготовка.Операция.Сумма, Номер, НачалоДня(Подготовка.Операция.ДатаОперации),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"), СтатьяПоручения(), КорреспонденцияПоручения()));

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с поручением").ЭтоЛожь();

КонецПроцедуры

// Место среди шагов: загруженный документ (шаг 0) побеждает номер документа и не получает ДокументПоНомеру. Предусловие: без
// загруженного документа счет находится.
Процедура Шаг5_ЗагруженныйДокумент_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Подготовка, РаспознатьПодготовку(Подготовка), "Предусловие: без загруженного документа счет находится");

	Идентификатор = НовыйИдентификатор();
	Банковский = ДокументПоКлючу(НовыйКлюч("А-1"), "ПоступлениеНаСчет", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Подготовка.Операция.ИдентификаторОперации = Идентификатор;

	Результат = РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ЗагруженныйДокумент, "Предусловие: операция сопоставлена с загруженным документом").Равно(Банковский.Ссылка);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида - загруженный документ").Равно("ЗагруженныйДокумент");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с загруженным документом").ЭтоЛожь();

КонецПроцедуры

// Пустое назначение или из одних пробелов: поиска нет, ошибки нет, вид по умолчанию. Предусловие: с номером документ находится.
Процедура Шаг5_ПустоеНазначение_ПоискаНет(Название, Назначение) Экспорт

	Базовая = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Базовая, РаспознатьПодготовку(Базовая), Название + ": предусловие - с номером документ находится");

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Назначение", Назначение));

	Результат = РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Пакет: каждая строка находит свой документ; номер документа одного контрагента в назначении строки другого контрагента
// ничего не находит. Предусловие: каждая строка по отдельности дает ожидаемое.
Процедура Шаг5_Пакет_КаждаяСтрокаСвойДокумент() Экспорт

	А1 = Шаг5_Подготовка("СчетНаОплату");
	А2 = Шаг5_ПодготовкаТогоЖеКонтрагента(А1, "СчетНаОплату");
	Б1 = Шаг5_Подготовка("СчетНаОплатуПоставщика");
	Чужая = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Назначение", "СМП_ТЕСТ_ Оплата за рахунок № " + А1.Номер));
	Для Каждого Элемент Из Новый Структура("А1, А2, Б1", А1, А2, Б1) Цикл
		Шаг5_ПроверитьНайден(Элемент.Значение, РаспознатьПодготовку(Элемент.Значение), "Предусловие: строка " + Элемент.Ключ + " по отдельности");
	КонецЦикла;
	Шаг5_ПроверитьНеНайден(РаспознатьПодготовку(Чужая), "Предусловие: номер чужого контрагента по отдельности ничего не находит");

	А1.Операция.ПорядковыйНомер = 1;
	А2.Операция.ПорядковыйНомер = 2;
	Б1.Операция.ПорядковыйНомер = 3;
	Чужая.Операция.ПорядковыйНомер = 4;
	Таблица = ТаблицаОпераций(А1.Операция, А2.Операция, Б1.Операция, Чужая.Операция);

	План = Распознать(Таблица, КонтекстСОрганизацией());

	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 1).ДокументПоНомеру, "Строка 1").Равно(А1.Документ);
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 2).ДокументПоНомеру, "Строка 2").Равно(А2.Документ);
	ЮТест.ОжидаетЧто(СтрокаПланаПоНомеру(План, 3).ДокументПоНомеру, "Строка 3 (списание)").Равно(Б1.Документ);
	Строка4 = СтрокаПланаПоНомеру(План, 4);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка4.ДокументПоНомеру), "Строка 4: номер документа чужого контрагента ничего не находит").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка4.ИсточникВидаОперации, "Строка 4: значение по умолчанию").Равно("ПоУмолчанию");

КонецПроцедуры

// Шаг ничего не пишет: количества контрагентов, договоров, счетов и банковских документов до и после не меняются, а документ
// найден (иначе равенство снимков могло бы означать, что шагу нечего было делать).
Процедура Шаг5_НеПишетВБазу() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	Результат = РаспознатьПодготовку(Подготовка);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Предусловие: документ найден");
	ЮТест.ОжидаетЧто(ПредставлениеКоличеств(После), "Количества объектов до и после Распознать с шагом 5").Равно(ПредставлениеКоличеств(До));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеШага5

// Сценарий шага 5: контрагент (учет по договорам и документам), его договоры (основной и договор документа), документ нужного
// вида с цифровым номером и операция, в назначении которой стоит этот номер. Вид: СчетНаОплату, ЗаказПокупателя,
// ЗаказПоставщику, СчетНаОплатуПоставщика, Акт (документ расчетов покупателя), РасходСоСчета (документ расчетов поставщика).
// Дополнительно - необязательные ключи:
//  * Отличие - одно из "", "непроведен", "помечен", "другаяОрганизация", "другойКонтрагент", "направлениеДругое",
//    "новыйКонтрагент", "расчетыПоДокументамНет"
//  * ШаблонНомера - номер документа, % - цифровой номер сценария; ШаблонНазначения / Назначение - шаблон / готовый текст
//  * ВходящийНомер - у документа поставщика: цифровой номер сценария записан ВХОДЯЩИМ, собственный - другой
//  * ВидДоговораДокумента - вид договора документа ("СПокупателем" / "СПоставщиком"; по умолчанию вид под вид операции)
//  * ПустойДоговорДокумента - договор документа очищен после проведения (СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента)
//  * ДатаДокумента - дата документа; Основа - подготовка, чьего контрагента и договоры взять
//  * Номер - цифровой номер сценария вместо нового
// Результат: Операция, Документ, Контрагент, Договор (документа), Основной, Номер, Вид, Сумма, Поступление,
// ВидДоговораДокумента.
Функция Шаг5_Подготовка(Вид, Дополнительно = Неопределено)

	Параметры = Новый Структура("Отличие, ШаблонНомера, ШаблонНазначения, Назначение, ВходящийНомер, ВидДоговораДокумента, "
		+ "ПустойДоговорДокумента, ДатаДокумента, Основа, Номер", "", "%", "СМП_ТЕСТ_ Оплата за рахунок № %", Неопределено, Ложь, Неопределено,
		Ложь, Неопределено, Неопределено, Неопределено);
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Если Не Параметры.Свойство(Элемент.Ключ) Тогда
				ВызватьИсключение "Шаг5_Подготовка: неизвестный ключ '" + Элемент.Ключ + "'";
			КонецЕсли;
			Параметры[Элемент.Ключ] = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	Отличие = Параметры.Отличие;

	Поступление = Шаг5_ЭтоВидПокупателя(Вид);
	Если Отличие = "направлениеДругое" Тогда
		НаправлениеОперации = ?(Поступление, "Списано", "Поступило");
	Иначе
		НаправлениеОперации = ?(Поступление, "Поступило", "Списано");
	КонецЕсли;
	ВидДоговора = ?(Поступление, "СПокупателем", "СПоставщиком");
	ВидДоговораДокумента = ?(Параметры.ВидДоговораДокумента = Неопределено, ВидДоговора, Параметры.ВидДоговораДокумента);

	Если Параметры.Основа <> Неопределено Тогда
		Контрагент = Параметры.Основа.Контрагент;
		Основной = Параметры.Основа.Основной;
		Договор = Параметры.Основа.Договор;
	Иначе
		Контрагент = НовыйКонтрагентТеста(Новый Структура("ВестиРасчетыПоДокументам", Отличие <> "расчетыПоДокументамНет"));
		Основной = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора), СМП_ТестыДанныеУНФ.Организация()));
		Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговораДокумента)));
	КонецЕсли;

	Номер = ?(Параметры.Номер = Неопределено, НовыйЦифровойНомер(), Параметры.Номер);
	Сумма = УникальнаяСумма();
	НомерДокумента = СтрЗаменить(Параметры.ШаблонНомера, "%", Номер);

	// Документ: другой контрагент (отличие) - документ принадлежит другому контрагенту с такими же договорами.
	КонтрагентДокумента = Контрагент;
	ДоговорДокумента = Договор;
	Если Отличие = "другойКонтрагент" Тогда
		КонтрагентДокумента = НовыйКонтрагентТеста();
		ДоговорДругого = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(КонтрагентДокумента, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора), СМП_ТестыДанныеУНФ.Организация()));
		ДоговорДокумента = ДоговорДругого;
	КонецЕсли;

	Настройки = Новый Структура;
	Если Параметры.ВходящийНомер Тогда
		Настройки.Вставить("НомерВходящегоДокумента", НомерДокумента);
		Собственный = НовыйЦифровойНомер();
		Пока Собственный = Номер Цикл
			Собственный = НовыйЦифровойНомер();
		КонецЦикла;
		Настройки.Вставить("Номер", Собственный);
	Иначе
		Настройки.Вставить("Номер", НомерДокумента);
	КонецЕсли;
	Если Параметры.ДатаДокумента <> Неопределено Тогда
		Настройки.Вставить("Дата", Параметры.ДатаДокумента);
	КонецЕсли;
	Если Отличие = "помечен" Тогда
		Настройки.Вставить("ПометкаУдаления", Истина);
	КонецЕсли;
	ДокументРасчетов = (Вид = "Акт" Или Вид = "РасходСоСчета");
	Если Отличие = "другаяОрганизация" И ДокументРасчетов Тогда
		ВызватьИсключение "Шаг5_Подготовка: для документа расчетов отличие 'другаяОрганизация' не строится (расчеты пишутся на компанию)";
	КонецЕсли;
	Если Отличие = "другаяОрганизация" Тогда
		ДругаяОрганизация = СМП_ТестыДанныеУНФ.НоваяОрганизация();
		ДоговорДокумента = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговораДокумента), ДругаяОрганизация));
		Настройки.Вставить("Организация", ДругаяОрганизация);
	КонецЕсли;

	Документ = Шаг5_СоздатьДокумент(Вид, КонтрагентДокумента, ДоговорДокумента, Сумма, Отличие <> "непроведен" И Отличие <> "помечен", Настройки);
	Если Параметры.ПустойДоговорДокумента Тогда
		СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента(Документ);
	КонецЕсли;

	// Контекст по умолчанию (known-state). Организацию документа расчетов отдельным отличием проверить нельзя: вендор пишет
	// расчеты не на организацию документа, а на "компанию" (Константы.УчетПоКомпании.Компания(Организация)), и в этой базе
	// компания одна для всех организаций (измерено в тестах фикстур и распознавания).
	Контекст = Неопределено;

	// Операция: контрагент найденный по коду (или код, которого в базе нет).
	КодКонтрагента = ?(Отличие = "новыйКонтрагент", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), ДанныеКонтрагента(Контрагент).Код);
	Назначение = ?(Параметры.Назначение = Неопределено, СтрЗаменить(Параметры.ШаблонНазначения, "%", Номер), Параметры.Назначение);
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, КонтрагентКод, КонтрагентНаименование, Сумма, НазначениеПлатежа",
		1, Продукт("СМП_ВыпискаБанка.Направление" + НаправлениеОперации), КодКонтрагента, "", Сумма, Назначение));

	Результат = Новый Структура("Операция, Документ, Контрагент, Договор, Основной, Номер, Вид, Сумма, Поступление, ВидДоговораДокумента, Контекст");
	Результат.Контекст = Контекст;
	Результат.Операция = Операция;
	Результат.Документ = Документ;
	Результат.Контрагент = Контрагент;
	Результат.Договор = Договор;
	Результат.Основной = Основной;
	Результат.Номер = Номер;
	Результат.Вид = Вид;
	Результат.Сумма = Сумма;
	Результат.Поступление = Поступление;
	Результат.ВидДоговораДокумента = ВидДоговораДокумента;

	Возврат Результат;

КонецФункции

// Вид, документы которого относятся к покупателю (поступление): остальные - к поставщику (списание).
Функция Шаг5_ЭтоВидПокупателя(Вид)

	Возврат Вид = "СчетНаОплату" Или Вид = "ЗаказПокупателя" Или Вид = "Акт";

КонецФункции

Функция Шаг5_СоздатьДокумент(Вид, Контрагент, Договор, Сумма, Провести, Настройки)

	Если Вид = "СчетНаОплату" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "ЗаказПокупателя" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "ЗаказПоставщику" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "СчетНаОплатуПоставщика" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "Акт" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "РасходСоСчета" Тогда
		// Банковский документ как документ расчетов поставщика: оплата без документа-основания оставляет аванс в
		// РасчетыСПоставщиками; ключи построителя банковского документа свои.
		Если Настройки.Свойство("Организация") Или Настройки.Свойство("НомерВходящегоДокумента") Тогда
			ВызватьИсключение "Шаг5_СоздатьДокумент: банковский документ не принимает Организацию и НомерВходящегоДокумента";
		КонецЕсли;
		Ключи = Новый Структура("ВидДокумента, Контрагент, Договор, Сумма, Проведен", "РасходСоСчета", Контрагент, Договор, Сумма, Провести);
		Если Настройки.Свойство("Номер") Тогда
			Ключи.Вставить("Номер", Настройки.Номер);
		КонецЕсли;
		Если Настройки.Свойство("Дата") Тогда
			Ключи.Вставить("Дата", Настройки.Дата);
		КонецЕсли;
		Если Настройки.Свойство("ПометкаУдаления") Тогда
			Ключи.Вставить("ПометкаУдаления", Настройки.ПометкаУдаления);
		КонецЕсли;
		Возврат СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Ключи);
	КонецЕсли;

	ВызватьИсключение "Шаг5_СоздатьДокумент: неизвестный вид '" + Вид + "'";

КонецФункции

// Еще один документ того же контрагента и договора. НомерДокумента - номер строкой (как записать).
Функция Шаг5_ДобавитьДокумент(Подготовка, Вид, НомерДокумента)

	Возврат Шаг5_СоздатьДокумент(Вид, Подготовка.Контрагент, Подготовка.Договор, Подготовка.Сумма + 1, Истина,
		Новый Структура("Номер", НомерДокумента));

КонецФункции

// Второй сценарий того же контрагента с другим цифровым номером (или заданным), документом вида Вид и своей операцией.
Функция Шаг5_ПодготовкаТогоЖеКонтрагента(Первая, Вид, ШаблонНомера = "%", Номер = Неопределено)

	Новая = Шаг5_Подготовка(Вид, Новый Структура("Основа, ШаблонНомера, Номер", Первая, ШаблонНомера, Номер));
	Новая.Операция.ПорядковыйНомер = 2;

	Возврат Новая;

КонецФункции

// Копия подготовки с другим назначением операции (документ тот же).
Функция Шаг5_КопияСНазначением(Подготовка, Назначение)

	Копия = Новый Структура;
	Для Каждого Элемент Из Подготовка Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Операция = Новый Структура;
	Для Каждого Элемент Из Подготовка.Операция Цикл
		Операция.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Операция.НазначениеПлатежа = Назначение;
	Копия.Операция = Операция;

	Возврат Копия;

КонецФункции

// Два счета покупателю с одним номером в разные годы: текущего года и прошлого. ПрошлогоднийПервым - порядок создания.
// ГодВНазначении: "текущий", "прошлый", "оба", "нет", "третий" (позапрошлый), "внутриЧисла" (текущий год внутри более длинного
// числа). Назначение: номер счета и (кроме "нет") дата с годом.
Функция Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении, КороткийНомер = Неопределено)

	Момент = ТекущаяДатаСеанса();
	ДатаПрошлого = ДобавитьМесяц(Момент, -12);
	ГодТекущий = Формат(Год(Момент), "ЧГ=0");
	ГодПрошлый = Формат(Год(ДатаПрошлого), "ЧГ=0");

	Хвост = "";
	Если ГодВНазначении = "текущий" Тогда
		Хвост = " від 15.03." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "прошлый" Тогда
		Хвост = " від 15.03." + ГодПрошлый;
	ИначеЕсли ГодВНазначении = "оба" Тогда
		Хвост = " від 15.03." + ГодПрошлый + " і від 15.03." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "третий" Тогда
		Хвост = " від 15.03." + Формат(Год(ДатаПрошлого) - 1, "ЧГ=0");
	ИначеЕсли ГодВНазначении = "внутриЧисла" Тогда
		Хвост = " на суму 1" + ГодТекущий + "5 грн";
	ИначеЕсли ГодВНазначении = "текущийВДате" Тогда
		// Год внутри даты дд.мм.рррр: для года межа - только "не цифра", точка с цифрами его не соединяет.
		Хвост = " від 12.10." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "прошлыйВДате" Тогда
		Хвост = " від 12.10." + ГодПрошлый;
	ИначеЕсли ГодВНазначении <> "нет" Тогда
		ВызватьИсключение "Шаг5_ПодготовкаДвухГодов: неизвестный год в назначении '" + ГодВНазначении + "'";
	КонецЕсли;

	Первый = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ДатаДокумента, ШаблонНазначения, Номер",
		?(ПрошлогоднийПервым, ДатаПрошлого, Момент), "СМП_ТЕСТ_ Оплата за рахунок № %" + Хвост, КороткийНомер));
	Второй = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Основа, Номер, ДатаДокумента",
		Первый, Первый.Номер, ?(ПрошлогоднийПервым, Момент, ДатаПрошлого)));

	Результат = Новый Структура("Текущий, Прошлогодний, Номер, Контрагент, Операция");
	Результат.Текущий = ?(ПрошлогоднийПервым, Второй.Документ, Первый.Документ);
	Результат.Прошлогодний = ?(ПрошлогоднийПервым, Первый.Документ, Второй.Документ);
	Результат.Номер = Первый.Номер;
	Результат.Контрагент = Первый.Контрагент;
	Результат.Операция = Первый.Операция;

	Возврат Результат;

КонецФункции

// Остаток документа расчетов: число строк регистра взаиморасчетов с ненулевым остатком по организации документа, контрагенту и
// самому документу (Акт - РасчетыСПокупателями, РасходСоСчета - РасчетыСПоставщиками).
Функция Шаг5_ЧислоНенулевыхОстатков(Подготовка)

	ИмяРегистра = ?(Подготовка.Вид = "Акт", "РасчетыСПокупателями", "РасчетыСПоставщиками");
	// Организация не фильтруется: документ расчетов принадлежит контрагенту и документу, а организация регистра в этой базе
	// не равна организации документа (регистры пишутся на "компанию", см. Шаг5_Подготовка).
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.СуммаВалОстаток <> 0 ИЛИ О.СуммаОстаток <> 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Количество
		|ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(, Контрагент = &Контрагент И Документ = &Документ) КАК О");
	Запрос.УстановитьПараметр("Контрагент", ЧитатьРеквизиты(Подготовка.Документ, "Контрагент").Контрагент);
	Запрос.УстановитьПараметр("Документ", Подготовка.Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Документ создан, номер записан, проведен и принадлежит организации по умолчанию; для документа расчетов остаток не нулевой.
Процедура Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Описание)

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Подготовка.Документ), Описание + ": предусловие - документ создан").ЭтоИстина();
	Данные = ЧитатьРеквизиты(Подготовка.Документ, "Проведен, ПометкаУдаления, Организация");
	ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Описание + ": предусловие - документ не помечен на удаление").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Данные.Организация, Описание + ": предусловие - организация документа - организация контекста").Равно(СМП_ТестыДанныеУНФ.Организация());
	Если Подготовка.Вид = "Акт" Или Подготовка.Вид = "РасходСоСчета" Тогда
		ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), Описание + ": предусловие - остаток документа расчетов не нулевой").НеРавно(0);
	КонецЕсли;

КонецПроцедуры

// Отличие действительно записано в данные (иначе "не кандидат" могло быть следствием ошибки сценария).
Процедура Шаг5_ПроверитьОтличиеЗаписано(Подготовка, Отличие, Описание)

	Данные = ЧитатьРеквизиты(Подготовка.Документ, "Проведен, ПометкаУдаления, Организация, Контрагент");
	Если Отличие = "непроведен" Тогда
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ не проведен").ЭтоЛожь();
	ИначеЕсли Отличие = "помечен" Тогда
		ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Описание + ": предусловие - документ помечен на удаление").ЭтоИстина();
		// Платформа отменяет проведение при пометке (проведенного помеченного документа не бывает - измерено): помеченный
		// документ отсеивается и по признаку проведения, и по пометке; отдельно пометку удаления тестом не изолировать.
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - платформа отменила проведение помеченного документа").ЭтоЛожь();
		Если Подготовка.Вид = "Акт" Или Подготовка.Вид = "РасходСоСчета" Тогда
			ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), Описание + ": предусловие - у помеченного остатка нет").Равно(0);
		КонецЕсли;
	ИначеЕсли Отличие = "другаяОрганизация" Тогда
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ другой организации проведен").ЭтоИстина();
		ЮТест.ОжидаетЧто(Данные.Организация, Описание + ": предусловие - организация документа другая").НеРавно(СМП_ТестыДанныеУНФ.Организация());
	ИначеЕсли Отличие = "другойКонтрагент" Тогда
		ЮТест.ОжидаетЧто(Данные.Контрагент, Описание + ": предусловие - контрагент документа другой").НеРавно(Подготовка.Контрагент);
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ другого контрагента проведен").ЭтоИстина();
	ИначеЕсли Отличие = "направлениеДругое" Тогда
		Ожидаемое = Продукт("СМП_ВыпискаБанка." + ?(Подготовка.Поступление, "НаправлениеСписано", "НаправлениеПоступило"));
		ЮТест.ОжидаетЧто(Подготовка.Операция.Направление, Описание + ": предусловие - направление операции другое").Равно(Ожидаемое);
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ проведен").ЭтоИстина();
	Иначе
		ВызватьИсключение "Шаг5_ПроверитьОтличиеЗаписано: неизвестное отличие '" + Отличие + "'";
	КонецЕсли;

КонецПроцедуры

// Найден: документ, источник вида, вид операции по направлению, контрагент остался найденным, "Проверьте операцию" не стоит,
// замечаний о документе нет.
Процедура Шаг5_ПроверитьНайден(Подготовка, Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ДокументПоНомеру, Описание + ": документ по номеру").Равно(Подготовка.Документ);
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - документ по номеру").Равно("ДокументПоНомеру");
	Если Подготовка.Поступление Тогда
		ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции - от покупателя")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"));
	Иначе
		ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции - поставщику")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	КонецЕсли;
	ЮТест.ОжидаетЧто(Строка.Контрагент, Описание + ": контрагент остается найденным").Равно(Подготовка.Контрагент);
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": действие над контрагентом").Равно("Найден");
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Описание + ": замечаний о документе нет").Равно(0);

КонецПроцедуры

// Не найден: документ пуст, вид операции дало значение по умолчанию.
Процедура Шаг5_ПроверитьНеНайден(Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ДокументПоНомеру), Описание + ": документ по номеру не найден").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - значение по умолчанию").Равно("ПоУмолчанию");

КонецПроцедуры

// Ровно одно предупреждение на поле ДокументПоНомеру с номером документов, ошибок нет.
Процедура Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, Описание, Номер)

	Предупреждения = ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": одно предупреждение о нескольких документах").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": в предупреждении номер документов").Содержит(Номер);
	ЮТест.ОжидаетЧто(ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", УровеньОшибка()).Количество(), Описание + ": ошибок о документе нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область РаспознаваниеНеПишет

// Review Focus 3, задача 4: конверт, где КАЖДОЙ операции нужно "Создать" (контрагент, счет и договор), и снимок
// количеств до и после равен. Сначала доказывается, что действия именно "Создать" (иначе равенство снимков могло бы
// означать, что создавать было нечего), потом сравниваются снимки. Пара к снимку - СнимокВидитСозданногоКонтрагента.
Процедура РаспознаваниеНеПишет_ВсеДействияСоздать() Экспорт

	Операции = ТаблицаОпераций(
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 1)),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление", 2,
			Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 3)));
	Контекст = КонтекстСОрганизацией();

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	План = Распознать(Операции, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Для Каждого СтрокаПлана Из План.Операции Цикл
		Номер = Формат(СтрокаПлана.ПорядковыйНомер, "ЧГ=");
		ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеКонтрагент, "Строка " + Номер + ": контрагент создается").Равно("Создать");
		ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеСчет, "Строка " + Номер + ": счет создается").Равно("Создать");
		ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеДоговор, "Строка " + Номер + ": договор создается").Равно("Создать");
	КонецЦикла;
	ЮТест.ОжидаетЧто(ПредставлениеКоличеств(После), "Количества контрагентов, договоров, счетов и документов при всех действиях Создать")
		.Равно(ПредставлениеКоличеств(До));

КонецПроцедуры

// Review Focus 3. Конверт, где операциям понадобился бы новый контрагент (данных о нем в базе нет),
// и снимок количеств до и после равны. Сам по себе такой тест мог бы быть зеленым при слепом снимке:
// пара - СнимокВидитСозданногоКонтрагента.
Процедура РаспознаваниеНеМеняетКоличестваОбъектов() Экспорт

	Операции = ТаблицаОпераций(
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 1)),
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление", 2,
			Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))));
	Контекст = КонтекстСОрганизацией();

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	Распознать(Операции, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	ЮТест.ОжидаетЧто(ПредставлениеКоличеств(После), "Количества контрагентов, договоров, счетов и документов до и после Распознать")
		.Равно(ПредставлениеКоличеств(До));

КонецПроцедуры

Процедура СнимокВидитСозданногоКонтрагента() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	ОсновнойКонтрагент();

	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	// Отдельный ключ, а не сравнение всего снимка: слепой счетчик контрагентов даст чистый failed на этой проверке
	// (общее сравнение маскировалось бы приростом договоров, которые порождает запись контрагента).
	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты"), "Счетчик контрагентов изменился после создания контрагента")
		.НеРавно(До.Получить("Справочник.Контрагенты"));
	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты"), "Контрагентов стало на один больше")
		.Равно(До.Получить("Справочник.Контрагенты") + 1);

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Читает правило запросом: реквизит СМП_ВидНалога принадлежит продуктовому расширению, тестовое его не видит.
Функция ПрочитатьПравило(Правило)

	Результат = Новый Структура("Найдено, ВидНалога, ВидОперацииРасхода", Ложь, Неопределено, Неопределено);
	Если Не ЗначениеЗаполнено(Правило) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Т.СМП_ВидНалога КАК ВидНалога, Т.ВидОперацииРасходаСоСчета КАК ВидОперацииРасхода
		|ИЗ Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Правило);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Найдено = Истина;
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

Функция НовыйПлан()

	Возврат Продукт("СМП_РаспознаваниеОпераций.НовыйПланЗагрузки");

КонецФункции

Функция Распознать(Операции, Контекст)

	Аргументы = Новый Массив;
	Аргументы.Добавить(Операции);
	Аргументы.Добавить(Контекст);
	Возврат Продукт("СМП_РаспознаваниеОпераций.Распознать", Аргументы);

КонецФункции

Функция СчетПоНомеру(Номер)

	Аргументы = Новый Массив;
	Аргументы.Добавить(Номер);
	Возврат Продукт("СМП_РаспознаваниеОпераций.БанковскийСчетОрганизацииПоНомеру", Аргументы);

КонецФункции

// Контекст с организацией и счетом, выбранными по правилу known-state.md (читает, не пишет).
Функция КонтекстСОрганизацией()

	Контекст = Продукт("СМП_РаспознаваниеОпераций.НовыйКонтекстРаспознавания");
	Контекст.Организация = СМП_ТестыДанныеУНФ.Организация();
	Контекст.БанковскийСчет = СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации();
	Возврат Контекст;

КонецФункции

// Ключ поиска загруженного документа: день, номер, сумма (уникальная в прогоне: чужие документы базы ключ не
// заденут) и номер счета контрагента операции. ПустаяДатаДокумента - у операции дата документа пуста.
Функция НовыйКлюч(Номер)

	Ключ = Новый Структура;
	Ключ.Вставить("День", НачалоДня(ТекущаяДатаСеанса()) - 5 * 86400);
	Ключ.Вставить("Номер", Номер);
	Ключ.Вставить("Сумма", УникальнаяСумма());
	Ключ.Вставить("СчетКонтрагента", СМП_ТестыДанныеУНФ.НовыйIBAN());
	Ключ.Вставить("ПустаяДатаДокумента", Ложь);
	Возврат Ключ;

КонецФункции

// Копия ключа с одним изменением. Что: "сумма", "день", "номер" (другой непустой), "номерОперацииПуст",
// "номерДокументаПуст" (ключ документа с пустым номером получает номер), "счет", "деньОперации" (дата документа
// операции пуста, а день ее ДатаОперации другой). Пустая строка - копия без изменений.
Функция КлючСИзменением(Ключ, Что)

	Копия = Новый Структура;
	Для Каждого Элемент Из Ключ Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Если Что = "сумма" Тогда
		Копия.Сумма = Ключ.Сумма + 1;
	ИначеЕсли Что = "день" Тогда
		Копия.День = Ключ.День - 86400;
	ИначеЕсли Что = "номер" Тогда
		Копия.Номер = Ключ.Номер + "Х";
	ИначеЕсли Что = "номерОперацииПуст" Тогда
		Копия.Номер = "";
	ИначеЕсли Что = "номерДокументаПуст" Тогда
		Копия.Номер = "А-1";
	ИначеЕсли Что = "счет" Тогда
		Копия.СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйIBAN();
	ИначеЕсли Что = "деньОперации" Тогда
		Копия.День = Ключ.День + 86400;
		Копия.ПустаяДатаДокумента = Истина;
	ИначеЕсли Не ПустаяСтрока(Что) Тогда
		ВызватьИсключение "Тест не знает изменение ключа: " + Что;
	КонецЕсли;

	Возврат Копия;

КонецФункции

// Сумма, не встречающаяся в базе агента: по 6 шестнадцатеричным знакам нового идентификатора.
Функция УникальнаяСумма()

	Знаки = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 6);
	Значение = 0;
	Для Индекс = 1 По СтрДлина(Знаки) Цикл
		Значение = Значение * 16 + Найти("0123456789abcdef", Сред(Знаки, Индекс, 1)) - 1;
	КонецЦикла;

	Возврат 5000 + Окр(Значение / 100, 2);

КонецФункции

Функция НовыйИдентификатор()

	Возврат СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 30);

КонецФункции

// Операция конверта по ключу: направление по виду документа, идентификатор по параметру (пустой - без идентификатора).
// Время ДатаОперации внутри суток дня ключа.
Функция ОперацияПоКлючу(ПорядковыйНомер, Ключ, Вид, Идентификатор = "", Дополнительно = Неопределено)

	Настройки = Новый Структура;
	Настройки.Вставить("ПорядковыйНомер", ПорядковыйНомер);
	Настройки.Вставить("НомерДокумента", Ключ.Номер);
	Настройки.Вставить("ДатаДокумента", ?(Ключ.ПустаяДатаДокумента, '00010101', Ключ.День));
	Настройки.Вставить("ДатаОперации", Ключ.День + 12 * 3600 + 34 * 60 + 56);
	Настройки.Вставить("Сумма", Ключ.Сумма);
	Настройки.Вставить("КонтрагентНомерСчета", Ключ.СчетКонтрагента);
	Настройки.Вставить("Направление", Продукт("СМП_ВыпискаБанка."
		+ ?(Вид = "ПоступлениеНаСчет", "НаправлениеПоступило", "НаправлениеСписано")));
	Настройки.Вставить("ИдентификаторОперации", Идентификатор);
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки);

КонецФункции

// Банковский документ по ключу; контрагент и договор создаются здесь, чтобы тест знал ожидаемые значения.
// Дополнительно - ключи НовыйБанковскийДокумент плюс СоСчетомКонтрагента (Булево: создать счет контрагента и
// записать его в документ; номер счета возвращается).
Функция ДокументПоКлючу(Ключ, Вид, Дополнительно = Неопределено)

	Контрагент = ОсновнойКонтрагент();
	ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(Вид = "ПоступлениеНаСчет", "СПокупателем", "СПоставщиком"));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ВидДоговора));

	Настройки = Новый Структура;
	Настройки.Вставить("ВидДокумента", Вид);
	Настройки.Вставить("НомерВходящегоДокумента", Ключ.Номер);
	Настройки.Вставить("ДатаВходящегоДокумента", Ключ.День);
	Настройки.Вставить("Сумма", Ключ.Сумма);
	Настройки.Вставить("Контрагент", Контрагент);
	Настройки.Вставить("Договор", Договор);

	СоСчетом = Ложь;
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Если Элемент.Ключ = "СоСчетомКонтрагента" Тогда
				СоСчетом = Элемент.Значение;
			Иначе
				Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	НомерСчета = "";
	Если СоСчетом Тогда
		Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Контрагент);
		Настройки.Вставить("СчетКонтрагента", Счет);
		НомерСчета = НомерСчета(Счет);
	КонецЕсли;

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Настройки);

	Возврат Новый Структура("Ссылка, Контрагент, Договор, НомерСчета", Документ, Контрагент, Договор, НомерСчета);

КонецФункции

// Документ по ключу плюс операция по ключу, отличающемуся одним компонентом (Режим, см. КлючСИзменением);
// пустой Режим - ключ совпадает целиком. У документа счет контрагента заполнен, идентификатора нет.
Функция СценарийСоставногоКлюча(Режим)

	Вид = "ПоступлениеНаСчет";
	КлючДокумента = НовыйКлюч(?(Режим = "номерДокументаПуст", "", "А-1"));
	Основа = ДокументПоКлючу(КлючДокумента, Вид, Новый Структура("СоСчетомКонтрагента", Истина));
	КлючДокумента.СчетКонтрагента = Основа.НомерСчета;
	КлючОперации = КлючСИзменением(КлючДокумента, Режим);

	Возврат Новый Структура("Документ, Операция", Основа, ОперацияПоКлючу(1, КлючОперации, Вид, НовыйИдентификатор()));

КонецФункции

// Реквизиты банковского документа запросом (СМП_ИДТранзакцииБанка принадлежит продуктовому расширению).
Функция ПрочитатьБанковскийДокумент(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.СМП_ИДТранзакцииБанка КАК Идентификатор,
		|	Т.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	Т.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	Т.СуммаДокумента КАК Сумма,
		|	Т.БанковскийСчет КАК БанковскийСчет,
		|	Т.СчетКонтрагента КАК СчетКонтрагента,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.Проведен КАК Проведен,
		|	Т.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	Документ." + Документ.Метаданные().Имя + " КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Результат = Новый Структура("Идентификатор, НомерВходящегоДокумента, ДатаВходящегоДокумента, Сумма, БанковскийСчет, СчетКонтрагента, ПометкаУдаления, Проведен, ВерсияДанных");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Иначе
		ВызватьИсключение "Банковский документ не найден в базе: " + Строка(Документ);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Предусловие "не найден": документ в базе несет ключ операции и идентификатор (читается обратно запросом).
Процедура ПроверитьКлючДокумента(Документ, Ключ, Идентификатор, Описание)

	Прочитано = ПрочитатьБанковскийДокумент(Документ);
	ЮТест.ОжидаетЧто(Прочитано.НомерВходящегоДокумента, Описание + ": номер документа = номеру операции").Равно(Ключ.Номер);
	ЮТест.ОжидаетЧто(Прочитано.ДатаВходящегоДокумента, Описание + ": входящая дата документа = дню операции").Равно(Ключ.День);
	ЮТест.ОжидаетЧто(Прочитано.Сумма, Описание + ": сумма документа = сумме операции").Равно(Ключ.Сумма);
	ЮТест.ОжидаетЧто(Прочитано.Идентификатор, Описание + ": идентификатор документа").Равно(Идентификатор);

КонецПроцедуры

// Сколько документов вида Вид на банковском счете контекста несут день и сумму ключа.
Функция КоличествоДокументовПоКлючу(Вид, Ключ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Документ." + Вид + " КАК Т
		|ГДЕ
		|	Т.БанковскийСчет = &БанковскийСчет
		|	И Т.ДатаВходящегоДокумента = &День
		|	И Т.СуммаДокумента = &Сумма");
	Запрос.УстановитьПараметр("БанковскийСчет", КонтекстСОрганизацией().БанковскийСчет);
	Запрос.УстановитьПараметр("День", Ключ.День);
	Запрос.УстановитьПараметр("Сумма", Ключ.Сумма);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

Функция СтрокаПланаПоНомеру(План, ПорядковыйНомер)

	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если СтрокаПлана.ПорядковыйНомер = ПорядковыйНомер Тогда
			Возврат СтрокаПлана;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В плане нет строки с порядковым номером " + ПорядковыйНомер;

КонецФункции

Функция ЗамечанияСтроки(План, ПорядковыйНомер)

	Замечания = Новый Массив;
	Для Каждого Замечание Из План.Замечания Цикл
		Если Замечание.ПорядковыйНомер = ПорядковыйНомер Тогда
			Замечания.Добавить(Замечание);
		КонецЕсли;
	КонецЦикла;

	Возврат Замечания;

КонецФункции

// Утверждение "найден": документ в строке и источник вида - загруженный документ.
Процедура ПроверитьНайден(План, ПорядковыйНомер, ОжидаемыйДокумент, Описание)

	СтрокаПлана = СтрокаПланаПоНомеру(План, ПорядковыйНомер);
	ЮТест.ОжидаетЧто(СтрокаПлана.ЗагруженныйДокумент, Описание + ": найденный документ").Равно(ОжидаемыйДокумент);
	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, Описание + ": источник вида - загруженный документ").Равно("ЗагруженныйДокумент");

КонецПроцедуры

// Утверждение "не найден": документ пуст, источник вида не "ЗагруженныйДокумент".
Процедура ПроверитьНеНайден(План, ПорядковыйНомер, Описание)

	СтрокаПлана = СтрокаПланаПоНомеру(План, ПорядковыйНомер);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент), Описание + ": документ не найден (колонка пуста)").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрокаПлана.ИсточникВидаОперации, Описание + ": источник вида не загруженный документ")
		.НеРавно("ЗагруженныйДокумент");

КонецПроцедуры

// Таблица Операции свежего конверта с добавленными строками (структуры из НоваяОперацияКонверта).
Функция ТаблицаОпераций(Операция1, Операция2 = Неопределено, Операция3 = Неопределено, Операция4 = Неопределено)

	Таблица = Продукт("СМП_ВыпискаБанка.НоваяВыписка").Операции;
	Для Каждого Операция Из Новый Структура("О1, О2, О3, О4", Операция1, Операция2, Операция3, Операция4) Цикл
		Если Операция.Значение <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция НомерСчета(Счет)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.НомерСчета КАК НомерСчета ИЗ Справочник.БанковскиеСчета КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Счет);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.НомерСчета, "");

КонецФункции

Функция УстаревшийНомерСчета(Счет)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.НомерСчетаУстаревший КАК Номер ИЗ Справочник.БанковскиеСчета КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Счет);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Номер, "");

КонецФункции

Функция ОсновнойКонтрагент()

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
	Возврат СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

КонецФункции

// Колонки решений плана (без ДокументПоНомеру: его тип собирается из метаданных). Типы - строка для ОписаниеТипов.
Функция КолонкиРешенийПлана()

	Колонки = Новый Массив;
	ДобавитьКолонкуРешения(Колонки, "Организация", "СправочникСсылка.Организации");
	ДобавитьКолонкуРешения(Колонки, "БанковскийСчет", "СправочникСсылка.БанковскиеСчета");
	ДобавитьКолонкуРешения(Колонки, "ВидДокумента", "Строка");
	ДобавитьКолонкуРешения(Колонки, "ВидОперации",
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета");
	ДобавитьКолонкуРешения(Колонки, "ИсточникВидаОперации", "Строка");
	ДобавитьКолонкуРешения(Колонки, "ЗагруженныйДокумент", "ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета");
	// Решение планировщика (задача 5): тип Организации убран - реквизит Контрагент банковских документов имеет только
	// тип Контрагенты; другая наша организация представлена контрагентом интеркампани, Сотрудники - для зарплаты.
	ДобавитьКолонкуРешения(Колонки, "Контрагент", "СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники");
	ДобавитьКолонкуРешения(Колонки, "СчетКонтрагента", "СправочникСсылка.БанковскиеСчета");
	ДобавитьКолонкуРешения(Колонки, "Договор", "СправочникСсылка.ДоговорыКонтрагентов");
	ДобавитьКолонкуРешения(Колонки, "ДействиеКонтрагент", "Строка");
	ДобавитьКолонкуРешения(Колонки, "ДействиеСчет", "Строка");
	ДобавитьКолонкуРешения(Колонки, "ДействиеДоговор", "Строка");
	// Тип СтатьяДДС в разделе интерфейса прямо не назван (строка "СтатьяДДС, ИсточникСтатьи - Строка"
	// описывает литералы источника): принята ссылка на статью ДДС. Вопрос к планировщику.
	ДобавитьКолонкуРешения(Колонки, "СтатьяДДС", "СправочникСсылка.СтатьиДвиженияДенежныхСредств");
	ДобавитьКолонкуРешения(Колонки, "ИсточникСтатьи", "Строка");
	ДобавитьКолонкуРешения(Колонки, "Корреспонденция", "ПланСчетовСсылка.Управленческий");
	ДобавитьКолонкуРешения(Колонки, "ВидНалога", "СправочникСсылка.ВидыНалогов");
	ДобавитьКолонкуРешения(Колонки, "Проект", "СправочникСсылка.Проекты");
	ДобавитьКолонкуРешения(Колонки, "Подразделение", "СправочникСсылка.СтруктурныеЕдиницы");
	ДобавитьКолонкуРешения(Колонки, "ПравилоНазначения", "СправочникСсылка.СоответствияНазначенийПлатежаИРеквизитовПлатежа");
	ДобавитьКолонкуРешения(Колонки, "ПлатежноеПоручение", "ДокументСсылка.ПлатежноеПоручение");
	ДобавитьКолонкуРешения(Колонки, "БезНДС", "Булево");
	ДобавитьКолонкуРешения(Колонки, "ПроверьтеОперацию", "Булево");
	Возврат Колонки;

КонецФункции

Процедура ДобавитьКолонкуРешения(Колонки, Имя, Типы)

	Колонки.Добавить(Новый Структура("Имя, Типы", Имя, Типы));

КонецПроцедуры

// Расхождение набора типов колонки с ожидаемым массивом типов; пустая строка - наборы равны.
Функция РасхождениеТипов(ОписаниеТипов, ОжидаемыеТипы)

	Расхождения = Новый Массив;
	Фактические = ОписаниеТипов.Типы();
	Если Фактические.Количество() <> ОжидаемыеТипы.Количество() Тогда
		Расхождения.Добавить("типов " + Фактические.Количество() + ", ожидали " + ОжидаемыеТипы.Количество());
	КонецЕсли;
	Для Каждого Ожидаемый Из ОжидаемыеТипы Цикл
		Если Не ОписаниеТипов.СодержитТип(Ожидаемый) Тогда
			Расхождения.Добавить("нет типа " + Строка(Ожидаемый));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Фактический Из Фактические Цикл
		Если ОжидаемыеТипы.Найти(Фактический) = Неопределено Тогда
			Расхождения.Добавить("лишний тип " + Строка(Фактический));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Расхождения, ", ");

КонецФункции

// Снимок количеств одной строкой в порядке ключей: сравнение строк показывает, какой тип разошелся.
Функция ПредставлениеКоличеств(Количества)

	Ключи = Новый СписокЗначений;
	Для Каждого Элемент Из Количества Цикл
		Ключи.Добавить(Элемент.Ключ);
	КонецЦикла;
	Ключи.СортироватьПоЗначению();

	Части = Новый Массив;
	Для Каждого ЭлементСписка Из Ключи Цикл
		Ключ = ЭлементСписка.Значение;
		Части.Добавить(Ключ + "=" + Формат(Количества.Получить(Ключ), "ЧН=0; ЧГ="));
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Описание типа одиночной колонки с квалификаторами: так сверяются схемы (как в СМП_ТестыКонтрактаВыписки).
Функция ОписаниеТипаКолонки(Колонка)

	ОписаниеТипов = Колонка.ТипЗначения;
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат "составной тип из " + Типы.Количество();
	КонецЕсли;

	ТипКолонки = Типы[0];
	Если ТипКолонки = Тип("Строка") Тогда
		Возврат "Строка(длина=" + Формат(ОписаниеТипов.КвалификаторыСтроки.Длина, "ЧН=0; ЧГ=") + ")";
	ИначеЕсли ТипКолонки = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Знак = ?(Квалификаторы.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный, "Неотрицательный", "Любой");
		Возврат "Число(" + Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=") + ","
			+ Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=") + "," + Знак + ")";
	ИначеЕсли ТипКолонки = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат "Дата(Дата)";
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат "Дата(Время)";
		КонецЕсли;
		Возврат "Дата(ДатаВремя)";
	КонецЕсли;

	Возврат "иной тип: " + Строка(ТипКолонки);

КонецФункции

#КонецОбласти
