				.СПараметрами("по идентификатору", "идентификатор")
				.СПараметрами("составным ключом", "ключ")
			// Пара: тот же документ на счете контекста находится.
			.ДобавитьСерверныйТест("Шаг0_ДокументТогоЖеБанковскогоСчета_Находится").ВТранзакции()
				.СПараметрами("по идентификатору", "идентификатор")
				.СПараметрами("составным ключом", "ключ")
			.ДобавитьСерверныйТест("Шаг0_ПомеченныйНаУдалениеНаходится").ВТранзакции()
				.СПараметрами("по идентификатору", "идентификатор")
				.СПараметрами("составным ключом", "ключ")
			.ДобавитьСерверныйТест("Шаг0_БезСовпадения_ИдетДальшеПоШагам").ВТранзакции()
			.ДобавитьСерверныйТест("Шаг0_НайденныйДокументНеПереопределяетсяСледующимиШагами").ВТранзакции()
