#Область Помощники

// Строит двоичные данные DBF (dBase III) вручную. Нужен там, где XBase создать файл не позволяет:
// байт языка 0 (как в образцах банков), числовое поле с левовыровненным текстом, повреждения.
//
// Параметры:
//  Поля - Массив из Структура - Имя, Тип ("C", "N", "D"), Длина, Точность. Для "C" длина больше 255
//         кодируется парой байтов (младший - длина, старший - в байте десятичных знаков), как в образцах.
//  Записи - Массив из Структура - Значения (Массив из Строка: текст ячейки, дополняется пробелами
//           справа), Удалена (Булево).
//  Параметры - Структура, Неопределено - необязательные ключи: БайтЯзыка (0), ЧислоЗаписейВЗаголовке
//           (по факту), ОтрезатьХвост (байтов с конца файла, 0), БезМаркераКонца (Ложь),
//           Кодировка ("windows-1251"), ГодЗаголовка (124), Версия (3), СдвигДлиныЗаголовка и
//           СдвигДлиныЗаписи (на сколько записанное в заголовке отличается от фактического, 0),
//           ОставитьБайт (обрезать файл до стольких байтов с начала, по умолчанию не обрезается),
//           ХвостHex (байты после маркера конца). Значение ячейки дополняется пробелами до длины
//           поля в БАЙТАХ выбранной кодировки (длиннее - обрезается). У записи необязательный
//           ПризнакHex (байт признака записи вместо "20"/"2A").
Функция ДанныеDBF(Поля, Записи, Параметры = Неопределено)

	Настройки = Новый Структура("БайтЯзыка, ЧислоЗаписейВЗаголовке, ОтрезатьХвост, БезМаркераКонца, Кодировка, ГодЗаголовка, Версия, СдвигДлиныЗаголовка, СдвигДлиныЗаписи, ХвостHex, ОставитьБайт",
		0, Неопределено, 0, Ложь, "windows-1251", 124, 3, 0, 0, "", Неопределено);
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Параметры);
	КонецЕсли;

	ДлинаЗаписи = 1;
	Для Каждого Поле Из Поля Цикл
		ДлинаЗаписи = ДлинаЗаписи + Поле.Длина;
	КонецЦикла;
	ДлинаЗаголовка = 32 + 32 * Поля.Количество() + 1;
	ЧислоЗаписей = ?(Настройки.ЧислоЗаписейВЗаголовке = Неопределено, Записи.Количество(), Настройки.ЧислоЗаписейВЗаголовке);

	Hex = ЧислоHex(Настройки.Версия, 1) + ЧислоHex(Настройки.ГодЗаголовка, 1) + "0A" + "0E"
		+ ЧислоHex(ЧислоЗаписей, 4) + ЧислоHex(ДлинаЗаголовка + Настройки.СдвигДлиныЗаголовка, 2)
		+ ЧислоHex(ДлинаЗаписи + Настройки.СдвигДлиныЗаписи, 2)
		+ ПовторСтроки("00", 17) + ЧислоHex(Настройки.БайтЯзыка, 1) + "0000";

	Для Каждого Поле Из Поля Цикл
		ИмяHex = ТекстHex(Поле.Имя, "windows-1251");
		Hex = Hex + ИмяHex + ПовторСтроки("00", 11 - СтрДлина(ИмяHex) / 2)
			+ ТекстHex(Поле.Тип, "windows-1251") + "00000000"
			+ ЧислоHex(Поле.Длина % 256, 1) + ЧислоHex(Поле.Точность + Цел(Поле.Длина / 256), 1)
			+ ПовторСтроки("00", 14);
	КонецЦикла;
	Hex = Hex + "0D";

	Для Каждого ЗаписьФайла Из Записи Цикл
		Признак = ?(ЗаписьФайла.Удалена, "2A", "20");
		Если ЗаписьФайла.ПризнакHex <> Неопределено Тогда
			Признак = ЗаписьФайла.ПризнакHex;
		КонецЕсли;
		Hex = Hex + Признак;
		Для Индекс = 0 По Поля.ВГраница() Цикл
			ЯчейкаHex = ТекстHex(ЗаписьФайла.Значения[Индекс], Настройки.Кодировка);
			ДлинаПоля = Поля[Индекс].Длина;
			ЯчейкаHex = Лев(ЯчейкаHex + ПовторСтроки("20", ДлинаПоля), ДлинаПоля * 2);
			Hex = Hex + ЯчейкаHex;
		КонецЦикла;
	КонецЦикла;
	Если Не Настройки.БезМаркераКонца Тогда
		Hex = Hex + "1A";
	КонецЕсли;
	Hex = Hex + Настройки.ХвостHex;

	Hex = Лев(Hex, СтрДлина(Hex) - Настройки.ОтрезатьХвост * 2);
	Если Настройки.ОставитьБайт <> Неопределено Тогда
		Hex = Лев(Hex, Настройки.ОставитьБайт * 2);
	КонецЕсли;
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(Hex);

КонецФункции

// Целое без знака, порядок байтов от младшего к старшему.
Функция ЧислоHex(Значение, Байтов)

	Результат = "";
	Остаток = Значение;
	Для Номер = 1 По Байтов Цикл
		Байт = Остаток % 256;
		Остаток = Цел(Остаток / 256);
		Результат = Результат + Сред("0123456789ABCDEF", Цел(Байт / 16) + 1, 1) + Сред("0123456789ABCDEF", Байт % 16 + 1, 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

