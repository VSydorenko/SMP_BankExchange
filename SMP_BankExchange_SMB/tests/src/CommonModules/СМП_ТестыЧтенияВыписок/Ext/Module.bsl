#Область Помощники

Функция Продукт(ИмяМетода, Параметры)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее." + ИмяМетода, Параметры);

КонецФункции

Функция ЗаписиCSV(Данные, Кодировка, Разделитель)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Параметры.Добавить(Кодировка);
	Параметры.Добавить(Разделитель);

	Возврат Продукт("ЗаписиCSV", Параметры);

КонецФункции

Функция Массив1(Значение)

	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

Функция ПоМассиву(Часть1, Часть2)

	Результат = Новый Массив;
	Результат.Добавить(Часть1);
	Результат.Добавить(Часть2);
	Возврат Результат;

КонецФункции

// Строки через CRLF; завершающего перевода строки нет.
Функция СтрокиВТекст(Строка1, Строка2, Строка3 = Неопределено)

	Части = Новый Массив;
	Части.Добавить(Строка1);
	Части.Добавить(Строка2);
	Если Строка3 <> Неопределено Тогда
		Части.Добавить(Строка3);
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ВК + Символы.ПС);

КонецФункции

Функция ДанныеUTF8(Текст)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "utf-8", Ложь);

КонецФункции

// Описание записей одной строкой: "<НомерВИсточнике>:[поле][поле]" через "; ".
// Ожидаемое в тестах записано литералом в том же виде.
Функция ОписаниеЗаписей(Записи)

	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат "не массив: " + МеткаЗначения(Записи);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Поля = "";
		Для Каждого Поле Из Запись.Поля Цикл
			// NUL показываем текстом: сообщение о расхождении с символом NUL ломает отчет прогона
			// (прогон зависает до таймаута вместо читаемого красного).
			Поля = Поля + "[" + СтрЗаменить(Поле, Символ(0), "<NUL>") + "]";
		КонецЦикла;
		Части.Добавить(Формат(Запись.НомерВИсточнике, "ЧН=0; ЧГ=") + ":" + Поля);
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Записи для контроля помощника ОписаниеЗаписей: номер, сырые, поля.
Функция ЗаписиДляКонтроля(Номер, Сырые, Поле1, Поле2 = Неопределено)

	Запись = Новый Структура;
	Запись.Вставить("НомерВИсточнике", Число(Номер));
	Запись.Вставить("Сырые", Сырые);
	Поля = Новый Массив;
	Поля.Добавить(Поле1);
	Если Поле2 <> Неопределено Тогда
		Поля.Добавить(Поле2);
	КонецЕсли;
	Запись.Вставить("Поля", Поля);

	Результат = Новый Массив;
	Результат.Добавить(Запись);
	Возврат Результат;

КонецФункции

// Тип и значение одной строкой, независимо от локали: "Число:1234.56", "Дата:2024-03-15T00:00:00",
// "Строка:980", "Неопределено".
Функция ОписаниеЗначения(Значение)

	Метка = МеткаЗначения(Значение);
	Если Метка = "Неопределено" Тогда
		Возврат Метка;
	КонецЕсли;
	Если Метка = "Число" Или Метка = "Дата" Или Метка = "Строка" Тогда
		Возврат Метка + ":" + XMLСтрока(Значение);
	КонецЕсли;
	Возврат Метка;

КонецФункции

Функция МеткаЗначения(Значение)

	// Тип() принимает только строковый литерал, поэтому проверки перечислены явно.
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Булево";
	ИначеЕсли ТипЗначения = Тип("Неопределено") Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "Массив";
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Возврат "Структура";
	КонецЕсли;
	Возврат "иной тип: " + Строка(ТипЗначения);

КонецФункции

