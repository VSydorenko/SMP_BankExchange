	Номера = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Номера.Добавить(Формат(Запись.НомерВИсточнике, "ЧН=0; ЧГ="));
	КонецЦикла;
	Возврат СтрСоединить(Номера, ",");

КонецФункции

