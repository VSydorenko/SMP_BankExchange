// Описание записей с полями-соответствием (DBF, XML): "<НомерВИсточнике>:{ключ=значение, ...}",
// ключи по алфавиту, записи через "; ".
Функция ОписаниеЗаписейСоответствием(Записи)

	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат "не массив: " + МеткаЗначения(Записи);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Ключи = Новый СписокЗначений;
		Для Каждого КлючИЗначение Из Запись.Поля Цикл
			Ключи.Добавить(КлючИЗначение.Ключ);
		КонецЦикла;
		Ключи.СортироватьПоЗначению();
		Пары = Новый Массив;
		Для Каждого Элемент Из Ключи Цикл
			Пары.Добавить(Элемент.Значение + "=" + ВидимыйТекст(ОписаниеЗначения(Запись.Поля[Элемент.Значение])));
		КонецЦикла;
		Части.Добавить(Формат(Запись.НомерВИсточнике, "ЧН=0; ЧГ=") + ":{" + СтрСоединить(Пары, ", ") + "}");
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Значение одного поля записи по номеру записи в массиве (с нуля) и имени поля, как ОписаниеЗначения.
Функция ОписаниеПоля(Записи, Индекс, Имя)

	Если ТипЗнч(Записи) <> Тип("Массив") Или Записи.Количество() <= Индекс Тогда
		Возврат "нет записи " + Индекс + ": " + ?(ТипЗнч(Записи) = Тип("Массив"), "записей " + Записи.Количество(), МеткаЗначения(Записи));
	КонецЕсли;
	Возврат ВидимыйТекст(ОписаниеЗначения(Записи[Индекс].Поля[Имя]));

КонецФункции

// Номера в источнике записей одной строкой: "1,3,4".
Функция НомераЗаписей(Записи)

	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		Возврат "не массив: " + МеткаЗначения(Записи);
