	ЮТест.ОжидаетЧто(Фактическое, "Записи простого CSV")
		.Равно("1:[Дата][Сумма][Назначение]; 2:[01.02.2024][100.50][оплата]");

КонецПроцедуры

Процедура CSV_РазделительВнутриКавычекНеРвуПоле() Экспорт

	Текст = СтрокиВТекст("a;b;c", """х;у"";2;3");

