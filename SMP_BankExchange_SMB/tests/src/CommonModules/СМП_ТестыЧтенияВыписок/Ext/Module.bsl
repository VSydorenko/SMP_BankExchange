#Область CSV

Процедура CSV_ПростыеЗаписиСНомерамиСтрок() Экспорт

	Текст = СтрокиВТекст("Дата;Сумма;Назначение", "01.02.2024;100.50;оплата");

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Записи простого CSV")
		.Равно("1:[Дата][Сумма][Назначение]; 2:[01.02.2024][100.50][оплата]");

КонецПроцедуры

Процедура CSV_РазделительВнутриКавычекНеРвуПоле() Экспорт

	Текст = СтрокиВТекст("a;b;c", """х;у"";2;3");

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Поле с разделителем внутри кавычек не рвется, колонки не сдвигаются")
		.Равно("1:[a][b][c]; 2:[х;у][2][3]");

КонецПроцедуры

Процедура CSV_УдвоеннаяКавычкаДаетОднуКавычку() Экспорт

	Текст = СтрокиВТекст("a;b", """он сказал """"да"""""";x");

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Удвоенная кавычка в кавычках - одна кавычка")
		.Равно("1:[a][b]; 2:[он сказал ""да""][x]");

КонецПроцедуры

Процедура CSV_ПереносСтрокиВКавычкахОстаетсяВПоле() Экспорт

	// Запись во второй физической строке занимает две строки файла; следующая - четвертая.
	Текст = СтрокиВТекст("h1;h2", """первая" + Символы.ПС + "вторая"";z", "d;e");

	Записи = ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";");
	Фактическое = ОписаниеЗаписей(Записи);

	ЮТест.ОжидаетЧто(Фактическое, "Перенос строки в кавычках не рвет запись; НомерВИсточнике - физическая строка начала")
		.Равно("1:[h1][h2]; 2:[первая" + Символы.ПС + "вторая][z]; 4:[d][e]");

КонецПроцедуры

Процедура CSV_ПустыеПоля() Экспорт

	Текст = СтрокиВТекст("a;;c", ";;", """"";x");

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Пустые поля сохраняются на своих местах")
		.Равно("1:[a][][c]; 2:[][][]; 3:[][x]");

КонецПроцедуры

Процедура CSV_ЗавершающийРазделительДаетЛишнееПоле() Экспорт

	Текст = СтрокиВТекст("a;b;c", "1;2;3;");

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Завершающий разделитель дает на одно поле больше заголовка")
		.Равно("1:[a][b][c]; 2:[1][2][3][]");

КонецПроцедуры

Процедура CSV_ПереводыСтрокиCRLFиLFРавнозначны() Экспорт

	ТекстCRLF = СтрокиВТекст("a;b", "1;2", "3;4") + Символы.ВК + Символы.ПС;
	ТекстLF = "a;b" + Символы.ПС + "1;2" + Символы.ПС + "3;4" + Символы.ПС;

	ФактическоеCRLF = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(ТекстCRLF), "utf-8", ";"));
	ФактическоеLF = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(ТекстLF), "utf-8", ";"));

	ЮТест.ОжидаетЧто(ФактическоеCRLF, "Записи CRLF").Равно("1:[a][b]; 2:[1][2]; 3:[3][4]");
	ЮТест.ОжидаетЧто(ФактическоеLF, "Записи LF").Равно("1:[a][b]; 2:[1][2]; 3:[3][4]");

КонецПроцедуры

Процедура CSV_BOMUTF8Снимается() Экспорт

	Текст = СтрокиВТекст("Дата;Сумма", "1;2");
	Данные = СоединитьДвоичныеДанные(ПоМассиву(
		ПолучитьДвоичныеДанныеИзHexСтроки("EFBBBF"), ДанныеUTF8(Текст)));

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(Данные, "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "BOM не попадает в первое поле первой записи")
		.Равно("1:[Дата][Сумма]; 2:[1][2]");

КонецПроцедуры

Процедура CSV_ПустыеСтрокиПропускаютсяНомераФизические() Экспорт

	Текст = "a;b" + Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС + "c;d" + Символы.ВК + Символы.ПС
		+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Пустые строки пропущены, номер - физическая строка файла")
		.Равно("1:[a][b]; 3:[c][d]");

КонецПроцедуры

Процедура CSV_NULЗаменяетсяАпострофомСтрокаНеОбрезается() Экспорт

	// Байты: ax;x NUL y;z + перевод строки + p;q. Один и тот же вход в двух кодировках.
	Ожидаемое = "1:[a][x'y][z]; 2:[p][q]";
	Hex = "61" + "3B" + "78" + "00" + "79" + "3B" + "7A" + "0D0A" + "70" + "3B" + "71";
	Данные = ПолучитьДвоичныеДанныеИзHexСтроки(Hex);

	Фактическое1251 = ОписаниеЗаписей(ЗаписиCSV(Данные, "windows-1251", ";"));
	ФактическоеUTF8 = ОписаниеЗаписей(ЗаписиCSV(Данные, "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое1251, "NUL в поле, windows-1251").Равно(Ожидаемое);
	ЮТест.ОжидаетЧто(ФактическоеUTF8, "NUL в поле, utf-8").Равно(Ожидаемое);

КонецПроцедуры

Процедура CSV_ТотЖеТекстВДвухКодировкахДаетТеЖеПоля() Экспорт

	Текст = СтрокиВТекст("Платник;Місто", "Іван Їжак;Київ №5", "Ґанок;Єнакієве");
	Данные1251 = ПолучитьДвоичныеДанныеИзСтроки(Текст, "windows-1251");
	ДанныеUTF8 = ПолучитьДвоичныеДанныеИзСтроки(Текст, "utf-8", Ложь);

	Фактическое1251 = ОписаниеЗаписей(ЗаписиCSV(Данные1251, "windows-1251", ";"));
	ФактическоеUTF8 = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8, "utf-8", ";"));

	Ожидаемое = "1:[Платник][Місто]; 2:[Іван Їжак][Київ №5]; 3:[Ґанок][Єнакієве]";
	ЮТест.ОжидаетЧто(Фактическое1251, "Поля из windows-1251").Равно(Ожидаемое);
	ЮТест.ОжидаетЧто(ФактическоеUTF8, "Поля из utf-8").Равно(Ожидаемое);

КонецПроцедуры

Процедура CSV_СырыеЭтоЗаписьКакВФайле() Экспорт

	Текст = СтрокиВТекст("a;b", """х;у"";""з""""з""", """п" + Символы.ПС + "р"";1");

	Записи = ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";");

	Фактическое = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Фактическое.Добавить("[" + Запись.Сырые + "]");
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Фактическое, ""), "Сырые: запись как в файле, без перевода строки в конце, с кавычками")
		.Равно("[a;b][""х;у"";""з""""з""][""п" + Символы.ПС + "р"";1]");

КонецПроцедуры

Процедура CSV_НезакрытаяКавычкаНеТеряетДанные() Экспорт

	// Дефект старой обработки: незакрытая кавычка склеивала остаток в одно поле и сдвигала колонки.
	// Новое правило: остаток файла - последнее поле, ничего не теряется и нет исключения.
	Текст = "a;""b;c" + Символы.ПС + "d;e";

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "Незакрытая кавычка: остаток файла - в последнем поле")
