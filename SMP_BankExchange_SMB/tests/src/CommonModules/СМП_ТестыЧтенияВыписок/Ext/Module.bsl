	Текст = "<?xml version=""1.0"" encoding=""utf-8""?><ROWDATA><HEAD X=""1""/><ROW A=""1"" B=""x""/><OTHER A=""9""/>"
		+ "<ROW A=""2"" B=""y z""/><ROW A=""3"" B=""""/></ROWDATA>";

