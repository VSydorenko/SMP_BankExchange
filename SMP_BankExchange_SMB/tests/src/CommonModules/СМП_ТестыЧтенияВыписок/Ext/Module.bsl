#КонецОбласти

#Область DBF

// DBF читается собственным разбором двоичных данных в памяти (XBase не годится: имя файла не длиннее
// 8 символов, кодировка только по локали сервера, мусор в числах молча становится нулем, NUL обрезает
// значение). Поля - сырые строки в кодировке из параметра; тест ничего не разбирает за читателя.
// Синтетику строит XBase (независимый источник); то, чего XBase не создаст (NUL, мусор в числе, байт
// языка 0, M, повреждения), строит ДанныеDBF байтами.

Процедура DBF_ЗаписиПоляНомераСырые() Экспорт

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьXBase("A-1", Дата(2024, 3, 15), 12.5, "оплата № 1 їєіґ", 980));
	Записи.Добавить(ЗаписьXBase("B-2", Дата(2024, 3, 16), 7, "друга", 840));

	Фактическое = ЗаписиDBF(ДанныеXBase(Записи, КодировкаXBase.ANSI), "windows-1251");

	// Числовое поле: XBase выравнивает вправо, ведущие пробелы - часть значения, читатель их не трогает.
	ЮТест.ОжидаетЧто(ОписаниеЗаписейСоответствием(Фактическое), "Записи DBF: поля по именам файла, все значения - строки")
		.Равно("1:{DT=Строка:20240315, NAZN=Строка:оплата № 1 їєіґ, NDOC=Строка:A-1, SUMMA=Строка:" + ПовторСтроки(" ", 15) + "12.50, VAL=Строка:" + " 980}; "
			+ "2:{DT=Строка:20240316, NAZN=Строка:друга, NDOC=Строка:B-2, SUMMA=Строка:" + ПовторСтроки(" ", 16) + "7.00, VAL=Строка:" + " 840}");

КонецПроцедуры

Процедура DBF_СырыеЭтоЗаписьКакВФайле() Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("A", "C", 3));
	Поля.Добавить(ПолеDBF("B", "N", 5));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("ab", "7")));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	Сырые = "нет записи";
	Если ТипЗнч(Фактическое) = Тип("Массив") И Фактическое.Количество() = 1 Тогда
		Сырые = Фактическое[0].Сырые;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Сырые, "Сырые: запись целиком без признака вычеркивания, с дополнением полей")
		.Равно("ab 7    ");

КонецПроцедуры

Процедура DBF_ДлинноеТекстовоеПолеЧитаетсяЦеликомИНеСдвигаетСледующие() Экспорт

	// 419 букв и маркер в конце: значение дополнено пробелами до 420, длина хранится двумя байтами.
	Длинное = ПовторСтроки("а", 419) + "я";
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьXBase("A-1", Дата(2024, 3, 15), 1, Длинное, 980));

	Фактическое = ЗаписиDBF(ДанныеXBase(Записи, КодировкаXBase.ANSI), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "NAZN"), "Длинное поле прочитано целиком, до маркера в конце").Равно("Строка:" + Длинное);
	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "VAL"), "Поле после длинного не сдвинулось").Равно("Строка: 980");

КонецПроцедуры

Процедура DBF_ТекстовоеПолеСПробеламиИNUL(Описание, Значение, Ожидаемое) Экспорт

	// NUL нельзя передать параметром сценария: в параметре его маркер.
	ТекстСNUL = СтрЗаменить(Значение, "<NUL>", Символ(0));
	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("T", "C", 12));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(Массив1(ТекстСNUL)));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "T"), "Текстовое поле: " + Описание).Равно("Строка:" + Ожидаемое);

КонецПроцедуры

// Мусор в числовом поле платформа (XBase) молча превращала в 0 или в начало числа. Читатель отдает
// сырой текст, разобрать его или признать мусором должен РазобратьСумму.
Процедура DBF_ЧисловоеПолеОтдаетсяСырымТекстом(Описание, Значение, Ожидаемое, СуммаРазобрана) Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("SUMMA", "N", 20, 2));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(Массив1(Значение)));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "SUMMA"), "Числовое поле, сырой текст: " + Описание).Равно("Строка:" + Ожидаемое);
	Текст = "";
	Если ТипЗнч(Фактическое) = Тип("Массив") И Фактическое.Количество() > 0 Тогда
		Текст = Фактическое[0].Поля["SUMMA"];
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(Текст);
	ЮТест.ОжидаетЧто(ОписаниеЗначения(Продукт("РазобратьСумму", Параметры)), "Что скажет РазобратьСумму: " + Описание).Равно(СуммаРазобрана);

КонецПроцедуры

// Дата - строка для РазобратьДату: непарсабельная дата не превращается в пустую дату.
Процедура DBF_ДатаОтдаетсяСырымТекстом(Описание, Значение, Ожидаемое, ДатаРазобрана) Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("DT", "D", 8));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(Массив1(Значение)));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "DT"), "Поле даты, сырой текст: " + Описание).Равно("Строка:" + Ожидаемое);
	Текст = "";
	Если ТипЗнч(Фактическое) = Тип("Массив") И Фактическое.Количество() > 0 Тогда
		Текст = Фактическое[0].Поля["DT"];
	КонецЕсли;
	Параметры = Новый Массив;
	Параметры.Добавить(Текст);
	Параметры.Добавить("ррррммдд");
	ЮТест.ОжидаетЧто(ОписаниеЗначения(Продукт("РазобратьДату", Параметры)), "Что скажет РазобратьДату: " + Описание).Равно(ДатаРазобрана);

КонецПроцедуры

Процедура DBF_ЛогическоеИПлавающееПоляОтдаютсяСырымТекстом() Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("FLAG", "L", 1));
	Поля.Добавить(ПолеDBF("FL", "F", 8, 2));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("T", " 1.50")));
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("?", "")));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеЗаписейСоответствием(Фактическое), "Поля L и F: сырой текст")
		.Равно("1:{FL=Строка: 1.50, FLAG=Строка:T}; 2:{FL=Строка:, FLAG=Строка:?}");

КонецПроцедуры

// Расположение: "+" - живая запись, "-" - вычеркнутая. Живые получают в NDOC свой физический номер.
Процедура DBF_ВычеркнутыеЗаписиНеОтдаютсяНомерФизический(Описание, Расположение, Ожидаемое) Экспорт

	Записи = Новый Массив;
	Для Номер = 1 По СтрДлина(Расположение) Цикл
		Удалена = (Сред(Расположение, Номер, 1) = "-");
		Записи.Добавить(ЗаписьXBase(?(Удалена, "DEL", Формат(Номер, "ЧГ=")), Дата(2024, 3, 15), 1, "x", 980, Удалена));
	КонецЦикла;

	Фактическое = ЗаписиDBF(ДанныеXBase(Записи, КодировкаXBase.ANSI), "windows-1251");

	Части = Новый Массив;
	Если ТипЗнч(Фактическое) = Тип("Массив") Тогда
		Для Каждого Запись Из Фактическое Цикл
			Части.Добавить(Формат(Запись.НомерВИсточнике, "ЧГ=") + ":" + Запись.Поля["NDOC"]);
		КонецЦикла;
	КонецЕсли;
	ЮТест.ОжидаетЧто(СтрСоединить(Части, ","), "Вычеркнутые не отданы, НомерВИсточнике - физический (" + Описание + ")")
		.Равно(Ожидаемое);

КонецПроцедуры

// Старая обработка читала через XBase, который по умолчанию вычеркнутые пропускает (измерено).
// Здесь признак вычеркивания записан байтом "*" в файле, собранном вручную.
Процедура DBF_ПризнакВычеркиванияЗвездочкаВБайтах() Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("K", "C", 3));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(Массив1("one")));
	Записи.Добавить(ЗаписьФайлаDBF(Массив1("two"), Истина));
	Записи.Добавить(ЗаписьФайлаDBF(Массив1("thr")));

	Фактическое = ЗаписиDBF(ДанныеDBF(Поля, Записи), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеЗаписейСоответствием(Фактическое), "Запись со звездочкой не отдана, третья имеет номер 3")
		.Равно("1:{K=Строка:one}; 3:{K=Строка:thr}");

КонецПроцедуры

// Тот же файл в двух кодировках (cp866 - OEM, windows-1251 - ANSI): с кодировкой из параметра
// текст один. Байт языка в заголовке ставит XBase (C9 и 65), читатель им не руководствуется.
Процедура DBF_ТотЖеФайлВДвухКодировкахДаетТотЖеТекст() Экспорт

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьXBase("A-1", Дата(2024, 3, 15), 1, "Оплата рахунку Їжак їє", 980));
	Данные1251 = ДанныеXBase(Записи, КодировкаXBase.ANSI);
	Данные866 = ДанныеXBase(Записи, КодировкаXBase.OEM);

	Из1251 = ЗаписиDBF(Данные1251, "windows-1251");
	Из866 = ЗаписиDBF(Данные866, "cp866");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Из1251, 0, "NAZN"), "windows-1251").Равно("Строка:Оплата рахунку Їжак їє");
	ЮТест.ОжидаетЧто(ОписаниеПоля(Из866, 0, "NAZN"), "cp866").Равно("Строка:Оплата рахунку Їжак їє");
	ЮТест.ОжидаетЧто(Данные1251.Размер(), "Размеры файлов равны").Равно(Данные866.Размер());
	ЮТест.ОжидаетЧто(ПолучитьHexСтрокуИзДвоичныхДанных(Данные1251), "Байты в двух кодировках различаются").НеРавно(ПолучитьHexСтрокуИзДвоичныхДанных(Данные866));

КонецПроцедуры

// Контроль: кодировка из параметра решает. Файл с байтом языка 65 (OEM) и текстом в cp866,
// прочитанный как windows-1251, не дает исходный текст; если бы читатель шел за байтом языка, дал бы.
Процедура DBF_КодировкаРешаетПараметрАНеБайтЯзыка() Экспорт

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьXBase("A-1", Дата(2024, 3, 15), 1, "Оплата рахунку Їжак їє", 980));
	Данные866 = ДанныеXBase(Записи, КодировкаXBase.OEM);

	Фактическое = ЗаписиDBF(Данные866, "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "NAZN"), "cp866-данные, прочитанные как windows-1251")
		.НеРавно("Строка:Оплата рахунку Їжак їє");
	ЮТест.ОжидаетЧто(НомераЗаписей(Фактическое), "Запись при этом прочитана").Равно("1");

КонецПроцедуры

Процедура DBF_КодировкаИзПараметраПриБайтеЯзыкаНоль(Описание, КодировкаДанных, КодировкаОписания) Экспорт

	Текст = "Оплата рахунку Їжак їє";
	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("NAZN", "C", 80));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(Массив1(Текст)));
	Данные = ДанныеDBF(Поля, Записи, Новый Структура("Кодировка", КодировкаДанных));

	Фактическое = ЗаписиDBF(Данные, КодировкаОписания);

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "NAZN"), "Кодировка из параметра, байт языка 0: " + Описание)
		.Равно("Строка:" + Текст);

КонецПроцедуры

// В utf-8 длина поля - в байтах: поле на 10 байтов вмещает 4 буквы по 2 байта и 2 пробела.
Процедура DBF_Utf8ДлинаПоляВБайтах() Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("A", "C", 10));
	Поля.Добавить(ПолеDBF("B", "C", 3));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("Їжак", "xyz")));
	Данные = ДанныеDBF(Поля, Записи, Новый Структура("Кодировка", "utf-8"));

	Фактическое = ЗаписиDBF(Данные, "utf-8");

	ЮТест.ОжидаетЧто(ОписаниеЗаписейСоответствием(Фактическое), "Поля по границам в байтах, второе не сдвинулось")
		.Равно("1:{A=Строка:Їжак, B=Строка:xyz}");

КонецПроцедуры

Процедура DBF_НераспознаннаяКодировкаЭтоИсключение(Описание, Кодировка) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(ДанныеDBF(ПоляСхемыОщад(), Новый Массив));
	Параметры.Добавить(Кодировка);

	ТекстОшибки = ТекстИсключенияПродукта("ЗаписиDBF", Параметры);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "Кодировка DBF не распознана") > 0, "Ожидали исключение: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "" + Кодировка) > 0, "Текст исключения называет кодировку (" + Описание + ")").ЭтоИстина();

КонецПроцедуры

Процедура DBF_ЗаголовокСНестандартнымиГодомИМаркеромКонца(Описание, Год, БезМаркера) Экспорт

	Записи = Новый Массив;
	Записи.Добавить(ЗначенияСхемыОщад("A-1", "20240315", "5", "x", "980"));
	Параметры = Новый Структура("ГодЗаголовка, БезМаркераКонца", Год, БезМаркера);

	Фактическое = ЗаписиDBF(ДанныеОщад(Записи, Параметры), "windows-1251");

	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 0, "ndoc"), "Файл читается: " + Описание).Равно("Строка:A-1");
	ЮТест.ОжидаетЧто(НомераЗаписей(Фактическое), "Одна запись: " + Описание).Равно("1");

КонецПроцедуры

Процедура DBF_БезЗаписейДаетПустойМассив() Экспорт

	Записи = ЗаписиDBF(ДанныеОщад(Новый Массив), "windows-1251");

	ЮТест.ОжидаетЧто(МеткаЗначения(Записи), "Тип результата").Равно("Массив");
	Если ТипЗнч(Записи) = Тип("Массив") Тогда
		ЮТест.ОжидаетЧто(Записи.Количество(), "Записей в файле без записей").Равно(0);
	КонецЕсли;

КонецПроцедуры

// Закрытый перечень типов полей: C, N, D, L, F. Любой другой - исключение с именем поля и типом
// (memo лежит в отдельном файле, который мы не получаем: молча пропустить поле нельзя).
Процедура DBF_НеподдерживаемыйТипПоляЭтоИсключение(Описание, Тип) Экспорт

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF("KEY", "C", 5));
	Поля.Добавить(ПолеDBF("MEMOFLD", Тип, 10));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("a", "b")));
	Параметры = Новый Массив;
	Параметры.Добавить(ДанныеDBF(Поля, Записи));
	Параметры.Добавить("windows-1251");

	ТекстОшибки = ТекстИсключенияПродукта("ЗаписиDBF", Параметры);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "прочитать как DBF") > 0, "Ожидали исключение: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "MEMOFLD") > 0, "Текст называет поле (" + Описание + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "тип поля """ + Тип + """") > 0, "Текст называет тип (" + Описание + ")").ЭтоИстина();

КонецПроцедуры

// Файл создан платформой: вычеркнутая запись посередине, длинное поле, все типы XBase.
Процедура DBF_ФайлСозданныйXBaseЧитается() Экспорт

	Записи = Новый Массив;
	Для Номер = 1 По 3 Цикл
		Записи.Добавить(ЗаписьXBase("док" + Номер, Дата(2024, 3, Номер), Номер * 10.5, "Призначення " + Номер + " їєіґ", 980, Номер = 2));
	КонецЦикла;

	Фактическое = ЗаписиDBF(ДанныеXBase(Записи, КодировкаXBase.ANSI), "windows-1251");

	ЮТест.ОжидаетЧто(НомераЗаписей(Фактическое), "Вычеркнутая вторая не отдана, третья имеет номер 3").Равно("1,3");
	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 1, "NDOC"), "Содержимое третьей").Равно("Строка:док3");
	ЮТест.ОжидаетЧто(ОписаниеПоля(Фактическое, 1, "NAZN"), "Длинное поле третьей").Равно("Строка:Призначення 3 їєіґ");

КонецПроцедуры

// Повреждения: каждое - своя причина в тексте исключения, а не часть записей.
Процедура DBF_ПоврежденныйФайлЭтоИсключениеАНеЧастьЗаписей(Описание, Вид, Причина) Экспорт

	Записи = Новый Массив;
	Для Номер = 1 По 4 Цикл
		Записи.Добавить(ЗначенияСхемыОщад("A-" + Номер, "20240315", "1", "x", "980"));
	КонецЦикла;
	Данные = ДанныеПоврежденногоDBF(Вид, Записи);

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Параметры.Добавить("windows-1251");
	ТекстОшибки = ТекстИсключенияПродукта("ЗаписиDBF", Параметры);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "прочитать как DBF") > 0, "Ожидали исключение, а не часть записей: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, Причина) > 0, "Причина названа: " + Описание + " (" + Причина + ")").ЭтоИстина();

КонецПроцедуры

// Контроль: целый файл той же сборки не падает (иначе исключения выше - артефакт сборки).
Процедура DBF_ЦелыйФайлТойЖеСборкиЧитается() Экспорт

	Записи = Новый Массив;
	Для Номер = 1 По 4 Цикл
		Записи.Добавить(ЗначенияСхемыОщад("A-" + Номер, "20240315", "1", "x", "980"));
	КонецЦикла;

	Фактическое = ЗаписиDBF(ДанныеОщад(Записи), "windows-1251");

	ЮТест.ОжидаетЧто(НомераЗаписей(Фактическое), "Четыре записи").Равно("1,2,3,4");

КонецПроцедуры

// Чтение не создает файлов в каталоге временных файлов: ни при успехе, ни при исключении.
Процедура DBF_ЧтениеНеСоздаетФайловВоВременном(Описание, Вид) Экспорт

	Записи = Новый Массив;
	Для Номер = 1 По 4 Цикл
		Записи.Добавить(ЗначенияСхемыОщад("A-" + Номер, "20240315", "1", "x", "980"));
	КонецЦикла;
	Данные = ДанныеПоврежденногоDBF(Вид, Записи);
	До = ВсеВременные();

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Параметры.Добавить("windows-1251");
	ТекстОшибки = ТекстИсключенияПродукта("ЗаписиDBF", Параметры);

	После = ВсеВременные();
	ЮТест.ОжидаетЧто(СтрДлина(ТекстОшибки) = 0, "Сборка: " + Описание + " - исключение только там, где ждем").Равно(Вид = "целый");
	ЮТест.ОжидаетЧто(После, "Каталог временных файлов не изменился: " + Описание).Равно(До);

КонецПроцедуры

// Повреждения. Вид: "целый" - без повреждения (контроль), остальные - см. условия ниже.
Функция ДанныеПоврежденногоDBF(Вид, Записи)

	Если Вид = "целый" Тогда
		Возврат ДанныеОщад(Записи);
	ИначеЕсли Вид = "оборван" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("ОтрезатьХвост", 700));
	ИначеЕсли Вид = "обещано больше" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("ЧислоЗаписейВЗаголовке", 50));
	ИначеЕсли Вид = "обещано меньше" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("ЧислоЗаписейВЗаголовке", 2));
	ИначеЕсли Вид = "лишний байт" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("ХвостHex", "00"));
	ИначеЕсли Вид = "заголовок длиннее" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("СдвигДлиныЗаголовка", 1));
	ИначеЕсли Вид = "заголовок короче" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("СдвигДлиныЗаголовка", -1));
	ИначеЕсли Вид = "длина записи" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("СдвигДлиныЗаписи", 1));
	ИначеЕсли Вид = "обрезан в описании полей" Тогда
		// Обрезан посреди описаний полей; заголовок заявляет полную длину.
		Возврат ДанныеОщад(Записи, Новый Структура("ОставитьБайт", 106));
	ИначеЕсли Вид = "оборван в описании, длина по файлу" Тогда
		// Заголовок заявлен ровно по размеру обрезанного файла (72 байта), терминатора нет.
		Возврат ДанныеОщад(Записи, Новый Структура("ОставитьБайт, СдвигДлиныЗаголовка", 72, -121));
	ИначеЕсли Вид = "длина заголовка меньше 33" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("СдвигДлиныЗаголовка", -173));
	ИначеЕсли Вид = "обещано очень много" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("ЧислоЗаписейВЗаголовке", 4294967295));
	ИначеЕсли Вид = "повторяющееся имя" Тогда
		Возврат ДанныеДублированногоИмени("A", "A");
	ИначеЕсли Вид = "повторяющееся имя в другом регистре" Тогда
		Возврат ДанныеДублированногоИмени("Name", "nAME");
	ИначеЕсли Вид = "пустое имя" Тогда
		Возврат ДанныеДублированногоИмени("A", "");
	ИначеЕсли Вид = "версия" Тогда
		Возврат ДанныеОщад(Записи, Новый Структура("Версия", 48));
	ИначеЕсли Вид = "признак записи" Тогда
		Файловые = Новый Массив;
		Для Каждого Значения Из Записи Цикл
			Файловые.Добавить(ЗаписьФайлаDBF(Значения));
		КонецЦикла;
		Файловые[1].ПризнакHex = "41";
		Возврат ДанныеDBF(ПоляСхемыОщад(), Файловые);
	ИначеЕсли Вид = "не DBF" Тогда
		Возврат ДанныеUTF8("это не DBF, а просто текст, и он достаточно длинный, чтобы не быть короче заголовка");
	КонецЕсли;
	// "короткий"
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки("030000");

КонецФункции

// Файл с двумя полями заданных имен (для проверки повторяющихся и пустых имен).
Функция ДанныеДублированногоИмени(Имя1, Имя2)

	Поля = Новый Массив;
	Поля.Добавить(ПолеDBF(Имя1, "C", 3));
	Поля.Добавить(ПолеDBF(Имя2, "C", 3));
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьФайлаDBF(ПоМассиву("one", "two")));
	Возврат ДанныеDBF(Поля, Записи);

КонецФункции

// Данные DBF, созданные XBase во временном каталоге теста (имя файла не длиннее 8 символов),
// каталог убирается; возвращает двоичные данные. Схема: NDOC S10, DT D, SUMMA N(20,2), NAZN S420, VAL N4.
Функция ДанныеXBase(Записи, КодировкаФайла)

	Каталог = ПолучитьИмяВременногоФайла("dbf");
	СоздатьКаталог(Каталог);
	ИмяФайла = Каталог + ПолучитьРазделительПути() + "t.dbf";
	Попытка
		Файл = Новый XBase;
		Файл.Кодировка = КодировкаФайла;
		Файл.Поля.Добавить("NDOC", "S", 10);
		Файл.Поля.Добавить("DT", "D", 8);
		Файл.Поля.Добавить("SUMMA", "N", 20, 2);
		Файл.Поля.Добавить("NAZN", "S", 420);
		Файл.Поля.Добавить("VAL", "N", 4);
		Файл.СоздатьФайл(ИмяФайла);
		Файл.Записать();
		Для Каждого Запись Из Записи Цикл
			Файл.Добавить();
			Файл.NDOC = Запись.Номер;
			Файл.DT = Запись.Дата;
			Файл.SUMMA = Запись.Сумма;
			Файл.NAZN = Запись.Назначение;
			Файл.VAL = Запись.Валюта;
			Файл.Записать();
			Если Запись.Удалена Тогда
				Файл.Удалить();
				Файл.Записать();
			КонецЕсли;
		КонецЦикла;
		Файл.ЗакрытьФайл();
		Данные = Новый ДвоичныеДанные(ИмяФайла);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		УдалитьФайлы(Каталог);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	УдалитьФайлы(Каталог);
	Возврат Данные;

КонецФункции

Функция ЗаписьXBase(Номер, Дата, Сумма, Назначение, Валюта, Удалена = Ложь)

	Возврат Новый Структура("Номер, Дата, Сумма, Назначение, Валюта, Удалена", Номер, Дата, Сумма, Назначение, Валюта, Удалена);

КонецФункции

