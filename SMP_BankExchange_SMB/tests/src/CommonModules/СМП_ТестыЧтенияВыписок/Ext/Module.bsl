КонецПроцедуры

Процедура CSV_ПереносСтрокиВКавычкахОстаетсяВПоле() Экспорт

	// Запись во второй физической строке занимает две строки файла; следующая - четвертая.
	Текст = СтрокиВТекст("h1;h2", """первая" + Символы.ПС + "вторая"";z", "d;e");

	Записи = ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";");
	Фактическое = ОписаниеЗаписей(Записи);

	ЮТест.ОжидаетЧто(Фактическое, "Перенос строки в кавычках не рвет запись; НомерВИсточнике - физическая строка начала")
		.Равно("1:[h1][h2]; 2:[первая" + Символы.ПС + "вторая][z]; 4:[d][e]");

КонецПроцедуры

Процедура CSV_ПереносCRLFВКавычкахСчитаетсяОднойСтрокой() Экспорт

	// CRLF внутри кавычек - один перевод строки: следующая запись во второй строке после
	// записи с переносом, а не через одну.
	ВКПС = Символы.ВК + Символы.ПС;
	Текст = "h;h2" + ВКПС + """а" + ВКПС + "б"";z" + ВКПС + "d;e";

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "CRLF в кавычках остается в поле, считается одной физической строкой")
		.Равно("1:[h][h2]; 2:[а" + ВКПС + "б][z]; 4:[d][e]");

КонецПроцедуры

Процедура CSV_ПереносCRВКавычкахСчитаетсяОднойСтрокой() Экспорт

	Текст = "h;h2" + Символы.ВК + """а" + Символы.ВК + "б"";z" + Символы.ВК + "d;e";

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "CR без LF в кавычках остается в поле и считается физической строкой")
		.Равно("1:[h][h2]; 2:[а" + Символы.ВК + "б][z]; 4:[d][e]");

КонецПроцедуры

Процедура CSV_ТолькоCRЭтоКонецСтроки() Экспорт

	Текст = "a;b" + Символы.ВК + "c;d" + Символы.ВК + Символы.ВК + "e;f" + Символы.ВК;

	Фактическое = ОписаниеЗаписей(ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";"));

	ЮТест.ОжидаетЧто(Фактическое, "CR без LF - конец строки; пустая строка пропущена, номер физический")
		.Равно("1:[a][b]; 2:[c][d]; 4:[e][f]");

КонецПроцедуры

Процедура CSV_СырыеСПереносомCRLFВКавычках() Экспорт

	ВКПС = Символы.ВК + Символы.ПС;
	Текст = "a;b" + ВКПС + """п" + ВКПС + "р"";1";

	Записи = ЗаписиCSV(ДанныеUTF8(Текст), "utf-8", ";");

	Фактическое = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Фактическое.Добавить("[" + Запись.Сырые + "]");
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Фактическое, ""), "Сырые: перенос CRLF в кавычках сохранен как в файле")
		.Равно("[a;b][""п" + ВКПС + "р"";1]");

КонецПроцедуры

Процедура CSV_НедопустимыйРазделительЭтоИсключение(Описание, Разделитель) Экспорт

	// Кавычка, CR и LF - служебные символы автомата: как разделитель они ломают разбор молча.
	Параметры = Новый Массив;
	Параметры.Добавить(ДанныеUTF8("a;b"));
	Параметры.Добавить("utf-8");
	Параметры.Добавить(Разделитель);

	ТекстОшибки = "";
	Попытка
		Продукт("ЗаписиCSV", Параметры);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(СтрДлина(ТекстОшибки) > 0, "Ожидали исключение для разделителя: " + Описание)
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "Разделитель CSV") > 0, "Текст исключения называет разделитель (" + Описание + ")")
		.ЭтоИстина();

КонецПроцедуры

