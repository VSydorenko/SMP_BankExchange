Процедура ФайлПохож_НеТекстовыйМусорПустойИКороткийЗаголовок(Описание, Вид) Экспорт

	Если Вид = "" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
	ИначеЕсли Вид = "30колонок" Тогда
		Заголовок = ПоляЗаписи(0);
		Заголовок.Удалить(30);
		Строки = Новый Массив;
		Строки.Добавить(СтрокаCSV(Заголовок));
		Строки.Добавить(СтрокаCSV(ПоляЗаписи(1)));
		Файл = ФайлИзТекстовыхСтрок(Строки);
	Иначе
		Файл = ПолучитьДвоичныеДанныеИзСтроки(Вид, "windows-1251", Ложь);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "Не выписка формата: " + Описание).ЭтоЛожь();

