	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(ПоляЗаписи(0)));
	Строки.Добавить(СтрокаCSV(Многострочная));
	Строки.Добавить(СтрокаCSV(ПоляЗаписи(1)));

	Результат = ПрочитатьСинтетику(ФайлИзТекстовыхСтрок(Строки));

