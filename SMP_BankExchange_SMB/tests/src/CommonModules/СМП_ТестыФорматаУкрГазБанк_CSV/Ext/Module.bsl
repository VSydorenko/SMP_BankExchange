		ЮТест.ОжидаетЧто(Результат.Операции[0].ПорядковыйНомер, "Многострочная запись - строка файла 2").Равно(2);
		ЮТест.ОжидаетЧто(Результат.Операции[1].ПорядковыйНомер, "Следующая запись - строка файла 4 (в редакторе)").Равно(4);
		ЮТест.ОжидаетЧто(Результат.Операции[0].НазначениеПлатежа, "Перенос внутри поля сохранен").Содержит("вторая строка");
	КонецЕсли;

КонецПроцедуры

// Период выписки - из дат операций (начало первого и конец последнего дня): в файле шапки с периодом нет.
Процедура Период_ИзДатОперацийЧтениеПолноеТолькоБезПотерь() Экспорт

	Эталон = РазобратьЭталон("CSVУкрГаз");
	Результат = ПрочитатьОбразец("CSVУкрГаз");

	Наименьшая = Неопределено;
	Наибольшая = Неопределено;
	Для Каждого Операция Из Эталон.Операции Цикл
		Момент = ДатаЭталона(Операция.ДатаОперации);
		Наименьшая = ?(Наименьшая = Неопределено, Момент, Мин(Наименьшая, Момент));
		Наибольшая = ?(Наибольшая = Неопределено, Момент, Макс(Наибольшая, Момент));
	КонецЦикла;

	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Начало периода - начало суток первой операции").Равно(НачалоДня(Наименьшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Конец периода - конец суток последней операции").Равно(КонецДня(Наибольшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Без потерь чтение полное").ЭтоИстина();

КонецПроцедуры

// Файл только с заголовком, без операций: выписка принимается как пустая (ничего не потеряно), диагностики нет,
// ЧтениеПолное = Истина, период остается пустым (его не из чего вывести).
Процедура ТолькоЗаголовок_ПустаяВыпискаБезОшибок() Экспорт

	Результат = ПрочитатьСинтетику(ФайлИзЗаписей(Новый Соответствие, Ложь, 0));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл с одним заголовком принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Диагностики нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Ничего не потеряно").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Период пуст: начало").Равно(Дата(1, 1, 1));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Период пуст: конец").Равно(Дата(1, 1, 1));

КонецПроцедуры

