			.ДобавитьСерверныйТест("ФайлПохож_ПроверкаУмеетПадать")
		.ДобавитьТестовыйНабор("УкрГаз CSV: подсказки реестра")
			.ДобавитьСерверныйТест("ПохожиеСтрокиРеестра_ФайлУкрГазаЧерезДругуюСтрокуНазываетУкрГаз");

КонецПроцедуры

#Область Реестр

Процедура Реестр_СтрокаУкрГаз() Экспорт

	Найдено = 0;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат <> ФорматМодуля() Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ЮТест.ОжидаетЧто(СтрокаРеестра.Идентификатор, "Идентификатор строки").Равно("УкрГазБанк_CSV");
		ЮТест.ОжидаетЧто(СтрокаРеестра.ИмяСтаройОбработки, "Имя старой обработки").Равно("СМП_ОбработкаВыпискиБанка_УкрГазБанк");
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокаРеестра.РасширенияФайлов, ","), "Расширения файлов").Равно("csv");
		ЮТест.ОжидаетЧто(СтрокаРеестра.Представление, "Представление").Равно(СтрокаРеестра.Банк + " — " + СтрокаРеестра.ТипФайла);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено, "Строк реестра формата УкрГаз CSV").Равно(1);

КонецПроцедуры

// Правило КодыБанка: МФО из IBAN собственного счета образца (позиции 5-10); счет берется из эталона.
Процедура Реестр_КодыБанкаВключаютМФОИзIBANСчетаОбразца() Экспорт

	МФО = Сред(РазобратьЭталон("CSVУкрГаз").НомерСчетаЧтения, 5, 6);
	СтрокаРеестра = СтрокаРеестраПоИдентификатору("УкрГазБанк_CSV");

	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаРеестра.КодыБанка) = Тип("Массив"), "КодыБанка - массив").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаРеестра.КодыБанка.Найти(МФО) <> Неопределено, "КодыБанка содержат МФО из IBAN счета образца " + МФО).ЭтоИстина();
	Виденные = Новый Соответствие;
	Для Каждого Код Из СтрокаРеестра.КодыБанка Цикл
		ЮТест.ОжидаетЧто(СтрДлина(Код) = 6 И ТолькоЦифры(Код), "Код банка - шесть цифр").ЭтоИстина();
		ЮТест.ОжидаетЧто(Виденные[Код] = Неопределено, "Код банка не повторяется").ЭтоИстина();
		Виденные[Код] = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура Реестр_ВариантаНет() Экспорт

	СтрокаРеестра = СтрокаРеестраПоИдентификатору("УкрГазБанк_CSV");
	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра <> Неопределено Тогда
		ЮТест.ОжидаетЧто(СтрокаРеестра.Вариант, "Вариант строки").Равно("");
	КонецЕсли;

КонецПроцедуры

Процедура Описание_КодировкаИдентификаторыОстатки() Экспорт

	Описание = Продукт(ФорматМодуля() + ".ОписаниеЧитателя");

	ЮТест.ОжидаетЧто(Описание.Кодировка, "Кодировка образца").Равно("windows-1251");
	ЮТест.ОжидаетЧто(Описание.ДаетИдентификаторыОпераций, "Старая обработка идентификатор банка не читала").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Описание.ДаетОстатки, "В файле есть входящий и исходящий остатки").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Описание.РасширенияФайлов, ","), "Расширения файлов").Равно("csv");

КонецПроцедуры

Процедура Описание_ПроходитПроверкуКонтракта() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Продукт(ФорматМодуля() + ".ОписаниеЧитателя"));
	Ошибки = Продукт("СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, Символы.ПС), "Ошибки описания читателя").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбразецПротивЭталона

// Конверт на образце равен эталону поле за полем. Сообщение: образец, строка файла, поле, ожидаемое, полученное.
//
// Отступлений от эталона на образце нет (измерено прототипом до кода: 7 строк, 12 полей - 0 расхождений).
// ДатаДокумента: эталон поля не содержит, продукт его не заполняет. Решение планувальника, равнозначное для
// ключа (спека D17, коммит 1db1c65): старая обработка кладет в ДатаДок день операции, а при пустой
// ДатаДокумента ключ берет дату операции. Тест требует пустую ДатаДокумента во всех строках.
//
// Сверяется конверт целиком:
//  - период: в файле шапки с периодом нет, за эталон берется то, что по правилу следует из дат операций
//    ЭТАЛОНА: начало суток минимальной и конец суток максимальной даты;
//  - счета: эталонные [Счета] (номер, число операций, порядок первого появления), НомерСчетаЧтения - первый;
//  - ЗаписейИсточника: число записей образца без заголовка (независимый разбор контейнером) равно
//    операциям продукта плюс потерянным строкам, а оно - эталонному значению;
//  - диагностика: если эталонная непуста - уровень, порядковый номер и сырое значение в тексте; пустая
//    эталонная означает пустую диагностику продукта (на образце так).
Процедура Образец_КонвертРавенЭталону() Экспорт

	Описание = "УкрГаз";
	ИдОбразца = "CSVУкрГаз";
	Эталон = РазобратьЭталон(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл принят: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Эталон.Операции.Количество(), "Эталон не пуст: " + Описание).НеРавно(0);
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Число операций: " + Описание).Равно(Эталон.Операции.Количество());
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(),
		"Диагностика пуста (в эталоне " + Эталон.Диагностика.Количество() + ", чужих счетов " + Эталон.ЧужиеСчета.Количество() + ")")
		.Равно(Эталон.Диагностика.Количество() + Эталон.ЧужиеСчета.Количество());
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Файл прочитан полностью").ЭтоИстина();

	Для Индекс = 0 По Мин(Результат.Операции.Количество(), Эталон.Операции.Количество()) - 1 Цикл
		СверитьОперацию(Описание, Результат.Операции[Индекс], Эталон.Операции[Индекс]);
	КонецЦикла;

	СверитьКонверт(Описание, Результат, Эталон, ИдОбразца);

	СДатой = 0;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Операция.ДатаДокумента <> Дата(1, 1, 1) Тогда
			СДатой = СДатой + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СДатой, "Образец " + Описание + ": строк с непустой ДатаДокумента (отступление - пуста во всех)").Равно(0);

КонецПроцедуры

Процедура Образец_СырыеДанныеДословно() Экспорт

	Результат = ПрочитатьОбразец("CSVУкрГаз");
	Строки = СтрРазделить(Текст1251(Макет("СМП_ТестВыпискаCSVУкрГаз")), Символы.ПС);

	Для Каждого Операция Из Результат.Операции Цикл
		Ожидаемое = СтрЗаменить(Строки[Операция.ПорядковыйНомер - 1], Символы.ВК, "");
		ЮТест.ОжидаетЧто(Операция.СырыеДанные, "Строка " + Операция.ПорядковыйНомер + ", поле СырыеДанные: ожидалась запись файла")
			.Равно(Ожидаемое);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны").ЭтоИстина();

КонецПроцедуры

// Контроль: на образце эталонная диагностика пуста, и сверка диагностики там вакуумна. Здесь она выполняется
// на синтетическом файле с нераспознанной суммой против «эталонной» диагностики, верной и испорченной.
Процедура Образец_СверкаДиагностикиУмеетПадать() Экспорт

	Замены = Новый Соответствие;
	Замены[17] = "-";
	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));

	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "-"))).Количество(),
		"Верная эталонная диагностика: расхождений нет").Равно(0);
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Предупреждение", "3", "-"))).Количество() > 0,
		"Иной уровень пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "4", "-"))).Количество() > 0,
		"Иной порядковый номер пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "12ab"))).Количество() > 0,
		"Иное сырое значение пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, Новый Массив).Количество() > 0,
		"Пустая эталонная диагностика против непустой пойман").ЭтоИстина();

КонецПроцедуры

// Правило направления «DK=2 - списание» доказано образцом, а не принято на веру: оборот по дебету из файла
// (DB_SUM_NOM) равен сумме строк с DK=2, оборот по кредиту (CR_SUM_NOM) - сумме строк с DK=1, а эталон
// называет «Списано» ровно там, где DK=2. Образец и эталон берутся из макетов, разбор - контейнером CSV.
Процедура Образец_НаправлениеПоDKДоказаноОборотами() Экспорт

	Эталон = РазобратьЭталон("CSVУкрГаз");
	Записи = ЗаписиФайла(Макет("СМП_ТестВыпискаCSVУкрГаз"));
	НаправлениеПоСтроке = Новый Соответствие;
	Для Каждого Операция Из Эталон.Операции Цикл
		НаправлениеПоСтроке[Операция.ПорядковыйНомер] = Операция.Направление;
	КонецЦикла;

	СуммаDK2 = 0;
	СуммаDK1 = 0;
	Для Индекс = 1 По Записи.ВГраница() Цикл
		Поля = Записи[Индекс].Поля;
		DK = СокрЛП(Поля[7]);
		Сумма = Число_(Поля[17]);
		ЮТест.ОжидаетЧто(DK = "1" Или DK = "2", "Строка " + Записи[Индекс].НомерВИсточнике + ": DK - 1 или 2").ЭтоИстина();
		ЮТест.ОжидаетЧто(НаправлениеПоСтроке[Записи[Индекс].НомерВИсточнике],
			"Строка " + Записи[Индекс].НомерВИсточнике + ", поле Направление").Равно(?(DK = "2", "Списано", "Поступило"));
		Если DK = "2" Тогда
			СуммаDK2 = СуммаDK2 + Сумма;
		Иначе
			СуммаDK1 = СуммаDK1 + Сумма;
		КонецЕсли;
	КонецЦикла;

	Первая = Записи[1].Поля;
	ЮТест.ОжидаетЧто(Окр(СуммаDK2, 2), "Сумма строк DK=2 равна обороту по дебету DB_SUM_NOM").Равно(Окр(Число_(Первая[24]), 2));
	ЮТест.ОжидаетЧто(Окр(СуммаDK1, 2), "Сумма строк DK=1 равна обороту по кредиту CR_SUM_NOM").Равно(Окр(Число_(Первая[25]), 2));
	ЮТест.ОжидаетЧто(СуммаDK2 > 0 И СуммаDK1 > 0, "В образце есть обе стороны").ЭтоИстина();

КонецПроцедуры

Процедура Образец_ИдентификаторОперацииПуст() Экспорт

	Результат = ПрочитатьОбразец("CSVУкрГаз");

	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.ИдентификаторОперации, "Идентификатора банка в файле нет, строка " + Операция.ПорядковыйНомер).Равно("");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны").ЭтоИстина();

КонецПроцедуры

// Известная особенность: НомерСчета операции берется из колонки DB_IBAN файла, а не из Параметры.НомерСчета.
// Поэтому фильтр чужих счетов платформы видит настоящий счет строки.
Процедура Образец_НашСчетСтрокиИзКолонкиФайла() Экспорт

	Эталон = РазобратьЭталон("CSVУкрГаз");
	Номера = Новый Массив;
	Номера.Добавить("UA000000000000000000000000000");

	Результат = ПрочитатьФайл("УкрГазБанк_CSV", Макет("СМП_ТестВыпискаCSVУкрГаз"), Номера);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Все строки файла - чужого счета и отфильтрованы").Равно(0);
	Предупреждения = ТекстыПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о чужом счете").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет счет из файла").Содержит(Эталон.НомерСчетаЧтения);
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет число строк").Содержит(Формат(Эталон.Операции.Количество(), "ЧГ="));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Остатки

// Звірка залишків на зразку: вхідний + надходження - списання = вихідний. Надходження і списання - з
// конверта продукту, залишки - з конверта продукту; звірка не залежить від колонок, з яких вони прочитані.
Процедура Остатки_ВходящийПлюсПоступленияМинусСписанияРавныИсходящему() Экспорт

	Результат = ПрочитатьОбразец("CSVУкрГаз");
	Поступило = 0;
	Списано = 0;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Операция.Направление = "Поступило" Тогда
			Поступило = Поступило + Операция.Сумма;
		Иначе
			Списано = Списано + Операция.Сумма;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Выписка.НачальныйОстаток), "Начальный остаток задан").Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Выписка.КонечныйОстаток), "Конечный остаток задан").Равно(Тип("Число"));
	Если ТипЗнч(Результат.Выписка.НачальныйОстаток) = Тип("Число") И ТипЗнч(Результат.Выписка.КонечныйОстаток) = Тип("Число") Тогда
		ЮТест.ОжидаетЧто(Окр(Результат.Выписка.НачальныйОстаток + Поступило - Списано, 2), "Входящий + поступления - списания = исходящий")
			.Равно(Окр(Результат.Выписка.КонечныйОстаток, 2));
	КонецЕсли;
	ЮТест.ОжидаетЧто(Поступило > 0 И Списано > 0, "Образец содержит обе стороны, звірка не вакуумна").ЭтоИстина();

КонецПроцедуры

// Остатки равны колонкам IN_RST_NO (20) и OUT_RST_NO (22) файла (разбор - контейнером CSV и общим разбором суммы).
Процедура Остатки_РавныКолонкамФайла() Экспорт

	Записи = ЗаписиФайла(Макет("СМП_ТестВыпискаCSVУкрГаз"));
	Результат = ПрочитатьОбразец("CSVУкрГаз");

	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток, "Начальный остаток = IN_RST_NO").Равно(Число_(Записи[1].Поля[20]));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонечныйОстаток, "Конечный остаток = OUT_RST_NO").Равно(Число_(Записи[1].Поля[22]));
	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток <> Результат.Выписка.КонечныйОстаток, "Остатки различаются: перестановка колонок видна").ЭтоИстина();

КонецПроцедуры

// Решение: остатки - из первой записи; в файле они повторяются в каждой записи одинаково.
Процедура Остатки_БерутсяИзПервойЗаписи() Экспорт

	Записи = ЗаписиФайла(Макет("СМП_ТестВыпискаCSVУкрГаз"));
	Замены = Новый Соответствие;
	Замены[20] = "1.00";
	Замены[22] = "2.00";

	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));

	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток, "Начальный остаток - из первой записи").Равно(Число_(Записи[1].Поля[20]));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонечныйОстаток, "Конечный остаток - из первой записи").Равно(Число_(Записи[1].Поля[22]));

КонецПроцедуры

// Решение: остаток, который не разобрать, - «Предупреждение» (строки не потеряны), остаток не задан.
Процедура Остатки_НераспознанныйДаетПредупреждениеБезПотери() Экспорт

	Замены = Новый Соответствие;
	Замены[20] = "abc";
	Файл = ФайлИзЗаписей(Замены, Истина);

	Результат = ПрочитатьСинтетику(Файл);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе операции прочитаны").Равно(2);
	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток, "Нераспознанный остаток не задан").Равно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Выписка.КонечныйОстаток, "Исходящий остаток разобран").НеРавно(Неопределено);
	Предупреждения = ДиагностикаПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Предупреждение содержит сырое значение").Содержит("abc");
		ЮТест.ОжидаетЧто(Предупреждения[0].ПорядковыйНомер, "Предупреждение привязано к первой записи (строка файла 2)").Равно(2);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет: данные не потеряны").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Чтение полное").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет").ЭтоЛожь();

КонецПроцедуры

Процедура Остатки_ВПустойВыпискеНеЗаданы() Экспорт

	Результат = ПрочитатьСинтетику(ФайлИзЗаписей(Новый Соответствие, Ложь, 0));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл с одним заголовком принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток, "Начальный остаток не задан").Равно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Выписка.КонечныйОстаток, "Конечный остаток не задан").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СчетВремяДатаДокумента

// Правило из данных: AC_KOR (колонка 9) в образце частично испорчен записью с экспонентой, а IBAN
// контрагента лежит в CR_IBAN (колонка 30), как читает старая обработка. Образец содержит испорченные значения.
Процедура СчетКорреспондента_НеИзЭкспоненциальнойКолонки() Экспорт

	Записи = ЗаписиФайла(Макет("СМП_ТестВыписка" + "CSVУкрГаз"));
	Результат = ПрочитатьОбразец("CSVУкрГаз");

	Испорчено = 0;
	Для Индекс = 1 По Записи.ВГраница() Цикл
		Поле9 = СокрЛП(Записи[Индекс].Поля[9]);
		Если НЕ (Лев(Поле9, 2) = "UA" И СтрДлина(Поле9) = 29) Тогда
			Испорчено = Испорчено + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Испорчено > 0, "В образце есть строки с испорченным AC_KOR (иначе тест вакуумен)").ЭтоИстина();

	Для Каждого Операция Из Результат.Операции Цикл
		Поля = Записи[Операция.ПорядковыйНомер - 1].Поля;
		ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, "Строка " + Операция.ПорядковыйНомер + ": счет контрагента из CR_IBAN")
			.Равно(СокрЛП(Поля[30]));
		ЮТест.ОжидаетЧто(Лев(Операция.КонтрагентНомерСчета, 2) = "UA" И СтрДлина(Операция.КонтрагентНомерСчета) = 29,
			"Строка " + Операция.ПорядковыйНомер + ": счет контрагента - IBAN, не экспонента").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Известная особенность старой обработки, отвечающая за составной ключ: в файле только дата (колонка 0),
// а время операции зашито «00:09:00». Решение планувальника: воспроизвести как есть.
Процедура Известное_ВремяОперацииЗашитоКакВСтаройОбработке() Экспорт

	Записи = ЗаписиФайла(Макет("СМП_ТестВыпискаCSVУкрГаз"));
	Для Индекс = 1 По Записи.ВГраница() Цикл
		ЮТест.ОжидаетЧто(СтрДлина(СокрЛП(Записи[Индекс].Поля[0])), "В колонке 0 только дата, времени нет").Равно(10);
	КонецЦикла;

	Результат = ПрочитатьОбразец("CSVУкрГаз");
	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Формат(Операция.ДатаОперации, "ДФ=HH:mm:ss"), "Строка " + Операция.ПорядковыйНомер + ": время операции")
			.Равно("00:09:00");
	КонецЦикла;

	Замены = Новый Соответствие;
	Замены[0] = "15.03.2023";
	Синтетика = ПрочитатьСинтетику(СинтетическийФайл(Замены));
	ЮТест.ОжидаетЧто(Синтетика.Операции.Количество(), "Обе строки прочитаны").Равно(2);
	Если Синтетика.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(ТекстДаты(Синтетика.Операции[1].ДатаОперации), "Дата из колонки 0, время зашито")
			.Равно("2023-03-15T00:09:00");
	КонецЕсли;

КонецПроцедуры

// Решение планувальника: колонка DATA_D (6) не читается, ДатаДокумента пуста: старая обработка кладет в
// ДатаДок день операции (колонка 0), составной ключ при пустой ДатаДокумента берет дату операции.
Процедура ДатаДокумента_КолонкаНеЧитаетсяПолеПустое() Экспорт

	Замены = Новый Соответствие;
	Замены[6] = "03.04.2021";

	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе строки прочитаны").Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].ДатаДокумента, "Дата документа из колонки 6 не читается").Равно(Дата(1, 1, 1));
	КонецЕсли;

	Замены[6] = "31.31.2024";
	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Мусор в колонке 6 строку не портит").Равно(2);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Направление

Процедура Направление_ПоЗначениюDK(Описание, DK, Ожидаемое) Экспорт

	Замены = Новый Соответствие;
	Замены[7] = DK;

	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе строки прочитаны: " + Описание).Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].Направление, "Направление: " + Описание).Равно(Ожидаемое);
	КонецЕсли;

КонецПроцедуры

Процедура Направление_НеизвестноеDKДаетОшибкуССырымЗначением(Описание, DK) Экспорт

	Замены = Новый Соответствие;
	Замены[7] = DK;

	Результат = ПрочитатьСинтетику(СинтетическийФайл(Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка с неизвестным DK в Операции нет: " + Описание).Равно(1);
	Ошибки = ДиагностикаПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка: " + Описание).Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0].ПорядковыйНомер, "Ошибка привязана к строке файла 3: " + Описание).Равно(3);
		Если Не ПустаяСтрока(DK) Тогда
