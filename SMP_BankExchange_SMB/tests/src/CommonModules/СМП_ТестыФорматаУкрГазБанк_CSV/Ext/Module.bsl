	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет: чужой счет не потеря данных").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Фильтр чужих счетов признак невалидных строк не ставит").ЭтоЛожь();

