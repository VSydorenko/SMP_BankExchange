// Тесты распознавания банковской выписки: шаг 3, платежное поручение БЕЗ контрагента и поручение сотруднику (задача 7а плана 04,
// D35.11, D35.12). Выделено из СМП_ТестыРаспознавания: зона новая, а модуль распознавания близок к пределу одного вызова прогона
// (~300 с). Общие помощники (подготовка поручения, таблицы плана, замечания, чтение реквизитов) живут в СМП_ТестыРаспознавания и
// вызываются оттуда (все экспортные). Правила - docs/architecture/testing.md.
//
// Каждый тест "поручение не берется" сначала доказывает, что те же данные БЕЗ единственного отличия берутся; каждый тест "берется"
// сначала доказывает на той же операции, что БЕЗ поручения результат иной (иначе зеленый цвет ничего не говорил бы о шаге 3).
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Шаг 3: поручение без контрагента, личные средства предпринимателя (D35.11)");
	Набор.ДобавитьСерверныйТест("Шаг3_БезКонтрагента_ВидИКорреспонденцияИзПоручения").ВТранзакции()
		// Описание, КонтрагентНайден
		.СПараметрами("контрагент операции не найден", Ложь)
		.СПараметрами("контрагент операции найден", Истина);
	Набор.ДобавитьСерверныйТест("Шаг3_БезКонтрагента_ОдноОтличие_ПоручениеНеБерется").ВТранзакции()
		// Описание, Отличие, КонтрагентНайден
		.СПараметрами("другой банковский счет поручения, контрагент не найден", "счет", Ложь)
		.СПараметрами("другой банковский счет поручения, контрагент найден", "счет", Истина)
		.СПараметрами("другая сумма", "сумма", Ложь)
		.СПараметрами("другой номер", "номер", Ложь)
		.СПараметрами("поступление, а не списание", "поступление", Ложь)
		.СПараметрами("вид поручения - перевод на другой счет (его определяет шаг 1)", "видПеревод", Ложь)
		.СПараметрами("вид поручения - оплата, без контрагента (в обход проверки вендора)", "видОплата", Ложь)
		.СПараметрами("у поручения чужой контрагент, у строки контрагента нет в базе", "контрагентДругой", Ложь)
		.СПараметрами("у поручения чужой контрагент, у строки найден другой", "контрагентДругой", Истина);
	Набор.ДобавитьСерверныйТест("Шаг3_БезКонтрагента_ДваОперацииОдноПоручение_БеретПервая").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Шаг3_БезКонтрагента_КандидатыВОдномПеречне_ГодРешает").ВТранзакции()
		// Описание, сдвиг лет поручения с контрагентом, сдвиг лет поручения без контрагента, кто взят ("С", "Без", "Никто")
		.СПараметрами("с контрагентом - прошлый год, без контрагента - год операции", -1, 0, "Без")
		.СПараметрами("с контрагентом - год операции, без контрагента - прошлый год", 0, -1, "С")
		.СПараметрами("оба года операции - год не решает", 0, 0, "Никто");
	Набор.ДобавитьСерверныйТест("Шаг3_БезКонтрагента_Запись_ДокументСКорреспонденциейПоручения").ВТранзакции()
		.СПараметрами("контрагент операции не найден", Ложь)
		.СПараметрами("контрагент операции найден", Истина);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Шаг 3: поручение без контрагента, сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область БезКонтрагента

// D35.11: поручение вида "Личные средства предпринимателя" с пустым контрагентом берется на любом состоянии контрагента строки -
// найден или нет в базе. Вид, статья и корреспонденция - из поручения; контрагент строки ПУСТ, а создание контрагента, счета и договора
// отменено (D6): иначе ФОП, снимающий деньги на свою карту, получил бы контрагента "сам себя". Предусловие, измеренное на той же операции:
// БЕЗ поручения контрагент строки найден (или будет создан), вид - по умолчанию, не личные средства.
Процедура Шаг3_БезКонтрагента_ВидИКорреспонденцияИзПоручения(Описание, КонтрагентНайден) Экспорт

	Сценарий = СценарийЛичныхСредств(КонтрагентНайден);

	Без = Распознать(Сценарий);
	ЮТест.ОжидаетЧто(Без.Строка.ДействиеКонтрагент, Описание + ": предусловие - без поручения действие над контрагентом")
		.Равно(?(КонтрагентНайден, "Найден", "Создать"));
	ЮТест.ОжидаетЧто(Без.Строка.ИсточникВидаОперации <> "ПлатежноеПоручение", Описание + ": предусловие - без поручения источник вида не поручение").ЭтоИстина();
	ЮТест.ОжидаетЧто(Без.Строка.ВидОперации, Описание + ": предусловие - без поручения вид не личные средства")
		.НеРавно(ВидСписания("ЛичныеСредстваПредпринимателя"));

	Поручение = ПоручениеЛичныхСредств(Сценарий);
	Результат = Распознать(Сценарий);

	ПроверитьВзятоБезКонтрагента(Результат, Поручение, Описание);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение").Количество(),
		Описание + ": замечаний о поручении нет (счет поручения - счет выписки)").Равно(0);

КонецПроцедуры

// Одно отличие - поручение не берется, и строка остается такой, какой была без поручения (контрагент не очищен, создание не отменено).
// Отличия: "счет" - банковский счет поручения не счет выписки (для поручения БЕЗ контрагента счет - условие, а не предупреждение: контрагента
// в ключе нет); "сумма", "номер"; "поступление" - шаг 3 только для списаний; "видПеревод" - вид поручения "Перевод на другой счет" (контрагент
// у него вендор не требует, тот же ключ; определяет вид шаг 1, шаг 3 его не берет); "видОплата" - вид "Оплата" без контрагента: вендор такое
// поручение не проводит и при записи не примет, поэтому ФИКСТУРА ЗАПИСАНА В ОБХОД ПРОВЕРКИ ВЕНДОРА (запись без проверки заполнения), и тест
// говорит лишь о том, что шаг 3 такое поручение не берет; "контрагентДругой" - у поручения контрагент заполнен и не тот, что в строке: нынешнее
// правило "контрагенты равны" для поручений с контрагентом не ослаблено.
Процедура Шаг3_БезКонтрагента_ОдноОтличие_ПоручениеНеБерется(Описание, Отличие, КонтрагентНайден) Экспорт

	Контроль = СценарийЛичныхСредств(КонтрагентНайден);
	ПоручениеКонтроля = ПоручениеЛичныхСредств(Контроль);
	ПроверитьВзятоБезКонтрагента(Распознать(Контроль), ПоручениеКонтроля, Описание + ": контроль - те же данные без отличия берутся");

	Сценарий = СценарийЛичныхСредств(КонтрагентНайден, Отличие);
	ДругойСчет = Неопределено;
	Если Отличие = "счет" Тогда
		ДругойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
		ЮТест.ОжидаетЧто(ДругойСчет <> СМП_ТестыРаспознавания.КонтекстСОрганизацией().БанковскийСчет,
			Описание + ": предусловие - счет поручения не счет выписки").ЭтоИстина();
	КонецЕсли;
	Поручение = ПоручениеЛичныхСредств(Сценарий, Отличие, ДругойСчет);

	Результат = Распознать(Сценарий);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ПлатежноеПоручение), Описание + ": поручение не взято").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации <> "ПлатежноеПоручение", Описание + ": источник вида не поручение").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, Описание + ": вид не личные средства")
		.НеРавно(ВидСписания("ЛичныеСредстваПредпринимателя"));
	Если Отличие <> "поступление" Тогда
		ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, Описание + ": действие над контрагентом не изменено")
			.Равно(?(КонтрагентНайден, "Найден", "Создать"));
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Поручение), Описание + ": предусловие - поручение записано").ЭтоИстина();

КонецПроцедуры

// Одно поручение - одна операция (как на шаге 0): две одинаковые по ключу операции, одно поручение без контрагента - берет первая по
// ПорядковыйНомер, вторая идет дальше с предупреждением "уже сопоставлено". Предусловие: каждая операция по отдельности поручение берет.
Процедура Шаг3_БезКонтрагента_ДваОперацииОдноПоручение_БеретПервая() Экспорт

	Сценарий = СценарийЛичныхСредств(Ложь);
	Поручение = ПоручениеЛичныхСредств(Сценарий);
	ПроверитьВзятоБезКонтрагента(Распознать(Сценарий), Поручение, "Предусловие: операция 1 одна");

	Вторая = Новый Структура;
	Для Каждого Элемент Из Сценарий.Операция Цикл
		Вторая.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Вторая.ПорядковыйНомер = 2;
	Вторая.ИдентификаторОперации = СМП_ТестыРаспознавания.НовыйИдентификатор();
	Вторая.КонтрагентКод = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	ПроверитьВзятоБезКонтрагента(РаспознатьТаблицу(Вторая, 2), Поручение, "Предусловие: операция 2 одна");

	План = СМП_ТестыРаспознавания.Распознать(СМП_ТестыРаспознавания.ТаблицаОпераций(Вторая, Сценарий.Операция),
		СМП_ТестыРаспознавания.КонтекстСОрганизацией());
	Первая = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1);
	Следующая = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 2);

	ЮТест.ОжидаетЧто(Первая.ПлатежноеПоручение, "Операция 1 взяла поручение").Равно(Поручение);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Следующая.ПлатежноеПоручение), "Операция 2 поручение не взяла").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Следующая.ИсточникВидаОперации <> "ПлатежноеПоручение", "Операция 2: источник вида не поручение").ЭтоИстина();
	Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(СМП_ТестыРаспознавания.ЗамечанияСтроки(План, 2), "ПлатежноеПоручение",
		СМП_ТестыРаспознавания.УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение у операции 2").Равно(1);
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), "Предупреждение: уже сопоставлено").Содержит("уже сопоставлено");
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Предупреждение называет операцию 1").Содержит("с операцией 1");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(СМП_ТестыРаспознавания.ЗамечанияСтроки(План, 1), "ПлатежноеПоручение").Количество(),
		"У операции 1 замечаний о поручении нет").Равно(0);

КонецПроцедуры

// Кандидаты с контрагентом и без него идут в ОДИН перечень: неоднозначность разрешает то же правило года (антипаттерн - отдельный проход для
// поручений без контрагента: одно поручение досталось бы двум операциям, а год не сравнивал бы поручения двух видов). Строка - с найденным
// контрагентом; поручение "С" - на него (вид "Прочее"), поручение "Без" - личные средства без контрагента; номера пишутся по-разному, цифры те же.
Процедура Шаг3_БезКонтрагента_КандидатыВОдномПеречне_ГодРешает(Описание, СдвигС, СдвигБез, ОжидаемоВзято) Экспорт

	Сценарий = СценарийЛичныхСредств(Истина);
	Момент = Сценарий.Момент;

	НастройкиС = Новый Структура;
	НастройкиС.Вставить("Контрагент", Сценарий.Контрагент);
	НастройкиС.Вставить("Сумма", Сценарий.Сумма);
	НастройкиС.Вставить("Номер", "ПП-00" + Сценарий.Номер);
	НастройкиС.Вставить("Дата", ДобавитьМесяц(Момент, 12 * СдвигС));
	НастройкиС.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"));
	НастройкиС.Вставить("Статья", СМП_ТестыРаспознавания.СтатьяПоручения());
	НастройкиС.Вставить("Корреспонденция", СМП_ТестыРаспознавания.КорреспонденцияПоручения());
	ПоручениеС = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(НастройкиС);

	ПоручениеБез = ПоручениеЛичныхСредств(Сценарий, "", Неопределено, Новый Структура("Номер, Дата", "ЦБ-" + Сценарий.Номер, ДобавитьМесяц(Момент, 12 * СдвигБез)));

	Результат = Распознать(Сценарий);

	Если ОжидаемоВзято = "Никто" Тогда
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ПлатежноеПоручение), Описание + ": ни одно поручение не взято").ЭтоЛожь();
		Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ПлатежноеПоручение", СМП_ТестыРаспознавания.УровеньПредупреждение());
		ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": одно предупреждение").Равно(1);
		ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": предупреждение о нескольких поручениях").Содержит("несколько");
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": в перечне поручение с контрагентом").Содержит(ПоручениеНомер(ПоручениеС));
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": в перечне поручение без контрагента").Содержит(ПоручениеНомер(ПоручениеБез));
	ИначеЕсли ОжидаемоВзято = "С" Тогда
		ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, Описание + ": взято поручение с контрагентом").Равно(ПоручениеС);
		ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, Описание + ": контрагент строки не очищен").Равно(Сценарий.Контрагент);
		ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, Описание + ": контрагент найден").Равно("Найден");
	Иначе
		ЮТест.ОжидаетЧто(Результат.Строка.ПлатежноеПоручение, Описание + ": взято поручение без контрагента").Равно(ПоручениеБез);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.Контрагент), Описание + ": контрагент строки очищен").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Результат.Строка.ВидОперации, Описание + ": вид - личные средства").Равно(ВидСписания("ЛичныеСредстваПредпринимателя"));
	КонецЕсли;

КонецПроцедуры

// Наскрозь с записью (D35.10, D6): распознавание + запись. Поручение личных средств без контрагента, корреспонденция поручения НЕ равна той,
// что ставит вендорский метод заполнения (НераспределеннаяПрибыль). Документ: основа взята (ДокументОснование - поручение), корреспонденция
// поручения, контрагента в документе нет и ничего не создано (ни контрагента, ни счета, ни договора), документ проведен, ошибок нет, поручение
// помечено "Оплачено" вендором. Если распознавание не очищает контрагента строки, запись отвергает поручение как "контрагент с одной стороны"
// (правило записи тянется именно на этом очищении) - тест красный; если очищает, но оставляет создание - красный по созданному контрагенту.
Процедура Шаг3_БезКонтрагента_Запись_ДокументСКорреспонденциейПоручения(Описание, КонтрагентНайден) Экспорт

	Сценарий = СценарийЛичныхСредств(КонтрагентНайден);
	Корреспонденция = ПредопределенноеЗначение("ПланСчетов.Управленческий.ПрочиеРасходы");
	ЮТест.ОжидаетЧто(Корреспонденция, Описание + ": предусловие - корреспонденция поручения не равна вендорской")
		.НеРавно(ПредопределенноеЗначение("ПланСчетов.Управленческий.НераспределеннаяПрибыль"));
	Поручение = ПоручениеЛичныхСредств(Сценарий, "", Неопределено, Новый Структура("Корреспонденция", Корреспонденция));
	Распознавание = Распознать(Сценарий);
	ЮТест.ОжидаетЧто(Распознавание.Строка.ПлатежноеПоручение, Описание + ": предусловие - распознавание взяло поручение").Равно(Поручение);

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(Распознавание.План);

	Объект = Прогон.Объект;
	Текст = СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат);
	ЮТест.ОжидаетЧто(Объект <> Неопределено, Описание + ": документ записан (замечания: " + Текст + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята - ДокументОснование - поручение (замечания: " + Текст + ")").Равно(Поручение);
	ЮТест.ОжидаетЧто(Объект.Корреспонденция, Описание + ": корреспонденция поручения (D35.10)").Равно(Корреспонденция);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.Контрагент), Описание + ": контрагента в документе нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Прогон.СтрокаРезультата.СозданКонтрагент), Описание + ": контрагент не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Прогон.СтрокаРезультата.СозданСчет), Описание + ": счет не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Прогон.СтрокаРезультата.СозданДоговор), Описание + ": договор не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + Текст + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.Проведен, Описание + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Ошибка").Количество(), Описание + ": ошибок нет").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), Описание + ": предупреждений нет").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Поручение, "Оплачено"), Описание + ": поручение помечено Оплачено вендором").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Сторож

Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Операция списания (или поступления) и контрагент строки: найденный по коду (КонтрагентНайден) или нет в базе. Поручений в базе еще нет.
// Отличие учитывается только для направления ("поступление"). Результат: Операция, Контрагент (Неопределено, если не найден), Номер, Сумма, Момент.
Функция СценарийЛичныхСредств(КонтрагентНайден, Отличие = "")

	Номер = СМП_ТестыРаспознавания.НовыйЦифровойНомер();
	Сумма = СМП_ТестыРаспознавания.УникальнаяСумма();
	Момент = ТекущаяДатаСеанса();
	Контрагент = Неопределено;
	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Если КонтрагентНайден Тогда
		Контрагент = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		Код = СМП_ТестыРаспознавания.ДанныеКонтрагента(Контрагент).Код;
	КонецЕсли;
	Направление = СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка." + ?(Отличие = "поступление", "НаправлениеПоступило", "НаправлениеСписано"));

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура(
		"ПорядковыйНомер, Направление, КонтрагентКод, КонтрагентНаименование, Сумма, НомерДокумента, ДатаОперации, ДатаДокумента",
		1, Направление, Код, "", Сумма, Номер, Момент, НачалоДня(Момент)));

	Возврат Новый Структура("Операция, Контрагент, Номер, Сумма, Момент", Операция, Контрагент, Номер, Сумма, Момент);

КонецФункции

// Платежное поручение личных средств БЕЗ контрагента (и без договора), ключ - как у операции сценария. Отличие: "" - все совпадает; "сумма",
// "номер"; "счет" (БанковскийСчет - второй счет организации, передается отдельно); "видПеревод", "видОплата" - другой вид поручения;
// "контрагентДругой" - у поручения заполнен посторонний контрагент. Дополнительно - ключи НовоеПлатежноеПоручение, заменяющие значения.
Функция ПоручениеЛичныхСредств(Сценарий, Отличие = "", БанковскийСчет = Неопределено, Дополнительно = Неопределено)

	Настройки = Новый Структура;
	Настройки.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Настройки.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Настройки.Вставить("Сумма", Сценарий.Сумма);
	Настройки.Вставить("Номер", "ПП-00" + Сценарий.Номер);
	Настройки.Вставить("Дата", НачалоДня(Сценарий.Момент));
	Настройки.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ЛичныеСредстваПредпринимателя"));
	Настройки.Вставить("Статья", СМП_ТестыРаспознавания.СтатьяПоручения());
	Настройки.Вставить("Корреспонденция", СМП_ТестыРаспознавания.КорреспонденцияПоручения());

	Если Отличие = "сумма" Тогда
		Настройки.Сумма = Сценарий.Сумма + 1;
	ИначеЕсли Отличие = "номер" Тогда
		Настройки.Номер = "ПП-00" + Формат(Число(Сценарий.Номер) + 1, "ЧГ=0");
	ИначеЕсли Отличие = "видПеревод" Тогда
		Настройки.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПереводНаДругойСчет");
	ИначеЕсли Отличие = "видОплата" Тогда
		Настройки.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Оплата");
	ИначеЕсли Отличие = "контрагентДругой" Тогда
		// Договор не задан: фикстура создаст договор этого контрагента.
		Настройки.Контрагент = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		Настройки.Удалить("Договор");
	ИначеЕсли Не ПустаяСтрока(Отличие) И Отличие <> "счет" И Отличие <> "поступление" Тогда
		ВызватьИсключение "ПоручениеЛичныхСредств: неизвестное отличие '" + Отличие + "'";
	КонецЕсли;
	Если БанковскийСчет <> Неопределено Тогда
		Настройки.Вставить("БанковскийСчет", БанковскийСчет);
	КонецЕсли;
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Настройки);

КонецФункции

// Распознает одну операцию сценария. Результат: План, Строка, Замечания.
Функция Распознать(Сценарий)

	Возврат РаспознатьТаблицу(Сценарий.Операция, Сценарий.Операция.ПорядковыйНомер);

КонецФункции

Функция РаспознатьТаблицу(Операция, ПорядковыйНомер)

	План = СМП_ТестыРаспознавания.Распознать(СМП_ТестыРаспознавания.ТаблицаОпераций(Операция), СМП_ТестыРаспознавания.КонтекстСОрганизацией());

	Результат = Новый Структура("План, Строка, Замечания");
	Результат.План = План;
	Результат.Строка = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, ПорядковыйНомер);
	Результат.Замечания = СМП_ТестыРаспознавания.ЗамечанияСтроки(План, ПорядковыйНомер);

	Возврат Результат;

КонецФункции

// Строка плана взята из поручения личных средств без контрагента: поручение, источники, вид, статья, корреспонденция - из поручения; контрагент
// строки пуст, создание контрагента, счета и договора отменено (действия "НеТребуется"), "Проверьте операцию" снята, ошибок нет.
Процедура ПроверитьВзятоБезКонтрагента(Результат, Поручение, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ПлатежноеПоручение, Описание + ": платежное поручение в строке").Равно(Поручение);
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции из поручения").Равно(ВидСписания("ЛичныеСредстваПредпринимателя"));
	ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Описание + ": статья из поручения").Равно(СМП_ТестыРаспознавания.СтатьяПоручения());
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Описание + ": источник статьи - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.Корреспонденция, Описание + ": корреспонденция из поручения").Равно(СМП_ТестыРаспознавания.КорреспонденцияПоручения());
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Контрагент), Описание + ": контрагент строки очищен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СчетКонтрагента), Описание + ": счет контрагента строки очищен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Договор), Описание + ": договор строки пуст").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": создание контрагента отменено").Равно("НеТребуется");
	ЮТест.ОжидаетЧто(Строка.ДействиеСчет, Описание + ": создание счета отменено").Равно("НеТребуется");
	ЮТест.ОжидаетЧто(Строка.ДействиеДоговор, Описание + ": создание договора отменено").Равно("НеТребуется");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоУровню(Результат.Замечания, СМП_ТестыРаспознавания.УровеньОшибка()).Количество(),
		Описание + ": ошибок нет").Равно(0);

КонецПроцедуры

Функция ВидСписания(Имя)

	Возврат ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета." + Имя);

КонецФункции

Функция ПоручениеНомер(Поручение)

	Возврат СМП_ТестыРаспознавания.ЧитатьРеквизиты(Поручение, "Номер").Номер;

КонецФункции

