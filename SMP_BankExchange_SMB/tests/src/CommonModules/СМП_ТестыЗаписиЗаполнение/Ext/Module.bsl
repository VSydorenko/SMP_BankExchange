#Область Помощники

// Виды операции таблицы Вид_ЗаполнениеИРезультат (задача 5), все 26, в порядке регистрации. Используется модулем СМП_ТестыЗаписиЗачет
// (вариант заполнения расшифровки на всех видах таблицы). СИНХРОННОСТЬ СО СПИСКОМ РЕГИСТРАЦИИ В ИсполняемыеСценарии - ВРУЧНУЮ: добавляя вид
// в таблицу, добавьте его и сюда (тест Вариант_СписокВидовНеПуст_ДанныеВидаСтроятся ловит только число видов).
Функция ВидыТаблицы() Экспорт

	Виды = "ПоступлениеНаСчет.ОтПокупателя,ПоступлениеНаСчет.ОтПоставщика,ПоступлениеНаСчет.ОтНашейОрганизации,РасходСоСчета.Поставщику,"
		+ "РасходСоСчета.Покупателю,РасходСоСчета.НашейОрганизации,ПоступлениеНаСчет.ПереводСДругогоСчета,РасходСоСчета.ПереводНаДругойСчет,"
		+ "РасходСоСчета.ЗарплатаСотруднику,РасходСоСчета.Подотчетнику,РасходСоСчета.КомиссияБанка,ПоступлениеНаСчет.Налоги,РасходСоСчета.Налоги,"
		+ "ПоступлениеНаСчет.Прочее,РасходСоСчета.Прочее,РасходСоСчета.НаРасходы,ПоступлениеНаСчет.ЛичныеСредстваПредпринимателя,"
		+ "РасходСоСчета.ЛичныеСредстваПредпринимателя,ПоступлениеНаСчет.ПоступлениеОплатыПоКартам,ПоступлениеНаСчет.ПоступлениеОплатыПоКредитам,"
		+ "ПоступлениеНаСчет.РасчетыПоКредитам,РасходСоСчета.ВозвратОплатыНаПлатежныеКарты,РасходСоСчета.ВозвратПродажиВКредит,"
		+ "РасходСоСчета.РасчетыПоКредитам,РасходСоСчета.Зарплата,РасходСоСчета.ПрочиеРасчеты";

	Возврат СтрРазделить(Виды, ",");

КонецФункции

// Данные одного вида операции: Сценарий (для СМП_ТестыЗаписиКаркас.ДобавитьСтроку; статья плана пуста), Настройки (колонки плана),
// Ожидание (что должно оказаться в документе). БезДанных = Истина - не давать плану того, чего вид требует (вид налога, корреспонденцию,
// счет контрагента, подотчетника).
Функция ДанныеВида(Вид, БезДанных = Ложь) Экспорт

	Части = СтрРазделить(Вид, ".");
	ИмяДокумента = Части[0];
	Имя = Части[1];
	ЭтоПоступление = (ИмяДокумента = "ПоступлениеНаСчет");
	ВидОперации = ?(ЭтоПоступление, Перечисления.ВидыОперацийПоступлениеНаСчет[Имя], Перечисления.ВидыОперацийРасходСоСчета[Имя]);
	Признаки = Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь);

	Настройки = Новый Структура("ПорядковыйНомер", 1);
	Ожидание = Новый Структура;
	Ожидание.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Ожидание.Вставить("СчетКонтрагента", Справочники.БанковскиеСчета.ПустаяСсылка());
	Ожидание.Вставить("Подотчетник", Справочники.Сотрудники.ПустаяСсылка());
	Ожидание.Вставить("ВидНалога", Справочники.ВидыНалогов.ПустаяСсылка());
	Ожидание.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Ожидание.Вставить("Строк", 0);

	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

	СРасчетами = "ОтПокупателя,ОтПоставщика,Поставщику,Покупателю,ПоступлениеОплатыПоКартам,ПоступлениеОплатыПоКредитам,ВозвратОплатыНаПлатежныеКарты,ВозвратПродажиВКредит";
	Наши = "ОтНашейОрганизации,НашейОрганизации";
	БезДоговора = "КомиссияБанка,РасчетыПоКредитам";

	Если СтрРазделить(СРасчетами + "," + Наши, ",").Найти(Имя) <> Неопределено Тогда
		Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);
		ВидДоговора = ?(Имя = "ОтПокупателя" Или Имя = "Покупателю", Перечисления.ВидыДоговоров.СПокупателем, Перечисления.ВидыДоговоров.СПоставщиком);
		Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ВидДоговора));
		Ожидание.Контрагент = Контрагент;
		Ожидание.Договор = Договор;
		Ожидание.Строк = 1;
		Если СтрРазделить(Наши, ",").Найти(Имя) <> Неопределено Тогда
			Организация2 = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Контрагент));
			Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация2);
			Настройки.Вставить("СчетКонтрагента", Счет);
			Ожидание.СчетКонтрагента = Счет;
		КонецЕсли;
	ИначеЕсли СтрРазделить(БезДоговора, ",").Найти(Имя) <> Неопределено Тогда
		Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);
		Ожидание.Контрагент = Контрагент;
	ИначеЕсли Имя = "ПереводСДругогоСчета" Или Имя = "ПереводНаДругойСчет" Тогда
		Если Не БезДанных Тогда
			Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
			Настройки.Вставить("СчетКонтрагента", Счет);
			Ожидание.СчетКонтрагента = Счет;
		КонецЕсли;
	ИначеЕсли Имя = "ЗарплатаСотруднику" Или Имя = "Подотчетнику" Тогда
		Если Не БезДанных Тогда
			Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудник(СМП_ТестыДанныеУНФ.НовоеФизЛицо());
			Контрагент = Сотрудник;
			Ожидание.Подотчетник = Сотрудник;
		КонецЕсли;
	ИначеЕсли Имя = "Налоги" Тогда
		Если Не БезДанных Тогда
			Настройки.Вставить("ВидНалога", Справочники.ВидыНалогов.ВоенныйСбор);
			Ожидание.ВидНалога = Справочники.ВидыНалогов.ВоенныйСбор;
		КонецЕсли;
	ИначеЕсли Имя = "Прочее" Или Имя = "НаРасходы" Или Имя = "ПрочиеРасчеты" Тогда
		Если Не БезДанных Тогда
			Настройки.Вставить("Корреспонденция", ?(ЭтоПоступление, ПланыСчетов.Управленческий.ПрочиеДоходы,
				?(Имя = "ПрочиеРасчеты", ПланыСчетов.Управленческий.РасчетыСРазнымиДебиторамиИКредиторами, ПланыСчетов.Управленческий.ПрочиеРасходы)));
		КонецЕсли;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Сценарий", НовыйСценарийВида(ИмяДокумента, ВидОперации, Контрагент, Договор));
	Данные.Вставить("Настройки", Настройки);
	Данные.Вставить("Ожидание", Ожидание);

	Возврат Данные;

КонецФункции

// Сценарий для СМП_ТестыЗаписиКаркас.ДобавитьСтроку; статья плана пуста (статью ставит продукт).
Функция НовыйСценарийВида(ИмяДокумента, ВидОперации, Контрагент, Договор) Экспорт

	Сценарий = Новый Структура;
	Сценарий.Вставить("Вид", ИмяДокумента);
	Сценарий.Вставить("Контрагент", Контрагент);
	Сценарий.Вставить("Договор", Договор);
	Сценарий.Вставить("Статья", Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка());
	Сценарий.Вставить("ВидОперации", ВидОперации);

	Возврат Сценарий;

КонецФункции

Функция СтавкаПоИмени(Имя)

	Если Имя = "Организация" Тогда
		Возврат Справочники.СтавкиНДС.СтавкаНДС(СМП_ТестыДанныеУНФ.Организация().ВидСтавкиНДСПоУмолчанию, ТекущаяДатаСеанса());
	КонецЕсли;

	Возврат Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС[Имя], ТекущаяДатаСеанса());

КонецФункции

// Тексты замечаний результата одной строкой ("Уровень: текст"), для сообщения утверждения. Уровень и номер строки - необязательные отборы.
Функция ТекстыЗамечаний(Результат, Уровень = Неопределено, ПорядковыйНомер = Неопределено)

	Тексты = Новый Массив;
	Для Каждого Замечание Из Результат.Замечания Цикл
		Если Уровень <> Неопределено И Замечание.Уровень <> Уровень Тогда
			Продолжить;
		КонецЕсли;
		Если ПорядковыйНомер <> Неопределено И Замечание.ПорядковыйНомер <> ПорядковыйНомер Тогда
			Продолжить;
		КонецЕсли;
		Тексты.Добавить(Замечание.Уровень + ": " + СтрЗаменить(Замечание.Текст, Символ(0), "<NUL>"));
	КонецЦикла;

	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

#КонецОбласти
