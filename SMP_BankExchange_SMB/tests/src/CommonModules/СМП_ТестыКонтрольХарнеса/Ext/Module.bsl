// Контроль харнеса YaXUnit для SMP_BankExchange_SMB.
//
// Мета модуля — довести, що тестовий контур у базі агента справді виконує тести і вміє
// повідомити про провал. Зелений прогін сам по собі цього не доводить: контроль має вміти
// впасти. Тому при розгортанні контуру тест «ОбчисленняВиконуєтьсяНаСервері» спершу прогнано
// з навмисно хибним очікуванням .Равно(3) — червоний прогін 2026-10-12: total=3, failed=1 саме на ньому;
// потім виправлено на .Равно(2) — зелений.
//
// Тест на параметризацію — зразок за SMP_SimplyConnect: кожен набор .СПараметрами дає окремий
// testcase, тож total у зведенні доводить склад прогону.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Контроль харнеса")
			.ДобавитьСерверныйТест("ОбчисленняВиконуєтьсяНаСервері")
			.ДобавитьСерверныйТест("ОбразецПараметризации")
				.СПараметрами("перший", 1)
				.СПараметрами("другий", 2);

КонецПроцедуры

Процедура ОбчисленняВиконуєтьсяНаСервері() Экспорт

	Сума = 1 + 1;
	ЮТест.ОжидаетЧто(Сума, "Сума 1 + 1")
		.Равно(2);

КонецПроцедуры

Процедура ОбразецПараметризации(Имя, Номер) Экспорт

	ЮТест.ОжидаетЧто(Номер, "Номер набору " + Имя)
		.Больше(0);

КонецПроцедуры
