КонецПроцедуры

Процедура ФайлПохож_НеТекстовыйМусорПустойИКороткийЗаголовок(Описание, Вид) Экспорт

	Если Вид = "" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
	ИначеЕсли Вид = "16колонок" Тогда
		Заголовок = Колонки(ЗаголовокАкорда());
		Заголовок.Удалить(16);
		Файл = ФайлИзСтрок(СтрРазделить(СтрСоединить(Заголовок, ";") + "|" + БазоваяСтрока(), "|"));
	Иначе
		Файл = ПолучитьДвоичныеДанныеИзСтроки(Вид, "windows-1251", Ложь);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "Не выписка формата: " + Описание).ЭтоЛожь();

КонецПроцедуры

Процедура ФайлПохож_СтрокиРеестраДляФайлаУзнаютВсеШесть() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыпискаCSVАкорд"));
	Узнанные = Продукт("СтрокиРеестраДляФайла", Параметры);

	Список = Новый Массив;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат = ФорматМодуля() Тогда
			Список.Добавить(СтрокаРеестра.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Идентификатор Из Список Цикл
		ЮТест.ОжидаетЧто(Узнанные.Найти(Идентификатор) <> Неопределено, "Файл узнан строкой " + Идентификатор).ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(Список.Количество(), "Строк формата в реестре").Равно(6);

КонецПроцедуры

// Контроль: проверка формата умеет отвечать Ложь на файл, который она обязана отвергнуть, и Истина - на допустимый.
Процедура ФайлПохож_ПроверкаУмеетПадать() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаCSVАкорд")), "Допустимый вход: Истина").ЭтоИстина();
	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLПивденный")), "Недопустимый вход: Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Переносимость

// Модуль формата не знает названий банков: отличие банка живет в Вариант строки реестра, а не в имени
// банка в тексте. Сам модуль формата читается в этом тесте как данные - исходного текста у теста нет,
// поэтому проверяется поведение: чтение не зависит от того, какой строкой реестра файл прочитан.
Процедура Модуль_НеЗнаетНазванийБанков() Экспорт

	Эталон = РазобратьЭталон("CSVАкорд");
	Номера = Новый Массив;
	Номера.Добавить(Эталон.НомерСчетаЧтения);
	Данные = Макет("СМП_ТестВыпискаCSVАкорд");

	ПервыйРезультат = Неопределено;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат <> ФорматМодуля() Тогда
			Продолжить;
		КонецЕсли;
		Результат = ПрочитатьФайл(СтрокаРеестра.Идентификатор, Данные, Номера);
		Если ПервыйРезультат = Неопределено Тогда
			ПервыйРезультат = ОписаниеОпераций(Результат);
		Иначе
			ЮТест.ОжидаетЧто(ОписаниеОпераций(Результат), "Чтение не зависит от строки реестра: " + СтрокаРеестра.Идентификатор)
				.Равно(ПервыйРезультат);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ПервыйРезультат <> Неопределено, "Хотя бы одна строка прочитана").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ФорматМодуля()

	Возврат "СМП_ЧитательВыпискиiFOBS_CSV";

КонецФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Если СтрНайти(ИмяМетода, ".") = 0 Тогда
		Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(ИдентификаторСтроки);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьФайл", Параметры);

КонецФункции

// Читает образец через реестр, номер нашего счета - из эталона.
Функция ПрочитатьОбразец(ИдОбразца, ИдСтроки)

	Эталон = РазобратьЭталон(ИдОбразца);
	Номера = Новый Массив;
	Номера.Добавить(Эталон.НомерСчетаЧтения);
	Возврат ПрочитатьФайл(ИдСтроки, Макет("СМП_ТестВыписка" + ИдОбразца), Номера);

КонецФункции

// Читает синтетический файл (счет базовой строки) строкой реестра Акорда.
Функция ПрочитатьСинтетику(Файл)

	Номера = Новый Массив;
	Номера.Добавить(Колонки(БазоваяСтрока())[2]);
	Возврат ПрочитатьФайл("Акорд_CSV", Файл, Номера);

КонецФункции

Функция ФайлПохож(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат Продукт(ФорматМодуля() + ".ФайлПохожНаФормат", Параметры);

КонецФункции

Функция Макет(Имя)

	Возврат Обработки.СМП_ТестыМакеты.ПолучитьМакет(Имя);

КонецФункции

Функция Текст1251(Данные)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "windows-1251");

КонецФункции

// Записи файла тем же контейнером, что и продукт, но независимо от модуля формата.
Функция ЗаписиФайла(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Параметры.Добавить("windows-1251");
	Параметры.Добавить(";");
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ЗаписиCSV", Параметры);

КонецФункции

Функция СтрокаРеестраПоИдентификатору(Идентификатор)

	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция БезNUL(Текст)

	Возврат СтрЗаменить(Текст, Символ(0), "<NUL>");

КонецФункции

Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Сообщения диагностики с уровнем как массив структур (ПорядковыйНомер, Текст).
Функция ДиагностикаПоУровню(Результат, Уровень)

	Сообщения = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Сообщения.Добавить(Новый Структура("ПорядковыйНомер, Текст", Сообщение.ПорядковыйНомер, Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

Функция ТекстовыеПоляОперации(Операция)

	Поля = Новый Массив;
	Поля.Добавить(Операция.КонтрагентНаименование);
	Поля.Добавить(Операция.НазначениеПлатежа);
	Поля.Добавить(Операция.КонтрагентНомерСчета);
	Поля.Добавить(Операция.НомерДокумента);
	Возврат Поля;

КонецФункции

// Строка операции для сравнения результатов чтения (без NUL).
Функция ОписаниеОпераций(Результат)

	Части = Новый Массив;
	Для Каждого Операция Из Результат.Операции Цикл
		Части.Добавить(СтрШаблон("%1|%2|%3|%4|%5|%6", Операция.ПорядковыйНомер, Операция.НомерСчета,
			Формат(Операция.ДатаОперации, "ДФ=yyyyMMddHHmmss"), Операция.Сумма, Операция.Направление,
			БезNUL(Операция.НазначениеПлатежа)));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

#КонецОбласти

#Область Синтетика

// Заголовок и базовая строка берутся из образца Акорда (знеособленный файл): строки 1 и 2.
Функция ЗаголовокАкорда()

	Возврат СтрЗаменить(СтрРазделить(Текст1251(Макет("СМП_ТестВыпискаCSVАкорд")), Символы.ПС)[0], Символы.ВК, "");

КонецФункции

Функция БазоваяСтрока()

	Возврат СтрЗаменить(СтрРазделить(Текст1251(Макет("СМП_ТестВыпискаCSVАкорд")), Символы.ПС)[1], Символы.ВК, "");

КонецФункции

// Колонки строки без разбора кавычек: в базовой строке «;» внутри кавычек нет.
Функция Колонки(Строка)

	Возврат СтрРазделить(Строка, ";", Истина);

КонецФункции

// Файл: заголовок, базовая строка, вторая строка с заменами колонок (номер колонки -> текст поля).
Функция СинтетическийФайл(Знач ДополнительныеСтроки, Замены)

	Вторая = Колонки(БазоваяСтрока());
	Для Каждого Замена Из Замены Цикл
		Вторая[Замена.Ключ] = Замена.Значение;
	КонецЦикла;
	Строки = Новый Массив;
	Строки.Добавить(ЗаголовокАкорда());
	Строки.Добавить(БазоваяСтрока());
	Строки.Добавить(СтрСоединить(Вторая, ";"));
	Для Каждого Строка Из ДополнительныеСтроки Цикл
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат ФайлИзСтрок(Строки);

КонецФункции

Функция ФайлИзСтрок(Строки)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС,
		"windows-1251", Ложь);

КонецФункции

#КонецОбласти

#Область Эталон

// Разбор эталона версии 1. Значения экранированы (\\, \t, \n, \r), поля разделены TAB.
// Возвращает структуру: НомерСчетаЧтения, ЗаписейИсточника, Счета, Операции (массив структур по
// именам колонок эталона), Диагностика, ЧужиеСчета.
Функция РазобратьЭталон(ИдОбразца)

	Документ = Макет("СМП_ТестЭталон" + ИдОбразца);
	Результат = Новый Структура("НомерСчетаЧтения, ЗаписейИсточника, Счета, Операции, Диагностика, ЧужиеСчета",
		"", 0, Новый Массив, Новый Массив, Новый Массив, Новый Массив);

	Раздел = "";
	Шапка = Неопределено;
	Для Номер = 1 По Документ.КоличествоСтрок() Цикл
		Строка = СтрЗаменить(Документ.ПолучитьСтроку(Номер), Символ(65279), "");
		Если Строка = "" Или Лев(Строка, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Строка, 1) = "[" Тогда
			Раздел = Строка;
			Шапка = Неопределено;
			Продолжить;
		КонецЕсли;

		Если Раздел = "[Образец]" Или Лев(Строка, 17) = "НомерСчетаЧтения=" Тогда
			Позиция = СтрНайти(Строка, "=");
			Ключ = Лев(Строка, Позиция - 1);
			Значение = РазэкранироватьЭталон(Сред(Строка, Позиция + 1));
			Если Ключ = "НомерСчетаЧтения" Тогда
				Результат.НомерСчетаЧтения = Значение;
			ИначеЕсли Ключ = "ЗаписейИсточника" Тогда
				Результат.ЗаписейИсточника = Число(Значение);
			КонецЕсли;
		ИначеЕсли Раздел = "[Счета]" Тогда
			Результат.Счета.Добавить(РазэкранироватьЭталон(СтрРазделить(Строка, Символы.Таб, Истина)[0]));
		Иначе
			Поля = СтрРазделить(Строка, Символы.Таб, Истина);
			Для Индекс = 0 По Поля.ВГраница() Цикл
				Поля[Индекс] = РазэкранироватьЭталон(Поля[Индекс]);
			КонецЦикла;
			Если Шапка = Неопределено Тогда
				Шапка = Поля;
				Продолжить;
			КонецЕсли;
			Запись = Новый Структура;
			Для Индекс = 0 По Шапка.ВГраница() Цикл
				Запись.Вставить(Шапка[Индекс], ?(Индекс <= Поля.ВГраница(), Поля[Индекс], ""));
			КонецЦикла;
			Если Раздел = "[Операции]" Тогда
				Запись.ПорядковыйНомер = Число(Запись.ПорядковыйНомер);
				Результат.Операции.Добавить(Запись);
			ИначеЕсли Раздел = "[Диагностика]" Тогда
				Результат.Диагностика.Добавить(Запись);
			ИначеЕсли Раздел = "[ЧужиеСчета]" Тогда
				Результат.ЧужиеСчета.Добавить(Запись);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазэкранироватьЭталон(Текст)

	Если СтрНайти(Текст, "\") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "\" И Позиция < Длина Тогда
			Следующий = Сред(Текст, Позиция + 1, 1);
			Если Следующий = "t" Тогда
				Части.Добавить(Символы.Таб);
			ИначеЕсли Следующий = "n" Тогда
				Части.Добавить(Символы.ПС);
			ИначеЕсли Следующий = "r" Тогда
				Части.Добавить(Символы.ВК);
			ИначеЕсли Следующий = "\" Тогда
				Части.Добавить("\");
			Иначе
				Части.Добавить(Символ + Следующий);
			КонецЕсли;
			Позиция = Позиция + 2;
		Иначе
			Части.Добавить(Символ);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// ГГГГ-ММ-ДДTгг:хх:сс -> Дата.
Функция ДатаЭталона(Текст)

	Возврат Дата(Лев(Текст, 4) + Сред(Текст, 6, 2) + Сред(Текст, 9, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2) + Сред(Текст, 18, 2));

КонецФункции

Функция ТекстДаты(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция ТекстСуммы(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=");

КонецФункции

// Известное отступление: Валюта - эталон пуст, получено "980"; ДатаОперации - та же минута, секунды
// как в записи файла (время ЧЧ:ММ:СС из полученной даты стоит в СырыеДанные).
Функция ЭтоИзвестноеОтступление(Поле, Ожидаемое, Полученное, Операция)

	Если Поле = "Валюта" Тогда
		Возврат Ожидаемое = "" И Полученное = "980";
	ИначеЕсли Поле = "ДатаОперации" Тогда
		Возврат Лев(Ожидаемое, 16) = Лев(Полученное, 16) И Прав(Ожидаемое, 2) = "00"
			И СтрНайти(Операция.СырыеДанные, Формат(Операция.ДатаОперации, "ДФ=HH:mm:ss")) > 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Сверка одной операции с эталоном поле за полем: «образец, строка файла, поле, ожидаемое, полученное».
Процедура СверитьОперацию(Образец, Операция, Ожидаемая, ПолеОтступления, Отступления)

	Сообщение = "Образец " + Образец + ", строка " + Ожидаемая.ПорядковыйНомер + ", поле ";

	Сверка = Новый Структура;
	Сверка.Вставить("ПорядковыйНомер", Новый Структура("Ожидаемое, Полученное", Формат(Ожидаемая.ПорядковыйНомер, "ЧГ="), Формат(Операция.ПорядковыйНомер, "ЧГ=")));
	Сверка.Вставить("НомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерСчета, Операция.НомерСчета));
	Сверка.Вставить("Валюта", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Валюта, Операция.Валюта));
	Сверка.Вставить("ДатаОперации", Новый Структура("Ожидаемое, Полученное", Ожидаемая.ДатаОперации, ТекстДаты(Операция.ДатаОперации)));
	Сверка.Вставить("НомерДокумента", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерДокумента, Операция.НомерДокумента));
	Сверка.Вставить("Сумма", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Сумма, ТекстСуммы(Операция.Сумма)));
	Сверка.Вставить("Направление", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Направление, Операция.Направление));
	Сверка.Вставить("КонтрагентНаименование", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНаименование, Операция.КонтрагентНаименование));
	Сверка.Вставить("КонтрагентНомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНомерСчета, Операция.КонтрагентНомерСчета));
	Сверка.Вставить("КонтрагентКод", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентКод, Операция.КонтрагентКод));
	Сверка.Вставить("КонтрагентМФО", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентМФО, Операция.КонтрагентМФО));
	Сверка.Вставить("НазначениеПлатежа", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НазначениеПлатежа, Операция.НазначениеПлатежа));

	// Отступ 2 (продолжение): в эталоне NUL убран, продукт ставит на его место апостроф. Запись файла с NUL
	// сверяется без апострофов, плюс длина больше ровно на число NUL.
	КоличествоNUL = СтрЧислоВхождений(Операция.СырыеДанные, Символ(0));

	Для Каждого Поле Из Сверка Цикл
		Ожидаемое = Поле.Значение.Ожидаемое;
		Полученное = Поле.Значение.Полученное;
		Если Поле.Ключ = "НазначениеПлатежа" И КоличествоNUL > 0 Тогда
			ЮТест.ОжидаетЧто(СтрДлина(Полученное) - СтрДлина(Ожидаемое), Сообщение + Поле.Ключ + ": апострофов больше ожидаемого на число NUL")
				.Равно(КоличествоNUL);
			Ожидаемое = СтрЗаменить(Ожидаемое, "'", "");
			Полученное = СтрЗаменить(Полученное, "'", "");
		КонецЕсли;
		Если Полученное <> Ожидаемое Тогда
			Если Поле.Ключ = ПолеОтступления И ЭтоИзвестноеОтступление(Поле.Ключ, Ожидаемое, Полученное, Операция) Тогда
				Отступления.Добавить(Операция.ПорядковыйНомер);
				Продолжить;
			КонецЕсли;
			ЮТест.ОжидаетЧто(БезNUL(Полученное), Сообщение + Поле.Ключ + ": ожидалось «" + БезNUL(Ожидаемое) + "»").Равно(БезNUL(Ожидаемое));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
