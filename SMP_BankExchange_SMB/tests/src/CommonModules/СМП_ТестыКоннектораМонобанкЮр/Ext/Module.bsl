// Тесты конектора monobank юросіб (план 05а, задача 4). Правило владельца 2026-10-20: «тестировать только ключевое
// и критически важное» - тестов ровно три, перечень в плане - верхняя граница.
//
//   Т1 - сквозной, по ВСЕМ записям банка mono-corp (синтетика задачи 2 и обезличенные записи run1): запись ->
//        транспорт воспроизведения -> конектор через точку чтения -> конверт; сравнение с эталоном оракула
//        («ожидаемое») поле за полем: операции, диагностика (уровень, номер и факты, различающие суть: статус, состояние, id; кода сути в контракте
//        диагностики нет, текст на код не разбирается, план fc84f12), ЧтениеПолное, ГраницаДоверия, класс
//        отказа, запросы и паузы; поля ключа D17 - из режима «старая обработка» того же эталона. Лишний или
//        пропущенный запрос ловит сам транспорт воспроизведения. Сообщение: «запис X, операція N, поле F».
//   Т2 - инвариант безопасности: синтетический токен не встречается ни в одном тексте результата (признак внутри Т1).
//   Т3 - контроль харнеса: эталон с одним испорченным полем дает красное (без конектора, на конверте, собранном из
//        самого эталона).
//
// Отдельных тестов на случаи нет: каждый случай - запись в наборе (СМП_ТестЗаписиAPI). Перечень «пункт покрытия ->
// записи» - в журнале прогонов плана 05а.
//
// Сверка запросов строгая и для синтетики, и для run1: транспорт воспроизведения красит запись при любом лишнем,
// пропущенном или ином запросе. Записи run1 читаются без правки запросов; те, которых конектор запрос в запрос не
// воспроизведет (параметр direction, окно balances из другого сценария), в набор run1 не входят (tools/statement-samples,
// readings.replay_exclusion). Запись run1 с limit, отличным от рабочего (5, 10, 500), читается внутренней точкой чтения с
// конектором-оберткой СМП_ТестКоннекторРазмерСтраницы, которая задает этот limit (шов размера страницы только на входе
// теста); записи на рабочем limit идут продуктовым путем без шва (ПрочитатьКоннектором по строке реестра).

Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конектор monobank юросіб: записи против эталона оракула (план 05а, задача 4)");
	Набор = Набор.ДобавитьСерверныйТест("Т1_ЗаписьПротивЭталона");
	Для Каждого Вид Из СМП_ТестЗаписиAPI.Виды() Цикл
		Для Каждого Ид Из СМП_ТестЗаписиAPI.Идентификаторы(БанкНабора(), Вид) Цикл
			Набор = Набор.СПараметрами(Вид + "/" + Ид, Вид, Ид);
		КонецЦикла;
	КонецЦикла;
	Набор.ДобавитьСерверныйТест("Т3_КонтрольХарнеса_ИспорченныйЭталонДаетКрасное");

КонецПроцедуры

#Область Тесты

// Т1 (и Т2 - признаком): одна запись набора.
Процедура Т1_ЗаписьПротивЭталона(Описание, Вид, Ид) Экспорт

	Название = Вид + "/" + Ид;
	Эталон = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), Вид, Ид);
	Чтение = ПрочитатьЗапись(Вид, Ид, Эталон);

	Расхождения = Новый Массив;
	ДобавитьВсе(Расхождения, Чтение.Проблемы);
	Если Чтение.Результат <> Неопределено Тогда
		ДобавитьВсе(Расхождения, СравнитьКонверт(Название, Эталон, Чтение.Результат.Выписка));
		ДобавитьВсе(Расхождения, СравнитьЗапросыИПаузы(Название, Вид, Эталон, Чтение.Транспорт));
		ДобавитьВсе(Расхождения, ТокеныВТекстах(Название, Чтение.Результат));
	КонецЕсли;

	ЮТест.ОжидаетЧто(ТекстРасхождений(Расхождения), "Запис " + Название + ": расхождения с эталоном оракула").Равно("");

КонецПроцедуры

// Т3: контроль харнеса. Конверт собран из самого эталона, поэтому верный эталон дает пустой список расхождений, а
// эталон с одним испорченным полем - непустой, и сообщение называет запись, операцию и поле.
Процедура Т3_КонтрольХарнеса_ИспорченныйЭталонДаетКрасное() Экспорт

	Ид = "СинтСтатусы";
	Выписка = ВыпискаИзЭталона(СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид));

	Верный = СравнитьКонверт("synthetic/" + Ид, СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид), Выписка);
	ЮТест.ОжидаетЧто(ТекстРасхождений(Верный), "Контроль: конверт из эталона против того же эталона - без расхождений").Равно("");

	// Испорчено одно поле операции.
	Испорченный = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	Операция = Испорченный["expected"]["Операции"][0];
	Операция["Сумма"] = "999999.99";
	ПоОперации = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, Испорченный, Выписка));
	ЮТест.ОжидаетЧто(ПоОперации, "Контроль: испорчена Сумма первой операции - красное").Содержит("Сумма");
	ЮТест.ОжидаетЧто(ПоОперации, "Контроль: сообщение называет запись и операцию")
		.Содержит("запис synthetic/" + Ид + ", операція " + Формат(Операция["ПорядковыйНомер"], "ЧГ=0"));

	// Испорчена диагностика: ожидаемый рядок другого уровня.
	ИспорченнаяДиагностика = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	ИспорченнаяДиагностика["expected"]["Диагностика"][0]["Уровень"] = "Ошибка";
	ПоДиагностике = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, ИспорченнаяДиагностика, Выписка));
	ЮТест.ОжидаетЧто(ПоДиагностике, "Контроль: испорчен уровень рядка диагностики - красное").Содержит("діагностика");

	// Испорчен класс отказа.
	ИспорченныйКласс = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	ИспорченныйКласс["expected"]["КлассОтказа"] = "Повторить";
	ПоКлассу = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, ИспорченныйКласс, Выписка));
	ЮТест.ОжидаетЧто(ПоКлассу, "Контроль: испорчен класс отказа - красное").Содержит("КлассОтказа");

КонецПроцедуры

#КонецОбласти

#Область Чтение

Функция БанкНабора()

	Возврат "mono-corp";

КонецФункции

// Идентификатор строки реестра конекторов (постоянный, общее пространство с форматами, D36 п. 4).
Функция ИдентификаторСтроки()

	Возврат "МонобанкЮр_API";

КонецФункции

// Рабочий limit конектора (журнал 05а, задача 1 Step 3: максимум страницы не меньше 33). Это ожидание теста, не
// чтение константы продукта: записи синтетики записаны с этим limit, и транспорт воспроизведения красит запись, если
// конектор спросит иначе.
Функция РабочийЛимит()

	Возврат 30;

КонецФункции

Функция ТокенСинтетический()

	Возврат "СМП_ТЕСТ_ТОКЕН_Zq7Xp93Lk";

КонецФункции

// Читает запись конектором через точку чтения.
//
// Возвращаемое значение:
//  Структура - Результат (результат точки чтения или Неопределено), Транспорт, Проблемы (Массив из Строка).
Функция ПрочитатьЗапись(Вид, Ид, Эталон)

	Итог = Новый Структура("Результат, Транспорт, Проблемы", Неопределено, Неопределено, Новый Массив);
	Название = Вид + "/" + Ид;

	Пакет = СМП_ТестЗаписиAPI.Записи(БанкНабора(), Вид)[Ид];
	Параметры = Эталон["parameters"];
	Начало = ДатаИзISO(Параметры["НачалоПериода"]);
	Конец = ДатаИзISO(Параметры["КонецПериода"]);
	Лимит = ЗаписанныйЛимит(Пакет);
	Потолок = Параметры["ПотолокСтраниц"];                                   // шов стелі сторінок (лише менша за робочу), Неопределено - робоча

	Транспорт = СМП_ТестЗаписиAPI.ТранспортИзПакета(Пакет);
	Итог.Транспорт = Транспорт;

	// Момент чтения транспорта фиксирован записью (D36 п. 11, a90f7ea): ТекущийМомент() отдает его, а не момент из startedUtc обменов.
	Если Параметры["МоментЧтения"] <> Неопределено Тогда
		Транспорт.ЗаданныйМомент = ДатаИзISO(Параметры["МоментЧтения"]);
	КонецЕсли;

	Найденная = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.НайтиСтрокуКоннектора", ПараметрыВызова(
		СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.РеестрКоннекторов"),
		СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ВыведенныеИдентификаторыКоннекторов"),
		ИдентификаторСтроки()));
	Если Найденная.Строка = Неопределено Тогда
		Итог.Проблемы.Добавить("запис " + Название + ": конектор не зарегистрирован - " + Найденная.Отказ);
		Возврат Итог;
	КонецЕсли;

	Счета = Новый Массив;
	Счета.Добавить(Параметры["НомерСчета"]);
	Учетные = Новый Структура("Токен", ТокенСинтетический());

	Попытка
		// Записи без запроса выписки (Лимит = 0: период целиком в будущем, запросов нет) идут продуктовым путем, как записи на рабочем лимите.
		Если (Лимит = РабочийЛимит() Или Лимит = 0) И Потолок = Неопределено Тогда
			Итог.Результат = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьКоннектором",
				ПараметрыВызова(ИдентификаторСтроки(), Счета, Начало, Конец, Учетные, Транспорт));
		Иначе
			Обертка = Обработки.СМП_ТестКоннекторРазмерСтраницы.Создать();
			Обертка.РазмерСтраницы = Лимит;
			Обертка.ПотолокСтраниц = Потолок;
			Итог.Результат = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора",
				ПараметрыВызова(Обертка, Найденная.Строка, Счета, Начало, Конец, Учетные, Транспорт));
		КонецЕсли;
	Исключение
		Итог.Проблемы.Добавить("запис " + Название + ": чтение завершилось исключением: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Аргументы вызова продукта массивом (Null - «аргумента нет»).
Функция ПараметрыВызова(А1, А2 = Null, А3 = Null, А4 = Null, А5 = Null, А6 = Null, А7 = Null)

	Массив = Новый Массив;
	Массив.Добавить(А1);
	Для Каждого Значение Из Новый Структура("Второй, Третий, Четвертый, Пятый, Шестой, Седьмой", А2, А3, А4, А5, А6, А7) Цикл
		Если ТипЗнч(Значение.Значение) = Тип("Null") Тогда
			Прервать;
		КонецЕсли;
		Массив.Добавить(Значение.Значение);
	КонецЦикла;
	Возврат Массив;

КонецФункции

// limit первого запроса выписки в записи (0 - запроса выписки нет).
Функция ЗаписанныйЛимит(Пакет)

	Для Каждого Запись Из Пакет["manifest"]["exchanges"] Цикл
		Запрос = Пакет["exchanges"][Запись["file"]]["request"];
		Если СтрНайти(Запрос["path"], "/statement/") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из СтрРазделить(Строка(Запрос["query"]), "&") Цикл
			Если Лев(Часть, 6) = "limit=" Тогда
				Возврат Число(Сред(Часть, 7));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат 0;

КонецФункции

#КонецОбласти

#Область Сравнение

// Сравнивает конверт (Выписка после точки чтения) с эталоном. Возвращает тексты расхождений.
Функция СравнитьКонверт(Название, Эталон, Выписка)

	Р = Новый Массив;
	Ожидаемое = Эталон["expected"];

	Сверить(Р, Название, 0, "ЧтениеПолное", Ожидаемое["ЧтениеПолное"], Выписка.ЧтениеПолное);
	Сверить(Р, Название, 0, "ГраницаДоверия", Ожидаемое["ГраницаДоверия"], ДатаВISO(Выписка.ГраницаДоверия));
	Сверить(Р, Название, 0, "КлассОтказа", Ожидаемое["КлассОтказа"], Выписка.КлассОтказа);

	ОжидаемыеОперации = Ожидаемое["Операции"];
	Сверить(Р, Название, 0, "число операций", ОжидаемыеОперации.Количество(), Выписка.Операции.Количество());
	Для Индекс = 0 По Мин(ОжидаемыеОперации.ВГраница(), Выписка.Операции.Количество() - 1) Цикл
		СравнитьОперацию(Р, Название, ОжидаемыеОперации[Индекс], Выписка.Операции[Индекс]);
	КонецЦикла;

	СравнитьДиагностику(Р, Название, Ожидаемое["Диагностика"], Выписка.Диагностика);
	СравнитьПоляКлюча(Р, Название, Эталон["oldProcessing"]["ПоляКлюча"], Выписка.Операции);

	Возврат Р;

КонецФункции

Процедура СравнитьОперацию(Р, Название, Ожидаемая, Фактическая)

	Номер = Ожидаемая["ПорядковыйНомер"];
	Для Каждого Колонка Из СтрРазделить("ПорядковыйНомер,НомерСчета,Валюта,ДатаОперации,НомерДокумента,ДатаДокумента,"
		+ "Сумма,Направление,ИдентификаторОперации,КонтрагентНаименование,КонтрагентНомерСчета,КонтрагентКод,"
		+ "КонтрагентМФО,НазначениеПлатежа", ",") Цикл
		Сверить(Р, Название, Номер, Колонка, ПредставлениеОжидаемого(Колонка, Ожидаемая[Колонка]),
			ПредставлениеФактического(Колонка, Фактическая[Колонка]));
	КонецЦикла;
	Если ПустаяСтрока(Фактическая.СырыеДанные) Тогда
		Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле СырыеДанные: пусто");
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеОжидаемого(Колонка, Значение)

	Если Колонка = "ПорядковыйНомер" Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли Колонка = "ДатаДокумента" Тогда
		Возврат Лев(Значение, 10);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПредставлениеФактического(Колонка, Значение)

	Если Колонка = "ПорядковыйНомер" Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли Колонка = "Сумма" Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
	ИначеЕсли Колонка = "ДатаОперации" Тогда
		Возврат ДатаВISO(Значение);
	ИначеЕсли Колонка = "ДатаДокумента" Тогда
		Возврат Лев(ДатаВISO(Значение), 10);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Процедура Сверить(Р, Название, Номер, Поле, Ожидаемое, Фактическое)

	Если Ожидаемое <> Фактическое Или ТипЗнч(Ожидаемое) <> ТипЗнч(Фактическое) Тогда
		Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле " + Поле
			+ ": очікувалось «" + Строка(Ожидаемое) + "», отримано «" + Строка(Фактическое) + "»");
	КонецЕсли;

КонецПроцедуры

// Диагностика: каждый ожидаемый рядок находит рядок того же уровня и номера, текст которого называет все факты
// (банк, статус, описание банка, состояние, идентификатор); рядки без пары - лишние. Текст не привязан к формулировке.
Процедура СравнитьДиагностику(Р, Название, Ожидаемые, Диагностика)

	Занятые = Новый Массив;
	Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
		Занятые.Добавить(Ложь);
	КонецЦикла;

	Для Каждого Ожидаемая Из Ожидаемые Цикл
		Факты = ФактыТекстом(Ожидаемая["Факты"]);
		Нашли = Ложь;
		Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
			Строка = Диагностика[Индекс];
			Если Занятые[Индекс] Или Строка.Уровень <> Ожидаемая["Уровень"]
				Или Строка.ПорядковыйНомер <> Ожидаемая["ПорядковыйНомер"] Тогда
				Продолжить;
			КонецЕсли;
			Подходит = Истина;
			Для Каждого Факт Из Факты Цикл
				Если СтрНайти(Строка.Текст, Факт) = 0 Тогда
					Подходит = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Подходит Тогда
				Занятые[Индекс] = Истина;
				Нашли = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Нашли Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Ожидаемая["ПорядковыйНомер"], "ЧГ=0")
				+ ", діагностика: немає рядка «" + Ожидаемая["Уровень"] + "» (суть " + Ожидаемая["Суть"]
				+ "), що називає " + СтрСоединить(Факты, ", "));
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
		Если Не Занятые[Индекс] Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Диагностика[Индекс].ПорядковыйНомер, "ЧГ=0")
				+ ", діагностика: зайвий рядок «" + Диагностика[Индекс].Уровень + "»: " + Диагностика[Индекс].Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Факты рядка диагностики, которые текст для человека обязан назвать (Вид - служебный код, в текст не идет).
Функция ФактыТекстом(Факты)

	Результат = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("Банк,Статус,ОписаниеБанка,Состояние,Ид,Значение,Код,Секунда,Секунда2,Количество,Пауза,Страниц,Операций,Граница", ",") Цикл
		Значение = Факты[Ключ];
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Текст = ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0"), Строка(Значение));
		Если Не ПустаяСтрока(Текст) Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поля ключа D17 (день документа, номер, счет контрагента, сумма) - из режима «старая обработка» эталона.
Процедура СравнитьПоляКлюча(Р, Название, ПоляКлюча, Операции)

	Для Каждого Ключ Из ПоляКлюча Цикл
		Номер = Ключ["ПорядковыйНомер"];
		Операция = Неопределено;
		Для Каждого Кандидат Из Операции Цикл
			Если Кандидат.ПорядковыйНомер = Номер Тогда
				Операция = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Операция = Неопределено Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле ключа D17: операції немає в конверті");
			Продолжить;
		КонецЕсли;
		Сверить(Р, Название, Номер, "ключ D17: ДатаДокумента", Лев(Ключ["ДатаДокумента"], 10), Лев(ДатаВISO(Операция.ДатаДокумента), 10));
		Сверить(Р, Название, Номер, "ключ D17: НомерДокумента", Ключ["НомерДокумента"], Операция.НомерДокумента);
		Сверить(Р, Название, Номер, "ключ D17: КонтрагентНомерСчета", Ключ["КонтрагентНомерСчета"], Операция.КонтрагентНомерСчета);
		Сверить(Р, Название, Номер, "ключ D17: Сумма", Ключ["Сумма"], Формат(Операция.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00"));
	КонецЦикла;

КонецПроцедуры

// Запросы и паузы. Транспорт воспроизведения сам сверяет каждый запрос с записанным и показывает невостребованные
// обмены (Проверить); здесь же запросы сверяются с эталоном и сверяются паузы (секунды по порядку).
Функция СравнитьЗапросыИПаузы(Название, Вид, Эталон, Транспорт)

	Р = Новый Массив;
	Ожидаемое = Эталон["expected"];

	Для Каждого Текст Из Транспорт.Проверить() Цикл
		Р.Добавить("запис " + Название + ", транспорт воспроизведення: " + Текст);
	КонецЦикла;

	ОжидаемыеЗапросы = Новый Массив;
	Для Каждого Запрос Из Ожидаемое["Запросы"] Цикл
		Пары = Новый Массив;
		Для Каждого Пара Из Запрос["Запрос"] Цикл
			Пары.Добавить(Пара[0] + "=" + Пара[1]);
		КонецЦикла;
		Адрес = "https://" + Запрос["Хост"] + Запрос["Путь"];
		Если Пары.Количество() > 0 Тогда
			Адрес = Адрес + "?" + СтрСоединить(Пары, "&");
		КонецЕсли;
		ОжидаемыеЗапросы.Добавить(Запрос["Метод"] + " " + Адрес);
	КонецЦикла;
	ФактическиеЗапросы = Новый Массив;
	Для Каждого Текст Из Транспорт.Запросы Цикл
		ФактическиеЗапросы.Добавить(Текст);
	КонецЦикла;
	Сверить(Р, Название, 0, "число запитів", ОжидаемыеЗапросы.Количество(), ФактическиеЗапросы.Количество());
	// Состав ИМЕН заголовков автентификации каждого запроса (значения транспорт не хранит): запрос без обязательного заголовка - расхождение.
	Для Номер = 0 По Транспорт.ИменаЗаголовков.ВГраница() Цикл
		Для Каждого Имя Из ИменаЗаголовковАвторизации() Цикл
			Если СтрНайти(Транспорт.ИменаЗаголовков[Номер], "," + Имя + ",") = 0 Тогда
				Р.Добавить("запис " + Название + ", транспорт воспроизведення: у запиті " + Формат(Номер + 1, "ЧГ=0") + " немає заголовка автентифікації " + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Индекс = 0 По Мин(ОжидаемыеЗапросы.ВГраница(), ФактическиеЗапросы.ВГраница()) Цикл
		Сверить(Р, Название, 0, "запит " + Формат(Индекс + 1, "ЧГ=0"), ОжидаемыеЗапросы[Индекс], ФактическиеЗапросы[Индекс]);
	КонецЦикла;

	Сверить(Р, Название, 0, "число пауз", Ожидаемое["Паузы"].Количество(), Транспорт.Паузы.Количество());
	Для Индекс = 0 По Мин(Ожидаемое["Паузы"].ВГраница(), Транспорт.Паузы.ВГраница()) Цикл
		Сверить(Р, Название, 0, "пауза " + Формат(Индекс + 1, "ЧГ=0") + " (секунди)",
			Формат(Ожидаемое["Паузы"][Индекс]["Секунд"], "ЧГ=0"), Формат(Транспорт.Паузы[Индекс], "ЧГ=0"));
	КонецЦикла;

	Возврат Р;

КонецФункции

// Имена заголовков автентификации, которые конектор обязан слать в каждом запросе (по описанию конектора: ПриватБанк - id и token, monobank - x-token).
Функция ИменаЗаголовковАвторизации()

	Результат = Новый Массив;
	Результат.Добавить("x-token");
	Возврат Результат;

КонецФункции

// Т2: синтетический токен не встречается ни в одном тексте результата - ни в диагностике, ни в колонках операций,
// ни в конверте платформы.
Функция ТокеныВТекстах(Название, Результат)

	Р = Новый Массив;
	Токен = ТокенСинтетический();
	Для Каждого Таблица Из СтрРазделить("Выписка.Диагностика,Выписка.Операции,Диагностика,Операции", ",") Цикл
		Если СтрНачинаетсяС(Таблица, "Выписка.") Тогда
			Данные = Результат.Выписка[Сред(Таблица, 9)];
		Иначе
			Данные = Результат[Таблица];
		КонецЕсли;
		Для Каждого Строка Из Данные Цикл
			Для Каждого Колонка Из Данные.Колонки Цикл
				Значение = Строка[Колонка.Имя];
				Если ТипЗнч(Значение) = Тип("Строка") И СтрНайти(Значение, Токен) > 0 Тогда
					Р.Добавить("запис " + Название + ", поле " + Таблица + "." + Колонка.Имя + ": токен в тексте результата");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;

КонецФункции

#КонецОбласти

#Область Помощники

// Конверт, собранный из эталона: то, что вернул бы идеальный конектор.
Функция ВыпискаИзЭталона(Эталон)

	Ожидаемое = Эталон["expected"];
	Выписка = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НоваяВыписка");
	Выписка.ЧтениеПолное = Ожидаемое["ЧтениеПолное"];
	Выписка.ГраницаДоверия = ДатаИзISO(Ожидаемое["ГраницаДоверия"]);
	Выписка.КлассОтказа = Ожидаемое["КлассОтказа"];

	Для Каждого Ожидаемая Из Ожидаемое["Операции"] Цикл
		Строка = Выписка.Операции.Добавить();
		Для Каждого Колонка Из Выписка.Операции.Колонки Цикл
			Имя = Колонка.Имя;
			Если Имя = "СырыеДанные" Тогда
				Строка[Имя] = "{}";
			ИначеЕсли Имя = "Сумма" Тогда
				Строка[Имя] = Число(Ожидаемая[Имя]);
			ИначеЕсли Имя = "ДатаОперации" Или Имя = "ДатаДокумента" Тогда
				Строка[Имя] = ДатаИзISO(Ожидаемая[Имя]);
			Иначе
				Строка[Имя] = Ожидаемая[Имя];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Ожидаемая Из Ожидаемое["Диагностика"] Цикл
		Строка = Выписка.Диагностика.Добавить();
		Строка.Уровень = Ожидаемая["Уровень"];
		Строка.ПорядковыйНомер = Ожидаемая["ПорядковыйНомер"];
		Строка.Текст = "Суть " + Ожидаемая["Суть"] + ": " + СтрСоединить(ФактыТекстом(Ожидаемая["Факты"]), ", ");
	КонецЦикла;

	Возврат Выписка;

КонецФункции

Функция ДатаВISO(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция ДатаИзISO(Текст)

	Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "T", ""), ":", ""));

КонецФункции

Процедура ДобавитьВсе(Приемник, Источник)

	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

// Расхождения одним текстом, не больше 25 строк (отчет YaXUnit должен остаться читаемым).
Функция ТекстРасхождений(Расхождения)

	Строки = Новый Массив;
	Для Индекс = 0 По Мин(Расхождения.ВГраница(), 24) Цикл
		Строки.Добавить(Расхождения[Индекс]);
	КонецЦикла;
	Если Расхождения.Количество() > 25 Тогда
		Строки.Добавить("... и еще " + Формат(Расхождения.Количество() - 25, "ЧГ=0"));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
