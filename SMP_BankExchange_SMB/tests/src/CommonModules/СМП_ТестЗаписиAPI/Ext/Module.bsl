// Записи ответов API и их эталоны для тестов конекторов (план 05а, задача 2, решение R15).
//
// Макеты обработки СМП_ТестыМакеты лежат пакетами, а не по одному на запись (записей около ста):
//   СМП_ТестОтветы<Банк><Вид>  - ДвоичныеДанные, JSON "smp-api-record-set": записи по идентификатору;
//   СМП_ТестЭталоны<Банк><Вид> - Текст, JSON "smp-api-etalon-set": эталоны по тому же идентификатору.
// <Банк> - Приват | МоноФОП | МоноЮр; <Вид> - Синт (синтетика, ознака в имени) | Run1 (знеособленные обмены прогона).
// Формы - шапка tools/statement-samples/apilib/sets.py. Макеты порождает инструмент, руками они не правятся.
//
// Тест любого конектора берет запись одной функцией: ТранспортЗаписи(Банк, Вид, Ид) - транспорт воспроизведения
// (СМП_ТестТранспортВоспроизведение), уже загруженный записью; Эталон(Банк, Вид, Ид) - эталон оракула (Соответствие).
// Банк: "privat" | "mono-fop" | "mono-corp"; Вид: "synthetic" | "run1".

#Область ПрограммныйИнтерфейс

// Банки наборов.
//
// Возвращаемое значение:
//  Массив из Строка - "privat", "mono-fop", "mono-corp".
Функция Банки() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("privat");
	Результат.Добавить("mono-fop");
	Результат.Добавить("mono-corp");
	Возврат Результат;

КонецФункции

// Виды наборов.
//
// Возвращаемое значение:
//  Массив из Строка - "synthetic", "run1".
Функция Виды() Экспорт

	Результат = Новый Массив;
	Результат.Добавить("synthetic");
	Результат.Добавить("run1");
	Возврат Результат;

КонецФункции

// Имена макетов пары наборов.
//
// Параметры:
//  Банк - Строка - "privat" | "mono-fop" | "mono-corp".
//  Вид - Строка - "synthetic" | "run1".
//
// Возвращаемое значение:
//  Структура - Ответы, Эталоны (имена макетов).
Функция ИменаМакетов(Банк, Вид) Экспорт

	Ключ = ?(Банк = "privat", "Приват", ?(Банк = "mono-fop", "МоноФОП", ?(Банк = "mono-corp", "МоноЮр", "")));
	Суффикс = ?(Вид = "synthetic", "Синт", ?(Вид = "run1", "Run1", ""));
	Если Ключ = "" Или Суффикс = "" Тогда
		ВызватьИсключение "Неизвестный банк или вид набора записей: " + Банк + ", " + Вид;
	КонецЕсли;
	Возврат Новый Структура("Ответы, Эталоны", "СМП_ТестОтветы" + Ключ + Суффикс, "СМП_ТестЭталоны" + Ключ + Суффикс);

КонецФункции

// Набор записей: Соответствие идентификатор -> пакет записи (Соответствие "manifest", "exchanges").
//
// Параметры:
//  Банк - Строка - банк.
//  Вид - Строка - вид набора.
//
// Возвращаемое значение:
//  Соответствие - идентификатор записи -> пакет.
Функция Записи(Банк, Вид) Экспорт

	Набор = РазобратьJSON(ТекстДвоичных(Обработки.СМП_ТестыМакеты.ПолучитьМакет(ИменаМакетов(Банк, Вид).Ответы)));
	ПроверитьНабор(Набор, "smp-api-record-set", Банк, Вид);
	Возврат Набор["records"];

КонецФункции

// Набор эталонов: Соответствие идентификатор -> эталон (Соответствие).
//
// Параметры:
//  Банк - Строка - банк.
//  Вид - Строка - вид набора.
//
// Возвращаемое значение:
//  Соответствие - идентификатор записи -> эталон.
Функция Эталоны(Банк, Вид) Экспорт

	Документ = Обработки.СМП_ТестыМакеты.ПолучитьМакет(ИменаМакетов(Банк, Вид).Эталоны);
	Набор = РазобратьJSON(СтрЗаменить(Документ.ПолучитьТекст(), Символ(65279), ""));
	ПроверитьНабор(Набор, "smp-api-etalon-set", Банк, Вид);
	Возврат Набор["etalons"];

КонецФункции

// Идентификаторы записей набора (по алфавиту).
//
// Параметры:
//  Банк - Строка - банк.
//  Вид - Строка - вид набора.
//
// Возвращаемое значение:
//  Массив из Строка - идентификаторы.
Функция Идентификаторы(Банк, Вид) Экспорт

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Записи(Банк, Вид) Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Транспорт воспроизведения, загруженный записью набора.
//
// Параметры:
//  Банк - Строка - банк.
//  Вид - Строка - вид набора.
//  Ид - Строка - идентификатор записи.
//
// Возвращаемое значение:
//  ОбработкаОбъект.СМП_ТестТранспортВоспроизведение - транспорт, готовый к ВыполнитьЗапрос.
Функция ТранспортЗаписи(Банк, Вид, Ид) Экспорт

	Пакет = Записи(Банк, Вид)[Ид];
	Если Пакет = Неопределено Тогда
		ВызватьИсключение "В наборе записей нет " + Банк + "/" + Вид + "/" + Ид;
	КонецЕсли;
	Возврат ТранспортИзПакета(Пакет);

КонецФункции

// Транспорт воспроизведения из пакета записи.
//
// Параметры:
//  Пакет - Соответствие - пакет записи ("manifest", "exchanges").
//
// Возвращаемое значение:
//  ОбработкаОбъект.СМП_ТестТранспортВоспроизведение - транспорт, загруженный записью.
Функция ТранспортИзПакета(Пакет) Экспорт

	ТекстыОбменов = Новый Соответствие;
	Для Каждого Элемент Из Пакет["exchanges"] Цикл
		ТекстыОбменов.Вставить(Элемент.Ключ, ТекстJSON(Элемент.Значение));
	КонецЦикла;
	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьЗапись(ТекстJSON(Пакет["manifest"]), ТекстыОбменов);
	Возврат Транспорт;

КонецФункции

// Эталон записи.
//
// Параметры:
//  Банк - Строка - банк.
//  Вид - Строка - вид набора.
//  Ид - Строка - идентификатор записи.
//
// Возвращаемое значение:
//  Соответствие - эталон (формат tools/statement-samples/apilib/etalon.py).
Функция Эталон(Банк, Вид, Ид) Экспорт

	Результат = Эталоны(Банк, Вид)[Ид];
	Если Результат = Неопределено Тогда
		ВызватьИсключение "В наборе эталонов нет " + Банк + "/" + Вид + "/" + Ид;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Воспроизводит запись целиком и проверяет её форму: запросы берутся из самого обмена (метод, хост, путь, запрос) в
// записанном порядке, ответы читаются транспортом (он же проверяет формат при загрузке); у каждого обмена ровно одно из
// "response" / "failure", а длина тела равна bodyLength.
//
// Параметры:
//  Пакет - Соответствие - пакет записи.
//
// Возвращаемое значение:
//  Структура - Обменов (Число), Расхождения (Массив из Строка), ОшибкиФормата (Массив из Строка).
Функция ПрогнатьЗапись(Пакет) Экспорт

	Транспорт = ТранспортИзПакета(Пакет);
	Манифест = Пакет["manifest"];
	Ошибки = Новый Массив;
	Прогнано = 0;
	Для Каждого Запись Из Манифест["exchanges"] Цикл
		Обмен = Пакет["exchanges"][Запись["file"]];
		Запрос = Обмен["request"];
		Адрес = "https://" + Запрос["host"] + Запрос["path"] + ?(ПустаяСтрока(Запрос["query"]), "", "?" + Запрос["query"]);
		Ответ = Транспорт.ВыполнитьЗапрос(Запрос["method"], Адрес, Новый Соответствие);
		Прогнано = Прогнано + 1;
		Если (Обмен["response"] = Неопределено) = (Обмен["failure"] = Неопределено) Тогда
			Ошибки.Добавить("Обмен " + Запись["file"] + ": должно быть ровно одно из response / failure");
		ИначеЕсли Обмен["response"] <> Неопределено И Ответ.Тело.Размер() <> Обмен["response"]["bodyLength"] Тогда
			Ошибки.Добавить("Обмен " + Запись["file"] + ": длина тела не равна bodyLength");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Обменов, Расхождения, ОшибкиФормата", Прогнано, Транспорт.Проверить(), Ошибки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНабор(Набор, Формат, Банк, Вид)

	Если ТипЗнч(Набор) <> Тип("Соответствие") Или Набор["format"] <> Формат Или Набор["formatVersion"] <> 1 Тогда
		ВызватьИсключение "Макет набора не в формате " + Формат + " версии 1";
	КонецЕсли;
	Если Набор["bank"] <> Банк Или Набор["kind"] <> Вид Тогда
		ВызватьИсключение "Макет набора " + Формат + " относится к другому банку или виду: ожидалось " + Банк + "/" + Вид;
	КонецЕсли;

КонецПроцедуры

Функция ТекстДвоичных(Данные)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "utf-8");

КонецФункции

Функция РазобратьJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
