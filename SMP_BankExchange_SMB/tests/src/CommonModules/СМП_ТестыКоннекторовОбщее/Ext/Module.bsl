#КонецОбласти

#Область ТочкаЧтенияКоннектора

// Токен не трапляється в жодному тексті результату в жодному регістрі: ни в сообщении конектора, ни в классе.
// Учетные данные хранят токен как есть, а дублер выводит его в верхнем регистре: вырезание не зависит от регистра.
// Текст исключения конектора (в нем может быть сеансовый токен, которого точка чтения не знает) в результат не идет вовсе:
// вместо него - нейтральная строка с именем конектора (6б, решение 2а, инвариант Б3).
Процедура Точка_ТокенНеТрапляетсяВТекстахРезультата() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ВРег(ТокенСинтетический());
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, СоставТеста(), НомераСчета("UA11"), УчетныеДанныеТеста(), Неопределено);

	Тексты = ТекстыДиагностики(Результат);
	ЮТест.ОжидаетЧто(НРег(Тексты), "Токен в диагностике (любой регистр)").НеСодержит(НРег(ТокенСинтетический()));
	ЮТест.ОжидаетЧто(Тексты, "Остальной текст сообщения конектора сохранен").Содержит("Банк ответил отказом");
	ЮТест.ОжидаетЧто(Тексты, "Текст исключения конектора в диагностике отсутствует").НеСодержит("Сбой запроса с токеном");
	// Нейтральная строка: слова не зависят от языка сеанса (ru "конектора банка", uk "конектора банку"), имя конектора - представление строки реестра.
	НейтральнаяСтрока = Ложь;
	Для Каждого Строка Из Результат.Диагностика Цикл
		Если СтрНайти(Строка.Текст, "конектора банк") > 0 И СтрНайти(Строка.Текст, "СМП_ТЕСТ_Банк (API)") > 0 Тогда
			НейтральнаяСтрока = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(НейтральнаяСтрока, "Нейтральная строка с именем конектора есть в диагностике").ЭтоИстина();
	ЮТест.ОжидаетЧто(НРег(Результат.Выписка.КлассОтказа), "Токен не в классе").НеСодержит(НРег(ТокенСинтетический()));
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Прочитанное лежит в результате").Равно(1);

КонецПроцедуры

// Контроль: сам дублер тот текст с токеном производит - без замены в точке чтения токен был бы в результате.
Процедура Точка_ТокенВТекстахДублера_Контроль() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);
	Выписка = ВызватьОбщее("СМП_ВыпискаБанка", "НоваяВыписка");
	Параметры = ВызватьОбщее("СМП_ВыпискаБанка", "НовыеПараметрыЧтения");

	ТекстИсключения = "";
	Попытка
		Дублер.Прочитать(Неопределено, Параметры, Выписка);
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, "Необработанный текст исключения дублера").Содержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Выписка.Диагностика[0].Текст, "Необработанная диагностика дублера").Содержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Выписка.Операции[0].СырыеДанные, "Необработанные СырыеДанные дублера").Содержит(ТокенСинтетический());

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ТокенСинтетический()

	Возврат "СМП_ТЕСТ_ТОКЕН_Zq7Xp93Lk";

КонецФункции

Функция НачалоПериодаТеста()

	Возврат Дата(2026, 1, 15, 0, 0, 0);

КонецФункции

Функция КонецПериодаТеста()

	Возврат Дата(2026, 1, 15, 23, 59, 59);

КонецФункции

Функция УчетныеДанныеТеста()

	Возврат Новый Структура("Токен", ТокенСинтетический());

КонецФункции

Функция СоставТеста()

	Состав = Новый Массив;
	Состав.Добавить("Токен");
	Возврат Состав;

КонецФункции

Функция НомераСчета(Первый, Второй = Неопределено)

	Номера = Новый Массив;
	Номера.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Номера.Добавить(Второй);
	КонецЕсли;
	Возврат Номера;

КонецФункции

Функция НовыйДублер(Режим)

	Дублер = Обработки.СМП_ТестКоннектор.Создать();
	Дублер.Режим = Режим;
	Возврат Дублер;

КонецФункции

Функция СтрокиДублера(Номер, Количество)

	Строки = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Строки.Добавить(Новый Структура("НомерСчета", Номер));
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Читает дублером через внутреннюю точку продукта, которая принимает объект конектора значением.
Функция ЧитатьДублером(Дублер, Состав, Счета, Учетные, Транспорт)

	СтрокаРеестра = Новый Структура;
	СтрокаРеестра.Вставить("Идентификатор", "СМП_ТЕСТ_Коннектор");
	СтрокаРеестра.Вставить("Банк", "СМП_ТЕСТ_Банк");
	СтрокаРеестра.Вставить("Представление", "СМП_ТЕСТ_Банк (API)");
	СтрокаРеестра.Вставить("СоставУчетныхДанных", Состав);

	Параметры = Новый Массив;
	Параметры.Добавить(Дублер);
	Параметры.Добавить(СтрокаРеестра);
	Параметры.Добавить(Счета);
	Параметры.Добавить(НачалоПериодаТеста());
	Параметры.Добавить(КонецПериодаТеста());
	Параметры.Добавить(Учетные);
	Параметры.Добавить(Транспорт);
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора", Параметры);

КонецФункции

// Вызов экспортной функции общего модуля продукта с позиционными аргументами (Null - "аргумента нет").
Функция ВызватьОбщее(Модуль, ИмяФункции, Аргумент1 = Null, Аргумент2 = Null, Аргумент3 = Null, Аргумент4 = Null)

	Аргументы = Новый Массив;
	Для Каждого Значение Из Новый Структура("Первый, Второй, Третий, Четвертый", Аргумент1, Аргумент2, Аргумент3, Аргумент4) Цикл
		Если ТипЗнч(Значение.Значение) = Тип("Null") Тогда
			Прервать;
		КонецЕсли;
		Аргументы.Добавить(Значение.Значение);
	КонецЦикла;
	Возврат СМП_ТестыВызовПродукта.Вызвать(Модуль + "." + ИмяФункции, Аргументы);

КонецФункции

Функция ТекстыДиагностики(Результат)

	Тексты = Новый Массив;
	Для Каждого Строка Из Результат.Диагностика Цикл
		Тексты.Добавить(Строка.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти

#Область РаундПравок1

// Секрет не остается ни в конверте платформы (Выписка.Диагностика), ни в СырыеДанные операций - ни в
// таблице результата, ни в таблице конверта: этап 5б может сохранять конверт.
Процедура Точка_ТокенНеТрапляетсяВКонвертеИСырыхДанных() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, СоставТеста(), НомераСчета("UA11"), УчетныеДанныеТеста(), Неопределено);

	ДиагностикаКонверта = ТекстыТаблицы(Результат.Выписка.Диагностика, "Текст");
	СырыеРезультата = ТекстыТаблицы(Результат.Операции, "СырыеДанные");
	СырыеКонверта = ТекстыТаблицы(Результат.Выписка.Операции, "СырыеДанные");

	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Токен в Выписка.Диагностика").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Остаток текста в Выписка.Диагностика сохранен").Содержит("Банк ответил отказом");
	ЮТест.ОжидаетЧто(СырыеРезультата, "Токен в СырыеДанные результата").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеРезультата, "Остаток СырыеДанные результата сохранен").Содержит("сырые данные с токеном");
	ЮТест.ОжидаетЧто(СырыеКонверта, "Токен в СырыеДанные конверта").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеКонверта, "Остаток СырыеДанные конверта сохранен").Содержит("сырые данные с токеном");

КонецПроцедуры

// Токен, пересекающий границу обрезания описания, не оставляет видимого префикса: сначала вырезание,
// потом обрезание.
Процедура ТекстОтказа_ВырезаетУчетныеДанныеПередОбрезанием() Экспорт

	Заполнитель = "";
	Для Счетчик = 1 По 285 Цикл
		Заполнитель = Заполнитель + "ж";
	КонецЦикла;
	Описание = Заполнитель + ТокенСинтетический() + " хвост";

	Текст = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "ТекстОтказаБанка", "СМП_ТЕСТ_Банк", 401, Описание, УчетныеДанныеТеста());

	ЮТест.ОжидаетЧто(Текст, "Префикс токена после обрезания").НеСодержит("СМП_ТЕСТ_ТОКЕН");
	ЮТест.ОжидаетЧто(Текст, "На месте токена - замена").Содержит("***");

КонецПроцедуры

// Ядро запроса банка вырезает секреты из текста отказа: короткое значение не оставляет хвоста длинного, в которое оно входит
// (от длинного к короткому, независимо от порядка полей), и ни одна форма секрета не остается в тексте ни в каком регистре -
// значение учетных данных как есть, после СокрЛП, в URL-кодировании (банк может вернуть тело form-urlencoded) и сеансовый токен.
Процедура УбратьУчетныеДанные_СначалаДлинноеЗначение() Экспорт

	Учетные = Новый Структура;
	Учетные.Вставить("Короткое", "12");
	Учетные.Вставить("Длинное", "12ab34");
	ЮТест.ОжидаетЧто(ТекстОтказаЯдра(Учетные, "", "ид 12ab34 и 12"), "Текст после вырезания значений").Содержит("ид *** и ***");

	Учетные = Новый Структура;
	Учетные.Вставить("Логин", "  Us3r.Name  ");
	Учетные.Вставить("Пароль", "p@ss word&1");
	Текст = НРег(ТекстОтказаЯдра(Учетные, "eyJ.Sess10n-Token",
		"login=us3r.name; PASSWORD=P%40SS%20WORD%261&bearer EYJ.SESS10N-TOKEN"));

	ЮТест.ОжидаетЧто(Текст, "Логин после СокрЛП, другой регистр").НеСодержит("us3r.name");
	ЮТест.ОжидаетЧто(Текст, "Пароль в URL-кодировании, другой регистр").НеСодержит("p%40ss%20word%261");
	ЮТест.ОжидаетЧто(Текст, "Пароль как есть").НеСодержит("p@ss word&1");
	ЮТест.ОжидаетЧто(Текст, "Сеансовый токен, другой регистр").НеСодержит("eyj.sess10n-token");
	ЮТест.ОжидаетЧто(Текст, "На месте секретов - замена").Содержит("***");

КонецПроцедуры

// Справочный транспорт без сети: адрес без хоста падает до создания соединения. Исключение - ответ
// со сбоем, статус 0, токен из заголовков в тексте сбоя не появляется.
Процедура Транспорт_Справжний_АдресБезХоста_СбойБезТокена(Описание, Адрес) Экспорт

	Транспорт = Вычислить("Обработки.СМП_ТранспортHTTP.Создать()");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", ТокенСинтетический());
	Заголовки.Вставить("Authorization", "Bearer " + ТокенСинтетический());

	ТекстИсключения = "";
	Ответ = Неопределено;
	Попытка
		Ответ = Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки);
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, Описание + ": транспорт не бросает исключение").Равно("");
	ЮТест.ОжидаетЧто(Ответ.Сбой, Описание + ": сбой").ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.Статус, Описание + ": статус при сбое").Равно(0);
	ЮТест.ОжидаетЧто(Ответ.ВидСбоя, Описание + ": вид сбоя").Равно("network");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ответ.ТекстСбоя), Описание + ": текст сбоя заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.ТекстСбоя, Описание + ": токен в тексте сбоя").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Ответ.Заголовки.Количество(), Описание + ": заголовков ответа нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПомощникиРаунда1

// Первый текст отказа, который ядро запроса банка записало в Состояние.Отказ на ответ 401 с описанием ошибки Описание. Транспорт -
// воспроизведение одного записанного обмена; Состояние - минимум полей, которые читает ядро (см. описание модуля ядра).
Функция ТекстОтказаЯдра(Учетные, СеансовыйТокен, Описание)

	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьОбмены(ТекстОбменаОшибки(Описание));

	Состояние = Новый Структура;
	Состояние.Вставить("Банк", "СМП_ТЕСТ_Банк");
	Состояние.Вставить("Транспорт", Транспорт);
	Состояние.Вставить("УчетныеДанные", Учетные);
	Состояние.Вставить("Токен", СеансовыйТокен);
	Состояние.Вставить("Отказ", Неопределено);
	Состояние.Вставить("ПаузаПередЗапросом", 0);

	Запрос = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "НовыйЗапросБанка");
	Запрос.Адрес = "https://api.test.invalid/path";
	Запрос.ПоляОписания = "error_description";
	ВызватьОбщее("СМП_КоннекторыБанковОбщее", "ВыполнитьЗапросБанка", Состояние, Запрос);

	ЮТест.ОжидаетЧто(Состояние.Отказ, "Ядро записало отказ").НеРавно(Неопределено);
	Возврат Состояние.Отказ.Тексты[0];

КонецФункции

// Обмен формата smp-api-exchange (docs: tools/api-recorder/FORMAT.md): ответ 401, тело JSON с error_description.
Функция ТекстОбменаОшибки(Описание)

	Тело = Новый Соответствие;
	Тело.Вставить("error_description", Описание);
	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, Тело);
	ТелоБайты = ПолучитьДвоичныеДанныеИзСтроки(ЗаписьТела.Закрыть(), "UTF-8", Ложь);

	Пара = Новый Массив;
	Пара.Добавить("content-type");
	Пара.Добавить("application/json; charset=utf-8");
	Заголовки = Новый Массив;
	Заголовки.Добавить(Пара);

	Ответ = Новый Соответствие;
	Ответ.Вставить("status", 401);
	Ответ.Вставить("headers", Заголовки);
	Ответ.Вставить("bodyBase64", СтрЗаменить(СтрЗаменить(Base64Строка(ТелоБайты), Символы.ПС, ""), Символы.ВК, ""));

	Запрос = Новый Соответствие;
	Запрос.Вставить("method", "GET");
	Запрос.Вставить("host", "api.test.invalid");
	Запрос.Вставить("path", "/path");
	Запрос.Вставить("query", "");

	Обмен = Новый Соответствие;
	Обмен.Вставить("format", "smp-api-exchange");
	Обмен.Вставить("formatVersion", 2);
	Обмен.Вставить("scenario", "СМП_ТЕСТ");
	Обмен.Вставить("startedUtc", "2026-01-15T10:00:00.000Z");
	Обмен.Вставить("request", Запрос);
	Обмен.Вставить("response", Ответ);

	ЗаписьОбмена = Новый ЗаписьJSON;
	ЗаписьОбмена.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьОбмена, Обмен);
	Тексты = Новый Массив;
	Тексты.Добавить(ЗаписьОбмена.Закрыть());
	Возврат Тексты;

КонецФункции

Функция ТекстыТаблицы(Таблица, Колонка)

	Тексты = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Тексты.Добавить(Строка[Колонка]);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ВходФормыСекреты

// Инвариант Б1 (план 6б, решения 2 и 2а): учетные данные учетной записи и сеансовый токен ПУМБ не остаются ни в результате серверной
// точки входа формы (ее видит форма и фоновое задание), ни в плане во временном хранилище. Путь целиком: учетная запись счета ->
// точка входа с транспортом-воспроизведением -> конектор ПУМБ -> ядро запроса банка -> точка чтения. Учетные данные берутся только из
// учетной записи (шва для них нет): запись создается здесь, в транзакции теста, значения синтетические. Банк в обоих сценариях
// отвечает отказом, в тексте которого эхом идут секреты; у каждого сценария свой сторож и своя мутация:
//   (1) сеансовый токен в тексте ошибки - его вырезает только ядро по Состояние.Токен (СекретыСостояния);
//   (2) учетные данные в тексте ошибки - вырезают оба слоя (ядро и УбратьУчетныеДанныеИзРезультата).
// Контроль непустоты в каждом сценарии: транспорт отдал обмены (тело с секретом дошло до конектора), а метка "***" есть в диагностике.
// Отказ банка не делает конверт недействительным (причины отказа конверта - подмена объекта, версия, схема таблиц), поэтому в обоих
// сценариях Принята = Истина, точка входа доходит до Распознать и кладет план в хранилище: адрес плана закреплен утверждением.
// Граница покрытия: плана с операциями здесь нет (банк отказал до выписки), так что проверка плана доказывает лишь отсутствие секретов
// в данных 1С плана; секреты в операциях плана этим тестом не покрыты.
// Проверяется вся структура результата (ЗначениеВСтрокуВнутр) и план из хранилища, все формы секрета, без учета регистра.
Процедура ВходФормы_СекретыНеВРезультатеИПлане(Описание, Сценарий) Экспорт

	Учетные = Новый Структура("ИД, Токен, Логин, Пароль",
		"СМП_ТЕСТ_ИД_7Hk2", "СМП_ТЕСТ_СЕКРЕТ_Lm4Pq9", "  tst.user@example.invalid ", "p@ss w0rd&Zt=5");
	Сеанс = "tok.Qw8/Rt42+Mn=Zx";
	ПутьТокена = "/auth/realms/VegaNet/protocol/openid-connect/token";

	Секреты = Новый Структура;
	Для Каждого Значение Из Учетные Цикл
		Секреты.Вставить(Значение.Ключ, Значение.Значение);
	КонецЦикла;

	Обмены = Новый Массив;
	Если Сценарий = "СеансовыйТокен" Тогда
		Секреты.Вставить("СеансовыйТокен", Сеанс);
		Обмены.Добавить(ТекстОбменаПУМБ("POST", "auth.fuib.com", Неопределено, ПутьТокена, 200, Новый Структура("access_token", Сеанс)));
		Обмены.Добавить(ТекстОбменаПУМБ("GET", "service.fuib.com", 4103, "/war_veganet_api/account", 401, Новый Структура("error_description",
			"Сессия отклонена: bearer " + Сеанс + "; верхний регистр " + ВРег(Сеанс) + "; в URL " + ТекстURL(Сеанс))));
	ИначеЕсли Сценарий = "УчетныеДанные" Тогда
		ТелоЗапроса = "client_id=" + ТекстURL(Учетные.ИД) + "&username=" + ТекстURL(Учетные.Логин)
			+ "&password=" + ТекстURL(Учетные.Пароль) + "&client_secret=" + ТекстURL(Учетные.Токен);
		Обмены.Добавить(ТекстОбменаПУМБ("POST", "auth.fuib.com", Неопределено, ПутьТокена, 401, Новый Структура("error_description",
			"Неверные данные " + ТелоЗапроса + "; логин " + Учетные.Логин + "; пароль " + Учетные.Пароль
			+ "; секрет " + ВРег(Учетные.Токен) + "; ид " + Учетные.ИД)));
	Иначе
		ВызватьИсключение "ВходФормы_СекретыНеВРезультатеИПлане: неизвестный сценарий " + Сценарий;
	КонецЕсли;

	// Объекты продукта (расширение-сосед) статически из тестового расширения не видны: учетная запись и перечисление - по имени.
	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	УчетнаяЗапись = Вычислить("Справочники.СМП_УчетныеЗаписиБанков.СоздатьЭлемент()");
	УчетнаяЗапись.Наименование = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "УчетнаяЗаписьБ1";
	УчетнаяЗапись.Организация = Организация;
	УчетнаяЗапись.БанковскийСчет = Счет;
	УчетнаяЗапись.Банк = Вычислить("Перечисления.СМП_ПоддерживаемыеИнтеграцииСБанками.ПУМБ");
	ЗаполнитьЗначенияСвойств(УчетнаяЗапись, Учетные);
	УчетнаяЗапись.Записать();

	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьОбмены(Обмены);

	Вход = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбменСБанком.НовыйВходЧтения");
	Вход.БанковскийСчет = Счет;
	Вход.НачалоПериода = Дата(2026, 1, 15, 0, 0, 0);
	Вход.КонецПериода = Дата(2026, 1, 15, 0, 0, 0);
	Параметры = Новый Массив;
	Параметры.Добавить(Вход);
	Параметры.Добавить(Транспорт);
	Результат = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбменСБанком.ПрочитатьИРаспознатьВыпискуТранспортом", Параметры);

	// Контроль непустоты: тело с секретом дошло до конектора, и маскирование сработало (метка есть в диагностике).
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), "; "), Описание + ": транспорт отдал все записанные обмены").Равно("");
	ЮТест.ОжидаетЧто(Результат.КлассОтказа, Описание + ": класс отказа")
		.Равно(ВызватьОбщее("СМП_ВыпискаБанка", "КлассОтказаДействиеЧеловека"));
	// Отказ банка не отклоняет конверт: точка входа доходит до плана, его адрес заполнен (иначе проверка плана ниже была бы пропущена молча).
	ЮТест.ОжидаетЧто(Результат.Принята, Описание + ": конверт принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.АдресПлана), Описание + ": план положен во временное хранилище").ЭтоИстина();
	ТекстыВхода = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		ТекстыВхода.Добавить(Сообщение.Текст);
	КонецЦикла;
	Для Каждого Текст Из Результат.ТекстыОтказа Цикл
		ТекстыВхода.Добавить(Текст);
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(ТекстыВхода, Символы.ПС), Описание + ": метка маскирования в диагностике (контроль)").Содержит("***");

	// Вся структура результата и план из временного хранилища - одной строкой, без учета регистра.
	Тексты = Новый Массив;
	Тексты.Добавить(ЗначениеВСтрокуВнутр(Результат));
	Тексты.Добавить(ЗначениеВСтрокуВнутр(ПолучитьИзВременногоХранилища(Результат.АдресПлана)));
	Все = НРег(СтрСоединить(Тексты, Символы.ПС));

	Для Каждого Секрет Из Секреты Цикл
		Для Каждого Форма Из ФормыСекрета(Секрет.Значение) Цикл
			ЮТест.ОжидаетЧто(Все, Описание + ": секрет " + Секрет.Ключ + ", форма " + Форма.Вид).НеСодержит(НРег(Форма.Текст));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Формы, в которых секрет может остаться в тексте: как есть, после СокрЛП, URL-кодирование (и после СокрЛП).
Функция ФормыСекрета(Значение)

	Формы = Новый Массив;
	Формы.Добавить(Новый Структура("Вид, Текст", "как есть", Значение));
	Формы.Добавить(Новый Структура("Вид, Текст", "после СокрЛП", СокрЛП(Значение)));
	Формы.Добавить(Новый Структура("Вид, Текст", "URL", ТекстURL(Значение)));
	Формы.Добавить(Новый Структура("Вид, Текст", "URL после СокрЛП", ТекстURL(СокрЛП(Значение))));
	Возврат Формы;

КонецФункции

Функция ТекстURL(Значение)

	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Один обмен формата smp-api-exchange (версия 2: порт), ответ с JSON-телом из структуры. Запись тела запроса не несет (не сверяется).
Функция ТекстОбменаПУМБ(Метод, Хост, Порт, Путь, Статус, ТелоОтвета)

	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, ТелоОтвета);
	ТелоБайты = ПолучитьДвоичныеДанныеИзСтроки(ЗаписьТела.Закрыть(), "UTF-8", Ложь);

	Пара = Новый Массив;
	Пара.Добавить("content-type");
	Пара.Добавить("application/json; charset=utf-8");
	Заголовки = Новый Массив;
	Заголовки.Добавить(Пара);

	Ответ = Новый Соответствие;
	Ответ.Вставить("status", Статус);
	Ответ.Вставить("headers", Заголовки);
	Ответ.Вставить("bodyBase64", СтрЗаменить(СтрЗаменить(Base64Строка(ТелоБайты), Символы.ПС, ""), Символы.ВК, ""));

	Запрос = Новый Соответствие;
	Запрос.Вставить("method", Метод);
	Запрос.Вставить("host", Хост);
	Если Порт <> Неопределено Тогда
		Запрос.Вставить("port", Порт);
	КонецЕсли;
	Запрос.Вставить("path", Путь);
	Запрос.Вставить("query", "");

	Обмен = Новый Соответствие;
	Обмен.Вставить("format", "smp-api-exchange");
	Обмен.Вставить("formatVersion", 2);
	Обмен.Вставить("scenario", "СМП_ТЕСТ_Б1");
	Обмен.Вставить("startedUtc", "2026-01-15T10:00:00.000Z");
	Обмен.Вставить("request", Запрос);
	Обмен.Вставить("response", Ответ);

	ЗаписьОбмена = Новый ЗаписьJSON;
	ЗаписьОбмена.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьОбмена, Обмен);
	Возврат ЗаписьОбмена.Закрыть();

КонецФункции

#КонецОбласти
