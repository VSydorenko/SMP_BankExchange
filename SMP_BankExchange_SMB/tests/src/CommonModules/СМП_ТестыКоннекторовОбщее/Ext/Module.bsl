// Измерения платформы, на которых стоят конекторы API (план 05а, задача 0, D36 п. 7).
//
// Модуль не тестирует продукт: он фиксирует поведение платформы и приемов предшественников
// (СМП_РаботаСБанками*API*) там, где его нельзя вывести из чтения кода. Каждое утверждение -
// измеренное значение, а не ожидание. Если платформа или сеанс другие, утверждения краснеют:
// это сигнал пересмотреть то, что на них стоит, а не подогнать число.
//
// Условия измерения (проверяются отдельными тестами, чтобы красное называло причину):
//   - платформа 8.3.27 (версия приложения начинается с "8.3.27");
//   - часовой пояс сеанса файловой базы - Europe/Kiev. Однопараметрический МестноеВремя(Д),
//     как его вызывает предшественник, берет именно пояс сеанса, поэтому в другом поясе
//     тесты "МестноеВремяПредшественника_*" покажут разницу.
// Тесты не меняют пояс сеанса и не читают данные базы.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Условия измерения")
			.ДобавитьСерверныйТест("Условие_ВерсияПлатформы")
			.ДобавитьСерверныйТест("Условие_ЧасовойПоясСеанса")
		.ДобавитьТестовыйНабор("Имя киевского часового пояса (D36 п. 7)")
			.ДобавитьСерверныйТест("ИмяПояса_Kiev_Принимается")
			.ДобавитьСерверныйТест("ИмяПояса_Kyiv_Отклоняется")
			.ДобавитьСерверныйТест("ИмяПояса_СписокДопустимыхСодержитТолькоKiev")
		.ДобавитьТестовыйНабор("Перевод момента UTC в киевское время")
			.ДобавитьСерверныйТест("МестноеВремяПояса_Момент")
				.СПараметрами("зима, за секунду до киевской полуночи", "20260114215959", "20260114235959")
				.СПараметрами("зима, киевская полночь", "20260114220000", "20260115000000")
				.СПараметрами("зима, 00:30 по Киеву", "20260114223000", "20260115003000")
				.СПараметрами("зима, 23:30 UTC - уже 01:30 следующих суток", "20260114233000", "20260115013000")
				.СПараметрами("лето, за секунду до киевской полуночи", "20260714205959", "20260714235959")
				.СПараметрами("лето, киевская полночь", "20260714210000", "20260715000000")
				.СПараметрами("лето, 00:30 по Киеву", "20260714213000", "20260715003000")
				.СПараметрами("лето, 22:30 UTC - уже 01:30 следующих суток", "20260714223000", "20260715013000")
				.СПараметрами("весна: последняя секунда зимнего времени", "20260329005959", "20260329025959")
				.СПараметрами("весна: первая секунда летнего времени", "20260329010000", "20260329040000")
				.СПараметрами("весна: полночь начала суток на 23 часа", "20260328220000", "20260329000000")
				.СПараметрами("весна: полночь конца суток на 23 часа", "20260329210000", "20260330000000")
				.СПараметрами("осень: последняя секунда летнего времени", "20261025005959", "20261025035959")
				.СПараметрами("осень: первая секунда зимнего времени", "20261025010000", "20261025030000")
				.СПараметрами("осень: полночь начала суток на 25 часов", "20261024210000", "20261025000000")
				.СПараметрами("осень: полночь конца суток на 25 часов", "20261025220000", "20261026000000")
			.ДобавитьСерверныйТест("МестноеВремяПредшественника_СовпадаетСЯвнымПоясомПриПоясеСеансаKiev")
				.СПараметрами("зима, 00:30 по Киеву", "20260114223000")
				.СПараметрами("лето, 00:30 по Киеву", "20260714213000")
				.СПараметрами("весна, первая секунда летнего времени", "20260329010000")
				.СПараметрами("осень, первая секунда зимнего времени", "20261025010000")
			.ДобавитьСерверныйТест("МестноеВремя_ЧасПослеОсеннегоПереходаНеоднозначен")
			.ДобавитьСерверныйТест("ДлинаМестныхСуток")
				.СПараметрами("обычная зимняя", "20260115", 24)
				.СПараметрами("обычная летняя", "20260715", 24)
				.СПараметрами("переход на летнее время", "20260329", 23)
				.СПараметрами("переход на зимнее время", "20261025", 25)
			.ДобавитьСерверныйТест("УниверсальноеВремя_МестноеИзНеоднозначногоИНесуществующегоЧаса")
		.ДобавитьТестовыйНабор("Приемы предшественников: преобразования значений")
			.ДобавитьСерверныйТест("СтрокаОтОтсутствующегоКлючаСоответствия_Пусто")
			.ДобавитьСерверныйТест("ДатаИзСтрокиДатаВремя")
				.СПараметрами("API ПриватБанка, часы с нулем", "07.01.2020 02:58:00", "20200107025800")
				.СПараметрами("часы без нуля", "07.01.2020 2:58:00", "20200107025800")
				.СПараметрами("формат ггггММддччммсс", "20200107025800", "20200107025800")
			.ДобавитьСерверныйТест("ДатаИзСтрокиТолькоДата_Исключение")
			.ДобавитьСерверныйТест("СтрокаОтДаты_ЧасыБезВедущегоНуля")
			.ДобавитьСерверныйТест("ЧислоИзСтроки")
				.СПараметрами("точка", "0.01", 0.01)
				.СПараметрами("запятая", "12,5", 12.5)
				.СПараметрами("точка, большая сумма", "1234.56", 1234.56)
			.ДобавитьСерверныйТест("ФорматЧГ0_СуммаБезГруппировкиСЗапятой");

КонецПроцедуры

#Область Условия

Процедура Условие_ВерсияПлатформы() Экспорт

	СисИнфо = Новый СистемнаяИнформация;
	ЮТест.ОжидаетЧто(Лев(СисИнфо.ВерсияПриложения, 6), "Условие измерения: платформа 8.3.27, версия " + СисИнфо.ВерсияПриложения)
		.Равно("8.3.27");

КонецПроцедуры

Процедура Условие_ЧасовойПоясСеанса() Экспорт

	ЮТест.ОжидаетЧто(ЧасовойПоясСеанса(), "Условие измерения: часовой пояс сеанса файловой базы")
		.Равно("Europe/Kiev");

КонецПроцедуры

#КонецОбласти

#Область ИмяПояса

Процедура ИмяПояса_Kiev_Принимается() Экспорт

	ЮТест.ОжидаетЧто(МестноеВремя(Дата(2026, 1, 15, 12, 0, 0), "Europe/Kiev"), "12:00 UTC зимой в Europe/Kiev")
		.Равно(Дата(2026, 1, 15, 14, 0, 0));

КонецПроцедуры

// Исключение не проглатывается: текст идет в утверждение, чтобы красное показало, что именно
// ответила платформа, если формулировка изменится.
Процедура ИмяПояса_Kyiv_Отклоняется() Экспорт

	ТекстОшибки = "";
	Попытка
		Результат = МестноеВремя(Дата(2026, 1, 15, 12, 0, 0), "Europe/Kyiv");
		ТекстОшибки = "исключения не было, результат " + Результат;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Europe/Kyiv на платформе 8.3.27")
		.Равно("Ошибочный идентификатор часового пояса 'Europe/Kyiv'");

КонецПроцедуры

Процедура ИмяПояса_СписокДопустимыхСодержитТолькоKiev() Экспорт

	Пояса = ПолучитьДопустимыеЧасовыеПояса();
	ЮТест.ОжидаетЧто(Пояса.Найти("Europe/Kiev") <> Неопределено, "Europe/Kiev есть в допустимых поясах").ЭтоИстина();
	ЮТест.ОжидаетЧто(Пояса.Найти("Europe/Kyiv"), "Europe/Kyiv в допустимых поясах").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область МестноеВремя

Процедура МестноеВремяПояса_Момент(Описание, МоментUTC, ОжидаемоеМестное) Экспорт

	ЮТест.ОжидаетЧто(МестноеВремя(ДатаИзТекста(МоментUTC), "Europe/Kiev"), Описание + ": " + МоментUTC + " UTC")
		.Равно(ДатаИзТекста(ОжидаемоеМестное));

КонецПроцедуры

// Предшественник (monobank) зовет МестноеВремя(Д) без пояса. Измерено только равенство явному
// поясу при поясе сеанса Europe/Kiev; для другого пояса сеанса результат был бы другим - это
// и есть отступ D36 п. 7. Условие пояса проверяет Условие_ЧасовойПоясСеанса.
Процедура МестноеВремяПредшественника_СовпадаетСЯвнымПоясомПриПоясеСеансаKiev(Описание, МоментUTC) Экспорт

	Момент = ДатаИзТекста(МоментUTC);
	ЮТест.ОжидаетЧто(МестноеВремя(Момент), Описание + ": МестноеВремя(Д) против явного пояса")
		.Равно(МестноеВремя(Момент, "Europe/Kiev"));

КонецПроцедуры

// Час 03:xx в день перехода на зимнее время встречается дважды: местное значение не
// однозначно определяет момент. Для ключа это не страшно (ключ - день), но тест фиксирует,
// что два разных момента UTC дают одно местное время.
Процедура МестноеВремя_ЧасПослеОсеннегоПереходаНеоднозначен() Экспорт

	Первый = МестноеВремя(Дата(2026, 10, 25, 0, 30, 0), "Europe/Kiev");
	Второй = МестноеВремя(Дата(2026, 10, 25, 1, 30, 0), "Europe/Kiev");

	ЮТест.ОжидаетЧто(Первый, "00:30 UTC в день осеннего перехода").Равно(Дата(2026, 10, 25, 3, 30, 0));
	ЮТест.ОжидаетЧто(Второй, "01:30 UTC в день осеннего перехода").Равно(Дата(2026, 10, 25, 3, 30, 0));

КонецПроцедуры

Процедура ДлинаМестныхСуток(Описание, ДеньТекстом, ОжидаемоеЧасов) Экспорт

	Начало = ДатаИзТекста(ДеньТекстом + "000000");
	Часов = (УниверсальноеВремя(Начало + 86400, "Europe/Kiev") - УниверсальноеВремя(Начало, "Europe/Kiev")) / 3600;

	ЮТест.ОжидаетЧто(Часов, Описание + ": длина суток " + ДеньТекстом + " в часах").Равно(ОжидаемоеЧасов);

КонецПроцедуры

// Обратное преобразование местного в UTC: неоднозначный час берет второе вхождение (зимнее
// смещение), несуществующий час весны - зимнее смещение. Конектор переводит только UTC в
// местное, но предшественник monobank считает границы запроса обратным преобразованием.
Процедура УниверсальноеВремя_МестноеИзНеоднозначногоИНесуществующегоЧаса() Экспорт

	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 10, 25, 3, 30, 0), "Europe/Kiev"), "03:30 в день осеннего перехода (час повторяется)")
		.Равно(Дата(2026, 10, 25, 1, 30, 0));
	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 3, 29, 3, 30, 0), "Europe/Kiev"), "03:30 в день весеннего перехода (часа нет)")
		.Равно(Дата(2026, 3, 29, 1, 30, 0));
	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 3, 29, 2, 30, 0), "Europe/Kiev"), "02:30 в день весеннего перехода (еще зимнее время)")
		.Равно(Дата(2026, 3, 29, 0, 30, 0));

КонецПроцедуры

#КонецОбласти

#Область Преобразования

// Предшественники зовут Строка(Транзакция["comment"]) и подобное. Отсутствующий ключ
// Соответствия дает Неопределено, а Строка(Неопределено) - пустую строку, не слово.
Процедура СтрокаОтОтсутствующегоКлючаСоответствия_Пусто() Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("есть", "значение");
	Данные.Вставить("пустой", Null);

	ЮТест.ОжидаетЧто(ТипЗнч(Данные["нет"]), "тип значения отсутствующего ключа").Равно(Тип("Неопределено"));
	ЮТест.ОжидаетЧто(Строка(Данные["нет"]), "Строка() от отсутствующего ключа").Равно("");
	ЮТест.ОжидаетЧто(Строка(Данные["пустой"]), "Строка() от Null").Равно("");
	ЮТест.ОжидаетЧто(СокрЛП(Строка(Данные["нет"])), "СокрЛП(Строка()) от отсутствующего ключа").Равно("");

КонецПроцедуры

Процедура ДатаИзСтрокиДатаВремя(Описание, Текст, ОжидаемоеТекстом) Экспорт

	ЮТест.ОжидаетЧто(Дата(Текст), Описание + ": Дата('" + Текст + "')")
		.Равно(ДатаИзТекста(ОжидаемоеТекстом));

КонецПроцедуры

Процедура ДатаИзСтрокиТолькоДата_Исключение() Экспорт

	ТекстОшибки = "";
	Попытка
		Результат = Дата("07.01.2020");
		ТекстОшибки = "исключения не было, результат " + Результат;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Дата('07.01.2020')")
		.Равно("Преобразование значения к типу Дата не может быть выполнено");

КонецПроцедуры

// Вывод Строка(Дата) в сеансе: так попадает дата в строковую
// колонку таблицы импорта, когда предшественник присваивает туда значение типа Дата (ПриватБанк).
// Условие - пояс и локаль сеанса; чтение кода этого не показывает.
Процедура СтрокаОтДаты_ЧасыБезВедущегоНуля() Экспорт

	ЮТест.ОжидаетЧто(Строка(Дата(2026, 10, 15, 0, 30, 12)), "Строка(Дата) в 00:30:12").Равно("15.10.2026 0:30:12");
	ЮТест.ОжидаетЧто(Строка(Дата(2026, 10, 15, 13, 5, 9)), "Строка(Дата) в 13:05:09").Равно("15.10.2026 13:05:09");

КонецПроцедуры

Процедура ЧислоИзСтроки(Описание, Текст, Ожидаемое) Экспорт

	ЮТест.ОжидаетЧто(Число(Текст), Описание + ": Число('" + Текст + "')").Равно(Ожидаемое);

КонецПроцедуры

// Предшественник monobank кладет сумму в строковую колонку так: Формат(Сумма, "ЧГ=0"), а
// распознавание потом берет Число() от этой строки. Разделитель дробной части - запятая сеанса.
Процедура ФорматЧГ0_СуммаБезГруппировкиСЗапятой() Экспорт

	Текст = Формат(1234.56, "ЧГ=0");
	ЮТест.ОжидаетЧто(Текст, "Формат(1234.56, 'ЧГ=0')").Равно("1234,56");
	ЮТест.ОжидаетЧто(Число(Текст), "Число() от результата Формат").Равно(1234.56);
	ЮТест.ОжидаетЧто(Формат(5, "ЧГ=0"), "Формат(5, 'ЧГ=0')").Равно("5");
	ЮТест.ОжидаетЧто(Формат(0.5, "ЧГ=0"), "Формат(0.5, 'ЧГ=0')").Равно("0,5");

КонецПроцедуры

#КонецОбласти

Функция ДатаИзТекста(Текст)

	Возврат Дата(Текст);

КонецФункции
