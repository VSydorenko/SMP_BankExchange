// Пояс в функциях явный: смена пояса сеанса результата не меняет. Тест на время ставит UTC и
// возвращает исходный пояс в любом случае.
Процедура Время_ПоясЯвный_НеЗависитОтПоясаСеанса() Экспорт

	Исходный = ЧасовойПоясСеанса();
	ТекстОшибки = "";
	Местное = Неопределено;
	Обратное = Неопределено;
	УстановитьЧасовойПоясСеанса("UTC");
	Попытка
		Местное = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "МоментUnixВКиевскоеВремя", 1768429800);
		Обратное = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "КиевскоеВремяВМоментUnix", Дата(2026, 1, 15, 0, 30, 0));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УстановитьЧасовойПоясСеанса(Исходный);

	ЮТест.ОжидаетЧто(ТекстОшибки, "Исключение при поясе сеанса UTC").Равно("");
	ЮТест.ОжидаетЧто(Формат(Местное, "ДФ=yyyyMMddHHmmss"), "Unix в местное при поясе сеанса UTC").Равно("20260115003000");
	ЮТест.ОжидаетЧто(Обратное, "Местное в Unix при поясе сеанса UTC").Равно(1768429800);
	ЮТест.ОжидаетЧто(ЧасовойПоясСеанса(), "Пояс сеанса возвращен").Равно(Исходный);

