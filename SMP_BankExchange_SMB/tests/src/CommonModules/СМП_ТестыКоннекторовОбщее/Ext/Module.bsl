// Транспорт воспроизведения с загруженными обменами (Массив из Строка - JSON обменов).
Функция ВоспроизведениеИз(Тексты)

	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьОбмены(Тексты);
	Возврат Транспорт;

КонецФункции

// Два обмена синтетической записи: 200 с телом "первый" и 429 с retry-after.
Функция ОбменыДвух()

	Обмены = Новый Массив;
	Заголовки1 = Новый Массив;
	Заголовки1.Добавить(Новый Массив);
	Заголовки1[0].Добавить("content-type");
	Заголовки1[0].Добавить("application/json;charset=utf-8");
	Обмены.Добавить(ТекстОбмена(1, "GET", "acp.example.test", "/api/a", "x=1", 200, ТелоТекстом("первый"), Заголовки1,
		Неопределено, "2026-10-15T09:00:00.000Z"));
	Заголовки2 = Новый Массив;
	Заголовки2.Добавить(Новый Массив);
	Заголовки2[0].Добавить("retry-after");
	Заголовки2[0].Добавить("30");
	Обмены.Добавить(ТекстОбмена(2, "GET", "acp.example.test", "/api/b", "", 429, ТелоТекстом("второй"), Заголовки2,
		Неопределено, "2026-10-15T09:00:05.000Z"));
	Возврат Обмены;

КонецФункции

Функция ОдинОбмен(Метод, Хост, Путь, Запрос, Статус, Тело, Сбой = Неопределено)

	Обмены = Новый Массив;
	Обмены.Добавить(ТекстОбмена(1, Метод, Хост, Путь, Запрос, Статус, Тело, Новый Массив, Сбой, "2026-10-15T09:00:00.000Z"));
	Возврат Обмены;

КонецФункции

// JSON обмена по FORMAT.md v1 (tools/api-recorder): запрос без заголовков, ответ с телом в Base64 либо сбой.
Функция ТекстОбмена(Номер, Метод, Хост, Путь, Запрос, Статус, Тело, Заголовки, Сбой, Запущен)

	Обмен = Новый Соответствие;
	Обмен.Вставить("format", "smp-api-exchange");
	Обмен.Вставить("formatVersion", 1);
	Обмен.Вставить("seq", Номер);
	Обмен.Вставить("scenario", "СМП_ТЕСТ_сценарий");
	Обмен.Вставить("startedUtc", Запущен);
	Обмен.Вставить("durationMs", 1);
	Запрос_ = Новый Соответствие;
	Запрос_.Вставить("method", Метод);
	Запрос_.Вставить("host", Хост);
	Запрос_.Вставить("path", Путь);
	Запрос_.Вставить("query", Запрос);
	Обмен.Вставить("request", Запрос_);
	Если Сбой = Неопределено Тогда
		Ответ = Новый Соответствие;
		Ответ.Вставить("status", Статус);
		Ответ.Вставить("headers", Заголовки);
		Ответ.Вставить("bodyLength", Тело.Размер());
		Ответ.Вставить("bodyBase64", СтрЗаменить(СтрЗаменить(Base64Строка(Тело), Символы.ПС, ""), Символы.ВК, ""));
		Обмен.Вставить("response", Ответ);
		Обмен.Вставить("failure", "@@NULL@@");
	Иначе
		Обмен.Вставить("response", "@@NULL@@");
		Обмен.Вставить("failure", Новый Соответствие);
		Обмен["failure"].Вставить("kind", Сбой.kind);
		Обмен["failure"].Вставить("text", Сбой.text);
	КонецЕсли;
	// ЗаписатьJSON не принимает Null: метка заменяется литералом null в тексте.
	Возврат СтрЗаменить(ТекстJSON(Обмен), """@@NULL@@""", "null");

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область РаундПравок1

// Секрет не остается ни в конверте платформы (Выписка.Диагностика), ни в СырыеДанные операций - ни в
// таблице результата, ни в таблице конверта: этап 5б может сохранять конверт.
Процедура Точка_ТокенНеТрапляетсяВКонвертеИСырыхДанных() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, СоставТеста(), НомераСчета("UA11"), УчетныеДанныеТеста(), Неопределено);

	ДиагностикаКонверта = ТекстыТаблицы(Результат.Выписка.Диагностика, "Текст");
	СырыеРезультата = ТекстыТаблицы(Результат.Операции, "СырыеДанные");
	СырыеКонверта = ТекстыТаблицы(Результат.Выписка.Операции, "СырыеДанные");

	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Токен в Выписка.Диагностика").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Остаток текста в Выписка.Диагностика сохранен").Содержит("Банк ответил отказом");
	ЮТест.ОжидаетЧто(СырыеРезультата, "Токен в СырыеДанные результата").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеРезультата, "Остаток СырыеДанные результата сохранен").Содержит("сырые данные с токеном");
	ЮТест.ОжидаетЧто(СырыеКонверта, "Токен в СырыеДанные конверта").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеКонверта, "Остаток СырыеДанные конверта сохранен").Содержит("сырые данные с токеном");

КонецПроцедуры

// Токен, пересекающий границу обрезания описания, не оставляет видимого префикса: сначала вырезание,
// потом обрезание.
Процедура ТекстОтказа_ВырезаетУчетныеДанныеПередОбрезанием() Экспорт

	Заполнитель = "";
	Для Счетчик = 1 По 285 Цикл
		Заполнитель = Заполнитель + "ж";
	КонецЦикла;
	Описание = Заполнитель + ТокенСинтетический() + " хвост";

	Текст = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "ТекстОтказаБанка", "СМП_ТЕСТ_Банк", 401, Описание, УчетныеДанныеТеста());

	ЮТест.ОжидаетЧто(Текст, "Префикс токена после обрезания").НеСодержит("СМП_ТЕСТ_ТОКЕН");
	ЮТест.ОжидаетЧто(Текст, "На месте токена - замена").Содержит("***");

КонецПроцедуры

// Короткое значение не оставляет хвоста длинного, в которое оно входит: вырезание от длинного к короткому,
// независимо от порядка полей в структуре.
Процедура УбратьУчетныеДанные_СначалаДлинноеЗначение() Экспорт

	Учетные = Новый Структура;
	Учетные.Вставить("Короткое", "12");
	Учетные.Вставить("Длинное", "12ab34");

	Результат = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "УбратьУчетныеДанные", "ид 12ab34 и 12", Учетные);

	ЮТест.ОжидаетЧто(Результат, "Текст после вырезания значений").Равно("ид *** и ***");

КонецПроцедуры

// Справочный транспорт без сети: адрес без хоста падает до создания соединения. Исключение - ответ
// со сбоем, статус 0, токен из заголовков в тексте сбоя не появляется.
Процедура Транспорт_Справжний_АдресБезХоста_СбойБезТокена(Описание, Адрес) Экспорт

	Транспорт = Вычислить("Обработки.СМП_ТранспортHTTP.Создать()");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", ТокенСинтетический());
	Заголовки.Вставить("Authorization", "Bearer " + ТокенСинтетический());

	ТекстИсключения = "";
	Ответ = Неопределено;
	Попытка
		Ответ = Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки);
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, Описание + ": транспорт не бросает исключение").Равно("");
	ЮТест.ОжидаетЧто(Ответ.Сбой, Описание + ": сбой").ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.Статус, Описание + ": статус при сбое").Равно(0);
	ЮТест.ОжидаетЧто(Ответ.ВидСбоя, Описание + ": вид сбоя").Равно("network");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ответ.ТекстСбоя), Описание + ": текст сбоя заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.ТекстСбоя, Описание + ": токен в тексте сбоя").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Ответ.Заголовки.Количество(), Описание + ": заголовков ответа нет").Равно(0);

КонецПроцедуры

Процедура Пауза_СекундыОжидания(Описание, Секунды, Ожидаемо) Экспорт

	Результат = ВызватьОбщее("СМП_ТранспортHTTPСервер", "СекундыОжидания", Секунды);

	ЮТест.ОжидаетЧто(Результат, Описание + ": секунд ожидания для " + Секунды).Равно(Ожидаемо);

КонецПроцедуры

// Не число - не ждать (нечего ждать), но и не исключение.
Процедура Пауза_СекундыОжидания_НеЧисло() Экспорт

	Для Каждого Значение Из ЗначенияНеЧисла() Цикл
		Результат = ВызватьОбщее("СМП_ТранспортHTTPСервер", "СекундыОжидания", Значение);
		ЮТест.ОжидаетЧто(Результат, "Секунд ожидания для не числа " + Строка(Значение)).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Запись сбоя паузы в журнал регистрации сама не должна ронять паузу: если запись упала, исключение не
// выходит, функция сообщает Ложь. Сбой записи моделируется недопустимым уровнем журнала.
Процедура Пауза_ЗаписьСбояВЖурнал_НеБросаетИсключение() Экспорт

	ТекстИсключения = "";
	Записано = Неопределено;
	Попытка
		Записано = ВызватьОбщее("СМП_ТранспортHTTPСервер", "ЗаписатьСбойПаузыВЖурнал", 2, "СМП_ТЕСТ сбой записи", "не уровень журнала");
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, "Исключение записи сбоя паузы не выходит наружу").Равно("");
	ЮТест.ОжидаетЧто(Записано, "Запись не удалась - Ложь").ЭтоЛожь();

КонецПроцедуры

// Контроль к предыдущему: допустимый вызов записывает и сообщает Истина (сбой в тесте выше - от уровня, а не от
// самой функции).
Процедура Пауза_ЗаписьСбояВЖурнал_Записывает() Экспорт

	Записано = ВызватьОбщее("СМП_ТранспортHTTPСервер", "ЗаписатьСбойПаузыВЖурнал", 2, "СМП_ТЕСТ проверка записи сбоя паузы");

	ЮТест.ОжидаетЧто(Записано, "Допустимая запись сбоя паузы").ЭтоИстина();

КонецПроцедуры

