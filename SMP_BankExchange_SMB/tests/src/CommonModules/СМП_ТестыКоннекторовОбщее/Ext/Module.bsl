	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Europe/Kyiv на платформе 8.3.27")
		.Равно("Ошибочный идентификатор часового пояса 'Europe/Kyiv'");

КонецПроцедуры

Процедура ИмяПояса_СписокДопустимыхСодержитТолькоKiev() Экспорт

	Пояса = ПолучитьДопустимыеЧасовыеПояса();
	ЮТест.ОжидаетЧто(Пояса.Найти("Europe/Kiev") <> Неопределено, "Europe/Kiev есть в допустимых поясах").ЭтоИстина();
	ЮТест.ОжидаетЧто(Пояса.Найти("Europe/Kyiv"), "Europe/Kyiv в допустимых поясах").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область МестноеВремя

Процедура МестноеВремяПояса_Момент(Описание, МоментUTC, ОжидаемоеМестное) Экспорт

	ЮТест.ОжидаетЧто(МестноеВремя(ДатаИзТекста(МоментUTC), "Europe/Kiev"), Описание + ": " + МоментUTC + " UTC")
		.Равно(ДатаИзТекста(ОжидаемоеМестное));

КонецПроцедуры

// Предшественник (monobank) зовет МестноеВремя(Д) без пояса. Измерено только равенство явному
// поясу при поясе сеанса Europe/Kiev; для другого пояса сеанса результат был бы другим - это
// и есть отступ D36 п. 7. Условие пояса проверяет Условие_ЧасовойПоясСеанса.
Процедура МестноеВремяПредшественника_СовпадаетСЯвнымПоясомПриПоясеСеансаKiev(Описание, МоментUTC) Экспорт

	Момент = ДатаИзТекста(МоментUTC);
	ЮТест.ОжидаетЧто(МестноеВремя(Момент), Описание + ": МестноеВремя(Д) против явного пояса")
		.Равно(МестноеВремя(Момент, "Europe/Kiev"));

КонецПроцедуры

// Час 03:xx в день перехода на зимнее время встречается дважды: местное значение не
// однозначно определяет момент. Для ключа это не страшно (ключ - день), но тест фиксирует,
// что два разных момента UTC дают одно местное время.
Процедура МестноеВремя_ЧасПослеОсеннегоПереходаНеоднозначен() Экспорт

	Первый = МестноеВремя(Дата(2026, 10, 25, 0, 30, 0), "Europe/Kiev");
	Второй = МестноеВремя(Дата(2026, 10, 25, 1, 30, 0), "Europe/Kiev");

	ЮТест.ОжидаетЧто(Первый, "00:30 UTC в день осеннего перехода").Равно(Дата(2026, 10, 25, 3, 30, 0));
	ЮТест.ОжидаетЧто(Второй, "01:30 UTC в день осеннего перехода").Равно(Дата(2026, 10, 25, 3, 30, 0));

КонецПроцедуры

Процедура ДлинаМестныхСуток(Описание, ДеньТекстом, ОжидаемоеЧасов) Экспорт

	Начало = ДатаИзТекста(ДеньТекстом + "000000");
	Часов = (УниверсальноеВремя(Начало + 86400, "Europe/Kiev") - УниверсальноеВремя(Начало, "Europe/Kiev")) / 3600;

	ЮТест.ОжидаетЧто(Часов, Описание + ": длина суток " + ДеньТекстом + " в часах").Равно(ОжидаемоеЧасов);

КонецПроцедуры

// Обратное преобразование местного в UTC: неоднозначный час берет второе вхождение (зимнее
// смещение), несуществующий час весны - зимнее смещение. Конектор переводит только UTC в
// местное, но предшественник monobank считает границы запроса обратным преобразованием.
Процедура УниверсальноеВремя_МестноеИзНеоднозначногоИНесуществующегоЧаса() Экспорт

	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 10, 25, 3, 30, 0), "Europe/Kiev"), "03:30 в день осеннего перехода (час повторяется)")
		.Равно(Дата(2026, 10, 25, 1, 30, 0));
	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 3, 29, 3, 30, 0), "Europe/Kiev"), "03:30 в день весеннего перехода (часа нет)")
		.Равно(Дата(2026, 3, 29, 1, 30, 0));
	ЮТест.ОжидаетЧто(УниверсальноеВремя(Дата(2026, 3, 29, 2, 30, 0), "Europe/Kiev"), "02:30 в день весеннего перехода (еще зимнее время)")
		.Равно(Дата(2026, 3, 29, 0, 30, 0));

КонецПроцедуры

#КонецОбласти

#Область Преобразования

// Предшественники зовут Строка(Транзакция["comment"]) и подобное. Отсутствующий ключ
// Соответствия дает Неопределено, а Строка(Неопределено) - пустую строку, не слово.
Процедура СтрокаОтОтсутствующегоКлючаСоответствия_Пусто() Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("есть", "значение");
	Данные.Вставить("пустой", Null);

	ЮТест.ОжидаетЧто(ТипЗнч(Данные["нет"]), "тип значения отсутствующего ключа").Равно(Тип("Неопределено"));
	ЮТест.ОжидаетЧто(Строка(Данные["нет"]), "Строка() от отсутствующего ключа").Равно("");
	ЮТест.ОжидаетЧто(Строка(Данные["пустой"]), "Строка() от Null").Равно("");
	ЮТест.ОжидаетЧто(СокрЛП(Строка(Данные["нет"])), "СокрЛП(Строка()) от отсутствующего ключа").Равно("");

КонецПроцедуры

Процедура ДатаИзСтрокиДатаВремя(Описание, Текст, ОжидаемоеТекстом) Экспорт

	ЮТест.ОжидаетЧто(Дата(Текст), Описание + ": Дата('" + Текст + "')")
		.Равно(ДатаИзТекста(ОжидаемоеТекстом));

КонецПроцедуры

Процедура ДатаИзСтрокиТолькоДата_Исключение() Экспорт

	ТекстОшибки = "";
	Попытка
		Результат = Дата("07.01.2020");
		ТекстОшибки = "исключения не было, результат " + Результат;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Дата('07.01.2020')")
		.Равно("Преобразование значения к типу Дата не может быть выполнено");

КонецПроцедуры

// Вывод Строка(Дата) в сеансе: так попадает дата в строковую
// колонку таблицы импорта, когда предшественник присваивает туда значение типа Дата (ПриватБанк).
// Условие - пояс и локаль сеанса; чтение кода этого не показывает.
Процедура СтрокаОтДаты_ЧасыБезВедущегоНуля() Экспорт

	ЮТест.ОжидаетЧто(Строка(Дата(2026, 10, 15, 0, 30, 12)), "Строка(Дата) в 00:30:12").Равно("15.10.2026 0:30:12");
	ЮТест.ОжидаетЧто(Строка(Дата(2026, 10, 15, 13, 5, 9)), "Строка(Дата) в 13:05:09").Равно("15.10.2026 13:05:09");

КонецПроцедуры

Процедура ЧислоИзСтроки(Описание, Текст, Ожидаемое) Экспорт

	ЮТест.ОжидаетЧто(Число(Текст), Описание + ": Число('" + Текст + "')").Равно(Ожидаемое);

КонецПроцедуры

// Предшественник monobank кладет сумму в строковую колонку так: Формат(Сумма, "ЧГ=0"), а
// распознавание потом берет Число() от этой строки. Разделитель дробной части - запятая сеанса.
Процедура ФорматЧГ0_СуммаБезГруппировкиСЗапятой() Экспорт

	Текст = Формат(1234.56, "ЧГ=0");
	ЮТест.ОжидаетЧто(Текст, "Формат(1234.56, 'ЧГ=0')").Равно("1234,56");
	ЮТест.ОжидаетЧто(Число(Текст), "Число() от результата Формат").Равно(1234.56);
	ЮТест.ОжидаетЧто(Формат(5, "ЧГ=0"), "Формат(5, 'ЧГ=0')").Равно("5");
	ЮТест.ОжидаетЧто(Формат(0.5, "ЧГ=0"), "Формат(0.5, 'ЧГ=0')").Равно("0,5");

КонецПроцедуры

#КонецОбласти

#Область ТранспортВоспроизведения

// Два обмена в записи, воспроизведение отдает их в записанном порядке, с записанными статусами,
// заголовками и телом; после этого расхождений нет.
Процедура Воспроизведение_ОбменыВЗаписанномПорядке() Экспорт

	Транспорт = ВоспроизведениеИз(ОбменыДвух());

	Первый = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a?x=1", Новый Соответствие);
	Второй = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/b", Новый Соответствие);

	ЮТест.ОжидаетЧто(Первый.Сбой, "Первый обмен без сбоя").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Первый.Статус, "Статус первого обмена").Равно(200);
	ЮТест.ОжидаетЧто(ТекстТела(Первый.Тело, "utf-8"), "Тело первого обмена").Равно("первый");
	ЮТест.ОжидаетЧто(Первый.Заголовки["content-type"], "Заголовок ответа (имя малыми)").Равно("application/json;charset=utf-8");
	ЮТест.ОжидаетЧто(Второй.Статус, "Статус второго обмена").Равно(429);
	ЮТест.ОжидаетЧто(Второй.Заголовки["retry-after"], "Заголовок retry-after второго обмена").Равно("30");
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), "; "), "Расхождения с записью").Равно("");
	ЮТест.ОжидаетЧто(Транспорт.Запросы.Количество(), "Воспроизведено запросов").Равно(2);

КонецПроцедуры

// Тело отдается теми же байтами, что в записи (cp1251 не превращается в UTF-8 и обратно).
Процедура Воспроизведение_ТелоБайтамиКакЗаписано() Экспорт

	Записанное = ПолучитьДвоичныеДанныеИзСтроки("СМП_ТЕСТ_Привіт, світе", "windows-1251", Ложь);
	Транспорт = ВоспроизведениеИз(ОдинОбмен("GET", "acp.example.test", "/api/a", "", 200, Записанное));

	Ответ = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a", Новый Соответствие);

	ЮТест.ОжидаетЧто(Base64Строка(Ответ.Тело), "Байты тела ответа").Равно(Base64Строка(Записанное));
	ЮТест.ОжидаетЧто(ТекстТела(Ответ.Тело, "windows-1251"), "Тело, прочитанное в cp1251").Равно("СМП_ТЕСТ_Привіт, світе");
	ЮТест.ОжидаетЧто(ТекстТела(Ответ.Тело, "utf-8"), "Те же байты прочитаны как UTF-8 - не тот текст")
		.НеРавно("СМП_ТЕСТ_Привіт, світе");

КонецПроцедуры

// Порядок обменов задает manifest recording.json (поле exchanges), а не порядок файлов во входе.
Процедура Воспроизведение_ЗагрузкаПоМанифесту() Экспорт

	Обмены = ОбменыДвух();
	ТекстыОбменов = Новый Соответствие;
	ТекстыОбменов.Вставить("0002.json", Обмены[1]);
	ТекстыОбменов.Вставить("0001.json", Обмены[0]);

	Записи = Новый Массив;
	Записи.Добавить(Новый Структура("seq, file", 1, "0001.json"));
	Записи.Добавить(Новый Структура("seq, file", 2, "0002.json"));
	Манифест = Новый Структура("format, formatVersion, bank, exchanges", "smp-api-recording", 1, "privat", Записи);

	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьЗапись(ТекстJSON(Манифест), ТекстыОбменов);

	Первый = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a?x=1", Новый Соответствие);
	Второй = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/b", Новый Соответствие);

	ЮТест.ОжидаетЧто(Первый.Статус, "Первый по манифесту").Равно(200);
	ЮТест.ОжидаетЧто(Второй.Статус, "Второй по манифесту").Равно(429);
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), "; "), "Расхождения с записью").Равно("");

КонецПроцедуры

// Запрос, которого нет в записи: конектору приходит ответ со сбоем, а тест получает падение с
// текстом запроса через Проверить(). Токен из заголовков в текст не попадает.
Процедура Воспроизведение_ЗапросВнеЗаписи_РасхождениеСТекстомЗапроса() Экспорт

	Транспорт = ВоспроизведениеИз(ОдинОбмен("GET", "acp.example.test", "/api/a", "x=1", 200, ТелоТекстом("a")));
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("token", ТокенСинтетический());

	Ответ = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/zzz?q=9", Заголовки);

	ЮТест.ОжидаетЧто(Ответ.Сбой, "Запрос вне записи - ответ со сбоем").ЭтоИстина();
	Расхождения = Транспорт.Проверить();
	ЮТест.ОжидаетЧто(Расхождения.Количество() > 0, "Расхождение зафиксировано").ЭтоИстина();
	Текст = СтрСоединить(Расхождения, Символы.ПС);
	ЮТест.ОжидаетЧто(Текст, "Текст расхождения называет запрос").Содержит("GET https://acp.example.test/api/zzz?q=9");
	ЮТест.ОжидаетЧто(Текст, "Текст расхождения не несет заголовков запроса").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Ответ.ТекстСбоя, "Текст сбоя не несет заголовков запроса").НеСодержит(ТокенСинтетический());

КонецПроцедуры

Процедура Воспроизведение_ЗапросПослеИсчерпанияЗаписи() Экспорт

	Транспорт = ВоспроизведениеИз(ОдинОбмен("GET", "acp.example.test", "/api/a", "", 200, ТелоТекстом("a")));
	Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a", Новый Соответствие);
	Лишний = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a", Новый Соответствие);

	ЮТест.ОжидаетЧто(Лишний.Сбой, "Лишний запрос - ответ со сбоем").ЭтоИстина();
	Текст = СтрСоединить(Транспорт.Проверить(), Символы.ПС);
	ЮТест.ОжидаетЧто(Текст, "Расхождение названо исчерпанием записи").Содержит("запись исчерпана");
	ЮТест.ОжидаетЧто(Текст, "Расхождение называет запрос").Содержит("GET https://acp.example.test/api/a");

КонецПроцедуры

// Запись b, a: конектор спросил a раньше b. Порядок обменов - часть записи.
Процедура Воспроизведение_НарушенныйПорядок_Расхождение() Экспорт

	Транспорт = ВоспроизведениеИз(ОбменыДвух());
	Ответ = Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/b", Новый Соответствие);

	ЮТест.ОжидаетЧто(Ответ.Сбой, "Запрос не в записанном порядке - ответ со сбоем").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), Символы.ПС), "Расхождение называет запрос").Содержит("GET https://acp.example.test/api/b");

КонецПроцедуры

Процедура Воспроизведение_ЧастьЗапросаОтличается_Расхождение(Описание, Метод, Хост, Путь, Запрос) Экспорт

	Транспорт = ВоспроизведениеИз(ОдинОбмен("GET", "acp.example.test", "/api/a", "x=1", 200, ТелоТекстом("a")));
	Адрес = "https://" + Хост + Путь + "?" + Запрос;

	Ответ = Транспорт.ВыполнитьЗапрос(Метод, Адрес, Новый Соответствие);

	ЮТест.ОжидаетЧто(Ответ.Сбой, Описание + ": ответ со сбоем").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), Символы.ПС), Описание + ": расхождение называет запрос")
		.Содержит(Метод + " " + Адрес);

КонецПроцедуры

// Конектор остановился раньше времени: второй обмен записи не востребован.
Процедура Воспроизведение_НевостребованныйОбменВКонце() Экспорт

	Транспорт = ВоспроизведениеИз(ОбменыДвух());
	Транспорт.ВыполнитьЗапрос("GET", "https://acp.example.test/api/a?x=1", Новый Соответствие);

	Расхождения = Транспорт.Проверить();
	ЮТест.ОжидаетЧто(Расхождения.Количество(), "Одно расхождение: невостребованный обмен").Равно(1);
	ЮТест.ОжидаетЧто(Расхождения[0], "Текст называет запрос невостребованного обмена").Содержит("GET https://acp.example.test/api/b");
	ЮТест.ОжидаетЧто(Расхождения[0], "Текст называет конец записи").Содержит("Невостребованный обмен 2");

КонецПроцедуры

// Пауза не ждет: пять пауз по 60 секунд укладываются в секунды, а транспорт их помнит.
Процедура Воспроизведение_ПаузаФиксируетсяИНеЖдет() Экспорт

	Транспорт = ВоспроизведениеИз(Новый Массив);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для Счетчик = 1 По 5 Цикл
		Транспорт.Пауза(60);
	КонецЦикла;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ЮТест.ОжидаетЧто(Длительность < 5000, "Пять пауз по 60 с заняли " + Длительность + " мс (не ждали)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Транспорт.Паузы.Количество(), "Зафиксировано пауз").Равно(5);
	ЮТест.ОжидаетЧто(Транспорт.Паузы[0], "Длительность первой паузы, с").Равно(60);

КонецПроцедуры

Процедура Воспроизведение_ЗаписанныйСбойДаетОтветСоСбоем() Экспорт

