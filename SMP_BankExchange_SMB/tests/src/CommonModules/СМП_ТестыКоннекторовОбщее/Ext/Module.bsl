// Читает дублером через внутреннюю точку продукта, которая принимает объект конектора значением.
Функция ЧитатьДублером(Дублер, Состав, Счета, Учетные, Транспорт)

	СтрокаРеестра = Новый Структура;
	СтрокаРеестра.Вставить("Идентификатор", "СМП_ТЕСТ_Коннектор");
