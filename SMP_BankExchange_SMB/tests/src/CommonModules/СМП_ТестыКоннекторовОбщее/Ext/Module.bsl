	СтрокаРеестра.Вставить("СоставУчетныхДанных", Состав);

	Параметры = Новый Массив;
	Параметры.Добавить(Дублер);
	Параметры.Добавить(СтрокаРеестра);
	Параметры.Добавить(Счета);
	Параметры.Добавить(НачалоПериодаТеста());
	Параметры.Добавить(КонецПериодаТеста());
	Параметры.Добавить(Учетные);
	Параметры.Добавить(Транспорт);
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора", Параметры);

