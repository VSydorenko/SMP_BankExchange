// Неполный или пустой состав учетных данных - действие человека до вызова конектора; значения в тексте нет.
Процедура Точка_СоставУчетныхДанных_НеполныйСостав(Описание, Вид) Экспорт

	Секрет = "СМП_ТЕСТ_СЕКРЕТ_ИД_77412";
	Учетные = Неопределено;
	Состав = Новый Массив;
	Состав.Добавить("ИД");
	Состав.Добавить("Токен");
	Если Вид = "нет" Тогда
		Учетные = Новый Структура("ИД", Секрет);
	ИначеЕсли Вид = "пусто" Тогда
		Учетные = Новый Структура("ИД, Токен", Секрет, "");
	ИначеЕсли Вид = "пробелы" Тогда
		Учетные = Новый Структура("ИД, Токен", Секрет, "   ");
	ИначеЕсли Вид = "строка" Тогда
		Учетные = Секрет;
	КонецЕсли;
	Дублер = НовыйДублер("");
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, Состав, НомераСчета("UA11"), Учетные, Неопределено);

	ЮТест.ОжидаетЧто(Результат.Принята, Описание + ": не принято").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Выписка.КлассОтказа, Описание + ": класс").Равно("ДействиеЧеловека");
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, Описание + ": чтение неполное").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Выписка.ГраницаДоверия, Описание + ": граница доверия").Равно(НачалоПериодаТеста());
	ЮТест.ОжидаетЧто(Дублер.ВызововПрочитать, Описание + ": конектор не вызывался").Равно(Неопределено);
	Тексты = ТекстыДиагностики(Результат);
	ЮТест.ОжидаетЧто(Тексты, Описание + ": текст не содержит значений учетных данных").НеСодержит(Секрет);
	ЮТест.ОжидаетЧто(КоличествоУровня(Результат, "Ошибка"), Описание + ": рядок - Предупреждение").Равно(0);
	Если Вид <> "нет" Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Тексты, Описание + ": текст называет отсутствующее поле").Содержит("Токен");

КонецПроцедуры

