// Вызов экспортной функции общего модуля продукта с позиционными аргументами (Null - "аргумента нет").
Функция ВызватьОбщее(Модуль, ИмяФункции, Аргумент1 = Null, Аргумент2 = Null, Аргумент3 = Null, Аргумент4 = Null)

	Аргументы = Новый Массив;
	Для Каждого Значение Из Новый Структура("Первый, Второй, Третий, Четвертый", Аргумент1, Аргумент2, Аргумент3, Аргумент4) Цикл
		Если ТипЗнч(Значение.Значение) = Тип("Null") Тогда
			Прервать;
		КонецЕсли;
		Аргументы.Добавить(Значение.Значение);
	КонецЦикла;
	Возврат СМП_ТестыВызовПродукта.Вызвать(Модуль + "." + ИмяФункции, Аргументы);

