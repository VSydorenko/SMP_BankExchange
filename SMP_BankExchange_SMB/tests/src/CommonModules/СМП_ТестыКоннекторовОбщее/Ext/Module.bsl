// Измерения платформы, на которых стоят конекторы API (план 05а, задача 0, D36 п. 7).
//
// Модуль не тестирует продукт: он фиксирует поведение платформы и приемов предшественников
// (СМП_РаботаСБанками*API*) там, где его нельзя вывести из чтения кода. Каждое утверждение -
// измеренное значение, а не ожидание. Если платформа или сеанс другие, утверждения краснеют:
// это сигнал пересмотреть то, что на них стоит, а не подогнать число.
//
// Условия измерения (проверяются отдельными тестами, чтобы красное называло причину):
//   - платформа 8.3.27 (версия приложения начинается с "8.3.27");
//   - часовой пояс сеанса файловой базы - Europe/Kiev. Однопараметрический МестноеВремя(Д),
//     как его вызывает предшественник, берет именно пояс сеанса, поэтому в другом поясе
//     тесты "МестноеВремяПредшественника_*" покажут разницу.
// Тесты не меняют пояс сеанса и не читают данные базы.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Имя киевского часового пояса (D36 п. 7)")
			.ДобавитьСерверныйТест("ИмяПояса_Kiev_Принимается")
			.ДобавитьСерверныйТест("ИмяПояса_Kyiv_Отклоняется")
		.ДобавитьТестовыйНабор("Спільні функції конекторів: час, JSON, відмови (D36 п. 7, 8)")
			.ДобавитьСерверныйТест("КлассПоСтатусуHTTP")
				.СПараметрами("200", 200, "")
				.СПараметрами("204", 204, "")
				.СПараметрами("400", 400, "ДействиеЧеловека")
				.СПараметрами("401 автентификация", 401, "ДействиеЧеловека")
				.СПараметрами("403 автентификация", 403, "ДействиеЧеловека")
				.СПараметрами("404", 404, "ДействиеЧеловека")
				.СПараметрами("408 таймаут запроса", 408, "Повторить")
				.СПараметрами("429 после повтора", 429, "Повторить")
				.СПараметрами("500", 500, "Повторить")
				.СПараметрами("502", 502, "Повторить")
				.СПараметрами("503", 503, "Повторить")
				.СПараметрами("504", 504, "Повторить")
				.СПараметрами("599", 599, "Повторить")
				.СПараметрами("ответа не было, статус 0", 0, "Повторить")
				.СПараметрами("301 перенаправление", 301, "ДействиеЧеловека")
		.ДобавитьТестовыйНабор("Читання конектором через точку читання (D36 п. 1, 3, 8, 10)")
			.ДобавитьСерверныйТест("Точка_ТокенНеТрапляетсяВТекстахРезультата")
			.ДобавитьСерверныйТест("Точка_ТокенВТекстахДублера_Контроль")
		.ДобавитьТестовыйНабор("Раунд правок 1: секреты, пауза, справжній транспорт, порядок вирізання")
			.ДобавитьСерверныйТест("Точка_ТокенНеТрапляетсяВКонвертеИСырыхДанных")
			.ДобавитьСерверныйТест("ТекстОтказа_ВырезаетУчетныеДанныеПередОбрезанием")
			.ДобавитьСерверныйТест("УбратьУчетныеДанные_СначалаДлинноеЗначение")
			.ДобавитьСерверныйТест("Транспорт_Справжний_АдресБезХоста_СбойБезТокена")
				.СПараметрами("только схема", "https://")
				.СПараметрами("пустой хост с путем", "https:///api/a?x=1");

КонецПроцедуры

#Область ИмяПояса

Процедура ИмяПояса_Kiev_Принимается() Экспорт

	ЮТест.ОжидаетЧто(МестноеВремя(Дата(2026, 1, 15, 12, 0, 0), "Europe/Kiev"), "12:00 UTC зимой в Europe/Kiev")
		.Равно(Дата(2026, 1, 15, 14, 0, 0));

КонецПроцедуры

// Исключение не проглатывается: текст идет в утверждение, чтобы красное показало, что именно
// ответила платформа, если формулировка изменится.
Процедура ИмяПояса_Kyiv_Отклоняется() Экспорт

	ТекстОшибки = "";
	Попытка
		Результат = МестноеВремя(Дата(2026, 1, 15, 12, 0, 0), "Europe/Kyiv");
		ТекстОшибки = "исключения не было, результат " + Результат;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Europe/Kyiv на платформе 8.3.27")
		.Равно("Ошибочный идентификатор часового пояса 'Europe/Kyiv'");

КонецПроцедуры

#КонецОбласти

#Область СпільніФункціїКоннекторів

Процедура КлассПоСтатусуHTTP(Описание, Статус, Ожидаемый) Экспорт

	Результат = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "КлассОтказаПоСтатусуHTTP", Статус);

	ЮТест.ОжидаетЧто(Результат, Описание + ": класс по статусу " + Статус).Равно(Ожидаемый);

КонецПроцедуры

#КонецОбласти

#Область ТочкаЧтенияКоннектора

// Токен не трапляється в жодному тексті результату: ни в сообщении конектора, ни в исключении, ни в классе.
Процедура Точка_ТокенНеТрапляетсяВТекстахРезультата() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, СоставТеста(), НомераСчета("UA11"), УчетныеДанныеТеста(), Неопределено);

	Тексты = ТекстыДиагностики(Результат);
	ЮТест.ОжидаетЧто(Тексты, "Токен в диагностике").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Тексты, "Остальной текст сообщения конектора сохранен").Содержит("Банк ответил отказом");
	ЮТест.ОжидаетЧто(Тексты, "Остальной текст исключения сохранен").Содержит("Сбой запроса с токеном");
	ЮТест.ОжидаетЧто(Результат.Выписка.КлассОтказа, "Токен не в классе").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Прочитанное лежит в результате").Равно(1);

КонецПроцедуры

// Контроль: сам дублер тот текст с токеном производит - без замены в точке чтения токен был бы в результате.
Процедура Точка_ТокенВТекстахДублера_Контроль() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);
	Выписка = ВызватьОбщее("СМП_ВыпискаБанка", "НоваяВыписка");
	Параметры = ВызватьОбщее("СМП_ВыпискаБанка", "НовыеПараметрыЧтения");

	ТекстИсключения = "";
	Попытка
		Дублер.Прочитать(Неопределено, Параметры, Выписка);
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, "Необработанный текст исключения дублера").Содержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Выписка.Диагностика[0].Текст, "Необработанная диагностика дублера").Содержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Выписка.Операции[0].СырыеДанные, "Необработанные СырыеДанные дублера").Содержит(ТокенСинтетический());

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ТокенСинтетический()

	Возврат "СМП_ТЕСТ_ТОКЕН_Zq7Xp93Lk";

КонецФункции

Функция НачалоПериодаТеста()

	Возврат Дата(2026, 1, 15, 0, 0, 0);

КонецФункции

Функция КонецПериодаТеста()

	Возврат Дата(2026, 1, 15, 23, 59, 59);

КонецФункции

Функция УчетныеДанныеТеста()

	Возврат Новый Структура("Токен", ТокенСинтетический());

КонецФункции

Функция СоставТеста()

	Состав = Новый Массив;
	Состав.Добавить("Токен");
	Возврат Состав;

КонецФункции

Функция НомераСчета(Первый, Второй = Неопределено)

	Номера = Новый Массив;
	Номера.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Номера.Добавить(Второй);
	КонецЕсли;
	Возврат Номера;

КонецФункции

Функция НовыйДублер(Режим)

	Дублер = Обработки.СМП_ТестКоннектор.Создать();
	Дублер.Режим = Режим;
	Возврат Дублер;

КонецФункции

Функция СтрокиДублера(Номер, Количество)

	Строки = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Строки.Добавить(Новый Структура("НомерСчета", Номер));
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Читает дублером через внутреннюю точку продукта, которая принимает объект конектора значением.
Функция ЧитатьДублером(Дублер, Состав, Счета, Учетные, Транспорт)

	СтрокаРеестра = Новый Структура;
	СтрокаРеестра.Вставить("Идентификатор", "СМП_ТЕСТ_Коннектор");
	СтрокаРеестра.Вставить("Банк", "СМП_ТЕСТ_Банк");
	СтрокаРеестра.Вставить("Представление", "СМП_ТЕСТ_Банк (API)");
	СтрокаРеестра.Вставить("СоставУчетныхДанных", Состав);

	Параметры = Новый Массив;
	Параметры.Добавить(Дублер);
	Параметры.Добавить(СтрокаРеестра);
	Параметры.Добавить(Счета);
	Параметры.Добавить(НачалоПериодаТеста());
	Параметры.Добавить(КонецПериодаТеста());
	Параметры.Добавить(Учетные);
	Параметры.Добавить(Транспорт);
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьОбъектомКоннектора", Параметры);

КонецФункции

// Вызов экспортной функции общего модуля продукта с позиционными аргументами (Null - "аргумента нет").
Функция ВызватьОбщее(Модуль, ИмяФункции, Аргумент1 = Null, Аргумент2 = Null, Аргумент3 = Null, Аргумент4 = Null)

	Аргументы = Новый Массив;
	Для Каждого Значение Из Новый Структура("Первый, Второй, Третий, Четвертый", Аргумент1, Аргумент2, Аргумент3, Аргумент4) Цикл
		Если ТипЗнч(Значение.Значение) = Тип("Null") Тогда
			Прервать;
		КонецЕсли;
		Аргументы.Добавить(Значение.Значение);
	КонецЦикла;
	Возврат СМП_ТестыВызовПродукта.Вызвать(Модуль + "." + ИмяФункции, Аргументы);

КонецФункции

Функция ТекстыДиагностики(Результат)

	Тексты = Новый Массив;
	Для Каждого Строка Из Результат.Диагностика Цикл
		Тексты.Добавить(Строка.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти

#Область РаундПравок1

// Секрет не остается ни в конверте платформы (Выписка.Диагностика), ни в СырыеДанные операций - ни в
// таблице результата, ни в таблице конверта: этап 5б может сохранять конверт.
Процедура Точка_ТокенНеТрапляетсяВКонвертеИСырыхДанных() Экспорт

	Дублер = НовыйДублер("ТокенВТексте");
	Дублер.ТокенДляТекста = ТокенСинтетический();
	Дублер.Строки = СтрокиДублера("UA11", 1);

	Результат = ЧитатьДублером(Дублер, СоставТеста(), НомераСчета("UA11"), УчетныеДанныеТеста(), Неопределено);

	ДиагностикаКонверта = ТекстыТаблицы(Результат.Выписка.Диагностика, "Текст");
	СырыеРезультата = ТекстыТаблицы(Результат.Операции, "СырыеДанные");
	СырыеКонверта = ТекстыТаблицы(Результат.Выписка.Операции, "СырыеДанные");

	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Токен в Выписка.Диагностика").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(ДиагностикаКонверта, "Остаток текста в Выписка.Диагностика сохранен").Содержит("Банк ответил отказом");
	ЮТест.ОжидаетЧто(СырыеРезультата, "Токен в СырыеДанные результата").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеРезультата, "Остаток СырыеДанные результата сохранен").Содержит("сырые данные с токеном");
	ЮТест.ОжидаетЧто(СырыеКонверта, "Токен в СырыеДанные конверта").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(СырыеКонверта, "Остаток СырыеДанные конверта сохранен").Содержит("сырые данные с токеном");

КонецПроцедуры

// Токен, пересекающий границу обрезания описания, не оставляет видимого префикса: сначала вырезание,
// потом обрезание.
Процедура ТекстОтказа_ВырезаетУчетныеДанныеПередОбрезанием() Экспорт

	Заполнитель = "";
	Для Счетчик = 1 По 285 Цикл
		Заполнитель = Заполнитель + "ж";
	КонецЦикла;
	Описание = Заполнитель + ТокенСинтетический() + " хвост";

	Текст = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "ТекстОтказаБанка", "СМП_ТЕСТ_Банк", 401, Описание, УчетныеДанныеТеста());

	ЮТест.ОжидаетЧто(Текст, "Префикс токена после обрезания").НеСодержит("СМП_ТЕСТ_ТОКЕН");
	ЮТест.ОжидаетЧто(Текст, "На месте токена - замена").Содержит("***");

КонецПроцедуры

// Короткое значение не оставляет хвоста длинного, в которое оно входит: вырезание от длинного к короткому,
// независимо от порядка полей в структуре.
Процедура УбратьУчетныеДанные_СначалаДлинноеЗначение() Экспорт

	Учетные = Новый Структура;
	Учетные.Вставить("Короткое", "12");
	Учетные.Вставить("Длинное", "12ab34");

	Результат = ВызватьОбщее("СМП_КоннекторыБанковОбщее", "УбратьУчетныеДанные", "ид 12ab34 и 12", Учетные);

	ЮТест.ОжидаетЧто(Результат, "Текст после вырезания значений").Равно("ид *** и ***");

КонецПроцедуры

// Справочный транспорт без сети: адрес без хоста падает до создания соединения. Исключение - ответ
// со сбоем, статус 0, токен из заголовков в тексте сбоя не появляется.
Процедура Транспорт_Справжний_АдресБезХоста_СбойБезТокена(Описание, Адрес) Экспорт

	Транспорт = Вычислить("Обработки.СМП_ТранспортHTTP.Создать()");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", ТокенСинтетический());
	Заголовки.Вставить("Authorization", "Bearer " + ТокенСинтетический());

	ТекстИсключения = "";
	Ответ = Неопределено;
	Попытка
		Ответ = Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки);
	Исключение
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстИсключения, Описание + ": транспорт не бросает исключение").Равно("");
	ЮТест.ОжидаетЧто(Ответ.Сбой, Описание + ": сбой").ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.Статус, Описание + ": статус при сбое").Равно(0);
	ЮТест.ОжидаетЧто(Ответ.ВидСбоя, Описание + ": вид сбоя").Равно("network");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Ответ.ТекстСбоя), Описание + ": текст сбоя заполнен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.ТекстСбоя, Описание + ": токен в тексте сбоя").НеСодержит(ТокенСинтетический());
	ЮТест.ОжидаетЧто(Ответ.Заголовки.Количество(), Описание + ": заголовков ответа нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПомощникиРаунда1

Функция ТекстыТаблицы(Таблица, Колонка)

	Тексты = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Тексты.Добавить(Строка[Колонка]);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти
