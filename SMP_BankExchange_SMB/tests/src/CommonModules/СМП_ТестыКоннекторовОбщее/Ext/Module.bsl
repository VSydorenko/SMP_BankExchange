Функция ЗначенияНеЧисла()

	Значения = Новый Массив;
	Значения.Добавить(Неопределено);
	Значения.Добавить("30");
	Значения.Добавить(Истина);
	Возврат Значения;

КонецФункции

Функция ТекстыТаблицы(Таблица, Колонка)

	Тексты = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Тексты.Добавить(Строка[Колонка]);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

