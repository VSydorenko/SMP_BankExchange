// Матрица распознавания и полнота реестра читателей (план 03, задача 11): доказательство D30 «пустой или мусорной
// выписки из не того файла не бывает» и того, что реестр покрывает каждую нынешнюю обработку, кроме Сбербанка.
//
// Матрица: каждый ФайлПохожНаФормат шести модулей форматов × каждый макет-образец обработки СМП_ТестыМакеты (все 18:
// 13 принимаемых и 5 отклоняемых). Ожидание - РОВНО свой формат (для отклоняемых - ни один) - задано в этом модуле явной
// таблицей «образец -> формат», а не берется из продукта. Совпадение двух форматов на одном файле - дефект одной из
// проверок. ОТП XML не узнает ни один формат (решение планировщика по задаче 10): рядка «ОТП - XML» в реестре нет.
//
// Полнота: перечень обработок epf/src (без Сбербанка) берется из макета СМП_ТестПереченьОбработок, который генерирует
// инструмент задачи 2 из epf/src, а не из константы теста. Проверяется в обе стороны: у каждой обработки перечня ровно
// одна строка реестра, и каждое ИмяСтаройОбработки реестра есть в перечне.
//
// Контроли «умеют падать»: те же функции-проверки получают заведомо неверные ожидания, реестр без строки, с лишней и
// с задвоенной строкой - и обязаны найти нарушение.
//
// Продукт вызывается только через СМП_ТестыВызовПродукта. Без данных в базе: транзакция не нужна.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Матрица распознавания: образец × формат")
			.ДобавитьСерверныйТест("Матрица_ТаблицаОжиданийПолная")
			.ДобавитьСерверныйТест("Матрица_ОбразецУзнаетсяРовноСвоимФорматом")
			.ДобавитьСерверныйТест("Матрица_ДвухФорматовНаОдномФайлеНет")
			.ДобавитьСерверныйТест("Матрица_КонтрольУмеетПадатьНаНеверныхОжиданиях")
		.ДобавитьТестовыйНабор("Матрица распознавания: подсказки реестра")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ОщадНаФайлеiFOBSCSVОтказИПодсказкаШестьСтрок")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ПодсказкаРазличаетФайлы")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ОтклоняемыйОбразецБезПодсказок")
		.ДобавитьТестовыйНабор("Полнота реестра")
			.ДобавитьСерверныйТест("Полнота_ПеречньЧитаетсяИНеПуст")
			.ДобавитьСерверныйТест("Полнота_КаждаяОбработкаИмеетРовноОднуСтрокуРеестра")
			.ДобавитьСерверныйТест("Полнота_КаждоеИмяВРеестреЕстьВПеречне")
			.ДобавитьСерверныйТест("Полнота_КонтрольУмеетПадатьБезСтрокиСЛишнейСтрокойИЗадвоенной")
			.ДобавитьСерверныйТест("Полнота_КонтрольУмеетПадатьНаЛишнемВПеречнеИПустомПеречне");

КонецПроцедуры

#Область Матрица

Процедура Матрица_ТаблицаОжиданийПолная() Экспорт

	Ожидания = ТаблицаОжиданий();
	Модули = МодулиФорматов();

	ЮТест.ОжидаетЧто(Ожидания.Количество(), "Образцов в таблице ожиданий (все макеты-образцы)").Равно(18);

	Отклоняемых = 0;
	Принимаемых = 0;
	Своих = Новый Соответствие;
	Для Каждого Элемент Из Ожидания Цикл
		Данные = Макет("СМП_ТестВыписка" + Элемент.Ключ);
		ЮТест.ОжидаетЧто(ТипЗнч(Данные), "Макет образца " + Элемент.Ключ + " - двоичные данные").Равно(Тип("ДвоичныеДанные"));
		ЮТест.ОжидаетЧто(Данные.Размер() > 0, "Макет образца " + Элемент.Ключ + " не пуст").ЭтоИстина();
		Если ПустаяСтрока(Элемент.Значение) Тогда
			Отклоняемых = Отклоняемых + 1;
		Иначе
			Принимаемых = Принимаемых + 1;
			Своих[Элемент.Значение] = Истина;
			ЮТест.ОжидаетЧто(Модули.Найти(Элемент.Значение) <> Неопределено, "Формат из таблицы есть среди модулей матрицы: "
				+ Элемент.Значение).ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Принимаемых, "Принимаемых образцов").Равно(13);
	ЮТест.ОжидаетЧто(Отклоняемых, "Отклоняемых образцов (ОТП 660, XLS под .csv, ОТП DBF, ОТП DBF доба, ОТП XML)").Равно(5);
	Для Каждого Модуль Из Модули Цикл
		ЮТест.ОжидаетЧто(Своих[Модуль] = Истина, "У формата есть хотя бы один свой образец: " + Модуль).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Главная проверка: 6 форматов × 18 образцов = 108 клеток; ожидание клетки «Истина» только для своего формата образца.
Процедура Матрица_ОбразецУзнаетсяРовноСвоимФорматом() Экспорт

	Нарушения = НарушенияМатрицы(ТаблицаОжиданий());

	ЮТест.ОжидаетЧто(СтрСоединить(Нарушения, Символы.ПС), "Нарушения матрицы").Равно("");

КонецПроцедуры

// Дефект «две проверки узнали один файл» ловится и без таблицы: по каждому образцу истинных ответов не больше одного.
Процедура Матрица_ДвухФорматовНаОдномФайлеНет() Экспорт

	Модули = МодулиФорматов();
	ВсегоУзнаваний = 0;
	Для Каждого Элемент Из ТаблицаОжиданий() Цикл
		Данные = Макет("СМП_ТестВыписка" + Элемент.Ключ);
		Узнали = Новый Массив;
		Для Каждого Модуль Из Модули Цикл
			Если ФайлПохож(Модуль, Данные) = Истина Тогда
				Узнали.Добавить(Модуль);
			КонецЕсли;
		КонецЦикла;
		ВсегоУзнаваний = ВсегоУзнаваний + Узнали.Количество();
		ЮТест.ОжидаетЧто(Узнали.Количество() <= 1, "Образец " + Элемент.Ключ + " узнали форматы: " + СтрСоединить(Узнали, ", ")).ЭтоИстина();
	КонецЦикла;
	// Проверка не вакуумна: узнаваний ровно столько, сколько принимаемых образцов.
	ЮТест.ОжидаетЧто(ВсегоУзнаваний, "Всего узнаваний на 18 образцах").Равно(13);

КонецПроцедуры

// Контроль: функция проверки обязана находить нарушение, когда ожидание неверно.
Процедура Матрица_КонтрольУмеетПадатьНаНеверныхОжиданиях() Экспорт

	// 1. Принимаемый образец объявлен отклоняемым.
	Ожидания = ТаблицаОжиданий();
	Ожидания["CSVПроКредит"] = "";
	Нарушения = НарушенияМатрицы(Ожидания);
	ЮТест.ОжидаетЧто(Нарушения.Количество() >= 1, "Принимаемый образец объявлен отклоняемым: нарушение найдено").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(СтрСоединить(Нарушения, Символы.ПС), "CSVПроКредит") > 0, "Нарушение называет образец").ЭтоИстина();

	// 2. Образцу назначен чужой формат.
	Ожидания = ТаблицаОжиданий();
	Ожидания["CSVУкрГаз"] = "СМП_ЧитательВыпискиСенсБанк_CSV";
	Нарушения = НарушенияМатрицы(Ожидания);
	ЮТест.ОжидаетЧто(Нарушения.Количество() >= 1, "Образцу назначен чужой формат: нарушение найдено").ЭтоИстина();

	// 3. Отклоняемому образцу назначен формат.
	Ожидания = ТаблицаОжиданий();
	Ожидания["XLSСенсТОВ"] = "СМП_ЧитательВыпискиiFOBS_CSV";
	Нарушения = НарушенияМатрицы(Ожидания);
	ЮТест.ОжидаетЧто(Нарушения.Количество() >= 1, "Отклоняемому образцу назначен формат: нарушение найдено").ЭтоИстина();

	// 4. ОТП XML ожидается узнанным Южным (старое, замененное ожидание).
	Ожидания = ТаблицаОжиданий();
	Ожидания["XMLОТПДоба"] = "СМП_ЧитательВыпискиiFOBS_XML";
	Нарушения = НарушенияМатрицы(Ожидания);
	ЮТест.ОжидаетЧто(Нарушения.Количество() >= 1, "ОТП XML ожидается узнанным: нарушение найдено").ЭтоИстина();

	// 5. Контроль не вакуумен: верная таблица нарушений не дает.
	ЮТест.ОжидаетЧто(НарушенияМатрицы(ТаблицаОжиданий()).Количество(), "Верная таблица: нарушений нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПодсказкиРеестра

// Выбрана строка «Ощадбанк - DBF», а файл - iFOBS CSV: отказ, подсказка - все шесть строк iFOBS CSV.
Процедура ПрочитатьФайл_ОщадНаФайлеiFOBSCSVОтказИПодсказкаШестьСтрок() Экспорт

	Результат = ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыпискаCSVПроКредит"), ЧислоСчетов());

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл iFOBS CSV под строкой Ощадбанка не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	Подсказка = Результат.ПохожиеСтрокиРеестра;
	ЮТест.ОжидаетЧто(Подсказка.Количество(), "В подсказке ровно шесть строк реестра").Равно(6);
	Для Каждого Идентификатор Из СтрРазделить("ПроКредит_CSV,УкрСиб_CSV,Восток_CSV,Райффайзен_CSV,Универсал_CSV,Акорд_CSV", ",") Цикл
		ЮТест.ОжидаетЧто(Подсказка.Найти(Идентификатор) <> Неопределено, "В подсказке есть строка iFOBS CSV: " + Идентификатор).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Контроль: подсказка зависит от файла, а не одна и та же.
Процедура ПрочитатьФайл_ПодсказкаРазличаетФайлы() Экспорт

	Результат = ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыпискаCSVУкрГаз"), ЧислоСчетов());

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл УкрГаза под строкой Ощадбанка не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "Подсказка - только строка УкрГаза").Равно("УкрГазБанк_CSV");

КонецПроцедуры

// Отклоняемый образец (ОТП XML) не узнает ни одна строка: подсказка пуста, принят не будет.
Процедура ПрочитатьФайл_ОтклоняемыйОбразецБезПодсказок() Экспорт

	Результат = ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыпискаXMLОТПДоба"), ЧислоСчетов());

	ЮТест.ОжидаетЧто(Результат.Принята, "ОТП XML под строкой Ощадбанка не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.ПохожиеСтрокиРеестра.Количество(), "Строк в подсказке нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Полнота

Процедура Полнота_ПеречньЧитаетсяИНеПуст() Экспорт

	Перечень = ПеречньОбработок();

	ЮТест.ОжидаетЧто(Перечень.Количество() > 0, "Перечень обработок прочитан из макета и не пуст").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(СтрСоединить(Перечень, ","), "Сбербанк"), "Сбербанка в перечне нет").Равно(0);
	Для Каждого Имя Из Перечень Цикл
		ЮТест.ОжидаетЧто(СтрНачинаетсяС(Имя, "СМП_ОбработкаВыпискиБанка_"), "Имя обработки в перечне: " + Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура Полнота_КаждаяОбработкаИмеетРовноОднуСтрокуРеестра() Экспорт

	Нарушения = НарушенияПолноты(Продукт("РеестрЧитателей"), ПеречньОбработок(), Истина);

	ЮТест.ОжидаетЧто(СтрСоединить(Нарушения, Символы.ПС), "Обработки без ровно одной строки реестра").Равно("");

КонецПроцедуры

Процедура Полнота_КаждоеИмяВРеестреЕстьВПеречне() Экспорт

	Нарушения = НарушенияПолноты(Продукт("РеестрЧитателей"), ПеречньОбработок(), Ложь);

	ЮТест.ОжидаетЧто(СтрСоединить(Нарушения, Символы.ПС), "Имена реестра, которых нет в перечне").Равно("");

КонецПроцедуры

Процедура Полнота_КонтрольУмеетПадатьБезСтрокиСЛишнейСтрокойИЗадвоенной() Экспорт

	Перечень = ПеречньОбработок();

	// Реестр без одной строки: у обработки нет строки.
	Реестр = Продукт("РеестрЧитателей").Скопировать();
	Удаляемое = Реестр[0].ИмяСтаройОбработки;
	Реестр.Удалить(0);
	Нарушения = НарушенияПолноты(Реестр, Перечень, Истина);
	ЮТест.ОжидаетЧто(Нарушения.Количество(), "Реестр без строки: ровно одно нарушение").Равно(1);
	ЮТест.ОжидаетЧто(СтрНайти(СтрСоединить(Нарушения, Символы.ПС), Удаляемое) > 0, "Нарушение называет обработку без строки").ЭтоИстина();

	// Задвоенная строка: обработка с двумя строками.
	Реестр = Продукт("РеестрЧитателей").Скопировать();
	Задвоенная = Реестр.Добавить();
	ЗаполнитьЗначенияСвойств(Задвоенная, Реестр[0]);
	Нарушения = НарушенияПолноты(Реестр, Перечень, Истина);
	ЮТест.ОжидаетЧто(Нарушения.Количество(), "Задвоенная строка: ровно одно нарушение").Равно(1);

	// Лишняя строка: имя, которого нет в перечне (например, Сбербанк).
	Реестр = Продукт("РеестрЧитателей").Скопировать();
	Лишняя = Реестр.Добавить();
	Лишняя.Идентификатор = "Контроль_Лишняя";
	Лишняя.ИмяСтаройОбработки = "СМП_ОбработкаВыпискиБанка_Сбербанк";
	Нарушения = НарушенияПолноты(Реестр, Перечень, Ложь);
	ЮТест.ОжидаетЧто(Нарушения.Количество(), "Лишняя строка: ровно одно нарушение обратной проверки").Равно(1);

	// Контроль не вакуумен: неизмененный реестр нарушений не дает в обе стороны.
	ЮТест.ОжидаетЧто(НарушенияПолноты(Продукт("РеестрЧитателей"), Перечень, Истина).Количество(), "Прямая проверка на целом реестре").Равно(0);
	ЮТест.ОжидаетЧто(НарушенияПолноты(Продукт("РеестрЧитателей"), Перечень, Ложь).Количество(), "Обратная проверка на целом реестре").Равно(0);

КонецПроцедуры

Процедура Полнота_КонтрольУмеетПадатьНаЛишнемВПеречнеИПустомПеречне() Экспорт

	Реестр = Продукт("РеестрЧитателей");

	// В перечне появилась обработка без строки реестра.
	Перечень = ПеречньОбработок();
	Перечень.Добавить("СМП_ОбработкаВыпискиБанка_Контрольная");
	Нарушения = НарушенияПолноты(Реестр, Перечень, Истина);
	ЮТест.ОжидаетЧто(Нарушения.Количество(), "Лишнее в перечне: ровно одно нарушение").Равно(1);

	// Пустой перечень: каждая строка реестра - «лишняя».
	Нарушения = НарушенияПолноты(Реестр, Новый Массив, Ложь);
	ЮТест.ОжидаетЧто(Нарушения.Количество(), "Пустой перечень: нарушение на каждую строку реестра").Равно(Реестр.Количество());

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Явная таблица ожиданий: образец -> модуль формата, который обязан его узнать; пусто - не узнает никто.
// Составлена по README инструмента (tools/statement-samples) и решениям планировщика, а не по продукту.
Функция ТаблицаОжиданий()

	Модуль_iFOBS_CSV = "СМП_ЧитательВыпискиiFOBS_CSV";
	Ожидания = Новый Соответствие;
	Ожидания["CSVАкорд"] = Модуль_iFOBS_CSV;
	Ожидания["CSVАваль"] = Модуль_iFOBS_CSV;
	Ожидания["CSVВосток"] = Модуль_iFOBS_CSV;
	Ожидания["CSVУниверсалNUL"] = Модуль_iFOBS_CSV;
	Ожидания["CSVПроКредит"] = Модуль_iFOBS_CSV;
	Ожидания["CSVУкрСиб"] = Модуль_iFOBS_CSV;
	Ожидания["CSVУкрГаз"] = "СМП_ЧитательВыпискиУкрГазБанк_CSV";
	Ожидания["CSVСенсТОВ"] = "СМП_ЧитательВыпискиСенсБанк_CSV";
	Ожидания["CSVСенсФОП"] = "СМП_ЧитательВыпискиСенсБанк_CSV";
	Ожидания["DATОТП1191"] = "СМП_ЧитательВыпискиОТП_DAT";
	Ожидания["DBFОщад16"] = "СМП_ЧитательВыпискиОщадБанк_DBF";
	Ожидания["DBFОщад17"] = "СМП_ЧитательВыпискиОщадБанк_DBF";
	Ожидания["XMLПивденный"] = "СМП_ЧитательВыпискиiFOBS_XML";
	// Отклоняемые: не узнает ни один формат.
	Ожидания["XLSСенсТОВ"] = "";
	Ожидания["DATОТП660"] = "";
	Ожидания["DBFОТП"] = "";
	Ожидания["DBFОТПДоба"] = "";
	Ожидания["XMLОТПДоба"] = "";
	Возврат Ожидания;

КонецФункции

Функция МодулиФорматов()

	Возврат СтрРазделить("СМП_ЧитательВыпискиiFOBS_CSV,СМП_ЧитательВыпискиУкрГазБанк_CSV,СМП_ЧитательВыпискиСенсБанк_CSV,"
		+ "СМП_ЧитательВыпискиОТП_DAT,СМП_ЧитательВыпискиОщадБанк_DBF,СМП_ЧитательВыпискиiFOBS_XML", ",");

КонецФункции

// Нарушения матрицы по заданной таблице ожиданий: клетки, где ответ ФайлПохожНаФормат не равен ожиданию.
Функция НарушенияМатрицы(Ожидания)

	Нарушения = Новый Массив;
	Модули = МодулиФорматов();
	Для Каждого Элемент Из Ожидания Цикл
		Данные = Макет("СМП_ТестВыписка" + Элемент.Ключ);
		Для Каждого Модуль Из Модули Цикл
			Ожидание = Модуль = Элемент.Значение;
			Факт = Неопределено;
			Попытка
				Факт = ФайлПохож(Модуль, Данные);
			Исключение
				Нарушения.Добавить(Элемент.Ключ + " × " + Модуль + ": исключение проверки формата");
				Продолжить;
			КонецПопытки;
			Если Факт <> Ожидание Тогда
				Нарушения.Добавить(СтрШаблон("%1 × %2: ожидали %3, получили %4", Элемент.Ключ, Модуль, Ожидание, Факт));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Нарушения;

КонецФункции

// Перечень обработок epf/src без Сбербанка - из макета, который генерирует инструмент задачи 2.
Функция ПеречньОбработок() Экспорт

	Документ = Макет("СМП_ТестПереченьОбработок");
	Перечень = Новый Массив;
	Для Номер = 1 По Документ.КоличествоСтрок() Цикл
		Имя = СокрЛП(СтрЗаменить(Документ.ПолучитьСтроку(Номер), Символ(65279), ""));
		Если Не ПустаяСтрока(Имя) Тогда
			Перечень.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Перечень;

КонецФункции

// ВПрямую = Истина: у каждой обработки перечня ровно одна строка реестра. ВПрямую = Ложь: каждое ИмяСтаройОбработки
// реестра есть в перечне.
Функция НарушенияПолноты(Реестр, Перечень, ВПрямую)

	Нарушения = Новый Массив;
	Если ВПрямую Тогда
		Для Каждого Имя Из Перечень Цикл
			Количество = 0;
			Для Каждого СтрокаРеестра Из Реестр Цикл
				Если СтрокаРеестра.ИмяСтаройОбработки = Имя Тогда
					Количество = Количество + 1;
				КонецЕсли;
			КонецЦикла;
			Если Количество <> 1 Тогда
				Нарушения.Добавить(СтрШаблон("%1: строк реестра %2, нужна ровно одна", Имя, Количество));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаРеестра Из Реестр Цикл
			Если Перечень.Найти(СтрокаРеестра.ИмяСтаройОбработки) = Неопределено Тогда
				Нарушения.Добавить(СтрШаблон("Строка %1: обработки %2 нет в перечне", СтрокаРеестра.Идентификатор, СтрокаРеестра.ИмяСтаройОбработки));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Нарушения;

КонецФункции

Функция Макет(Имя)

	Возврат Обработки.СМП_ТестыМакеты.ПолучитьМакет(Имя);

КонецФункции

Функция ФайлПохож(Модуль, Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат СМП_ТестыВызовПродукта.Вызвать(Модуль + ".ФайлПохожНаФормат", Параметры);

КонецФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьФайл(Идентификатор, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(Идентификатор);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьФайл", Параметры);

КонецФункции

// Номер нашего счета для отказных вызовов: до чтения дело не доходит, значение произвольное.
Функция ЧислоСчетов()

	Номера = Новый Массив;
	Номера.Добавить("UA000000000000000000000000000");
	Возврат Номера;

КонецФункции

