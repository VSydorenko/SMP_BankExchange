		"первая" + Символы.ПС + "вторая" + Символы.ВК + Символы.ПС + "третья")))));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].НазначениеПлатежа, "ПС - пробел, ВК остается")
