		ЮТест.ОжидаетЧто(Результат.Операции[0].КонтрагентМФО, "Остальные поля контрагента читаются").Равно("300002");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОтображениеПолей

// Каждое свойство операции берется из своего атрибута, независимо от направления: наш счет - IBAN, контрагент - CORR...
// У каждого атрибута свое значение-маркер; атрибуты, которые старая обработка в операцию не переносит (ACCOUNTNO,
// CORRACCOUNTNO, BANKID, IDENTIFYCODE, BANKNAME, CORRBANKNAME, DATAVERSION), в операцию не попадают.
Процедура Поля_КаждоеПолеИзСвоегоИсточника(Описание, Флаг, ОжидаемоеНаправление) Экспорт

	Подмена = Новый Структура;
	Подмена.Вставить("OPERATIONID", Флаг);
	Подмена.Вставить("DOCUMENTNO", "NDOC-M");
	Подмена.Вставить("IBAN", "ACC-OWN");
	Подмена.Вставить("CORRIBAN", "ACC-COR");
	Подмена.Вставить("CORRIDENTIFYCODE", "KOD-COR");
	Подмена.Вставить("CORRBANKID", "MFO-COR");
	Подмена.Вставить("CORRCONTRAGENTSNAME", "NAME-COR");
	Подмена.Вставить("PLATPURPOSE", "PURPOSE-M");
	Подмена.Вставить("ACCOUNTNO", "OLD-OWN-M");
	Подмена.Вставить("CORRACCOUNTNO", "OLD-COR-M");
	Подмена.Вставить("BANKID", "MFO-OWN-M");
	Подмена.Вставить("IDENTIFYCODE", "KOD-OWN-M");
	Подмена.Вставить("BANKNAME", "BANK-OWN-M");
	Подмена.Вставить("CORRBANKNAME", "BANK-COR-M");
	Подмена.Вставить("DATAVERSION", "VERSION-M");
	Результат = ПрочитатьФайл("Пивденный_XML", ФайлXML(МассивИз(ЗаписьСПодменой(1, Подмена))), НомераИз("ACC-OWN"));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана: " + Описание).Равно(1);
	Если Результат.Операции.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	Операция = Результат.Операции[0];
	ЮТест.ОжидаетЧто(Операция.Направление, "Направление: " + Описание).Равно(ОжидаемоеНаправление);
	ЮТест.ОжидаетЧто(Операция.НомерСчета, "НомерСчета - IBAN: " + Описание).Равно("ACC-OWN");
	ЮТест.ОжидаетЧто(Операция.НомерДокумента, "НомерДокумента - DOCUMENTNO: " + Описание).Равно("NDOC-M");
	ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, "КонтрагентНомерСчета - CORRIBAN: " + Описание).Равно("ACC-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентКод, "КонтрагентКод - CORRIDENTIFYCODE: " + Описание).Равно("KOD-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентМФО, "КонтрагентМФО - CORRBANKID: " + Описание).Равно("MFO-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентНаименование, "КонтрагентНаименование - CORRCONTRAGENTSNAME: " + Описание).Равно("NAME-COR");
	ЮТест.ОжидаетЧто(Операция.НазначениеПлатежа, "НазначениеПлатежа - PLATPURPOSE: " + Описание).Равно("PURPOSE-M");

	Прочитанное = Новый Массив;
	Для Каждого Колонка Из Результат.Операции.Колонки Цикл
		Значение = Операция[Колонка.Имя];
		// СырыеДанные - запись файла целиком, там по определению все атрибуты, в том числе не читаемые.
		Если ТипЗнч(Значение) = Тип("Строка") И Колонка.Имя <> "СырыеДанные" Тогда
			Прочитанное.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Прочитанное = СтрСоединить(Прочитанное, "|");
	Для Каждого Маркер Из СтрРазделить("OLD-OWN-M,OLD-COR-M,MFO-OWN-M,KOD-OWN-M,BANK-OWN-M,BANK-COR-M,VERSION-M", ",") Цикл
		ЮТест.ОжидаетЧто(СтрНайти(Прочитанное, Маркер), "Атрибут, который старая обработка не читает, в операцию не попал: " + Маркер + ", " + Описание).Равно(0);
	КонецЦикла;

КонецПроцедуры

// ПС в назначении - пробел, как у старой обработки (СтрЗаменить(PLATPURPOSE, ПС, " ")): ВК не трогается.
