#Область Реестр

Процедура Реестр_СтрокаПивденный() Экспорт

	Найдено = 0;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат <> ФорматМодуля() Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ЮТест.ОжидаетЧто(СтрокаРеестра.Идентификатор, "Идентификатор строки").Равно("Пивденный_XML");
		ЮТест.ОжидаетЧто(СтрокаРеестра.ИмяСтаройОбработки, "Имя старой обработки").Равно("СМП_ОбработкаВыпискиБанка_Пивденный");
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокаРеестра.РасширенияФайлов, ","), "Расширения файлов").Равно("xml");
		ЮТест.ОжидаетЧто(СтрокаРеестра.Представление, "Представление").Равно(СтрокаРеестра.Банк + " — " + СтрокаРеестра.ТипФайла);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено, "Строк реестра формата Южный XML (строки «ОТП - XML» нет: D30)").Равно(1);

КонецПроцедуры

// Правило КодыБанка: МФО из IBAN собственного счета образца (позиции 5-10), только измеренные; справочник НБУ не
// подключался.
Процедура Реестр_КодыБанкаТолькоМФОИзСчетаОбразца() Экспорт

	Эталон = РазобратьЭталон("XMLПивденный");
	СтрокаРеестра = СтрокаРеестраПоИдентификатору("Пивденный_XML");

	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаРеестра.КодыБанка) = Тип("Массив"), "КодыБанка - массив").ЭтоИстина();
	ЮТест.ОжидаетЧто(Сред(Эталон.Счета[0].НомерСчета, 5, 6), "МФО в IBAN обоих счетов образца одно").Равно(Сред(Эталон.Счета[1].НомерСчета, 5, 6));
	ЮТест.ОжидаетЧто(СтрСоединить(СтрокаРеестра.КодыБанка, ","), "КодыБанка - МФО из IBAN счета образца и ничего больше")
		.Равно(Сред(Эталон.НомерСчетаЧтения, 5, 6));

КонецПроцедуры

Процедура Реестр_ВариантаНет() Экспорт

	СтрокаРеестра = СтрокаРеестраПоИдентификатору("Пивденный_XML");
	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра <> Неопределено Тогда
		ЮТест.ОжидаетЧто(СтрокаРеестра.Вариант, "Вариант строки").Равно("");
	КонецЕсли;

КонецПроцедуры

// ОТП в XML - не наш формат (D30, антипаттерн задачи): строки реестра для него нет. Строка с этим модулем формата одна.
Процедура Реестр_СтрокиДляОТПВXMLНет() Экспорт

	Идентификаторы = Новый Массив;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат = ФорматМодуля() Или СтрНайти(НРег(СтрокаРеестра.Идентификатор), "xml") > 0 Тогда
			Идентификаторы.Добавить(СтрокаРеестра.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрСоединить(Идентификаторы, ","), "Строки реестра с модулем формата XML или «xml» в идентификаторе").Равно("Пивденный_XML");

КонецПроцедуры

Процедура Описание_КодировкаИдентификаторыОстатки() Экспорт

	Описание = Продукт(ФорматМодуля() + ".ОписаниеЧитателя");

	ЮТест.ОжидаетЧто(Описание.Кодировка, "Кодировка образцов (декларация XML)").Равно("windows-1251");
	ЮТест.ОжидаетЧто(Описание.ДаетИдентификаторыОпераций, "Старая обработка DATAVERSION не читала").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Описание.ДаетОстатки, "В файле остатков нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Описание.РасширенияФайлов, ","), "Расширения файлов").Равно("xml");

КонецПроцедуры

Процедура Описание_ПроходитПроверкуКонтракта() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Продукт(ФорматМодуля() + ".ОписаниеЧитателя"));
	Ошибки = Продукт("СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, Символы.ПС), "Ошибки описания читателя").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбразецПротивЭталона

// Конверт на образце (все 68 записей, два наших счета - прямой вызов Прочитать, фильтра счетов нет) равен эталону
// поле за полем. Сверяется конверт целиком: период, счета (номер, число операций, порядок), ЗаписейИсточника
// (независимый разбор контейнера), диагностика (пуста на образце). ДатаДокумента пуста во всех строках.
Процедура Образец_КонвертРавенЭталонуЦеликом() Экспорт

	Описание = "XMLПивденный";
	Эталон = РазобратьЭталон("XMLПивденный");
	Выписка = ПрочитатьМодулемФормата(Макет("СМП_ТестВыпискаXMLПивденный"));
	Результат = Новый Структура("Операции, Диагностика, Выписка", Выписка.Операции, Выписка.Диагностика, Выписка);

	ЮТест.ОжидаетЧто(Эталон.Операции.Количество(), "Эталон не пуст").НеРавно(0);
	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Число операций").Равно(Эталон.Операции.Количество());
	ЮТест.ОжидаетЧто(Выписка.Диагностика.Количество(), "Диагностика пуста (в эталоне " + Эталон.Диагностика.Количество() + ")")
		.Равно(Эталон.Диагностика.Количество());
	ЮТест.ОжидаетЧто(Выписка.ЧтениеПолное, "Файл прочитан полностью").ЭтоИстина();

	Для Индекс = 0 По Мин(Выписка.Операции.Количество(), Эталон.Операции.Количество()) - 1 Цикл
		СверитьОперацию(Описание, Выписка.Операции[Индекс], Эталон.Операции[Индекс]);
	КонецЦикла;

	СверитьКонверт(Описание, Результат, Эталон, "XMLПивденный");

	СДатой = 0;
	Для Каждого Операция Из Выписка.Операции Цикл
		Если Операция.ДатаДокумента <> Дата(1, 1, 1) Тогда
			СДатой = СДатой + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СДатой, "Строк с непустой ДатаДокумента (решение D17 - пуста во всех)").Равно(0);

КонецПроцедуры

Процедура Образец_СырыеДанныеДословно() Экспорт

	Выписка = ПрочитатьМодулемФормата(Макет("СМП_ТестВыпискаXMLПивденный"));
	Записи = ЗаписиОбразца("XMLПивденный");

	ЮТест.ОжидаетЧто(Выписка.Операции.Количество() > 0, "Операции прочитаны").ЭтоИстина();
	Для Каждого Операция Из Выписка.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.СырыеДанные, "Запись " + Операция.ПорядковыйНомер + ", поле СырыеДанные: ожидалась запись файла")
			.Равно(Записи[Операция.ПорядковыйНомер - 1].Сырые);
	КонецЦикла;

КонецПроцедуры

// DATAVERSION (в образце у всех строк свой) в ИдентификаторОперации не кладется: старая обработка его не читала.
Процедура Образец_ИдентификаторОперацииПуст() Экспорт

	Выписка = ПрочитатьМодулемФормата(Макет("СМП_ТестВыпискаXMLПивденный"));
	Записи = ЗаписиОбразца("XMLПивденный");

	ЕстьПоле = 0;
	Для Каждого Запись Из Записи Цикл
		Если Не ПустаяСтрока(Запись.Поля["DATAVERSION"]) Тогда
			ЕстьПоле = ЕстьПоле + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьПоле, "Контроль: в образце DATAVERSION заполнен во всех строках").Равно(Записи.Количество());
	Для Каждого Операция Из Выписка.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.ИдентификаторОперации, "Запись " + Операция.ПорядковыйНомер + ": DATAVERSION не читается").Равно("");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Выписка.Операции.Количество() > 0, "Операции прочитаны").ЭтоИстина();

КонецПроцедуры

// Два наших счета в файле (R6). Чтение с первым счетом: в Операции его операции, второй счет - одно «Предупреждение»
// платформы с числом строк (отступ 3), читатель сам ничего не фильтрует. Наш счет строки - атрибут IBAN.
Процедура Образец_ДваСчетаЧерезРеестрСчетПервый() Экспорт

	Эталон = РазобратьЭталон("XMLПивденный");
	ПроверитьЧтениеСоСчетом(Эталон, 0, 1);

КонецПроцедуры

Процедура Образец_ДваСчетаЧерезРеестрСчетВторой() Экспорт

	Эталон = РазобратьЭталон("XMLПивденный");
	ПроверитьЧтениеСоСчетом(Эталон, 1, 0);

КонецПроцедуры

Процедура ПроверитьЧтениеСоСчетом(Эталон, ИндексНашего, ИндексЧужого)

	Наш = Эталон.Счета[ИндексНашего];
	Чужой = Эталон.Счета[ИндексЧужого];
	Результат = ПрочитатьФайл("Пивденный_XML", Макет("СМП_ТестВыпискаXMLПивденный"), НомераИз(Наш.НомерСчета));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл принят, счет " + (ИндексНашего + 1)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нашего счета " + (ИндексНашего + 1)).Равно(Наш.Количество);
	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.НомерСчета, "Операция " + Операция.ПорядковыйНомер + ": НомерСчета - IBAN строки").Равно(Наш.НомерСчета);
	КонецЦикла;
	Предупреждения = ТекстыПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о втором счете").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет второй счет").Содержит(Чужой.НомерСчета);
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет число строк").Содержит(Формат(Чужой.Количество, "ЧГ="));
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет: чужой счет не потеря данных").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет").ЭтоЛожь();

	// Операции счета равны эталонным операциям того же ПорядковогоНомера.
	ПоНомеру = Новый Соответствие;
	Для Каждого Ожидаемая Из Эталон.Операции Цикл
		ПоНомеру.Вставить(Ожидаемая.ПорядковыйНомер, Ожидаемая);
	КонецЦикла;
	Для Каждого Операция Из Результат.Операции Цикл
		Ожидаемая = ПоНомеру[Операция.ПорядковыйНомер];
		ЮТест.ОжидаетЧто(Ожидаемая <> Неопределено, "Запись " + Операция.ПорядковыйНомер + " есть в эталоне").ЭтоИстина();
		Если Ожидаемая <> Неопределено Тогда
			СверитьОперацию("XMLПивденный (через реестр)", Операция, Ожидаемая);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// BOOKEDDATE во всех строках образца соответствует шаблону ррррммддTчч:мм:сс (решение планировщика: иначе «Ошибка»), и
// проверка шаблона вне продукта умеет падать: на образце ОТП XML (BOOKEDDATE - только дата) она не проходит ни в одной строке.
Процедура Образец_ВремяВBookedDateВоВсехСтрокахОбразца() Экспорт

	Записи = ЗаписиОбразца("XMLПивденный");
	БезВремени = 0;
	Для Каждого Запись Из Записи Цикл
		Если Не ВремяПоШаблону(Запись.Поля["BOOKEDDATE"]) Тогда
			БезВремени = БезВремени + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(БезВремени, "Строк образца Южного с BOOKEDDATE не по шаблону (из " + Записи.Количество() + ")").Равно(0);

	ЗаписиОтп = ЗаписиОбразца("XMLОТПДоба");
	ЮТест.ОжидаетЧто(ЗаписиОтп.Количество() > 0, "Контроль: образец ОТП XML прочитан").ЭтоИстина();
	ПоШаблону = 0;
	Для Каждого Запись Из ЗаписиОтп Цикл
		Если ВремяПоШаблону(Запись.Поля["BOOKEDDATE"]) Тогда
			ПоШаблону = ПоШаблону + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ПоШаблону, "Контроль: строк ОТП XML с BOOKEDDATE по шаблону (проверка умеет отвергать)").Равно(0);

КонецПроцедуры

// Контроль: на образце эталонная диагностика пуста, и сверка диагностики там вакуумна. Здесь она выполняется на
// синтетическом файле с нераспознанной суммой против «эталонной» диагностики, верной и испорченной.
Процедура Образец_СверкаДиагностикиУмеетПадать() Экспорт

	Результат = ПотерянаВторая(Новый Структура("SUMMA", "1.2.3"));

	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "2", "1.2.3"))).Количество(),
		"Верная эталонная диагностика: расхождений нет").Равно(0);
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Предупреждение", "2", "1.2.3"))).Количество() > 0,
		"Иной уровень пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "1.2.3"))).Количество() > 0,
		"Иной порядковый номер пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "2", "XYZ"))).Количество() > 0,
		"Иное сырое значение пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, Новый Массив).Количество() > 0,
		"Пустая эталонная диагностика против непустой пойман").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПоляКлюча

// Поля составного ключа D17 равны тому, что давала старая обработка: НомерДокумента = DOCUMENTNO, КонтрагентНомерСчета =
// CORRIBAN (в обе стороны направления), Сумма = SUMMA / 100, ДатаОперации = DOCUMENTDATE + Сред(BOOKEDDATE, 10, 8) - то
// самое значение, которое старая обработка клала и в Дата, и в ДатаДок; ДатаДокумента пуста (день ДатаДок = день
// ДатаОперации). Ожидание считается из сырых атрибутов контейнера, а не продуктом. Прямой вызов: все 68 записей.
Процедура Ключ_ПоляКакВСтаройОбработкеНаОбразце() Экспорт

	Записи = ЗаписиОбразца("XMLПивденный");
	Выписка = ПрочитатьМодулемФормата(Макет("СМП_ТестВыпискаXMLПивденный"));

	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Число операций").Равно(Записи.Количество());
	Для Индекс = 0 По Мин(Выписка.Операции.Количество(), Записи.Количество()) - 1 Цикл
		Поля = Записи[Индекс].Поля;
		Операция = Выписка.Операции[Индекс];
		Сообщение = "Запись " + (Индекс + 1) + ", поле ";
		ЮТест.ОжидаетЧто(Операция.НомерДокумента, Сообщение + "НомерДокумента (DOCUMENTNO)").Равно(Поля["DOCUMENTNO"]);
		ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, Сообщение + "КонтрагентНомерСчета (CORRIBAN)").Равно(ЗначениеАтрибута(Поля, "CORRIBAN"));
		ЮТест.ОжидаетЧто(Операция.Сумма, Сообщение + "Сумма (SUMMA / 100)").Равно(Число(Поля["SUMMA"]) / 100);
		ЮТест.ОжидаетЧто(ТекстДаты(Операция.ДатаОперации), Сообщение + "ДатаОперации (DOCUMENTDATE + время BOOKEDDATE)")
			.Равно(ТекстДаты(ОжидаемаяДата(Поля)));
		ЮТест.ОжидаетЧто(Операция.ДатаДокумента, Сообщение + "ДатаДокумента (пуста, день операции)").Равно(Дата(1, 1, 1));
		ЮТест.ОжидаетЧто(Операция.НомерСчета, Сообщение + "НомерСчета (IBAN)").Равно(Поля["IBAN"]);
	КонецЦикла;

КонецПроцедуры

// День BOOKEDDATE может отличаться от DOCUMENTDATE (в образце такая строка есть, в реальных файлах - 4 из 113 по оракулу):
// воспроизводится день DOCUMENTDATE, время - из BOOKEDDATE.
Процедура Ключ_ДеньBookedDateИнойВоспроизводитсяDocumentDate() Экспорт

	Записи = ЗаписиОбразца("XMLПивденный");
	Выписка = ПрочитатьМодулемФормата(Макет("СМП_ТестВыпискаXMLПивденный"));

	Иных = 0;
	Для Индекс = 0 По Мин(Выписка.Операции.Количество(), Записи.Количество()) - 1 Цикл
		Поля = Записи[Индекс].Поля;
		Если Лев(Поля["BOOKEDDATE"], 8) = Поля["DOCUMENTDATE"] Тогда
			Продолжить;
		КонецЕсли;
		Иных = Иных + 1;
		Момент = Выписка.Операции[Индекс].ДатаОперации;
		ЮТест.ОжидаетЧто(Формат(Момент, "ДФ=yyyyMMdd"), "Запись " + (Индекс + 1) + ": день - DOCUMENTDATE").Равно(Поля["DOCUMENTDATE"]);
		ЮТест.ОжидаетЧто(Формат(Момент, "ДФ=HH:mm:ss"), "Запись " + (Индекс + 1) + ": время - из BOOKEDDATE").Равно(Сред(Поля["BOOKEDDATE"], 10, 8));
	КонецЦикла;
	ЮТест.ОжидаетЧто(Иных, "Контроль: строк образца с днем BOOKEDDATE не равным DOCUMENTDATE (измерено: 1)").Равно(1);

КонецПроцедуры

// Номер документа - как в файле, ведущие нули сохраняются, число из строки никто не делает; старая обработка номер не
// обрезала (в образце крайних пробелов нет).
Процедура Ключ_НомерДокументаКакЕсть() Экспорт

	Результат = Читать(ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура("DOCUMENTNO", "007")))));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].НомерДокумента, "Ведущие нули сохранены").Равно("007");
	КонецЕсли;

КонецПроцедуры

// ИЗВЕСТНАЯ ОСОБЕННОСТЬ: строка без CORRIBAN (есть лишь CORRACCOUNTNO) - КонтрагентНомерСчета пуст, CORRACCOUNTNO не
// читается (старая обработка: Формат(Неопределено, "ЧГ=0") -> пусто). Остальные поля строки читаются.
Процедура Ключ_БезCorribanКонтрагентНомерСчетаПуст() Экспорт

	Результат = Читать(ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура("CORRIBAN, CORRACCOUNTNO, CORRBANKID", Неопределено, "OLD-ACC-77", "300002")))));

