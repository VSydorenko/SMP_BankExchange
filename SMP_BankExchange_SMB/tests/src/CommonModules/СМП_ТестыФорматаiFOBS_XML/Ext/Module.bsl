	Записи.Добавить(ЗаписьСПодменой(1, Новый Структура("DOCUMENTDATE, BOOKEDDATE", "20240605", "20240605T09:00:00000")));
	Записи.Добавить(ЗаписьСПодменой(2, Новый Структура("DOCUMENTDATE, BOOKEDDATE", "20240601", "20240601T08:00:00000")));
	Записи.Добавить(ЗаписьСПодменой(3, Новый Структура("DOCUMENTDATE, BOOKEDDATE", "20240603", "20240603T08:00:00000")));
	Результат = Читать(ФайлXML(Записи));

	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "НачалоПериода - начало суток минимальной даты").Равно(Дата(2024, 6, 1, 0, 0, 0));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "КонецПериода - конец суток максимальной даты").Равно(Дата(2024, 6, 5, 23, 59, 59));
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Без потерь чтение полное").ЭтоИстина();

	Потеря = ПотерянаВторая(Новый Структура("DOCUMENTDATE", "2024O101"));
	ЮТест.ОжидаетЧто(Потеря.Выписка.ЧтениеПолное, "С потерей строки чтение не полное").ЭтоЛожь();

КонецПроцедуры

// Файл без строк ROW: читать нечего - «Ошибка» ко всей выписке (прямой вызов Прочитать; через реестр такой файл не
// узнается, ФайлПохожНаФормат смотрит на первый ROW).
Процедура Файл_БезСтрокROWДаетОшибку() Экспорт

	Файл = ФайлXML(Новый Массив);
	Выписка = ПрочитатьМодулемФормата(Файл);

	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Прямо: операций нет").Равно(0);
	ЮТест.ОжидаетЧто(Выписка.ЧтениеПолное, "Прямо: чтение не полное").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Выписка.Диагностика.Количество(), "Прямо: одно сообщение").Равно(1);
	Если Выписка.Диагностика.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Выписка.Диагностика[0].Уровень, "Прямо: уровень").Равно("Ошибка");
		ЮТест.ОжидаетЧто(Выписка.Диагностика[0].ПорядковыйНомер, "Прямо: ко всей выписке").Равно(0);
	КонецЕсли;
	Результат = Читать(Файл);
	ЮТест.ОжидаетЧто(Результат.Принята, "Через реестр файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Через реестр операций нет").Равно(0);

КонецПроцедуры

// Начало файла верное (формат узнан), хвост оборван: исключение контейнера наружу не выходит, это «Ошибка».
Процедура Файл_ОбрезанныйДаетОшибкуБезИсключения() Экспорт

	Полный = Макет("СМП_ТестВыпискаXMLПивденный");
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Полный);
	Обрезанный = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.ПолучитьСрез(0, Цел(Буфер.Размер * 6 / 10)));

	ЮТест.ОжидаетЧто(ФайлПохож(Обрезанный), "Контроль: начало файла узнано").ЭтоИстина();
	Результат = ПрочитатьФайл("Пивденный_XML", Обрезанный, НомераИз(РазобратьЭталон("XMLПивденный").НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "Оборванный файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество() > 0, "Есть сообщение об ошибке").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Чтение не полное").ЭтоЛожь();

КонецПроцедуры

// Чтение не создает файлов в каталоге временных файлов (контейнер работает из потока). Служебные файлы платформы
// v8_<hex>.tmp не считаются.
Процедура Временные_ЧтениеНеСоздаетФайлов() Экспорт

	До = ВсеВременные();
	Образец = ПрочитатьОбразец("XMLПивденный");
	Синтетика = Читать(ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура))));
	Отказ = Читать(ПолучитьДвоичныеДанныеИзСтроки("не XML", "windows-1251", Ложь));
	После = ВсеВременные();

	ЮТест.ОжидаетЧто(Образец.Операции.Количество() > 0 И Синтетика.Операции.Количество() = 1, "Чтение удалось (проверка не вакуумна)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Отказ.Принята, "Не XML отвергнут").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Новые(До, После), "Новых временных файлов после чтения нет").Равно("");
	ЮТест.ОжидаетЧто(ВсеВременные(), "Каталог временных файлов прежний").Равно(До);

КонецПроцедуры

// Контроль: сверка каталога временных файлов видит новый файл.
Процедура Временные_СверкаКаталогаУмеетПадать() Экспорт

	До = ВсеВременные();
	Имя = ПолучитьИмяВременногоФайла("txt");
	Запись = Новый ТекстовыйДокумент;
	Запись.УстановитьТекст("x");
	Запись.Записать(Имя);
	Во = ВсеВременные();
	УдалитьФайлы(Имя);
	После = ВсеВременные();

	ЮТест.ОжидаетЧто(Во, "Список видит новый файл").НеРавно(До);
	СозданныйФайл = Новый Файл(Имя);
	ИмяБезКаталога = СозданныйФайл.Имя;
	ЮТест.ОжидаетЧто(Новые(До, Во), "Сверка новых файлов называет созданный файл").Содержит(ИмяБезКаталога);
	ЮТест.ОжидаетЧто(После, "После удаления список прежний").Равно(До);

КонецПроцедуры

#КонецОбласти

#Область ФайлПохожНаФормат

Процедура ФайлПохож_ОбразецДа() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLПивденный")), "Образец Южного узнан").ЭтоИстина();

КонецПроцедуры

// ОТП в XML (та же структура ROWDATA/ROW, тот же набор атрибутов) не наш формат (D30): отличается BOOKEDDATE - у ОТП только
// дата, у Южного дата и время (решение планировщика). Проверка умеет падать: ее пара - образец Южного (Истина).
Процедура ФайлПохож_ОтпВXmlНет() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLПивденный")), "Контроль: образец Южного узнан").ЭтоИстина();
	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLОТПДоба")), "Образец ОТП XML не узнан").ЭтоЛожь();

КонецПроцедуры

Процедура ФайлПохож_ОбразцыДругихФорматовНет(Описание, ИдОбразца) Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыписка" + ИдОбразца)), "Образец другого формата не узнан: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Колизия форматов: образец Южного не узнает ни один из ранее сделанных модулей форматов.
Процедура ФайлПохож_ДругиеМодулиФорматовОбразецЮжногоНеУзнают(Описание, Модуль) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыпискаXMLПивденный"));
	Ответ = СМП_ТестыВызовПродукта.Вызвать(Модуль + ".ФайлПохожНаФормат", Параметры);

	ЮТест.ОжидаетЧто(Ответ, "Образец Южного не узнан модулем: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Проверка дешевая: достаточно начала файла. Файл обрезан после второй строки ROW (XML не закрыт, корень не завершен), а
// формат узнан по первой строке.
Процедура ФайлПохож_ТолькоНачалоФайла() Экспорт

	Полный = Макет("СМП_ТестВыпискаXMLПивденный");
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Полный, "windows-1251");
	Позиция = СтрНайти(Текст, "/>", , , 2);
	ЮТест.ОжидаетЧто(Позиция > 0, "Контроль: в образце есть вторая строка ROW").ЭтоИстина();
	Голова = ПолучитьДвоичныеДанныеИзСтроки(Лев(Текст, Позиция + 1), "windows-1251", Ложь);

	ЮТест.ОжидаетЧто(ФайлПохож(Голова), "Только начало файла: файл узнан").ЭтоИстина();
	ЮТест.ОжидаетЧто(Голова.Размер() < Полный.Размер(), "Контроль: это именно начало, а не весь файл").ЭтоИстина();

КонецПроцедуры

// Режимы: «» - как есть, «-ИМЯ» - атрибут убран, «ИМЯ=значение» - атрибут подменен, а также «пусто», «текст», «корень»,
// «безROW».
Процедура ФайлПохож_НеОбразцовыйXMLИМусор(Описание, Вид) Экспорт

	Если Вид = "пусто" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
	ИначеЕсли Вид = "текст" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("это совсем не выписка, а просто текст достаточной длины", "windows-1251", Ложь);
	ИначеЕсли Вид = "корень" Тогда
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура))), "windows-1251");
		Файл = ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(СтрЗаменить(Текст, "ROWDATA", "OTHERDATA"), "<ROW ", "<ROW "), "windows-1251", Ложь);
	ИначеЕсли Вид = "безROW" Тогда
		Файл = ФайлXML(Новый Массив);
	ИначеЕсли Лев(Вид, 1) = "-" Тогда
		Файл = ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура(Сред(Вид, 2), Неопределено))));
	Иначе
		Позиция = СтрНайти(Вид, "=");
		Файл = ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура(Лев(Вид, Позиция - 1), Сред(Вид, Позиция + 1)))));
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "Не выписка формата: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Хвост BOOKEDDATE после секунд не проверяется (решение планировщика): время чч:мм:сс на позициях 10-17 достаточно.
Процедура ФайлПохож_БезХвостаПослеСекундУзнан() Экспорт

	Файл = ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура("BOOKEDDATE", "20240604T15:54:06"))));
	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "BOOKEDDATE без хвоста после секунд").ЭтоИстина();
	Файл = ФайлXML(МассивИз(ЗаписьСПодменой(1, Новый Структура("BOOKEDDATE", "20240604T15:54:06ABC"))));
	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "BOOKEDDATE с любым хвостом").ЭтоИстина();

КонецПроцедуры

Процедура ФайлПохож_СтрокиРеестраДляФайлаУзнаютТолькоСвою(Описание, ИдОбразца, Ожидание) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Узнанные = Продукт("СтрокиРеестраДляФайла", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Узнанные, ","), "Какие строки реестра узнают файл: " + Описание).Равно(Ожидание);

КонецПроцедуры

// Контроль: проверка формата умеет отвечать Ложь на файл, который она обязана отвергнуть, и Истина - на допустимый.
Процедура ФайлПохож_ПроверкаУмеетПадать() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLПивденный")), "Допустимый вход: Истина").ЭтоИстина();
	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаDBFОщад16")), "Недопустимый вход (DBF Ощада): Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПодсказкиРеестра

// Файл Южного, прочитанный строкой другого формата, отвергается, а ПохожиеСтрокиРеестра называет строку Южного.
Процедура ПохожиеСтрокиРеестра_ФайлЮжногоЧерезДругуюСтрокуНазываетЮжный(Описание, ИдентификаторСтроки) Экспорт

	Эталон = РазобратьЭталон("XMLПивденный");
	Результат = ПрочитатьФайл(ИдентификаторСтроки, Макет("СМП_ТестВыпискаXMLПивденный"), НомераИз(Эталон.НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл другого формата не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "ПохожиеСтрокиРеестра называет строку Южного: " + Описание).Равно("Пивденный_XML");

КонецПроцедуры

// ОТП в XML - не наш формат (D30): строкой Пивденный_XML он отвергается, ни одна строка реестра его не узнает.
Процедура ОтпВXml_СтрокойЮжногоОтвергаетсяБезПодсказок() Экспорт

	Результат = ПрочитатьФайл("Пивденный_XML", Макет("СМП_ТестВыпискаXMLОТПДоба"), НомераИз(РазобратьЭталон("XMLПивденный").НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "ОТП XML не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество() > 0, "Есть сообщение об ошибке").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "Какие строки реестра узнают файл").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ФорматМодуля()

	Возврат "СМП_ЧитательВыпискиiFOBS_XML";

КонецФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Если СтрНайти(ИмяМетода, ".") = 0 Тогда
		Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(ИдентификаторСтроки);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьФайл", Параметры);

КонецФункции

Функция НомераИз(Номер)

	Номера = Новый Массив;
	Номера.Добавить(Номер);
	Возврат Номера;

КонецФункции

Функция МассивИз(Элемент)

	Массив = Новый Массив;
	Массив.Добавить(Элемент);
	Возврат Массив;

КонецФункции

Функция ЗаписьЭталонаДиагностики(Уровень, ПорядковыйНомер, СырьеЗначение)

	Возврат Новый Структура("Уровень, ПорядковыйНомер, Что, СырьеЗначение", Уровень, ПорядковыйНомер, "amount", СырьеЗначение);

КонецФункции

// Читает образец через реестр, номер нашего счета - из эталона.
Функция ПрочитатьОбразец(ИдОбразца)

	Возврат ПрочитатьФайл("Пивденный_XML", Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз(РазобратьЭталон(ИдОбразца).НомерСчетаЧтения));

КонецФункции

Функция Макет(Имя)

	Возврат Обработки.СМП_ТестыМакеты.ПолучитьМакет(Имя);

КонецФункции

Функция ФайлПохож(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат Продукт(ФорматМодуля() + ".ФайлПохожНаФормат", Параметры);

КонецФункции

Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ДиагностикаПоУровню(Результат, Уровень)

	Сообщения = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Сообщения.Добавить(Новый Структура("ПорядковыйНомер, Текст", Сообщение.ПорядковыйНомер, Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция СтрокаРеестраПоИдентификатору(Идентификатор)

	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Потерянная строка: в Операции ее нет (первая запись прочитана), одна «Ошибка» на запись файла с сырым значением,
// признак невалидных строк, чтение не полное. Плохое значение кладется во вторую запись: первая остается образцом
// прочитанной строки.
Процедура ПроверитьПотерянуюСтроку(Результат, НомерЗаписи, Сырье, Описание)

	ЮТест.ОжидаетЧто(Результат.Принята, "Конверт принят, отброшена одна запись: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Записи в Операции нет, первая прочитана: " + Описание).Равно(1);
	Ошибки = ДиагностикаПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка по записи: " + Описание).Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0].ПорядковыйНомер, "Ошибка привязана к записи файла " + НомерЗаписи + ": " + Описание).Равно(НомерЗаписи);
		Если Не ПустаяСтрока(Сырье) Тогда
			ЮТест.ОжидаетЧто(Ошибки[0].Текст, "Текст ошибки содержит сырое значение: " + Описание).Содержит(Сырье);
		КонецЕсли;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Признак невалидных строк: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Потеря записи: чтение не полное: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Служебные файлы самой платформы v8_<hex>_d<n>.tmp не считаются: платформа создает их сама и сама убирает при
// завершении сеанса. Файлы продукта считаются.
Функция Новые(До, После)

	Были = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(До, Символы.ПС) Цикл
		Были[Имя] = Истина;
	КонецЦикла;
	Новые = Новый Массив;
	Для Каждого Имя Из СтрРазделить(После, Символы.ПС) Цикл
		Если Были[Имя] = Неопределено И Не СлужебныйФайлПлатформы(Имя) Тогда
			Новые.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Новые, Символы.ПС);

КонецФункции

Функция СлужебныйФайлПлатформы(ПолноеИмя)

	Файл = Новый Файл(ПолноеИмя);
	Возврат Лев(Файл.Имя, 3) = "v8_" И Файл.Расширение = ".tmp";

КонецФункции

// Все элементы каталога временных файлов одной строкой, без служебных файлов платформы.
Функция ВсеВременные()

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из НайтиФайлы(КаталогВременныхФайлов(), "*") Цикл
		Если Не СлужебныйФайлПлатформы(Элемент.ПолноеИмя) Тогда
			Список.Добавить(Элемент.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС);

КонецФункции

#КонецОбласти

#Область Синтетика

// Записи образца контейнером: независимый разбор (атрибуты как в файле, значения как есть).
Функция ЗаписиОбразца(ИдОбразца)

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Параметры.Добавить("ROW");
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ЗаписиXML", Параметры);

КонецФункции

Функция НашСчетСинтетики()

	Возврат "UA" + ПовторитьСтроку("1", 27);

КонецФункции

Функция ПовторитьСтроку(Символ, Количество)

	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл
		Части.Добавить(Символ);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// Значение атрибута или пустая строка, если атрибута нет.
Функция ЗначениеАтрибута(Поля, Имя)

	Значение = Поля[Имя];
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Подмена одного атрибута; сырье «<нет>» - атрибут убран из строки.
Функция ПодменаАтрибута(Имя, Сырье)

	Подмена = Новый Структура;
	Подмена.Вставить(Имя, ?(Сырье = "<нет>", Неопределено, Сырье));
	Возврат Подмена;

КонецФункции

// Время BOOKEDDATE по шаблону ррррммддTчч:мм:сс (хвост после секунд не проверяется): независимая от продукта проверка.
Функция ВремяПоШаблону(Текст)

	Если СтрДлина(Текст) < 17 Или Сред(Текст, 9, 1) <> "T" Или Сред(Текст, 12, 1) <> ":" Или Сред(Текст, 15, 1) <> ":" Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = Лев(Текст, 8) + Сред(Текст, 10, 2) + Сред(Текст, 13, 2) + Сред(Текст, 16, 2);
	Возврат ТолькоЦифры(Цифры);

КонецФункции

// DOCUMENTDATE + время из BOOKEDDATE (Сред(BOOKEDDATE, 10, 8)) - то, что собирала старая обработка.
Функция ОжидаемаяДата(Поля)

	ДатаДок = Поля["DOCUMENTDATE"];
	Проведено = Поля["BOOKEDDATE"];
	Возврат Дата(Число(Лев(ДатаДок, 4)), Число(Сред(ДатаДок, 5, 2)), Число(Сред(ДатаДок, 7, 2)),
		Число(Сред(Проведено, 10, 2)), Число(Сред(Проведено, 13, 2)), Число(Сред(Проведено, 16, 2)));

КонецФункции

// Строка файла по умолчанию (значения вымышленные, порядок атрибутов как в файле Южного) с подменой атрибутов;
// значение Неопределено в подмене убирает атрибут. Номер - только чтобы значения строк различались.
Функция ЗаписьСПодменой(Номер, Подмена)

	Запись = Новый Структура;
	Запись.Вставить("ARCDATE", "20240301");
	Запись.Вставить("DOCUMENTNO", "DOC" + Номер);
	Запись.Вставить("ACCOUNTNO", "26000111222");
	Запись.Вставить("IBAN", НашСчетСинтетики());
	Запись.Вставить("CURRENCYID", "980");
	Запись.Вставить("BANKID", "300001");
	Запись.Вставить("CORRBANKID", "300002");
	Запись.Вставить("CORRACCOUNTNO", "26000333444");
	Запись.Вставить("CORRIBAN", "UA" + ПовторитьСтроку("2", 27));
	Запись.Вставить("OPERATIONID", "0");
	Запись.Вставить("PLATPURPOSE", "оплата по счету");
	Запись.Вставить("DOCUMENTDATE", "20240301");
	Запись.Вставить("CORRBANKNAME", "Банк контрагента");
	Запись.Вставить("CORRIDENTIFYCODE", "22222222");
	Запись.Вставить("CORRCONTRAGENTSNAME", "Контрагент");
	Запись.Вставить("BANKNAME", "Наш банк");
	Запись.Вставить("IDENTIFYCODE", "11111111");
	Запись.Вставить("BOOKEDDATE", "20240301T10:11:12123");
	Запись.Вставить("DATAVERSION", "10000" + Номер);
	Запись.Вставить("SUMMA", "10050");
	Для Каждого Элемент Из Подмена Цикл
		Если Элемент.Значение = Неопределено Тогда
			Запись.Удалить(Элемент.Ключ);
		Иначе
			Запись.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Запись;

КонецФункции

Функция ЭкранироватьАтрибут(Значение)

	Результат = СтрЗаменить(Значение, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, Символы.ПС, "&#10;");
	Результат = СтрЗаменить(Результат, Символы.ВК, "&#13;");
	Результат = СтрЗаменить(Результат, Символы.Таб, "&#9;");
	Возврат Результат;

КонецФункции

// Файл XML ROWDATA/ROW из строк (Структуры атрибутов); кодировка - в декларации и в байтах.
Функция ФайлXML(Записи, Кодировка = "windows-1251")

	Части = Новый Массив;
	Части.Добавить("<?xml version=""1.0"" encoding=""" + Кодировка + """?>" + Символы.ВК + Символы.ПС + "<ROWDATA>");
	Для Каждого Запись Из Записи Цикл
		Элемент = "<ROW";
		Для Каждого Атрибут Из Запись Цикл
			Элемент = Элемент + " " + Атрибут.Ключ + "=""" + ЭкранироватьАтрибут(Атрибут.Значение) + """";
		КонецЦикла;
		Части.Добавить(Элемент + "/>");
	КонецЦикла;
	Части.Добавить("</ROWDATA>");
	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Части, ""), Кодировка, Ложь);

КонецФункции

// Прямой вызов Прочитать модуля формата в обход реестра и ФайлПохожНаФормат; возвращает заполненный конверт.
// Прочитать - процедура: вызов через СМП_ТестыВызовПродукта.ВызватьПроцедуру; Выписка заполняется на месте.
Функция ПрочитатьМодулемФормата(Данные)

	Выписка = Продукт("СМП_ВыпискаБанка.НоваяВыписка");
	Параметры = Продукт("СМП_ВыпискаБанка.НовыеПараметрыЧтения");
