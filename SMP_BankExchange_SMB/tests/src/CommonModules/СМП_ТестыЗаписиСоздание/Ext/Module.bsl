// Тесты записи документов банка: создание общих объектов пакета - контрагента, банковского счета, договора (задача 4 плана 04, D6).
// Зона: действие плана "Создать" над контрагентом, счетом и договором; группировка без дублей в пакете; отказ создания; сторож.
// Каркас записи и "уже загружен" - СМП_ТестыЗаписиКаркас (его помощники экспортные и используются здесь), заполнение по виду
// операции - задача 5. Правила - docs/architecture/testing.md.
//
// План строится вручную (без Распознать): записи нужен план с заданными решениями. Продукт вызывается только через
// СМП_ТестыВызовПродукта (позднее связывание).
//
// Условия измерения (утверждает Условия_РежимБазыИзмерения): спутник СМП_ТестыВендораСоздание.Условия_РежимБазыИзмерения -
// основная организация базы НЕ равна организации плана (организации фикстуры), пользователь сеанса "Администратор", настройка
// "ОсновнойВидКонтрагента" пуста, группы доступа контрагентов используются, организация фикстуры - ФОП, не платник НДС.
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: условия и измерения");
	Набор.ДобавитьСерверныйТест("Условия_РежимБазыИзмерения").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Счет_БезБанка_ЗаписатьПринимает_Измерение").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Банк_КодыНеУникальны_Измерение").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Договор_ВендорскийПроходитПроверкуЗаполненияБезНомераИДаты_Измерение").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_ЗаполнитьСтруктурой_ЗначенияИзСтруктурыИДефолты_Измерение").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: контрагент");
	Набор.ДобавитьСерверныйТест("Контрагент_ЮрЛицо_ВосемьЦифр").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_ФОП_ДесятьЦифр").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_ФОП_ДубльИНН_РегистрДублейЗаписанВендором").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_ФОП_СозданныйПродуктом_РаспознаваниеПоКодуНеНаходит_Измерение").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_ДевятьЦифр_ДополненНулем").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Контрагент_БезПригодногоКода_ВидВендора").ВТранзакции()
		.СПараметрами("кода нет", "")
		.СПараметрами("код из пяти цифр", "12345");
	Набор.ДобавитьСерверныйТест("Контрагент_ГруппаДоступа").ВТранзакции()
		.СПараметрами("группа из контекста", Истина)
		.СПараметрами("группа не задана: по умолчанию вендора", Ложь);
	Набор.ДобавитьСерверныйТест("Контрагент_ОтношенияПоВидуОперации").ВТранзакции()
		.СПараметрами("поступление от покупателя", "ПоступлениеНаСчет", Истина, Ложь)
		.СПараметрами("расход поставщику", "РасходСоСчета", Ложь, Истина);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: договор");
	Набор.ДобавитьСерверныйТест("Договор_НовыйКонтрагент_ВендорскийПерестроенНаОрганизациюПлана").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Договор_НовыйКонтрагент_ДваВидаОперации_ДваДоговора").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Договор_НайденныйКонтрагент_СоздатьНовыйОдинНаКлюч").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Найден_НичегоНеСоздает").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: банковский счет");
	Набор.ДобавитьСерверныйТест("Счет_НайденныйКонтрагент_Создан").ВТранзакции()
		.СПараметрами("номер как есть", Ложь)
		.СПараметрами("номер с пробелами", Истина);
	Набор.ДобавитьСерверныйТест("Счет_НовыйКонтрагент_ВладелецСозданный").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Счет_МФОНетВБазе_НеСоздан_ДокументЗаписан").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Счет_IBANНеСоответствуетБанку_НеСоздан").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Счет_МФОСДублемБанка_НеСоздан_Предупреждение").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Счет_НеСоздан_ВидСОбязательнымСчетом_Непроведен").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: пакет и отказы");
	Набор.ДобавитьСерверныйТест("Пакет_ДвеОперацииНовогоКонтрагента_Один").ВТранзакции()
		.СПараметрами("ключ - код", "Код")
		.СПараметрами("без кода - ключ счет", "Счет")
		.СПараметрами("без кода и счета - ключ название", "Название");
	Набор.ДобавитьСерверныйТест("Пакет_РазныеКоды_РазныеКонтрагенты").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Пакет_ПервыйДокументНеЗаписан_ВторойСТемЖеКонтрагентом").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Пакет_ПовторнаяЗапись_НичегоНеСоздает").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Невозможно_ДокументБезКонтрагента_Непроведен_СоседПроведен").ВТранзакции();
	Набор.ДобавитьСерверныйТест("СозданныеОбъекты_ВидныСторожу").ВТранзакции();

	// Сторож остатков: БЕЗ транзакции, последним.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Создание: сторож остатков");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область УсловияИИзмерения

// Условия измерения - те же, что у измерения вендора (задача 2): от них зависят выводы тестов договора.
Процедура Условия_РежимБазыИзмерения() Экспорт

	СМП_ТестыВендораСоздание.Условия_РежимБазыИзмерения();

	ЮТест.ОжидаетЧто(ОсновнаяОрганизацияБазы(), "Условие: основная организация базы не равна организации плана")
		.НеРавно(СМП_ТестыДанныеУНФ.Организация());

КонецПроцедуры

// Измерение (условие: серверная база агента SMB, платформа 8.3.27): банковский счет без банка (так выглядит счет, созданный
// по МФО, которого нет в справочнике банков) не проходит ПроверитьЗаполнение, а Записать его ПРИНИМАЕТ без исключения - значит,
// отказ создания обеспечивает проверка заполнения, а не запись; продукт проверяет заполнение до записи.
Процедура Счет_БезБанка_ЗаписатьПринимает_Измерение() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);
	Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN();
	Счет.Наименование = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Счет_без_банка_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Счет.Банк), "Предусловие: банк счета не задан").ЭтоЛожь();

	ПолучитьСообщенияПользователю(Истина);
	ПроверкаПрошла = Счет.ПроверитьЗаполнение();
	ПолучитьСообщенияПользователю(Истина);

	ТекстОшибки = Неопределено;
	Попытка
		Счет.Записать();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// После исключения записи транзакция теста непригодна: восстановление, как в тесте исключения проведения.
		ОтменитьТранзакцию();
		НачатьТранзакцию();
	КонецПопытки;

	ЮТест.ОжидаетЧто(ПроверкаПрошла, "ПроверитьЗаполнение счета без банка").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ТекстОшибки, "Записать счета без банка не кидает исключения").Равно(Неопределено);

КонецПроцедуры

// Измерение (M-5 задачи 2; условие - серверная база агента SMB, справочник Банки как в базе на 2026-10-15). Код банка НЕ уникален:
// под кодом 305299 записано два банка ("ПАТ ПРИВАТБАНК" в Днепре и в Киеве). Оба не помечены на удаление и не группы; различаются
// наименованием, городом, адресом, родителем (киевский - в группе области), РучноеИзменение (0 и 2), корсчетом и использованием (на
// одном два счета, на другом нет). Признака актуальности, по которому банк выбирался бы, нет. Вендорские поиски (НайтиПоКоду,
// БанкиУНФ.СсылкаНаБанкИзСправочника) берут ПЕРВЫЙ найденный молча; ПолучитьТаблицуБанковПоРеквизитам("Код", МФО), которой пользуется
// форма банковского счета, отдает ОБА (форма при нескольких просит выбрать банк человека). Помеченных на удаление банков с
// шестизначным кодом в базе нет (поэтому вопрос "берет ли вендор помеченный банк" в этих условиях не возникает). Красный тест =
// условия базы изменились (дублей нет): смысл Счет_МФОСДублемБанка_НеСоздан_Предупреждение пересмотреть.
Процедура Банк_КодыНеУникальны_Измерение() Экспорт

	Код = КодБанкаСДублем();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Код), "В справочнике банков есть шестизначный код с дублем среди не помеченных и не групп").ЭтоЛожь();

	Таблица = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", Код);
	ЮТест.ОжидаетЧто(Таблица.Количество(), "Вендорская таблица банков по коду (поиск формы счета) отдает оба банка").Равно(2);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Реквизиты = РеквизитыСсылки(СтрокаТаблицы.Ссылка, "ПометкаУдаления, ЭтоГруппа");
		ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления Или Реквизиты.ЭтоГруппа, "Банк с дублирующим кодом не помечен и не группа").ЭтоЛожь();
	КонецЦикла;
	Первый = Таблица[0].Ссылка;
	ЮТест.ОжидаетЧто(Справочники.Банки.НайтиПоКоду(Код), "НайтиПоКоду берет первый из таблицы").Равно(Первый);
	ЮТест.ОжидаетЧто(БанкиУНФ.СсылкаНаБанкИзСправочника(Код), "СсылкаНаБанкИзСправочника берет первый из таблицы").Равно(Первый);
	Различия = РеквизитыСсылки(Таблица[0].Ссылка, "Наименование, Город");
	Другие = РеквизитыСсылки(Таблица[1].Ссылка, "Наименование, Город");
	ЮТест.ОжидаетЧто(Различия.Наименование <> Другие.Наименование И Различия.Город <> Другие.Город, "Банки различаются наименованием и городом").ЭтоИстина();

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.Банки КАК Б
		|ГДЕ Б.ПометкаУдаления И НЕ Б.ЭтоГруппа И Б.Код ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]""");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Количество, "Помеченных на удаление банков с шестизначным кодом в базе нет").Равно(0);

КонецПроцедуры

// Договор, созданный вендором при записи контрагента, проходит ПроверитьЗаполнение без номера и даты (продукт их не вигадує, D6),
// и после перестройки на организацию плана тоже (измерено до продукта: перестройка не добавляет обязательных реквизитов).
Процедура Договор_ВендорскийПроходитПроверкуЗаполненияБезНомераИДаты_Измерение() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент).ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Договор.НомерДоговора) И Не ЗначениеЗаполнено(Договор.ДатаДоговора),
		"Предусловие: у договора вендора нет номера и даты").ЭтоИстина();

	ПолучитьСообщенияПользователю(Истина);
	ЮТест.ОжидаетЧто(Договор.ПроверитьЗаполнение(), "ПроверитьЗаполнение договора вендора").ЭтоИстина();

	Договор.Организация = СМП_ТестыДанныеУНФ.Организация();
	Договор.Наименование = ШаблоныНаименований.НаименованиеДоговораПоУмолчанию(Договор);
	ПолучитьСообщенияПользователю(Истина);
	ЮТест.ОжидаетЧто(Договор.ПроверитьЗаполнение(), "ПроверитьЗаполнение договора вендора, перестроенного на организацию плана")
		.ЭтоИстина();

КонецПроцедуры

// Рецепт создания контрагента: Заполнить(Структура) берет из структуры значения реквизитов (обработчик заполнения вендора -
// ЗаполнитьЗначенияСвойств) и дозаполняет остальное по умолчанию; вендорские значения реквизитов для нового контрагента
// (ПолучитьЗначенияРеквизитовПоУмолчаниюДляНовогоКонтрагента) - четыре булевых признака учета расчетов.
Процедура Контрагент_ЗаполнитьСтруктурой_ЗначенияИзСтруктурыИДефолты_Измерение() Экспорт

	Имя = НовоеИмя();
	Данные = Новый Структура;
	Данные.Вставить("Наименование", Имя);
	Данные.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	Данные.Вставить("ИНН", "1234567890");
	Данные.Вставить("Покупатель", Истина);

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Заполнить(Данные);

	ЮТест.ОжидаетЧто(Контрагент.Наименование, "Наименование из структуры").Равно(Имя);
	ЮТест.ОжидаетЧто(Контрагент.ВидКонтрагента, "Вид из структуры").Равно(Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	ЮТест.ОжидаетЧто(Контрагент.ИНН, "ИНН из структуры").Равно("1234567890");
	ЮТест.ОжидаетЧто(Контрагент.Покупатель, "Признак покупателя из структуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(Контрагент.ВалютаРасчетовПоУмолчанию, "Остальное дозаполнено по умолчанию (валюта расчетов)")
		.Равно(Константы.НациональнаяВалюта.Получить());

	Умолчания = РасчетыРаботаСФормамиВызовСервера.ПолучитьЗначенияРеквизитовПоУмолчаниюДляНовогоКонтрагента();
	Для Каждого Ключ Из СтрРазделить("ВестиРасчетыПоДоговорам,ВестиРасчетыПоДокументам,ВестиРасчетыПоЗаказам,ВестиУчетОплатыПоСчетам", ",") Цикл
		ЮТест.ОжидаетЧто(Умолчания.Свойство(Ключ), "Вендорские значения по умолчанию для нового контрагента: ключ " + Ключ).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Контрагент

// "Создать" над контрагентом с 8-значным кодом (ЕДРПОУ): юрлицо, код в КодПоЕДРПОУ, ИНН пуст; наименование из операции. Запись
// без ОбменДанными.Загрузка: вендорский ПередЗаписью/ПриЗаписи отработали (договор по умолчанию создан - проверяет договор ниже и
// Контрагент_ФОП_ДубльИНН_РегистрДублейЗаписанВендором).
Процедура Контрагент_ЮрЛицо_ВосемьЦифр() Экспорт

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Имя = НовоеИмя();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, Имя, Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, "Результат строки").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СозданКонтрагент), "Создан контрагент").ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Строка.СозданКонтрагент, "Наименование, КодПоЕДРПОУ, ИНН, ВидКонтрагента, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.Наименование, "Наименование").Равно(Имя);
	ЮТест.ОжидаетЧто(Реквизиты.КодПоЕДРПОУ, "Код в КодПоЕДРПОУ").Равно(Код);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.ИНН), "ИНН пуст").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, "Вид - юридическое лицо").Равно(Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Не помечен на удаление").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ДоговорыКонтрагента(Строка.СозданКонтрагент).Количество(), "Вендор создал договор при записи контрагента (запись без Загрузка)")
		.Равно(1);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Строка.Документ).Контрагент, "Документ ссылается на созданного контрагента")
		.Равно(Строка.СозданКонтрагент);

КонецПроцедуры

// "Создать" над контрагентом с 10-значным кодом (РНОКПП): ФОП (вид вендор из кода не выводит - знахидка 3), код в ИНН,
// КодПоЕДРПОУ пуст.
Процедура Контрагент_ФОП_ДесятьЦифр() Экспорт

	Код = НовыйРНОКПП();
	Имя = НовоеИмя();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, Имя, Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, "Результат строки").Равно("Создан");
	Реквизиты = РеквизитыСсылки(Строка.СозданКонтрагент, "КодПоЕДРПОУ, ИНН, ВидКонтрагента");
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, "Вид - индивидуальный предприниматель")
		.Равно(Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	ЮТест.ОжидаетЧто(Реквизиты.ИНН, "Код в ИНН").Равно(Код);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.КодПоЕДРПОУ), "КодПоЕДРПОУ пуст").ЭтоИстина();

КонецПроцедуры

// Контрагент с таким ИНН уже есть, а план говорит "Создать" (распознавание его не нашло): вендор при записи регистрирует дубль для
// обоих - это возможно только если продукт пишет контрагента штатно, без ОбменДанными.Загрузка (иначе ПередЗаписью вендора
// не выполняется). Предусловие: до записи у существующего контрагента строк регистра нет.
Процедура Контрагент_ФОП_ДубльИНН_РегистрДублейЗаписанВендором() Экспорт

	Код = НовыйРНОКПП();
	Настройки = ПризнакиУчета();
	Настройки.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	Настройки.Вставить("ИНН", Код);
	Существующий = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);
	ЮТест.ОжидаетЧто(СтрокиРегистраДублей(Существующий), "Предусловие: у существующего контрагента строк регистра дублей нет").Равно(0);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(), Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СозданКонтрагент), "Контрагент создан").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокиРегистраДублей(Строка.СозданКонтрагент), "Вендор записал регистр дублей для нового контрагента").Равно(1);
	ЮТест.ОжидаетЧто(СтрокиРегистраДублей(Существующий), "...и для существующего").Равно(1);

КонецПроцедуры

// ИЗМЕРЕНИЕ (открытый вопрос к планировщику): ФОП, созданный продуктом по брифу (РНОКПП в ИНН, КодПоЕДРПОУ пуст), ПОСЛЕДУЮЩИМ
// распознаванием по тому же коду НЕ находится: ПрочитатьКонтрагентовПоКодам ищет только КодПоЕДРПОУ. Следствие: следующая выписка
// с операцией этого ФОП получит "Создать" и второго контрагента. Тест фиксирует измеренное состояние; решение (поиск и по ИНН, либо
// код ФОП дополнительно в КодПоЕДРПОУ) - за планировщиком; после решения тест переписать.
Процедура Контрагент_ФОП_СозданныйПродуктом_РаспознаваниеПоКодуНеНаходит_Измерение() Экспорт

	Код = НовыйРНОКПП();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(), Код));
	Записано = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	Создан = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Записано, 1).СозданКонтрагент;
	ЮТест.ОжидаетЧто(Реквизит(Создан, "ИНН"), "Предусловие: код ФОП записан в ИНН").Равно(Код);

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентКод, КонтрагентНаименование, Сумма",
		1, Код, "Другое название", СМП_ТестыРаспознавания.УникальнаяСумма()));
	Распознанный = СМП_ТестыРаспознавания.Распознать(СМП_ТестыРаспознавания.ТаблицаОпераций(Операция), СМП_ТестыРаспознавания.КонтекстСОрганизацией());

	СтрокаПлана = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(Распознанный, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.Контрагент, "Распознавание по коду ФОП (в ИНН) контрагента не находит").НеРавно(Создан);

КонецПроцедуры

// 9 цифр - вероятно потерян ведущий ноль (так же поступает поиск распознавания): код дополняется нулем, вид по длине дополненного.
Процедура Контрагент_ДевятьЦифр_ДополненНулем() Экспорт

	Код = Сред(НовыйРНОКПП(), 2);
	ЮТест.ОжидаетЧто(СтрДлина(Код), "Предусловие: код из девяти цифр").Равно(9);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(), Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Реквизиты = РеквизитыСсылки(Строка.СозданКонтрагент, "ИНН, ВидКонтрагента");
	ЮТест.ОжидаетЧто(Реквизиты.ИНН, "ИНН дополнен нулем").Равно("0" + Код);
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, "Вид - ФОП (по длине дополненного кода)")
		.Равно(Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);

КонецПроцедуры

// Нет кода или он непригоден (не 8 и не 10 цифр): ни ИНН, ни КодПоЕДРПОУ не заполняются, вид - значение вендора по умолчанию
// (то, что дает Заполнить на новом контрагенте; условие - настройка "ОсновнойВидКонтрагента" пуста, утверждена условиями).
Процедура Контрагент_БезПригодногоКода_ВидВендора(Описание, Код) Экспорт

	Ожидаемый = Справочники.Контрагенты.СоздатьЭлемент();
	Ожидаемый.Заполнить(Неопределено);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Ожидаемый.ВидКонтрагента), Описание + ": предусловие - вид по умолчанию у вендора не пуст").ЭтоИстина();

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(), Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, Описание + ": результат").Равно("Создан");
	Реквизиты = РеквизитыСсылки(Строка.СозданКонтрагент, "ИНН, КодПоЕДРПОУ, ВидКонтрагента");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.ИНН), Описание + ": ИНН пуст").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.КодПоЕДРПОУ), Описание + ": КодПоЕДРПОУ пуст").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, Описание + ": вид - значение вендора по умолчанию").Равно(Ожидаемый.ВидКонтрагента);

КонецПроцедуры

// Группа доступа новых контрагентов - из контекста (D26), если задана; иначе значение вендора по умолчанию. Предусловие: в базе есть
// группа, отличная от вендорской по умолчанию (иначе тест не различал бы "из контекста" и "по умолчанию").
Процедура Контрагент_ГруппаДоступа(Описание, ЗадатьВКонтексте) Экспорт

	ЮТест.ОжидаетЧто(Справочники.ГруппыДоступаКонтрагентов.ИспользуютсяГруппыДоступа(), "Условие: группы доступа используются").ЭтоИстина();
	// В базе измерения группа одна: вторая нужна, чтобы группа из контекста отличалась от группы вендора по умолчанию (которая
	// определяется настройкой пользователя сеанса либо первой разрешенной группой - порядок не гарантирован).
	СМП_ТестыДанныеУНФ.НоваяГруппаДоступаКонтрагентов();
	ПоУмолчанию = Справочники.ГруппыДоступаКонтрагентов.ГруппаДоступаПоУмолчанию();
	Другая = ДругаяГруппаДоступа(ПоУмолчанию);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Другая) И ЗначениеЗаполнено(ПоУмолчанию), Описание + ": предусловие - есть группа, отличная от группы по умолчанию")
		.ЭтоИстина();

	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи();
	Если ЗадатьВКонтексте Тогда
		Контекст.ГруппаДоступаКонтрагентов = Другая;
	КонецЕсли;
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(),
		СМП_ТестыДанныеУНФ.НовыйЕДРПОУ()));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Реквизит(Строка.СозданКонтрагент, "ГруппаДоступа"), Описание + ": группа доступа контрагента")
		.Равно(?(ЗадатьВКонтексте, Другая, ПоУмолчанию));

КонецПроцедуры

// Роли контрагента (покупатель / поставщик / прочие) - по виду операции, вендорской функцией КлассификацияКонтактов.
Процедура Контрагент_ОтношенияПоВидуОперации(Описание, Вид, Покупатель, Поставщик) Экспорт

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, Вид, Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(),
		СМП_ТестыДанныеУНФ.НовыйЕДРПОУ()));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Реквизиты = РеквизитыСсылки(Строка.СозданКонтрагент, "Покупатель, Поставщик, ПрочиеОтношения");
	ЮТест.ОжидаетЧто(Реквизиты.Покупатель, Описание + ": покупатель").Равно(Покупатель);
	ЮТест.ОжидаетЧто(Реквизиты.Поставщик, Описание + ": поставщик").Равно(Поставщик);
	ЮТест.ОжидаетЧто(Реквизиты.ПрочиеОтношения, Описание + ": прочие отношения").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Договор

// D6: договор нового контрагента - тот, что вендор сам создал при записи контрагента; продукт доналаштовывает именно его.
// Условие измерения (утверждено): основная организация базы НЕ организация плана - договор вендора создан на основную.
// После записи: у контрагента ровно один договор, с организацией и видом плана, в регистре основных ровно одна запись этого
// договора (с организацией плана), на основную организацию записи нет, функция выбора вендора находит его для организации плана.
Процедура Договор_НовыйКонтрагент_ВендорскийПерестроенНаОрганизациюПлана() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	ЮТест.ОжидаетЧто(ОсновнаяОрганизацияБазы(), "Условие измерения: основная организация базы не равна организации плана").НеРавно(Организация);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, НовоеИмя(),
		СМП_ТестыДанныеУНФ.НовыйЕДРПОУ()));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, "Результат строки").Равно("Создан");
	Контрагент = Строка.СозданКонтрагент;
	Договоры = ДоговорыКонтрагента(Контрагент);
	ЮТест.ОжидаетЧто(Договоры.Количество(), "У нового контрагента ровно один договор (второй рядом с вендорским не создан)").Равно(1);
	Договор = Договоры[0].Ссылка;
	ЮТест.ОжидаетЧто(Строка.СозданДоговор, "СозданДоговор - договор, созданный записью контрагента").Равно(Договор);
	Реквизиты = РеквизитыСсылки(Договор, "Организация, ВидДоговора, ВалютаРасчетов, НомерДоговора, ДатаДоговора, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация договора - организация плана").Равно(Организация);
	ЮТест.ОжидаетЧто(Реквизиты.ВидДоговора, "Вид договора - по виду операции (от покупателя)").Равно(Перечисления.ВидыДоговоров.СПокупателем);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаРасчетов, "Валюта договора - валюта банковского счета плана")
		.Равно(СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации().ВалютаДенежныхСредств);
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Договор не помечен на удаление").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.НомерДоговора), "Номер договора продукт не выдумывает (D6)").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.ДатаДоговора), "Дату договора продукт не выдумывает (D6)").ЭтоЛожь();

	Записи = ЗаписиОсновныхДоговоров(Контрагент);
	ЮТест.ОжидаетЧто(Записи.Количество(), "В регистре основных договоров контрагента ровно одна запись (на основную организацию записи нет)")
		.Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].Договор, "Запись регистра - этот договор").Равно(Договор);
	ЮТест.ОжидаетЧто(Записи[0].Организация, "Организация записи регистра - организация плана").Равно(Организация);
	ЮТест.ОжидаетЧто(Записи[0].ВидДоговора, "Вид записи регистра").Равно(Перечисления.ВидыДоговоров.СПокупателем);

	Найденный = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.ПоступлениеНаСчет.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);
	ЮТест.ОжидаетЧто(Найденный, "Функция выбора вендора находит договор для организации плана").Равно(Договор);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Строка.Документ).Договор, "Договор документа - созданный").Равно(Договор);

КонецПроцедуры

// Один новый контрагент, две операции разных видов (расход поставщику, поступление от покупателя): два договора, не три. Первый -
// вендорский, перестроенный на вид первой операции; второй (другой вид) - новый, по рецепту знахидки 9. Роли контрагента - обе.
Процедура Договор_НовыйКонтрагент_ДваВидаОперации_ДваДоговора() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	ЮТест.ОжидаетЧто(ОсновнаяОрганизацияБазы(), "Условие измерения: основная организация базы не равна организации плана").НеРавно(Организация);

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Имя = НовоеИмя();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "РасходСоСчета", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 1, Имя, Код));
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 2, Имя, Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Первая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Вторая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Первая.Результат, "Результат первой").Равно("Создан");
	ЮТест.ОжидаетЧто(Вторая.Результат, "Результат второй").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданКонтрагент), "Контрагента создала первая строка").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Вторая.СозданКонтрагент), "Вторая строка контрагента не создавала").ЭтоЛожь();
	Контрагент = Первая.СозданКонтрагент;
	Реквизиты = РеквизитыСсылки(Контрагент, "Покупатель, Поставщик");
	ЮТест.ОжидаетЧто(Реквизиты.Покупатель И Реквизиты.Поставщик, "Роли контрагента - объединение ролей обеих операций").ЭтоИстина();

	Договоры = ДоговорыКонтрагента(Контрагент);
	ЮТест.ОжидаетЧто(Договоры.Количество(), "У контрагента два договора (не три)").Равно(2);
	ЮТест.ОжидаетЧто(Первая.СозданДоговор <> Вторая.СозданДоговор И ЗначениеЗаполнено(Первая.СозданДоговор) И ЗначениеЗаполнено(Вторая.СозданДоговор),
		"Каждая строка создала свой договор").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизит(Первая.СозданДоговор, "ВидДоговора"), "Первый договор - с поставщиком")
		.Равно(Перечисления.ВидыДоговоров.СПоставщиком);
	ЮТест.ОжидаетЧто(Реквизит(Вторая.СозданДоговор, "ВидДоговора"), "Второй договор - с покупателем")
		.Равно(Перечисления.ВидыДоговоров.СПокупателем);
	Для Каждого Договор Из Договоры Цикл
		ЮТест.ОжидаетЧто(Реквизит(Договор.Ссылка, "Организация"), "Организация каждого договора - организация плана").Равно(Организация);
	КонецЦикла;
	// Вендорский (первый) - основной по своему виду; рядом с ним нет записи на основную организацию.
	Записи = ЗаписиОсновныхДоговоров(Контрагент);
	ЮТест.ОжидаетЧто(Записи.Количество(), "В регистре основных одна запись - вендорского договора").Равно(1);
	ЮТест.ОжидаетЧто(Записи[0].Договор, "Запись регистра - первый договор").Равно(Первая.СозданДоговор);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Первая.Документ).Договор, "Договор первого документа").Равно(Первая.СозданДоговор);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Договор, "Договор второго документа").Равно(Вторая.СозданДоговор);

КонецПроцедуры

// Контрагент найден, договора нужного вида нет: "Создать" - новый договор (рецепт знахидки 9: Заполнить, вид, организация,
// наименование по шаблону вендора); две операции одного вида на того же контрагента - ОДИН новый договор. Договор контрагента,
// который уже был, не меняется.
Процедура Договор_НайденныйКонтрагент_СоздатьНовыйОдинНаКлюч() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Прежний = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация", Организация));
	ЮТест.ОжидаетЧто(Реквизит(Прежний, "ВидДоговора"), "Предусловие: прежний договор - с покупателем").Равно(Перечисления.ВидыДоговоров.СПокупателем);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Для Номер = 1 По 2 Цикл
		Строка = СтрокаСоздания(План, "РасходСоСчета", Новый Структура("ПорядковыйНомер, ДействиеКонтрагент", Номер, Действие("Найден")));
		Строка.Контрагент = Контрагент;
	КонецЦикла;

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Первая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Вторая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Первая.Результат, "Результат первой").Равно("Создан");
	ЮТест.ОжидаетЧто(Вторая.Результат, "Результат второй").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданКонтрагент), "Контрагент не создавался (найден)").ЭтоЛожь();
	Договоры = ДоговорыКонтрагента(Контрагент);
	ЮТест.ОжидаетЧто(Договоры.Количество(), "Договоров два: прежний и один новый на ключ (контрагент, организация, вид)").Равно(2);
	НовыйДоговорСозд = Первая.СозданДоговор;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(НовыйДоговорСозд), "Первая строка создала договор").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Вторая.СозданДоговор), "Вторая строка договор не создавала").ЭтоЛожь();
	Реквизиты = РеквизитыСсылки(НовыйДоговорСозд, "Организация, ВидДоговора, Владелец");
	ЮТест.ОжидаетЧто(Реквизиты.Владелец, "Владелец нового договора").Равно(Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация нового договора").Равно(Организация);
	ЮТест.ОжидаетЧто(Реквизиты.ВидДоговора, "Вид нового договора - по виду операции (поставщику)").Равно(Перечисления.ВидыДоговоров.СПоставщиком);
	ЮТест.ОжидаетЧто(Реквизит(Прежний, "ВидДоговора"), "Прежний договор не изменен").Равно(Перечисления.ВидыДоговоров.СПокупателем);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Первая.Документ).Договор, "Договор первого документа").Равно(НовыйДоговорСозд);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Договор, "Договор второго документа").Равно(НовыйДоговорСозд);
	Найденный = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.РасходСоСчета.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийРасходСоСчета.Поставщику);
	ЮТест.ОжидаетЧто(Найденный, "Функция выбора вендора находит новый договор по виду").Равно(НовыйДоговорСозд);

КонецПроцедуры

// Контрагент, счет и договор найдены или не требуются: ничего не создается (счетчик сторожа по типам не меняется).
Процедура Найден_НичегоНеСоздает() Экспорт

	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер", 1));
	Строка.ДействиеКонтрагент = Действие("Найден");
	Строка.ДействиеСчет = Действие("НеТребуется");
	Строка.ДействиеДоговор = Действие("Найден");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, "Результат строки").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданКонтрагент) Или ЗначениеЗаполнено(РезультатСтроки.СозданСчет)
		Или ЗначениеЗаполнено(РезультатСтроки.СозданДоговор), "В результате нет созданных объектов").ЭтоЛожь();
	Для Каждого Тип Из СтрРазделить("Справочник.Контрагенты,Справочник.ДоговорыКонтрагентов,Справочник.БанковскиеСчета,РегистрСведений.ОсновныеДоговорыКонтрагента,РегистрСведений.НаличиеДублейУКонтрагентов", ",") Цикл
		ЮТест.ОжидаетЧто(КоличествоПоТипу(После, Тип), Тип + ": количество не изменилось").Равно(КоличествоПоТипу(До, Тип));
	КонецЦикла;
	ЮТест.ОжидаетЧто(КоличествоПоТипу(После, "Документ.ПоступлениеНаСчет"), "Документ записан")
		.Равно(КоличествоПоТипу(До, "Документ.ПоступлениеНаСчет") + 1);

КонецПроцедуры

#КонецОбласти

#Область БанковскийСчет

// Контрагент найден, счета нет: "Создать" - счет контрагента по МФО банка и номеру операции. Номер хранится без пробелов
// (в верхнем регистре) - так его потом найдет поиск распознавания; банк - по МФО (точный код); наименование - вендорское
// (СформироватьНаименование); валюта, вид и прочее - то, что ставит Заполнить(контрагент).
Процедура Счет_НайденныйКонтрагент_Создан(Описание, СПробелами) Экспорт

	Банк = БанкСШестизначнымКодом();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код);
	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	ЗаписанныйНомер = ?(СПробелами, Лев(Номер, 4) + " " + Сред(Номер, 5, 6) + " " + Сред(Номер, 11), Номер);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, ЗаписанныйНомер, Банк.Код, Действие("Создать")));
	Строка.ДействиеКонтрагент = Действие("Найден");
	Строка.ДействиеДоговор = Действие("Найден");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, Описание + ": результат").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданСчет), Описание + ": создан счет").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданКонтрагент), Описание + ": контрагент не создавался").ЭтоЛожь();
	Реквизиты = РеквизитыСсылки(РезультатСтроки.СозданСчет, "Владелец, НомерСчета, Банк, ВидСчета, ВалютаДенежныхСредств, Наименование");
	ЮТест.ОжидаетЧто(Реквизиты.Владелец, Описание + ": владелец счета").Равно(Сценарий.Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.НомерСчета, Описание + ": номер счета без пробелов").Равно(Номер);
	ЮТест.ОжидаетЧто(Реквизиты.Банк, Описание + ": банк по МФО").Равно(Банк.Ссылка);
	ТаблицаБанков = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", Банк.Код);
	ЮТест.ОжидаетЧто(ТаблицаБанков.Количество(), Описание + ": предусловие - вендорский поиск формы счета дает один банк").Равно(1);
	ЮТест.ОжидаетЧто(Реквизиты.Банк, Описание + ": банк - тот, что дает вендорский поиск формы счета").Равно(ТаблицаБанков[0].Ссылка);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаДенежныхСредств, Описание + ": валюта - национальная (Заполнить вендора)")
		.Равно(Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(Реквизиты.Наименование, Описание + ": наименование по шаблону вендора")
		.Равно(НаименованиеСчетаВендора(Номер, Банк.Ссылка));
	ЮТест.ОжидаетЧто(ПрочитатьСчетДокумента(РезультатСтроки.Документ), Описание + ": счет контрагента документа").Равно(РезультатСтроки.СозданСчет);

КонецПроцедуры

// Новый контрагент и счет: владелец счета - только что созданный контрагент; без МФО-банка счет пригоден (банк в справочнике).
Процедура Счет_НовыйКонтрагент_ВладелецСозданный() Экспорт

	Банк = БанкСШестизначнымКодом();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "РасходСоСчета", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, НовоеИмя(), СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), Номер, Банк.Код, Действие("Создать")));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, "Результат строки").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СозданСчет), "Создан счет").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизит(Строка.СозданСчет, "Владелец"), "Владелец счета - созданный контрагент").Равно(Строка.СозданКонтрагент);
	ЮТест.ОжидаетЧто(ПрочитатьСчетДокумента(Строка.Документ), "Счет контрагента документа").Равно(Строка.СозданСчет);

КонецПроцедуры

// МФО, которого нет в справочнике банков: счет не создается (ПроверитьЗаполнение не проходит - измерено: банк обязателен), документ
// записывается без счета контрагента и проводится (счет документу не нужен); причина - предупреждение на поле СчетКонтрагента.
Процедура Счет_МФОНетВБазе_НеСоздан_ДокументЗаписан() Экспорт

	МФО = МФОКоторогоНетВБазе();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(МФО);
	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, Номер, МФО, Действие("Создать")));
	Строка.ДействиеКонтрагент = Действие("Найден");
	Строка.ДействиеДоговор = Действие("Найден");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, "Документ записан и проведен без счета контрагента").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданСчет), "Счет не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(КоличествоСчетовПоНомеру(Номер), "Счета с этим номером в базе нет").Равно(0);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ПрочитатьСчетДокумента(РезультатСтроки.Документ)), "У документа нет счета контрагента").ЭтоЛожь();
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество() > 0, "Причина отказа создания счета - предупреждение").ЭтоИстина();
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, "Поле предупреждения").Равно("СчетКонтрагента");
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Ошибка").Количество(), "Ошибок у проведенного документа нет").Равно(0);

КонецПроцедуры

// Банк по МФО есть, но код банка в IBAN другой: ПроверитьЗаполнение счета не проходит (вендорское сообщение переносится в
// предупреждение), счет не создается, документ записан и проведен.
Процедура Счет_IBANНеСоответствуетБанку_НеСоздан() Экспорт

	Банк = БанкСШестизначнымКодом();
	ДругойКод = МФОКоторогоНетВБазе();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(ДругойКод);
	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, Номер, Банк.Код, Действие("Создать")));
	Строка.ДействиеКонтрагент = Действие("Найден");
	Строка.ДействиеДоговор = Действие("Найден");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, "Результат строки").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданСчет), "Счет не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(КоличествоСчетовПоНомеру(Номер), "Счета с этим номером в базе нет").Равно(0);
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество() > 0, "Причина отказа создания счета - предупреждение").ЭтоИстина();
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, "Поле предупреждения").Равно("СчетКонтрагента");
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "Текст - сообщение вендора: должен быть банк с кодом из IBAN").Содержит(ДругойКод);

КонецПроцедуры

// МФО, под которым в справочнике банков больше одного банка (измерено: Банк_КодыНеУникальны_Измерение): банк неоднозначен, счет не
// создается (угадывать банк нельзя), причина - предупреждение; документ записан и проведен.
Процедура Счет_МФОСДублемБанка_НеСоздан_Предупреждение() Экспорт

	МФО = КодБанкаСДублем();
	ЮТест.ОжидаетЧто(ПустаяСтрока(МФО), "Предусловие: в справочнике банков есть код с дублем").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрДлина(МФО), "Предусловие: код с дублем - шесть цифр (МФО)").Равно(6);
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(МФО);
	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, Номер, МФО, Действие("Создать")));
	Строка.ДействиеКонтрагент = Действие("Найден");
	Строка.ДействиеДоговор = Действие("Найден");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, "Результат строки").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданСчет), "Счет не создан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(КоличествоСчетовПоНомеру(Номер), "Счета с этим номером в базе нет").Равно(0);
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество() > 0, "Причина - предупреждение").ЭтоИстина();
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, "Поле предупреждения").Равно("СчетКонтрагента");

КонецПроцедуры

// Счет не создан - две ветки (решение консультанта к задаче 4). Контрагентные виды (ОтПокупателя и др.) счет документу не требуют
// (достаточный набор задачи 1; тесты выше: проведено, предупреждение). Вид с обязательным СчетКонтрагента (по чтению кода: только
// РасходСоСчета.ПереводНаДругойСчет - ПроверитьЗаполнение требует счет) без владельца счета: создавать нечего - документ записан
// непроведенным, причина - замечание уровня Ошибка от ПроверитьЗаполнение документа (поле счета названо).
Процедура Счет_НеСоздан_ВидСОбязательнымСчетом_Непроведен() Экспорт

	Банк = БанкСШестизначнымКодом();
	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("РасходСоСчета");
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код), Банк.Код, Действие("Создать")));
	Строка.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ПереводНаДругойСчет;
	Строка.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Строка.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Строка.ДействиеКонтрагент = Действие("НеТребуется");
	Строка.ДействиеДоговор = Действие("НеТребуется");

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	РезультатСтроки = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(РезультатСтроки.Результат, "Вид с обязательным счетом: документ непроведен").Равно("СозданНепроведенным");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РезультатСтроки.СозданСчет), "Счет без владельца не создан").ЭтоЛожь();
	Ошибки = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество() > 0, "Причина - замечание уровня Ошибка").ЭтоИстина();
	Тексты = Новый Массив;
	Для Каждого Замечание Из Ошибки Цикл
		Тексты.Добавить(Замечание.Текст);
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Тексты, "; "), "Причина от ПроверитьЗаполнение называет счет контрагента").Содержит("Счет контрагента");

КонецПроцедуры

#КонецОбласти

#Область ПакетИОтказы

// Две операции одного нового контрагента в одной выписке: один контрагент, один счет, один договор (Review Focus 2).
// Ключ группировки - тот же, что у поиска распознавания: код; без кода - номер счета; без обоих - название.
Процедура Пакет_ДвеОперацииНовогоКонтрагента_Один(Описание, Ключ) Экспорт

	Банк = БанкСШестизначнымКодом();
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код);
	Имя = НовоеИмя();
	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Для Номер_ = 1 По 2 Цикл
		// Значения операции по умолчанию (код, номер счета) у фикстуры случайные и разные у каждой строки: ключ, которого тест не
		// называет, задается пустым явно.
		Настройки = Новый Структура("ПорядковыйНомер, КонтрагентКод, КонтрагентНомерСчета", Номер_, "", "");
		Если Ключ = "Название" Тогда
			Настройки.Вставить("КонтрагентНаименование", ?(Номер_ = 1, Имя, НРег(Имя)));
		Иначе
			Настройки.Вставить("КонтрагентНаименование", ?(Номер_ = 1, Имя, Имя + "_иначе"));
			Настройки.КонтрагентНомерСчета = Номер;
			Настройки.Вставить("КонтрагентМФО", Банк.Код);
			Настройки.Вставить("ДействиеСчет", Действие("Создать"));
			Если Ключ = "Код" Тогда
				Настройки.КонтрагентКод = Код;
			КонецЕсли;
		КонецЕсли;
		СтрокаСоздания(План, "ПоступлениеНаСчет", Настройки);
	КонецЦикла;

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Первая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Вторая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Первая.Результат, Описание + ": результат первой").Равно("Создан");
	ЮТест.ОжидаетЧто(Вторая.Результат, Описание + ": результат второй").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданКонтрагент), Описание + ": контрагента создала первая строка").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Вторая.СозданКонтрагент), Описание + ": вторая строка контрагента не создавала").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Первая.Документ).Контрагент, Описание + ": контрагент первого документа").Равно(Первая.СозданКонтрагент);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Контрагент, Описание + ": контрагент второго документа - тот же").Равно(Первая.СозданКонтрагент);
	Договор = ПрочитатьДокумент(Первая.Документ).Договор;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), Описание + ": договор первого документа заполнен").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Договор, Описание + ": договор второго документа - тот же").Равно(Договор);
	ЮТест.ОжидаетЧто(ДоговорыКонтрагента(Первая.СозданКонтрагент).Количество(), Описание + ": договор один (вендорский второй рядом не создан)").Равно(1);
	ЮТест.ОжидаетЧто(КоличествоПоТипу(После, "Справочник.Контрагенты"), Описание + ": новых контрагентов")
		.Равно(КоличествоПоТипу(До, "Справочник.Контрагенты") + 1);
	Если Ключ <> "Название" Тогда
		ЮТест.ОжидаетЧто(КоличествоПоТипу(После, "Справочник.БанковскиеСчета"), Описание + ": новых счетов")
			.Равно(КоличествоПоТипу(До, "Справочник.БанковскиеСчета") + 1);
		ЮТест.ОжидаетЧто(ПрочитатьСчетДокумента(Первая.Документ), Описание + ": счет первого документа").Равно(Первая.СозданСчет);
		ЮТест.ОжидаетЧто(ПрочитатьСчетДокумента(Вторая.Документ), Описание + ": счет второго документа - тот же").Равно(Первая.СозданСчет);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Вторая.СозданСчет), Описание + ": вторая строка счета не создавала").ЭтоЛожь();
	КонецЕсли;

КонецПроцедуры

// Разные коды - разные контрагенты (группировка не слипает чужих): два контрагента, два договора.
Процедура Пакет_РазныеКоды_РазныеКонтрагенты() Экспорт

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Для Номер = 1 По 2 Цикл
		СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", Номер, НовоеИмя(),
			?(Номер = 1, СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), НовыйРНОКПП())));
	КонецЦикла;

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Первая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Вторая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданКонтрагент) И ЗначениеЗаполнено(Вторая.СозданКонтрагент), "Оба контрагента созданы").ЭтоИстина();
	ЮТест.ОжидаетЧто(Первая.СозданКонтрагент <> Вторая.СозданКонтрагент, "Контрагенты разные").ЭтоИстина();
	ЮТест.ОжидаетЧто(Первая.СозданДоговор <> Вторая.СозданДоговор, "Договоры разные").ЭтоИстина();

КонецПроцедуры

// Инвариант записи: общий объект - отдельная единица, созданная ДО документов. Первая операция нового контрагента не записывается
// (идентификатор длиннее реквизита - "Ошибка" документа), но контрагент к этому моменту уже создан (учтен на этой строке:
// протокол считает созданное), вторая операция записана с тем же контрагентом, и он есть в базе.
Процедура Пакет_ПервыйДокументНеЗаписан_ВторойСТемЖеКонтрагентом() Экспорт

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Имя = НовоеИмя();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ДлинаРеквизитаИдентификатора(), "Предусловие: длина реквизита идентификатора").Равно(50);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод, ИдентификаторОперации", 1, Имя, Код,
		СМП_ТестыЗаписиКаркас.ДлинныйИдентификатор(51)));
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 2, Имя, Код));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());

	Первая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Вторая = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Первая.Результат, "Первая операция не записана").Равно("Ошибка");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.Документ), "У первой нет документа").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданКонтрагент), "Контрагент создан до отказа и учтен на первой строке").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Первая.СозданДоговор), "Договор создан до отказа и учтен на первой строке").ЭтоИстина();
	ЮТест.ОжидаетЧто(Вторая.Результат, "Вторая операция записана и проведена").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Вторая.СозданКонтрагент), "Вторая строка контрагента не создавала").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Контрагент, "Документ второй операции ссылается на контрагента первой").Равно(Первая.СозданКонтрагент);
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Вторая.Документ).Договор, "...и на его договор").Равно(Первая.СозданДоговор);
	ЮТест.ОжидаетЧто(КоличествоКонтрагентовПоНаименованию(Имя), "Контрагент существует в базе в одном экземпляре").Равно(1);
	ЮТест.ОжидаетЧто(Реквизит(Первая.СозданКонтрагент, "Наименование"), "Контрагент в базе читается").Равно(Имя);

КонецПроцедуры

// Вторая запись того же плана ничего не создает: операции найдены повторной проверкой (D5, D35.5), общие объекты для них не создаются
// заново, хотя план по-прежнему говорит "Создать" (план не меняется).
Процедура Пакет_ПовторнаяЗапись_НичегоНеСоздает() Экспорт

	Банк = БанкСШестизначнымКодом();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, НовоеИмя(), СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код), Банк.Код, Действие("Создать")));
	// Контекст создается один раз: каждый КонтекстЗаписи() создает фикстурного пользователя (и физлицо) - это не запись продукта.
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи();
	Первая = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Первая, 1).Результат, "Предусловие: первая запись создала документ").Равно("Создан");
	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Вторая = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Строка = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Вторая, 1);
	ЮТест.ОжидаетЧто(Строка.Результат, "Результат повторной записи").Равно("УжеЗагружен");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СозданКонтрагент) Или ЗначениеЗаполнено(Строка.СозданСчет) Или ЗначениеЗаполнено(Строка.СозданДоговор),
		"Повторная запись ничего не создала").ЭтоЛожь();
	Для Каждого Элемент Из До Цикл
		ЮТест.ОжидаетЧто(КоличествоПоТипу(После, Элемент.Ключ), Элемент.Ключ + ": количество не изменилось").Равно(Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

// "Невозможно": ни названия, ни кода, ни счета - объект не создается, документ записывается без контрагента и остается непроведенным
// (причина - ошибка проверки заполнения документа); соседняя операция с созданием записана и проведена.
Процедура Невозможно_ДокументБезКонтрагента_Непроведен_СоседПроведен() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, ДействиеКонтрагент, ДействиеДоговор", 1, Действие("Невозможно"),
		Действие("Невозможно")));
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод", 2, НовоеИмя(),
		СМП_ТестыДанныеУНФ.НовыйЕДРПОУ()));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Невозможно = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Сосед = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Невозможно.Результат, "Операция с действием 'Невозможно'").Равно("СозданНепроведенным");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Невозможно.Документ), "Документ записан").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ПрочитатьДокумент(Невозможно.Документ).Контрагент), "У документа нет контрагента").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ПрочитатьДокумент(Невозможно.Документ).Проведен, "Документ не проведен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Невозможно.СозданКонтрагент) Или ЗначениеЗаполнено(Невозможно.СозданДоговор), "Для 'Невозможно' ничего не создано")
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Ошибка").Количество() > 0, "Причина - замечание уровня Ошибка").ЭтоИстина();
	ЮТест.ОжидаетЧто(Сосед.Результат, "Сосед проведен").Равно("Создан");
	ЮТест.ОжидаетЧто(КоличествоПоТипу(После, "Справочник.Контрагенты"), "Создан один контрагент (соседа)")
		.Равно(КоличествоПоТипу(До, "Справочник.Контрагенты") + 1);

КонецПроцедуры

// Сторож видит всё, что создала запись: контрагент, договор вендора (имя по шаблону, без префикса), счет (имя вендорское),
// запись основных договоров и сам документ - по одному (регистр дублей вендор пишет лишь при дубле, его видит СторожВидитРегистрДублей).
Процедура СозданныеОбъекты_ВидныСторожу() Экспорт

	Банк = БанкСШестизначнымКодом();
	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаСоздания(План, "ПоступлениеНаСчет", Новый Структура("ПорядковыйНомер, КонтрагентНаименование, КонтрагентКод, КонтрагентНомерСчета, КонтрагентМФО, ДействиеСчет",
		1, НовоеИмя(), СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), СМП_ТестыДанныеУНФ.НовыйIBAN(Банк.Код), Банк.Код, Действие("Создать")));

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1).Результат, "Предусловие: документ создан").Равно("Создан");
	Для Каждого Тип Из СтрРазделить("Справочник.Контрагенты,Справочник.ДоговорыКонтрагентов,Справочник.БанковскиеСчета,РегистрСведений.ОсновныеДоговорыКонтрагента,Документ.ПоступлениеНаСчет", ",") Цикл
		ЮТест.ОжидаетЧто(КоличествоПоТипу(После, Тип) - КоличествоПоТипу(До, Тип), Тип + ": сторож увидел ровно один новый объект").Равно(1);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СторожОстатков

// БЕЗ транзакции, ПОСЛЕДНИМ. Тот же подсчет, что в СМП_ТестыФикстур; ждет нуль в каждом типе.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

// Литерал действия плана ("Создать", "Найден", "НеТребуется", "Невозможно") - функцией продукта.
Функция Действие(Имя)

	Возврат Продукт("СМП_РаспознаваниеОпераций.Действие" + Имя);

КонецФункции

// Строка плана для создания: контрагента нет (пустые ссылки), действия по умолчанию - контрагент и договор "Создать", счет
// "НеТребуется". Вид операции - "От покупателя" (поступление) или "Поставщику" (расход); настройки переопределяют.
Функция СтрокаСоздания(План, Вид, Настройки)

	ЭтоПоступление = (Вид = "ПоступлениеНаСчет");
	Сценарий = Новый Структура;
	Сценарий.Вставить("Вид", Вид);
	Сценарий.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Сценарий.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Сценарий.Вставить("Статья", ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств."
		+ ?(ЭтоПоступление, "ОплатаОтПокупателей", "ОплатаПоставщикам")));
	Сценарий.Вставить("ВидОперации", ?(ЭтоПоступление, ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику")));

	Полные = Новый Структура;
	Полные.Вставить("ДействиеКонтрагент", Действие("Создать"));
	Полные.Вставить("ДействиеСчет", Действие("НеТребуется"));
	Полные.Вставить("ДействиеДоговор", Действие("Создать"));
	Для Каждого Элемент Из Настройки Цикл
		Полные.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Полные);

КонецФункции

Функция НовоеИмя()

	Возврат СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "НовыйДоговорСозд" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 14);

КонецФункции

Функция ПризнакиУчета()

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);

	Возврат Настройки;

КонецФункции

// "Основная организация" базы по формуле вендора (так ОбработкаЗаполнения договора выбирает организацию).
Функция ОсновнаяОрганизацияБазы()

	Результат = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.АвторизованныйПользователь(), "ОсновнаяОрганизация");
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// РНОКПП - 10 цифр, первая не нуль. Контрольная цифра не нужна: вендор ее не проверяет (журнал задачи 2, знахидка 4).
Функция НовыйРНОКПП()

	ГСЧ = Новый ГенераторСлучайныхЧисел(Число(Прав(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"), 6)));
	Цифры = Формат(ГСЧ.СлучайноеЧисло(1, 9), "ЧГ=0");
	Пока СтрДлина(Цифры) < 10 Цикл
		Цифры = Цифры + Формат(ГСЧ.СлучайноеЧисло(0, 9), "ЧГ=0");
	КонецЦикла;

	Возврат Цифры;

КонецФункции

// Код банка (шесть цифр), под которым в справочнике банков больше одного банка среди не помеченных и не групп; пустая строка, если нет.
Функция КодБанкаСДублем()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Б.Код КАК Код
		|ИЗ
		|	Справочник.Банки КАК Б
		|ГДЕ
		|	НЕ Б.ПометкаУдаления
		|	И НЕ Б.ЭтоГруппа
		|	И Б.Код ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]""
		|СГРУППИРОВАТЬ ПО
		|	Б.Код
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1
		|УПОРЯДОЧИТЬ ПО
		|	Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), СокрЛП(Выборка.Код), "");

КонецФункции

Функция ДругаяГруппаДоступа(ГруппаПоУмолчанию)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Г.Ссылка КАК Ссылка ИЗ Справочник.ГруппыДоступаКонтрагентов КАК Г
		|ГДЕ НЕ Г.ПометкаУдаления И Г.Ссылка <> &ПоУмолчанию
		|УПОРЯДОЧИТЬ ПО Г.Код");
	Запрос.УстановитьПараметр("ПоУмолчанию", ГруппаПоУмолчанию);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.ГруппыДоступаКонтрагентов.ПустаяСсылка());

КонецФункции

// Первый не помеченный на удаление банк (не группа), код которого - ровно шесть цифр (МФО) и встречается один раз (коды банков в
// базе не уникальны - Банк_КодыНеУникальны_Измерение; банк с неоднозначным кодом продукт не берет).
Функция БанкСШестизначнымКодом()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Б.Код КАК Код
		|ИЗ
		|	Справочник.Банки КАК Б
		|ГДЕ
		|	НЕ Б.ПометкаУдаления
		|	И НЕ Б.ЭтоГруппа
		|	И Б.Код ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]""
		|СГРУППИРОВАТЬ ПО
		|	Б.Код
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) = 1
		|УПОРЯДОЧИТЬ ПО
		|	Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: в справочнике Банки есть банк с шестизначным кодом, встречающимся один раз").ЭтоИстина();
	Код = СокрЛП(Выборка.Код);

	Возврат Новый Структура("Ссылка, Код", Справочники.Банки.НайтиПоКоду(Код), Код);

КонецФункции

// Шестизначный код, которого нет в справочнике банков (утверждено запросом).
Функция МФОКоторогоНетВБазе()

	Для Кандидат = 900001 По 999999 Цикл
		Код = Формат(Кандидат, "ЧГ=0");
		Если Справочники.Банки.НайтиПоКоду(Код).Пустая() Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не найден шестизначный код, которого нет в справочнике банков";

КонецФункции

// Наименование счета так, как его дает вендорский СформироватьНаименование: ждет те же номер и банк.
Функция НаименованиеСчетаВендора(Номер, Банк)

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.НомерСчета = Номер;
	Счет.Банк = Банк;
	Счет.СформироватьНаименование();

	Возврат Счет.Наименование;

КонецФункции

Функция РеквизитыСсылки(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + "
		|ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Реквизит(Ссылка, Имя)

	Возврат РеквизитыСсылки(Ссылка, Имя)[Имя];

КонецФункции

Функция ДоговорыКонтрагента(Контрагент)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.ВидДоговора КАК ВидДоговора
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЗаписиОсновныхДоговоров(Контрагент)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Т.Организация КАК Организация, Т.Договор КАК Договор, Т.ВидДоговора КАК ВидДоговора
		|ИЗ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Т
		|ГДЕ Т.Контрагент = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СтрокиРегистраДублей(Контрагент)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.НаличиеДублейУКонтрагентов КАК Т ГДЕ Т.Контрагент = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

Функция КоличествоКонтрагентовПоНаименованию(Имя)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.Наименование = &Имя");
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

Функция КоличествоСчетовПоНомеру(Номер)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.БанковскиеСчета КАК Т ГДЕ Т.НомерСчета = &Номер");
	Запрос.УстановитьПараметр("Номер", Номер);
	Выборка = Запрос.Выполнить().Выбрать();
