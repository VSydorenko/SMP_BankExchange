Функция ПрочитатьДокумент(Документ)

	Возврат СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Документ);

КонецФункции

// Счет контрагента банковского документа (запросом).
Функция ПрочитатьСчетДокумента(Документ)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.СчетКонтрагента КАК Счет ИЗ Документ." + Документ.Метаданные().Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Счет;

КонецФункции

// Количество типа из результата подсчета сторожа (нет ключа - нуль).
Функция КоличествоПоТипу(Количества, Тип)

	Значение = Количества.Получить(Тип);

	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

#КонецОбласти
