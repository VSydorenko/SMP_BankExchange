// Тесты записи документов банка: основа - ПЛАТЕЖНОЕ ПОРУЧЕНИЕ (колонка плана ПлатежноеПоручение; задача 7 плана 04; D21, D34, D35.10).
// Зона: документ списания заполняется вендорским РасходСоСчета.ЗаполнитьПоПлатежноеПоручение, после чего продукт возвращает данные плана:
// корреспонденцию (метод для особых видов ставит свою - D35.10), статью, налогообложение НДС по организации (метод ставит "облагается"
// безусловно), данные банка; поручение, по которому записан и проведен документ, вендор помечает "Оплачено". Проверка поручения до вызова
// метода: организация, пометка на удаление, "Оплачено", контрагент. Заказы и счета - СМП_ТестыЗаписиОснование, документы расчетов -
// СМП_ТестыЗаписиОснованиеРасчеты (экспортные помощники первого используются, не копируются).
//
// ИСТОРИЯ ЦВЕТА (журнал плана 04, задача 7): продукт ветки поручения написан в коммите B раньше тестов этой зоны, поэтому часть тестов зелена
// без нового продукта; их доказательство - мутации (журнал). Тест D35.10 краснел на этом продукте по другой причине: проверка контрагента
// сравнивала контрагента основы с контрагентом ДОКУМЕНТА (пустым у видов без контрагента), и поручение вида "Личные средства" не бралось вовсе.
//
// Платежное поручение не проводится (Posting=Deny, cf/src Documents/ПлатежноеПоручение.xml), поэтому "основа проведена" для него не требуется:
// фикстура поручения непроведенная, и оно берется. Условия измерения - как в СМП_ТестыЗаписиОснование (Условия_РежимБазыИзмерения).
// Фрагменты причин по-русски: условие "русский сеанс".
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Поручение: условия");
	Набор.ДобавитьСерверныйТест("Условия_РежимБазыИзмерения").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Поручение: заполнение по поручению и возврат данных плана (D21, D35.10)");
	Набор.ДобавитьСерверныйТест("Поручение_Оплата_ДокументПоПоручению_ПоручениеОплачено").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Поручение_КореспонденцияПлана_Сохраняется").ВТранзакции()
		// Описание, Корреспонденция плана (метод вендора для особых видов ставит НераспределеннаяПрибыль безусловно)
		.СПараметрами("личные средства, корреспонденция плана - прочие расходы", "ПрочиеРасходы")
		.СПараметрами("личные средства, корреспонденция плана - прочие доходы", "ПрочиеДоходы");
	Набор.ДобавитьСерверныйТест("Поручение_НалогообложениеНДС_ПоОрганизации_НеОблагаетсяМетода").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Поручение_Статья_ПланаВажнееСтатьиПоручения").ВТранзакции();
	Набор.ДобавитьСерверныйТест("СпособЗачета_Поручение_СтавитПродуктДоЗаписи").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Поручение: проверка до вызова метода (D21)");
	Набор.ДобавитьСерверныйТест("Проверка_ПоручениеНеПроходит_НеБерется").ВТранзакции()
		.СПараметрами("поручение другой организации", "ДругаяОрганизация", "другой организации")
		.СПараметрами("поручение уже оплачено", "Оплачено", "уже оплачено")
		.СПараметрами("поручение помечено на удаление", "ПомеченоНаУдаление", "удаление")
		.СПараметрами("контрагент поручения не контрагент плана", "КонтрагентДругой", "контрагент")
		.СПараметрами("у поручения контрагент есть, в плане контрагента нет", "КонтрагентаВПланеНет", "контрагент");
	Набор.ДобавитьСерверныйТест("Поручение_БезКонтрагента_ПланБезКонтрагента_Берется").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Поручение: сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Условия

Процедура Условия_РежимБазыИзмерения() Экспорт

	СМП_ТестыЗаписиОснование.Условия_РежимБазыИзмерения();

КонецПроцедуры

#КонецОбласти

#Область Тесты

// Поручение "Оплата" (вид списания "Поставщику"): документ заполнен методом вендора - ДокументОснование = поручение, одна строка расшифровки
// из строки поручения (договор, сумма), способ зачета "Вручную", данные банка плана. Поручение непроведенное (Posting=Deny) и берется. После
// проведения документа поручение помечено "Оплачено" вендором (журнал плана 04, задача 2, находка 21: связь - ДокументОснование).
// Предусловие: до записи "Оплачено" = Нет.
Процедура Поручение_Оплата_ДокументПоПоручению_ПоручениеОплачено() Экспорт

	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.Оплата, Новый Структура);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Поручение, "Оплачено"), "Предусловие: поручение не оплачено").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Поручение, "Проведен"), "Предусловие: поручение не проводится (Posting=Deny)").ЭтоЛожь();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуПоручения(План, Основа, Новый Структура);

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, "Результат (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, "ДокументОснование - поручение").Равно(Основа.Поручение);
	ЮТест.ОжидаетЧто(Объект.СуммаДокумента, "Сумма документа - сумма банка (= сумма поручения)").Равно(Основа.Сумма);
	ЮТест.ОжидаетЧто(Объект.Контрагент, "Контрагент").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), "Одна строка расшифровки из поручения").Равно(1);
	Строка = Объект.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.Договор, "Договор строки - договор поручения").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, "Сумма платежа строки").Равно(Основа.Сумма);
	ЮТест.ОжидаетЧто(Строка.СпособЗачета, "Способ зачета - Вручную").Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), "Предупреждений нет").Равно(0);
	ЮТест.ОжидаетЧто(Объект.Проведен, "Документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Поручение, "Оплачено"), "Поручение помечено Оплачено вендором после проведения")
		.ЭтоИстина();

КонецПроцедуры

// D35.10: метод вендора для вида поручения "Личные средства предпринимателя" ставит корреспонденцию НераспределеннаяПрибыль безусловно, отбрасывая
// корреспонденцию поручения (журнал плана 04, задача 2, находка 20). Продукт возвращает корреспонденцию ПЛАНА (в плане она из поручения или
// из правила) после метода - документ получает именно ее. Вид без контрагента в документе, но поручение выписано на контрагента, найденного
// распознаванием (шаг 3 берет только строки с найденным контрагентом): основа берется и для такого вида. Предусловие измерено в тесте:
// метод вендора на пробном документе дает НераспределеннаяПрибыль, а корреспонденция плана - другая.
Процедура Поручение_КореспонденцияПлана_Сохраняется(Описание, ИмяКорреспонденции) Экспорт

	КорреспонденцияПлана = ПредопределенноеЗначение("ПланСчетов.Управленческий." + ИмяКорреспонденции);
	НераспределеннаяПрибыль = ПредопределенноеЗначение("ПланСчетов.Управленческий.НераспределеннаяПрибыль");
	ЮТест.ОжидаетЧто(КорреспонденцияПлана, Описание + ": предусловие - корреспонденция плана не равна той, что ставит метод").НеРавно(НераспределеннаяПрибыль);

	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.ЛичныеСредстваПредпринимателя,
		Новый Структура("Корреспонденция", КорреспонденцияПлана));
	Проба = Документы.РасходСоСчета.СоздатьДокумент();
	Проба.Дата = ТекущаяДатаСеанса();
	Проба.ЗаполнитьПоПлатежноеПоручение(Основа.Поручение);
	ЮТест.ОжидаетЧто(Проба.Корреспонденция, Описание + ": предусловие - метод вендора перезаписал корреспонденцию поручения").Равно(НераспределеннаяПрибыль);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуПоручения(План, Основа, Новый Структура("Корреспонденция", КорреспонденцияПлана));

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект <> Неопределено, Описание + ": документ записан (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята - ДокументОснование - поручение").Равно(Основа.Поручение);
	ЮТест.ОжидаетЧто(Объект.Корреспонденция, Описание + ": корреспонденция - из плана, не вендорская НераспределеннаяПрибыль").Равно(КорреспонденцияПлана);

КонецПроцедуры

// Метод вендора ставит НалогообложениеНДС = "облагается" безусловно, хотя организация - не плательщик (журнал плана 04, задача 2, находка 19).
// Продукт возвращает налогообложение ТОЙ ЖЕ функцией, что заполнение документа без основы (НалогиУНФ.НалогообложениеНДС по организации;
// ЗаполнениеОбъектовУНФ.РазыменоватьПоляОрганизацииНалогообложениеНДС). ВИМІРЯНО в тесте: эталон - документ без основы, заполненный штатным
// Заполнить(Организация, ВидОперации) на этой организации; документ с основой получает то же значение. Предусловия: метод вендора на пробном
// документе дает "облагается", а эталон - нет.
Процедура Поручение_НалогообложениеНДС_ПоОрганизации_НеОблагаетсяМетода() Экспорт

	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.Оплата, Новый Структура);
	Проба = Документы.РасходСоСчета.СоздатьДокумент();
	Проба.Дата = ТекущаяДатаСеанса();
	Проба.ЗаполнитьПоПлатежноеПоручение(Основа.Поручение);
	ЮТест.ОжидаетЧто(Проба.НалогообложениеНДС, "Предусловие: метод вендора ставит ""облагается""").Равно(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);

	Эталон = Документы.РасходСоСчета.СоздатьДокумент();
	Эталон.Дата = ТекущаяДатаСеанса();
	Эталон.Заполнить(Новый Структура("Организация, ВидОперации", СМП_ТестыДанныеУНФ.Организация(), Перечисления.ВидыОперацийРасходСоСчета.Поставщику));
	ЮТест.ОжидаетЧто(Эталон.НалогообложениеНДС, "Предусловие: документ без основы - не ""облагается"" (организация не плательщик)")
		.НеРавно(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуПоручения(План, Основа, Новый Структура);
	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, "Основа взята").Равно(Основа.Поручение);
	ЮТест.ОжидаетЧто(Объект.НалогообложениеНДС, "Налогообложение НДС - как у документа без основы (по организации), не ""облагается"" метода")
		.Равно(Эталон.НалогообложениеНДС);

КонецПроцедуры

// Стаття: метод вендора ставит статью поручения (а когда ее нет - "Оплата поставщикам" / "Прочее"); продукт возвращает статью ПЛАНА. Статья плана -
// "Прочее", статья поручения - "Оплата поставщикам" (разные: иначе возврат не отличить). Статья документа - в шапке или в строке (положение
// статьи у фикстурного ответственного не задано - в шапке).
Процедура Поручение_Статья_ПланаВажнееСтатьиПоручения() Экспорт

	СтатьяПоручения = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщикам;
	СтатьяПлана = Справочники.СтатьиДвиженияДенежныхСредств.Прочее;
	ЮТест.ОжидаетЧто(СтатьяПлана, "Предусловие: статья плана не равна статье поручения").НеРавно(СтатьяПоручения);
	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.Оплата, Новый Структура("Статья", СтатьяПоручения));
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуПоручения(План, Основа, Новый Структура("СтатьяДДС", СтатьяПлана));

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, "Основа взята").Равно(Основа.Поручение);
	СтатьяДокумента = ?(ЗначениеЗаполнено(Объект.Статья), Объект.Статья, Объект.РасшифровкаПлатежа[0].СтатьяДДС);
	ЮТест.ОжидаетЧто(СтатьяДокумента, "Статья документа - статья плана, не статья поручения").Равно(СтатьяПлана);

КонецПроцедуры

// D34: строки по поручению - "Вручную" (как вендор при вводе на основании). Заполняется ОТКРЫТЫЙ объект: при записи пустой способ вендор сам
// превращает в "Вручную" и после записи не отличить. Строка поручения способ зачета не несет (фикстура его не задает) - ставит продукт.
Процедура СпособЗачета_Поручение_СтавитПродуктДоЗаписи() Экспорт

	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.Оплата, Новый Структура);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуПоручения(План, Основа, Новый Структура);
	Объект = Документы.РасходСоСчета.СоздатьДокумент();

	СМП_ТестыЗаписиОснование.ЗаполнитьОткрытыйДокумент(Объект, СтрокаПлана);

	ЮТест.ОжидаетЧто(Объект.ДокументОснование, "Основа взята").Равно(Основа.Поручение);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), "Строка расшифровки из поручения").Равно(1);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа[0].СпособЗачета, "Способ зачета - Вручную, поставлен до записи")
		.Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную);
	ЮТест.ОжидаетЧто(Объект.ВариантЗаполненияРасшифровки, "ВариантЗаполненияРасшифровки не Автоматически")
		.НеРавно(Перечисления.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически);

КонецПроцедуры

// Правило контрагента (D21): контрагент основы совпадает с контрагентом СТРОКИ ПЛАНА, в том числе пусто в обоих. Вендорское поручение вида
// "Личные средства" контрагента, как правило, не несет (форма очищает его: Documents/ПлатежноеПоручение/Forms/ФормаДокумента/Ext/Form/Module.bsl:
// 1496-1502; проверка заполнения не требует: Documents/ПлатежноеПоручение/Ext/ObjectModule.bsl:1659-1664). Поручение без контрагента, строка плана
// без контрагента - основа берется (ДокументОснование - поручение, корреспонденция плана, предупреждений нет). Парный отказ (контрагент у поручения
// есть, в плане нет) - Проверка_ПоручениеНеПроходит_НеБерется, случай "КонтрагентаВПланеНет".
Процедура Поручение_БезКонтрагента_ПланБезКонтрагента_Берется() Экспорт

	КорреспонденцияПлана = ПредопределенноеЗначение("ПланСчетов.Управленческий.ПрочиеРасходы");
	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.ЛичныеСредстваПредпринимателя, Новый Структура("Корреспонденция", КорреспонденцияПлана), Истина);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Поручение, "Контрагент")), "Предусловие: у поручения контрагента нет").ЭтоЛожь();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуПоручения(План, Основа, Новый Структура("Корреспонденция", КорреспонденцияПлана));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаПлана.Контрагент), "Предусловие: в плане контрагента нет").ЭтоЛожь();

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект <> Неопределено, "Документ записан (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, "Основа взята - ДокументОснование - поручение").Равно(Основа.Поручение);
	ЮТест.ОжидаетЧто(Объект.Корреспонденция, "Корреспонденция плана").Равно(КорреспонденцияПлана);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), "Предупреждений нет").Равно(0);

КонецПроцедуры

// D21: проверка поручения ДО вызова метода: организация поручения, пометка на удаление, "Оплачено" (между распознаванием и записью поручение
// могли оплатить другим запуском), контрагент (в плане другой). Поручение не проводится - проверки "проведено" нет. Провал - основа не берется,
// документ заполняется без нее, одно предупреждение по полю ПлатежноеПоручение.
Процедура Проверка_ПоручениеНеПроходит_НеБерется(Описание, Случай, ФрагментПричины) Экспорт

	Настройки = Новый Структура;
	Если Случай = "ДругаяОрганизация" Тогда
		ДругаяОрганизация = СМП_ТестыДанныеУНФ.ДругаяОрганизация();
		Если Не ЗначениеЗаполнено(ДругаяОрганизация) Тогда
			ЮТест.Пропустить("В базе нет второй организации: нечем отличить организацию поручения от организации документа");
			Возврат;
		КонецЕсли;
		Настройки.Вставить("Организация", ДругаяОрганизация);
	ИначеЕсли Случай = "Оплачено" Тогда
		Настройки.Вставить("Оплачено", Истина);
	ИначеЕсли Случай = "ПомеченоНаУдаление" Тогда
		Настройки.Вставить("ПометкаУдаления", Истина);
	КонецЕсли;

	Основа = НовоеПоручение(Перечисления.ВидыОперацийПлатежноеПоручение.Оплата, Настройки);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуПоручения(План, Основа, Новый Структура);
	Если Случай = "КонтрагентДругой" Тогда
		Другой = СМП_ТестыЗаписиОснование.СценарийДругогоКонтрагента("РС.Заказ");
		СтрокаПлана.Контрагент = Другой.Контрагент;
		СтрокаПлана.Договор = Другой.Договор;
	ИначеЕсли Случай = "КонтрагентаВПланеНет" Тогда
		// Поручение выписано на контрагента, а распознавание в операции контрагента не нашло: основа чужая, проверка при пустом плане не пропускается.
		СтрокаПлана.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		СтрокаПлана.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект <> Неопределено, Описание + ": документ записан (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.ДокументОснование), Описание + ": основа не взята - ДокументОснование пусто").ЭтоЛожь();
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": ровно одно предупреждение (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")")
		.Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, Описание + ": поле предупреждения").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": причина названа").Содержит(НРег(ФрагментПричины));

КонецПроцедуры

#КонецОбласти

#Область Сторож

Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Платежное поручение фикстуры на контрагента с договором "с поставщиком". Настройки - ключи НовоеПлатежноеПоручение (Статья, Корреспонденция,
// Оплачено, ПометкаУдаления, Организация). Возвращает: Контрагент, Договор, Поручение, Сумма, ВидПоручения.
Функция НовоеПоручение(ВидПоручения, Настройки, БезКонтрагента = Ложь)

	Если БезКонтрагента Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Иначе
		Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
			Истина, Истина, Истина, Ложь));
		Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", Перечисления.ВидыДоговоров.СПоставщиком));
	КонецЕсли;
	Сумма = 700;
	Полные = Новый Структура("Контрагент, Договор, Сумма, ВидОперации", Контрагент, Договор, Сумма, ВидПоручения);
	Для Каждого Элемент Из Настройки Цикл
		Полные.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Полные);

	Возврат Новый Структура("Контрагент, Договор, Поручение, Сумма, ВидПоручения", Контрагент, Договор, Поручение, Сумма, ВидПоручения);

КонецФункции

// Строка плана списания по поручению: вид операции - соответствие вида поручения (как в распознавании: Оплата -> Поставщику, личные
// средства -> ЛичныеСредстваПредпринимателя), контрагент и договор поручения, сумма поручения. Решения - значения колонок плана сверх основы.
Функция ДобавитьСтрокуПоручения(План, Основа, Решения)

	Если Основа.ВидПоручения = Перечисления.ВидыОперацийПлатежноеПоручение.ЛичныеСредстваПредпринимателя Тогда
		ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ЛичныеСредстваПредпринимателя;
	Иначе
		ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Поставщику;
	КонецЕсли;
	Сценарий = Новый Структура;
	Сценарий.Вставить("Вид", "РасходСоСчета");
	Сценарий.Вставить("Контрагент", Основа.Контрагент);
	Сценарий.Вставить("Договор", Основа.Договор);
	Сценарий.Вставить("Статья", Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщикам);
	Сценарий.Вставить("ВидОперации", ВидОперации);
	Настройки = Новый Структура("Сумма, ПлатежноеПоручение", Основа.Сумма, Основа.Поручение);
	Для Каждого Элемент Из Решения Цикл
		Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Настройки);

КонецФункции

#КонецОбласти
