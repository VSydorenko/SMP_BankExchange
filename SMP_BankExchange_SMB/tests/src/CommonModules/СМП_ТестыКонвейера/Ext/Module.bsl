// Тесты конвейера регламента (план 5б, задача 3, тесты 1 и 2). Продукт - только через СМП_ТестыВызовПродукта и Вычислить.
//
// Тест 1 - контракт курсора: чистая НовыйКурсор (полное чтение, временный сбой записи, постоянные отказы, стена конектора, доба над стеной, назад не идет).
// Мутации: убрать ГраницаЗаписи из Мин (НовыйКурсор) -> красный «сбой записи»; убрать границу отрезка (Мин(Конец, ГраницаДоверия) -> Конец,
// ГраницаЧтения) -> красный «стена покрывает»; убрать МоментЧтения в (г) -> красный «сегодняшняя доба».
//
// Тест 2 - конвейер на воспроизведении записей 5а, два сценария:
//  (1) С1: ответ банка с эхом сеансового токена -> состояние и событие журнала (одна ТекстСостояния) без секрета; контроль - метка *** и текст отказа.
//      Мутация: ядро без маскирования (ЗавершитьЧтение без УбратьИзКолонки диагностики) -> красный.
//  (2) временный сбой записи (шов ИтогЗаписи: исключение записи детерминированно не вызвать) и постоянный отказ -> курсор не дальше доби перед сбоем,
//      отказ в НедочитанныеДни, состояние «действие человека». Мутации: убрать ГраницаЗаписи из хода курсора / считать ее постоянным отказом -> красный.

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Конвейер: ход курсора (план 5б, тест 1)")
			.ДобавитьСерверныйТест("НовыйКурсор_Сценарий")
				.СПараметрами("полное чтение: до последних полных суток границы доверия", "ПолноеЧтение", "20260513", 0)
				.СПараметрами("граница в полночь: сутки до нее полные", "ГраницаВПолночь", "20260513", 0)
				.СПараметрами("сбой записи: не дальше доби перед ним", "СбойЗаписи", "20260511", 0)
				.СПараметрами("постоянный отказ: курсор идет дальше, доба в отметках", "ПостоянныйОтказ", "20260513", 1)
				.СПараметрами("невалидная строка с датой: курсор дальше, доба в отметках", "НевалиднаяСДатой", "20260513", 1)
				.СПараметрами("невалидная строка без даты: курсор стоит", "НевалиднаяБезДаты", "00010101", 0)
				.СПараметрами("стена покрывает первую новую доба: до Мин(Б, граница отрезка)", "СтенаПокрывает", "20260512", 0)
				.СПараметрами("стена: разрыв отрезка - без движения", "СтенаРазрыв", "00010101", 0)
				.СПараметрами("доба над стеной: курсор за нее, отметка доби", "ДобаНадСтеной", "20260511", 1)
				.СПараметрами("сегодняшняя доба над стеной: еще не закончена, курсор стоит", "СегодняшняяДоба", "00010101", 0)
				.СПараметрами("назад курсор не идет", "НазадНеИдет", "00010101", 0)
		.ДобавитьТестовыйНабор("Конвейер на воспроизведении (план 5б, тест 2)")
			.ДобавитьСерверныйТест("Конвейер_СекретыНеВСостоянииИСобытии").ВТранзакции()
			.ДобавитьСерверныйТест("Конвейер_СбойЗаписиИПостоянныйОтказ").ВТранзакции();

КонецПроцедуры

#Область Тест1

// База сценариев: курсор К = 10.05.2026; Д(Н) - начало суток К + Н.
Процедура НовыйКурсор_Сценарий(Описание, Сценарий, Ожидаемый, ЧислоОтметок) Экспорт

	К = Д(0);
	Поля = Новый Структура("НачалоПериода, КонецПериода, ГраницаДоверия, ЧтениеПолное", Д(-2), КонецДня(Д(5)), Д(4) + 43200, Истина);

	Если Сценарий = "ПолноеЧтение" Тогда
		// значения по умолчанию: принято, полное, граница доверия - середина суток Д(4)
	ИначеЕсли Сценарий = "ГраницаВПолночь" Тогда
		Поля.ГраницаДоверия = Д(4);
	ИначеЕсли Сценарий = "СбойЗаписи" Тогда
		Поля.Вставить("ГраницаЗаписи", Д(2) + 36000);
	ИначеЕсли Сценарий = "ПостоянныйОтказ" Тогда
		Отказы = Новый Массив;
		Отказы.Добавить(Новый Структура("Дата, Сумма, Направление, Причина", Д(2) + 32400, 10, "Списание", "тест"));
		Поля.Вставить("ПостоянныеОтказы", Отказы);
	ИначеЕсли Сценарий = "НевалиднаяСДатой" Тогда
		Строки = Новый Массив;
		Строки.Добавить(Новый Структура("Дата, Сумма, Направление, Причина", Д(2) + 3600, 1, "Списание", "Сумма"));
		Поля.Вставить("НевалидныеСтроки", Строки);
	ИначеЕсли Сценарий = "НевалиднаяБезДаты" Тогда
		Строки = Новый Массив;
		Строки.Добавить(Новый Структура("Дата, Сумма, Направление, Причина", Дата(1, 1, 1), 1, "Списание", "Дата"));
		Поля.Вставить("НевалидныеСтроки", Строки);
	ИначеЕсли Сценарий = "СтенаПокрывает" Тогда
		// отрезок [Д(-2); Д(4)+12:00] покрывает начало Д(1); кандидат (неостаточная операция) внутри отрезка - Д(3)+08:00: за ним курсор не идет
		Поля.Вставить("ПрочитанныйОтрезок", Новый Структура("Начало, Конец, ГраницаДоверия", Д(-2), Д(4) + 43200, Д(3) + 28800));
		Поля.ЧтениеПолное = Ложь;
		Поля.Вставить("КлассОтказа", "ДействиеЧеловека");
	ИначеЕсли Сценарий = "СтенаРазрыв" Тогда
		Поля.Вставить("ПрочитанныйОтрезок", Новый Структура("Начало, Конец, ГраницаДоверия", Д(2), Д(4), Д(4)));
		Поля.ЧтениеПолное = Ложь;
		Поля.Вставить("КлассОтказа", "ДействиеЧеловека");
	ИначеЕсли Сценарий = "ДобаНадСтеной" Или Сценарий = "СегодняшняяДоба" Тогда
		// чтение ровно суток после курсора, доба сама превышает стену; граница кандидатов - внутри нее
		Поля.НачалоПериода = Д(1);
		Поля.КонецПериода = КонецДня(Д(1));
		Поля.Вставить("ПрочитанныйОтрезок", Новый Структура("Начало, Конец, ГраницаДоверия", Д(1), Д(1) + 43200, Д(1) + 21600));
		Поля.ЧтениеПолное = Ложь;
		Поля.Вставить("КлассОтказа", "ДействиеЧеловека");
		Поля.Вставить("МоментЧтения", ?(Сценарий = "ДобаНадСтеной", Д(3), Д(1) + 43200));
	ИначеЕсли Сценарий = "НазадНеИдет" Тогда
		Поля.ГраницаДоверия = Д(0) + 43200;
	Иначе
		ВызватьИсключение "НовыйКурсор_Сценарий: неизвестный сценарий " + Сценарий;
	КонецЕсли;

	Итог = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.НовыйПроход", ПараметрыВызова(Д(-2), КонецДня(Д(5))));
	ЗаполнитьЗначенияСвойств(Итог, Поля);
	Решение = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.НовыйКурсор", ПараметрыВызова(К, Итог));

	ЮТест.ОжидаетЧто(СутокСтрокой(Решение.Курсор), Описание + ": курсор").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(Решение.Отметки.Количество(), Описание + ": число отметок").Равно(ЧислоОтметок);

	Если Сценарий = "ПостоянныйОтказ" Или Сценарий = "НевалиднаяСДатой" Тогда
		ЮТест.ОжидаетЧто(СутокСтрокой(Решение.Отметки[0].Дата), Описание + ": доба отметки").Равно(СутокСтрокой(Д(2)));
	ИначеЕсли Сценарий = "ДобаНадСтеной" Тогда
		ЮТест.ОжидаетЧто(СутокСтрокой(Решение.Отметки[0].Дата), Описание + ": доба отметки").Равно(СутокСтрокой(Д(1)));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тест2

// (1) С1: банк отвечает отказом с эхом сеансового токена; сеансовый токен вырезает только ядро (СекретыСостояния), поэтому мутация ядра красит именно этот сценарий.
// Конвейер с настоящим составом записи: ПУМБ, автор - ответственный записи, период первого запуска - сутки «сегодня» по киевскому времени транспорта.
Процедура Конвейер_СекретыНеВСостоянииИСобытии() Экспорт

	Учетные = Новый Структура("ИД, Токен, Логин, Пароль", "СМП_ТЕСТ_ИД_7Hk2", "СМП_ТЕСТ_СЕКРЕТ_Lm4Pq9", "  tst.user@example.invalid ", "p@ss w0rd&Zt=5");
	Сеанс = "tok.Qw8/Rt42+Mn=Zx";
	Секреты = Новый Структура;
	Для Каждого Значение Из Учетные Цикл
		Секреты.Вставить(Значение.Ключ, Значение.Значение);
	КонецЦикла;
	Секреты.Вставить("СеансовыйТокен", Сеанс);

	Обмены = Новый Массив;
	Обмены.Добавить(ТекстОбменаПУМБ("POST", "auth.fuib.com", Неопределено, "/auth/realms/VegaNet/protocol/openid-connect/token", 200, Новый Структура("access_token", Сеанс)));
	Обмены.Добавить(ТекстОбменаПУМБ("GET", "service.fuib.com", 4103, "/war_veganet_api/account", 401, Новый Структура("error_description",
		"Сессия отклонена: bearer " + Сеанс + "; верхний регистр " + ВРег(Сеанс) + "; в URL " + ТекстURL(Сеанс))));

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	УчетнаяЗапись = НоваяУчетнаяЗапись("СМП_Конвейер_С1", Счет, Организация, "ПУМБ", СМП_ТестыДанныеУНФ.НовыйПользователь(), Учетные);

	Транспорт = Обработки.СМП_ТестТранспортВоспроизведение.Создать();
	Транспорт.ЗагрузитьОбмены(Обмены);
	МоментЧтения = Дата(2026, 3, 10, 12, 0, 0);
	Транспорт.ЗаданныйМомент = МоментЧтения;

	Итог = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.ОбменПоУчетнойЗаписи", ПараметрыВызова(УчетнаяЗапись, Транспорт));
	Состояние = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.СостояниеУчетнойЗаписи", ПараметрыВызова(УчетнаяЗапись));

	// Контроль непустоты: тело с секретом дошло до конектора (транспорт отдал оба обмена), состояние записано и несет метку и текст отказа.
	ЮТест.ОжидаетЧто(СтрСоединить(Транспорт.Проверить(), "; "), "транспорт отдал все записанные обмены").Равно("");
	ЮТест.ОжидаетЧто(Итог.Результат = Вычислить("Перечисления.СМП_РезультатыОбменаСБанком.ДействиеЧеловека"), "отказ банка - действие человека, без исключения").ЭтоИстина();
	ЮТест.ОжидаетЧто(Состояние.ТекстОшибки, "текст состояния - тот же, что вернул запуск").Равно(Итог.ТекстОшибки);
	ЮТест.ОжидаетЧто(Состояние.ТекстОшибки, "контроль: метка маскирования в тексте состояния").Содержит("***");
	ЮТест.ОжидаетЧто(Состояние.ТекстОшибки, "контроль: текст отказа банка в состоянии").Содержит("Сессия отклонена");
	ЮТест.ОжидаетЧто(СутокСтрокой(Состояние.НачалоРегламента), "первый запуск без курсора: начало регламента - сегодня по киевскому времени")
		.Равно(СутокСтрокой(НачалоДня(КиевскоеВремя(МоментЧтения))));

	ТекстыСобытий = ТекстыСобытийКонвейера();
	ЮТест.ОжидаетЧто(ТекстыСобытий.Количество() > 0, "контроль: событие журнала СМП.Регламент.Обмен записано").ЭтоИстина();

	Все = НРег(СтрСоединить(ТекстыСобытий, Символы.ПС) + Символы.ПС + Состояние.ТекстОшибки);
	Для Каждого Секрет Из Секреты Цикл
		Для Каждого Форма Из ФормыСекрета(Секрет.Значение) Цикл
			ЮТест.ОжидаетЧто(Все, "секрет " + Секрет.Ключ + ", форма " + Форма.Вид + ": нет в состоянии и событии журнала").НеСодержит(НРег(Форма.Текст));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// (2) Курсор К хранится в регистре; период запуска - [К - 2; сегодня], его воспроизводит запись 5а (чтение ровно по периоду конвейера, не меньше шести суток).
// Контроль: запуск без сбоя записи двигает курсор. Затем сбой записи в сутках К + 1 (шов ИтогЗаписи: ГраницаЗаписи) и постоянный отказ в сутках К + 2:
// курсор остается К, отказ - в НедочитанныеДни, результат - действие человека.
Процедура Конвейер_СбойЗаписиИПостоянныйОтказ() Экспорт

	Запись = ПодходящаяЗапись();
	ЮТест.ОжидаетЧто(Запись <> Неопределено, "в записях 5а есть запись Привата с периодом 6-31 суток, выровненным по суткам, и чтением до сегодня").ЭтоИстина();
	Параметры = Запись.Эталон["parameters"];

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = НовыйСчет(Организация, Параметры["НомерСчета"]);
	УчетнаяЗапись = НоваяУчетнаяЗапись("СМП_Конвейер_Сбой", Счет, Организация, "ПриватБанк", СМП_ТестыДанныеУНФ.НовыйПользователь(), Неопределено);
	К = НачалоДня(ДатаИзISO(Параметры["НачалоПериода"])) + 2 * 86400;

	// Контроль: без сбоя записи курсор идет дальше К.
	УстановитьКурсор(Счет, К);
	Контроль = ЗапускНаЗаписи(Запись, УчетнаяЗапись, Новый Структура("ИтогЗаписи", ИтогЗаписи(Неопределено, Новый Массив)));
	ЮТест.ОжидаетЧто(СтрСоединить(Контроль.Транспорт.Проверить(), "; "), "контроль: период конвейера совпал с записью 5а").Равно("");
	ЮТест.ОжидаетЧто(Контроль.Итог.Курсор > К, "контроль: чтение без сбоя записи двигает курсор").ЭтоИстина();

	// Сбой записи в сутках К + 1, постоянный отказ в сутках К + 2.
	УстановитьКурсор(Счет, К);
	Отказы = Новый Массив;
	Отказы.Добавить(Новый Структура("Дата, Сумма, Направление, Причина", К + 2 * 86400 + 3600, 15, "Списание", "тест: строка отклонена записью"));
	Результат = ЗапускНаЗаписи(Запись, УчетнаяЗапись, Новый Структура("ИтогЗаписи", ИтогЗаписи(К + 86400 + 36000, Отказы)));
	Состояние = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.СостояниеУчетнойЗаписи", ПараметрыВызова(УчетнаяЗапись));

	ЮТест.ОжидаетЧто(СутокСтрокой(Результат.Итог.Курсор), "курсор не дальше доби перед сбоем записи").Равно(СутокСтрокой(К));
	ЮТест.ОжидаетЧто(Результат.Итог.Результат = Вычислить("Перечисления.СМП_РезультатыОбменаСБанком.ДействиеЧеловека"), "сбой записи и постоянный отказ - действие человека").ЭтоИстина();
	ЮТест.ОжидаетЧто(Состояние.НедочитанныеДни, "постоянный отказ - в НедочитанныеДни").Содержит(Формат(К + 2 * 86400, "ДФ=yyyyMMdd"));
	ЮТест.ОжидаетЧто(Состояние.НедочитанныеДни, "текст отметки - отказ с причиной").Содержит("тест: строка отклонена записью");

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция Д(Номер)

	Возврат Дата(2026, 5, 10) + Номер * 86400;

КонецФункции

Функция СутокСтрокой(Значение)

	Если Значение = Неопределено Тогда
		Возврат "00010101";
	КонецЕсли;
	Возврат Формат(НачалоДня(Значение), "ДФ=yyyyMMdd");

КонецФункции

Функция КиевскоеВремя(МоментUTC)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя", ПараметрыВызова(МоментUTC - Дата(1970, 1, 1)));

КонецФункции

Функция ИтогЗаписи(ГраницаЗаписи, ПостоянныеОтказы)

	Возврат Новый Структура("Выполнено, ТекстОтказа, Создано, НеПроведено, ГраницаЗаписи, ПостоянныеОтказы", Истина, "", 0, 0, ГраницаЗаписи, ПостоянныеОтказы);

КонецФункции

Функция ЗапускНаЗаписи(Запись, УчетнаяЗапись, Шов)

	Пакет = СМП_ТестЗаписиAPI.Записи("privat", Запись.Вид)[Запись.Ид];
	Транспорт = СМП_ТестЗаписиAPI.ТранспортИзПакета(Пакет);
	Транспорт.ЗаданныйМомент = ДатаИзISO(Запись.Эталон["parameters"]["МоментЧтения"]);
	Итог = СМП_ТестыВызовПродукта.Вызвать("СМП_ОбменСБанкомКонвейер.ОбменПоУчетнойЗаписиСоШвом", ПараметрыВызова(УчетнаяЗапись, Транспорт, Шов));
	Возврат Новый Структура("Итог, Транспорт", Итог, Транспорт);

КонецФункции

// Запись набора privat: чтение полное (класс отказа пуст), с операциями, период выровнен по суткам, 6-31 сутки, конец периода - сегодня по киевскому
// времени момента чтения: ровно тот период, который конвейер вычислит от курсора К = начало + 2 суток.
Функция ПодходящаяЗапись()

	КлассНет = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.КлассОтказаНет");
	Для Каждого Вид Из СМП_ТестЗаписиAPI.Виды() Цикл
		Для Каждого Ид Из СМП_ТестЗаписиAPI.Идентификаторы("privat", Вид) Цикл
			Эталон = СМП_ТестЗаписиAPI.Эталон("privat", Вид, Ид);
			Параметры = Эталон["parameters"];
			Если Параметры["ПотолокСтраниц"] <> Неопределено Или Параметры["НачалоПериода"] = Неопределено Или Параметры["МоментЧтения"] = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Начало = ДатаИзISO(Параметры["НачалоПериода"]);
			Конец = ДатаИзISO(Параметры["КонецПериода"]);
			Если Начало <> НачалоДня(Начало) Или Конец <> КонецДня(Конец) Тогда
				Продолжить;
			КонецЕсли;
			Суток = (НачалоДня(Конец) - Начало) / 86400 + 1;
			Если Суток < 6 Или Суток > 31 Тогда
				Продолжить;
			КонецЕсли;
			Сегодня = НачалоДня(КиевскоеВремя(ДатаИзISO(Параметры["МоментЧтения"])));
			Если НачалоДня(Конец) <> Сегодня Тогда
				Продолжить;
			КонецЕсли;
			Ожидаемое = Эталон["expected"];
			Если Ожидаемое["КлассОтказа"] = КлассНет И Ожидаемое["Операции"].Количество() > 0 Тогда
				Возврат Новый Структура("Вид, Ид, Эталон", Вид, Ид, Эталон);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Процедура УстановитьКурсор(Счет, Курсор)

	Менеджер = Вычислить("РегистрыСведений.СМП_НомерПоследнейТранзакции.СоздатьМенеджерЗаписи()");
	Менеджер.БанковскийСчет = Счет;
	Менеджер.ДатаТранзакции = Курсор;
	Менеджер.Записать(Истина);

КонецПроцедуры

Функция НовыйСчет(Организация, НомерСчета)

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация).ПолучитьОбъект();
	Счет.НомерСчета = НомерСчета;
	Счет.ОбменДанными.Загрузка = Истина;
	Счет.Записать();
	Возврат Счет.Ссылка;

КонецФункции

Функция НоваяУчетнаяЗапись(Наименование, Счет, Организация, ИмяБанка, Ответственный, Учетные)

	Запись = Вычислить("Справочники.СМП_УчетныеЗаписиБанков.СоздатьЭлемент()");
	Запись.Наименование = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + Наименование;
	Запись.Банк = Вычислить("Перечисления.СМП_ПоддерживаемыеИнтеграцииСБанками." + ИмяБанка);
	Запись.БанковскийСчет = Счет;
	Запись.Организация = Организация;
	Запись.Ответственный = Ответственный;
	Если Учетные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Запись, Учетные);
	Иначе
		Запись.ИД = "тест-ид";
		Запись.Токен = "тест-токен";
	КонецЕсли;
	Запись.Записать();
	Возврат Запись.Ссылка;

КонецФункции

// Тексты событий СМП.Регламент.Обмен за последние минуты (журнал регистрации пишется вне транзакции теста).
Функция ТекстыСобытийКонвейера()

	Журнал = Новый ТаблицаЗначений;
	Отбор = Новый Структура("Событие, ДатаНачала", "СМП.Регламент.Обмен", ТекущаяДатаСеанса() - 600);
	ВыгрузитьЖурналРегистрации(Журнал, Отбор);
	Тексты = Новый Массив;
	Для Каждого Строка Из Журнал Цикл
		Тексты.Добавить(Строка.Комментарий);
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ФормыСекрета(Значение)

	Формы = Новый Массив;
	Формы.Добавить(Новый Структура("Вид, Текст", "как есть", Значение));
	Формы.Добавить(Новый Структура("Вид, Текст", "после СокрЛП", СокрЛП(Значение)));
	Формы.Добавить(Новый Структура("Вид, Текст", "URL", ТекстURL(Значение)));
	Формы.Добавить(Новый Структура("Вид, Текст", "URL после СокрЛП", ТекстURL(СокрЛП(Значение))));
	Возврат Формы;

КонецФункции

Функция ТекстURL(Значение)

	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Один обмен формата smp-api-exchange (версия 2: порт), ответ с JSON-телом из структуры.
Функция ТекстОбменаПУМБ(Метод, Хост, Порт, Путь, Статус, ТелоОтвета)

	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, ТелоОтвета);
	ТелоБайты = ПолучитьДвоичныеДанныеИзСтроки(ЗаписьТела.Закрыть(), "UTF-8", Ложь);

	Пара = Новый Массив;
	Пара.Добавить("content-type");
	Пара.Добавить("application/json; charset=utf-8");
	Заголовки = Новый Массив;
	Заголовки.Добавить(Пара);

	Ответ = Новый Соответствие;
	Ответ.Вставить("status", Статус);
	Ответ.Вставить("headers", Заголовки);
	Ответ.Вставить("bodyBase64", СтрЗаменить(СтрЗаменить(Base64Строка(ТелоБайты), Символы.ПС, ""), Символы.ВК, ""));

	Запрос = Новый Соответствие;
	Запрос.Вставить("method", Метод);
	Запрос.Вставить("host", Хост);
	Если Порт <> Неопределено Тогда
		Запрос.Вставить("port", Порт);
	КонецЕсли;
	Запрос.Вставить("path", Путь);
	Запрос.Вставить("query", "");

	Обмен = Новый Соответствие;
	Обмен.Вставить("format", "smp-api-exchange");
	Обмен.Вставить("formatVersion", 2);
	Обмен.Вставить("scenario", "СМП_ТЕСТ_КОНВЕЙЕР");
	Обмен.Вставить("startedUtc", "2026-03-10T12:00:00.000Z");
	Обмен.Вставить("request", Запрос);
	Обмен.Вставить("response", Ответ);

	ЗаписьОбмена = Новый ЗаписьJSON;
	ЗаписьОбмена.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьОбмена, Обмен);
	Возврат ЗаписьОбмена.Закрыть();

КонецФункции

Функция ПараметрыВызова(А1, А2 = Null, А3 = Null)

	Массив = Новый Массив;
	Массив.Добавить(А1);
	Если ТипЗнч(А2) <> Тип("Null") Тогда
		Массив.Добавить(А2);
	КонецЕсли;
	Если ТипЗнч(А3) <> Тип("Null") Тогда
		Массив.Добавить(А3);
	КонецЕсли;
	Возврат Массив;

КонецФункции

Функция ДатаИзISO(Текст)

	Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "T", ""), ":", ""));

КонецФункции

#КонецОбласти
