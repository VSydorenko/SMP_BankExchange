// Построитель тестовых данных УНФ для расширения SMP_BankExchange_SMB.
//
// Модуль без сценариев: его вызывают тесты (СМП_ТестыФикстур и следующие). Правила - docs/architecture/testing.md.
//
// Инварианты:
//  - Каждая функция, пишущая в базу, ПЕРВОЙ строкой проверяет, что транзакция активна, и иначе
//    отказывает исключением. База агента общая: запись вне транзакции теста осталась бы в ней навсегда.
//  - Сразу после охраны каждая такая функция проверяет тип обязательных параметров и ДО любой записи
//    отказывает исключением с другим текстом ("неверный тип параметра"). Поэтому вызов с заведомо
//    неверным аргументом без охраны падает на типе, а не пишет в базу: на этом держится тест охраны.
//  - Возвращаются ссылки, а не объекты. Значения, от которых зависит измерение, - параметры.
//  - Константы и настройки организаций построитель только ЧИТАЕТ, курсы валют не пишет.
//  - Имена и комментарии объектов начинаются с ПрефиксФикстуры(); сторож остатков ищет по нему.
//  - Валюта договоров и документов - НАЦИОНАЛЬНАЯ: банковские счета организаций в базе в ней,
//    а валюта учета (USD) от национальной (UAH) отличается.

#Область ПрефиксИПодсчет

// Префикс имени фикстуры: Наименование справочников, Комментарий документов.
Функция ПрефиксФикстуры() Экспорт

	Возврат "СМП_ТЕСТ_";

КонецФункции

// Считает объекты фикстуры (с префиксом ПрефиксФикстуры()) по типам, которые создает построитель.
// Единственная функция подсчета: ее вызывают и сторож остатков, и сторож, видящий фикстуру.
// Договоры считаются и по собственному наименованию, и по наименованию владельца: запись контрагента
// сама порождает договор по умолчанию, а имя ему дает платформа. Банковские счета - только по
// собственному наименованию.
//
// Возвращаемое значение:
//  Соответствие - ключ: Строка, вид и имя объекта ("Справочник.Контрагенты"), значение: Число.
Функция КоличествоОбъектовФикстурыПоТипам() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ""Справочник.Контрагенты"" КАК Тип, КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Справочник.Контрагенты КАК Т
		|ГДЕ Т.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Справочник.ДоговорыКонтрагентов"", КОЛИЧЕСТВО(*)
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Т
		|ГДЕ Т.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|	ИЛИ Т.Владелец.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Справочник.БанковскиеСчета"", КОЛИЧЕСТВО(*)
		|ИЗ Справочник.БанковскиеСчета КАК Т
		|ГДЕ Т.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Справочник.Номенклатура"", КОЛИЧЕСТВО(*)
		|ИЗ Справочник.Номенклатура КАК Т
		|ГДЕ Т.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.ЗаказПокупателя"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.ЗаказПокупателя КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.СчетНаОплату"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.СчетНаОплату КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.ЗаказПоставщику"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.ЗаказПоставщику КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.СчетНаОплатуПоставщика"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.СчетНаОплатуПоставщика КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.ПоступлениеНаСчет"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.ПоступлениеНаСчет КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.РасходСоСчета"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.РасходСоСчета КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.АктВыполненныхРабот"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.АктВыполненныхРабот КАК Т
		|ГДЕ Т.Комментарий ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""");
	Запрос.УстановитьПараметр("Шаблон", "СМП\_ТЕСТ\_%");

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Тип, Выборка.Количество);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КонтрольныеСуммы

// Новый код ЕДРПОУ (8 цифр) с правильной контрольной цифрой.
Функция НовыйЕДРПОУ() Экспорт

	// Диапазон 10000000..59999999: граница весов (30 и 60 млн) не зависит от последней цифры.
	ГСЧ = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());
	Код = XMLСтрока(ГСЧ.СлучайноеЧисло(10000000, 59999999));
	Цифры = Лев(Код, 7);

	Возврат Цифры + XMLСтрока(КонтрольнаяЦифраЕДРПОУ(Цифры, Число(Код)));

КонецФункции

// Проверяет контрольную цифру кода ЕДРПОУ.
Функция ЕДРПОУКорректен(Код) Экспорт

	Если ТипЗнч(Код) <> Тип("Строка") Или СтрДлина(Код) <> 8 Или Не СтрокаТолькоЦифры(Код) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат XMLСтрока(КонтрольнаяЦифраЕДРПОУ(Лев(Код, 7), Число(Код))) = Прав(Код, 1);

КонецФункции

// Новый IBAN (UA, 29 символов) с правильной контрольной суммой.
Функция НовыйIBAN() Экспорт

	ГСЧ = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());
	BBAN = "";
	Для Индекс = 1 По 25 Цикл
		BBAN = BBAN + XMLСтрока(ГСЧ.СлучайноеЧисло(0, 9));
	КонецЦикла;

	// UA -> 30 10, контрольные цифры 00 в конец; проверочное число = 98 - (остаток по 97).
	Остаток = ОстатокОтДеления97(BBAN + "301000");
	Возврат "UA" + Прав("0" + XMLСтрока(98 - Остаток), 2) + BBAN;

КонецФункции

// Проверяет контрольную сумму IBAN (mod 97) и длину украинского номера.
Функция IBANКорректен(Номер) Экспорт

	Если ТипЗнч(Номер) <> Тип("Строка") Или СтрДлина(Номер) <> 29 Или Лев(Номер, 2) <> "UA" Или Не СтрокаТолькоЦифры(Сред(Номер, 3)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ОстатокОтДеления97(Сред(Номер, 5) + "3010" + Сред(Номер, 3, 2)) = 1;

КонецФункции

// Контрольная цифра ЕДРПОУ (0..9) по первым семи цифрам и числовому значению кода. Веса 1..7; для кодов
// от 30 до 60 млн - 7,1,2,3,4,5,6; остаток 10 - второй проход с весами, увеличенными на 2; снова 10 - ноль.
Функция КонтрольнаяЦифраЕДРПОУ(Цифры7, ЧисловоеЗначениеКода)

	Если ЧисловоеЗначениеКода < 30000000 Или ЧисловоеЗначениеКода > 60000000 Тогда
		Веса = СтрРазделить("1,2,3,4,5,6,7", ",");
	Иначе
		Веса = СтрРазделить("7,1,2,3,4,5,6", ",");
	КонецЕсли;

	Остаток = ВзвешеннаяСуммаПо11(Цифры7, Веса, 0);
	Если Остаток = 10 Тогда
		Остаток = ВзвешеннаяСуммаПо11(Цифры7, Веса, 2);
		Если Остаток = 10 Тогда
			Остаток = 0;
		КонецЕсли;
	КонецЕсли;

	Возврат Остаток;

КонецФункции

Функция ВзвешеннаяСуммаПо11(Цифры7, Веса, Добавка)

	Сумма = 0;
	Для Индекс = 1 По 7 Цикл
		Сумма = Сумма + Число(Сред(Цифры7, Индекс, 1)) * (Число(Веса[Индекс - 1]) + Добавка);
	КонецЦикла;

	Возврат Сумма % 11;

КонецФункции

Функция ОстатокОтДеления97(ЦифровойТекст)

	Остаток = 0;
	Для Индекс = 1 По СтрДлина(ЦифровойТекст) Цикл
		Остаток = (Остаток * 10 + Число(Сред(ЦифровойТекст, Индекс, 1))) % 97;
	КонецЦикла;

	Возврат Остаток;

КонецФункции

Функция СтрокаТолькоЦифры(Строка)

	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если Найти("0123456789", Сред(Строка, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Строка) > 0;

КонецФункции

#КонецОбласти

#Область ДанныеИзБазы

// Организация по правилу выбора (known-state.md): первая по коду среди не помеченных на удаление
// и имеющих живой банковский счет в национальной валюте. Не создает. Если организации по правилу нет,
// отказывает исключением с названной причиной, а не возвращает пустую ссылку: пустая организация
// дала бы документы фикстуры без организации и красные тесты с чужой причиной.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - заполненная ссылка
Функция Организация() Экспорт

	Возврат ОрганизацияПоВалюте(Константы.НациональнаяВалюта.Получить());

КонецФункции

// Правило выбора организации с параметром "валюта счета": Организация() вызывает его с национальной
// валютой. Параметр нужен, чтобы тест мог безопасно, без изменения базы, дойти до ветки "не найдено"
// (валюта, в которой у организаций нет живого счета).
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта банковского счета организации
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - заполненная ссылка; если организации по правилу нет - исключение
Функция ОрганизацияПоВалюте(Валюта) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	О.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК О
		|ГДЕ
		|	НЕ О.ПометкаУдаления
		|	И О.Ссылка В
		|		(ВЫБРАТЬ
		|			Б.Владелец
		|		ИЗ
		|			Справочник.БанковскиеСчета КАК Б
		|		ГДЕ
		|			НЕ Б.ПометкаУдаления
		|			И НЕ Б.Недействителен
		|			И Б.ВалютаДенежныхСредств = &Национальная)
		|
		|УПОРЯДОЧИТЬ ПО
		|	О.Код");
	Запрос.УстановитьПараметр("Национальная", Валюта);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ВызватьИсключение "СМП_ТестыДанныеУНФ.Организация: организация по правилу выбора не найдена (нет не помеченной на удаление "
		+ "организации с живым банковским счетом в валюте " + Строка(Валюта) + "); правило - docs/architecture/testing.md";

КонецФункции

// Банковский счет организации, выбранной Организация(), в национальной валюте. Не создает.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - пустая ссылка, если у организации нет счета по правилу;
//                                     если нет самой организации - исключение Организация()
Функция БанковскийСчетОрганизации() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Б.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Б
		|ГДЕ
		|	Б.Владелец = &Организация
		|	И НЕ Б.ПометкаУдаления
		|	И НЕ Б.Недействителен
		|	И Б.ВалютаДенежныхСредств = &Национальная
		|
		|УПОРЯДОЧИТЬ ПО
		|	Б.Код");
	Запрос.УстановитьПараметр("Организация", Организация());
	Запрос.УстановитьПараметр("Национальная", Константы.НациональнаяВалюта.Получить());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Справочники

// Создает контрагента (юридическое лицо, резидент Украины). ЕДРПОУ - с правильной контрольной цифрой.
// Запись контрагента сама создает ему договор по умолчанию.
//
// Параметры:
//  Настройки - Структура - ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам,
//              ВестиУчетОплатыПоСчетам (Булево; обязательные), СтатьяДДСПоУмолчанию,
//              СпособРазнесенияОплатыПоУмолчанию (необязательные).
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты
Функция НовыйКонтрагент(Настройки) Экспорт

	ПроверитьТранзакцию("НовыйКонтрагент");
	ПроверитьТипПараметра("НовыйКонтрагент", "Настройки", Настройки, "Структура");

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Заполнить(Неопределено);

	Имя = ПрефиксФикстуры() + "Контрагент_" + УникальноеОкончание();
	Контрагент.Наименование = Имя;
	Контрагент.НаименованиеПолное = Имя;
	Контрагент.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЮридическоеЛицо");
	Контрагент.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Украина");
	Контрагент.КодПоЕДРПОУ = НовыйЕДРПОУ();
	Контрагент.Покупатель = Истина;
	Контрагент.Поставщик = Истина;
	Контрагент.ВестиРасчетыПоДоговорам = Настройки.ВестиРасчетыПоДоговорам;
	Контрагент.ВестиРасчетыПоДокументам = Настройки.ВестиРасчетыПоДокументам;
	Контрагент.ВестиРасчетыПоЗаказам = Настройки.ВестиРасчетыПоЗаказам;
	Контрагент.ВестиУчетОплатыПоСчетам = Настройки.ВестиУчетОплатыПоСчетам;
	Если Настройки.Свойство("СтатьяДДСПоУмолчанию") И ЗначениеЗаполнено(Настройки.СтатьяДДСПоУмолчанию) Тогда
		Контрагент.СтатьяДДСПоУмолчанию = Настройки.СтатьяДДСПоУмолчанию;
	КонецЕсли;
	Если Настройки.Свойство("СпособРазнесенияОплатыПоУмолчанию") И ЗначениеЗаполнено(Настройки.СпособРазнесенияОплатыПоУмолчанию) Тогда
		Контрагент.СпособРазнесенияОплатыПоУмолчанию = Настройки.СпособРазнесенияОплатыПоУмолчанию;
	КонецЕсли;

	ЗаписатьОбъект(Контрагент, "Контрагент");

	Возврат Контрагент.Ссылка;

КонецФункции

// Создает договор контрагента в национальной валюте на организацию, выбранную по правилу.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Настройки - Структура, Неопределено - ВидДоговора (ПеречислениеСсылка.ВидыДоговоров, по умолчанию
//              СПокупателем); необязательные СтатьяДДСПоУмолчанию, СпособРазнесенияОплатыПоУмолчанию.
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов
Функция НовыйДоговор(Контрагент, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйДоговор");
	ПроверитьТипПараметра("НовыйДоговор", "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйДоговор", "Настройки", Настройки, "Структура");
	КонецЕсли;

	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Заполнить(Новый Структура("ОснованиеЗаполнения", Контрагент));

	Договор.Наименование = ПрефиксФикстуры() + "Договор_" + УникальноеОкончание();
	Договор.Организация = Организация();
	Договор.ВалютаРасчетов = Константы.НациональнаяВалюта.Получить();
	Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем");
	Договор.НомерДоговора = УникальноеОкончание();
	Договор.ДатаДоговора = НачалоДня(ТекущаяДатаСеанса());

	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ВидДоговора") И ЗначениеЗаполнено(Настройки.ВидДоговора) Тогда
			Договор.ВидДоговора = Настройки.ВидДоговора;
		КонецЕсли;
		Если Настройки.Свойство("СтатьяДДСПоУмолчанию") И ЗначениеЗаполнено(Настройки.СтатьяДДСПоУмолчанию) Тогда
			Договор.СтатьяДДСПоУмолчанию = Настройки.СтатьяДДСПоУмолчанию;
		КонецЕсли;
		Если Настройки.Свойство("СпособРазнесенияОплатыПоУмолчанию") И ЗначениеЗаполнено(Настройки.СпособРазнесенияОплатыПоУмолчанию) Тогда
			Договор.СпособРазнесенияОплатыПоУмолчанию = Настройки.СпособРазнесенияОплатыПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

	ЗаписатьОбъект(Договор, "Договор");

	Возврат Договор.Ссылка;

КонецФункции

// Создает банковский счет контрагента с IBAN, прошедшим контрольную сумму, в национальной валюте.
// Банк берется из справочника Банки (классификатор): первый не помеченный на удаление.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета
Функция НовыйБанковскийСчетКонтрагента(Контрагент) Экспорт

	ПроверитьТранзакцию("НовыйБанковскийСчетКонтрагента");
	ПроверитьТипПараметра("НовыйБанковскийСчетКонтрагента", "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = Контрагент;
	Счет.Наименование = ПрефиксФикстуры() + "Счет_" + УникальноеОкончание();
	Счет.НомерСчета = НовыйIBAN();
	Счет.ВидСчета = "Расчетный";
	Счет.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	Счет.Банк = ПервыйБанк();

	ЗаписатьОбъект(Счет, "Банковский счет контрагента");

	Возврат Счет.Ссылка;

