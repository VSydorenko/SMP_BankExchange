// Создает акт выполненных работ покупателю с одной строкой услуги на Сумму. Проведенный акт порождает ДОЛГ
// покупателя в РасчетыСПокупателями - источник долга для измерения способа зачета "Авто" (задача 5).
// Дата акта на час раньше даты фикстуры, но не раньше начала ее суток (см. ДатаАктаДляМоментаФикстуры):
// банковский документ на дату фикстуры видит долг на свой момент, а договор и все документы теста - в одних сутках.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Договор - СправочникСсылка.ДоговорыКонтрагентов
//  Сумма - Число
//  Провести - Булево - при Ложь документ только записывается
//  Настройки - Структура, Неопределено - см. НовыйЗаказПокупателя (Дата по умолчанию - час назад от даты фикстуры, не раньше начала суток;
//              НомерВходящегоДокумента у акта нет)
//
// Возвращаемое значение:
//  ДокументСсылка.АктВыполненныхРабот
Функция НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Провести = Истина, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйАктВыполненныхРабот");
	ПроверитьТипыПараметровДокумента("НовыйАктВыполненныхРабот", Контрагент, Договор, Сумма);
	ПроверитьНастройкиДокумента("НовыйАктВыполненныхРабот", Настройки, "АктВыполненныхРабот", Провести);

	ДатаАкта = ?(Настройки <> Неопределено И Настройки.Свойство("Дата"), Настройки.Дата, ДатаАктаДляМоментаФикстуры(ДатаФикстуры()));
	Документ = Документы.АктВыполненныхРабот.СоздатьДокумент();
	Документ.Дата = ДатаАкта;
	Документ.Заполнить(Договор);
	Документ.Дата = ДатаАкта;
	Документ.Организация = ?(Настройки <> Неопределено И Настройки.Свойство("Организация"), Настройки.Организация, Организация());
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();
	ДобавитьСтрокуУслуги(Документ.РаботыИУслуги, Сумма);
	Документ.СуммаДокумента = Сумма;

	ЗаписатьДокументПоНастройкам(Документ, Провести, "Акт выполненных работ", Настройки);

	Возврат Документ.Ссылка;

КонецФункции

// Очищает договор УЖЕ ЗАПИСАННОГО документа-основания (заказ, счет, акт), не затрагивая проведение: вендор при обычной записи
// подставляет договор по умолчанию, поэтому документ с пустым договором иначе не построить. Запись идет в режиме загрузки
// обмена (обработчики и перепроведение не выполняются); документ остается проведенным.
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказПокупателя, ДокументСсылка.СчетНаОплату, ДокументСсылка.ЗаказПоставщику,
//             ДокументСсылка.СчетНаОплатуПоставщика, ДокументСсылка.АктВыполненныхРабот
//
// Возвращаемое значение:
//  ДокументСсылка - тот же документ
Функция ОчиститьДоговорДокумента(Документ) Экспорт

	ПроверитьТранзакцию("ОчиститьДоговорДокумента");
	ПроверитьТипПараметра("ОчиститьДоговорДокумента", "Документ", Документ,
		"ДокументСсылка.ЗаказПокупателя, ДокументСсылка.СчетНаОплату, ДокументСсылка.ЗаказПоставщику, ДокументСсылка.СчетНаОплатуПоставщика, ДокументСсылка.АктВыполненныхРабот");

	Объект = Документ.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ЗаписатьОбъект(Объект, "Документ без договора");

	Возврат Документ;

КонецФункции

// Создает приходную накладную (поступление от поставщика) с одной строкой УСЛУГИ (табличная часть "Расходы") на Сумму.
// Проведенная накладная порождает ДОЛГ перед поставщиком в РасчетыСПоставщиками (тип расчетов "Долг") - источник долга для
// шага 5 распознавания (документ расчетов поставщика). Услуга выбрана, чтобы не требовать склада и остатков.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Договор - СправочникСсылка.ДоговорыКонтрагентов (с поставщиком)
//  Сумма - Число
//  Провести - Булево - при Ложь документ только записывается
//  Настройки - Структура, Неопределено - см. НовыйЗаказПокупателя (НомерВходящегоДокумента у накладной есть)
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходнаяНакладная
Функция НоваяПриходнаяНакладная(Контрагент, Договор, Сумма, Провести = Истина, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НоваяПриходнаяНакладная");
	ПроверитьТипыПараметровДокумента("НоваяПриходнаяНакладная", Контрагент, Договор, Сумма);
	ПроверитьНастройкиДокумента("НоваяПриходнаяНакладная", Настройки, "ПриходнаяНакладная", Провести);

	ДругаяОрганизация = Настройки <> Неопределено И Настройки.Свойство("Организация");
	ОрганизацияДокумента = ?(ДругаяОрганизация, Настройки.Организация, Организация());
	ДатаДокумента = ?(Настройки <> Неопределено И Настройки.Свойство("Дата"), Настройки.Дата, ДатаФикстуры());

	Документ = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Документ.Заполнить(Новый Структура("Организация, Контрагент, Договор", ОрганизацияДокумента, Контрагент, Договор));
	Документ.Дата = ДатаДокумента;
	Документ.Организация = ОрганизацияДокумента;
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика");
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();
	// Проводки накладной по услуге требуют счета затрат у номенклатуры (у новой услуги он пуст): задается управленческий расход.
	Услуга = НоваяУслуга();
	УслугаОбъект = Услуга.ПолучитьОбъект();
	УслугаОбъект.СчетУчетаЗатрат = ПредопределенноеЗначение("ПланСчетов.Управленческий.УправленческиеРасходы");
	ЗаписатьОбъект(УслугаОбъект, "Услуга со счетом затрат");
	ДобавитьСтрокуУслуги(Документ.Расходы, Сумма, Услуга);
	Документ.СуммаДокумента = Сумма;

	ЗаписатьДокументПоНастройкам(Документ, Провести, "Приходная накладная", Настройки);

	Возврат Документ.Ссылка;

КонецФункции

// Создает проведенный банковский документ, частично оплачивающий основание:
// ПоступлениеНаСчет для счета/заказа покупателя, РасходСоСчета для счета/заказа поставщика.
// Табличную часть и шапку заполняет штатное заполнение на основании документа с суммой.
//
// Параметры:
//  Основание - ДокументСсылка.СчетНаОплату, ДокументСсылка.ЗаказПокупателя,
//              ДокументСсылка.СчетНаОплатуПоставщика, ДокументСсылка.ЗаказПоставщику
//  Сумма - Число - сумма оплаты (меньше суммы основания)
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета
Функция НоваяОплата(Основание, Сумма) Экспорт

	ПроверитьТранзакцию("НоваяОплата");
	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования <> Тип("ДокументСсылка.СчетНаОплату") И ТипОснования <> Тип("ДокументСсылка.ЗаказПокупателя")
		И ТипОснования <> Тип("ДокументСсылка.СчетНаОплатуПоставщика") И ТипОснования <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ОтказПоТипуПараметра("НоваяОплата", "Основание", "СчетНаОплату, ЗаказПокупателя, СчетНаОплатуПоставщика или ЗаказПоставщику", Основание);
	КонецЕсли;
	ПроверитьТипПараметра("НоваяОплата", "Сумма", Сумма, "Число");

	ИмяОснования = Основание.Метаданные().Имя;
	Если ИмяОснования = "СчетНаОплату" Или ИмяОснования = "ЗаказПокупателя" Тогда
		Документ = Документы.ПоступлениеНаСчет.СоздатьДокумент();
	ИначеЕсли ИмяОснования = "СчетНаОплатуПоставщика" Или ИмяОснования = "ЗаказПоставщику" Тогда
		Документ = Документы.РасходСоСчета.СоздатьДокумент();
	Иначе
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НоваяОплата: основание " + ИмяОснования + " не поддерживается";
	КонецЕсли;

	Документ.Дата = ДатаФикстуры();
	Документ.Заполнить(Новый Структура("Документ, Сумма", Основание, Сумма));
	Документ.Дата = ДатаФикстуры();
	Документ.СуммаДокумента = Сумма;
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();

	ЗаписатьДокумент(Документ, Истина, "Оплата");

	Возврат Документ.Ссылка;

КонецФункции

// Создает правило справочника СоответствияНазначенийПлатежаИРеквизитовПлатежа (набор реквизитов для
// подстановки по фразе в назначении платежа). Любая комбинация полей задается структурой Настройки.
//
// Параметры:
//  Настройки - Структура - ключи (все необязательные):
//   * Фраза - Строка - фраза для поиска; к ней добавляется ПрефиксФикстуры() (и уникальное окончание,
//             если фраза не задана)
//   * ФразаДословно - Строка - фраза ровно как задана (пустая, из пробелов, без префикса): для проверки правил, у
//             которых фраза пуста, и типовых фраз. Вместе с ключом Фраза не принимается. Такое правило не видно
//             сторожу остатков (он ищет по префиксу фразы), поэтому живет только внутри транзакции теста
//             (охрана транзакции действует и для него)
//   * ВидОперацииПоступленияНаСчет, ВидОперацииРасходаСоСчета, СтатьяДДС, Корреспонденция, Проект,
//     Подразделение, СМП_ВидНалога - значения реквизитов (ссылки), присваиваются как есть
//   * Код, ПометкаУдаления - стандартные реквизиты, присваиваются как есть (Код - строка до 5 знаков: для проверки
//             порядка по коду, когда порядок кодов не совпадает с порядком создания)
//
// Возвращаемое значение:
//  СправочникСсылка.СоответствияНазначенийПлатежаИРеквизитовПлатежа
Функция НовоеПравилоНазначения(Настройки) Экспорт

	ПроверитьТранзакцию("НовоеПравилоНазначения");
	ПроверитьТипПараметра("НовоеПравилоНазначения", "Настройки", Настройки, "Структура");

	// Ключ, которого нет среди реквизитов объекта, - опечатка: ЗаполнитьЗначенияСвойств молча пропустила бы его,
	// и тест измерял бы не то условие. Список реквизитов - из метаданных, не из перечня в коде.
	ОписаниеОбъекта = Метаданные.Справочники.СоответствияНазначенийПлатежаИРеквизитовПлатежа;
	Для Каждого Элемент Из Настройки Цикл
		Если Элемент.Ключ <> "Фраза" И Элемент.Ключ <> "ФразаДословно" И Не ЕстьРеквизитОбъекта(ОписаниеОбъекта, Элемент.Ключ) Тогда
			ВызватьИсключение "СМП_ТестыДанныеУНФ.НовоеПравилоНазначения: неизвестный ключ настроек '" + Элемент.Ключ
				+ "' (нет среди реквизитов справочника); запись в базу не начиналась.";
		КонецЕсли;
	КонецЦикла;
	Если Настройки.Свойство("Фраза") И Настройки.Свойство("ФразаДословно") Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НовоеПравилоНазначения: ключи 'Фраза' и 'ФразаДословно' взаимоисключающие; "
			+ "запись в базу не начиналась.";
	КонецЕсли;
	Если Настройки.Свойство("ФразаДословно") Тогда
		ПроверитьТипПараметра("НовоеПравилоНазначения", "Настройки.ФразаДословно", Настройки.ФразаДословно, "Строка");
	КонецЕсли;

	Если Настройки.Свойство("ФразаДословно") Тогда
		Фраза = Настройки.ФразаДословно;
	Иначе
		Фраза = ПрефиксФикстуры();
		Если Настройки.Свойство("Фраза") Тогда
			Фраза = Фраза + Настройки.Фраза + "_";
		КонецЕсли;
		Фраза = Фраза + УникальноеОкончание();
	КонецЕсли;

	// Реквизиты продуктового расширения (СМП_ВидНалога) этому расширению не видны: присваиваются поздним связыванием.
	Значения = Новый Структура;
	Для Каждого Элемент Из Настройки Цикл
		Если Элемент.Ключ <> "Фраза" И Элемент.Ключ <> "ФразаДословно" Тогда
			Значения.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Правило = Справочники.СоответствияНазначенийПлатежаИРеквизитовПлатежа.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(Правило, Значения);
	Правило.ФразаДляПоискаВНазначенииПлатежа = Фраза;
	ЗаписатьОбъект(Правило, "Правило назначения платежа");

	Возврат Правило.Ссылка;

КонецФункции

// Создает банковский документ (ПоступлениеНаСчет или РасходСоСчета) с заданными признаками, по которым
// распознавание ищет уже загруженную операцию: идентификатор транзакции банка, входящие номер и дата,
// сумма, счет контрагента, банковский счет организации, проведен ли документ. Контрагент и договор,
// если не заданы, создаются (контрагент - с признаками учета по договорам, договор - вида по документу).
// Незаданные входящие номер и дата, идентификатор и счет контрагента остаются ПУСТЫМИ.
//
// Параметры:
//  Настройки - Структура - ключи (все необязательные; ключ вне перечня - исключение до записи):
//   * ВидДокумента - Строка - "ПоступлениеНаСчет" (по умолчанию) или "РасходСоСчета"
//   * СМП_ИДТранзакцииБанка - Строка - идентификатор транзакции банка (реквизит продуктового расширения)
//   * НомерВходящегоДокумента - Строка
//   * ДатаВходящегоДокумента - Дата
//   * Сумма - Число - СуммаДокумента и сумма строки расшифровки (по умолчанию 100)
//   * СчетКонтрагента - СправочникСсылка.БанковскиеСчета
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации (по умолчанию БанковскийСчетОрганизации())
//   * Контрагент - СправочникСсылка.Контрагенты
//   * Договор - СправочникСсылка.ДоговорыКонтрагентов
//   * ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета
//   * Дата - Дата - дата документа (по умолчанию дата фикстуры)
//   * Номер - Строка - номер документа (до 11 знаков; по умолчанию присваивает платформа)
//   * Проведен - Булево - провести документ (по умолчанию только записывается)
//   * ПометкаУдаления - Булево - после записи (и проведения) пометить документ на удаление
//   * РасшифровкаПоДолгам - Булево - заполнить расшифровку штатно (ЗаполнитьРасшифровкуПлатежа вендора): оплата гасит долги
//     контрагента по документам, остаток - аванс (по умолчанию одна строка без документа-основания, то есть аванс)
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета
Функция НовыйБанковскийДокумент(Настройки) Экспорт

	ПроверитьТранзакцию("НовыйБанковскийДокумент");
	ПроверитьТипПараметра("НовыйБанковскийДокумент", "Настройки", Настройки, "Структура");

	// Ключ, которого нет в перечне, - опечатка: ЗаполнитьЗначенияСвойств молча пропустила бы его, и тест
	// измерял бы не то условие. Типы проверяются до первой записи (в том числе создания контрагента).
	ТипыКлючей = Новый Соответствие;
	ТипыКлючей.Вставить("ВидДокумента", "Строка");
	ТипыКлючей.Вставить("СМП_ИДТранзакцииБанка", "Строка");
	ТипыКлючей.Вставить("НомерВходящегоДокумента", "Строка");
	ТипыКлючей.Вставить("ДатаВходящегоДокумента", "Дата");
	ТипыКлючей.Вставить("Сумма", "Число");
	ТипыКлючей.Вставить("СчетКонтрагента", "СправочникСсылка.БанковскиеСчета");
	ТипыКлючей.Вставить("БанковскийСчет", "СправочникСсылка.БанковскиеСчета");
	ТипыКлючей.Вставить("Контрагент", "СправочникСсылка.Контрагенты");
	ТипыКлючей.Вставить("Договор", "СправочникСсылка.ДоговорыКонтрагентов");
	ТипыКлючей.Вставить("ВидОперации",
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета");
	ТипыКлючей.Вставить("Дата", "Дата");
	ТипыКлючей.Вставить("Номер", "Строка");
	ТипыКлючей.Вставить("Проведен", "Булево");
	ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
	ТипыКлючей.Вставить("РасшифровкаПоДолгам", "Булево");
	Для Каждого Элемент Из Настройки Цикл
		Если ТипыКлючей.Получить(Элемент.Ключ) = Неопределено Тогда
			ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент: неизвестный ключ настроек '" + Элемент.Ключ
				+ "' (допустимы " + СтрСоединить(ТипыКлючейСписком(ТипыКлючей), ", ") + "); запись в базу не начиналась.";
		КонецЕсли;
		ПроверитьТипПараметра("НовыйБанковскийДокумент", "Настройки." + Элемент.Ключ, Элемент.Значение,
			ТипыКлючей.Получить(Элемент.Ключ));
	КонецЦикла;
	Если Настройки.Свойство("ВидДокумента") И Настройки.ВидДокумента <> "ПоступлениеНаСчет" И Настройки.ВидДокумента <> "РасходСоСчета" Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент: ВидДокумента '" + Настройки.ВидДокумента
			+ "' недопустим (ПоступлениеНаСчет или РасходСоСчета); запись в базу не начиналась.";
	КонецЕсли;

	ВидДокумента = ?(Настройки.Свойство("ВидДокумента"), Настройки.ВидДокумента, "ПоступлениеНаСчет");
	ЭтоПоступление = (ВидДокумента = "ПоступлениеНаСчет");
	Сумма = ?(Настройки.Свойство("Сумма"), Настройки.Сумма, 100);
	ДатаДокумента = ?(Настройки.Свойство("Дата"), Настройки.Дата, ДатаФикстуры());

	Если Настройки.Свойство("Контрагент") Тогда
		Контрагент = Настройки.Контрагент;
	Иначе
		ПризнакиУчета = Новый Структура;
		ПризнакиУчета.Вставить("ВестиРасчетыПоДоговорам", Истина);
		ПризнакиУчета.Вставить("ВестиРасчетыПоДокументам", Истина);
		ПризнакиУчета.Вставить("ВестиРасчетыПоЗаказам", Истина);
		ПризнакиУчета.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
		Контрагент = НовыйКонтрагент(ПризнакиУчета);
	КонецЕсли;
	Если Настройки.Свойство("Договор") Тогда
		Договор = Настройки.Договор;
	Иначе
		ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(ЭтоПоступление, "СПокупателем", "СПоставщиком"));
		Договор = НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ВидДоговора));
	КонецЕсли;

	Документ = ?(ЭтоПоступление, Документы.ПоступлениеНаСчет.СоздатьДокумент(), Документы.РасходСоСчета.СоздатьДокумент());
	Документ.Дата = ДатаДокумента;
	Документ.Заполнить(Новый Структура("Организация, Контрагент, Договор", Организация(), Контрагент, Договор));
	Документ.Дата = ДатаДокумента;
	Если Настройки.Свойство("Номер") Тогда
		Документ.Номер = Настройки.Номер;
	КонецЕсли;
	Документ.Организация = Организация();
	Документ.Контрагент = Контрагент;
	Если Настройки.Свойство("ВидОперации") Тогда
		Документ.ВидОперации = Настройки.ВидОперации;
	Иначе
		Документ.ВидОперации = ?(ЭтоПоступление,
			ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"),
			ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	КонецЕсли;
	Документ.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	Документ.БанковскийСчет = ?(Настройки.Свойство("БанковскийСчет"), Настройки.БанковскийСчет, БанковскийСчетОрганизации());
	Документ.СуммаДокумента = Сумма;
	Документ.СчетКонтрагента = ?(Настройки.Свойство("СчетКонтрагента"), Настройки.СчетКонтрагента,
		Справочники.БанковскиеСчета.ПустаяСсылка());
	Документ.НомерВходящегоДокумента = ?(Настройки.Свойство("НомерВходящегоДокумента"), Настройки.НомерВходящегоДокумента, "");
	Документ.ДатаВходящегоДокумента = ?(Настройки.Свойство("ДатаВходящегоДокумента"), Настройки.ДатаВходящегоДокумента, '00010101');
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();

	// Реквизит продуктового расширения этому расширению не виден: присваивается поздним связыванием.
	Если Настройки.Свойство("СМП_ИДТранзакцииБанка") Тогда
		ЗаполнитьЗначенияСвойств(Документ, Новый Структура("СМП_ИДТранзакцииБанка", Настройки.СМП_ИДТранзакцииБанка));
	КонецЕсли;

	Если Настройки.Свойство("РасшифровкаПоДолгам") И Настройки.РасшифровкаПоДолгам Тогда
		// Штатное заполнение расшифровки вендора: сумма распределяется по долгам контрагента (строка с документом-долгом),
		// остаток - авансом. Так оплата гасит долг по документу.
		Документ.ЗаполнитьРасшифровкуПлатежа();
	Иначе
		Документ.РасшифровкаПлатежа.Очистить();
		Строка = Документ.РасшифровкаПлатежа.Добавить();
		Строка.Договор = Договор;
		Строка.ПризнакАванса = Ложь;
		Строка.Курс = 1;
		Строка.Кратность = 1;
		Строка.СуммаПлатежа = Сумма;
		Строка.СуммаРасчетов = Сумма;
		Строка.СтавкаНДС = СтавкаНДСБезНалога();
		Строка.СуммаНДС = 0;
	КонецЕсли;

	Проведен = Настройки.Свойство("Проведен") И Настройки.Проведен;
	ЗаписатьДокумент(Документ, Проведен, ?(ЭтоПоступление, "Поступление на счет", "Расход со счета"));

	Если Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		Попытка
			Документ.УстановитьПометкуУдаления(Истина);
		Исключение
			ВызватьИсключение "СМП_ТестыДанныеУНФ: не помечен на удаление банковский документ: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
		КонецПопытки;
	КонецЕсли;

	Возврат Документ.Ссылка;

КонецФункции

#КонецОбласти

#Область ПлатежноеПоручение

// Создает платежное поручение (ПлатежноеПоручение) - основание шага 3 распознавания. Документ НЕпроводимый (Проведение
// запрещено вендором), поэтому только записывается. Незаданное остается значением по умолчанию: оплачено - Нет, без пометки
// удаления, вид операции - Оплата, статья и корреспонденция - пусто.
//
// Параметры:
//  Настройки - Структура - ключи (все необязательные; ключ вне перечня - исключение до записи):
//   * Контрагент - СправочникСсылка.Контрагенты - по умолчанию создается (с признаками учета по договорам)
//   * Договор - СправочникСсылка.ДоговорыКонтрагентов - по умолчанию создается договор с поставщиком контрагента
//   * Организация - СправочникСсылка.Организации - по умолчанию Организация()
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - по умолчанию БанковскийСчетОрганизации() для организации
//     по умолчанию, иначе создается новый счет заданной организации
//   * Сумма - Число - СуммаДокумента и сумма строки расшифровки (по умолчанию 100)
//   * Дата - Дата - дата документа (по умолчанию дата фикстуры)
//   * Номер - Строка - номер документа (до 11 знаков; по умолчанию уникальный числовой, как у нового поручения)
//   * ВидОперации - ПеречислениеСсылка.ВидыОперацийПлатежноеПоручение - по умолчанию Оплата
//   * Статья - СправочникСсылка.СтатьиДвиженияДенежныхСредств
//   * Корреспонденция - ПланСчетовСсылка.Управленческий
//   * Оплачено - Булево - признак, который вендор ставит при проведении РасходСоСчета на основании поручения
//   * ПометкаУдаления - Булево - после записи пометить документ на удаление
//
// Возвращаемое значение:
//  ДокументСсылка.ПлатежноеПоручение
Функция НовоеПлатежноеПоручение(Настройки) Экспорт

	ПроверитьТранзакцию("НовоеПлатежноеПоручение");
	ПроверитьТипПараметра("НовоеПлатежноеПоручение", "Настройки", Настройки, "Структура");

	// Ключ с опечаткой и неверный тип - исключение ДО первой записи (в том числе создания контрагента и договора).
	ТипыКлючей = Новый Соответствие;
	ТипыКлючей.Вставить("Контрагент", "СправочникСсылка.Контрагенты");
	ТипыКлючей.Вставить("Договор", "СправочникСсылка.ДоговорыКонтрагентов");
	ТипыКлючей.Вставить("Организация", "СправочникСсылка.Организации");
	ТипыКлючей.Вставить("БанковскийСчет", "СправочникСсылка.БанковскиеСчета");
	ТипыКлючей.Вставить("Сумма", "Число");
	ТипыКлючей.Вставить("Дата", "Дата");
	ТипыКлючей.Вставить("Номер", "Строка");
	ТипыКлючей.Вставить("ВидОперации", "ПеречислениеСсылка.ВидыОперацийПлатежноеПоручение");
	ТипыКлючей.Вставить("Статья", "СправочникСсылка.СтатьиДвиженияДенежныхСредств");
	ТипыКлючей.Вставить("Корреспонденция", "ПланСчетовСсылка.Управленческий");
	ТипыКлючей.Вставить("Оплачено", "Булево");
	ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
	ПроверитьКлючиНастроек("НовоеПлатежноеПоручение", Настройки, ТипыКлючей);
	Если Настройки.Свойство("Номер") И СтрДлина(Настройки.Номер) > 11 Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение: Номер '" + Настройки.Номер
			+ "' длиннее 11 знаков (длина номера документа); запись в базу не начиналась.";
	КонецЕсли;

	Организация = ?(Настройки.Свойство("Организация"), Настройки.Организация, Организация());
	Если Настройки.Свойство("БанковскийСчет") Тогда
		БанковскийСчет = Настройки.БанковскийСчет;
	ИначеЕсли Настройки.Свойство("Организация") Тогда
		БанковскийСчет = НовыйБанковскийСчетОрганизации(Настройки.Организация);
	Иначе
		БанковскийСчет = БанковскийСчетОрганизации();
	КонецЕсли;

	Если Настройки.Свойство("Контрагент") Тогда
		Контрагент = Настройки.Контрагент;
	Иначе
		ПризнакиУчета = Новый Структура;
		ПризнакиУчета.Вставить("ВестиРасчетыПоДоговорам", Истина);
		ПризнакиУчета.Вставить("ВестиРасчетыПоДокументам", Истина);
		ПризнакиУчета.Вставить("ВестиРасчетыПоЗаказам", Истина);
		ПризнакиУчета.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
		Контрагент = НовыйКонтрагент(ПризнакиУчета);
	КонецЕсли;
	Если Настройки.Свойство("Договор") Тогда
		Договор = Настройки.Договор;
	Иначе
		Договор = НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком")));
	КонецЕсли;
	Сумма = ?(Настройки.Свойство("Сумма"), Настройки.Сумма, 100);

	Документ = Документы.ПлатежноеПоручение.СоздатьДокумент();
	Документ.Дата = ?(Настройки.Свойство("Дата"), Настройки.Дата, ДатаФикстуры());
	Документ.Номер = ?(Настройки.Свойство("Номер"), Настройки.Номер, НовыйЧисловойНомерДокумента());
	Документ.Организация = Организация;
	Документ.БанковскийСчет = БанковскийСчет;
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.ВидОперации = ?(Настройки.Свойство("ВидОперации"), Настройки.ВидОперации,
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Оплата"));
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.СуммаДокумента = Сумма;
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();
	Если Настройки.Свойство("Статья") Тогда
		Документ.Статья = Настройки.Статья;
	КонецЕсли;
	Если Настройки.Свойство("Корреспонденция") Тогда
		Документ.Корреспонденция = Настройки.Корреспонденция;
	КонецЕсли;
	Если Настройки.Свойство("Оплачено") Тогда
		Документ.Оплачено = Настройки.Оплачено;
	КонецЕсли;

	Документ.РасшифровкаПлатежа.Очистить();
	Строка = Документ.РасшифровкаПлатежа.Добавить();
	Строка.Договор = Договор;
	Строка.ПризнакАванса = Ложь;
	Строка.Курс = 1;
	Строка.Кратность = 1;
	Строка.СуммаПлатежа = Сумма;
	Строка.СуммаРасчетов = Сумма;
	Строка.СтавкаНДС = СтавкаНДСБезНалога();
	Строка.СуммаНДС = 0;

	ЗаписатьДокумент(Документ, Ложь, "Платежное поручение");

	Если Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		УстановитьПометкуУдаленияОбъекта(Документ, "Платежное поручение");
	КонецЕсли;

	Возврат Документ.Ссылка;

КонецФункции

// Номер документа из цифр без ведущих нулей, уникальный в прогоне (8 знаков: чужие номера базы его не заденут).
Функция НовыйЧисловойНомерДокумента()

	Генератор = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());

	Возврат Формат(Генератор.СлучайноеЧисло(10000000, 99999999), "ЧГ=0");

КонецФункции

#КонецОбласти
#Область КонвертВыписки

// Строка конверта выписки (схема СМП_ВыпискаБанка.НоваяВыписка().Операции) с правдоподобными значениями
// и переопределением любого поля. В базу НЕ пишет, поэтому охраны транзакции нет (охрана - у функций,
// которые пишут); читает только счетчик-генераторы IBAN и ЕДРПОУ. Колонки берутся из конструктора
// контракта, а не из перечня в тесте: новая колонка контракта появляется в строке сама.
//
// Параметры:
//  Настройки - Структура - значения колонок конверта; ключ, которого нет среди колонок, - опечатка:
//              исключение до построения.
//
// Возвращаемое значение:
//  Структура - ключи: все колонки Операции конверта. Для добавления в таблицу
//              ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция).
Функция НоваяОперацияКонверта(Настройки) Экспорт

	ПроверитьТипПараметра("НоваяОперацияКонверта", "Настройки", Настройки, "Структура");

	Колонки = КолонкиОперацийКонверта();
	Для Каждого Элемент Из Настройки Цикл
		Если Колонки.Найти(Элемент.Ключ) = Неопределено Тогда
			ВызватьИсключение "СМП_ТестыДанныеУНФ.НоваяОперацияКонверта: неизвестный ключ настроек '" + Элемент.Ключ
				+ "' (нет среди колонок Операции конверта)";
		КонецЕсли;
	КонецЦикла;

	// Момент читается ОДИН раз: дата документа - начало суток того же момента, что и дата операции. Два чтения на границе
	// суток дали бы операцию следующих суток при дате документа предыдущих.
	Момент = ДатаФикстуры();
	Значения = Новый Структура;
	Значения.Вставить("ПорядковыйНомер", 1);
	Значения.Вставить("НомерСчета", НовыйIBAN());
	Значения.Вставить("Валюта", "980");
	Значения.Вставить("ДатаОперации", Момент);
	Значения.Вставить("НомерДокумента", "ТЕСТ-" + Лев(УникальноеОкончание(), 8));
	Значения.Вставить("ДатаДокумента", НачалоДня(Момент));
	Значения.Вставить("Сумма", 100);
	Значения.Вставить("Направление", СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НаправлениеПоступило"));
	Значения.Вставить("ИдентификаторОперации", ПрефиксФикстуры() + Лев(УникальноеОкончание(), 30));
	Значения.Вставить("КонтрагентНаименование", ПрефиксФикстуры() + "Контрагент_" + Лев(УникальноеОкончание(), 8));
	Значения.Вставить("КонтрагентНомерСчета", НовыйIBAN());
	Значения.Вставить("КонтрагентКод", НовыйЕДРПОУ());
	Значения.Вставить("КонтрагентМФО", "305299");
	Значения.Вставить("НазначениеПлатежа", ПрефиксФикстуры() + "Назначение");
	Значения.Вставить("СырыеДанные", "");

	Операция = Новый Структура;
	Для Каждого Имя Из Колонки Цикл
		// Колонка контракта без значения по умолчанию здесь - пустое значение ее типа, не отсутствие ключа.
		Если Значения.Свойство(Имя) Тогда
			Операция.Вставить(Имя, Значения[Имя]);
		Иначе
			Операция.Вставить(Имя, Неопределено);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Настройки Цикл
		Операция[Элемент.Ключ] = Элемент.Значение;
	КонецЦикла;

	Возврат Операция;

КонецФункции

// Снимок количеств объектов, в которые могло бы писать распознавание: контрагенты, договоры, банковские счета,
// документы ПоступлениеНаСчет и РасходСоСчета. Считает ВСЕ объекты, не только с префиксом фикстуры: запись
// продукта префикса не носит, и снимок по префиксу ее не увидел бы. Только читает базу (охраны транзакции нет:
// чтение безопасно и вне транзакции). Пара к снимку - создание контрагента между двумя снимками.
//
// Возвращаемое значение:
//  Соответствие - ключ: Строка, вид и имя объекта ("Справочник.Контрагенты"), значение: Число.
Функция КоличестваОбъектовДляПроверкиЗаписи() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ""Справочник.Контрагенты"" КАК Тип, КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ Справочник.Контрагенты КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Справочник.ДоговорыКонтрагентов"", КОЛИЧЕСТВО(*)
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Справочник.БанковскиеСчета"", КОЛИЧЕСТВО(*)
		|ИЗ Справочник.БанковскиеСчета КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.ПоступлениеНаСчет"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.ПоступлениеНаСчет КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ""Документ.РасходСоСчета"", КОЛИЧЕСТВО(*)
		|ИЗ Документ.РасходСоСчета КАК Т");

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Тип, Выборка.Количество);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебные

// Охрана: построитель пишет в базу только внутри транзакции теста.
Процедура ПроверитьТранзакцию(ИмяФункции)

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": вызов вне транзакции отклонен. "
			+ "Построитель пишет в общую базу агента и работает только внутри транзакции: "
			+ "тест должен быть помечен .ВТранзакции().";
	КонецЕсли;

КонецПроцедуры

// Проверка типа параметра: неверный тип - исключение ДО любой записи. Текст НЕ содержит "вне транзакции".
Процедура ПроверитьТипПараметра(ИмяФункции, ИмяПараметра, Значение, ИменаТипов)

	ДопустимыеТипы = Новый ОписаниеТипов(ИменаТипов);
	Если Не ДопустимыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
		ОтказПоТипуПараметра(ИмяФункции, ИмяПараметра, ИменаТипов, Значение);
	КонецЕсли;

КонецПроцедуры

// Ключи настроек: неизвестный ключ и неверный тип значения отклоняются исключением ДО любой записи. Ключ вне
// перечня - опечатка, а ЗаполнитьЗначенияСвойств и Свойство() молча пропустили бы его, и тест измерял бы не то
// условие. ТипыКлючей - соответствие "ключ -> имена типов"; пустая строка вместо типа - тип не проверяется.
Процедура ПроверитьКлючиНастроек(ИмяФункции, Настройки, ТипыКлючей)

	Для Каждого Элемент Из Настройки Цикл
		Если ТипыКлючей.Получить(Элемент.Ключ) = Неопределено Тогда
			ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": неизвестный ключ настроек '" + Элемент.Ключ
				+ "' (допустимы " + СтрСоединить(ТипыКлючейСписком(ТипыКлючей), ", ") + "); запись в базу не начиналась.";
		КонецЕсли;
		Если Не ПустаяСтрока(ТипыКлючей.Получить(Элемент.Ключ)) Тогда
			ПроверитьТипПараметра(ИмяФункции, "Настройки." + Элемент.Ключ, Элемент.Значение, ТипыКлючей.Получить(Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Помечает записанный объект на удаление штатным методом (с обработкой подчиненных, как в интерфейсе).
Процедура УстановитьПометкуУдаленияОбъекта(Объект, Описание)

	Попытка
		Объект.УстановитьПометкуУдаления(Истина);
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: не помечен на удаление объект '" + Описание + "': "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

// Записывает договор основным для его контрагента, организации и вида штатной процедурой вендора.
Процедура ЗаписатьОсновнойДоговор(Договор)

	Попытка
		Справочники.ДоговорыКонтрагентов.ЗаписатьДоговорПоУмолчанию(Договор);
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: не записан основной договор: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

Процедура ОтказПоТипуПараметра(ИмяФункции, ИмяПараметра, ОжидаемыеТипы, Значение)

	ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": неверный тип параметра " + ИмяПараметра
		+ " (ожидается " + ОжидаемыеТипы + ", получено " + Строка(ТипЗнч(Значение)) + "); запись в базу не начиналась.";

КонецПроцедуры

Процедура ПроверитьТипыПараметровДокумента(ИмяФункции, Контрагент, Договор, Сумма)

	ПроверитьТипПараметра(ИмяФункции, "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	ПроверитьТипПараметра(ИмяФункции, "Договор", Договор, "СправочникСсылка.ДоговорыКонтрагентов");
	ПроверитьТипПараметра(ИмяФункции, "Сумма", Сумма, "Число");

КонецПроцедуры

// Имена ключей соответствия, отсортированные: для текста исключения о неизвестном ключе.
Функция ТипыКлючейСписком(ТипыКлючей)

	Имена = Новый СписокЗначений;
	Для Каждого Элемент Из ТипыКлючей Цикл
		Имена.Добавить(Элемент.Ключ);
	КонецЦикла;
	Имена.СортироватьПоЗначению();

	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

// Есть ли у объекта метаданных реквизит или стандартный реквизит с таким именем.
Функция ЕстьРеквизитОбъекта(ОписаниеОбъекта, Имя)

	Если ОписаниеОбъекта.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Реквизит Из ОписаниеОбъекта.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Зерно генератора случайных чисел из нового идентификатора: два вызова в одну миллисекунду дают разные зерна.
Функция ЗерноГСЧ()

	Шестнадцатеричные = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 7);
	Зерно = 0;
	Для Индекс = 1 По СтрДлина(Шестнадцатеричные) Цикл
		Зерно = Зерно * 16 + Найти("0123456789abcdef", Сред(Шестнадцатеричные, Индекс, 1)) - 1;
	КонецЦикла;

	Возврат Зерно;

КонецФункции

Функция УникальноеОкончание()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

КонецФункции

// Дата документов фикстуры. Правило: текущая дата сеанса. Если проведение упадет из-за отсутствия
// курса на дату, правило заменяется выбором среди дней, на которые курс в КурсыВалют уже есть.
Функция ДатаФикстуры()

	Возврат ТекущаяДатаСеанса();

КонецФункции

// Дата акта для заданного момента фикстуры: на час раньше момента, но не раньше начала его суток. Инвариант
// построителя: дата договора (начало суток фикстуры) <= дата документа-основы <= дата платежа (момент фикстуры), все
// в одних сутках - в том числе когда тест идет в первый час суток (иначе "момент - час" уходит во вчера, раньше даты
// договора и за границу суток). Принимает момент параметром, чтобы инвариант проверялся на любой час, а не на час
// прогона.
//
// Параметры:
//  Момент - Дата - момент фикстуры
//
// Возвращаемое значение:
//  Дата
Функция ДатаАктаДляМоментаФикстуры(Момент) Экспорт

	Возврат Макс(Момент - 3600, НачалоДня(Момент));

КонецФункции

Функция ПервыйБанк()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка ИЗ Справочник.Банки КАК Б ГДЕ НЕ Б.ПометкаУдаления И НЕ Б.ЭтоГруппа УПОРЯДОЧИТЬ ПО Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: в справочнике Банки нет ни одного банка для счета контрагента";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

Функция ПерваяЕдиницаИзмерения()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Е.Ссылка КАК Ссылка ИЗ Справочник.КлассификаторЕдиницИзмерения КАК Е ГДЕ НЕ Е.ПометкаУдаления УПОРЯДОЧИТЬ ПО Е.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: в классификаторе единиц измерения нет ни одной единицы";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

Функция СтавкаНДСБезНалога()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ Справочник.СтавкиНДС КАК С ГДЕ НЕ С.ПометкаУдаления И С.НеОблагается УПОРЯДОЧИТЬ ПО С.Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: нет ставки НДС 'не облагается'";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Общая шапка документов: штатное заполнение (организация по правилу, валюта, курс из настроек),
// затем явные значения построителя.
Процедура ЗаполнитьШапкуДокумента(Документ, Контрагент, Договор, Настройки = Неопределено)

	ДругаяОрганизация = Настройки <> Неопределено И Настройки.Свойство("Организация");
	ОрганизацияДокумента = ?(ДругаяОрганизация, Настройки.Организация, Организация());
	ДатаДокумента = ?(Настройки <> Неопределено И Настройки.Свойство("Дата"), Настройки.Дата, ДатаФикстуры());

	Документ.Дата = ДатаДокумента;
	Документ.Заполнить(Новый Структура("Организация, Контрагент, Договор", ОрганизацияДокумента, Контрагент, Договор));
	Документ.Дата = ДатаДокумента;
	Документ.Организация = ОрганизацияДокумента;
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.БанковскийСчет = ?(ДругаяОрганизация, НовыйБанковскийСчетОрганизации(ОрганизацияДокумента), БанковскийСчетОрганизации());
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();

КонецПроцедуры

Функция ДобавитьСтрокуУслуги(ТабличнаяЧасть, Сумма, Услуга = Неопределено)

	Если Услуга = Неопределено Тогда
		Услуга = НоваяУслуга();
	КонецЕсли;
	Строка = ТабличнаяЧасть.Добавить();
	Строка.Номенклатура = Услуга;
	Строка.ЕдиницаИзмерения = ПерваяЕдиницаИзмерения();
	Строка.Количество = 1;
	Строка.Цена = Сумма;
	Строка.Сумма = Сумма;
	Строка.Всего = Сумма;
	Строка.СтавкаНДС = СтавкаНДСБезНалога();
	Строка.СуммаНДС = 0;

	Возврат Строка;

КонецФункции

Процедура ЗаписатьОбъект(Объект, Описание)

	Попытка
		Объект.Записать();
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: не записан объект '" + Описание + "': "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьДокумент(Документ, Провести, Описание)

	Попытка
		Если Провести Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Документ.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: документ '" + Описание + "' не " + ?(Провести, "проведен", "записан") + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

// Ключи Настройки документов-оснований (заказы, счета, акт): неизвестный ключ, неверный тип и номер длиннее 11 знаков
// отклоняются ДО любой записи. НомерВходящегоДокумента допустим только документу, у которого есть такой реквизит
// (список - из метаданных).
Процедура ПроверитьНастройкиДокумента(ИмяФункции, Настройки, ИмяДокумента, Провести)

	Если Настройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроверитьТипПараметра(ИмяФункции, "Настройки", Настройки, "Структура");

	ТипыКлючей = Новый Соответствие;
	ТипыКлючей.Вставить("Номер", "Строка");
	ТипыКлючей.Вставить("Дата", "Дата");
	ТипыКлючей.Вставить("Организация", "СправочникСсылка.Организации");
	ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
	Если ЕстьРеквизитОбъекта(Метаданные.Документы.Найти(ИмяДокумента), "НомерВходящегоДокумента") Тогда
		ТипыКлючей.Вставить("НомерВходящегоДокумента", "Строка");
	КонецЕсли;
	ПроверитьКлючиНастроек(ИмяФункции, Настройки, ТипыКлючей);

	Если Провести И Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": нельзя одновременно провести документ и пометить его на удаление "
			+ "(проведенный документ помеченным не бывает); задайте Провести = Ложь; запись в базу не начиналась.";
	КонецЕсли;

	Для Каждого ИмяКлюча Из СтрРазделить("Номер,НомерВходящегоДокумента", ",") Цикл
		Если Настройки.Свойство(ИмяКлюча) И СтрДлина(Настройки[ИмяКлюча]) > 11 Тогда
			ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": " + ИмяКлюча + " '" + Настройки[ИмяКлюча]
				+ "' длиннее 11 знаков (длина номера документа); запись в базу не начиналась.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Записывает документ с номерами из Настройки и, если просили, ставит пометку удаления штатным методом (платформа при этом
// отменяет проведение: помеченный документ всегда непроведен).
Процедура ЗаписатьДокументПоНастройкам(Документ, Провести, Описание, Настройки)

	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("Номер") Тогда
			Документ.Номер = Настройки.Номер;
		КонецЕсли;
		Если Настройки.Свойство("НомерВходящегоДокумента") Тогда
			Документ.НомерВходящегоДокумента = Настройки.НомерВходящегоДокумента;
		КонецЕсли;
	КонецЕсли;

	ЗаписатьДокумент(Документ, Провести, Описание);

	Если Настройки <> Неопределено И Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		УстановитьПометкуУдаленияОбъекта(Документ, Описание);
	КонецЕсли;

КонецПроцедуры

// Сообщения пользователю, накопленные платформой за вызов (причины отказа проведения).
Функция СообщенияПользователю()

	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Символы.ПС + "  - " + Сообщение.Текст;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Текст), "", Символы.ПС + "Сообщения платформы:" + Текст);

КонецФункции


// Имена колонок Операции в конструкторе контракта (единственный источник схемы строки).
Функция КолонкиОперацийКонверта()

	Имена = Новый Массив;
	Для Каждого Колонка Из СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НоваяВыписка").Операции.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции
#КонецОбласти
