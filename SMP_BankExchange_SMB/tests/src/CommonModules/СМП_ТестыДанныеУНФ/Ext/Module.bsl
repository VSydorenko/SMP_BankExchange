#КонецОбласти

#Область КонтрольныеСуммы

// Новый код ЕДРПОУ (8 цифр) с правильной контрольной цифрой.
Функция НовыйЕДРПОУ() Экспорт

	// Диапазон 10000000..59999999: граница весов (30 и 60 млн) не зависит от последней цифры.
	ГСЧ = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());
	Код = XMLСтрока(ГСЧ.СлучайноеЧисло(10000000, 59999999));
	Цифры = Лев(Код, 7);

	Возврат Цифры + XMLСтрока(КонтрольнаяЦифраЕДРПОУ(Цифры, Число(Код)));

КонецФункции

// Новый код ЕДРПОУ с ведущим нулем (8 цифр: ноль и семь значащих) с правильной контрольной цифрой. Для тестов
// кодов, у которых читатель, присвоив число, теряет ведущий ноль (журнал плана 01, Minor 1). Только вычисляет.
Функция НовыйЕДРПОУСВедущимНулем() Экспорт

	// Первая цифра после нуля не ноль: код остается "с одним ведущим нулем", а не с двумя.
	ГСЧ = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());
	Цифры = Лев("0" + XMLСтрока(ГСЧ.СлучайноеЧисло(1000000, 9999999)), 7);

	Возврат Цифры + XMLСтрока(КонтрольнаяЦифраЕДРПОУ(Цифры, Число(Цифры)));

КонецФункции

// Проверяет контрольную цифру кода ЕДРПОУ.
Функция ЕДРПОУКорректен(Код) Экспорт

	Если ТипЗнч(Код) <> Тип("Строка") Или СтрДлина(Код) <> 8 Или Не СтрокаТолькоЦифры(Код) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат XMLСтрока(КонтрольнаяЦифраЕДРПОУ(Лев(Код, 7), Число(Код))) = Прав(Код, 1);

КонецФункции

// Новый IBAN (UA, 29 символов) с правильной контрольной суммой.
Функция НовыйIBAN() Экспорт

	ГСЧ = Новый ГенераторСлучайныхЧисел(ЗерноГСЧ());
	BBAN = "";
	Для Индекс = 1 По 25 Цикл
		BBAN = BBAN + XMLСтрока(ГСЧ.СлучайноеЧисло(0, 9));
	КонецЦикла;

	// UA -> 30 10, контрольные цифры 00 в конец; проверочное число = 98 - (остаток по 97).
	Остаток = ОстатокОтДеления97(BBAN + "301000");
	Возврат "UA" + Прав("0" + XMLСтрока(98 - Остаток), 2) + BBAN;

КонецФункции

// Проверяет контрольную сумму IBAN (mod 97) и длину украинского номера.
Функция IBANКорректен(Номер) Экспорт

	Если ТипЗнч(Номер) <> Тип("Строка") Или СтрДлина(Номер) <> 29 Или Лев(Номер, 2) <> "UA" Или Не СтрокаТолькоЦифры(Сред(Номер, 3)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ОстатокОтДеления97(Сред(Номер, 5) + "3010" + Сред(Номер, 3, 2)) = 1;

КонецФункции

// Контрольная цифра ЕДРПОУ (0..9) по первым семи цифрам и числовому значению кода. Веса 1..7; для кодов
// от 30 до 60 млн - 7,1,2,3,4,5,6; остаток 10 - второй проход с весами, увеличенными на 2; снова 10 - ноль.
Функция КонтрольнаяЦифраЕДРПОУ(Цифры7, ЧисловоеЗначениеКода)

	Если ЧисловоеЗначениеКода < 30000000 Или ЧисловоеЗначениеКода > 60000000 Тогда
		Веса = СтрРазделить("1,2,3,4,5,6,7", ",");
	Иначе
		Веса = СтрРазделить("7,1,2,3,4,5,6", ",");
	КонецЕсли;

	Остаток = ВзвешеннаяСуммаПо11(Цифры7, Веса, 0);
	Если Остаток = 10 Тогда
		Остаток = ВзвешеннаяСуммаПо11(Цифры7, Веса, 2);
		Если Остаток = 10 Тогда
			Остаток = 0;
		КонецЕсли;
	КонецЕсли;

	Возврат Остаток;

КонецФункции

Функция ВзвешеннаяСуммаПо11(Цифры7, Веса, Добавка)

	Сумма = 0;
	Для Индекс = 1 По 7 Цикл
		Сумма = Сумма + Число(Сред(Цифры7, Индекс, 1)) * (Число(Веса[Индекс - 1]) + Добавка);
	КонецЦикла;

	Возврат Сумма % 11;

КонецФункции

Функция ОстатокОтДеления97(ЦифровойТекст)

	Остаток = 0;
	Для Индекс = 1 По СтрДлина(ЦифровойТекст) Цикл
		Остаток = (Остаток * 10 + Число(Сред(ЦифровойТекст, Индекс, 1))) % 97;
	КонецЦикла;

	Возврат Остаток;

КонецФункции

Функция СтрокаТолькоЦифры(Строка)

	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Если Найти("0123456789", Сред(Строка, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Строка) > 0;

КонецФункции

#КонецОбласти

#Область ДанныеИзБазы

// Организация по правилу выбора (known-state.md): первая по коду среди не помеченных на удаление
// и имеющих живой банковский счет в национальной валюте. Не создает. Если организации по правилу нет,
// отказывает исключением с названной причиной, а не возвращает пустую ссылку: пустая организация
// дала бы документы фикстуры без организации и красные тесты с чужой причиной.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - заполненная ссылка
Функция Организация() Экспорт

	Возврат ОрганизацияПоВалюте(Константы.НациональнаяВалюта.Получить());

КонецФункции

// Правило выбора организации с параметром "валюта счета": Организация() вызывает его с национальной
// валютой. Параметр нужен, чтобы тест мог безопасно, без изменения базы, дойти до ветки "не найдено"
// (валюта, в которой у организаций нет живого счета).
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта банковского счета организации
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - заполненная ссылка; если организации по правилу нет - исключение
Функция ОрганизацияПоВалюте(Валюта) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	О.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК О
		|ГДЕ
		|	НЕ О.ПометкаУдаления
		|	И О.Ссылка В
		|		(ВЫБРАТЬ
		|			Б.Владелец
		|		ИЗ
		|			Справочник.БанковскиеСчета КАК Б
		|		ГДЕ
		|			НЕ Б.ПометкаУдаления
		|			И НЕ Б.Недействителен
		|			И Б.ВалютаДенежныхСредств = &Национальная)
		|
		|УПОРЯДОЧИТЬ ПО
		|	О.Код");
	Запрос.УстановитьПараметр("Национальная", Валюта);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ВызватьИсключение "СМП_ТестыДанныеУНФ.Организация: организация по правилу выбора не найдена (нет не помеченной на удаление "
		+ "организации с живым банковским счетом в валюте " + Строка(Валюта) + "); правило - docs/architecture/testing.md";

КонецФункции

// Любая другая, не помеченная на удаление организация (не та, что выбрана Организация()), первая по коду. Не создает.
// Для тестов, где договор или счет принадлежит ЧУЖОЙ организации. Если второй организации в базе нет - пустая
// ссылка (в отличие от Организация(): наличие второй организации правилом не гарантируется), и тест, которому она
// нужна, обязан пропустить себя ИМЕНОВАННО, а не пройти зеленым.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации - пустая ссылка, если другой организации нет
Функция ДругаяОрганизация() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	О.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК О
		|ГДЕ
		|	НЕ О.ПометкаУдаления
		|	И О.Ссылка <> &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	О.Код");
	Запрос.УстановитьПараметр("Организация", Организация());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

// Банковский счет организации, выбранной Организация(), в национальной валюте. Не создает.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - пустая ссылка, если у организации нет счета по правилу;
//                                     если нет самой организации - исключение Организация()
Функция БанковскийСчетОрганизации() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Б.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Б
		|ГДЕ
		|	Б.Владелец = &Организация
		|	И НЕ Б.ПометкаУдаления
		|	И НЕ Б.Недействителен
		|	И Б.ВалютаДенежныхСредств = &Национальная
		|
		|УПОРЯДОЧИТЬ ПО
		|	Б.Код");
	Запрос.УстановитьПараметр("Организация", Организация());
	Запрос.УстановитьПараметр("Национальная", Константы.НациональнаяВалюта.Получить());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Справочники

// Создает контрагента (юридическое лицо, резидент Украины). ЕДРПОУ - с правильной контрольной цифрой.
// Запись контрагента сама создает ему договор по умолчанию.
//
// Параметры:
//  Настройки - Структура - ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам,
//              ВестиУчетОплатыПоСчетам (Булево; обязательные), СтатьяДДСПоУмолчанию,
//              СпособРазнесенияОплатыПоУмолчанию (необязательные), КодПоЕДРПОУ (Строка: код как есть, без
//              проверки контрольной суммы; по умолчанию новый ЕДРПОУ с контрольной цифрой), ПометкаУдаления
//              (Булево: контрагент помечается на удаление после записи). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты
Функция НовыйКонтрагент(Настройки) Экспорт

	ПроверитьТранзакцию("НовыйКонтрагент");
	ПроверитьТипПараметра("НовыйКонтрагент", "Настройки", Настройки, "Структура");

	ТипыКлючей = Новый Соответствие;
	ТипыКлючей.Вставить("ВестиРасчетыПоДоговорам", "Булево");
	ТипыКлючей.Вставить("ВестиРасчетыПоДокументам", "Булево");
	ТипыКлючей.Вставить("ВестиРасчетыПоЗаказам", "Булево");
	ТипыКлючей.Вставить("ВестиУчетОплатыПоСчетам", "Булево");
	ТипыКлючей.Вставить("СтатьяДДСПоУмолчанию", "");
	ТипыКлючей.Вставить("СпособРазнесенияОплатыПоУмолчанию", "");
	ТипыКлючей.Вставить("КодПоЕДРПОУ", "Строка");
	ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
	ПроверитьКлючиНастроек("НовыйКонтрагент", Настройки, ТипыКлючей);

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Заполнить(Неопределено);

	Имя = ПрефиксФикстуры() + "Контрагент_" + УникальноеОкончание();
	Контрагент.Наименование = Имя;
	Контрагент.НаименованиеПолное = Имя;
	Контрагент.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЮридическоеЛицо");
	Контрагент.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Украина");
	Контрагент.КодПоЕДРПОУ = ?(Настройки.Свойство("КодПоЕДРПОУ"), Настройки.КодПоЕДРПОУ, НовыйЕДРПОУ());
	Контрагент.Покупатель = Истина;
	Контрагент.Поставщик = Истина;
	Контрагент.ВестиРасчетыПоДоговорам = Настройки.ВестиРасчетыПоДоговорам;
	Контрагент.ВестиРасчетыПоДокументам = Настройки.ВестиРасчетыПоДокументам;
	Контрагент.ВестиРасчетыПоЗаказам = Настройки.ВестиРасчетыПоЗаказам;
	Контрагент.ВестиУчетОплатыПоСчетам = Настройки.ВестиУчетОплатыПоСчетам;
	Если Настройки.Свойство("СтатьяДДСПоУмолчанию") И ЗначениеЗаполнено(Настройки.СтатьяДДСПоУмолчанию) Тогда
		Контрагент.СтатьяДДСПоУмолчанию = Настройки.СтатьяДДСПоУмолчанию;
	КонецЕсли;
	Если Настройки.Свойство("СпособРазнесенияОплатыПоУмолчанию") И ЗначениеЗаполнено(Настройки.СпособРазнесенияОплатыПоУмолчанию) Тогда
		Контрагент.СпособРазнесенияОплатыПоУмолчанию = Настройки.СпособРазнесенияОплатыПоУмолчанию;
	КонецЕсли;

	ЗаписатьОбъект(Контрагент, "Контрагент");

	Если Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		УстановитьПометкуУдаленияОбъекта(Контрагент, "Контрагент");
	КонецЕсли;

	Возврат Контрагент.Ссылка;

КонецФункции

// Создает договор контрагента в национальной валюте на организацию, выбранную по правилу.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Настройки - Структура, Неопределено - ВидДоговора (ПеречислениеСсылка.ВидыДоговоров, по умолчанию
//              СПокупателем); необязательные СтатьяДДСПоУмолчанию, СпособРазнесенияОплатыПоУмолчанию,
//              Основной (Булево: договор записывается как основной договор контрагента для организации и вида,
//              через штатную запись основного договора), ПометкаУдаления, Недействителен (Булево: записываются
//              в договоре), Организация (СправочникСсылка.Организации; по умолчанию Организация():
//              договор документа другой организации). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов
Функция НовыйДоговор(Контрагент, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйДоговор");
	ПроверитьТипПараметра("НовыйДоговор", "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйДоговор", "Настройки", Настройки, "Структура");
		ТипыКлючей = Новый Соответствие;
		ТипыКлючей.Вставить("ВидДоговора", "ПеречислениеСсылка.ВидыДоговоров");
		ТипыКлючей.Вставить("СтатьяДДСПоУмолчанию", "");
		ТипыКлючей.Вставить("СпособРазнесенияОплатыПоУмолчанию", "");
		ТипыКлючей.Вставить("Основной", "Булево");
		ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
		ТипыКлючей.Вставить("Недействителен", "Булево");
		ТипыКлючей.Вставить("Организация", "СправочникСсылка.Организации");
		ПроверитьКлючиНастроек("НовыйДоговор", Настройки, ТипыКлючей);
	КонецЕсли;

	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Заполнить(Новый Структура("ОснованиеЗаполнения", Контрагент));

	Договор.Наименование = ПрефиксФикстуры() + "Договор_" + УникальноеОкончание();
	Договор.Организация = Организация();
	Договор.ВалютаРасчетов = Константы.НациональнаяВалюта.Получить();
	Договор.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем");
	Договор.НомерДоговора = УникальноеОкончание();
	Договор.ДатаДоговора = НачалоДня(ДатаФикстуры());

	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ВидДоговора") И ЗначениеЗаполнено(Настройки.ВидДоговора) Тогда
			Договор.ВидДоговора = Настройки.ВидДоговора;
		КонецЕсли;
		Если Настройки.Свойство("СтатьяДДСПоУмолчанию") И ЗначениеЗаполнено(Настройки.СтатьяДДСПоУмолчанию) Тогда
			Договор.СтатьяДДСПоУмолчанию = Настройки.СтатьяДДСПоУмолчанию;
		КонецЕсли;
		Если Настройки.Свойство("СпособРазнесенияОплатыПоУмолчанию") И ЗначениеЗаполнено(Настройки.СпособРазнесенияОплатыПоУмолчанию) Тогда
			Договор.СпособРазнесенияОплатыПоУмолчанию = Настройки.СпособРазнесенияОплатыПоУмолчанию;
		КонецЕсли;
		Если Настройки.Свойство("ПометкаУдаления") Тогда
			Договор.ПометкаУдаления = Настройки.ПометкаУдаления;
		КонецЕсли;
		Если Настройки.Свойство("Недействителен") Тогда
			Договор.Недействителен = Настройки.Недействителен;
		КонецЕсли;
		Если Настройки.Свойство("Организация") Тогда
			Договор.Организация = Настройки.Организация;
		КонецЕсли;
	КонецЕсли;

	ЗаписатьОбъект(Договор, "Договор");

	Если Настройки <> Неопределено И Настройки.Свойство("Основной") И Настройки.Основной И Не Договор.ПометкаУдаления Тогда
		ЗаписатьОсновнойДоговор(Договор.Ссылка);
	КонецЕсли;

	Возврат Договор.Ссылка;

КонецФункции

// Делает УЖЕ СУЩЕСТВУЮЩИЙ договор основным договором своего контрагента для его организации и вида (штатная запись
// основного договора). Нужна тестам, где роль "основной" назначается по прочитанным из базы кодам справочника: код
// платформа выдает не по порядку создания, поэтому роль нельзя задавать при создании.
//
// Параметры:
//  Договор - СправочникСсылка.ДоговорыКонтрагентов
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов - тот же договор
Функция СделатьДоговорОсновным(Договор) Экспорт

	ПроверитьТранзакцию("СделатьДоговорОсновным");
	ПроверитьТипПараметра("СделатьДоговорОсновным", "Договор", Договор, "СправочникСсылка.ДоговорыКонтрагентов");

	ЗаписатьОсновнойДоговор(Договор);

	Возврат Договор;

КонецФункции

// Меняет ДОГОВОР ПО УМОЛЧАНИЮ, который запись контрагента создает сама (организация, основной ли он, пометка
// удаления). Нужна тестам, которым состав договоров контрагента не должен зависеть от того, на какую организацию
// платформа заполнила автоматический договор. Договор по умолчанию находится штатной функцией вендора.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент, только что созданный НовыйКонтрагент
//  Настройки - Структура - необязательные Организация (СправочникСсылка.Организации), Основной (Булево: остается
//              ли договор основным; без ключа остается как был), ПометкаУдаления (Булево), ВидДоговора
//              (ПеречислениеСсылка.ВидыДоговоров: вид договора по умолчанию). Ключ вне перечня -
//              исключение до записи; контрагент без договора по умолчанию - тоже, до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.ДоговорыКонтрагентов - измененный договор
Функция НастроитьДоговорПоУмолчанию(Контрагент, Настройки) Экспорт

	ПроверитьТранзакцию("НастроитьДоговорПоУмолчанию");
	ПроверитьТипПараметра("НастроитьДоговорПоУмолчанию", "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	ПроверитьТипПараметра("НастроитьДоговорПоУмолчанию", "Настройки", Настройки, "Структура");
	ТипыКлючей = Новый Соответствие;
	ТипыКлючей.Вставить("Организация", "СправочникСсылка.Организации");
	ТипыКлючей.Вставить("ВидДоговора", "ПеречислениеСсылка.ВидыДоговоров");
	ТипыКлючей.Вставить("Основной", "Булево");
	ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
	ПроверитьКлючиНастроек("НастроитьДоговорПоУмолчанию", Настройки, ТипыКлючей);

	Ссылка = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию: у контрагента нет договора по умолчанию "
			+ "(основного договора в регистре); запись в базу не начиналась.";
	КонецЕсли;

	Договор = Ссылка.ПолучитьОбъект();
	Если Настройки.Свойство("Организация") Тогда
		Договор.Организация = Настройки.Организация;
	КонецЕсли;
	Если Настройки.Свойство("ВидДоговора") Тогда
		Договор.ВидДоговора = Настройки.ВидДоговора;
	КонецЕсли;
	Если Настройки.Свойство("ПометкаУдаления") Тогда
		Договор.ПометкаУдаления = Настройки.ПометкаУдаления;
	КонецЕсли;
	ЗаписатьОбъект(Договор, "Договор по умолчанию");

	// Найденный договор по умолчанию - основной (он найден по регистру основных договоров). Запись с пометкой
	// удаления штатно очищает основной договор; иначе основной ли он, определяет ключ Основной (без ключа договор
	// остается основным, но запись регистра переписывается: ключ регистра содержит организацию).
	Основной = ?(Настройки.Свойство("Основной"), Настройки.Основной, Истина);
	Если Основной И Не Договор.ПометкаУдаления Тогда
		ЗаписатьОсновнойДоговор(Договор.Ссылка);
	Иначе
		РегистрыСведений.ОсновныеДоговорыКонтрагента.ОчиститьЗаписиСДоговором(Договор.Ссылка);
	КонецЕсли;

	Возврат Договор.Ссылка;

КонецФункции

// Создает банковский счет контрагента с IBAN, прошедшим контрольную сумму, в национальной валюте.
// Банк берется из справочника Банки (классификатор): первый не помеченный на удаление.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - владелец счета
//  Настройки - Структура, Неопределено - необязательные НомерСчета, НомерСчетаУстаревший (Строка: как есть, без
//              проверки контрольной суммы), ПометкаУдаления, Недействителен (Булево: счет записывается уже с
//              этими признаками). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета
Функция НовыйБанковскийСчетКонтрагента(Контрагент, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйБанковскийСчетКонтрагента");
	ПроверитьТипПараметра("НовыйБанковскийСчетКонтрагента", "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйБанковскийСчетКонтрагента", "Настройки", Настройки, "Структура");
		ТипыКлючей = Новый Соответствие;
		ТипыКлючей.Вставить("НомерСчета", "Строка");
		ТипыКлючей.Вставить("НомерСчетаУстаревший", "Строка");
		ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
		ТипыКлючей.Вставить("Недействителен", "Булево");
		ПроверитьКлючиНастроек("НовыйБанковскийСчетКонтрагента", Настройки, ТипыКлючей);
	КонецЕсли;

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = Контрагент;
	Счет.Наименование = ПрефиксФикстуры() + "Счет_" + УникальноеОкончание();
	Счет.НомерСчета = НовыйIBAN();
	Счет.ВидСчета = "Расчетный";
	Счет.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	Счет.Банк = ПервыйБанк();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Счет, Настройки);
	КонецЕсли;

	ЗаписатьОбъект(Счет, "Банковский счет контрагента");

	Возврат Счет.Ссылка;

КонецФункции

// Создает банковский счет ОРГАНИЗАЦИИ (владелец - организация) для тестов поиска счета по номеру.
// Номер по умолчанию - новый IBAN с правильной контрольной суммой. Банк и валюта - как у счета контрагента.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - владелец счета
//  Настройки - Структура, Неопределено - необязательные НомерСчета, НомерСчетаУстаревший (Строка),
//              ПометкаУдаления (Булево: счет записывается уже помеченным на удаление).
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета
Функция НовыйБанковскийСчетОрганизации(Организация, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйБанковскийСчетОрганизации");
	ПроверитьТипПараметра("НовыйБанковскийСчетОрганизации", "Организация", Организация, "СправочникСсылка.Организации");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйБанковскийСчетОрганизации", "Настройки", Настройки, "Структура");
		Допустимые = СтрРазделить("НомерСчета,НомерСчетаУстаревший,ПометкаУдаления", ",");
		Для Каждого Элемент Из Настройки Цикл
			Если Допустимые.Найти(Элемент.Ключ) = Неопределено Тогда
				ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации: неизвестный ключ настроек '"
					+ Элемент.Ключ + "' (допустимы " + СтрСоединить(Допустимые, ", ") + "); запись в базу не начиналась.";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = Организация;
	Счет.Наименование = ПрефиксФикстуры() + "СчетОрганизации_" + УникальноеОкончание();
	Счет.НомерСчета = НовыйIBAN();
	Счет.ВидСчета = "Расчетный";
	Счет.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	Счет.Банк = ПервыйБанк();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Счет, Настройки);
	КонецЕсли;

	ЗаписатьОбъект(Счет, "Банковский счет организации");

	Возврат Счет.Ссылка;

КонецФункции

// Создает ОРГАНИЗАЦИЮ фикстуры (с префиксом в наименовании). Нужна тестам "другая наша организация": реальные
// организации базы не пишутся даже внутри транзакции, а состояние их КонтрагентИнтеркампани - свойство базы, не фикстуры.
//
// Параметры:
//  Настройки - Структура, Неопределено - необязательный КонтрагентИнтеркампани (СправочникСсылка.Контрагенты;
//              без ключа реквизит пуст). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации
Функция НоваяОрганизация(Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НоваяОрганизация");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НоваяОрганизация", "Настройки", Настройки, "Структура");
		ТипыКлючей = Новый Соответствие;
		ТипыКлючей.Вставить("КонтрагентИнтеркампани", "СправочникСсылка.Контрагенты");
		ПроверитьКлючиНастроек("НоваяОрганизация", Настройки, ТипыКлючей);
	КонецЕсли;

	Организация = Справочники.Организации.СоздатьЭлемент();
	Организация.Заполнить(Неопределено);
	Имя = ПрефиксФикстуры() + "Организация_" + УникальноеОкончание();
	Организация.Наименование = Имя;
	Организация.НаименованиеПолное = Имя;
	Если Настройки <> Неопределено И Настройки.Свойство("КонтрагентИнтеркампани") Тогда
		Организация.КонтрагентИнтеркампани = Настройки.КонтрагентИнтеркампани;
	КонецЕсли;

	ЗаписатьОбъект(Организация, "Организация");

	Возврат Организация.Ссылка;

КонецФункции

// Создает физическое лицо фикстуры (с префиксом в наименовании).
//
// Параметры:
//  Настройки - Структура, Неопределено - зарезервировано (ключей нет); параметр существует, чтобы вызов с заведомо
//              неверным значением (не структурой) был безопасен для теста охраны.
//
// Возвращаемое значение:
//  СправочникСсылка.ФизическиеЛица
Функция НовоеФизЛицо(Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовоеФизЛицо");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовоеФизЛицо", "Настройки", Настройки, "Структура");
		ПроверитьКлючиНастроек("НовоеФизЛицо", Настройки, Новый Соответствие);
	КонецЕсли;

	ФизЛицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
	ФизЛицо.Заполнить(Неопределено);
	ФизЛицо.Наименование = ПрефиксФикстуры() + "ФизЛицо_" + УникальноеОкончание();

	ЗаписатьОбъект(ФизЛицо, "Физическое лицо");

	Возврат ФизЛицо.Ссылка;

КонецФункции

// Создает сотрудника физлица. "Действующий" в УНФ - запись регистра ТекущиеКадровыеДанныеСотрудников с заполненной
// датой приема и ПУСТОЙ датой увольнения (так форма сотрудника различает "принят" и "уволен"); построитель пишет эту
// запись напрямую, не оформляя кадровые документы.
//
// Параметры:
//  ФизЛицо - СправочникСсылка.ФизическиеЛица
//  Настройки - Структура, Неопределено - необязательные: Состояние (Строка: "Работает" - по умолчанию, "Уволен",
//              "НеПринят" - записи в регистре нет), Организация (СправочникСсылка.Организации; по умолчанию
//              Константы.УчетПоКомпании.Компания(Организация()) - так вендор пишет кадровые данные), Недействителен, ПометкаУдаления (Булево). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.Сотрудники
Функция НовыйСотрудник(ФизЛицо, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйСотрудник");
	ПроверитьТипПараметра("НовыйСотрудник", "ФизЛицо", ФизЛицо, "СправочникСсылка.ФизическиеЛица");
	Состояние = "Работает";
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйСотрудник", "Настройки", Настройки, "Структура");
		ТипыКлючей = Новый Соответствие;
		ТипыКлючей.Вставить("Состояние", "Строка");
		ТипыКлючей.Вставить("Организация", "СправочникСсылка.Организации");
		ТипыКлючей.Вставить("Недействителен", "Булево");
		ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
		ПроверитьКлючиНастроек("НовыйСотрудник", Настройки, ТипыКлючей);
		Если Настройки.Свойство("Состояние") Тогда
			Состояние = Настройки.Состояние;
			Если Состояние <> "Работает" И Состояние <> "Уволен" И Состояние <> "НеПринят" Тогда
				ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйСотрудник: Состояние '" + Состояние
					+ "' недопустимо (Работает, Уволен, НеПринят); запись в базу не начиналась.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	Сотрудник.Заполнить(Неопределено);
	Сотрудник.Наименование = ПрефиксФикстуры() + "Сотрудник_" + УникальноеОкончание();
	Сотрудник.Физлицо = ФизЛицо;
	Если Настройки <> Неопределено И Настройки.Свойство("Недействителен") Тогда
		Сотрудник.Недействителен = Настройки.Недействителен;
	КонецЕсли;
	ЗаписатьОбъект(Сотрудник, "Сотрудник");

	Если Состояние <> "НеПринят" Тогда
		Набор = РегистрыСведений.ТекущиеКадровыеДанныеСотрудников.СоздатьНаборЗаписей();
		Набор.Отбор.Сотрудник.Установить(Сотрудник.Ссылка);
		Запись = Набор.Добавить();
		Запись.Сотрудник = Сотрудник.Ссылка;
		// По умолчанию - то, что пишет вендор: компания организации (Константы.УчетПоКомпании.Компания), а не сама организация.
		Запись.Организация = ?(Настройки <> Неопределено И Настройки.Свойство("Организация"), Настройки.Организация,
			Константы.УчетПоКомпании.Компания(Организация()));
		Запись.ДатаПриема = НачалоДня(ТекущаяДатаСеанса()) - 60 * 86400;
		Если Состояние = "Уволен" Тогда
			Запись.ДатаУвольнения = НачалоДня(ТекущаяДатаСеанса()) - 10 * 86400;
		КонецЕсли;
		Попытка
			Набор.Записать();
		Исключение
			ВызватьИсключение "СМП_ТестыДанныеУНФ: не записаны кадровые данные сотрудника: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
		КонецПопытки;
	КонецЕсли;

	Если Настройки <> Неопределено И Настройки.Свойство("ПометкаУдаления") И Настройки.ПометкаУдаления Тогда
		УстановитьПометкуУдаленияОбъекта(Сотрудник, "Сотрудник");
	КонецЕсли;

	Возврат Сотрудник.Ссылка;

КонецФункции

// Создает сотрудника физлица НАСТОЯЩИМ кадровым путем УНФ: проведением вендорского документа ПриемНаРаботу. Запись
// регистров "Сотрудники" и ТекущиеКадровыеДанныеСотрудников делает сам вендор, поэтому организация в кадровых данных - та
// же, что в проведении: Константы.УчетПоКомпании.Компания(Организация документа) (вендор пишет регистр на "компанию",
// ПроведениеДокументовУНФ.ИнициализироватьДополнительныеСвойстваДляПроведения). Построитель НовыйСотрудник пишет регистр
// напрямую и такого превращения не делает - он нужен для случаев "уволен" и "не принят".
//
// Создаются: сотрудник, должность (Справочник.Должности, префикс фикстуры в наименовании), проведенный ПриемНаРаботу
// (префикс в комментарии) с подразделением Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение, одной ставкой и датой приема за
// 60 суток до даты фикстуры. Начислений и удержаний документ не содержит.
//
// Параметры:
//  ФизЛицо - СправочникСсылка.ФизическиеЛица
//  ОрганизацияДокумента - СправочникСсылка.Организации, Неопределено - организация документа; по умолчанию Организация()
//
// Возвращаемое значение:
//  СправочникСсылка.Сотрудники
Функция НовыйСотрудникПриемомНаРаботу(ФизЛицо, ОрганизацияДокумента = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйСотрудникПриемомНаРаботу");
	ПроверитьТипПараметра("НовыйСотрудникПриемомНаРаботу", "ФизЛицо", ФизЛицо, "СправочникСсылка.ФизическиеЛица");
	Если ОрганизацияДокумента <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйСотрудникПриемомНаРаботу", "ОрганизацияДокумента", ОрганизацияДокумента, "СправочникСсылка.Организации");
	КонецЕсли;

	Подразделение = Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение;
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу: в базе нет предопределенного основного подразделения";
	КонецЕсли;

	Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
	Сотрудник.Заполнить(Неопределено);
	Сотрудник.Наименование = ПрефиксФикстуры() + "Сотрудник_" + УникальноеОкончание();
	Сотрудник.Физлицо = ФизЛицо;
	ЗаписатьОбъект(Сотрудник, "Сотрудник");

	Должность = Справочники.Должности.СоздатьЭлемент();
	Должность.Наименование = ПрефиксФикстуры() + "Должность_" + УникальноеОкончание();
	ЗаписатьОбъект(Должность, "Должность");

	ДатаПриема = НачалоДня(ДатаФикстуры()) - 60 * 86400;
	Документ = Документы.ПриемНаРаботу.СоздатьДокумент();
	Документ.Дата = ДатаПриема;
	Документ.Организация = ?(ОрганизацияДокумента = Неопределено, Организация(), ОрганизацияДокумента);

	// Вендор при включенной опции "Вести штатное расписание" (ВыполнитьКонтрольШтатногоРасписания) требует ставки в штатном
	// расписании на компанию, должность и подразделение: иначе "в штатном расписании не предусмотрены ставки". Константу
	// построитель только читает; запись регистра ШтатноеРасписание - внутри транзакции теста, должность новая (префикс).
	Если Константы.ФункциональнаяОпцияВестиШтатноеРасписание.Получить() Тогда
		Набор = РегистрыСведений.ШтатноеРасписание.СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить(ДатаПриема);
		Набор.Отбор.Организация.Установить(Константы.УчетПоКомпании.Компания(Документ.Организация));
		Набор.Отбор.СтруктурнаяЕдиница.Установить(Подразделение);
		Набор.Отбор.Должность.Установить(Должность.Ссылка);
		Запись = Набор.Добавить();
		Запись.Период = ДатаПриема;
		Запись.Организация = Константы.УчетПоКомпании.Компания(Документ.Организация);
		Запись.СтруктурнаяЕдиница = Подразделение;
		Запись.Должность = Должность.Ссылка;
		Запись.КоличествоСтавок = 1;
		Попытка
			Набор.Записать();
		Исключение
			ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу: не записано штатное расписание: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
		КонецПопытки;
	КонецЕсли;

	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();
	СтрокаСотрудника = Документ.Сотрудники.Добавить();
	СтрокаСотрудника.Сотрудник = Сотрудник.Ссылка;
	СтрокаСотрудника.Период = ДатаПриема;
	СтрокаСотрудника.СтруктурнаяЕдиница = Подразделение;
	СтрокаСотрудника.Должность = Должность.Ссылка;
	СтрокаСотрудника.ЗанимаемыхСтавок = 1;
	ЗаписатьДокумент(Документ, Истина, "Прием на работу");

	Возврат Сотрудник.Ссылка;

КонецФункции

// Создает банковский счет ФИЗЛИЦА (владелец - физлицо) в национальной валюте.
//
// Параметры:
//  ФизЛицо - СправочникСсылка.ФизическиеЛица - владелец счета
//  Настройки - Структура, Неопределено - необязательные НомерСчета, НомерСчетаУстаревший (Строка), ПометкаУдаления,
//              Недействителен (Булево). Ключ вне перечня - исключение до записи.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета
Функция НовыйБанковскийСчетФизЛица(ФизЛицо, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйБанковскийСчетФизЛица");
	ПроверитьТипПараметра("НовыйБанковскийСчетФизЛица", "ФизЛицо", ФизЛицо, "СправочникСсылка.ФизическиеЛица");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НовыйБанковскийСчетФизЛица", "Настройки", Настройки, "Структура");
		ТипыКлючей = Новый Соответствие;
		ТипыКлючей.Вставить("НомерСчета", "Строка");
		ТипыКлючей.Вставить("НомерСчетаУстаревший", "Строка");
		ТипыКлючей.Вставить("ПометкаУдаления", "Булево");
		ТипыКлючей.Вставить("Недействителен", "Булево");
		ПроверитьКлючиНастроек("НовыйБанковскийСчетФизЛица", Настройки, ТипыКлючей);
	КонецЕсли;

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Владелец = ФизЛицо;
	Счет.Наименование = ПрефиксФикстуры() + "СчетФизЛица_" + УникальноеОкончание();
	Счет.НомерСчета = НовыйIBAN();
	Счет.ВидСчета = "Расчетный";
	Счет.ВалютаДенежныхСредств = Константы.НациональнаяВалюта.Получить();
	Счет.Банк = ПервыйБанк();
	Если Настройки <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Счет, Настройки);
	КонецЕсли;

	ЗаписатьОбъект(Счет, "Банковский счет физлица");

	Возврат Счет.Ссылка;

КонецФункции

// Фикстура конфликта "свой счет против правила назначения" (для задачи 9, где появится шаг 4): операция, у которой
// счет контрагента - ДРУГОЙ счет организации выписки (шаг 1 дает перевод между своими счетами), а текст назначения
// содержит фразу правила, которое ДАЛО БЫ другой вид (поступление - ОтПокупателя, списание - Поставщику). Свой счет
// обязан победить.
//
// Параметры:
//  ВидДокумента - Строка - "ПоступлениеНаСчет" или "РасходСоСчета"
//
// Возвращаемое значение:
//  Структура - ключи: Операция (строка конверта, см. НоваяОперацияКонверта), СвойСчет
//              (СправочникСсылка.БанковскиеСчета), Правило (СправочникСсылка.СоответствияНазначенийПлатежаИРеквизитовПлатежа),
//              Фраза (Строка).
Функция НовыйКонфликтСвойСчетИПравило(ВидДокумента) Экспорт

	ПроверитьТранзакцию("НовыйКонфликтСвойСчетИПравило");
	ПроверитьТипПараметра("НовыйКонфликтСвойСчетИПравило", "ВидДокумента", ВидДокумента, "Строка");
	Если ВидДокумента <> "ПоступлениеНаСчет" И ВидДокумента <> "РасходСоСчета" Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НовыйКонфликтСвойСчетИПравило: ВидДокумента '" + ВидДокумента
			+ "' недопустим (ПоступлениеНаСчет или РасходСоСчета); запись в базу не начиналась.";
	КонецЕсли;

	ЭтоПоступление = (ВидДокумента = "ПоступлениеНаСчет");
	СвойСчет = НовыйБанковскийСчетОрганизации(Организация());

	Настройки = Новый Структура;
	Если ЭтоПоступление Тогда
		Настройки.Вставить("ВидОперацииПоступленияНаСчет",
			ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"));
	Иначе
		Настройки.Вставить("ВидОперацииРасходаСоСчета",
			ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	КонецЕсли;
	Правило = НовоеПравилоНазначения(Настройки);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Правила.ФразаДляПоискаВНазначенииПлатежа КАК Фраза,
		|	Счета.НомерСчета КАК НомерСчета
		|ИЗ
		|	Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа КАК Правила,
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Правила.Ссылка = &Правило
		|	И Счета.Ссылка = &Счет");
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("Счет", СвойСчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Операция = НоваяОперацияКонверта(Новый Структура("КонтрагентНомерСчета, НазначениеПлатежа, Направление",
		Выборка.НомерСчета, "Оплата по договору " + Выборка.Фраза,
		СМП_ТестыВызовПродукта.Вызвать(?(ЭтоПоступление, "СМП_ВыпискаБанка.НаправлениеПоступило", "СМП_ВыпискаБанка.НаправлениеСписано"))));

	Возврат Новый Структура("Операция, СвойСчет, Правило, Фраза", Операция, СвойСчет, Правило, Выборка.Фраза);

КонецФункции

// Создает номенклатуру-услугу для строк заказов и счетов.
//
// Параметры:
//  Настройки - Структура, Неопределено - зарезервировано; параметр существует, чтобы вызов с
//              заведомо неверным значением (не структурой) был безопасен для теста охраны.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура
Функция НоваяУслуга(Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НоваяУслуга");
	Если Настройки <> Неопределено Тогда
		ПроверитьТипПараметра("НоваяУслуга", "Настройки", Настройки, "Структура");
	КонецЕсли;

	Услуга = Справочники.Номенклатура.СоздатьЭлемент();
