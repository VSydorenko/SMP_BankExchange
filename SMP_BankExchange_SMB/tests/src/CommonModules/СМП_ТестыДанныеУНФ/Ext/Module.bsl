// Создает заказ покупателя с одной строкой услуги на Сумму.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Договор - СправочникСсылка.ДоговорыКонтрагентов
//  Сумма - Число
//  Провести - Булево - при Ложь документ только записывается
//  Настройки - Структура, Неопределено - необязательные ключи (ключ вне перечня и неверный тип - исключение до записи):
//   * Номер - Строка - номер документа (до 11 знаков; по умолчанию присваивает платформа). Нумерация документа по годам
//             с контролем уникальности: одинаковый номер допустим только в разные годы
//   * Дата - Дата - дата документа (по умолчанию дата фикстуры)
//   * Организация - СправочникСсылка.Организации - по умолчанию Организация(); для другой организации создается новый
//             банковский счет этой организации
//   * НомерВходящегоДокумента - Строка - только для документов, у которых есть такой реквизит
//   * ПометкаУдаления - Булево - после записи пометить документ на удаление штатным методом. Проведенный документ помеченным
//             не бывает (измерено: запись объекта с признаком отказывает "Проведенный документ не может быть помечен на
//             удаление", в том числе при ОбменДанными.Загрузка; штатная пометка проведенного падает в обработке вендора), поэтому
//             вместе с Провести = Истина ключ отклоняется исключением до записи
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя
Функция НовыйЗаказПокупателя(Контрагент, Договор, Сумма, Провести = Истина, Настройки = Неопределено) Экспорт

	ПроверитьТранзакцию("НовыйЗаказПокупателя");
	ПроверитьТипыПараметровДокумента("НовыйЗаказПокупателя", Контрагент, Договор, Сумма);
	ПроверитьНастройкиДокумента("НовыйЗаказПокупателя", Настройки, "ЗаказПокупателя", Провести);

	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаполнитьШапкуДокумента(Документ, Контрагент, Договор, Настройки);
	Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу");
	Документ.ДатаОтгрузки = Документ.Дата;
	ДобавитьСтрокуУслуги(Документ.Запасы, Сумма);
	Документ.СуммаДокумента = Сумма;

	ЗаписатьДокументПоНастройкам(Документ, Провести, "Заказ покупателя", Настройки);

	Возврат Документ.Ссылка;

КонецФункции

