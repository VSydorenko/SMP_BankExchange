// Создает акт выполненных работ покупателю с одной строкой услуги на Сумму. Проведенный акт порождает ДОЛГ
// покупателя в РасчетыСПокупателями - источник долга для измерения способа зачета "Авто" (задача 5).
// Дата акта на час раньше даты фикстуры: банковский документ на дату фикстуры видит долг на свой момент.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//  Договор - СправочникСсылка.ДоговорыКонтрагентов
//  Сумма - Число
//  Провести - Булево - при Ложь документ только записывается
//
// Возвращаемое значение:
//  ДокументСсылка.АктВыполненныхРабот
Функция НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Провести = Истина) Экспорт

	ПроверитьТранзакцию("НовыйАктВыполненныхРабот");
	ПроверитьТипыПараметровДокумента("НовыйАктВыполненныхРабот", Контрагент, Договор, Сумма);

	Документ = Документы.АктВыполненныхРабот.СоздатьДокумент();
	Документ.Дата = ДатаФикстуры() - 3600;
	Документ.Заполнить(Договор);
	Документ.Дата = ДатаФикстуры() - 3600;
	Документ.Организация = Организация();
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();
	ДобавитьСтрокуУслуги(Документ.РаботыИУслуги, Сумма);
	Документ.СуммаДокумента = Сумма;

	ЗаписатьДокумент(Документ, Провести, "Акт выполненных работ");

	Возврат Документ.Ссылка;

КонецФункции

// Создает проведенный банковский документ, частично оплачивающий основание:
// ПоступлениеНаСчет для счета/заказа покупателя, РасходСоСчета для счета/заказа поставщика.
// Табличную часть и шапку заполняет штатное заполнение на основании документа с суммой.
//
// Параметры:
//  Основание - ДокументСсылка.СчетНаОплату, ДокументСсылка.ЗаказПокупателя,
//              ДокументСсылка.СчетНаОплатуПоставщика, ДокументСсылка.ЗаказПоставщику
//  Сумма - Число - сумма оплаты (меньше суммы основания)
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета
Функция НоваяОплата(Основание, Сумма) Экспорт

	ПроверитьТранзакцию("НоваяОплата");
	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования <> Тип("ДокументСсылка.СчетНаОплату") И ТипОснования <> Тип("ДокументСсылка.ЗаказПокупателя")
		И ТипОснования <> Тип("ДокументСсылка.СчетНаОплатуПоставщика") И ТипОснования <> Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ОтказПоТипуПараметра("НоваяОплата", "Основание", "СчетНаОплату, ЗаказПокупателя, СчетНаОплатуПоставщика или ЗаказПоставщику", Основание);
	КонецЕсли;
	ПроверитьТипПараметра("НоваяОплата", "Сумма", Сумма, "Число");

	ИмяОснования = Основание.Метаданные().Имя;
	Если ИмяОснования = "СчетНаОплату" Или ИмяОснования = "ЗаказПокупателя" Тогда
		Документ = Документы.ПоступлениеНаСчет.СоздатьДокумент();
	ИначеЕсли ИмяОснования = "СчетНаОплатуПоставщика" Или ИмяОснования = "ЗаказПоставщику" Тогда
		Документ = Документы.РасходСоСчета.СоздатьДокумент();
	Иначе
		ВызватьИсключение "СМП_ТестыДанныеУНФ.НоваяОплата: основание " + ИмяОснования + " не поддерживается";
	КонецЕсли;

	Документ.Дата = ДатаФикстуры();
	Документ.Заполнить(Новый Структура("Документ, Сумма", Основание, Сумма));
	Документ.Дата = ДатаФикстуры();
	Документ.СуммаДокумента = Сумма;
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();

	ЗаписатьДокумент(Документ, Истина, "Оплата");

	Возврат Документ.Ссылка;

КонецФункции

#КонецОбласти

#Область Служебные

// Охрана: построитель пишет в базу только внутри транзакции теста.
Процедура ПроверитьТранзакцию(ИмяФункции)

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": вызов вне транзакции отклонен. "
			+ "Построитель пишет в общую базу агента и работает только внутри транзакции: "
			+ "тест должен быть помечен .ВТранзакции().";
	КонецЕсли;

КонецПроцедуры

// Проверка типа параметра: неверный тип - исключение ДО любой записи. Текст НЕ содержит "вне транзакции".
Процедура ПроверитьТипПараметра(ИмяФункции, ИмяПараметра, Значение, ИменаТипов)

	ДопустимыеТипы = Новый ОписаниеТипов(ИменаТипов);
	Если Не ДопустимыеТипы.СодержитТип(ТипЗнч(Значение)) Тогда
		ОтказПоТипуПараметра(ИмяФункции, ИмяПараметра, ИменаТипов, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ОтказПоТипуПараметра(ИмяФункции, ИмяПараметра, ОжидаемыеТипы, Значение)

	ВызватьИсключение "СМП_ТестыДанныеУНФ." + ИмяФункции + ": неверный тип параметра " + ИмяПараметра
		+ " (ожидается " + ОжидаемыеТипы + ", получено " + Строка(ТипЗнч(Значение)) + "); запись в базу не начиналась.";

КонецПроцедуры

Процедура ПроверитьТипыПараметровДокумента(ИмяФункции, Контрагент, Договор, Сумма)

	ПроверитьТипПараметра(ИмяФункции, "Контрагент", Контрагент, "СправочникСсылка.Контрагенты");
	ПроверитьТипПараметра(ИмяФункции, "Договор", Договор, "СправочникСсылка.ДоговорыКонтрагентов");
	ПроверитьТипПараметра(ИмяФункции, "Сумма", Сумма, "Число");

КонецПроцедуры

// Зерно генератора случайных чисел из нового идентификатора: два вызова в одну миллисекунду дают разные зерна.
Функция ЗерноГСЧ()

	Шестнадцатеричные = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 7);
	Зерно = 0;
	Для Индекс = 1 По СтрДлина(Шестнадцатеричные) Цикл
		Зерно = Зерно * 16 + Найти("0123456789abcdef", Сред(Шестнадцатеричные, Индекс, 1)) - 1;
	КонецЦикла;

	Возврат Зерно;

КонецФункции

Функция УникальноеОкончание()

	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

КонецФункции

// Дата документов фикстуры. Правило: текущая дата сеанса. Если проведение упадет из-за отсутствия
// курса на дату, правило заменяется выбором среди дней, на которые курс в КурсыВалют уже есть.
Функция ДатаФикстуры()

	Возврат ТекущаяДатаСеанса();

КонецФункции

Функция ПервыйБанк()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка ИЗ Справочник.Банки КАК Б ГДЕ НЕ Б.ПометкаУдаления И НЕ Б.ЭтоГруппа УПОРЯДОЧИТЬ ПО Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: в справочнике Банки нет ни одного банка для счета контрагента";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

Функция ПерваяЕдиницаИзмерения()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Е.Ссылка КАК Ссылка ИЗ Справочник.КлассификаторЕдиницИзмерения КАК Е ГДЕ НЕ Е.ПометкаУдаления УПОРЯДОЧИТЬ ПО Е.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: в классификаторе единиц измерения нет ни одной единицы";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

Функция СтавкаНДСБезНалога()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ Справочник.СтавкиНДС КАК С ГДЕ НЕ С.ПометкаУдаления И С.НеОблагается УПОРЯДОЧИТЬ ПО С.Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыДанныеУНФ: нет ставки НДС 'не облагается'";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Общая шапка документов: штатное заполнение (организация по правилу, валюта, курс из настроек),
// затем явные значения построителя.
Процедура ЗаполнитьШапкуДокумента(Документ, Контрагент, Договор)

	Документ.Дата = ДатаФикстуры();
	Документ.Заполнить(Новый Структура("Организация, Контрагент, Договор", Организация(), Контрагент, Договор));
	Документ.Дата = ДатаФикстуры();
	Документ.Организация = Организация();
	Документ.Контрагент = Контрагент;
	Документ.Договор = Договор;
	Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	Документ.БанковскийСчет = БанковскийСчетОрганизации();
	Документ.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС");
	Документ.Комментарий = ПрефиксФикстуры() + УникальноеОкончание();

КонецПроцедуры

Функция ДобавитьСтрокуУслуги(ТабличнаяЧасть, Сумма)

	Услуга = НоваяУслуга();
	Строка = ТабличнаяЧасть.Добавить();
	Строка.Номенклатура = Услуга;
	Строка.ЕдиницаИзмерения = ПерваяЕдиницаИзмерения();
	Строка.Количество = 1;
	Строка.Цена = Сумма;
	Строка.Сумма = Сумма;
	Строка.Всего = Сумма;
	Строка.СтавкаНДС = СтавкаНДСБезНалога();
	Строка.СуммаНДС = 0;

	Возврат Строка;

КонецФункции

Процедура ЗаписатьОбъект(Объект, Описание)

	Попытка
		Объект.Записать();
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: не записан объект '" + Описание + "': "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьДокумент(Документ, Провести, Описание)

	Попытка
		Если Провести Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Документ.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	Исключение
		ВызватьИсключение "СМП_ТестыДанныеУНФ: документ '" + Описание + "' не " + ?(Провести, "проведен", "записан") + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

// Сообщения пользователю, накопленные платформой за вызов (причины отказа проведения).
Функция СообщенияПользователю()

	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Символы.ПС + "  - " + Сообщение.Текст;
	КонецЦикла;

	Возврат ?(ПустаяСтрока(Текст), "", Символы.ПС + "Сообщения платформы:" + Текст);

КонецФункции

#КонецОбласти
