// Тесты нормализованного поручения и преобразования документа УНФ (план 07, задача 2, спека D8).
//
// Правила - docs/architecture/testing.md. Продукт (СМП_ВыгрузкаПлатежей) вызывается ТОЛЬКО через
// СМП_ТестыВызовПродукта (позднее связывание). Тесты с данными работают в СВОЕЙ транзакции; дата и сумма
// поручения явные, чужие объекты базы не используются (организация, банки, контрагенты - фикстуры).
//
// Три части:
//  1. Конструктор: состав полей поручения - СПЕЦИФИКАЦИЯ (перечень ниже меняется только добавлением полей).
//  2. Проверка на границе: тип каждого поля, обязательные поля, текст причины. Данных в базе не нужно.
//  3. Преобразование документа: таблица "реквизит документа УНФ -> поле поручения" (литералы в таблице, не
//     вычисляются продуктом) и диагностика по каждой ссылке (Review Focus 4).
//
// Условие измерения текстов причин: сеанс тестов ru (тексты продукта через НСтр; проверяются фрагменты ru).
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Конструктор поручения: состав полей")
			.ДобавитьСерверныйТест("Конструктор_СоставПолейПоручения")
			.ДобавитьСерверныйТест("Конструктор_СоставПолейСтороны")
			.ДобавитьСерверныйТест("Конструктор_ПустыеЗначенияПоТипам")
			.ДобавитьСерверныйТест("Конструктор_КаждыйВызовНезависим")
		.ДобавитьТестовыйНабор("Проверка поручения на границе")
			.ДобавитьСерверныйТест("Проверка_ПринимаетЗаполненноеПоручение")
			.ДобавитьСерверныйТест("Проверка_ПринимаетПоручениеСКонструктора")
			.ДобавитьСерверныйТест("Проверка_Отклоняет")
				.СПараметрами("не структура", "Заменить", "", 5, "не структура")
				.СПараметрами("лишнее поле поручения", "Задать", "Лишнее", "x", "лишнее поле Лишнее")
				.СПараметрами("нет поля поручения", "Удалить", "Номер", Неопределено, "нет поля Номер")
				.СПараметрами("нет поля в стороне", "Удалить", "Получатель.МФО", Неопределено, "нет поля Получатель.МФО")
				.СПараметрами("лишнее поле в стороне", "Задать", "Плательщик.Лишнее", "x", "лишнее поле Плательщик.Лишнее")
				.СПараметрами("сторона не структура", "Задать", "Плательщик", "x", "Плательщик")
				.СПараметрами("сумма строкой", "Задать", "Сумма", "100", "поле Сумма имеет тип Строка")
				.СПараметрами("дата строкой", "Задать", "Дата", "05.03.2026", "поле Дата имеет тип Строка")
				.СПараметрами("номер числом", "Задать", "Номер", 123, "поле Номер имеет тип Число")
				.СПараметрами("МФО числом", "Задать", "Получатель.МФО", 305299, "поле Получатель.МФО имеет тип Число")
				.СПараметрами("сумма ноль", "Задать", "Сумма", 0, "поле Сумма равно 0")
				.СПараметрами("сумма отрицательная", "Задать", "Сумма", -5.5, "поле Сумма равно -5.50")
				.СПараметрами("пустая дата", "Задать", "Дата", Дата(1, 1, 1), "поле Дата не заполнено")
				.СПараметрами("пустой номер", "Задать", "Номер", "", "поле Номер не заполнено")
				.СПараметрами("пустое назначение", "Задать", "НазначениеПлатежа", "", "поле НазначениеПлатежа не заполнено")
				.СПараметрами("пустое наименование плательщика", "Задать", "Плательщик.Наименование", "", "поле Плательщик.Наименование не заполнено")
				.СПараметрами("пустое наименование получателя", "Задать", "Получатель.Наименование", "", "поле Получатель.Наименование не заполнено")
				.СПараметрами("пустой счет плательщика", "Задать", "Плательщик.НомерСчета", "", "поле Плательщик.НомерСчета не заполнено")
				.СПараметрами("пустой счет получателя", "Задать", "Получатель.НомерСчета", "", "поле Получатель.НомерСчета не заполнено")
				.СПараметрами("пустое МФО плательщика", "Задать", "Плательщик.МФО", "", "поле Плательщик.МФО не заполнено")
				.СПараметрами("пустое МФО получателя", "Задать", "Получатель.МФО", "", "поле Получатель.МФО не заполнено")
			.ДобавитьСерверныйТест("Проверка_НеТребуетКодаГородаIBANБанка")
				.СПараметрами("код плательщика пуст", "Плательщик.Код")
				.СПараметрами("код получателя пуст", "Получатель.Код")
				.СПараметрами("город пуст", "Получатель.Город")
				.СПараметрами("IBAN пуст", "Плательщик.IBAN")
				.СПараметрами("название банка пусто", "Получатель.Банк")
			.ДобавитьСерверныйТест("Проверка_НазываетВсеПричиныСразу")
			.ДобавитьСерверныйТест("Проверка_НеМеняетПоручение")
		.ДобавитьТестовыйНабор("Преобразование документа УНФ: таблица реквизитов")
			// Сценарий, путь поля, ожидаемое. "@Объект.Реквизит" - значение реквизита объекта фикстуры (имя банка и номер
			// счета содержат уникальный суффикс прогона); остальное - литерал.
			.ДобавитьСерверныйТест("Преобразование_РеквизитВПоле").ВТранзакции()
				// юрлицо - юрлицо, рахунки IBAN, тексти сторін заповнені
				.СПараметрами("юр-юр: номер без ведущих нулей", "ЮрЮр", "Номер", "123")
				.СПараметрами("юр-юр: дата документа", "ЮрЮр", "Дата", Дата(2026, 3, 5, 14, 30, 0))
				.СПараметрами("юр-юр: сумма", "ЮрЮр", "Сумма", 1234.5)
				.СПараметрами("юр-юр: назначение без пробелов по краям", "ЮрЮр", "НазначениеПлатежа", "Оплата за товар №1")
				.СПараметрами("юр-юр: плательщик - ТекстПлательщика", "ЮрЮр", "Плательщик.Наименование", "ТОВ Платник (текст документа)")
				.СПараметрами("юр-юр: плательщик - код ЕДРПОУ организации", "ЮрЮр", "Плательщик.Код", "01234567")
				.СПараметрами("юр-юр: плательщик - вид кода", "ЮрЮр", "Плательщик.ВидКода", "ЕДРПОУ")
				.СПараметрами("юр-юр: плательщик - номер счета", "ЮрЮр", "Плательщик.НомерСчета", "@СчетПлательщика.НомерСчета")
				.СПараметрами("юр-юр: плательщик - IBAN", "ЮрЮр", "Плательщик.IBAN", "@СчетПлательщика.НомерСчета")
				.СПараметрами("юр-юр: плательщик - банк", "ЮрЮр", "Плательщик.Банк", "@БанкПлательщика.Наименование")
				.СПараметрами("юр-юр: плательщик - МФО с ведущим нулем", "ЮрЮр", "Плательщик.МФО", "012345")
				.СПараметрами("юр-юр: плательщик - город банка", "ЮрЮр", "Плательщик.Город", "Київ")
				.СПараметрами("юр-юр: получатель - ТекстПолучателя", "ЮрЮр", "Получатель.Наименование", "ТОВ Одержувач (текст документа)")
				.СПараметрами("юр-юр: получатель - код ЕДРПОУ контрагента", "ЮрЮр", "Получатель.Код", "12345678")
				.СПараметрами("юр-юр: получатель - вид кода", "ЮрЮр", "Получатель.ВидКода", "ЕДРПОУ")
				.СПараметрами("юр-юр: получатель - номер счета", "ЮрЮр", "Получатель.НомерСчета", "@СчетПолучателя.НомерСчета")
				.СПараметрами("юр-юр: получатель - IBAN", "ЮрЮр", "Получатель.IBAN", "@СчетПолучателя.НомерСчета")
				.СПараметрами("юр-юр: получатель - банк", "ЮрЮр", "Получатель.Банк", "@БанкПолучателя.Наименование")
				.СПараметрами("юр-юр: получатель - МФО", "ЮрЮр", "Получатель.МФО", "305299")
				.СПараметрами("юр-юр: получатель - город банка", "ЮрЮр", "Получатель.Город", "Львів")
				// ФОП (организация) и ФОП (контрагент): код - РНОКПП из ИНН, а не ЕДРПОУ-обманка
				.СПараметрами("фоп-фоп: плательщик - РНОКПП с ведущим нулем из ИНН", "ФопФоп", "Плательщик.Код", "0123456789")
				.СПараметрами("фоп-фоп: плательщик - вид кода", "ФопФоп", "Плательщик.ВидКода", "РНОКПП")
				.СПараметрами("фоп-фоп: получатель - РНОКПП с двумя ведущими нулями", "ФопФоп", "Получатель.Код", "0012345678")
				.СПараметрами("фоп-фоп: получатель - вид кода", "ФопФоп", "Получатель.ВидКода", "РНОКПП")
				// физлицо-контрагент: тоже РНОКПП (вид не юрлицо)
				.СПараметрами("физлицо: получатель - РНОКПП из ИНН", "Физлицо", "Получатель.Код", "2345678901")
				.СПараметрами("физлицо: получатель - вид кода", "Физлицо", "Получатель.ВидКода", "РНОКПП")
				// ФОП без ИНН, но с ЕДРПОУ в карточке: ЕДРПОУ не подставляется (код - по виду)
				.СПараметрами("фоп без ИНН: код пуст, ЕДРПОУ не берется", "ФопБезИНН", "Получатель.Код", "")
				.СПараметрами("фоп без ИНН: вид кода все равно РНОКПП", "ФопБезИНН", "Получатель.ВидКода", "РНОКПП")
				// счет без банка и старый 14-значный номер с ведущими нулями
				.СПараметрами("старый счет: номер как в карточке", "СтарыйСчетБезБанка", "Получатель.НомерСчета", "00026007233566")
				.СПараметрами("старый счет: IBAN пуст", "СтарыйСчетБезБанка", "Получатель.IBAN", "")
				.СПараметрами("без банка: название пусто", "СтарыйСчетБезБанка", "Получатель.Банк", "")
				.СПараметрами("без банка: МФО пусто", "СтарыйСчетБезБанка", "Получатель.МФО", "")
				.СПараметрами("без банка: город пуст", "СтарыйСчетБезБанка", "Получатель.Город", "")
				// тексты сторон пусты: наименование из полного наименования организации/контрагента
				.СПараметрами("без текстов: плательщик - полное наименование организации", "БезТекстов", "Плательщик.Наименование", "ТОВ Повна назва організації")
				.СПараметрами("без текстов: получатель - полное наименование контрагента", "БезТекстов", "Получатель.Наименование", "@Контрагент.НаименованиеПолное")
			.ДобавитьСерверныйТест("Преобразование_НомерБезВедущихНулей").ВТранзакции()
				.СПараметрами("ведущие нули", "00000123", "123")
				.СПараметрами("нули внутри и в конце остаются", "1000", "1000")
				.СПараметрами("нули перед числом с нулем внутри", "0010200", "10200")
				.СПараметрами("префикс не из цифр снимается вместе с нулями", "ПП-000045", "45")
			.ДобавитьСерверныйТест("Преобразование_ПустойКодДаетПредупреждение").ВТранзакции()
				.СПараметрами("ФОП без ИНН: получатель", "ФопБезИНН", "Получатель")
				.СПараметрами("юрлицо без ЕДРПОУ: получатель", "ЮрБезКода", "Получатель")
			.ДобавитьСерверныйТест("Преобразование_ЗаполненныйКодПредупрежденийНеДает").ВТранзакции()
			.ДобавитьСерверныйТест("Преобразование_ПоручениеНесетТолькоТипыПлатформы").ВТранзакции()
			.ДобавитьСерверныйТест("Преобразование_СуммаНольПреобразуетсяАПроверкаОтклоняет").ВТранзакции()
		.ДобавитьТестовыйНабор("Преобразование документа УНФ: отбор и диагностика по каждой ссылке")
			.ДобавитьСерверныйТест("Отбор_СтруктураРезультата").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ПустойСписокДаетПустойРезультат").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ДругойСчетПропускаетсяСПричиной").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ДругаяОрганизацияПропускаетсяСПричиной").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ПомеченныйНаУдалениеПропускаетсяСПричиной").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ДругойПериодПропускаетсяСПричиной").ВТранзакции()
				.СПараметрами("до начала периода", Дата(2026, 2, 28, 23, 59, 59))
				.СПараметрами("после конца периода", Дата(2026, 4, 1, 0, 0, 0))
			.ДобавитьСерверныйТест("Отбор_ГраницыПериодаВключены").ВТранзакции()
				.СПараметрами("начало первого дня", Дата(2026, 3, 1, 0, 0, 0))
				.СПараметрами("конец последнего дня", Дата(2026, 3, 31, 23, 59, 59))
			.ДобавитьСерверныйТест("Отбор_ПустыеГраницыПериодаНеОграничивают").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_НесуществующаяСсылкаПропускаетсяСПричиной").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ПовторнаяСсылкаПропускаетсяСПричиной").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ОдноПлохоеСредиХорошихНеТеряетХорошие").ВТранзакции()
			.ДобавитьСерверныйТест("Отбор_ПорядокСтрокКакВСпискеСсылок").ВТранзакции()
		// Временные решения координатора до ответа планировщика (каждое - одна точка в продукте).
		.ДобавитьТестовыйНабор("Преобразование документа УНФ: непрямые расчеты, валюта, налог")
			.ДобавитьСерверныйТест("Особые_НепрямыеРасчетыБерутБанкРасчетов").ВТранзакции()
				.СПараметрами("счет плательщика", "Плательщик")
				.СПараметрами("счет получателя", "Получатель")
			.ДобавитьСерверныйТест("Особые_НеНациональнаяВалютаПропускается").ВТранзакции()
				.СПараметрами("валюта документа", "Документ", "документ в валюте, отличной от национальной", "банковский счет в валюте")
				.СПараметрами("валюта счета", "Счет", "банковский счет в валюте, отличной от национальной", "документ в валюте")
			.ДобавитьСерверныйТест("Особые_ПеречислениеНалогаВыгружаетсяСПредупреждением").ВТранзакции()
		// Раунд 1 рев'ю: текст стороны при непрямых расчетах режется до первого "р/с" (вендорский экспорт КлиентБанк).
		.ДобавитьТестовыйНабор("Преобразование документа УНФ: текст стороны при непрямых расчетах")
			.ДобавитьСерверныйТест("Особые_ТекстСтороныПриНепрямыхРасчетах").ВТранзакции()
