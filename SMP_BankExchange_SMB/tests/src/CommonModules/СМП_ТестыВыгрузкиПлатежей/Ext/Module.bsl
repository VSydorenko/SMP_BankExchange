Процедура Проверка_ПринимаетПоручениеСКонструктора() Экспорт

	// Конструктор, заполненный по схеме, проходит границу: схема проверки и конструктор - одно целое.
	Поручение = ПродуктФункция("НовоеПоручение");
	ТребоватьСхему(Поручение);
	Образец = ЗаполненноеПоручение();
	Поручение.Номер = Образец.Номер;
	Поручение.Дата = Образец.Дата;
	Поручение.Сумма = Образец.Сумма;
	Поручение.НазначениеПлатежа = Образец.НазначениеПлатежа;
	Для Каждого ИмяСтороны Из СтрРазделить("Плательщик,Получатель", ",") Цикл
		Для Каждого Поле Из Образец[ИмяСтороны] Цикл
			Поручение[ИмяСтороны][Поле.Ключ] = Поле.Значение;
		КонецЦикла;
	КонецЦикла;

	Причины = ПродуктФункция("ПроверитьПоручение", Поручение);

	ЮТест.ОжидаетЧто(СтрСоединить(Причины, " | "), "Поручение с конструктора, заполненное по схеме, принято").Равно("");

