Процедура Преобразование_РеквизитВПоле(Описание, ИмяСценария, Путь, Ожидаемое) Экспорт

	Фикстура = СценарийФикстуры(ИмяСценария);

	Результат = Преобразовать(Фикстура);
	Поручение = ПоручениеИзРезультата(Результат, Фикстура.Поручение, Описание);

	Значение = ЗначениеПоПути(Поручение, Путь);
	ОжидаемоеЗначение = РазобратьОжидаемое(Ожидаемое, Фикстура);
	ЮТест.ОжидаетЧто(Значение, Описание + ": поле " + Путь).Равно(ОжидаемоеЗначение);

