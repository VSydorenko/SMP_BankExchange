Процедура Конструктор_СоставПолейСтороны() Экспорт

	Поручение = ПродуктФункция("НовоеПоручение");
	ЮТест.ОжидаетЧто(Поручение.Свойство("Плательщик"), "У поручения есть сторона Плательщик").ЭтоИстина();
	ЮТест.ОжидаетЧто(Поручение.Свойство("Получатель"), "У поручения есть сторона Получатель").ЭтоИстина();

	Ожидаемые = "Наименование,Код,ВидКода,НомерСчета,IBAN,Банк,МФО,Город";
	ЮТест.ОжидаетЧто(КлючиСтрокой(Поручение.Плательщик), "Состав и порядок полей плательщика").Равно(Ожидаемые);
	ЮТест.ОжидаетЧто(КлючиСтрокой(Поручение.Получатель), "Состав и порядок полей получателя").Равно(Ожидаемые);
	ЮТест.ОжидаетЧто(КлючиСтрокой(ПродуктФункция("НоваяСторонаПоручения")), "Конструктор стороны отдельно").Равно(Ожидаемые);

КонецПроцедуры

Процедура Конструктор_ПустыеЗначенияПоТипам() Экспорт

	Поручение = ПродуктФункция("НовоеПоручение");
	ТребоватьСхему(Поручение);

	ЮТест.ОжидаетЧто(Поручение.Номер, "Номер - пустая строка").Равно("");
	ЮТест.ОжидаетЧто(Поручение.Дата, "Дата - пустая дата").Равно(Дата(1, 1, 1));
	ЮТест.ОжидаетЧто(Поручение.Сумма, "Сумма - ноль типа Число").Равно(0);
	ЮТест.ОжидаетЧто(ТипЗнч(Поручение.Сумма), "Сумма - Число").Равно(Тип("Число"));
	ЮТест.ОжидаетЧто(Поручение.НазначениеПлатежа, "НазначениеПлатежа - пустая строка").Равно("");
	Для Каждого ИмяСтороны Из СтрРазделить("Плательщик,Получатель", ",") Цикл
		Для Каждого Поле Из Поручение[ИмяСтороны] Цикл
			ЮТест.ОжидаетЧто(Поле.Значение, ИмяСтороны + "." + Поле.Ключ + " - пустая строка").Равно("");
		КонецЦикла;
	КонецЦикла;

