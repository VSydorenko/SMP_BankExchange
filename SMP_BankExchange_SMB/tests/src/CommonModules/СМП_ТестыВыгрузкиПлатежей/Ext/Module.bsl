Процедура Преобразование_ПустойКодДаетПредупреждение(Описание, ИмяСценария, Сторона) Экспорт

	Фикстура = СценарийФикстуры(ИмяСценария);

	Результат = Преобразовать(Фикстура);
	ПоручениеИзРезультата(Результат, Фикстура.Поручение, Описание + " (пустой код - только предупреждение, не отказ)");
	Предупреждения = ДиагностикаСсылки(Результат, Фикстура.Поручение, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": одно предупреждение (" + СтрСоединить(Предупреждения, " | ") + ")").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0], Описание + ": названа сторона").Содержит(Сторона);
	ЮТест.ОжидаетЧто(Предупреждения[0], Описание + ": суть - код не заполнен").Содержит("не заполнен");

