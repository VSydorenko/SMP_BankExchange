Процедура Отбор_ОдноПлохоеСредиХорошихНеТеряетХорошие() Экспорт

	// Review Focus 4: одно плохое среди добрых. Хорошие остаются, каждое пропущенное названо с причиной, "N из M" считается.
	Фикстура = СценарийФикстуры("ЮрЮр");
	Хорошее2 = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,Номер,Сумма",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 7, 9, 0, 0), "00000124", 50));
	Помеченное = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,ПометкаУдаления",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 8, 9, 0, 0), Истина));
	ДругойПериод = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 5, 1, 9, 0, 0)));
	Ссылки = МассивИз(Фикстура.Поручение, Помеченное, Хорошее2, ДругойПериод);

	Результат = ПродуктФункция("ПреобразоватьДокументыВПоручения", Ссылки, Фикстура.СчетПлательщика, Фикстура.Начало, Фикстура.Конец);

	ЮТест.ОжидаетЧто(Результат.Строки.Количество(), "M = 4: строка на каждую ссылку").Равно(4);
	Принятые = Новый Массив;
	Для Каждого Строка Из Результат.Строки Цикл
		Если ТипЗнч(Строка.Поручение) = Тип("Структура") Тогда
			Принятые.Добавить(Строка.Поручение.Номер);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Принятые, ","), "N = 2: приняты первое и третье, номера без ведущих нулей").Равно("123,124");
	ПроверитьПропущено(Результат, Помеченное, "помечен на удаление", "Помеченное среди добрых");
	ПроверитьПропущено(Результат, ДругойПериод, "вне периода выгрузки", "Другой период среди добрых");
	ЮТест.ОжидаетЧто(ДиагностикаСсылки(Результат, Фикстура.Поручение, "Ошибка").Количество(), "У доброго поручения нет ошибок").Равно(0);
	ЮТест.ОжидаетЧто(ДиагностикаСсылки(Результат, Хорошее2, "Ошибка").Количество(), "У второго доброго нет ошибок").Равно(0);

