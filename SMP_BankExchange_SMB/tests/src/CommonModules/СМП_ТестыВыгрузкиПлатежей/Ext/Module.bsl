// Момент - требование точки (формат Сенса на пустой дате падает текстом без слова "Момент").
Процедура Пакет_МоментОбязателенИНазванВОшибке(Описание, Идентификатор, Вариант) Экспорт

	Фикстура = ЧистаяФикстура();
	Параметры = ПараметрыВывода(Фикстура, Идентификатор);
	Если Вариант = "НетПоля" Тогда
		Параметры.Удалить("Момент");
	ИначеЕсли Вариант = "НеДата" Тогда
		Параметры.Момент = "2026-03-31";
	Иначе
		Параметры.Момент = Дата(1, 1, 1);
	КонецЕсли;

	Текст = ТекстИсключенияВывода(МассивИз(Фикстура.Поручение), Параметры);

	ЮТест.ОжидаетЧто(Текст <> Неопределено, Описание + ": исключение было").ЭтоИстина();
	ЮТест.ОжидаетЧто(Текст, Описание + ": текст называет Момент").Содержит("Момент");

КонецПроцедуры

