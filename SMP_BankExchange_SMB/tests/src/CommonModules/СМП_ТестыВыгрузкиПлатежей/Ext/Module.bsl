Процедура Особые_НепрямыеРасчетыБерутБанкРасчетов(Описание, Сторона) Экспорт

	// Решение координатора 1: как в вендорском экспорте, банк, МФО и город - из банка расчетов счета.
	Фикстура = СценарийФикстуры("ЮрЮр");
	БанкРасчетов = СМП_ТестыДанныеУНФ.НовыйБанк(Новый Структура("Код,Город", "300001", "Одеса"));
	Счет = ?(Сторона = "Плательщик", Фикстура.СчетПлательщика, Фикстура.СчетПолучателя);
	Объект = Счет.ПолучитьОбъект();
	Объект.БанкРасчетов = БанкРасчетов;
	Объект.Записать();

	Результат = Преобразовать(Фикстура);
	Поручение = ПоручениеИзРезультата(Результат, Фикстура.Поручение, Описание);

	ЮТест.ОжидаетЧто(Поручение[Сторона].Банк, Описание + ": банк - банк расчетов")
		.Равно(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанкРасчетов, "Наименование"));
	ЮТест.ОжидаетЧто(Поручение[Сторона].МФО, Описание + ": МФО банка расчетов").Равно("300001");
	ЮТест.ОжидаетЧто(Поручение[Сторона].Город, Описание + ": город банка расчетов").Равно("Одеса");
	// Пара: другая сторона не затронута.
	Другая = ?(Сторона = "Плательщик", "Получатель", "Плательщик");
	ЮТест.ОжидаетЧто(Поручение[Другая].МФО <> "300001", Описание + ": у другой стороны свой банк").ЭтоИстина();

КонецПроцедуры

Процедура Особые_НеНациональнаяВалютаПропускается(Описание, Где, Фрагмент, ЧужойФрагмент) Экспорт

	// Решение координатора 2: документ или счет не в национальной валюте - пропущено с причиной (форматы только гривневые).
	Фикстура = СценарийФикстуры("ЮрЮр");
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.Валюты КАК Т ГДЕ Т.Ссылка <> &Национальная И НЕ Т.ПометкаУдаления");
	Запрос.УстановитьПараметр("Национальная", Константы.НациональнаяВалюта.Получить());
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предпосылка: в базе есть иностранная валюта").ЭтоИстина();
	Валюта = Выборка.Ссылка;

	Если Где = "Документ" Тогда
		Объект = Фикстура.Поручение.ПолучитьОбъект();
		Объект.ВалютаДокумента = Валюта;
	Иначе
		Объект = Фикстура.СчетПлательщика.ПолучитьОбъект();
		Объект.ВалютаДенежныхСредств = Валюта;
	КонецЕсли;
	Объект.Записать();

	Результат = Преобразовать(Фикстура);

	ПроверитьПропущено(Результат, Фикстура.Поручение, "валюте, отличной от национальной", Описание);
	Тексты = СтрСоединить(ДиагностикаСсылки(Результат, Фикстура.Поручение, "Ошибка"), " | ");
	ЮТест.ОжидаетЧто(Тексты, Описание + ": названо, что именно не в гривне").Содержит(Фрагмент);
	ЮТест.ОжидаетЧто(СтрНайти(Тексты, ЧужойФрагмент), Описание + ": причина про другое (" + ЧужойФрагмент + ") не названа").Равно(0);

КонецПроцедуры

Процедура Особые_ТекстСтороныПриНепрямыхРасчетах(Описание, СторонаТекста, СторонаНепрямых, Текст, Ожидаемое) Экспорт

	// Вендорский экспорт (КлиентБанк): при непрямых расчетах стороны текст режется до первого "р/с" (поиск с учетом регистра)
	// и очищается от пробелов; без "р/с" и при прямых расчетах - как есть.
	Фикстура = СценарийФикстуры("ЮрЮр");
	Если СторонаНепрямых <> "" Тогда
		БанкРасчетов = СМП_ТестыДанныеУНФ.НовыйБанк(Новый Структура("Код,Город", "300001", "Одеса"));
		Счет = ?(СторонаНепрямых = "Плательщик", Фикстура.СчетПлательщика, Фикстура.СчетПолучателя);
		Объект = Счет.ПолучитьОбъект();
		Объект.БанкРасчетов = БанкРасчетов;
		Объект.Записать();
	КонецЕсли;
	СМП_ТестыДанныеУНФ.НастроитьПлатежноеПоручение(Фикстура.Поручение, Новый Структура(?(СторонаТекста = "Плательщик", "ТекстПлательщика", "ТекстПолучателя"), Текст));

	Результат = Преобразовать(Фикстура);
	Поручение = ПоручениеИзРезультата(Результат, Фикстура.Поручение, Описание);

	ЮТест.ОжидаетЧто(Поручение[СторонаТекста].Наименование, Описание).Равно(Ожидаемое);

КонецПроцедуры

Процедура Особые_ПеречислениеНалогаВыгружаетсяСПредупреждением() Экспорт

	// Решение координатора 3: вид операции "Перечисление налога" выгружается как обычное, с предупреждением.
	Фикстура = СценарийФикстуры("ЮрЮр");
	Налог = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,ВидОперации",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 9, 9, 0, 0),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПеречислениеНалога")));

	Результат = ПродуктФункция("ПреобразоватьДокументыВПоручения", МассивИз(Налог, Фикстура.Поручение),
		Фикстура.СчетПлательщика, Фикстура.Начало, Фикстура.Конец);

	ПоручениеИзРезультата(Результат, Налог, "Налоговый платеж выгружается как обычный");
	ЮТест.ОжидаетЧто(СтрСоединить(ДиагностикаСсылки(Результат, Налог, "Предупреждение"), " | "), "Предупреждение о реквизитах налога")
		.Содержит("реквизиты налога формат не передает");
	ЮТест.ОжидаетЧто(ДиагностикаСсылки(Результат, Фикстура.Поручение, "Предупреждение").Количество(), "Пара: обычный платеж без предупреждения").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Состав полей конструктора - предпосылка тестов, что его используют: без нее тест падает на этом утверждении.
Процедура ТребоватьСхему(Поручение)

	ЮТест.ОжидаетЧто(КлючиСтрокой(Поручение), "Предпосылка: конструктор вернул схему поручения")
		.Равно("Номер,Дата,Сумма,НазначениеПлатежа,Плательщик,Получатель");

КонецПроцедуры

// Поручение ссылки из результата: строка есть, поручение построено (иначе тест красный с перечнем причин).
Функция ПоручениеИзРезультата(Результат, Ссылка, Описание)

	Строка = СтрокаРезультата(Результат, Ссылка);
	ЮТест.ОжидаетЧто(Строка <> Неопределено, Описание + ": для ссылки есть строка результата").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Строка.Поручение), Описание + ": поручение построено (причины: " + ПричиныСтрокой(Результат, Ссылка) + ")")
		.Равно(Тип("Структура"));
	Возврат Строка.Поручение;

КонецФункции

// Вызов функции продукта через помощник позднего связывания.
Функция ПродуктФункция(Имя, Аргумент1 = Неопределено, Аргумент2 = Неопределено, Аргумент3 = Неопределено, Аргумент4 = Неопределено)

	Аргументы = Новый Массив;
	Если Аргумент1 <> Неопределено Или Имя = "ПроверитьПоручение" Тогда
		Аргументы.Добавить(Аргумент1);
	КонецЕсли;
	Если Аргумент2 <> Неопределено Тогда
		Аргументы.Добавить(Аргумент2);
		Аргументы.Добавить(Аргумент3);
		Аргументы.Добавить(Аргумент4);
	КонецЕсли;

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ВыгрузкаПлатежей." + Имя, Аргументы);

КонецФункции

Функция МассивИз(Знач1, Знач2 = Неопределено, Знач3 = Неопределено, Знач4 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Знач1);
	Если Знач2 <> Неопределено Тогда
		Массив.Добавить(Знач2);
	КонецЕсли;
	Если Знач3 <> Неопределено Тогда
		Массив.Добавить(Знач3);
	КонецЕсли;
	Если Знач4 <> Неопределено Тогда
		Массив.Добавить(Знач4);
	КонецЕсли;
	Возврат Массив;

КонецФункции

Функция КлючиСтрокой(Структура)

	Ключи = Новый Массив;
	Для Каждого Элемент Из Структура Цикл
		Ключи.Добавить(Элемент.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ",");

КонецФункции

Функция КолонкиСтрокой(Таблица)

	Имена = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

// Поручение, заполненное правильными значениями по схеме (без обращения к конструктору продукта).
Функция ЗаполненноеПоручение()

	Плательщик = Новый Структура("Наименование,Код,ВидКода,НомерСчета,IBAN,Банк,МФО,Город",
		"ТОВ Платник", "01234567", "ЕДРПОУ", "UA213223130000026007233566001", "UA213223130000026007233566001", "Банк Платника", "322313", "Київ");
	Получатель = Новый Структура("Наименование,Код,ВидКода,НомерСчета,IBAN,Банк,МФО,Город",
		"ТОВ Одержувач", "12345678", "ЕДРПОУ", "UA903052992990004149123456789", "UA903052992990004149123456789", "Банк Одержувача", "305299", "Львів");

	Поручение = Новый Структура;
	Поручение.Вставить("Номер", "123");
	Поручение.Вставить("Дата", Дата(2026, 3, 5, 14, 30, 0));
	Поручение.Вставить("Сумма", 1234.5);
	Поручение.Вставить("НазначениеПлатежа", "Оплата за товар");
	Поручение.Вставить("Плательщик", Плательщик);
	Поручение.Вставить("Получатель", Получатель);
	Возврат Поручение;

КонецФункции

// Меняет поле по пути "Сторона.Поле" или "Поле": Задать, Удалить.
Процедура ИзменитьПоПути(Поручение, Операция, Путь, Значение = Неопределено)

	Части = СтрРазделить(Путь, ".");
	Объект = Поручение;
	Для Индекс = 0 По Части.ВГраница() - 1 Цикл
		Объект = Объект[Части[Индекс]];
	КонецЦикла;
	Имя = Части[Части.ВГраница()];
	Если Операция = "Удалить" Тогда
		Объект.Удалить(Имя);
	Иначе
		Объект.Вставить(Имя, Значение);
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеПоПути(Поручение, Путь)

	Значение = Поручение;
	Для Каждого Часть Из СтрРазделить(Путь, ".") Цикл
		Значение = Значение[Часть];
	КонецЦикла;
	Возврат Значение;

КонецФункции

// Ожидаемое значение: "@Объект.Реквизит" - реквизит объекта фикстуры, иначе литерал.
Функция РазобратьОжидаемое(Ожидаемое, Фикстура)

	Если ТипЗнч(Ожидаемое) <> Тип("Строка") Или Не СтрНачинаетсяС(Ожидаемое, "@") Тогда
		Возврат Ожидаемое;
	КонецЕсли;

	Части = СтрРазделить(Сред(Ожидаемое, 2), ".");
	Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Фикстура[Части[0]], Части[1]));

КонецФункции

Процедура СобратьНеПлатформенные(Значение, Путь, Нарушения)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого Элемент Из Значение Цикл
			СобратьНеПлатформенные(Элемент.Значение, ?(Путь = "", "", Путь + ".") + Элемент.Ключ, Нарушения);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") И ТипЗнч(Значение) <> Тип("Число") И ТипЗнч(Значение) <> Тип("Дата")
		И ТипЗнч(Значение) <> Тип("Булево") Тогда
		Нарушения.Добавить(Путь + " (" + Строка(ТипЗнч(Значение)) + ")");
	КонецЕсли;

КонецПроцедуры

Функция Преобразовать(Фикстура)

	Возврат ПродуктФункция("ПреобразоватьДокументыВПоручения", МассивИз(Фикстура.Поручение), Фикстура.СчетПлательщика, Фикстура.Начало, Фикстура.Конец);

КонецФункции

Функция СтрокаРезультата(Результат, Ссылка)

	Для Каждого Строка Из Результат.Строки Цикл
		Если Строка.Ссылка = Ссылка Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Тексты диагностики ссылки заданного уровня.
Функция ДиагностикаСсылки(Результат, Ссылка, Уровень)

	Тексты = Новый Массив;
	Для Каждого Строка Из Результат.Диагностика Цикл
		Если Строка.Ссылка = Ссылка И Строка.Уровень = Уровень Тогда
			Тексты.Добавить(Строка.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ПричиныСтрокой(Результат, Ссылка)

	Возврат СтрСоединить(ДиагностикаСсылки(Результат, Ссылка, "Ошибка"), " | ");

КонецФункции

// Ссылка пропущена: строка результата есть, поручения нет, в диагностике ошибка с названной причиной.
Процедура ПроверитьПропущено(Результат, Ссылка, Фрагмент, Описание)

	Строка = СтрокаРезультата(Результат, Ссылка);
	ЮТест.ОжидаетЧто(Строка <> Неопределено, Описание + ": для ссылки есть строка результата (D3: мовчки не пропускается)").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Строка.Поручение) <> Тип("Структура"), Описание + ": поручения нет").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(ДиагностикаСсылки(Результат, Ссылка, "Ошибка"), " | "), Описание + ": причина названа").Содержит(Фрагмент);

КонецПроцедуры

// Фикстура сценария: организация, счет и банки, контрагент, счет контрагента, поручение. Сценарии:
//  ЮрЮр - юрлица, IBAN, тексты сторон заданы; ФопФоп - ФОП (организация) и ФОП-контрагент с ЕДРПОУ-обманкой в карточке;
//  Физлицо - контрагент-физлицо; ФопБезИНН - ФОП с ЕДРПОУ, без ИНН; ЮрБезКода - юрлицо без ЕДРПОУ;
//  СтарыйСчетБезБанка - счет получателя со старым номером и без банка; БезТекстов - ТекстПлательщика/Получателя пусты.
Функция СценарийФикстуры(ИмяСценария, НомерДокумента = "00000123", СуммаДокумента = 1234.5)

	ВидЮр = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЮридическоеЛицо");
	ВидФоп = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель");
	ВидФиз = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ФизическоеЛицо");
	ОргЮр = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо");
	ОргФиз = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо");

	// Параметры сценария. Обманка: код "не того" вида, который продукт не должен брать.
	ОргВид = ОргЮр;
	ОргЕДРПОУ = "01234567";
	ОргИНН = "9999999999";
	КонтрВид = ВидЮр;
	КонтрЕДРПОУ = "12345678";
	КонтрИНН = "1111111111";
	ЕстьТексты = Истина;
	СчетПолучателяСтарый = Ложь;
	БезБанкаПолучателя = Ложь;
	Если ИмяСценария = "ФопФоп" Тогда
		ОргВид = ОргФиз;
		ОргЕДРПОУ = "88888888";
		ОргИНН = "0123456789";
		КонтрВид = ВидФоп;
		КонтрЕДРПОУ = "77777777";
		КонтрИНН = "0012345678";
	ИначеЕсли ИмяСценария = "Физлицо" Тогда
		КонтрВид = ВидФиз;
		КонтрЕДРПОУ = "";
		КонтрИНН = "2345678901";
	ИначеЕсли ИмяСценария = "ФопБезИНН" Тогда
		КонтрВид = ВидФоп;
		КонтрЕДРПОУ = "77777777";
		КонтрИНН = "";
	ИначеЕсли ИмяСценария = "ЮрБезКода" Тогда
		КонтрЕДРПОУ = "";
	ИначеЕсли ИмяСценария = "СтарыйСчетБезБанка" Тогда
		СчетПолучателяСтарый = Истина;
		БезБанкаПолучателя = Истина;
	ИначеЕсли ИмяСценария = "БезТекстов" Тогда
		ЕстьТексты = Ложь;
	КонецЕсли;

	Фикстура = Новый Структура;
	Фикстура.Вставить("Начало", Дата(2026, 3, 1));
	Фикстура.Вставить("Конец", Дата(2026, 3, 31));

	Организация = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	СМП_ТестыДанныеУНФ.НастроитьОрганизациюФикстуры(Организация, Новый Структура(
		"НаименованиеПолное,КодПоЕДРПОУ,ИНН,ЮридическоеФизическоеЛицо", "ТОВ Повна назва організації", ОргЕДРПОУ, ОргИНН, ОргВид));
	БанкПлательщика = СМП_ТестыДанныеУНФ.НовыйБанк(Новый Структура("Код,Город", "012345", "Київ"));
	СчетПлательщика = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация, Новый Структура("Банк", БанкПлательщика));

	Признаки = Новый Структура("ВестиРасчетыПоДоговорам,ВестиРасчетыПоДокументам,ВестиРасчетыПоЗаказам,ВестиУчетОплатыПоСчетам,ВидКонтрагента,КодПоЕДРПОУ,ИНН",
		Истина, Истина, Истина, Ложь, КонтрВид, КонтрЕДРПОУ, КонтрИНН);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);

	БанкПолучателя = СМП_ТестыДанныеУНФ.НовыйБанк(Новый Структура("Код,Город", "305299", "Львів"));
	НастройкиСчета = Новый Структура("Банк", БанкПолучателя);
	Если БезБанкаПолучателя Тогда
		НастройкиСчета.Вставить("Банк", Справочники.Банки.ПустаяСсылка());
	КонецЕсли;
	Если СчетПолучателяСтарый Тогда
		НастройкиСчета.Вставить("НомерСчета", "00026007233566");
	КонецЕсли;
	СчетПолучателя = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Контрагент, НастройкиСчета);

	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,Номер,Сумма",
		Организация, СчетПлательщика, Контрагент, Дата(2026, 3, 5, 14, 30, 0), НомерДокумента, СуммаДокумента));
	Реквизиты = Новый Структура("НазначениеПлатежа,СчетКонтрагента", "  Оплата за товар №1 ", СчетПолучателя);
	Если ЕстьТексты Тогда
		Реквизиты.Вставить("ТекстПлательщика", "ТОВ Платник (текст документа)");
		Реквизиты.Вставить("ТекстПолучателя", "ТОВ Одержувач (текст документа)");
	КонецЕсли;
	СМП_ТестыДанныеУНФ.НастроитьПлатежноеПоручение(Поручение, Реквизиты);

