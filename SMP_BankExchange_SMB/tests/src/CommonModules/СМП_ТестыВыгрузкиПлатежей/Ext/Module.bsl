	Ожидаемое = ФайлМодуляФормата(Идентификатор, Фикстура, МассивИз(Фикстура.Поручение));
	ЮТест.ОжидаетЧто(БайтыРавны(Пакет.ДвоичныеДанные, Ожидаемое.Данные), Описание + ": в файле только хорошее поручение").ЭтоИстина();

КонецПроцедуры

// Review Focus 4: одно плохое среди добрых; не тот счет, не та организация, помеченное, другой период, нулевая сумма,
// повтор. Файл содержит остальное, диагностика называет каждое пропущенное, "N из M" верно.
Процедура Пакет_ОдноПлохоеСредиХорошихНеТеряетХорошие(Описание, Идентификатор) Экспорт

	Фикстура = ЧистаяФикстура();
	ДругойСчет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Фикстура.Организация);
	ДругаяОрганизация = СМП_ТестыДанныеУНФ.НоваяОрганизация();

	ДокДругойСчет = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата",
		Фикстура.Организация, ДругойСчет, Фикстура.Контрагент, Дата(2026, 3, 6, 10, 0, 0)));
	ДокДругаяОрганизация = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата",
		ДругаяОрганизация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 6, 10, 0, 0)));
	Помеченный = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,ПометкаУдаления",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 8, 9, 0, 0), Истина));
	ДругойПериод = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 5, 1, 9, 0, 0)));
	Нулевое = НовоеХорошее(Фикстура, "00000130", 9, 0);
	Хорошее2 = НовоеХорошее(Фикстура, "00000131", 10, 50, Повтор("Оплата ", 30));

	Ссылки = Новый Массив;
	Ссылки.Добавить(Фикстура.Поручение);
	Ссылки.Добавить(ДокДругойСчет);
	Ссылки.Добавить(ДокДругаяОрганизация);
	Ссылки.Добавить(Помеченный);
	Ссылки.Добавить(ДругойПериод);
	Ссылки.Добавить(Нулевое);
	Ссылки.Добавить(Хорошее2);
	Ссылки.Добавить(Фикстура.Поручение);

	Пакет = ВывестиПакет(Фикстура, Ссылки, Идентификатор);

	ЮТест.ОжидаетЧто(Пакет.Всего, Описание + ": M - ссылок в списке").Равно(8);
	ЮТест.ОжидаетЧто(Пакет.Выгружено, Описание + ": N - в файле").Равно(2);
	ЮТест.ОжидаетЧто(Пакет.СПредупреждениями, Описание + ": из них с предупреждением").Равно(1);
	ЮТест.ОжидаетЧто(Пакет.Пропущено, Описание + ": пропущено").Равно(6);
	ЮТест.ОжидаетЧто(Пакет.Сводка, Описание + ": сводка называет N и M").Содержит("2");
	ЮТест.ОжидаетЧто(Пакет.Сводка, Описание + ": сводка называет M").Содержит("8");

	// Молча не пропускается ничего: у каждой позиции есть строка диагностики; пропущенные названы с причиной.
	Для Позиция = 1 По 8 Цикл
		ЮТест.ОжидаетЧто(КоличествоСтрокПозиции(Пакет, Позиция) > 0, Описание + ": позиция " + Позиция + " имеет диагностику").ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтатусПозиции(Пакет, 1), Описание + ": 1 выгружено").Равно("Выгружено");
	ЮТест.ОжидаетЧто(СтатусПозиции(Пакет, 7), Описание + ": 7 выгружено с предупреждением").Равно("ВыгруженоСПредупреждением");
	Пропущенные = Новый Структура("П2,П3,П4,П5,П6,П8", "банковский счет документа", "организация документа", "помечен на удаление",
		"вне периода выгрузки", "Сумма", "указан повторно");
	Для Каждого Элемент Из Пропущенные Цикл
		Позиция = Число(Сред(Элемент.Ключ, 2));
		ЮТест.ОжидаетЧто(СтатусПозиции(Пакет, Позиция), Описание + ": позиция " + Позиция + " пропущена").Равно("Пропущено");
		ЮТест.ОжидаетЧто(ТекстПозиции(Пакет, Позиция), Описание + ": позиция " + Позиция + " - причина").Содержит(Элемент.Значение);
	КонецЦикла;

	Ожидаемое = ФайлМодуляФормата(Идентификатор, Фикстура, МассивИз(Фикстура.Поручение, Хорошее2));
	ЮТест.ОжидаетЧто(БайтыРавны(Пакет.ДвоичныеДанные, Ожидаемое.Данные), Описание + ": файл содержит остальное (два хороших)").ЭтоИстина();

КонецПроцедуры

// Нечего выводить (пустой список или все пропущены) - пакет без файла (решение планировщика 5), но с диагностикой.
Процедура Пакет_НечегоВыгружатьДаетПакетБезФайла(Описание, Вариант) Экспорт

	Фикстура = ЧистаяФикстура();
	Ссылки = Новый Массив;
	Если Вариант = "ВсеПропущены" Тогда
		Ссылки.Добавить(СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,ПометкаУдаления",
			Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 8, 9, 0, 0), Истина)));
		Ссылки.Добавить(НовоеХорошее(Фикстура, "00000125", 8, 0));
	КонецЕсли;

	Пакет = ВывестиПакет(Фикстура, Ссылки, "Акорд_TXT");

	ЮТест.ОжидаетЧто(ТипЗнч(Пакет.ДвоичныеДанные) = Тип("Неопределено"), Описание + ": файла нет (не пустой файл)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Пакет.Отказ, Описание + ": это не отказ вывода, а пустой результат").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Пакет.Всего, Описание + ": M").Равно(Ссылки.Количество());
	ЮТест.ОжидаетЧто(Пакет.Выгружено, Описание + ": N").Равно(0);
	ЮТест.ОжидаетЧто(Пакет.Пропущено, Описание + ": пропущено").Равно(Ссылки.Количество());
	ЮТест.ОжидаетЧто(ПустаяСтрока(Пакет.Сводка), Описание + ": сводка для человека есть").ЭтоЛожь();
	Для Позиция = 1 По Ссылки.Количество() Цикл
		ЮТест.ОжидаетЧто(СтатусПозиции(Пакет, Позиция), Описание + ": позиция " + Позиция + " пропущена с причиной").Равно("Пропущено");
	КонецЦикла;

КонецПроцедуры

Процедура Пакет_ПовторнаяСсылкаВторойРазПропускается() Экспорт

	Фикстура = ЧистаяФикстура();
