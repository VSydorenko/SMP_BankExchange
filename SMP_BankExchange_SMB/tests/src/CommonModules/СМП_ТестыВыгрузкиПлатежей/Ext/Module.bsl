				.СПараметрами("прямые расчеты плательщика: текст полный", "Плательщик", "", "ТОВ Платник р/с 26000123456 в Банк", "ТОВ Платник р/с 26000123456 в Банк")
				.СПараметрами("прямые расчеты получателя: текст полный", "Получатель", "", "ТОВ Одержувач р/с 26000123456 в Банк", "ТОВ Одержувач р/с 26000123456 в Банк")
				.СПараметрами("непрямые у другой стороны не режут этот текст", "Плательщик", "Получатель", "ТОВ Платник р/с 26000123456 в Банк", "ТОВ Платник р/с 26000123456 в Банк")
