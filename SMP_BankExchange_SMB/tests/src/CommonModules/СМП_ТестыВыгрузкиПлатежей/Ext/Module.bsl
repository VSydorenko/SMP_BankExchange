// "Оплачено" - реквизит документа ПлатежноеПоручение (вендор ставит его при проведении РасходСоСчета).
Процедура Кандидаты_ПризнакОплачено() Экспорт

	Фикстура = ЧистаяФикстура();
	Оплаченное = НовоеХорошее(Фикстура, "00000124", 12, 100, "Оплата за товар", Истина);

	Кандидаты = Кандидаты(Фикстура);

	ЮТест.ОжидаетЧто(Кандидаты.Количество(), "Два кандидата").Равно(2);
	ЮТест.ОжидаетЧто(СтрокаКандидата(Кандидаты, Фикстура.Поручение).Оплачено, "Неоплаченное").Равно(Ложь);
	ЮТест.ОжидаетЧто(СтрокаКандидата(Кандидаты, Оплаченное).Оплачено, "Оплаченное").Равно(Истина);

КонецПроцедуры

Процедура Кандидаты_ПризнакОшибокПроверки() Экспорт

	Фикстура = ЧистаяФикстура();
	Нулевое = НовоеХорошее(Фикстура, "00000125", 8, 0);
	БезНазначения = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,Номер,Сумма",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, 9, 9, 0, 0), "00000126", 10));

	Кандидаты = Кандидаты(Фикстура);

	Хорошее = СтрокаКандидата(Кандидаты, Фикстура.Поручение);
	ЮТест.ОжидаетЧто(Хорошее.ЕстьОшибки, "Хорошее поручение без ошибок").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Хорошее.Ошибки.Количество(), "Список ошибок хорошего пуст").Равно(0);
	Плохое = СтрокаКандидата(Кандидаты, Нулевое);
	ЮТест.ОжидаетЧто(Плохое.ЕстьОшибки, "Нулевая сумма - ошибка проверки").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Плохое.Ошибки, " | "), "Ошибка называет сумму").Содержит("Сумма");
	Пустое = СтрокаКандидата(Кандидаты, БезНазначения);
	ЮТест.ОжидаетЧто(Пустое.ЕстьОшибки, "Пустое назначение - ошибка проверки").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Пустое.Ошибки, " | "), "Ошибка называет назначение").Содержит("НазначениеПлатежа");

КонецПроцедуры

Процедура Кандидаты_ПустыеГраницыПериодаНеОграничивают() Экспорт

	Фикстура = ЧистаяФикстура();
	Давний = НовоеХорошее(Фикстура, "00000124", 1);
	СМП_ТестыДанныеУНФ.НастроитьПлатежноеПоручение(Давний, Новый Структура("НазначениеПлатежа", "Оплата за товар"));
	Другой = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2027, 1, 15, 9, 0, 0)));

	Кандидаты = ТочкаВывода("КандидатыВыгрузки", МассивИз(Фикстура.СчетПлательщика, Дата(1, 1, 1), Дата(1, 1, 1)));

	Ссылки = Новый Массив;
	Для Каждого Строка Из Кандидаты Цикл
		Ссылки.Добавить(Строка.Ссылка);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Ссылки.Найти(Другой) <> Неопределено, "Документ вне любого месяца попадает при пустых границах").ЭтоИстина();
	ЮТест.ОжидаетЧто(Ссылки.Найти(Давний) <> Неопределено, "И документ внутри марта").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ТочкаВыводаИстория

// Запись истории (решение планировщика 17): ИсходныйФайл - ДвоичныеДанные пакета как есть для КАЖДОГО формата;
// ИмяФайла - имя пакета; КодировкаТекста - из пакета (пусто для двоичного формата); ресурс Кодировка не заполняется.

Процедура История_РовноОднаЗаписьСТипамиЗначений(Описание, Идентификатор, КодировкаТекста) Экспорт

	Фикстура = ЧистаяФикстура();
	Пакет = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение), Идентификатор);
	ЮТест.ОжидаетЧто(ТипЗнч(Пакет.ДвоичныеДанные) = Тип("ДвоичныеДанные"), Описание + ": предпосылка - у пакета есть файл").ЭтоИстина();

	ЗаписатьИсторию(Пакет);

	Записи = ЗаписиИстории(Фикстура.Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), Описание + ": ровно одна запись").Равно(1);
	Запись = Записи[0];
	ЮТест.ОжидаетЧто(Запись.Период, Описание + ": период - момент пакета").Равно(МоментВывода());
	ЮТест.ОжидаетЧто(Запись.БанковскийСчет, Описание + ": счет").Равно(Фикстура.СчетПлательщика);
	ЮТест.ОжидаетЧто(Запись.Загрузка, Описание + ": это вывод, не загрузка").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Запись.КоличествоДокументовВВыписке, Описание + ": число документов = N").Равно(Пакет.Выгружено);
	ЮТест.ОжидаетЧто(ТипЗнч(Запись.ИсходныйФайл.Получить()), Описание + ": ИсходныйФайл - двоичные данные").Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(Запись.ИмяФайла, Описание + ": имя файла = имя пакета").Равно(Пакет.ПредлагаемоеИмя);
	ЮТест.ОжидаетЧто(Запись.КодировкаТекста, Описание + ": кодировка текста файла").Равно(КодировкаТекста);
	ЮТест.ОжидаетЧто(Запись.Кодировка, Описание + ": ресурс Кодировка новые записи не заполняют").Равно("");
	ЮТест.ОжидаетЧто(ТипЗнч(Запись.ПротоколЗагрузки.Получить()), Описание + ": ПротоколЗагрузки - табличный документ").Равно(Тип("ТабличныйДокумент"));

КонецПроцедуры

Процедура История_БайтыИсходногоФайлаРавныБайтамПакета(Описание, Идентификатор) Экспорт

	Фикстура = ЧистаяФикстура();
	Пакет = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение), Идентификатор);
	ЗаписатьИсторию(Пакет);

	Записи = ЗаписиИстории(Фикстура.Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), Описание + ": предпосылка - запись есть").Равно(1);
	Прочитанное = Записи[0].ИсходныйФайл.Получить();
	ЮТест.ОжидаетЧто(БайтыРавны(Прочитанное, Пакет.ДвоичныеДанные), Описание + ": байты записи = байты пакета").ЭтоИстина();

КонецПроцедуры

// Вход, который ломает текст: NUL (повсюду в DBF) и число записей 10 / 13 (байт 4 заголовка = LF / CR). Запись-строка,
// декодированная кодировкой пакета, такой файл не восстановит. Предпосылки проверяют, что эти байты в файле есть.
Процедура История_DBF_ЗаголовокСLFCRИNUL_БайтыВосстановлены(Описание, ЧислоЗаписей) Экспорт

	Организация = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	Формат = "СМП_ФорматВыгрузкиСенсБанк_DBF";
	Поручения = Новый Массив;
	Для Индекс = 1 По ЧислоЗаписей Цикл
		Поручения.Добавить(ЗаполненноеПоручение());
	КонецЦикла;
	Параметры = СМП_ТестыВызовПродукта.Вызвать(Формат + ".НовыеПараметры");
	Параметры.Вставить("Момент", МоментВывода());
	Файл = СМП_ТестыВызовПродукта.Вызвать(Формат + ".Сформировать", МассивИз(Поручения, Параметры));

	Исходные = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Файл.Данные);
	ЮТест.ОжидаетЧто(Исходные[4], Описание + ": предпосылка - байт 4 заголовка (число записей)").Равно(ЧислоЗаписей);
	ЮТест.ОжидаетЧто(Исходные[4] = 10 Или Исходные[4] = 13, Описание + ": предпосылка - в заголовке есть LF или CR").ЭтоИстина();
	ЮТест.ОжидаетЧто(КоличествоБайтов(Исходные, 0) > 0, Описание + ": предпосылка - в файле есть NUL").ЭтоИстина();

	Пакет = ТочкаВывода("НовыйПакетВыгрузки");
	Пакет.Вставить("ИдентификаторСтроки", "СенсБанк_DBF");
	Пакет.Вставить("БанковскийСчет", Счет);
	Пакет.Вставить("Организация", Организация);
	Пакет.Вставить("Момент", МоментВывода());
	Пакет.Вставить("ДвоичныеДанные", Файл.Данные);
	Пакет.Вставить("Кодировка", "windows-1251");
	Пакет.Вставить("КодировкаТекста", "");
	Пакет.Вставить("ПредлагаемоеИмя", "Sens_20260331_164530.dbf");
	Пакет.Вставить("Выгружено", ЧислоЗаписей);
	Пакет.Вставить("Всего", ЧислоЗаписей);
	ЗаписатьИсторию(Пакет);

	Записи = ЗаписиИстории(Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), Описание + ": запись истории есть").Равно(1);
	Прочитанное = Записи[0].ИсходныйФайл.Получить();
	ЮТест.ОжидаетЧто(ТипЗнч(Прочитанное), Описание + ": тип ИсходныйФайл").Равно(Тип("ДвоичныеДанные"));
	Расхождение = ПервоеРасхождение(Исходные, ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Прочитанное));
	ЮТест.ОжидаетЧто(Расхождение, Описание + ": кругооборот через регистр, размер " + Исходные.Размер).Равно("байты восстановлены");

КонецПроцедуры

// Запись-строка, сделанная так, как пишет стара форма (ИсходныйФайл - ХранилищеЗначения со строкой, Кодировка "Windows"),
// читается тем же типом после изменения метаданных; новые ресурсы у нее пусты. Не зависит от кода точки (метаданные).
Процедура История_СтараяЗаписьСтрокойЧитаетсяТойЖеСтрокой() Экспорт

	Организация = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	Менеджер = Вычислить("РегистрыСведений.ИсторияРаботыСКлиентомБанка.СоздатьМенеджерЗаписи()");
	Менеджер.Период = МоментВывода();
	Менеджер.Организация = Организация;
	Менеджер.БанковскийСчет = Счет;
	Менеджер.Загрузка = Ложь;
	Менеджер.КоличествоДокументовВВыписке = 1;
	Менеджер.Кодировка = "Windows";
	Менеджер.ИсходныйФайл = Новый ХранилищеЗначения("Content-Type=doc/ua_payment", Новый СжатиеДанных(5));
	Менеджер.ПротоколЗагрузки = Новый ХранилищеЗначения(Новый ТабличныйДокумент, Новый СжатиеДанных(5));
	Менеджер.Записать();

	Записи = ЗаписиИстории(Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), "Старая запись записана").Равно(1);
	ЮТест.ОжидаетЧто(ТипЗнч(Записи[0].ИсходныйФайл.Получить()), "ИсходныйФайл старой записи читается строкой").Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(Записи[0].ИсходныйФайл.Получить(), "Текст старой записи").Равно("Content-Type=doc/ua_payment");
	ЮТест.ОжидаетЧто(Записи[0].Кодировка, "Ресурс Кодировка старой записи").Равно("Windows");
	ЮТест.ОжидаетЧто(Записи[0].ИмяФайла, "Новый ресурс у старой записи пуст").Равно("");
	ЮТест.ОжидаетЧто(Записи[0].КодировкаТекста, "Новый ресурс кодировки у старой записи пуст").Равно("");

КонецПроцедуры

Процедура История_ЧитаетсяМенеджеромЗаписи() Экспорт

	Фикстура = ЧистаяФикстура();
	Пакет = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение), "Акорд_TXT");
	ЗаписатьИсторию(Пакет);

	МенеджерЗаписи = Вычислить("РегистрыСведений.ИсторияРаботыСКлиентомБанка.СоздатьМенеджерЗаписи()");
	МенеджерЗаписи.Период = Пакет.Момент;
	МенеджерЗаписи.Организация = Фикстура.Организация;
	МенеджерЗаписи.БанковскийСчет = Фикстура.СчетПлательщика;
	МенеджерЗаписи.Прочитать();

	ЮТест.ОжидаетЧто(МенеджерЗаписи.Выбран(), "Запись находится по ключу (период, организация, счет), как в формах").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(МенеджерЗаписи.ИсходныйФайл.Получить()), "ИсходныйФайл - двоичные данные").Равно(Тип("ДвоичныеДанные"));
	ЮТест.ОжидаетЧто(ТипЗнч(МенеджерЗаписи.ПротоколЗагрузки.Получить()), "ФормаПротокола получает табличный документ").Равно(Тип("ТабличныйДокумент"));
	ЮТест.ОжидаетЧто(МенеджерЗаписи.ФайлОтформатирован, "Форматированный вид строит форма при первом открытии").ЭтоЛожь();

КонецПроцедуры

Процедура История_ПротоколСодержитДиагностикуПакета() Экспорт

	Фикстура = ЧистаяФикстура();
	Нулевое = НовоеХорошее(Фикстура, "00000125", 8, 0);
	Пакет = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение, Нулевое), "Акорд_TXT");
	ЗаписатьИсторию(Пакет);

	Записи = ЗаписиИстории(Фикстура.Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), "Предпосылка: запись есть").Равно(1);
	Текст = ТекстТабличногоДокумента(Записи[0].ПротоколЗагрузки.Получить());
	ЮТест.ОжидаетЧто(Текст, "Протокол называет статус выгруженного").Содержит("Выгружено");
	ЮТест.ОжидаетЧто(Текст, "Протокол называет статус пропущенного").Содержит("Пропущено");
	ЮТест.ОжидаетЧто(Текст, "Протокол несет причину пропуска из диагностики пакета").Содержит(ТекстПозиции(Пакет, 2));

КонецПроцедуры

Процедура История_ПакетБезФайлаОтклоняется() Экспорт

	Фикстура = ЧистаяФикстура();
	Пакет = ВывестиПакет(Фикстура, Новый Массив, "Акорд_TXT");
	ЮТест.ОжидаетЧто(ТипЗнч(Пакет.ДвоичныеДанные) = Тип("Неопределено"), "Предпосылка: пакет без файла").ЭтоИстина();

	Текст = Неопределено;
	Попытка
		ЗаписатьИсторию(Пакет);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	ЮТест.ОжидаетЧто(Текст <> Неопределено, "Запись истории пакета без файла - исключение").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписиИстории(Фикстура.Организация).Количество(), "Записи нет").Равно(0);

КонецПроцедуры

// ИЗМЕРЕНИЕ (планировщик, не лечится): два вывода по одному счету с одним моментом (секунда - период ключа).
// Утверждает измеренное: запись ЗАМЕЩАЕТСЯ (одна запись, файл второго пакета), без исключения.
Процедура История_ДваВыводаЗаОднуСекундуЗамещают_Измерение() Экспорт

	Фикстура = ЧистаяФикстура();
	Второе = НовоеХорошее(Фикстура, "00000124", 7, 250.75);
	Пакет1 = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение), "Акорд_TXT");
	Пакет2 = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение, Второе), "Акорд_TXT");
	ЮТест.ОжидаетЧто(БайтыРавны(Пакет1.ДвоичныеДанные, Пакет2.ДвоичныеДанные), "Предпосылка: пакеты различаются").ЭтоЛожь();

	ЗаписатьИсторию(Пакет1);
	ЗаписатьИсторию(Пакет2);

	Записи = ЗаписиИстории(Фикстура.Организация);
	ЮТест.ОжидаетЧто(Записи.Количество(), "Две записи с одним ключом: одна запись (заместилась)").Равно(1);
	ЮТест.ОжидаетЧто(БайтыРавны(Записи[0].ИсходныйФайл.Получить(), Пакет2.ДвоичныеДанные), "Осталась запись второго пакета").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ТочкаВыводаСторож

// Тот же подсчет для сторожа остатков и для сторожа, видящего историю: записи регистра истории организаций фикстуры.
Функция ЗаписейИсторииФикстуры()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ РегистрСведений.ИсторияРаботыСКлиентомБанка КАК Т
		|ГДЕ Т.Организация.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""");
	Запрос.УстановитьПараметр("Шаблон", "СМП\_ТЕСТ\_%");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

// Доказывает, что сторож видит запись истории, которую создает вывод (иначе нулевой итог ничего не доказывает).
Процедура СторожБачитИсторию() Экспорт

	Фикстура = ЧистаяФикстура();
	Пакет = ВывестиПакет(Фикстура, МассивИз(Фикстура.Поручение), "Акорд_TXT");
	До = ЗаписейИсторииФикстуры();
	ЗаписатьИсторию(Пакет);
	ЮТест.ОжидаетЧто(ЗаписейИсторииФикстуры() - До, "Сторож видит запись истории фикстуры").Равно(1);

КонецПроцедуры

// БЕЗ транзакции, ПОСЛЕДНИМ. Красный - СТОП: остатки руками не удалять, сообщить владельцу.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗаписейИсторииФикстуры(), "РегистрСведений.ИсторияРаботыСКлиентомБанка: записи фикстуры пережили откат теста").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ТочкаВыводаПомощники

Функция Повтор(Текст, Раз)

	Части = Новый Массив;
	Для Индекс = 1 По Раз Цикл
		Части.Добавить(Текст);
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции


Процедура ЗаписатьИсторию(Пакет)

	СМП_ТестыВызовПродукта.ВызватьПроцедуру("СМП_ВыгрузкаПлатежей.ЗаписатьИсториюВыгрузки", МассивИз(Пакет));

КонецПроцедуры

Функция ТекстТабличногоДокумента(Документ)

	Тексты = Новый Массив;
	Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По Документ.ШиринаТаблицы Цикл
			Текст = Документ.Область(НомерСтроки, НомерКолонки).Текст;
			Если Не ПустаяСтрока(Текст) Тогда
				Тексты.Добавить(Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

// Сколько байт буфера равно значению.
Функция КоличествоБайтов(Буфер, Значение)

	Количество = 0;
	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Если Буфер[Индекс] = Значение Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;

КонецФункции

// Первое расхождение двух буферов: строка без управляющих символов (смещение и значения байтов числами) или
// "байты восстановлены".
Функция ПервоеРасхождение(Первый, Второй)

	Предел = Мин(Первый.Размер, Второй.Размер);
	Для Индекс = 0 По Предел - 1 Цикл
		Если Первый[Индекс] <> Второй[Индекс] Тогда
			Возврат "первое расхождение на смещении " + Формат(Индекс, "ЧН=0; ЧГ=") + ": байт "
				+ Формат(Первый[Индекс], "ЧН=0; ЧГ=") + " -> " + Формат(Второй[Индекс], "ЧН=0; ЧГ=");
		КонецЕсли;
	КонецЦикла;
	Если Первый.Размер <> Второй.Размер Тогда
		Возврат "размеры различаются при равном начале (до смещения " + Формат(Предел, "ЧН=0; ЧГ=") + ")";
	КонецЕсли;
	Возврат "байты восстановлены";

КонецФункции

Функция МоментВывода()

	Возврат Дата(2026, 3, 31, 16, 45, 30);

КонецФункции

Функция ТочкаВывода(Имя, Аргументы = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ВыгрузкаПлатежей." + Имя, Аргументы);

КонецФункции

Функция СтрокаРеестраВывода(Идентификатор)

	Для Каждого Строка Из ТочкаВывода("РеестрВыгрузки") Цикл
		Если Строка.Идентификатор = Идентификатор Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Модуль формата строки реестра - ЛИТЕРАЛЬНАЯ таблица теста (не из реестра продукта): подмена модуля в реестре
// продукта должна давать красный.
Функция МодульФорматаСтроки(Идентификатор)

	Если Идентификатор = "СенсБанк_DBF" Тогда
		Возврат "СМП_ФорматВыгрузкиСенсБанк_DBF";
	КонецЕсли;
	Возврат "СМП_ФорматВыгрузкиiFOBS_TXT";

КонецФункции

Функция ОписаниеМодуляФормата(Идентификатор)

	Возврат СМП_ТестыВызовПродукта.Вызвать(МодульФорматаСтроки(Идентификатор) + ".ОписаниеФормата");

КонецФункции

Функция ИмяФайлаМодуляФормата(Идентификатор, Момент)

	Возврат СМП_ТестыВызовПродукта.Вызвать(МодульФорматаСтроки(Идентификатор) + ".ПредлагаемоеИмяФайла", МассивИз(Момент));

КонецФункции

// Файл модуля формата на тех же поручениях, которые принял бы пакет: преобразование + ПроверитьПоручение.
Функция ФайлМодуляФормата(Идентификатор, Фикстура, Ссылки)

	Результат = ПродуктФункция("ПреобразоватьДокументыВПоручения", Ссылки, Фикстура.СчетПлательщика, Фикстура.Начало, Фикстура.Конец);
	Поручения = Новый Массив;
	Для Каждого Строка Из Результат.Строки Цикл
		Если ТипЗнч(Строка.Поручение) = Тип("Структура") И ПродуктФункция("ПроверитьПоручение", Строка.Поручение).Количество() = 0 Тогда
			Поручения.Добавить(Строка.Поручение);
		КонецЕсли;
	КонецЦикла;
	Модуль = МодульФорматаСтроки(Идентификатор);
	Параметры = СМП_ТестыВызовПродукта.Вызвать(Модуль + ".НовыеПараметры");
	Параметры.Вставить("Момент", МоментВывода());
	Возврат СМП_ТестыВызовПродукта.Вызвать(Модуль + ".Сформировать", МассивИз(Поручения, Параметры));

КонецФункции

Функция БайтыРавны(Первые, Вторые)

	Если ТипЗнч(Первые) <> Тип("ДвоичныеДанные") Или ТипЗнч(Вторые) <> Тип("ДвоичныеДанные") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Base64Строка(Первые) = Base64Строка(Вторые);

КонецФункции

Функция ПараметрыВывода(Фикстура, Идентификатор)

	Параметры = ТочкаВывода("НовыеПараметрыВыгрузки");
	Параметры.Вставить("БанковскийСчет", Фикстура.СчетПлательщика);
	Параметры.Вставить("НачалоПериода", Фикстура.Начало);
	Параметры.Вставить("КонецПериода", Фикстура.Конец);
	Параметры.Вставить("ИдентификаторСтроки", Идентификатор);
	Параметры.Вставить("Момент", МоментВывода());
	Возврат Параметры;

КонецФункции

Функция ВывестиПакет(Фикстура, Ссылки, Идентификатор)

	Возврат ТочкаВывода("Выгрузить", МассивИз(Ссылки, ПараметрыВывода(Фикстура, Идентификатор)));

КонецФункции

Функция ТекстИсключенияВывода(Ссылки, Параметры)

	Текст = Неопределено;
	Попытка
		ТочкаВывода("Выгрузить", МассивИз(Ссылки, Параметры));
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Текст;

КонецФункции

Функция Кандидаты(Фикстура)

	Возврат ТочкаВывода("КандидатыВыгрузки", МассивИз(Фикстура.СчетПлательщика, Фикстура.Начало, Фикстура.Конец));

КонецФункции

Функция СтрокаКандидата(Кандидаты, Ссылка)

	Для Каждого Строка Из Кандидаты Цикл
		Если Строка.Ссылка = Ссылка Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Ложь, "Кандидат " + Ссылка + " есть в списке кандидатов").ЭтоИстина();
	Возврат Неопределено;

КонецФункции

// Фикстура без предупреждений: названия банков короткие (имя фикстурного банка - 46 знаков, длиннее пределов 45/38),
// назначение без недопустимых символов (в сценарии фикстуры стоит №).
Функция ЧистаяФикстура(ИмяСценария = "ЮрЮр")

	Фикстура = СценарийФикстуры(ИмяСценария);
	Банк1 = Фикстура.БанкПлательщика.ПолучитьОбъект();
	Банк1.Наименование = "Банк платника";
	Банк1.Записать();
	Банк2 = Фикстура.БанкПолучателя.ПолучитьОбъект();
	Банк2.Наименование = "Банк одержувача";
	Банк2.Записать();
	СМП_ТестыДанныеУНФ.НастроитьПлатежноеПоручение(Фикстура.Поручение, Новый Структура("НазначениеПлатежа", "Оплата за товар"));
	Возврат Фикстура;

КонецФункции

Функция НовоеХорошее(Фикстура, Номер, День, Сумма = 100, Назначение = "Оплата за товар", Оплачено = Ложь)

	Ссылка = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация,БанковскийСчет,Контрагент,Дата,Номер,Сумма,Оплачено",
		Фикстура.Организация, Фикстура.СчетПлательщика, Фикстура.Контрагент, Дата(2026, 3, День, 9, 0, 0), Номер, Сумма, Оплачено));
	СМП_ТестыДанныеУНФ.НастроитьПлатежноеПоручение(Ссылка, Новый Структура("НазначениеПлатежа,СчетКонтрагента,ТекстПлательщика,ТекстПолучателя",
		Назначение, Фикстура.СчетПолучателя, "ТОВ Платник (текст документа)", "ТОВ Одержувач (текст документа)"));
	Возврат Ссылка;

КонецФункции

Функция СтрокиПозиции(Пакет, Позиция)

	Строки = Новый Массив;
	Для Каждого Строка Из Пакет.Диагностика Цикл
		Если Строка.Позиция = Позиция Тогда
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция КоличествоСтрокПозиции(Пакет, Позиция)

	Возврат СтрокиПозиции(Пакет, Позиция).Количество();

КонецФункции

// Статусы строк позиции без повторов, через запятую (одно значение - у позиции один статус).
Функция СтатусПозиции(Пакет, Позиция)

	Статусы = Новый Массив;
	Для Каждого Строка Из СтрокиПозиции(Пакет, Позиция) Цикл
		Если Статусы.Найти(Строка.Статус) = Неопределено Тогда
			Статусы.Добавить(Строка.Статус);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Статусы, ",");

КонецФункции

Функция ТекстПозиции(Пакет, Позиция)

	Тексты = Новый Массив;
	Для Каждого Строка Из СтрокиПозиции(Пакет, Позиция) Цикл
		Тексты.Добавить(Строка.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

Функция СтрокаПоля(Пакет, Позиция, Поле)

	Для Каждого Строка Из СтрокиПозиции(Пакет, Позиция) Цикл
		Если Строка.Поле = Поле Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ВерсииДокументов(Ссылки)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.ВерсияДанных КАК Версия ИЗ Документ.ПлатежноеПоручение КАК Т ГДЕ Т.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Версии = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Версии.Вставить(Выборка.Ссылка, Выборка.Версия);
	КонецЦикла;
	Возврат Версии;

КонецФункции

// Записи истории организации (ValueStorage-поля выбираются как есть).
Функция ЗаписиИстории(Организация)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Т.Период КАК Период, Т.Организация КАК Организация, Т.БанковскийСчет КАК БанковскийСчет, Т.Загрузка КАК Загрузка,
		|	Т.КоличествоДокументовВВыписке КАК КоличествоДокументовВВыписке, Т.Кодировка КАК Кодировка,
		|	Т.ИсходныйФайл КАК ИсходныйФайл, Т.ПротоколЗагрузки КАК ПротоколЗагрузки, Т.ИмяФайла КАК ИмяФайла,
		|	Т.КодировкаТекста КАК КодировкаТекста
		|ИЗ РегистрСведений.ИсторияРаботыСКлиентомБанка КАК Т
		|ГДЕ Т.Организация = &Организация");
	Запрос.УстановитьПараметр("Организация", Организация);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

