// Антипаттерн "точка формирует байты сама": файл пакета равен файлу модуля формата на тех же поручениях.
Процедура Пакет_ФайлРавенФайлуМодуляФормата(Описание, Идентификатор) Экспорт

	Фикстура = ЧистаяФикстура();
	Второе = НовоеХорошее(Фикстура, "00000124", 7, 250.75);
	Ссылки = МассивИз(Фикстура.Поручение, Второе);

	Пакет = ВывестиПакет(Фикстура, Ссылки, Идентификатор);
	Ожидаемое = ФайлМодуляФормата(Идентификатор, Фикстура, Ссылки);

	ЮТест.ОжидаетЧто(Пакет.Отказ, Описание + ": вывод не отклонен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ТипЗнч(Ожидаемое.Данные) = Тип("ДвоичныеДанные") И Ожидаемое.Данные.Размер() > 0, Описание + ": предпосылка - модуль формата дал файл").ЭтоИстина();
	ЮТест.ОжидаетЧто(БайтыРавны(Пакет.ДвоичныеДанные, Ожидаемое.Данные), Описание + ": файл пакета = файл модуля формата на тех же поручениях").ЭтоИстина();
	ЮТест.ОжидаетЧто(Пакет.Кодировка, Описание + ": кодировка из описания формата").Равно(ОписаниеМодуляФормата(Идентификатор).Кодировка);
	ЮТест.ОжидаетЧто(Пакет.КодировкаТекста, Описание + ": кодировка текста файла из описания формата (пакет переносит)")
		.Равно(ОписаниеМодуляФормата(Идентификатор).КодировкаТекста);
	ЮТест.ОжидаетЧто(Пакет.ПредлагаемоеИмя, Описание + ": имя от модуля формата").Равно(ИмяФайлаМодуляФормата(Идентификатор, МоментВывода()));
	ЮТест.ОжидаетЧто(Пакет.ИдентификаторСтроки, Описание + ": строка реестра в пакете").Равно(Идентификатор);
	ЮТест.ОжидаетЧто(Пакет.Всего, Описание + ": M").Равно(2);
	ЮТест.ОжидаетЧто(Пакет.Выгружено, Описание + ": N").Равно(2);

КонецПроцедуры

