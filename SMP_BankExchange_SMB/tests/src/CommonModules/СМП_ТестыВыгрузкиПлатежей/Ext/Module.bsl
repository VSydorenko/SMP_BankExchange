Процедура Проверка_Отклоняет(Описание, Операция, Путь, Значение, Фрагмент) Экспорт

	Поручение = ЗаполненноеПоручение();
	Если Операция = "Заменить" Тогда
		Поручение = Значение;
	Иначе
		ИзменитьПоПути(Поручение, Операция, Путь, Значение);
	КонецЕсли;

	Причины = ПродуктФункция("ПроверитьПоручение", Поручение);

	ЮТест.ОжидаетЧто(Причины.Количество() > 0, Описание + ": поручение отклонено (причин: " + Причины.Количество() + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрСоединить(Причины, " | "), Описание + ": в причине названо поле и суть").Содержит(Фрагмент);

