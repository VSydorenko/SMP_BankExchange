
#Область ГарнесЭталона

// Файл эталона для набора нормализованных поручений (план 07, задача 1): Выгрузить_Бух копии обработки банка,
// вход которой строится из ТЕХ ЖЕ нормализованных поручений (СМП_ВыгрузкаПлатежей.НовоеПоручение), что получит
// модуль формата. Так сравниваются два формата одних данных, а не две выборки (не таблица из документа базы и не
// «золотой» файл: эталон живет, пока живы копии обработок; этап 9 обязан заморозить его иначе - «Перенесено»).
// На этом гарнесе стоят сравнения байт в байт задач 3-4.
//
// Гарнес базу не читает и не пишет, файлы убирает (помощник Выгрузить).
//
// Параметры:
//  ИмяБанка - Строка - суффикс копии обработки: "АкордБанк", "СенсБанк" и т.д.
//  Поручения - Массив из Структура - нормализованные поручения.
//  Отображение - Массив из Структура, Неопределено - отображение колонок (по умолчанию ОтображениеКолонокЭталона());
//                 параметр нужен только контролям гарнеса.
//
// Возвращаемое значение:
//  ДвоичныеДанные - файл эталона.
Функция ФайлЭталона(ИмяБанка, Поручения, Отображение = Неопределено) Экспорт

	Возврат Выгрузить(ИмяБанка, ТаблицаВходаЭталона(Поручения, Отображение)).Байты;

КонецФункции

// Таблица значений с колонками ПлатежныеДокументы ACC, построенная из нормализованных поручений.
// Каждая колонка входа обязана иметь отображение, а каждое отображение - поле в поручении и подходящий тип:
// иначе исключение с именем колонки (пустое значение молча не подставляется; эталон падает на отсутствующей
// колонке сам, но полноту проверяет гарнес). Колонка Выгружать служебная: форма ACC передает эталону только
// строки с Выгружать = Истина, гарнес ставит Истина.
//
// Параметры:
//  Поручения - Массив из Структура
//  Отображение - Массив из Структура, Неопределено
//
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ТаблицаВходаЭталона(Поручения, Отображение = Неопределено) Экспорт

	Если Отображение = Неопределено Тогда
		Отображение = ОтображениеКолонокЭталона();
	КонецЕсли;

	Таблица = НоваяТаблицаВхода();
	ПроверитьПолнотуОтображения(Таблица, Отображение);

	Для Каждого Поручение Из Поручения Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Выгружать = Истина;
		Для Каждого Элемент Из Отображение Цикл
			Значение = ЗначениеПоляПоручения(Поручение, Элемент.Путь, Элемент.Колонка);
			Если НЕ Таблица.Колонки[Элемент.Колонка].ТипЗначения.СодержитТип(ТипЗнч(Значение)) Тогда
				ВызватьИсключение СтрШаблон("Гарнес эталона: колонка %1 не принимает значение поля %2 типа %3",
					Элемент.Колонка, Элемент.Путь, Строка(ТипЗнч(Значение)));
			КонецЕсли;
			НоваяСтрока[Элемент.Колонка] = Значение;
		КонецЦикла;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// ЕДИНСТВЕННОЕ место отображения «колонка ПлатежныеДокументы ACC -> поле нормализованного поручения».
// Источник - вендорский запрос ACC: ЗаполнитьДокументыНаЭкспорт (DataProcessors/КлиентБанк, модуль менеджера):
//  ОКПОПлательщика = Организация.КодПоЕДРПОУ              <- Плательщик.Код
//  ОКПОПолучателя  = Контрагент.КодПоЕДРПОУ                <- Получатель.Код
//  Организация / Контрагент = НаименованиеПолное            <- Наименование стороны
//  ОрганизацияНомерСчета / КонтрагентНомерСчета = СчетОрганизации.НомерСчета / СчетКонтрагента.НомерСчета
//                                                           <- НомерСчета стороны
//  ОрганизацияБанк / КонтрагентБанк = Банк.Наименование     <- Банк
//  ОрганизацияМФОБанка / КонтрагентМФОБанка = Банк.Код      <- МФО
//  Номер, Дата, СуммаДокумента, НазначениеПлатежа           <- одноименные поля документа
// Счет - НомерСчета, а не IBAN: ACC берет НомерСчета как в справочнике (IBAN или старый
// номер), и именно его читает эталон; поле IBAN стороны - выделенный IBAN, для старых счетов пустое.
// Эталон не читает: ВидКода, IBAN, Город (колонок для них в ПлатежныеДокументы, которые читает Выгрузить_Бух, нет).
//
// Возвращаемое значение:
//  Массив из Структура - элементы Колонка, Путь (путь с точкой: "Плательщик.Код").
Функция ОтображениеКолонокЭталона() Экспорт

	Результат = Новый Массив;
	ДобавитьОтображение(Результат, "Дата", "Дата");
	ДобавитьОтображение(Результат, "Номер", "Номер");
	ДобавитьОтображение(Результат, "СуммаДокумента", "Сумма");
	ДобавитьОтображение(Результат, "НазначениеПлатежа", "НазначениеПлатежа");
	ДобавитьОтображение(Результат, "Организация", "Плательщик.Наименование");
	ДобавитьОтображение(Результат, "ОКПОПлательщика", "Плательщик.Код");
	ДобавитьОтображение(Результат, "ОрганизацияНомерСчета", "Плательщик.НомерСчета");
	ДобавитьОтображение(Результат, "ОрганизацияБанк", "Плательщик.Банк");
	ДобавитьОтображение(Результат, "ОрганизацияМФОБанка", "Плательщик.МФО");
	ДобавитьОтображение(Результат, "Контрагент", "Получатель.Наименование");
	ДобавитьОтображение(Результат, "ОКПОПолучателя", "Получатель.Код");
	ДобавитьОтображение(Результат, "КонтрагентНомерСчета", "Получатель.НомерСчета");
	ДобавитьОтображение(Результат, "КонтрагентБанк", "Получатель.Банк");
	ДобавитьОтображение(Результат, "КонтрагентМФОБанка", "Получатель.МФО");
	Возврат Результат;

КонецФункции

Процедура ДобавитьОтображение(Отображение, Колонка, Путь)

	Отображение.Добавить(Новый Структура("Колонка,Путь", Колонка, Путь));

КонецПроцедуры

// Каждая колонка входа (кроме служебной Выгружать) имеет ровно одно отображение; отображение не ссылается на
// несуществующую колонку.
Процедура ПроверитьПолнотуОтображения(Таблица, Отображение)

	Отображаемые = Новый Соответствие;
	Для Каждого Элемент Из Отображение Цикл
		Если Таблица.Колонки.Найти(Элемент.Колонка) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Гарнес эталона: отображение для колонки %1, которой нет во входе эталона", Элемент.Колонка);
		КонецЕсли;
		Отображаемые.Вставить(Элемент.Колонка, Истина);
	КонецЦикла;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя <> "Выгружать" И Отображаемые[Колонка.Имя] = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Гарнес эталона: для колонки %1 нет отображения из нормализованного поручения", Колонка.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеПоляПоручения(Поручение, Путь, Колонка)

	Текущее = Поручение;
	Для Каждого Имя Из СтрРазделить(Путь, ".") Цикл
		Если ТипЗнч(Текущее) <> Тип("Структура") Тогда
			ВызватьИсключение СтрШаблон("Гарнес эталона: в поручении нет поля %1 (колонка %2)", Путь, Колонка);
		КонецЕсли;
		Если НЕ Текущее.Свойство(Имя) Тогда
			ВызватьИсключение СтрШаблон("Гарнес эталона: в поручении нет поля %1 (колонка %2)", Путь, Колонка);
		КонецЕсли;
		Текущее = Текущее[Имя];
	КонецЦикла;
	Возврат Текущее;

КонецФункции

#КонецОбласти

#Область Помощники

// Вызов эталона: Выгрузить_Бух на копии обработки банка. Возвращает Байты (результат из временного хранилища) и
// НовыеФайлы (имена файлов, которые эталон оставил во временной папке); свой файл удаляется (УдалитьСвойФайл), адрес хранилища чистится.
Функция Выгрузить(ИмяБанка, Таблица)

	Перед = ИменаВременныхФайлов();
	Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_" + ИмяБанка + ".Создать");
	Параметры = Новый Структура;
	Параметры.Вставить("ПлатежныеДокументы", Таблица.НайтиСтроки(Новый Структура("Выгружать", Истина)));
	Параметры.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	Адрес = Обработка.Выгрузить_Бух(Параметры);
	Байты = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Новые = НовыеФайлыСПосле(Перед, МаскаЭталона(ИмяБанка));
	УдалитьСвойФайл(Новые);
	Возврат Новый Структура("Байты,НовыеФайлы", Байты, Новые);

КонецФункции

// Снимок имен файлов, какие оставляет эталон: v8*.csv (iFOBS: ПолучитьИмяВременногоФайла) и <8 цифр>.dbf (Сенс). Временная
// папка общая с другими процессами (в ней бывают недоступные каталоги и чужие файлы), поэтому перебираются только
// эти маски и удаляются только файлы по имени эталона, появившиеся после снимка.
Функция ИменаВременныхФайлов()

	Результат = Новый Соответствие;
	Для Каждого Файл Из ФайлыЭталона() Цикл
		Результат.Вставить(НРег(Файл.Имя), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Полные имена файлов эталона, которых не было в снимке. Маска: "v8*.csv" (iFOBS), "????????.dbf" (Сенс); Неопределено - обе.
Функция НовыеФайлыСПосле(Перед, Маска = Неопределено)

	Результат = Новый Массив;
	Для Каждого Файл Из ФайлыЭталона(Маска) Цикл
		Если Перед[НРег(Файл.Имя)] = Неопределено Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МаскаЭталона(ИмяБанка)

	Возврат ?(ИмяБанка = "СенсБанк", "????????.dbf", "v8*.csv");

КонецФункции

Функция ФайлыЭталона(Маска = Неопределено)

	Результат = Новый Массив;
	Для Каждого ТекущаяМаска Из ?(Маска = Неопределено, СтрРазделить("v8*.csv,????????.dbf", ","), СтрРазделить(Маска, ",")) Цикл
		Для Каждого Файл Из НайтиФайлы(КаталогВременныхФайлов(), ТекущаяМаска) Цикл
			Результат.Добавить(Файл);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Удаляет файл, который создала эта обработка: ровно один новый файл по маске эталона. Временная папка общая с другими
// сессиями и процессами 1С, поэтому при нескольких кандидатах свой не определить: исключение, ничего не удаляется.
Процедура УдалитьСвойФайл(Новые)

	Если Новые.Количество() > 1 Тогда
		ВызватьИсключение "Во временной папке после вызова эталона несколько новых файлов (" + СтрСоединить(Новые, "; ")
			+ "): свой не определить, ничего не удалено (папка общая с другими процессами)";
	КонецЕсли;
	Если Новые.Количество() = 1 Тогда
		УдалитьФайлы(Новые[0]);
	КонецЕсли;

КонецПроцедуры

// Таблица значений с колонками ПлатежныеДокументы ACC, которые читает Выгрузить_Бух (+ Выгружать: форма ACC
// передает НайтиСтроки(Выгружать = Истина)). Типы и длины - как в метаданных ACC.
Функция НоваяТаблицаВхода()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Выгружать", Новый ОписаниеТипов("Булево"));
	Т.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Т.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("СуммаДокумента", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));
	Для Каждого Имя Из СтрРазделить("Организация,ОрганизацияБанк,Контрагент,КонтрагентБанк,НазначениеПлатежа", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОКПОПлательщика,ОКПОПолучателя", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОрганизацияНомерСчета,КонтрагентНомерСчета", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(34)));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОрганизацияМФОБанка,КонтрагентМФОБанка", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	КонецЦикла;
	Возврат Т;

КонецФункции

#КонецОбласти
