// Вызов эталона: Выгрузить_Бух на копии обработки банка. Возвращает Байты (результат из временного хранилища) и
// НовыеФайлы (имена файлов, которые эталон оставил во временной папке); новые файлы удаляются, адрес хранилища чистится.
Функция Выгрузить(ИмяБанка, Таблица)

	Перед = ИменаВременныхФайлов();
	Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_" + ИмяБанка + ".Создать");
	Параметры = Новый Структура;
	Параметры.Вставить("ПлатежныеДокументы", Таблица.НайтиСтроки(Новый Структура("Выгружать", Истина)));
	Параметры.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	Адрес = Обработка.Выгрузить_Бух(Параметры);
	Байты = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	Новые = НовыеФайлыСПосле(Перед);
	УдалитьВременныеФайлыПосле(Перед);
	Возврат Новый Структура("Байты,НовыеФайлы", Байты, Новые);

КонецФункции

// Снимок имен файлов, какие оставляет эталон: v8*.csv (iFOBS: ПолучитьИмяВременногоФайла) и <8 цифр>.dbf (Сенс). Временная
// папка общая с другими процессами (в ней бывают недоступные каталоги и чужие файлы), поэтому перебираются только
// эти маски и удаляются только файлы по имени эталона, появившиеся после снимка.
Функция ИменаВременныхФайлов()

	Результат = Новый Соответствие;
	Для Каждого Файл Из ФайлыЭталона() Цикл
		Результат.Вставить(НРег(Файл.Имя), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Полные имена файлов эталона, которых не было в снимке.
Функция НовыеФайлыСПосле(Перед)

	Результат = Новый Массив;
	Для Каждого Файл Из ФайлыЭталона() Цикл
		Если Перед[НРег(Файл.Имя)] = Неопределено Тогда
			Результат.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ФайлыЭталона()

	Результат = Новый Массив;
	Для Каждого Файл Из НайтиФайлы(КаталогВременныхФайлов(), "v8*.csv") Цикл
		Результат.Добавить(Файл);
	КонецЦикла;
	Для Каждого Файл Из НайтиФайлы(КаталогВременныхФайлов(), "????????.dbf") Цикл
		Результат.Добавить(Файл);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура УдалитьВременныеФайлыПосле(Перед)

	Для Каждого Имя Из НовыеФайлыСПосле(Перед) Цикл
		УдалитьФайлы(Имя);
	КонецЦикла;

КонецПроцедуры

// Таблица значений с колонками ПлатежныеДокументы ACC, которые читает Выгрузить_Бух (+ Выгружать: форма ACC
// передает НайтиСтроки(Выгружать = Истина)). Типы и длины - как в метаданных ACC.
Функция НоваяТаблицаВхода()

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Выгружать", Новый ОписаниеТипов("Булево"));
	Т.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Т.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	Т.Колонки.Добавить("СуммаДокумента", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));
	Для Каждого Имя Из СтрРазделить("Организация,ОрганизацияБанк,Контрагент,КонтрагентБанк,НазначениеПлатежа", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОКПОПлательщика,ОКПОПолучателя", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОрганизацияНомерСчета,КонтрагентНомерСчета", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(34)));
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ОрганизацияМФОБанка,КонтрагентМФОБанка", ",") Цикл
		Т.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(9)));
	КонецЦикла;
	Возврат Т;

КонецФункции

// Добавляет строку-поручение с выдуманными значениями; Значения - Структура с заменами по имени колонки.
Процедура ДобавитьСтроку(Таблица, Значения = Неопределено)

	Строка = Таблица.Добавить();
	Строка.Выгружать = Истина;
	Строка.Дата = Дата(2026, 10, 5, 13, 45, 0);
	Строка.Номер = "000012";
	Строка.СуммаДокумента = 1234567.5;
	Строка.Организация = "СМП_ТЕСТ_Организация";
	Строка.ОКПОПлательщика = "90000001";
	Строка.ОКПОПолучателя = "90000002";
	Строка.ОрганизацияНомерСчета = "UA159999910000026000000000001";
	Строка.ОрганизацияБанк = "СМП_ТЕСТ_Банк организации";
	Строка.ОрганизацияМФОБанка = "999991";
	Строка.Контрагент = "СМП_ТЕСТ_Контрагент";
	Строка.КонтрагентНомерСчета = "UA229999920000026000000000002";
	Строка.КонтрагентБанк = "СМП_ТЕСТ_Банк контрагента";
	Строка.КонтрагентМФОБанка = "999992";
	Строка.НазначениеПлатежа = "Оплата за товар 5";
	Если Значения <> Неопределено Тогда
		Для Каждого Элемент Из Значения Цикл
			Строка[Элемент.Ключ] = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ТаблицаСДвумяПоручениями()

	Таблица = НоваяТаблицаВхода();
	ДобавитьСтроку(Таблица);
	ДобавитьСтроку(Таблица, Новый Структура("Номер,СуммаДокумента,Дата", "7", 100, Дата(2026, 1, 2)));
	Возврат Таблица;

КонецФункции

Функция Повтор(Символы, Количество)

	Части = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Части.Добавить(Символы);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

Функция ТекстWindows1251(Байты)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Байты, "windows-1251");

КонецФункции

Функция БайтыИзТекстаWindows1251(Текст)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "windows-1251", Ложь);

КонецФункции

Функция БайтыМассив(Данные)

	Результат = Новый Массив;
	Чтение = Новый ЧтениеДанных(Данные);
	Для Индекс = 1 По Данные.Размер() Цикл
		Результат.Добавить(Чтение.ПрочитатьБайт());
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ДвоичныеИзБайтов(Массив)

	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Для Каждого Б Из Массив Цикл
		Запись.ЗаписатьБайт(Б);
	КонецЦикла;
	Запись.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// Записи iFOBS как массив Соответствий «ключ - значение». Структуру файла проверяют ПроверкаКонцовСтрок и тест
// числа строк; здесь блок = 17 строк: заголовок, пустая, 14 ключей, пустая.
Функция ЗаписиiFOBS(Байты)

	Строки = СтрРазделить(СтрЗаменить(ТекстWindows1251(Байты), Символы.ВК, ""), Символы.ПС);
	Результат = Новый Массив;
	Начало = 0;
	Пока Начало + 16 < Строки.Количество() Цикл
		Запись = Новый Соответствие;
		Для Индекс = 2 По 15 Цикл
			Строка = Строки[Начало + Индекс];
			Позиция = СтрНайти(Строка, "=");
			Запись.Вставить(Лев(Строка, Позиция - 1), Сред(Строка, Позиция + 1));
		КонецЦикла;
		Результат.Добавить(Запись);
		Начало = Начало + 17;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключи строк, которыми отличаются два текста (по порядку, без повторов); при разном числе строк - «<число строк>».
Функция РазличающиесяКлючи(ТекстА, ТекстБ)

	СтрокиА = СтрРазделить(ТекстА, Символы.ПС);
	СтрокиБ = СтрРазделить(ТекстБ, Символы.ПС);
	Результат = Новый Массив;
	Если СтрокиА.Количество() <> СтрокиБ.Количество() Тогда
		Результат.Добавить("<число строк>");
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 0 По СтрокиА.ВГраница() Цикл
		Если СтрокиА[Индекс] <> СтрокиБ[Индекс] Тогда
			Позиция = СтрНайти(СтрокиА[Индекс], "=");
			Ключ = ?(Позиция > 0, Лев(СтрокиА[Индекс], Позиция - 1), "<строка " + Индекс + ">");
			Если Результат.Найти(Ключ) = Неопределено Тогда
				Результат.Добавить(Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание проблемы с концами строк, BOM и хвостом iFOBS; пустая строка - файл как у эталона: без BOM, CRLF,
// без одиночных CR/LF, заканчивается пустой строкой (CRLF CRLF).
Функция ПроверкаКонцовСтрок(Байты)

	Б = БайтыМассив(Байты);
	Проблемы = Новый Массив;
	Если Б.Количество() >= 3 И Б[0] = 239 И Б[1] = 187 И Б[2] = 191 Тогда
		Проблемы.Добавить("есть BOM UTF-8");
	КонецЕсли;
	Если Б.Количество() >= 2 И ((Б[0] = 255 И Б[1] = 254) Или (Б[0] = 254 И Б[1] = 255)) Тогда
		Проблемы.Добавить("есть BOM UTF-16");
	КонецЕсли;
	Для Индекс = 0 По Б.ВГраница() Цикл
		Если Б[Индекс] = 13 Тогда
			Если Индекс = Б.ВГраница() Или Б[Индекс + 1] <> 10 Тогда
				Проблемы.Добавить("CR без LF");
			КонецЕсли;
		ИначеЕсли Б[Индекс] = 10 Тогда
			Если Индекс = 0 Или Б[Индекс - 1] <> 13 Тогда
				Проблемы.Добавить("LF без CR");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Количество = Б.Количество();
	Если Количество < 4 Или Б[Количество - 4] <> 13 Или Б[Количество - 3] <> 10 Или Б[Количество - 2] <> 13 Или Б[Количество - 1] <> 10 Тогда
		Проблемы.Добавить("файл не заканчивается пустой строкой (CRLF CRLF)");
	КонецЕсли;
	Возврат СтрСоединить(Проблемы, "; ");

КонецФункции

// Разбор DBF как у эталона: dBASE III, поля типа C. Записи - Соответствия «поле - значение без хвостовых
// пробелов», кодировка 1251.
Функция РазобратьDBF(Байты)

	Б = БайтыМассив(Байты);
	Т = Новый Структура;
	Т.Вставить("Размер", Б.Количество());
	Т.Вставить("Версия", Б[0]);
	Т.Вставить("ДатаГод", Б[1]);
	Т.Вставить("ДатаМесяц", Б[2]);
	Т.Вставить("ДатаДень", Б[3]);
	Т.Вставить("ЧислоЗаписей", Б[4] + Б[5] * 256 + Б[6] * 65536 + Б[7] * 16777216);
	Т.Вставить("ДлинаЗаголовка", Б[8] + Б[9] * 256);
	Т.Вставить("ДлинаЗаписи", Б[10] + Б[11] * 256);
	Т.Вставить("ЯзыковойДрайвер", Б[29]);
	Т.Вставить("Терминатор", Б[Т.ДлинаЗаголовка - 1]);
	Т.Вставить("Последний", Б[Б.ВГраница()]);

	Поля = Новый Массив;
	Смещение = 32;
	Пока Б[Смещение] <> 13 Цикл
		Имя = "";
		Для Индекс = 0 По 10 Цикл
			Если Б[Смещение + Индекс] <> 0 Тогда
				Имя = Имя + Символ(Б[Смещение + Индекс]);
			КонецЕсли;
		КонецЦикла;
		Поля.Добавить(Новый Структура("Имя,Тип,Длина,Дробная", Имя, Символ(Б[Смещение + 11]), Б[Смещение + 16], Б[Смещение + 17]));
		Смещение = Смещение + 32;
	КонецЦикла;
	Т.Вставить("Поля", Поля);

	Записи = Новый Массив;
	Признаки = Новый Массив;
	Если Т.ЧислоЗаписей > 0 Тогда
		Чтение = Новый ЧтениеДанных(Байты);
		Чтение.Пропустить(Т.ДлинаЗаголовка);
		Тело = ТекстWindows1251(Чтение.Прочитать(Т.ДлинаЗаписи * Т.ЧислоЗаписей).ПолучитьДвоичныеДанные());
		Чтение.Закрыть();
		Для НомерЗаписи = 0 По Т.ЧислоЗаписей - 1 Цикл
			Признаки.Добавить(Б[Т.ДлинаЗаголовка + НомерЗаписи * Т.ДлинаЗаписи]);
			// +1: признак записи занимает первый символ записи; позиции в Сред считаются с 1.
			Позиция = НомерЗаписи * Т.ДлинаЗаписи + 2;
			Запись = Новый Соответствие;
			Для Каждого Поле Из Поля Цикл
				Запись.Вставить(Поле.Имя, СокрП(Сред(Тело, Позиция, Поле.Длина)));
				Позиция = Позиция + Поле.Длина;
			КонецЦикла;
			Записи.Добавить(Запись);
		КонецЦикла;
	КонецЕсли;
	Т.Вставить("Записи", Записи);
	Т.Вставить("ПризнакиУдаления", Признаки);
	Возврат Т;

КонецФункции

#КонецОбласти
