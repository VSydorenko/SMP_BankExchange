#Область УсловияВызова

Процедура Условия_СеансRuRU() Экспорт

	ЮТест.ОжидаетЧто(ТекущийКодЛокализации(), "Код локализации сеанса тестов (условие измерения эталона)").Равно("ru_RU");
	ЮТест.ОжидаетЧто(Формат(1234567.5, "ЧДЦ=2"), "Неявный формат числа в этом сеансе").Равно("1" + Символ(160) + "234" + Символ(160) + "567,50");

КонецПроцедуры

// Выгрузить_Бух вызывается из теста без формы ACC, без ACC и с минимальным составом параметров.
Процедура Вызов_ВнеФормыБезACC(Описание, ИмяБанка) Экспорт

	Результат = Выгрузить(ИмяБанка, ТаблицаСДвумяПоручениями());

	ЮТест.ОжидаетЧто(Результат.Байты.Размер() > 0, Описание + ": эталон вернул пустой файл").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Байты), Описание + ": тип результата").Равно(Тип("ДвоичныеДанные"));

КонецПроцедуры

// Эталон читает Параметры.УникальныйИдентификатор и обязательно: без него падает с текстом про поле.
Процедура Вызов_БезУникальногоИдентификатора_ОшибкаПоля() Экспорт

	Перед = ИменаВременныхФайлов();
	Текст = "";
	Попытка
		Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_АкордБанк.Создать");
		Адрес = Обработка.Выгрузить_Бух(Новый Структура("ПлатежныеДокументы", Новый Массив));
		Текст = "Исключения не было";
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УдалитьВременныеФайлыПосле(Перед);

	ЮТест.ОжидаетЧто(Текст, "Вызов без УникальныйИдентификатор").Равно("Поле объекта не обнаружено (УникальныйИдентификатор)");

КонецПроцедуры

// Колонки, которой нет в таблице, эталон называет в ошибке (первая недостающая в порядке чтения: Дата прочитана,
// Номер нет). Текст «Неверное имя колонки» без имени дает не эталон, а НайтиСтроки по колонке Выгружать.
Процедура Вызов_БезКолонки_ОшибкаНазываетПерваюНедостающую() Экспорт

	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Выгружать");
	Т.Колонки.Добавить("Дата");
	Строка = Т.Добавить();
	Строка.Выгружать = Истина;
	Текст = "";
	Перед = ИменаВременныхФайлов();
	Попытка
		Выгрузить("АкордБанк", Т);
		Текст = "Исключения не было";
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УдалитьВременныеФайлыПосле(Перед);

	ЮТест.ОжидаетЧто(Текст, "Таблица без колонки Номер").Равно("Поле объекта не обнаружено (Номер)");

КонецПроцедуры

Процедура Вызов_ФорматФайлаВыгрузки(Описание, ИмяБанка, Ожидаемый) Экспорт

	Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_" + ИмяБанка + ".Создать");

	ЮТест.ОжидаетЧто(Обработка.ФорматФайлаВыгрузки(), Описание + ": ФорматФайлаВыгрузки()").Равно(Ожидаемый);

КонецПроцедуры

// Эталон iFOBS пишет во временный файл со случайным именем и расширением csv (ФорматФайла()), а не txt
// (ФорматФайлаВыгрузки()). Имя пакета эталон не определяет: его даст форма ACC или человек.
Процедура Выгрузка_ВременныйФайлiFOBS_СлучайноеИмяРасширениеCsv() Экспорт

	Результат = Выгрузить("АкордБанк", ТаблицаСДвумяПоручениями());

	ЮТест.ОжидаетЧто(Результат.НовыеФайлы.Количество(), "Новых файлов после одного вызова").Равно(1);
	Файл = Новый Файл(Результат.НовыеФайлы[0]);
	ЮТест.ОжидаетЧто(Файл.Расширение, "Расширение временного файла").Равно(".csv");
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Файл.ИмяБезРасширения, "v8"), "Имя от ПолучитьИмяВременногоФайла: " + Файл.Имя).ЭтоИстина();

КонецПроцедуры

// Эталон Сенса сам формирует имя: <yyMMhhmm>.dbf, где hh - 12-часовой. Новая реализация берет момент
// параметром и пишет 24-часовой (отступление 2 плана); этот тест фиксирует, что эталон и вправду 12-часовой.
Процедура Выгрузка_ВременныйФайлСенса_ИмяИзТекущегоВремени12ЧасовыхЧасов() Экспорт

	ДоВызова = ТекущаяДата();
	Результат = Выгрузить("СенсБанк", ТаблицаСДвумяПоручениями());
	ПослеВызова = ТекущаяДата();

	ЮТест.ОжидаетЧто(Результат.НовыеФайлы.Количество(), "Новых файлов после одного вызова").Равно(1);
	Файл = Новый Файл(Результат.НовыеФайлы[0]);
	// XBase пишет расширение заглавными: имя файла «yyMMhhmm.DBF», хотя в коде эталона «dbf».
	ЮТест.ОжидаетЧто(Файл.Расширение, "Расширение").Равно(".DBF");
	Допустимые = Новый Массив;
	Допустимые.Добавить(Формат(ДоВызова, "ДФ=yyMMhhmm"));
	Допустимые.Добавить(Формат(ПослеВызова, "ДФ=yyMMhhmm"));
	ЮТест.ОжидаетЧто(Допустимые.Найти(Файл.ИмяБезРасширения) <> Неопределено, "Имя '" + Файл.ИмяБезРасширения + "', ожидали одно из " + СтрСоединить(Допустимые, ", ")).ЭтоИстина();
	// 13:45 по 12-часовым часам - 01, а не 13; это свойство формата, на котором стоит имя.
	ЮТест.ОжидаетЧто(Формат(Дата(2026, 10, 5, 13, 45, 0), "ДФ=yyMMhhmm"), "Формат ДФ=yyMMhhmm для 13:45").Равно("26100145");

КонецПроцедуры

