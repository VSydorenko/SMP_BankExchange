// Три банка пишут в CLN_OKPO код получателя, два - код плательщика. В таблице ACC плательщик - наша организация
// (запрос ACC: Организация.КодПоЕДРПОУ КАК ОКПОПлательщика), поэтому у трех банков CLN_OKPO (клиент) - код
// контрагента. Решение спеки: дефект, не воспроизводится.
Процедура iFOBS_ОКПО_ПереставленыУТрехБанков(Описание, ИмяБанка, CLNБерётПолучателя) Экспорт

	Таблица = НоваяТаблицаВхода();
	ДобавитьСтроку(Таблица, Новый Структура("ОКПОПлательщика,ОКПОПолучателя", "90000001", "90000002"));
	Записи = ЗаписиiFOBS(Выгрузить(ИмяБанка, Таблица).Байты);

	ЮТест.ОжидаетЧто(Записи[0].Получить("CLN_OKPO"), Описание + ": CLN_OKPO").Равно(?(CLNБерётПолучателя, "90000002", "90000001"));
	ЮТест.ОжидаетЧто(Записи[0].Получить("RCPT_OKPO"), Описание + ": RCPT_OKPO").Равно(?(CLNБерётПолучателя, "90000001", "90000002"));

КонецПроцедуры

// Пять копий iFOBS на одном входе дают одинаковые байты, кроме строк CLN_OKPO/RCPT_OKPO. ЕДРПОУ организации
// и контрагента во входе РАЗНЫЕ: иначе переставленные строки дали бы те же байты и тест прошел бы впустую.
Процедура iFOBS_ПятьКопийДаютОдинаковыеБайтыКромеОКПО() Экспорт

	Таблица = НоваяТаблицаВхода();
	ДобавитьСтроку(Таблица, Новый Структура("ОКПОПлательщика,ОКПОПолучателя", "90000001", "90000002"));
	ДобавитьСтроку(Таблица, Новый Структура("ОКПОПлательщика,ОКПОПолучателя,Номер", "90000003", "90000004", "7"));

	Тексты = Новый Соответствие;
	Хеши = Новый Соответствие;
	Записи = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("АкордБанк,БанкВосток,РайффайзенБанк,УкрГазБанк,УниверсалБанк", ",") Цикл
		Байты = Выгрузить(Имя, Таблица).Байты;
		Тексты.Вставить(Имя, ТекстWindows1251(Байты));
		Хеши.Вставить(Имя, Base64Строка(Байты));
		Записи.Вставить(Имя, ЗаписиiFOBS(Байты));
	КонецЦикла;

	ЮТест.ОжидаетЧто(Хеши["УкрГазБанк"], "УкрГаз = Акорд, байт в байт").Равно(Хеши["АкордБанк"]);
	ЮТест.ОжидаетЧто(Хеши["УниверсалБанк"], "Универсал = Акорд, байт в байт").Равно(Хеши["АкордБанк"]);
	ЮТест.ОжидаетЧто(Хеши["РайффайзенБанк"], "Райффайзен = Восток, байт в байт").Равно(Хеши["БанкВосток"]);

	// Восток и Райффайзен от Акорда отличаются, и ровно строками CLN_OKPO/RCPT_OKPO.
	Различия = СтрСоединить(РазличающиесяКлючи(Тексты["АкордБанк"], Тексты["БанкВосток"]), ",");
	ЮТест.ОжидаетЧто(Различия, "Строки, которыми Восток отличается от Акорда").Равно("CLN_OKPO,RCPT_OKPO");
	Различия = СтрСоединить(РазличающиесяКлючи(Тексты["АкордБанк"], Тексты["РайффайзенБанк"]), ",");
	ЮТест.ОжидаетЧто(Различия, "Строки, которыми Райффайзен отличается от Акорда").Равно("CLN_OKPO,RCPT_OKPO");

	// И значения в этих строках действительно другие, у обоих поручений.
	Акорд = Записи["АкордБанк"];
	Восток = Записи["БанкВосток"];
	Для Индекс = 0 По 1 Цикл
		ЮТест.ОжидаетЧто(Восток[Индекс].Получить("CLN_OKPO") <> Акорд[Индекс].Получить("CLN_OKPO"), "CLN_OKPO Востока иной, чем у Акорда, поручение " + Индекс).ЭтоИстина();
		ЮТест.ОжидаетЧто(Восток[Индекс].Получить("RCPT_OKPO") <> Акорд[Индекс].Получить("RCPT_OKPO"), "RCPT_OKPO Востока иной, чем у Акорда, поручение " + Индекс).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Парная сторона: при ОДИНАКОВЫХ кодах Восток и Акорд дают одни байты - значит различие видно только на разных
// кодах (ровно то, что утверждает тест выше), а не на любом входе.
Процедура iFOBS_ПятьКопий_ПриОдинаковыхЕДРПОУПерестановкиНеВидно() Экспорт

	Таблица = НоваяТаблицаВхода();
	ДобавитьСтроку(Таблица, Новый Структура("ОКПОПлательщика,ОКПОПолучателя", "90000001", "90000001"));
	Акорд = Base64Строка(Выгрузить("АкордБанк", Таблица).Байты);
	Восток = Base64Строка(Выгрузить("БанкВосток", Таблица).Байты);

	ЮТест.ОжидаетЧто(Восток, "При одинаковых ЕДРПОУ перестановка не видна в байтах").Равно(Акорд);

КонецПроцедуры

#КонецОбласти

#Область DBF

Процедура DBF_Заголовок() Экспорт

	ДоВызова = ТекущаяДата();
	Байты = Выгрузить("СенсБанк", ТаблицаСДвумяПоручениями()).Байты;
	ПослеВызова = ТекущаяДата();
	Т = РазобратьDBF(Байты);

	ЮТест.ОжидаетЧто(Т.Версия, "Первый байт (dBASE III без memo)").Равно(3);
	ЮТест.ОжидаетЧто(Т.ЧислоЗаписей, "Число записей").Равно(2);
	ЮТест.ОжидаетЧто(Т.ДлинаЗаголовка, "Длина заголовка").Равно(577);
	ЮТест.ОжидаетЧто(Т.ДлинаЗаписи, "Длина записи").Равно(533);
	ЮТест.ОжидаетЧто(Т.ЯзыковойДрайвер, "Байт 29 - язык (0xC9: русская Windows, 1251)").Равно(201);
	ЮТест.ОжидаетЧто(Т.Терминатор, "Завершитель описаний полей").Равно(13);
	ЮТест.ОжидаетЧто(Т.Последний, "Последний байт файла (маркер конца)").Равно(26);
	ЮТест.ОжидаетЧто(Т.Размер, "Размер = заголовок + записи + маркер").Равно(577 + 2 * 533 + 1);
	// Дата последнего обновления в заголовке - ТЕКУЩАЯ ДАТА: год-1900, месяц, день. Эталон от времени зависит.
	Допустимые = Новый Массив;
