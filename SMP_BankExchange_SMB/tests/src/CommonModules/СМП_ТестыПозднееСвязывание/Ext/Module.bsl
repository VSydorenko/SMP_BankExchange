// Симметричная пара, доказывающая, что помощник позднего связывания СМП_ТестыВызовПродукта
// различает два состояния: «модуль не виден» и «модуль виден». Образец - пара из
// SMP_SimplyConnect (docs/architecture/prro/testing.md, разделы 3 и 8).
//
// Исключение не проглатывается: его текст уходит в отчет. Вердикт «Ложь» не отличил бы
// «модуль не виден» от «метод вернул Ложь». Если платформа изменит формулировку ошибки,
// оба теста сломаются одновременно, и это будет видно: одинокий тест тихо позеленел бы навсегда.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Позднее связывание с продуктом")
			.ДобавитьСерверныйТест("НесуществующийМодульДаетОшибкуНеопределеннойПеременной")
			.ДобавитьСерверныйТест("СуществующаяФункцияПродуктаБезОшибкиНеопределеннойПеременной")
			.ДобавитьСерверныйТест("ИсключениеПродуктаПробиваетсяНаверхПолнымТекстом");

КонецПроцедуры

// Отрицательная сторона пары: подстрока платформы ЕСТЬ.
Процедура НесуществующийМодульДаетОшибкуНеопределеннойПеременной() Экспорт

	ТекстИсключения = ТекстВызова("СМП_ЗаведомоНетТакогоМодуля20261013.НетТакогоМетода");

	ЮТест.ОжидаетЧто(СтрНайти(ТекстИсключения, ПодстрокаНеопределеннойПеременной("СМП_ЗаведомоНетТакогоМодуля20261013")) > 0,
		"Ожидали 'Переменная не определена' на несуществующем модуле. Текст: " + ТекстИсключения)
		.ЭтоИстина();

КонецПроцедуры

// Положительная сторона пары: у существующей функции продукта той же подстроки НЕТ.
Процедура СуществующаяФункцияПродуктаБезОшибкиНеопределеннойПеременной() Экспорт

	ТекстИсключения = ТекстВызова("СМП_ВыпискаБанка.ВерсияКонтракта");

	ЮТест.ОжидаетЧто(СтрНайти(ТекстИсключения, ПодстрокаНеопределеннойПеременной("СМП_ВыпискаБанка")), "Имя модуля продукта разрешилось. Текст: " + ТекстИсключения)
		.Равно(0);

КонецПроцедуры

// Исключение внутри метода продукта не прячется помощником: вызов с заведомо неверным числом
// аргументов должен дать исключение, текст которого уже НЕ про неопределенную переменную.
Процедура ИсключениеПродуктаПробиваетсяНаверхПолнымТекстом() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(1);
	Параметры.Добавить(2);
	Параметры.Добавить(3);

	ТекстИсключения = ТекстВызова("СМП_ВыпискаБанка.ВерсияКонтракта", Параметры);

	ЮТест.ОжидаетЧто(ТекстИсключения, "Вызов с лишними аргументами должен дать исключение")
		.НеРавно("");
	ЮТест.ОжидаетЧто(СтрНайти(ТекстИсключения, "Исключения не было"), "Исключение должно было быть. Текст: " + ТекстИсключения)
		.Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстИсключения, ПодстрокаНеопределеннойПеременной("СМП_ВыпискаБанка")), "Имя модуля продукта разрешилось. Текст: " + ТекстИсключения)
		.Равно(0);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ПодстрокаНеопределеннойПеременной(ИмяМодуля)

	Возврат "Переменная не определена (" + ИмяМодуля + ")";

КонецФункции

// Текст исключения вызова через помощник; если исключения не было - так и пишет.
Функция ТекстВызова(ИмяМетода, Параметры = Неопределено)

	ТекстИсключения = "";

	Попытка
		Значение = СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);
		ТекстИсключения = "Исключения не было, возвращено: " + Строка(Значение);
	Исключение
		ТекстИсключения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат ТекстИсключения;

КонецФункции

#КонецОбласти
