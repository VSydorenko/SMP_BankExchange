#Область ОхранаТранзакции

// Тест умеет падать: красный, если охрану в построителе убрать, и красный именно на ИМЕНИ этой функции:
// в тексте исключения требуется "СМП_ТестыДанныеУНФ.<ИмяФункции>: вызов вне транзакции", а не общий
// подстрок (документные функции вызывают НоваяУслуга со своей охраной, общий подстрок прошел бы).
// Работает БЕЗ транзакции (тест не помечен), поэтому каждый вызов получает заведомо неверный по типу
// аргумент: функция БЕЗ охраны упала бы на проверке типа, которая стоит сразу за охраной и ДО любой
// записи (см. НеверныйТипПараметраОтклоняетсяДоЗаписи), - в общей базе от такого вызова ничего не остается.
Процедура ПостроительОтказываетсяРаботатьВнеТранзакции(ИмяФункции) Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется вне транзакции")
		.ЭтоЛожь();

	ТекстОшибки = Неопределено;
	Попытка
		ВызватьФункциюПостроителя(ИмяФункции);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": вызов вне транзакции дал исключение (охраны нет)")
		.НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": в исключении названа эта функция и причина")
		.Содержит("СМП_ТестыДанныеУНФ." + ИмяФункции + ": вызов вне транзакции");

КонецПроцедуры

// Пара к охране: внутри транзакции неверный тип аргумента отклоняется ДО записи. Именно это делает
// безопасным вызов тестом охраны без транзакции. Текст отказа не должен содержать слов охраны,
// иначе тест охраны не отличил бы охрану от проверки типа. Подсчет объектов фикстуры до и после
// вызова совпадает: ничего не записано.
Процедура НеверныйТипПараметраОтклоняетсяДоЗаписи(ИмяФункции) Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется в своей транзакции")
		.ЭтоИстина();
	До = СуммаПодсчета();

	ТекстОшибки = Неопределено;
	Попытка
		ВызватьФункциюПостроителя(ИмяФункции);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": неверный тип параметра дал исключение")
		.НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": в исключении названа эта функция и неверный тип")
		.Содержит("СМП_ТестыДанныеУНФ." + ИмяФункции + ": неверный тип параметра");
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": отказ по типу, а не по транзакции")
		.НеСодержит("вне транзакции");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), ИмяФункции + ": объектов фикстуры не прибавилось")
		.Равно(До);

КонецПроцедуры

Функция СуммаПодсчета()

	Итого = 0;
	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		Итого = Итого + Элемент.Значение;
	КонецЦикла;

	Возврат Итого;

КонецФункции

Процедура ВызватьФункциюПостроителя(ИмяФункции)

	Если ИмяФункции = "НовыйКонтрагент" Тогда
		СМП_ТестыДанныеУНФ.НовыйКонтрагент(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйДоговор" Тогда
		СМП_ТестыДанныеУНФ.НовыйДоговор(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйБанковскийСчетКонтрагента" Тогда
		СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйЗаказПокупателя" Тогда
		СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплату" Тогда
		СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйЗаказПоставщику" Тогда
		СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплатуПоставщика" Тогда
		СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйАктВыполненныхРабот" Тогда
		СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяОплата" Тогда
		СМП_ТестыДанныеУНФ.НоваяОплата(Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяУслуга" Тогда
		СМП_ТестыДанныеУНФ.НоваяУслуга("не структура");
	Иначе
		ВызватьИсключение "Тест не знает функцию построителя: " + ИмяФункции;
	КонецЕсли;

КонецПроцедуры

