		ПодрВторого, ВТабличной, ВШапке, ВТабличной);
	Для Каждого Кто Из Получить Цикл
		Для Каждого Имя Из Имена Цикл
			Значение = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Кто.Значение, Имя.Ключ);
			ЮТест.ОжидаетЧто(Значение, Кто.Ключ + ": настройка " + Имя.Ключ).Равно(Ожидаемое[Кто.Ключ][Имя.Ключ]);
		КонецЦикла;
