	Настройки = Новый Структура("СпособРазнесенияОплатыПоУмолчанию", Способ);

	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент, Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "НовыйДоговор вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Договор, "СпособРазнесенияОплатыПоУмолчанию");
	ЮТест.ОжидаетЧто(Реквизиты.СпособРазнесенияОплатыПоУмолчанию, "Способ разнесения оплаты из параметров")
		.Равно(Способ);

