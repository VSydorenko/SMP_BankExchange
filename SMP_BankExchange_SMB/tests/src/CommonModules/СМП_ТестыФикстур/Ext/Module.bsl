// Состояния сотрудника читаются из регистра ТекущиеКадровыеДанныеСотрудников так же, как их читает продукт: "работает" -
// дата приема есть, увольнения нет; "уволен" - есть обе; "не принят" - записи нет.
Процедура СотрудникСоСостоянием(Описание, Состояние, ЕстьПрием, ЕстьУвольнение) Экспорт

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();
	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудник(ФизЛицо, Новый Структура("Состояние", Состояние));

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Сотрудник), Описание + ": НовыйСотрудник вернул заполненную ссылку (не создан)").ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Сотрудник, "Физлицо, Наименование, Недействителен, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.Физлицо, Описание + ": физлицо сотрудника").Равно(ФизЛицо);
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()), Описание + ": наименование с префиксом").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Недействителен Или Реквизиты.ПометкаУдаления, Описание + ": по умолчанию сотрудник действителен и не помечен").ЭтоЛожь();

	Кадровые = КадровыеДанные(Сотрудник);
	Если Не ЕстьПрием Тогда
		ЮТест.ОжидаетЧто(Кадровые, Описание + ": записи в регистре нет").Равно(Неопределено);
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Кадровые <> Неопределено, Описание + ": запись в регистре есть").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Кадровые.ДатаПриема), Описание + ": дата приема заполнена").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Кадровые.ДатаУвольнения), Описание + ": дата увольнения").Равно(ЕстьУвольнение);

КонецПроцедуры

Процедура СотрудникПоУмолчаниюРаботаетВОрганизацииПоПравилу() Экспорт

	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудник(СМП_ТестыДанныеУНФ.НовоеФизЛицо());

	Кадровые = КадровыеДанные(Сотрудник);
	ЮТест.ОжидаетЧто(Кадровые <> Неопределено, "Без настроек сотрудник действующий: запись в регистре есть").ЭтоИстина();
	ЮТест.ОжидаетЧто(Кадровые.Организация, "Организация - компания организации по правилу выбора (как пишет вендор)")
		.Равно(Константы.УчетПоКомпании.Компания(СМП_ТестыДанныеУНФ.Организация()));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Кадровые.ДатаУвольнения), "Без настроек увольнения нет").ЭтоЛожь();

КонецПроцедуры

Процедура СотрудникПринимаетОрганизациюИПризнаки() Экспорт

	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();

	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудник(ФизЛицо, Новый Структура("Организация, Недействителен", Другая, Истина));
	Помеченный = СМП_ТестыДанныеУНФ.НовыйСотрудник(ФизЛицо, Новый Структура("ПометкаУдаления", Истина));

	ЮТест.ОжидаетЧто(КадровыеДанные(Сотрудник).Организация, "Организация из настройки").Равно(Другая);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Сотрудник, "Недействителен").Недействителен, "Настройка Недействителен применена").ЭтоИстина();
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Помеченный, "ПометкаУдаления").ПометкаУдаления, "Настройка ПометкаУдаления применена").ЭтоИстина();

КонецПроцедуры

Процедура СотрудникОтклоняетЛишнийКлючИНеверныйТип(Описание, Ключ, Значение, ОжидаемыйФрагмент) Экспорт

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();

	ПроверитьОтказДоЗаписи(Описание, "НовыйСотрудник", ОжидаемыйФрагмент,
		Новый Структура("ФизЛицо, Настройки", ФизЛицо, Новый Структура(Ключ, Значение)));

КонецПроцедуры

Процедура СчетФизЛицаСоздаетсяИПринимаетНастройки() Экспорт

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();
	Устаревший = СМП_ТестыДанныеУНФ.НовыйIBAN();

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(ФизЛицо, Новый Структура("НомерСчетаУстаревший", Устаревший));
	Без = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(ФизЛицо);
	Особый = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(ФизЛицо, Новый Структура("ПометкаУдаления, Недействителен", Истина, Истина));

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Счет), "НовыйБанковскийСчетФизЛица вернул заполненную ссылку (не создан)").ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Счет, "Владелец, НомерСчета, НомерСчетаУстаревший, Наименование, ПометкаУдаления, Недействителен");
	ЮТест.ОжидаетЧто(Реквизиты.Владелец, "Владелец счета - физлицо").Равно(ФизЛицо);
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Реквизиты.НомерСчета), "Номер - IBAN с правильной контрольной суммой").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.НомерСчетаУстаревший, "Устаревший номер из настроек").Равно(Устаревший);
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()), "Наименование с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления Или Реквизиты.Недействителен, "Без настроек счет живой").ЭтоЛожь();
	Реквизиты = РеквизитыСсылки(Особый, "ПометкаУдаления, Недействителен");
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Настройка ПометкаУдаления применена").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Недействителен, "Настройка Недействителен применена").ЭтоИстина();
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Без, "НомерСчетаУстаревший").НомерСчетаУстаревший, "Без настройки устаревшего номера нет").Равно("");

КонецПроцедуры

Процедура СчетФизЛицаОтклоняетЛишнийКлючИНеверныйТип(Описание, Ключ, Значение, ОжидаемыйФрагмент) Экспорт

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();

	ПроверитьОтказДоЗаписи(Описание, "НовыйБанковскийСчетФизЛица", ОжидаемыйФрагмент,
		Новый Структура("ФизЛицо, Настройки", ФизЛицо, Новый Структура(Ключ, Значение)));

КонецПроцедуры

// Конфликт для задачи 9: счет операции - ДРУГОЙ счет организации выписки, текст содержит фразу правила, которое дало бы
// другой вид. Тест фикстуры доказывает оба признака в самой операции: она узнаваема как "свой счет" (владелец -
// организация, счет не равен счету выписки) и как "правило" (правило есть, фраза в тексте, вид правила - не перевод).
Процедура КонфликтСвойСчетИПравилоСоздаетсяСОбоимиПризнаками(Описание, ВидДокумента, ПолеВида, ИмяВидаПравила) Экспорт

	Конфликт = СМП_ТестыДанныеУНФ.НовыйКонфликтСвойСчетИПравило(ВидДокумента);

	Счет = РеквизитыСсылки(Конфликт.СвойСчет, "Владелец, НомерСчета");
	ЮТест.ОжидаетЧто(Счет.Владелец, Описание + ": счет принадлежит организации выписки").Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(Конфликт.СвойСчет, Описание + ": это не счет самой выписки").НеРавно(СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации());
	ЮТест.ОжидаетЧто(Конфликт.Операция.КонтрагентНомерСчета, Описание + ": номер счета операции - номер нашего счета").Равно(Счет.НомерСчета);
	ЮТест.ОжидаетЧто(СтрНайти(Конфликт.Операция.НазначениеПлатежа, Конфликт.Фраза) > 0, Описание + ": текст содержит фразу правила").ЭтоИстина();
	Правило = РеквизитыСсылки(Конфликт.Правило, ПолеВида + ", ФразаДляПоискаВНазначенииПлатежа");
	ЮТест.ОжидаетЧто(Правило.ФразаДляПоискаВНазначенииПлатежа, Описание + ": фраза правила").Равно(Конфликт.Фраза);
	ЮТест.ОжидаетЧто(Правило[ПолеВида], Описание + ": вид правила - не перевод между счетами")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + ВидДокумента + "." + ИмяВидаПравила));
	Направление = СМП_ТестыВызовПродукта.Вызвать(?(ВидДокумента = "ПоступлениеНаСчет", "СМП_ВыпискаБанка.НаправлениеПоступило", "СМП_ВыпискаБанка.НаправлениеСписано"));
	ЮТест.ОжидаетЧто(Конфликт.Операция.Направление, Описание + ": направление операции").Равно(Направление);

КонецПроцедуры

Процедура КонфликтСвойСчетИПравилоОтклоняетНедопустимыйВид() Экспорт

	ПроверитьОтказДоЗаписи("вид документа вне перечня", "НовыйКонфликтСвойСчетИПравило", "ВидДокумента 'Прочее' недопустим",
		Новый Структура("ВидДокумента", "Прочее"));

КонецПроцедуры

// Сторож видит новые типы: функция подсчета (она же у ДанныхТестовНеОсталось) считает организацию, физлицо, сотрудника и
// запись кадровых данных. Красный с названием типа, если тип убрать из функции подсчета.
Процедура СторожВидитОрганизациюФизЛицоСотрудникаИКадровыеДанные() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	СМП_ТестыДанныеУНФ.НоваяОрганизация();
	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();
	СМП_ТестыДанныеУНФ.НовыйСотрудник(ФизЛицо);

	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	Для Каждого Тип Из СтрРазделить("Справочник.Организации,Справочник.ФизическиеЛица,Справочник.Сотрудники,РегистрСведений.ТекущиеКадровыеДанныеСотрудников", ",") Цикл
		Было = ?(До.Получить(Тип) = Неопределено, 0, До.Получить(Тип));
		Стало = ?(После.Получить(Тип) = Неопределено, 0, После.Получить(Тип));
		ЮТест.ОжидаетЧто(Стало, "Сторож видит фикстуру типа " + Тип).Равно(Было + 1);
	КонецЦикла;

КонецПроцедуры

// Сотрудник приемом на работу: кадровые данные пишет вендор, организация в них - Компания(Организация документа), а не сама
// организация (вендор пишет регистры на "компанию"). Ожидание считается функцией вендора, а не константой теста: при режиме
// "без учета по компании" Компания(Организация) = Организация, и тест все равно верен.
Процедура СотрудникПриемомНаРаботу_КадровыеДанныеВОрганизацииКомпании() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу(СМП_ТестыДанныеУНФ.НовоеФизЛицо());

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Сотрудник), "НовыйСотрудникПриемомНаРаботу вернул заполненную ссылку (не создан)").ЭтоИстина();
	Кадровые = КадровыеДанные(Сотрудник);
	ЮТест.ОжидаетЧто(Кадровые <> Неопределено, "Запись в регистре кадровых данных есть").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Кадровые.ДатаПриема), "Дата приема заполнена").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Кадровые.ДатаУвольнения), "Увольнения нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Кадровые.Организация, "Организация кадровых данных - компания организации документа")
		.Равно(Константы.УчетПоКомпании.Компания(Организация));

КонецПроцедуры

// Документ приема проведен, несет префикс фикстуры в комментарии, сотрудник создан на основе физлица.
Процедура СотрудникПриемомНаРаботу_ДокументПроведенИОтклоняетНеверныйТип() Экспорт

	ФизЛицо = СМП_ТестыДанныеУНФ.НовоеФизЛицо();
	Сотрудник = СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу(ФизЛицо);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Проведен КАК Проведен,
		|	Т.Комментарий КАК Комментарий,
		|	Т.Организация КАК Организация
		|ИЗ
		|	Документ.ПриемНаРаботу КАК Т
		|ГДЕ
		|	Т.Ссылка В (ВЫБРАТЬ С.Ссылка ИЗ Документ.ПриемНаРаботу.Сотрудники КАК С ГДЕ С.Сотрудник = &Сотрудник)");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Количество(), "Документ приема на сотрудника один").Равно(1);
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Проведен, "Документ приема проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Выборка.Комментарий, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()), "Комментарий с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(Выборка.Организация, "Организация документа - по правилу выбора").Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Сотрудник, "Физлицо").Физлицо, "Физлицо сотрудника").Равно(ФизЛицо);

	ПроверитьОтказДоЗаписи("организация документа - не организация", "НовыйСотрудникПриемомНаРаботу",
		"неверный тип параметра ОрганизацияДокумента",
		Новый Структура("ФизЛицо, ОрганизацияДокумента", ФизЛицо, 5));

КонецПроцедуры

// Сторож видит типы, которые создает приемом на работу: должность, документ приема, запись регистра "Сотрудники" и
// кадровые данные. Красный с названием типа, если тип убрать из функции подсчета.
Процедура СторожВидитКадровыйДокументИДолжность() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу(СМП_ТестыДанныеУНФ.НовоеФизЛицо());

	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	Типы = "Справочник.Сотрудники,Справочник.Должности,Документ.ПриемНаРаботу,РегистрСведений.Сотрудники,РегистрСведений.ТекущиеКадровыеДанныеСотрудников";
	// Ставки в штатном расписании построитель пишет только при включенной опции "Вести штатное расписание".
	Если Константы.ФункциональнаяОпцияВестиШтатноеРасписание.Получить() Тогда
		Типы = Типы + ",РегистрСведений.ШтатноеРасписание";
	КонецЕсли;
	Для Каждого Тип Из СтрРазделить(Типы, ",") Цикл
		Было = ?(До.Получить(Тип) = Неопределено, 0, До.Получить(Тип));
		Стало = ?(После.Получить(Тип) = Неопределено, 0, После.Получить(Тип));
		ЮТест.ОжидаетЧто(Стало, "Сторож видит фикстуру типа " + Тип).Равно(Было + 1);
	КонецЦикла;

КонецПроцедуры

// Запись регистра ТекущиеКадровыеДанныеСотрудников сотрудника (читается запросом) или Неопределено, если ее нет.
Функция КадровыеДанные(Сотрудник)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Организация КАК Организация,
		|	Т.ДатаПриема КАК ДатаПриема,
		|	Т.ДатаУвольнения КАК ДатаУвольнения
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК Т
		|ГДЕ
		|	Т.Сотрудник = &Сотрудник");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Организация, ДатаПриема, ДатаУвольнения", Выборка.Организация, Выборка.ДатаПриема, Выборка.ДатаУвольнения);

КонецФункции

#КонецОбласти

#Область КонвертИСнимок

// Строка содержит РОВНО колонки Операции конверта (ни одной лишней и ни одной недостающей) и является
// валидной строкой для границы платформы: ПроверитьВыписку принимает ее без замечаний.
Процедура ОперацияКонвертаСодержитВсеКолонкиИПроходитПроверку() Экспорт

	Выписка = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НоваяВыписка");
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура);

	Расхождения = Новый Массив;
	Для Каждого Колонка Из Выписка.Операции.Колонки Цикл
		Если Не Операция.Свойство(Колонка.Имя) Тогда
			Расхождения.Добавить("нет ключа " + Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Операция Цикл
		Если Выписка.Операции.Колонки.Найти(Элемент.Ключ) = Неопределено Тогда
			Расхождения.Добавить("лишний ключ " + Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Ключи строки = колонки Операции конверта").Равно("");

	ЗаполнитьЗначенияСвойств(Выписка.Операции.Добавить(), Операция);
	Аргументы = Новый Массив;
	Аргументы.Добавить(Выписка);
	Аргументы.Добавить(Выписка);
	Результат = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.ПроверитьВыписку", Аргументы);

	ЮТест.ОжидаетЧто(Результат.Принята, "Конверт со строкой фикстуры принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка фикстуры валидна (не отброшена)").Равно(1);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет").ЭтоЛожь();

	Вторая = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура);
	ЮТест.ОжидаетЧто(Вторая.ИдентификаторОперации, "Идентификатор операции уникален между вызовами")
		.НеРавно(Операция.ИдентификаторОперации);

КонецПроцедуры

Процедура ОперацияКонвертаПринимаетПереопределение() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Сумма", 777.77);
	Настройки.Вставить("КонтрагентКод", "0012345");
	Настройки.Вставить("НазначениеПлатежа", "Оплата згідно рахунку");

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки);

	ЮТест.ОжидаетЧто(Операция.Сумма, "Сумма переопределена").Равно(777.77);
	ЮТест.ОжидаетЧто(Операция.КонтрагентКод, "Код с ведущим нулем остался строкой").Равно("0012345");
	ЮТест.ОжидаетЧто(Операция.НазначениеПлатежа, "Назначение платежа переопределено").Равно("Оплата згідно рахунку");
	ЮТест.ОжидаетЧто(Операция.Направление, "Непереопределенное поле осталось по умолчанию - поступление")
		.Равно(СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НаправлениеПоступило"));

КонецПроцедуры

Процедура ОперацияКонвертаОтклоняетЛишнийКлюч() Экспорт

	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("НазначениеПлатежей", "x"));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Ключ с опечаткой дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении названа функция и ключ")
		.Содержит("НоваяОперацияКонверта: неизвестный ключ настроек 'НазначениеПлатежей'");

КонецПроцедуры

// Функция не пишет в базу, поэтому охраны транзакции у нее нет: вызов вне транзакции допустим (пара к охране
// пишущих функций). Неверный тип настроек отклоняется по типу.
Процедура ОперацияКонвертаОтклоняетНеверныйТипНастроекБезОхраныТранзакции() Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется вне транзакции").ЭтоЛожь();
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура);
	ЮТест.ОжидаетЧто(Операция.Свойство("Сумма"), "Вне транзакции строка строится").ЭтоИстина();

	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НоваяОперацияКонверта("не структура");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Неверный тип настроек дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "Отказ по типу параметра")
		.Содержит("СМП_ТестыДанныеУНФ.НоваяОперацияКонверта: неверный тип параметра");
	ЮТест.ОжидаетЧто(ТекстОшибки, "Отказ по типу, а не по транзакции").НеСодержит("вне транзакции");

КонецПроцедуры

// Снимок только читает: работает и вне транзакции (охраны нет), и возвращает все пять видов объектов.
Процедура СнимокКоличествСчитаетсяВнеТранзакции() Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется вне транзакции").ЭтоЛожь();

	Количества = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Ожидаемые = СтрРазделить("Справочник.Контрагенты,Справочник.ДоговорыКонтрагентов,Справочник.БанковскиеСчета,Документ.ПоступлениеНаСчет,Документ.РасходСоСчета", ",");
	ЮТест.ОжидаетЧто(Количества.Количество(), "В снимке ровно пять видов объектов").Равно(Ожидаемые.Количество());
	Для Каждого Ключ Из Ожидаемые Цикл
		Значение = Количества.Получить(Ключ);
		ЮТест.ОжидаетЧто(ТипЗнч(Значение), Ключ + ": количество - число").Равно(Тип("Число"));
	КонецЦикла;

КонецПроцедуры

// Снимок считает объекты КАЖДОГО вида, включая созданные без префикса фикстуры (по счетчику, не по префиксу).
Процедура СнимокКоличествВидитСозданное() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Основа = ОсновнаяФикстура();
	Поставщик = ОсновнаяФикстура("СПоставщиком");
	СчетПокупателю = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, 100);
	СчетПоставщика = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Поставщик.Контрагент, Поставщик.Договор, 100);
	СМП_ТестыДанныеУНФ.НоваяОплата(СчетПокупателю, 40);
	СМП_ТестыДанныеУНФ.НоваяОплата(СчетПоставщика, 40);
	СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Основа.Контрагент);
	СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());

	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты") - До.Получить("Справочник.Контрагенты"), "Контрагентов прибавилось два")
		.Равно(2);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.ДоговорыКонтрагентов") - До.Получить("Справочник.ДоговорыКонтрагентов") >= 2,
		"Договоров прибавилось не меньше двух").ЭтоИстина();
	ЮТест.ОжидаетЧто(После.Получить("Справочник.БанковскиеСчета") - До.Получить("Справочник.БанковскиеСчета"), "Банковских счетов прибавилось два")
		.Равно(2);
	ЮТест.ОжидаетЧто(После.Получить("Документ.ПоступлениеНаСчет") - До.Получить("Документ.ПоступлениеНаСчет"), "ПоступлениеНаСчет прибавилось одно")
		.Равно(1);
	ЮТест.ОжидаетЧто(После.Получить("Документ.РасходСоСчета") - До.Получить("Документ.РасходСоСчета"), "РасходСоСчета прибавилось одно")
		.Равно(1);

КонецПроцедуры

