// Тесты построителя тестовых данных СМП_ТестыДанныеУНФ и сторож остатков фикстур.
//
// Правила — docs/architecture/testing.md. Каждый тест с данными в базе работает в СВОЕЙ транзакции
// (.ВТранзакции() на тесте, не на наборе) и сам создает свою фикстуру. База агента общая:
// константы и существующие данные только читаются.
//
// Порядок значим: ДанныхТестовНеОсталось - ПОСЛЕДНИМ и БЕЗ транзакции (итог всех тестов с данными).
// Красный ДанныхТестовНеОсталось - СТОП: остатки руками не удалять, сообщить владельцу.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Данные из базы по правилу")
			.ДобавитьСерверныйТест("ОрганизацияПоПравилу").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетОрганизацииВНациональнойВалюте").ВТранзакции()
			.ДобавитьСерверныйТест("ОрганизацияНеНайденаОтказываетИсключениемСПричиной")
		.ДобавитьТестовыйНабор("Справочники фикстуры")
			.ДобавитьСерверныйТест("КонтрагентЗаписываетсяСФлагами").ВТранзакции()
				.СПараметрами("все признаки учета", Истина, Истина, Истина, Истина)
				.СПараметрами("только договоры", Истина, Ложь, Ложь, Ложь)
			.ДобавитьСерверныйТест("ДоговорЗаписываетсяСВидом").ВТранзакции()
				.СПараметрами("с покупателем", "СПокупателем")
				.СПараметрами("с поставщиком", "СПоставщиком")
			.ДобавитьСерверныйТест("ДоговорПринимаетСпособРазноса").ВТранзакции()
			.ДобавитьСерверныйТест("ДоговорСтановитсяОсновнымПоПрочитаннымКодам").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетКонтрагентаСоздается").ВТранзакции()
			.ДобавитьСерверныйТест("УслугаСоздается").ВТранзакции()
			.ДобавитьСерверныйТест("ПодразделениеСоздаетсяТипаПодразделение").ВТранзакции()
			.ДобавитьСерверныйТест("ПользовательСоздаетсяБезПользователяИБ").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкиПользователяЧитаютсяШтатнымМетодомПоПользователю").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкиПользователяОтклоняютЛишнийКлюч").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкиПользователяСеансаНеПишутся").ВТранзакции()
			.ДобавитьСерверныйТест("ДоговорПринимаетСпособЗаполненияСтавкиНДС").ВТранзакции()
			.ДобавитьСерверныйТест("ПроектПринимаетДоговор").ВТранзакции()
			.ДобавитьСерверныйТест("ПравилоНазначенияСоздаетсяИЗаписывается").ВТранзакции()
			// Пара к предыдущему (допустимый ключ - вид операции): ключ с опечаткой отклоняется до записи.
			.ДобавитьСерверныйТест("ПравилоНазначенияОтклоняетЛишнийКлюч").ВТранзакции()
			// План 02, задача 7: фраза дословно (пустая, из пробелов), код и пометка удаления правила, проект.
			// Пара: без ФразаДословно фраза всегда с префиксом фикстуры и уникальна.
			.ДобавитьСерверныйТест("ПравилоНазначенияФразаДословно").ВТранзакции()
				.СПараметрами("пустая", "")
				.СПараметрами("из пробелов", "   ")
				.СПараметрами("обычная без префикса", "Повернення")
			.ДобавитьСерверныйТест("ПравилоНазначенияФразаПоУмолчаниюСПрефиксомИУникальна").ВТранзакции()
			.ДобавитьСерверныйТест("ПравилоНазначенияПринимаетКодИПометкуУдаления").ВТранзакции()
			.ДобавитьСерверныйТест("ПравилоНазначенияОтклоняетФразуИФразуДословно").ВТранзакции()
				.СПараметрами("оба ключа", Новый Структура("Фраза, ФразаДословно", "а", "б"), "ключи 'Фраза' и 'ФразаДословно' взаимоисключающие")
				.СПараметрами("ФразаДословно - не строка", Новый Структура("ФразаДословно", 5), "неверный тип параметра Настройки.ФразаДословно")
			.ДобавитьСерверныйТест("ПроектСоздается").ВТранзакции()
			.ДобавитьСерверныйТест("ПроектОтклоняетНеструктуру").ВТранзакции()
			.ДобавитьСерверныйТест("ГруппаДоступаКонтрагентовСоздаетсяИОтклоняетНеверное").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетОрганизацииСоздаетсяИПринимаетНастройки").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетОрганизацииОтклоняетЛишнийКлюч").ВТранзакции()
		// Расширения построителя под распознавание контрагента (план 02, задача 4): код, пометка удаления,
		// основной договор, договор по умолчанию, настройки счета контрагента. Пары: без настройки - значение
		// по умолчанию; ключ с опечаткой и неверный тип - отказ до записи.
		.ДобавитьТестовыйНабор("Расширения построителя: контрагент, договор, счет контрагента")
			.ДобавитьСерверныйТест("КонтрагентПринимаетКод").ВТранзакции()
			.ДобавитьСерверныйТест("КонтрагентБезНастроекКодаИПометкиИмеетСвойКодИНеПомечен").ВТранзакции()
			.ДобавитьСерверныйТест("КонтрагентПринимаетПометкуУдаления").ВТранзакции()
			.ДобавитьСерверныйТест("КонтрагентОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "КодПоЕДРПОУУ", "1", "неизвестный ключ настроек 'КодПоЕДРПОУУ'")
				.СПараметрами("код - не строка", "КодПоЕДРПОУ", 12345678, "неверный тип параметра Настройки.КодПоЕДРПОУ")
				.СПараметрами("пометка - не булево", "ПометкаУдаления", "да", "неверный тип параметра Настройки.ПометкаУдаления")
				.СПараметрами("вид контрагента - не вид", "ВидКонтрагента", 5, "неверный тип параметра Настройки.ВидКонтрагента")
				.СПараметрами("ИНН - не строка", "ИНН", 1234567890, "неверный тип параметра Настройки.ИНН")
				.СПараметрами("БезЗаполнения - не булево", "БезЗаполнения", "да", "неверный тип параметра Настройки.БезЗаполнения")
				.СПараметрами("Покупатель - не булево", "Покупатель", "да", "неверный тип параметра Настройки.Покупатель")
				.СПараметрами("ПрочиеОтношения - не булево", "ПрочиеОтношения", "да", "неверный тип параметра Настройки.ПрочиеОтношения")
				.СПараметрами("валюта - не валюта", "ВалютаРасчетовПоУмолчанию", 5, "неверный тип параметра Настройки.ВалютаРасчетовПоУмолчанию")
			.ДобавитьСерверныйТест("ДоговорБезОсновногоНеПопадаетВРегистрОсновных").ВТранзакции()
			.ДобавитьСерверныйТест("ДоговорОсновнойПопадаетВРегистрОсновных").ВТранзакции()
			.ДобавитьСерверныйТест("ДоговорПринимаетПометкуУдаленияИНедействителен").ВТранзакции()
			.ДобавитьСерверныйТест("ДоговорОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "Основнои", Истина, "неизвестный ключ настроек 'Основнои'")
				.СПараметрами("основной - не булево", "Основной", "да", "неверный тип параметра Настройки.Основной")
				.СПараметрами("вид - не вид договора", "ВидДоговора", 5, "неверный тип параметра Настройки.ВидДоговора")
			.ДобавитьСерверныйТест("ДоговорПоУмолчаниюНовогоКонтрагентаОсновной").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкаДоговораПоУмолчаниюСнимаетОсновной").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкаДоговораПоУмолчаниюСтавитПометкуУдаления").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкаДоговораПоУмолчаниюМеняетОрганизациюИОставляетОсновным").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкаДоговораПоУмолчаниюМеняетВидИОставляетОсновным").ВТранзакции()
			.ДобавитьСерверныйТест("НастройкаДоговораПоУмолчаниюОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("вид - не вид договора", "ВидДоговора", 5, "неверный тип параметра Настройки.ВидДоговора")
				.СПараметрами("опечатка в ключе", "Организаця", "1", "неизвестный ключ настроек 'Организаця'")
				.СПараметрами("организация - не организация", "Организация", 5, "неверный тип параметра Настройки.Организация")
				.СПараметрами("основной - не булево", "Основной", "да", "неверный тип параметра Настройки.Основной")
			.ДобавитьСерверныйТест("БанковскийСчетКонтрагентаПринимаетНастройки").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетКонтрагентаБезНастроекЖивойСНовымНомером").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетКонтрагентаОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "НомерСчетаУстарел", "1", "неизвестный ключ настроек 'НомерСчетаУстарел'")
				.СПараметрами("номер - не строка", "НомерСчета", 5, "неверный тип параметра Настройки.НомерСчета")
				.СПараметрами("пометка - не булево", "ПометкаУдаления", "да", "неверный тип параметра Настройки.ПометкаУдаления")
			.ДобавитьСерверныйТест("ДругаяОрганизацияНеТаЖеИНеПомечена").ВТранзакции()
		// Фикстуры шагов 1-2 (план 02, задача 5): организация фикстуры, физлицо, сотрудник, счет физлица, конфликт
		// "свой счет против правила". Пары: без настройки - значение по умолчанию; ключ с опечаткой и неверный тип - отказ.
		.ДобавитьТестовыйНабор("Фикстуры шагов 1-2: организация, физлицо, сотрудник")
			.ДобавитьСерверныйТест("ОрганизацияФикстурыСоздаетсяСПрефиксомИБезИнтеркампани").ВТранзакции()
			.ДобавитьСерверныйТест("ОрганизацияФикстурыПринимаетКонтрагентаИнтеркампани").ВТранзакции()
			.ДобавитьСерверныйТест("ОрганизацияФикстурыОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "КонтрагентИнтеркампаний", "1", "неизвестный ключ настроек 'КонтрагентИнтеркампаний'")
				.СПараметрами("интеркампани - не контрагент", "КонтрагентИнтеркампани", 5, "неверный тип параметра Настройки.КонтрагентИнтеркампани")
			.ДобавитьСерверныйТест("ФизЛицоСоздаетсяСПрефиксом").ВТранзакции()
			.ДобавитьСерверныйТест("ФизЛицоОтклоняетЛюбойКлюч").ВТранзакции()
			.ДобавитьСерверныйТест("СотрудникСоСостоянием").ВТранзакции()
				.СПараметрами("работает: прием есть, увольнения нет", "Работает", Истина, Ложь)
				.СПараметрами("уволен: есть и прием, и увольнение", "Уволен", Истина, Истина)
				.СПараметрами("не принят: записи в регистре нет", "НеПринят", Ложь, Ложь)
			.ДобавитьСерверныйТест("СотрудникПоУмолчаниюРаботаетВОрганизацииПоПравилу").ВТранзакции()
			.ДобавитьСерверныйТест("СотрудникПринимаетОрганизациюИПризнаки").ВТранзакции()
			.ДобавитьСерверныйТест("СотрудникОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "Состояни", "Работает", "неизвестный ключ настроек 'Состояни'")
				.СПараметрами("состояние - не строка", "Состояние", 5, "неверный тип параметра Настройки.Состояние")
				.СПараметрами("состояние вне перечня", "Состояние", "Отпуск", "Состояние 'Отпуск' недопустимо")
				.СПараметрами("организация - не организация", "Организация", 5, "неверный тип параметра Настройки.Организация")
			.ДобавитьСерверныйТест("СчетФизЛицаСоздаетсяИПринимаетНастройки").ВТранзакции()
			.ДобавитьСерверныйТест("СчетФизЛицаОтклоняетЛишнийКлючИНеверныйТип").ВТранзакции()
				.СПараметрами("опечатка в ключе", "НомерСчетаУстарел", "1", "неизвестный ключ настроек 'НомерСчетаУстарел'")
				.СПараметрами("номер - не строка", "НомерСчета", 5, "неверный тип параметра Настройки.НомерСчета")
			.ДобавитьСерверныйТест("КонфликтСвойСчетИПравилоСоздаетсяСОбоимиПризнаками").ВТранзакции()
				.СПараметрами("поступление", "ПоступлениеНаСчет", "ВидОперацииПоступленияНаСчет", "ОтПокупателя")
				.СПараметрами("списание", "РасходСоСчета", "ВидОперацииРасходаСоСчета", "Поставщику")
			.ДобавитьСерверныйТест("КонфликтСвойСчетИПравилоОтклоняетНедопустимыйВид").ВТранзакции()
			.ДобавитьСерверныйТест("СторожВидитОрганизациюФизЛицоСотрудникаИКадровыеДанные").ВТранзакции()
			// Сотрудник настоящим кадровым путем (проведение вендорского ПриемНаРаботу).
			.ДобавитьСерверныйТест("СотрудникПриемомНаРаботу_КадровыеДанныеВОрганизацииКомпании").ВТранзакции()
			.ДобавитьСерверныйТест("СотрудникПриемомНаРаботу_ДокументПроведенИОтклоняетНеверныйТип").ВТранзакции()
			.ДобавитьСерверныйТест("СторожВидитКадровыйДокументИДолжность").ВТранзакции()
		// Строка конверта и снимок количеств: ничего не пишут (первая) или только читают (второй), поэтому
		// охраны транзакции у них нет, и это доказывают тесты БЕЗ транзакции.
		.ДобавитьТестовыйНабор("Конверт операций и снимок количеств")
			.ДобавитьСерверныйТест("ОперацияКонвертаСодержитВсеКолонкиИПроходитПроверку")
			.ДобавитьСерверныйТест("ОперацияКонвертаПринимаетПереопределение")
			.ДобавитьСерверныйТест("ОперацияКонвертаОтклоняетЛишнийКлюч")
			.ДобавитьСерверныйТест("ОперацияКонвертаОтклоняетНеверныйТипНастроекБезОхраныТранзакции")
			.ДобавитьСерверныйТест("СнимокКоличествСчитаетсяВнеТранзакции")
			.ДобавитьСерверныйТест("СнимокКоличествВидитСозданное").ВТранзакции()
		.ДобавитьТестовыйНабор("Документы фикстуры")
			.ДобавитьСерверныйТест("ЗаказПокупателяПроводится").ВТранзакции()
