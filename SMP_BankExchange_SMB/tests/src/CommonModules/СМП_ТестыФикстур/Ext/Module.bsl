// Тесты построителя тестовых данных СМП_ТестыДанныеУНФ и сторож остатков фикстур.
//
// Правила — docs/architecture/testing.md. Каждый тест с данными в базе работает в СВОЕЙ транзакции
// (.ВТранзакции() на тесте, не на наборе) и сам создает свою фикстуру. База агента общая:
// константы и существующие данные только читаются.
//
// Порядок значим: ДанныхТестовНеОсталось - ПОСЛЕДНИМ и БЕЗ транзакции (итог всех тестов с данными).
// Красный ДанныхТестовНеОсталось - СТОП: остатки руками не удалять, сообщить владельцу.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Данные из базы по правилу")
			.ДобавитьСерверныйТест("ОрганизацияПоПравилу").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетОрганизацииВНациональнойВалюте").ВТранзакции()
		.ДобавитьТестовыйНабор("Справочники фикстуры")
			.ДобавитьСерверныйТест("КонтрагентЗаписываетсяСФлагами").ВТранзакции()
				.СПараметрами("все признаки учета", Истина, Истина, Истина, Истина)
				.СПараметрами("только договоры", Истина, Ложь, Ложь, Ложь)
			.ДобавитьСерверныйТест("ДоговорЗаписываетсяСВидом").ВТранзакции()
				.СПараметрами("с покупателем", "СПокупателем")
				.СПараметрами("с поставщиком", "СПоставщиком")
			.ДобавитьСерверныйТест("ДоговорПринимаетСпособРазноса").ВТранзакции()
			.ДобавитьСерверныйТест("БанковскийСчетКонтрагентаСоздается").ВТранзакции()
			.ДобавитьСерверныйТест("УслугаСоздается").ВТранзакции()
		.ДобавитьТестовыйНабор("Документы фикстуры")
			.ДобавитьСерверныйТест("ЗаказПокупателяПроводится").ВТранзакции()
			.ДобавитьСерверныйТест("СчетНаОплатуПроводится").ВТранзакции()
			.ДобавитьСерверныйТест("ЗаказПоставщикуПроводится").ВТранзакции()
			.ДобавитьСерверныйТест("СчетНаОплатуПоставщикаПроводится").ВТранзакции()
			.ДобавитьСерверныйТест("АктВыполненныхРаботПроводитсяИДаетДолг").ВТранзакции()
			.ДобавитьСерверныйТест("ДокументБезПроведенияОстаетсяНепроведенным").ВТранзакции()
			.ДобавитьСерверныйТест("ОплатаПокупателяПроводитсяИОплачиваетЧасть").ВТранзакции()
			.ДобавитьСерверныйТест("ОплатаПоставщикуПроводитсяИОплачиваетЧасть").ВТранзакции()
		.ДобавитьТестовыйНабор("Охрана транзакции")
			// БЕЗ транзакции: проверяется отказ работать вне ее.
			.ДобавитьСерверныйТест("ПостроительОтказываетсяРаботатьВнеТранзакции")
				.СПараметрами("НовыйКонтрагент")
				.СПараметрами("НовыйДоговор")
				.СПараметрами("НовыйБанковскийСчетКонтрагента")
				.СПараметрами("НовыйЗаказПокупателя")
				.СПараметрами("НовыйСчетНаОплату")
				.СПараметрами("НовыйЗаказПоставщику")
				.СПараметрами("НовыйСчетНаОплатуПоставщика")
				.СПараметрами("НовыйАктВыполненныхРабот")
				.СПараметрами("НоваяОплата")
				.СПараметрами("НоваяУслуга")
			// Пара к предыдущему: ВНУТРИ транзакции тот же вызов с неверным аргументом отклоняется по типу
			// (другой текст, без слов "вне транзакции") и ничего не пишет.
			.ДобавитьСерверныйТест("НеверныйТипПараметраОтклоняетсяДоЗаписи").ВТранзакции()
				.СПараметрами("НовыйКонтрагент")
				.СПараметрами("НовыйДоговор")
				.СПараметрами("НовыйБанковскийСчетКонтрагента")
				.СПараметрами("НовыйЗаказПокупателя")
				.СПараметрами("НовыйСчетНаОплату")
				.СПараметрами("НовыйЗаказПоставщику")
				.СПараметрами("НовыйСчетНаОплатуПоставщика")
				.СПараметрами("НовыйАктВыполненныхРабот")
				.СПараметрами("НоваяОплата")
				.СПараметрами("НоваяУслуга")
		.ДобавитьТестовыйНабор("Контрольные суммы")
			.ДобавитьСерверныйТест("ЕДРПОУИзВнешнегоРасчетаПроходит")
				.СПараметрами("12345678", "весы 1..7")
				.СПараметрами("31234562", "диапазон 30..60 млн, сдвинутые весы")
				.СПараметрами("40404049", "остаток 10, второй проход весов")
			.ДобавитьСерверныйТест("ИспорченныйЕДРПОУНеПроходит")
				.СПараметрами("12345678")
				.СПараметрами("31234562")
				.СПараметрами("40404049")
			.ДобавитьСерверныйТест("IBANИзВнешнегоРасчетаПроходит")
			.ДобавитьСерверныйТест("ИспорченныйIBANНеПроходит")
			.ДобавитьСерверныйТест("СгенерированныйЕДРПОУПроходитПроверку")
			.ДобавитьСерверныйТест("СгенерированныйIBANПроходитПроверку")
		.ДобавитьТестовыйНабор("Сторож остатков")
			.ДобавитьСерверныйТест("СторожВидитФикстуру").ВТранзакции()
		// ПОСЛЕДНИМ в модуле и БЕЗ транзакции: итог всех тестов с данными.
		.ДобавитьТестовыйНабор("Сторож остатков: итог")
			.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область ДанныеИзБазы

Процедура ОрганизацияПоПравилу() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Организация), "Организация() вернула заполненную ссылку (не создана)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Организация, "ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Организация не помечена на удаление")
		.ЭтоЛожь();

КонецПроцедуры

Процедура БанковскийСчетОрганизацииВНациональнойВалюте() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Счет), "БанковскийСчетОрганизации() вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Счет, "Владелец, ВалютаДенежныхСредств, ПометкаУдаления, Недействителен");
	Национальная = Константы.НациональнаяВалюта.Получить();

	ЮТест.ОжидаетЧто(Реквизиты.Владелец, "Владелец счета - организация фикстуры")
		.Равно(Организация);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаДенежныхСредств, "Валюта счета организации - национальная")
		.Равно(Национальная);
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления Или Реквизиты.Недействителен, "Счет живой")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Справочники

Процедура КонтрагентЗаписываетсяСФлагами(Имя, ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", ПоДоговорам);
	Настройки.Вставить("ВестиРасчетыПоДокументам", ПоДокументам);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", ПоЗаказам);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", ПоСчетам);

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Контрагент), Имя + ": НовыйКонтрагент вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Контрагент,
		"Наименование, КодПоЕДРПОУ, ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам");

	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоДоговорам, Имя + ": признак по договорам из параметров").Равно(ПоДоговорам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоДокументам, Имя + ": признак по документам из параметров").Равно(ПоДокументам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоЗаказам, Имя + ": признак по заказам из параметров").Равно(ПоЗаказам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиУчетОплатыПоСчетам, Имя + ": признак оплаты по счетам из параметров").Равно(ПоСчетам);
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		Имя + ": наименование с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Реквизиты.КодПоЕДРПОУ),
		Имя + ": ЕДРПОУ контрагента с правильной контрольной цифрой").ЭтоИстина();

КонецПроцедуры

Процедура ДоговорЗаписываетсяСВидом(Имя, ИмяВида) Экспорт

	Основа = ОсновнаяФикстура();
	Вид = ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяВида);
	Настройки = Новый Структура("ВидДоговора", Вид);

	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент, Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), Имя + ": НовыйДоговор вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Договор, "Владелец, ВидДоговора, ВалютаРасчетов, Организация, Наименование");
	ЮТест.ОжидаетЧто(Реквизиты.Владелец, Имя + ": владелец договора").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.ВидДоговора, Имя + ": вид договора из параметров").Равно(Вид);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаРасчетов, Имя + ": валюта договора - национальная (счет организации в ней)")
		.Равно(Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(Реквизиты.Организация, Имя + ": организация договора - по правилу")
		.Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		Имя + ": наименование с префиксом фикстуры").ЭтоИстина();

КонецПроцедуры

Процедура ДоговорПринимаетСпособРазноса() Экспорт

