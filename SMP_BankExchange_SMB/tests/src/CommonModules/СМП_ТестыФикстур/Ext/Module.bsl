// Акт выполненных работ - источник долга покупателя для задачи 5. Помимо проведения доказывается, что проведенный
// акт действительно оставил долг контрагента в РасчетыСПокупателями (иначе измерение способа зачета "Авто" вакуумно).
// Приходная накладная поставщика проводится и оставляет ДОЛГ перед поставщиком в РасчетыСПоставщиками (тип "Долг", остаток по
// документу положительный); аванса по ней нет. Источник долга для шага 5 распознавания (документ расчетов поставщика).
// Правило даты акта проверяется на заданных моментах суток, а не на часе прогона: иначе "момент - час" выходил бы за
// границу суток только у теста, идущего в первый час суток, и в остальное время был бы зеленым случайно.
Процедура ДатаАктаНеВыходитЗаСуткиМоментаФикстуры(Описание, СекундОтНачалаСуток) Экспорт

	НачалоСуток = '20260115000000';
	Момент = НачалоСуток + СекундОтНачалаСуток;

	ДатаАкта = СМП_ТестыДанныеУНФ.ДатаАктаДляМоментаФикстуры(Момент);

	ЮТест.ОжидаетЧто(ДатаАкта >= НачалоСуток, Описание + ": акт не раньше начала суток момента (дата договора)").ЭтоИстина();
	ЮТест.ОжидаетЧто(ДатаАкта <= Момент, Описание + ": акт не позже момента фикстуры (даты платежа)").ЭтоИстина();
	ЮТест.ОжидаетЧто(НачалоДня(ДатаАкта), Описание + ": акт в тех же сутках, что момент").Равно(НачалоСуток);
	// Где час назад помещается в сутки - акт ровно на час раньше; иначе - начало суток. Без этой пары
	// "всегда начало суток" и "всегда момент" проходили бы оба предыдущих утверждения.
	Ожидаемая = ?(СекундОтНачалаСуток >= 3600, Момент - 3600, НачалоСуток);
	ЮТест.ОжидаетЧто(ДатаАкта, Описание + ": дата акта").Равно(Ожидаемая);

КонецПроцедуры

// Инвариант на том, что реально строит построитель и что читается из базы: дата договора <= дата документа-основы <=
// дата платежа, все в одних сутках. Идущий через полночь прогон дал бы красный по суткам - сам тест занимает секунды.
Процедура ДатыДоговораОснованийИПлатежаСогласованы() Экспорт

	Основа = ОсновнаяФикстура();
	Акт = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 1300);
	Счет = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, 1000);
	Заказ = СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Основа.Контрагент, Основа.Договор, 900);
	Оплата = СМП_ТестыДанныеУНФ.НоваяОплата(Счет, 400);

	ДатаДоговора = РеквизитыСсылки(Основа.Договор, "ДатаДоговора").ДатаДоговора;
	ДатаПлатежа = РеквизитыСсылки(Оплата, "Дата").Дата;
	Основания = Новый Структура("Акт, Счет, Заказ", Акт, Счет, Заказ);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(ДатаДоговора), "Дата договора заполнена").ЭтоИстина();
	Для Каждого Основание Из Основания Цикл
		ДатаОсновы = РеквизитыСсылки(Основание.Значение, "Дата").Дата;
		ЮТест.ОжидаетЧто(ДатаДоговора <= ДатаОсновы, Основание.Ключ + ": договор не позже документа-основы").ЭтоИстина();
		ЮТест.ОжидаетЧто(ДатаОсновы <= ДатаПлатежа, Основание.Ключ + ": документ-основа не позже платежа").ЭтоИстина();
		ЮТест.ОжидаетЧто(НачалоДня(ДатаОсновы), Основание.Ключ + ": документ в сутках договора").Равно(НачалоДня(ДатаДоговора));
	КонецЦикла;
	ЮТест.ОжидаетЧто(НачалоДня(ДатаПлатежа), "Платеж в сутках договора").Равно(НачалоДня(ДатаДоговора));

КонецПроцедуры

Процедура ПриходнаяНакладнаяПроводитсяИДаетДолгПоставщику() Экспорт

	Основа = ОсновнаяФикстура("СПоставщиком");
	Документ = СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Основа.Контрагент, Основа.Договор, 1400);
	ПроверитьПроведенныйДокумент(Документ, "Документ.ПриходнаяНакладная", 1400);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг) ТОГДА О.СуммаВалОстаток ИНАЧЕ 0 КОНЕЦ), 0) КАК Долг,
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Аванс) ТОГДА О.СуммаВалОстаток ИНАЧЕ 0 КОНЕЦ), 0) КАК Аванс
		|ИЗ РегистрНакопления.РасчетыСПоставщиками.Остатки(, Контрагент = &Контрагент И Документ = &Документ) КАК О");
	Запрос.УстановитьПараметр("Контрагент", Основа.Контрагент);
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Долг, "Накладная оставила долг перед поставщиком в РасчетыСПоставщиками").Равно(1400);
	ЮТест.ОжидаетЧто(Выборка.Аванс, "Аванса по накладной нет").Равно(0);

КонецПроцедуры

Процедура АктВыполненныхРаботПроводитсяИДаетДолг() Экспорт

	Основа = ОсновнаяФикстура();
	Документ = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 1300);
	ПроверитьПроведенныйДокумент(Документ, "Документ.АктВыполненныхРабот", 1300);

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаВал), 0) КАК Сумма
		|ИЗ РегистрНакопления.РасчетыСПокупателями КАК Р
		|ГДЕ Р.Регистратор = &Документ И Р.ТипРасчетов = &Долг И Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Долг", ПредопределенноеЗначение("Перечисление.ТипыРасчетов.Долг"));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЮТест.ОжидаетЧто(Выборка.Сумма, "Акт оставил долг покупателя в РасчетыСПокупателями (приход, тип Долг)").Равно(1300);

КонецПроцедуры

Процедура СчетНаОплатуПоставщикаПроводится() Экспорт

	Основа = ОсновнаяФикстура("СПоставщиком");
	Документ = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Основа.Контрагент, Основа.Договор, 900);
	ПроверитьПроведенныйДокумент(Документ, "Документ.СчетНаОплатуПоставщика", 900);

КонецПроцедуры

// Симметричная пара к тестам проведения: Провести = Ложь дает непроведенный документ.
// Без нее "всегда проводит" и "параметр Провести игнорируется" были бы неразличимы.
Процедура ДокументБезПроведенияОстаетсяНепроведенным() Экспорт

	Основа = ОсновнаяФикстура();
	Документ = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, 500, Ложь);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ), "НовыйСчетНаОплату(Провести = Ложь) вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Документ, "Проведен");
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, "Документ с Провести = Ложь не проведен")
		.ЭтоЛожь();

КонецПроцедуры

Процедура ОплатаПокупателяПроводитсяИОплачиваетЧасть() Экспорт

	Основа = ОсновнаяФикстура();
	Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, 1000);

	Оплата = СМП_ТестыДанныеУНФ.НоваяОплата(Основание, 400);

	ПроверитьПроведенныйДокумент(Оплата, "Документ.ПоступлениеНаСчет", 400);
	Реквизиты = РеквизитыСсылки(Оплата, "Контрагент");
	ЮТест.ОжидаетЧто(Реквизиты.Контрагент, "Контрагент оплаты - контрагент основания").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(400 < РеквизитыСсылки(Основание, "СуммаДокумента").СуммаДокумента, "Оплата меньше суммы основания")
		.ЭтоИстина();

КонецПроцедуры

Процедура ОплатаПоставщикуПроводитсяИОплачиваетЧасть() Экспорт

	Основа = ОсновнаяФикстура("СПоставщиком");
	Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Основа.Контрагент, Основа.Договор, 700);

	Оплата = СМП_ТестыДанныеУНФ.НоваяОплата(Основание, 300);

	ПроверитьПроведенныйДокумент(Оплата, "Документ.РасходСоСчета", 300);
	Реквизиты = РеквизитыСсылки(Оплата, "Контрагент");
	ЮТест.ОжидаетЧто(Реквизиты.Контрагент, "Контрагент оплаты - контрагент основания").Равно(Основа.Контрагент);

КонецПроцедуры

// Номер, дата и организация из Настройки записываются и читаются запросом; документ проведен; организация документа и
// организация регистра взаиморасчетов - заданная (для акта - с долгом покупателя на ЭТУ организацию).
Процедура ДокументСоздаетсяСНомеромДатойОрганизацией(Описание, ИмяФункции, ВидДоговора, ИмяДокумента) Экспорт

	Основа = ОсновнаяФикстура(ВидДоговора);
	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();
	// Договор документа другой организации - этой же организации (документ и договор согласованы).
	Основа.Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент, Новый Структура("ВидДоговора, Организация",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора), Другая));
	Номер = НовыйНомерФикстуры();
	Дата = ДобавитьМесяц(ТекущаяДатаСеанса(), -12);
	Настройки = Новый Структура("Номер, Дата, Организация", Номер, Дата, Другая);

	Документ = СоздатьДокументОснования(ИмяФункции, Основа, 700, Истина, Настройки);

	ПроверитьПроведенныйДокумент(Документ, "Документ." + ИмяДокумента, 700);
	Реквизиты = РеквизитыСсылки(Документ, "Номер, Дата, Организация");
	ЮТест.ОжидаетЧто(Реквизиты.Номер, Описание + ": номер из настройки").Равно(Номер);
	ЮТест.ОжидаетЧто(Реквизиты.Дата, Описание + ": дата из настройки").Равно(Дата);
	ЮТест.ОжидаетЧто(Реквизиты.Организация, Описание + ": организация из настройки").Равно(Другая);
	ЮТест.ОжидаетЧто(Реквизиты.Организация, Описание + ": организация отличается от организации по умолчанию")
		.НеРавно(СМП_ТестыДанныеУНФ.Организация());

	Если ИмяДокумента = "АктВыполненныхРабот" Тогда
		// Измерено: вендор пишет расчеты акта НЕ на организацию документа и не на организацию договора, а на основную компанию
		// базы (организация регистра отличается и от Организации(), и от заданной в настройке). Поэтому долг ищется по
		// регистратору без отбора по организации, а тесты распознавания берут организацию контекста из самого регистра.
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаВал), 0) КАК Сумма
			|ИЗ РегистрНакопления.РасчетыСПокупателями КАК Р
			|ГДЕ Р.Регистратор = &Документ И Р.ТипРасчетов = &Долг И Р.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
		Запрос.УстановитьПараметр("Документ", Документ);
		Запрос.УстановитьПараметр("Долг", ПредопределенноеЗначение("Перечисление.ТипыРасчетов.Долг"));
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ЮТест.ОжидаетЧто(Выборка.Сумма, Описание + ": долг акта записан в регистр взаиморасчетов").Равно(700);
	КонецЕсли;

КонецПроцедуры

// Пара к предыдущему: без Настройки номер присваивает платформа (он отличается от номера, заказанного в паре), а дата и
// организация - по умолчанию фикстуры.
Процедура ДокументБезНастроекПолучаетЗначенияПоУмолчанию(Описание, ИмяФункции, ВидДоговора, ИмяДокумента) Экспорт

	Основа = ОсновнаяФикстура(ВидДоговора);
	// Год ожидания берется из момента, прочитанного ДО создания документа, а не из свежего чтения после него.
	Момент = ТекущаяДатаСеанса();

	Документ = СоздатьДокументОснования(ИмяФункции, Основа, 710, Истина, Неопределено);

	ПроверитьПроведенныйДокумент(Документ, "Документ." + ИмяДокумента, 710);
	Реквизиты = РеквизитыСсылки(Документ, "Номер, Дата, Организация");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.Номер), Описание + ": номер присвоен платформой").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.Организация, Описание + ": организация по умолчанию").Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(НачалоГода(Реквизиты.Дата), Описание + ": дата этого года").Равно(НачалоГода(Момент));

КонецПроцедуры

// Входящий номер документа поставщика записывается; собственный номер при этом остается присвоенным платформой.
Процедура ДокументСВходящимНомером(Описание, ИмяФункции, ВидДоговора, ИмяДокумента) Экспорт

	Основа = ОсновнаяФикстура(ВидДоговора);
	Входящий = "ВХ-" + Лев(НовыйНомерФикстуры(), 7);

	Документ = СоздатьДокументОснования(ИмяФункции, Основа, 720, Истина, Новый Структура("НомерВходящегоДокумента", Входящий));

	Реквизиты = РеквизитыСсылки(Документ, "НомерВходящегоДокумента, Номер");
	ЮТест.ОжидаетЧто(Реквизиты.НомерВходящегоДокумента, Описание + ": входящий номер из настройки").Равно(Входящий);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Реквизиты.Номер), Описание + ": собственный номер присвоен платформой").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.Номер, Описание + ": собственный номер не равен входящему").НеРавно(Входящий);

КонецПроцедуры

// Пометка удаления ставится штатным методом; платформа при этом отменяет проведение (проведенный документ помеченным не бывает:
// запись объекта с признаком отказывает). Пара: без ключа документ не помечен и проведен.
Процедура ДокументПомечаетсяНаУдалениеИОстаетсяНепроведенным(Описание, ИмяФункции, ВидДоговора, ИмяДокумента) Экспорт

	Основа = ОсновнаяФикстура(ВидДоговора);
	Обычный = СоздатьДокументОснования(ИмяФункции, Основа, 730, Истина, Неопределено);
	Помеченный = СоздатьДокументОснования(ИмяФункции, Основа, 731, Ложь, Новый Структура("ПометкаУдаления", Истина));

	ОбычныйРеквизиты = РеквизитыСсылки(Обычный, "ПометкаУдаления, Проведен");
	ЮТест.ОжидаетЧто(ОбычныйРеквизиты.ПометкаУдаления, Описание + ": без ключа документ не помечен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ОбычныйРеквизиты.Проведен, Описание + ": без ключа документ проведен").ЭтоИстина();
	ПомеченныйРеквизиты = РеквизитыСсылки(Помеченный, "ПометкаУдаления, Проведен");
	ЮТест.ОжидаетЧто(ПомеченныйРеквизиты.ПометкаУдаления, Описание + ": документ помечен на удаление").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПомеченныйРеквизиты.Проведен, Описание + ": платформа отменила проведение помеченного документа").ЭтоЛожь();

КонецПроцедуры

// Договор записанного документа очищается без отмены проведения (вендор при обычной записи подставляет договор по умолчанию).
// Пара: тот же вид документа, созданный обычно, договор имеет.
Процедура ДоговорДокументаОчищаетсяБезОтменыПроведения(Описание, ИмяФункции, ВидДоговора, ИмяДокумента) Экспорт

	Основа = ОсновнаяФикстура(ВидДоговора);
	Обычный = СоздатьДокументОснования(ИмяФункции, Основа, 740, Истина, Неопределено);
	Очищенный = СоздатьДокументОснования(ИмяФункции, Основа, 741, Истина, Неопределено);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РеквизитыСсылки(Очищенный, "Договор").Договор), Описание + ": предусловие - до очистки договор есть").ЭтоИстина();
	СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента(Очищенный);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РеквизитыСсылки(Очищенный, "Договор").Договор), Описание + ": договор очищен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Очищенный, "Проведен").Проведен, Описание + ": документ остался проведенным").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РеквизитыСсылки(Обычный, "Договор").Договор), Описание + ": пара - обычный документ договор сохранил").ЭтоИстина();

КонецПроцедуры

// Ключ с опечаткой, неверный тип, слишком длинный номер и входящий номер у документа без такого реквизита отклоняются до
// записи.
Процедура ДокументОтклоняетЛишнийКлючИНеверныйТип(Описание, ИмяФункции, Ключ, Значение, ОжидаемыйФрагмент) Экспорт

	Основа = ОсновнаяФикстура();

	ПроверитьОтказДоЗаписи(Описание, ИмяФункции, ОжидаемыйФрагмент,
		Новый Структура("Контрагент, Договор, Настройки", Основа.Контрагент, Основа.Договор, Новый Структура(Ключ, Значение)));

КонецПроцедуры

#КонецОбласти

#Область ВимирВендораЗадача2

// ФОП: вид и ИНН записываются, код ЕДРПОУ по умолчанию не создается (код ФОП - ИНН).
Процедура КонтрагентПринимаетВидИИННиНеПолучаетЕДРПОУ() Экспорт

	Вид = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель");
	Настройки = ПризнакиУчетаКонтрагента();
	Настройки.Вставить("ВидКонтрагента", Вид);
	Настройки.Вставить("ИНН", "1234567890");

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Реквизиты = РеквизитыСсылки(Контрагент, "ВидКонтрагента, ИНН, КодПоЕДРПОУ");
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, "Вид контрагента из настройки").Равно(Вид);
	ЮТест.ОжидаетЧто(Реквизиты.ИНН, "ИНН из настройки").Равно("1234567890");
	ЮТест.ОжидаетЧто(Реквизиты.КодПоЕДРПОУ, "У ФОП без ключа КодПоЕДРПОУ код ЕДРПОУ пуст").Равно("");

КонецПроцедуры

// Пара к предыдущему: без ключа ВидКонтрагента контрагент - юрлицо с корректным ЕДРПОУ, ИНН пуст.
Процедура КонтрагентБезВидаУЮрлицаЕстьЕДРПОУ() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчетаКонтрагента());

	Реквизиты = РеквизитыСсылки(Контрагент, "ВидКонтрагента, ИНН, КодПоЕДРПОУ");
	ЮТест.ОжидаетЧто(Реквизиты.ВидКонтрагента, "Вид по умолчанию - юрлицо")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ЮридическоеЛицо"));
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Реквизиты.КодПоЕДРПОУ), "У юрлица ЕДРПОУ с правильной контрольной цифрой")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.ИНН, "У юрлица без ключа ИНН пуст").Равно("");

КонецПроцедуры

Процедура КонтрагентПринимаетРолиПокупательПоставщикПрочие(Описание, Покупатель, Поставщик, Прочие, ОжПокупатель, ОжПоставщик, ОжПрочие) Экспорт

	Настройки = ПризнакиУчетаКонтрагента();
	Если Покупатель <> Неопределено Тогда
		Настройки.Вставить("Покупатель", Покупатель);
	КонецЕсли;
	Если Поставщик <> Неопределено Тогда
		Настройки.Вставить("Поставщик", Поставщик);
	КонецЕсли;
	Если Прочие <> Неопределено Тогда
		Настройки.Вставить("ПрочиеОтношения", Прочие);
	КонецЕсли;

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Реквизиты = РеквизитыСсылки(Контрагент, "Покупатель, Поставщик, ПрочиеОтношения");
	ЮТест.ОжидаетЧто(Реквизиты.Покупатель, Описание + ": Покупатель").Равно(ОжПокупатель);
	ЮТест.ОжидаетЧто(Реквизиты.Поставщик, Описание + ": Поставщик").Равно(ОжПоставщик);
	ЮТест.ОжидаетЧто(Реквизиты.ПрочиеОтношения, Описание + ": ПрочиеОтношения").Равно(ОжПрочие);

КонецПроцедуры

// БезЗаполнения = Истина пропускает Заполнить: поля, которые ставит только обработчик заполнения вендора, остаются пустыми.
// Предусловие пары: с Заполнить (по умолчанию) ВалютаРасчетовПоУмолчанию заполнена - иначе "пусто без Заполнить" ничего не значило бы.
Процедура КонтрагентБезЗаполненияНеПолучаетЗначенийЗаполнить() Экспорт

	С = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчетаКонтрагента());
	НастройкиБез = ПризнакиУчетаКонтрагента();
	НастройкиБез.Вставить("БезЗаполнения", Истина);
	Без = СМП_ТестыДанныеУНФ.НовыйКонтрагент(НастройкиБез);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РеквизитыСсылки(С, "ВалютаРасчетовПоУмолчанию").ВалютаРасчетовПоУмолчанию),
		"Предусловие: с Заполнить валюта расчетов по умолчанию контрагента заполнена").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(РеквизитыСсылки(Без, "ВалютаРасчетовПоУмолчанию").ВалютаРасчетовПоУмолчанию),
		"БезЗаполнения: валюта расчетов по умолчанию контрагента пуста").ЭтоЛожь();

КонецПроцедуры

Процедура КонтрагентПринимаетВалютуРасчетовПоУмолчанию() Экспорт

	Валюта = Константы.ВалютаУчета.Получить();
	Настройки = ПризнакиУчетаКонтрагента();
	Настройки.Вставить("ВалютаРасчетовПоУмолчанию", Валюта);

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	ЮТест.ОжидаетЧто(РеквизитыСсылки(Контрагент, "ВалютаРасчетовПоУмолчанию").ВалютаРасчетовПоУмолчанию,
		"Валюта расчетов по умолчанию из настройки").Равно(Валюта);
	ЮТест.ОжидаетЧто(Валюта, "Предусловие: валюта настройки отличается от национальной (иначе ключ неотличим от значения по умолчанию)")
		.НеРавно(Константы.НациональнаяВалюта.Получить());

КонецПроцедуры

// Пустая ссылка в ключе ВидКонтрагента = "вид не задавать": остается то, что дало Заполнить (сверка с голым объектом).
Процедура КонтрагентПринимаетПустойВидИОставляетТоЧтоДалоЗаполнить() Экспорт

	Эталон = Справочники.Контрагенты.СоздатьЭлемент();
	Эталон.Заполнить(Неопределено);

	Настройки = ПризнакиУчетаКонтрагента();
	Настройки.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ПустаяСсылка());
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	ЮТест.ОжидаетЧто(РеквизитыСсылки(Контрагент, "ВидКонтрагента").ВидКонтрагента,
		"Вид контрагента при пустой ссылке в ключе - как после голого Заполнить").Равно(Эталон.ВидКонтрагента);

КонецПроцедуры

Процедура БанковскийСчетПринимаетБанкИСтроитНомерНаКодБанка() Экспорт

	Банк = БанкСШестизначнымКодом();
	Основа = ОсновнаяФикстура();

	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Основа.Контрагент, Новый Структура("Банк", Банк.Ссылка));

	Реквизиты = РеквизитыСсылки(Счет, "Банк, НомерСчета");
	ЮТест.ОжидаетЧто(Реквизиты.Банк, "Банк из настройки").Равно(Банк.Ссылка);
	ЮТест.ОжидаетЧто(Сред(Реквизиты.НомерСчета, 5, 6), "Позиции 5-10 номера - код банка").Равно(СокрЛП(Банк.Код));
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Реквизиты.НомерСчета), "Номер с кодом банка проходит проверку IBAN").ЭтоИстина();

КонецПроцедуры

Процедура IBANСКодомБанкаНесетКодИПроходитПроверку() Экспорт

	Для Каждого Код Из СтрРазделить("300001,305299,000000,999999", ",") Цикл
		Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(Код);
		ЮТест.ОжидаетЧто(СтрДлина(Номер), "Длина IBAN с кодом " + Код).Равно(29);
		ЮТест.ОжидаетЧто(Сред(Номер, 5, 6), "Позиции 5-10 IBAN " + Номер).Равно(Код);
		ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Номер), "IBAN '" + Номер + "' с кодом банка проходит проверку").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура IBANСКодомБанкаОтклоняетНеШестизначныйКод(Описание, Код) Экспорт

	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовыйIBAN(Код);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Код '" + Код + "': отказ").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "Код '" + Код + "': причина названа").Содержит("КодБанка должен быть строкой из шести цифр");

КонецПроцедуры

// Акт с НДС: ставка "Общая", сумма включает НДС, НДС выделен; пара без ключа - ставка "без налога", НДС 0.
Процедура АктСНДСДаетСтрокуСоСтавкойИСуммойНДС() Экспорт

	Основа = ОсновнаяФикстура();
	Общая = Справочники.СтавкиНДС.СтавкаНДС(ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.Общая"), ТекущаяДатаСеанса());

	С = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 1200, Истина, Новый Структура("СНДС", Истина));
	Без = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 1200);

	Строка = СтрокаДокумента(С, "АктВыполненныхРабот", "РаботыИУслуги");
	ЮТест.ОжидаетЧто(Строка.СтавкаНДС, "Акт с НДС: ставка 'Общая'").Равно(Общая);
	ЮТест.ОжидаетЧто(Строка.СуммаНДС, "Акт с НДС: НДС выделен из суммы, включающей НДС (20/120 от 1200)").Равно(200);
	ЮТест.ОжидаетЧто(Строка.Всего, "Акт с НДС: сумма строки включает НДС").Равно(1200);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(С, "СуммаДокумента").СуммаДокумента, "Акт с НДС: сумма документа").Равно(1200);
	Контроль = СтрокаДокумента(Без, "АктВыполненныхРабот", "РаботыИУслуги");
	ЮТест.ОжидаетЧто(Контроль.СуммаНДС, "Пара: акт без ключа - НДС 0").Равно(0);
	ЮТест.ОжидаетЧто(Контроль.СтавкаНДС, "Пара: акт без ключа - ставка не 'Общая'").НеРавно(Общая);

КонецПроцедуры

Процедура РасходнаяНакладнаяСоздаетсяПроводитсяИДаетДолг() Экспорт

	Основа = ОсновнаяФикстура();
