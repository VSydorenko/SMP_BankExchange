// Договор, созданный без ключа Основной, в регистре основных договоров не появляется. Предусловие пары: автоматический
// договор по умолчанию нового контрагента В регистре есть (иначе "нет в регистре" ничего не значило бы).
Процедура ДоговорБезОсновногоНеПопадаетВРегистрОсновных() Экспорт

	Основа = ОсновнаяФикстура();
	Автоматический = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Основа.Контрагент);
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Автоматический),
		"Предусловие: автоматический договор нового контрагента числится основным (запрос регистра видит основные договоры)")
		.ЭтоИстина();

	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент);

