Процедура ОрганизацияНеНайденаОтказываетИсключениемСПричиной() Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Валюты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Валюты КАК Валюты
		|ГДЕ
		|	Валюты.Ссылка НЕ В
		|		(ВЫБРАТЬ
		|			Б.ВалютаДенежныхСредств
		|		ИЗ
		|			Справочник.БанковскиеСчета КАК Б
		|		ГДЕ
		|			НЕ Б.ПометкаУдаления
		|			И НЕ Б.Недействителен
		|			И Б.Владелец ССЫЛКА Справочник.Организации)");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: в базе есть валюта без живых счетов организаций")
		.ЭтоИстина();
	ВалютаБезСчетов = Выборка.Ссылка;

	Результат = Неопределено;
	ТекстОшибки = Неопределено;
	Попытка
		Результат = СМП_ТестыДанныеУНФ.ОрганизацияПоВалюте(ВалютаБезСчетов);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Правило без подходящей организации отказывает исключением, а не возвращает значение (вернуло тип: "
		+ Строка(ТипЗнч(Результат)) + ")")
		.НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении названа функция и причина")
		.Содержит("СМП_ТестыДанныеУНФ.Организация: организация по правилу выбора не найдена");

КонецПроцедуры

#КонецОбласти

#Область Справочники

Процедура КонтрагентЗаписываетсяСФлагами(Имя, ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", ПоДоговорам);
	Настройки.Вставить("ВестиРасчетыПоДокументам", ПоДокументам);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", ПоЗаказам);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", ПоСчетам);

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Контрагент), Имя + ": НовыйКонтрагент вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Контрагент,
		"Наименование, КодПоЕДРПОУ, ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам");

	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоДоговорам, Имя + ": признак по договорам из параметров").Равно(ПоДоговорам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоДокументам, Имя + ": признак по документам из параметров").Равно(ПоДокументам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиРасчетыПоЗаказам, Имя + ": признак по заказам из параметров").Равно(ПоЗаказам);
	ЮТест.ОжидаетЧто(Реквизиты.ВестиУчетОплатыПоСчетам, Имя + ": признак оплаты по счетам из параметров").Равно(ПоСчетам);
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		Имя + ": наименование с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Реквизиты.КодПоЕДРПОУ),
		Имя + ": ЕДРПОУ контрагента с правильной контрольной цифрой").ЭтоИстина();

КонецПроцедуры

Процедура ДоговорЗаписываетсяСВидом(Имя, ИмяВида) Экспорт

	Основа = ОсновнаяФикстура();
	Вид = ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяВида);
	Настройки = Новый Структура("ВидДоговора", Вид);

	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент, Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), Имя + ": НовыйДоговор вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Договор, "Владелец, ВидДоговора, ВалютаРасчетов, Организация, Наименование");
	ЮТест.ОжидаетЧто(Реквизиты.Владелец, Имя + ": владелец договора").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.ВидДоговора, Имя + ": вид договора из параметров").Равно(Вид);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаРасчетов, Имя + ": валюта договора - национальная (счет организации в ней)")
		.Равно(Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(Реквизиты.Организация, Имя + ": организация договора - по правилу")
		.Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Наименование, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		Имя + ": наименование с префиксом фикстуры").ЭтоИстина();

КонецПроцедуры

