КонецПроцедуры

// Сторож (функция подсчета) видит то, что вендор создает с именем БЕЗ префикса: договор по умолчанию при записи
// контрагента (имя - шаблон вендора) и банковский счет с именем, которое дает вендорский СформироватьНаименование. Основной
// договор в регистре считается по наименованию контрагента. Предусловия - имена без префикса: иначе владелец в функции подсчета
// был бы не нужен и тест не доказывал бы его.
Процедура СторожВидитДоговорИСчетСИменемВендораБезПрефикса() Экспорт

	Префикс = СМП_ТестыДанныеУНФ.ПрефиксФикстуры();
	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчетаКонтрагента());
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "Предусловие: запись контрагента создала договор по умолчанию").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(РеквизитыСсылки(Договор, "Наименование").Наименование, Префикс),
		"Предусловие: имя договора, созданного вендором, без префикса фикстуры").ЭтоЛожь();

	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);
	Счет.Банк = БанкСШестизначнымКодом().Ссылка;
	Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN(СокрЛП(Счет.Банк.Код));
	Счет.СформироватьНаименование();
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Счет.Наименование, Префикс), "Предусловие: имя счета, данное вендором, без префикса фикстуры")
		.ЭтоЛожь();
	Счет.Записать();

	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	Для Каждого Тип Из СтрРазделить("Справочник.Контрагенты,Справочник.ДоговорыКонтрагентов,Справочник.БанковскиеСчета,РегистрСведений.ОсновныеДоговорыКонтрагента", ",") Цикл
		Было = До.Получить(Тип);
		Стало = После.Получить(Тип);
		ЮТест.ОжидаетЧто(?(Стало = Неопределено, 0, Стало) - ?(Было = Неопределено, 0, Было), Тип + ": сторож увидел ровно один новый объект")
			.Равно(1);
	КонецЦикла;

КонецПроцедуры

// Регистр дублей контрагентов вендор пишет только при дубле: два ФОП с одним ИНН (для не юрлица ЕДРПОУ не нужен) дают по строке
// на каждого. Сторож (функция подсчета) видит обе - по наименованию контрагента (ни ИНН, ни префикса в самом регистре нет).
// Предусловие: до записи второго контрагента строк у пары нет.
Процедура СторожВидитРегистрДублейУКонтрагентов() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();
	Пара = ДвойникФОП();
	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Тип = "РегистрСведений.НаличиеДублейУКонтрагентов";
	Было = ?(До.Получить(Тип) = Неопределено, 0, До.Получить(Тип));
	Стало = ?(После.Получить(Тип) = Неопределено, 0, После.Получить(Тип));
	ЮТест.ОжидаетЧто(Стало - Было, Тип + ": сторож увидел по строке на каждого из двух ФОП с одним ИНН").Равно(2);
	ЮТест.ОжидаетЧто(Пара.Первый <> Пара.Второй, "Предусловие: два разных контрагента").ЭтоИстина();

КонецПроцедуры

// Два ФОП с одним ИНН (вторая запись заставляет вендора записать регистр дублей для обоих).
Функция ДвойникФОП()

	ИНН = Лев(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"), 10);
	Настройки = ПризнакиУчетаКонтрагента();
	Настройки.Вставить("ВидКонтрагента", ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель"));
	Настройки.Вставить("ИНН", ИНН);
	Первый = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);
	Второй = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Возврат Новый Структура("Первый, Второй", Первый, Второй);

КонецФункции

// Первый не помеченный на удаление банк (не группа), код которого - ровно шесть цифр (МФО).
Функция БанкСШестизначнымКодом()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка, Б.Код КАК Код
		|ИЗ Справочник.Банки КАК Б
		|ГДЕ НЕ Б.ПометкаУдаления И НЕ Б.ЭтоГруппа И Б.Код ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]""
		|УПОРЯДОЧИТЬ ПО Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: в справочнике Банки есть банк с шестизначным кодом").ЭтоИстина();

	Возврат Новый Структура("Ссылка, Код", Выборка.Ссылка, Выборка.Код);

КонецФункции

// Первая строка табличной части документа (читается запросом).
Функция СтрокаДокумента(Документ, ИмяДокумента, ИмяТабличнойЧасти)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 С.СтавкаНДС КАК СтавкаНДС, С.СуммаНДС КАК СуммаНДС, С.Всего КАК Всего
		|ИЗ Документ." + ИмяДокумента + "." + ИмяТабличнойЧасти + " КАК С
		|ГДЕ С.Ссылка = &Документ
		|УПОРЯДОЧИТЬ ПО С.НомерСтроки");
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: у документа есть строка " + ИмяТабличнойЧасти).ЭтоИстина();

	Возврат Новый Структура("СтавкаНДС, СуммаНДС, Всего", Выборка.СтавкаНДС, Выборка.СуммаНДС, Выборка.Всего);

КонецФункции

#КонецОбласти

#Область БанковскийДокумент

// Все признаки, по которым распознавание ищет загруженную операцию, записываются и читаются запросом.
// Реквизит СМП_ИДТранзакцииБанка принадлежит продуктовому расширению: читается запросом.
Процедура БанковскийДокументСоздаетсяСПризнаками(Описание, Вид) Экспорт

	Основа = ОсновнаяФикстура(?(Вид = "ПоступлениеНаСчет", "СПокупателем", "СПоставщиком"));
	Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Основа.Контрагент);
	День = НачалоДня(ТекущаяДатаСеанса()) - 3 * 86400;
	Настройки = Новый Структура;
	Настройки.Вставить("ВидДокумента", Вид);
	Настройки.Вставить("СМП_ИДТранзакцииБанка", "СМП_ТЕСТ_ИД_1");
	Настройки.Вставить("НомерВходящегоДокумента", "А-77");
	Настройки.Вставить("ДатаВходящегоДокумента", День);
	Настройки.Вставить("Сумма", 1234.56);
	Настройки.Вставить("СчетКонтрагента", Счет);
	Настройки.Вставить("Контрагент", Основа.Контрагент);
	Настройки.Вставить("Договор", Основа.Договор);

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ), Описание + ": построитель вернул заполненную ссылку (не создан)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Документ.Метаданные().Имя, Описание + ": вид документа").Равно(Вид);
	Реквизиты = РеквизитыСсылки(Документ,
		"СМП_ИДТранзакцииБанка, НомерВходящегоДокумента, ДатаВходящегоДокумента, СуммаДокумента, СчетКонтрагента, Контрагент, БанковскийСчет, Комментарий, Проведен, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.СМП_ИДТранзакцииБанка, Описание + ": идентификатор транзакции банка").Равно("СМП_ТЕСТ_ИД_1");
	ЮТест.ОжидаетЧто(Реквизиты.НомерВходящегоДокумента, Описание + ": входящий номер").Равно("А-77");
	ЮТест.ОжидаетЧто(Реквизиты.ДатаВходящегоДокумента, Описание + ": входящая дата").Равно(День);
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, Описание + ": сумма").Равно(1234.56);
	ЮТест.ОжидаетЧто(Реквизиты.СчетКонтрагента, Описание + ": счет контрагента").Равно(Счет);
	ЮТест.ОжидаетЧто(Реквизиты.Контрагент, Описание + ": контрагент").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.БанковскийСчет, Описание + ": банковский счет организации по умолчанию")
		.Равно(СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации());
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Комментарий, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		Описание + ": комментарий с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, Описание + ": по умолчанию не проведен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, Описание + ": по умолчанию без пометки удаления").ЭтоЛожь();

КонецПроцедуры

// Что не задано, остается ПУСТЫМ (идентификатор, входящие номер и дата, счет контрагента): документ без
// признаков - основа тестов "файл после API".
Процедура БанковскийДокументПоУмолчаниюПустойКлючНепроведенНеПомечен() Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура);

	Реквизиты = РеквизитыСсылки(Документ,
		"СМП_ИДТранзакцииБанка, НомерВходящегоДокумента, ДатаВходящегоДокумента, СуммаДокумента, СчетКонтрагента, Проведен, ПометкаУдаления");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ), "Построитель вернул заполненную ссылку (не создан)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Метаданные.Документы.ПоступлениеНаСчет.Имя, "Предусловие - вид по умолчанию").Равно(Документ.Метаданные().Имя);
	ЮТест.ОжидаетЧто(Реквизиты.СМП_ИДТранзакцииБанка, "Идентификатор пуст").Равно("");
	ЮТест.ОжидаетЧто(Реквизиты.НомерВходящегоДокумента, "Входящий номер пуст").Равно("");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.ДатаВходящегоДокумента), "Входящая дата пуста").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.СчетКонтрагента), "Счет контрагента пуст").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, "Сумма по умолчанию").Равно(100);
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, "Не проведен").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Без пометки удаления").ЭтоЛожь();

КонецПроцедуры

Процедура БанковскийДокументПроводитсяКогдаПросят(Описание, Вид) Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента, Проведен, Сумма", Вид, Истина, 321));

	ЮТест.ОжидаетЧто(Документ.Метаданные().Имя, Описание + ": вид документа").Равно(Вид);
	Реквизиты = РеквизитыСсылки(Документ, "Проведен, СуммаДокумента");
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, Описание + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, Описание + ": сумма").Равно(321);

КонецПроцедуры

// Ключ РасшифровкаПоДолгам: штатное заполнение расшифровки вендора - оплата на сумму акта гасит долг по акту (остаток документа 0);
// пара - оплата без ключа (одна строка без основания) долг не гасит (остаток документа прежний, уходит в аванс).
Процедура БанковскийДокументРасшифровкаПоДолгамГаситДолгАкта() Экспорт

	Основа = ОсновнаяФикстура();
	Акт = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 900);

	СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("Контрагент, Договор, Сумма, Проведен", Основа.Контрагент, Основа.Договор, 900, Истина));
	ЮТест.ОжидаетЧто(ОстатокДолгаПоДокументу(Акт, Основа.Контрагент), "Пара: оплата без ключа долг по акту не гасит").Равно(900);

	СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("Контрагент, Договор, Сумма, Проведен, РасшифровкаПоДолгам",
		Основа.Контрагент, Основа.Договор, 900, Истина, Истина));
	ЮТест.ОжидаетЧто(ОстатокДолгаПоДокументу(Акт, Основа.Контрагент), "Оплата с РасшифровкаПоДолгам гасит долг по акту").Равно(0);

КонецПроцедуры

Функция ОстатокДолгаПоДокументу(Документ, Контрагент)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(О.СуммаВалОстаток), 0) КАК Сумма
		|ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, Контрагент = &Контрагент И Документ = &Документ И ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)) КАК О");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

Процедура БанковскийДокументПомечаетсяНаУдаление() Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ПометкаУдаления", Истина));

	Реквизиты = РеквизитыСсылки(Документ, "ПометкаУдаления, Проведен");
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Документ помечен на удаление").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, "Помеченный на удаление не проведен").ЭтоЛожь();

КонецПроцедуры

// Ключ с опечаткой не пропускается молча: исключение называет ключ, запись не начинается.
Процедура БанковскийДокументОтклоняетЛишнийКлюч() Экспорт

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("СМП_ИДТранзакцииБанк", "1"));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Ключ с опечаткой дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении названа функция и ключ")
		.Содержит("НовыйБанковскийДокумент: неизвестный ключ настроек 'СМП_ИДТранзакцииБанк'");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), "Документ, контрагент и договор не созданы").Равно(До);

КонецПроцедуры

// Тип значения ключа проверяется до первой записи (контрагент и договор тоже не создаются).
Процедура БанковскийДокументОтклоняетНеверныйТипЗначения(Описание, Ключ, Значение) Экспорт

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура(Ключ, Значение));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": неверный тип дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": в исключении названы функция и ключ")
		.Содержит("НовыйБанковскийДокумент: неверный тип параметра Настройки." + Ключ);
	ЮТест.ОжидаетЧто(СуммаПодсчета(), Описание + ": ничего не создано").Равно(До);

КонецПроцедуры

Процедура БанковскийДокументОтклоняетНедопустимыйВид() Экспорт

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента", "СчетНаОплату"));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Недопустимый вид дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении назван вид").Содержит("ВидДокумента 'СчетНаОплату' недопустим");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), "Ничего не создано").Равно(До);

КонецПроцедуры

#КонецОбласти

#Область ПлатежноеПоручение

// Все признаки, по которым шаг 3 распознавания ищет платежное поручение, записываются и читаются запросом.
Процедура ПлатежноеПоручениеСоздаетсяСПризнаками() Экспорт

	Основа = ОсновнаяФикстура("СПоставщиком");
	День = НачалоДня(ТекущаяДатаСеанса()) - 2 * 86400;
	Настройки = Новый Структура;
	Настройки.Вставить("Контрагент", Основа.Контрагент);
	Настройки.Вставить("Договор", Основа.Договор);
	Настройки.Вставить("Сумма", 1234.56);
	Настройки.Вставить("Дата", День);
	Настройки.Вставить("Номер", "ЦБ-00007");
	Настройки.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"));
	Настройки.Вставить("Статья", ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.Прочее"));
	Настройки.Вставить("Корреспонденция", ПредопределенноеЗначение("ПланСчетов.Управленческий.РасчетыСПоставщиками"));
	Настройки.Вставить("Оплачено", Истина);

	Документ = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Настройки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ), "Построитель вернул заполненную ссылку (не создан)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Документ.Метаданные().Имя, "Вид документа").Равно("ПлатежноеПоручение");
	Реквизиты = РеквизитыСсылки(Документ,
		"Контрагент, Договор, СуммаДокумента, Дата, Номер, ВидОперации, Статья, Корреспонденция, Оплачено, Организация, БанковскийСчет, Комментарий, Проведен, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.Контрагент, "Контрагент").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Реквизиты.Договор, "Договор").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, "Сумма").Равно(1234.56);
	ЮТест.ОжидаетЧто(Реквизиты.Дата, "Дата").Равно(День);
	ЮТест.ОжидаетЧто(Реквизиты.Номер, "Номер").Равно("ЦБ-00007");
	ЮТест.ОжидаетЧто(Реквизиты.ВидОперации, "Вид операции")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"));
	ЮТест.ОжидаетЧто(Реквизиты.Статья, "Статья").Равно(ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.Прочее"));
	ЮТест.ОжидаетЧто(Реквизиты.Корреспонденция, "Корреспонденция").Равно(ПредопределенноеЗначение("ПланСчетов.Управленческий.РасчетыСПоставщиками"));
	ЮТест.ОжидаетЧто(Реквизиты.Оплачено, "Признак оплаты, который ставит вендор").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация по умолчанию").Равно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(Реквизиты.БанковскийСчет, "Банковский счет организации по умолчанию").Равно(СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации());
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Комментарий, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()), "Комментарий с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, "Поручение не проводится (проведение запрещено вендором)").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Без пометки удаления").ЭтоЛожь();

КонецПроцедуры

// Пара к предыдущему: что не задано, получает значение по умолчанию. Не оплачено, без пометки, вид Оплата, статья и
// корреспонденция пусты, контрагент и договор созданы, номер - восемь цифр без ведущего нуля.
Процедура ПлатежноеПоручениеПоУмолчанию() Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура);

	Реквизиты = РеквизитыСсылки(Документ,
		"Контрагент, Договор, СуммаДокумента, Дата, Номер, ВидОперации, Статья, Корреспонденция, Оплачено, ПометкаУдаления");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.Контрагент), "Контрагент создан").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.Договор), "Договор создан").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, "Сумма по умолчанию").Равно(100);
	ЮТест.ОжидаетЧто(Реквизиты.Оплачено, "Не оплачено").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Без пометки удаления").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизиты.ВидОперации, "Вид по умолчанию - Оплата")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Оплата"));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.Статья), "Статья пуста").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.Корреспонденция), "Корреспонденция пуста").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрДлина(Реквизиты.Номер), "Номер - восемь цифр").Равно(8);
	ЮТест.ОжидаетЧто(Лев(Реквизиты.Номер, 1), "Номер без ведущего нуля").НеРавно("0");
	ЮТест.ОжидаетЧто(Формат(Число(Реквизиты.Номер), "ЧГ=0"), "Номер состоит из цифр").Равно(Реквизиты.Номер);

КонецПроцедуры

Процедура ПлатежноеПоручениеПомечаетсяНаУдаление() Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("ПометкаУдаления", Истина));

	ЮТест.ОжидаетЧто(РеквизитыСсылки(Документ, "ПометкаУдаления").ПометкаУдаления, "Поручение помечено на удаление").ЭтоИстина();

КонецПроцедуры

// Другая организация: поручение записывается на нее и на ее новый банковский счет (не на счет организации по правилу).
Процедура ПлатежноеПоручениеДругойОрганизации() Экспорт

	Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация();

	Документ = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Организация", Другая));

	Реквизиты = РеквизитыСсылки(Документ, "Организация, БанковскийСчет");
	ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация из настройки").Равно(Другая);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Реквизиты.БанковскийСчет, "Владелец").Владелец, "Счет принадлежит этой организации").Равно(Другая);

КонецПроцедуры

// Ключ с опечаткой, неверный тип и слишком длинный номер отклоняются до записи (контрагент и договор не создаются).
Процедура ПлатежноеПоручениеОтклоняетЛишнийКлючИНеверныйТип(Описание, Ключ, Значение, ОжидаемыйФрагмент) Экспорт

	ПроверитьОтказДоЗаписи(Описание, "НовоеПлатежноеПоручение", ОжидаемыйФрагмент, Новый Структура("Настройки", Новый Структура(Ключ, Значение)));

КонецПроцедуры

#КонецОбласти

#Область ОхранаТранзакции

// Тест умеет падать: красный, если охрану в построителе убрать, и красный именно на ИМЕНИ этой функции:
// в тексте исключения требуется "СМП_ТестыДанныеУНФ.<ИмяФункции>: вызов вне транзакции", а не общий
// подстрок (документные функции вызывают НоваяУслуга со своей охраной, общий подстрок прошел бы).
// Работает БЕЗ транзакции (тест не помечен), поэтому каждый вызов получает заведомо неверный по типу
// аргумент: функция БЕЗ охраны упала бы на проверке типа, которая стоит сразу за охраной и ДО любой
// записи (см. НеверныйТипПараметраОтклоняетсяДоЗаписи), - в общей базе от такого вызова ничего не остается.
Процедура ПостроительОтказываетсяРаботатьВнеТранзакции(ИмяФункции) Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется вне транзакции")
		.ЭтоЛожь();

	ТекстОшибки = Неопределено;
	Попытка
		ВызватьФункциюПостроителя(ИмяФункции);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": вызов вне транзакции дал исключение (охраны нет)")
		.НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": в исключении названа эта функция и причина")
		.Содержит("СМП_ТестыДанныеУНФ." + ИмяФункции + ": вызов вне транзакции");

КонецПроцедуры

// Пара к охране: внутри транзакции неверный тип аргумента отклоняется ДО записи. Именно это делает
// безопасным вызов тестом охраны без транзакции. Текст отказа не должен содержать слов охраны,
// иначе тест охраны не отличил бы охрану от проверки типа. Подсчет объектов фикстуры до и после
// вызова совпадает: ничего не записано.
Процедура НеверныйТипПараметраОтклоняетсяДоЗаписи(ИмяФункции) Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: тест выполняется в своей транзакции")
		.ЭтоИстина();
	До = СуммаПодсчета();

	ТекстОшибки = Неопределено;
	Попытка
		ВызватьФункциюПостроителя(ИмяФункции);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": неверный тип параметра дал исключение")
		.НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": в исключении названа эта функция и неверный тип")
		.Содержит("СМП_ТестыДанныеУНФ." + ИмяФункции + ": неверный тип параметра");
	ЮТест.ОжидаетЧто(ТекстОшибки, ИмяФункции + ": отказ по типу, а не по транзакции")
		.НеСодержит("вне транзакции");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), ИмяФункции + ": объектов фикстуры не прибавилось")
		.Равно(До);

КонецПроцедуры

Функция СуммаПодсчета()

	Итого = 0;
	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		Итого = Итого + Элемент.Значение;
	КонецЦикла;

	Возврат Итого;

КонецФункции

Процедура ВызватьФункциюПостроителя(ИмяФункции)

	Если ИмяФункции = "НовыйКонтрагент" Тогда
		СМП_ТестыДанныеУНФ.НовыйКонтрагент(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйДоговор" Тогда
		СМП_ТестыДанныеУНФ.НовыйДоговор(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйБанковскийСчетКонтрагента" Тогда
		СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйЗаказПокупателя" Тогда
		СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплату" Тогда
		СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйЗаказПоставщику" Тогда
		СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплатуПоставщика" Тогда
		СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НовыйАктВыполненныхРабот" Тогда
		СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяПриходнаяНакладная" Тогда
		СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяРасходнаяНакладная" Тогда
		СМП_ТестыДанныеУНФ.НоваяРасходнаяНакладная(Неопределено, Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяОплата" Тогда
		СМП_ТестыДанныеУНФ.НоваяОплата(Неопределено, 1);
	ИначеЕсли ИмяФункции = "НоваяУслуга" Тогда
		СМП_ТестыДанныеУНФ.НоваяУслуга("не структура");
	ИначеЕсли ИмяФункции = "НовоеПодразделение" Тогда
		СМП_ТестыДанныеУНФ.НовоеПодразделение("не структура");
	ИначеЕсли ИмяФункции = "НовыйПользователь" Тогда
		СМП_ТестыДанныеУНФ.НовыйПользователь("не структура");
	ИначеЕсли ИмяФункции = "УстановитьНастройкиПользователя" Тогда
		СМП_ТестыДанныеУНФ.УстановитьНастройкиПользователя(Неопределено, Новый Структура);
	ИначеЕсли ИмяФункции = "НовыйПроект" Тогда
		СМП_ТестыДанныеУНФ.НовыйПроект("не структура");
	ИначеЕсли ИмяФункции = "НоваяГруппаДоступаКонтрагентов" Тогда
		СМП_ТестыДанныеУНФ.НоваяГруппаДоступаКонтрагентов("не структура");
	ИначеЕсли ИмяФункции = "НовоеПравилоНазначения" Тогда
		СМП_ТестыДанныеУНФ.НовоеПравилоНазначения("не структура");
	ИначеЕсли ИмяФункции = "НовыйБанковскийСчетОрганизации" Тогда
		СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйБанковскийДокумент" Тогда
		СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент("не структура");
	ИначеЕсли ИмяФункции = "НастроитьДоговорПоУмолчанию" Тогда
		СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Неопределено, Новый Структура);
	ИначеЕсли ИмяФункции = "СделатьДоговорОсновным" Тогда
		СМП_ТестыДанныеУНФ.СделатьДоговорОсновным(Неопределено);
	ИначеЕсли ИмяФункции = "НоваяОрганизация" Тогда
		СМП_ТестыДанныеУНФ.НоваяОрганизация("не структура");
	ИначеЕсли ИмяФункции = "НовоеФизЛицо" Тогда
		СМП_ТестыДанныеУНФ.НовоеФизЛицо("не структура");
	ИначеЕсли ИмяФункции = "НовыйСотрудник" Тогда
		СМП_ТестыДанныеУНФ.НовыйСотрудник(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйСотрудникПриемомНаРаботу" Тогда
		СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйБанковскийСчетФизЛица" Тогда
		СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(Неопределено);
	ИначеЕсли ИмяФункции = "НовыйКонфликтСвойСчетИПравило" Тогда
		СМП_ТестыДанныеУНФ.НовыйКонфликтСвойСчетИПравило(5);
	ИначеЕсли ИмяФункции = "НовоеПлатежноеПоручение" Тогда
		СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение("не структура");
	ИначеЕсли ИмяФункции = "ОчиститьДоговорДокумента" Тогда
		СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента("не документ");
	Иначе
		ВызватьИсключение "Тест не знает функцию построителя: " + ИмяФункции;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КонтрольныеСуммы

// Значения - из независимого расчета (скрипт вне BSL по публичному алгоритму ЕДРПОУ), не из
// самого построителя: тест, проверяющий лишь то, что сгенерировал тот же код, ничего не доказывает.
Процедура ЕДРПОУИзВнешнегоРасчетаПроходит(Код, Описание) Экспорт

	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Код), "ЕДРПОУ " + Код + " (" + Описание + ") проходит проверку")
		.ЭтоИстина();

КонецПроцедуры

// Пара к предыдущему: тот же код с измененной контрольной цифрой не проходит.
Процедура ИспорченныйЕДРПОУНеПроходит(Код) Экспорт

	Испорченный = ИспортитьПоследнююЦифру(Код);

	ЮТест.ОжидаетЧто(Испорченный, "Испорченный код отличается от исходного").НеРавно(Код);
	ЮТест.ОжидаетЧто(СтрДлина(Испорченный), "Испорченный код той же длины (отказ - из-за суммы, не из-за длины)").Равно(СтрДлина(Код));
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Испорченный), "ЕДРПОУ " + Испорченный + " с испорченной контрольной цифрой не проходит")
		.ЭтоЛожь();

КонецПроцедуры

Процедура IBANИзВнешнегоРасчетаПроходит() Экспорт

	Номер = "UA213223130000026007233566001";
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Номер), "IBAN " + Номер + " проходит проверку")
		.ЭтоИстина();

КонецПроцедуры

Процедура ИспорченныйIBANНеПроходит() Экспорт

	Исходный = "UA213223130000026007233566001";
	Испорченный = ИспортитьПоследнююЦифру(Исходный);

	ЮТест.ОжидаетЧто(Испорченный, "Испорченный номер отличается от исходного").НеРавно(Исходный);
	ЮТест.ОжидаетЧто(СтрДлина(Испорченный), "Испорченный номер той же длины (отказ - из-за суммы, не из-за длины)").Равно(СтрДлина(Исходный));
	ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Испорченный), "IBAN " + Испорченный + " с испорченной суммой не проходит")
		.ЭтоЛожь();

КонецПроцедуры

Процедура СгенерированныйЕДРПОУПроходитПроверку() Экспорт

	Для Индекс = 1 По 50 Цикл
		Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
		ЮТест.ОжидаетЧто(СтрДлина(Код), "Длина сгенерированного ЕДРПОУ " + Код).Равно(8);
		ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Код), "Сгенерированный ЕДРПОУ '" + Код + "' проходит проверку")
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Код с ведущим нулем: восемь знаков, первый - ноль, второй - нет (один ведущий ноль), контрольная цифра верна.
// Оракул - независимая проверка ЕДРПОУКорректен, не повторение генератора; ее собственная работоспособность
// доказана значениями из внешнего расчета (ЕДРПОУИзВнешнегоРасчетаПроходит / ИспорченныйЕДРПОУНеПроходит).
Процедура СгенерированныйЕДРПОУСВедущимНулемПроходитПроверку() Экспорт

	Для Индекс = 1 По 50 Цикл
		Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУСВедущимНулем();
		ЮТест.ОжидаетЧто(СтрДлина(Код), "Длина кода с ведущим нулем " + Код).Равно(8);
		ЮТест.ОжидаетЧто(Лев(Код, 1), "Первый знак кода " + Код + " - ноль").Равно("0");
		ЮТест.ОжидаетЧто(Сред(Код, 2, 1), "Второй знак кода " + Код + " - не ноль (ровно один ведущий ноль)").НеРавно("0");
		ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.ЕДРПОУКорректен(Код), "Код с ведущим нулем '" + Код + "' проходит проверку")
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура СгенерированныйIBANПроходитПроверку() Экспорт

	Для Индекс = 1 По 50 Цикл
		Номер = СМП_ТестыДанныеУНФ.НовыйIBAN();
		ЮТест.ОжидаетЧто(СтрДлина(Номер), "Длина сгенерированного IBAN " + Номер).Равно(29);
		ЮТест.ОжидаетЧто(СМП_ТестыДанныеУНФ.IBANКорректен(Номер), "Сгенерированный IBAN '" + Номер + "' проходит проверку")
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Функция ИспортитьПоследнююЦифру(Строка)

	Последняя = Число(Прав(Строка, 1));
	Новая = (Последняя + 1) % 10;
	Возврат Лев(Строка, СтрДлина(Строка) - 1) + XMLСтрока(Новая);

КонецФункции

#КонецОбласти

#Область СторожОстатков

// Симметричная пара к ДанныхТестовНеОсталось. Внутри СВОЕЙ транзакции создает построителем по
// одному объекту каждого типа и той же функцией подсчета, что и сторож остатков, требует не менее
// одного для КАЖДОГО типа. Доказывает: сторож видит все, что создает построитель. Красный с
// названием типа, если из функции подсчета тип убрать (проверено мутацией, см. журнал прогонов).
Процедура СторожВидитФикстуру() Экспорт

	Основа = ОсновнаяФикстура();
	Поставщик = ОсновнаяФикстура("СПоставщиком");
	Созданное = Новый Соответствие;

	Созданное.Вставить("Справочник.Контрагенты", Основа.Контрагент);
	Созданное.Вставить("Справочник.ДоговорыКонтрагентов", Основа.Договор);
	Созданное.Вставить("Справочник.БанковскиеСчета",
		СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Основа.Контрагент));
	Созданное.Вставить("Справочник.Номенклатура", СМП_ТестыДанныеУНФ.НоваяУслуга());
	Созданное.Вставить("Справочник.Проекты", СМП_ТестыДанныеУНФ.НовыйПроект());
	Созданное.Вставить("Справочник.ГруппыДоступаКонтрагентов", СМП_ТестыДанныеУНФ.НоваяГруппаДоступаКонтрагентов());
	Подразделение = СМП_ТестыДанныеУНФ.НовоеПодразделение();
	Пользователь = СМП_ТестыДанныеУНФ.НовыйПользователь();
	Созданное.Вставить("Справочник.СтруктурныеЕдиницы", Подразделение);
	Созданное.Вставить("Справочник.Пользователи", Пользователь);
	Созданное.Вставить("РегистрСведений.НастройкиПользователей",
		СМП_ТестыДанныеУНФ.УстановитьНастройкиПользователя(Пользователь, Новый Структура("ОсновноеПодразделение", Подразделение)));
	Созданное.Вставить("Документ.ЗаказПокупателя",
		СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Основа.Контрагент, Основа.Договор, 100));
	СчетПокупателю = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, 100);
	Созданное.Вставить("Документ.СчетНаОплату", СчетПокупателю);
	Созданное.Вставить("Документ.ЗаказПоставщику",
		СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Поставщик.Контрагент, Поставщик.Договор, 100));
	СчетПоставщика = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Поставщик.Контрагент, Поставщик.Договор, 100);
	Созданное.Вставить("Документ.СчетНаОплатуПоставщика", СчетПоставщика);
	Созданное.Вставить("Документ.АктВыполненныхРабот",
		СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, 100));
	Созданное.Вставить("Документ.ПриходнаяНакладная",
		СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Поставщик.Контрагент, Поставщик.Договор, 100));
	Созданное.Вставить("Документ.РасходнаяНакладная",
		СМП_ТестыДанныеУНФ.НоваяРасходнаяНакладная(Основа.Контрагент, Основа.Договор, 100));
	// Запись основных договоров появляется при записи контрагента (договор по умолчанию); сторож считает ее по контрагенту.
	Созданное.Вставить("РегистрСведений.ОсновныеДоговорыКонтрагента",
		Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Основа.Контрагент));
	// Регистр дублей вендор пишет лишь когда у контрагента есть дубль (одинаковые ИНН и ЕДРПОУ; для ФОП - заполненный ИНН):
	// строки получают оба. Сторож считает регистр по наименованию контрагента.
	Созданное.Вставить("РегистрСведений.НаличиеДублейУКонтрагентов", ДвойникФОП().Второй);
	Созданное.Вставить("Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа",
		СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура));
	Созданное.Вставить("Документ.ПоступлениеНаСчет", СМП_ТестыДанныеУНФ.НоваяОплата(СчетПокупателю, 40));
	Созданное.Вставить("Документ.РасходСоСчета", СМП_ТестыДанныеУНФ.НоваяОплата(СчетПоставщика, 40));
	Созданное.Вставить("Документ.ПлатежноеПоручение", СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура));

	Количества = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Для Каждого Элемент Из Созданное Цикл
		Тип = Элемент.Ключ;
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Элемент.Значение), Тип + ": построитель создал объект (не пустая ссылка)")
			.ЭтоИстина();
		Количество = Количества.Получить(Тип);
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		ЮТест.ОжидаетЧто(Количество, "Сторож видит фикстуру типа " + Тип + " (функция подсчета)")
			.Больше(0);
	КонецЦикла;

КонецПроцедуры

// В СторожВидитФикстуру ключ "Справочник.БанковскиеСчета" занят счетом контрагента, поэтому счет организации
// проверяется отдельно: создается ТОЛЬКО он, и функция подсчета (она же у ДанныхТестовНеОсталось) его видит.
Процедура СторожВидитСчетОрганизации() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам().Получить("Справочник.БанковскиеСчета");
	До = ?(До = Неопределено, 0, До);

	СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());

	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам().Получить("Справочник.БанковскиеСчета");
	ЮТест.ОжидаетЧто(После, "Сторож видит банковский счет организации (функция подсчета)").Равно(До + 1);

КонецПроцедуры

// Документ вендора КорректировкаРегистров (его пишут тесты шага 5): сторож видит его по префиксу в Комментарии. Создается
// только он, без рухов - для подсчета нужен лишь комментарий. ДанныхТестовНеОсталось считает той же функцией по всем типам,
// поэтому ждет нуль и для этого типа.
Процедура СторожВидитКорректировкуРегистров() Экспорт

	До = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам().Получить("Документ.КорректировкаРегистров");
	До = ?(До = Неопределено, 0, До);

	Документ = Документы.КорректировкаРегистров.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Документ.Записать(РежимЗаписиДокумента.Запись);

	После = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам().Получить("Документ.КорректировкаРегистров");
	ЮТест.ОжидаетЧто(После, "Сторож видит документ КорректировкаРегистров (функция подсчета)").Равно(До + 1);

КонецПроцедуры

// БЕЗ транзакции, ПОСЛЕДНИМ. Один запрос подсчета (общая функция с СторожВидитФикстуру) по всем
// типам построителя; ждет нуль в каждом. Красный здесь - СТОП: остатки руками не удалять,
// сообщить владельцу.
Процедура ДанныхТестовНеОсталось() Экспорт

	Количества = СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам();

	Для Каждого Элемент Из Количества Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Контрагент с договором нужного вида. Создается внутри транзакции вызывающего теста.
Функция ОсновнаяФикстура(ИмяВидаДоговора = "СПокупателем")

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Вид = ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяВидаДоговора);
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", Вид));

	Возврат Новый Структура("Контрагент, Договор", Контрагент, Договор);

КонецФункции

// Создает документ-основание построителем с заданным именем. Основа - структура с Контрагент и Договор.
Функция СоздатьДокументОснования(ИмяФункции, Основа, Сумма, Провести, Настройки)

	Если ИмяФункции = "НовыйЗаказПокупателя" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплату" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НовыйЗаказПоставщику" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НовыйСчетНаОплатуПоставщика" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НовыйАктВыполненныхРабот" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НоваяПриходнаяНакладная" Тогда
		Возврат СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	ИначеЕсли ИмяФункции = "НоваяРасходнаяНакладная" Тогда
		Возврат СМП_ТестыДанныеУНФ.НоваяРасходнаяНакладная(Основа.Контрагент, Основа.Договор, Сумма, Провести, Настройки);
	КонецЕсли;

	ВызватьИсключение "Тест не знает построитель документа-основания: " + ИмяФункции;

КонецФункции

// Номер документа фикстуры: до 11 знаков, уникальный в прогоне.
Функция НовыйНомерФикстуры()

	Возврат "Ф" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 9);

КонецФункции

// Признаки учета контрагента для фикстуры: учет по договорам, документам, заказам; оплата по счетам не ведется.
Функция ПризнакиУчетаКонтрагента()

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);

	Возврат Настройки;

КонецФункции

// Числится ли договор в регистре основных договоров контрагентов (читается запросом).
Функция ЕстьВРегистреОсновных(Договор)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Т ГДЕ Т.Договор = &Договор");
	Запрос.УстановитьПараметр("Договор", Договор);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество > 0;

КонецФункции

// Вызов функции построителя с заведомо недопустимой настройкой: исключение называет функцию и причину, объектов
// фикстуры не прибавилось. Аргументы - структура с ключами Настройки (и Контрагент для функций, которые его берут).
Процедура ПроверитьОтказДоЗаписи(Описание, ИмяФункции, ОжидаемыйФрагмент, Аргументы)

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		Если ИмяФункции = "НовыйКонтрагент" Тогда
			СМП_ТестыДанныеУНФ.НовыйКонтрагент(Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовыйДоговор" Тогда
			СМП_ТестыДанныеУНФ.НовыйДоговор(Аргументы.Контрагент, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НастроитьДоговорПоУмолчанию" Тогда
			СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Аргументы.Контрагент, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовыйБанковскийСчетКонтрагента" Тогда
			СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Аргументы.Контрагент, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НоваяОрганизация" Тогда
			СМП_ТестыДанныеУНФ.НоваяОрганизация(Аргументы.Настройки);
		ИначеЕсли СтрНачинаетсяС(ИмяФункции, "НовыйЗаказ") Или СтрНачинаетсяС(ИмяФункции, "НовыйСчетНаОплат")
			Или ИмяФункции = "НовыйАктВыполненныхРабот" Или ИмяФункции = "НоваяПриходнаяНакладная"
			Или ИмяФункции = "НоваяРасходнаяНакладная" Тогда
			СоздатьДокументОснования(ИмяФункции, Аргументы, 1, Истина, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовоеФизЛицо" Тогда
			СМП_ТестыДанныеУНФ.НовоеФизЛицо(Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовыйСотрудник" Тогда
			СМП_ТестыДанныеУНФ.НовыйСотрудник(Аргументы.ФизЛицо, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовыйСотрудникПриемомНаРаботу" Тогда
			СМП_ТестыДанныеУНФ.НовыйСотрудникПриемомНаРаботу(Аргументы.ФизЛицо, Аргументы.ОрганизацияДокумента);
		ИначеЕсли ИмяФункции = "НовыйБанковскийСчетФизЛица" Тогда
			СМП_ТестыДанныеУНФ.НовыйБанковскийСчетФизЛица(Аргументы.ФизЛицо, Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовыйКонфликтСвойСчетИПравило" Тогда
			СМП_ТестыДанныеУНФ.НовыйКонфликтСвойСчетИПравило(Аргументы.ВидДокумента);
		ИначеЕсли ИмяФункции = "НовоеПлатежноеПоручение" Тогда
			СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Аргументы.Настройки);
		ИначеЕсли ИмяФункции = "НовоеПравилоНазначения" Тогда
			СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Аргументы.Настройки);
		Иначе
			ВызватьИсключение "Тест не знает функцию построителя: " + ИмяФункции;
		КонецЕсли;
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": недопустимая настройка дала исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, Описание + ": в исключении названа функция и причина")
		.Содержит("СМП_ТестыДанныеУНФ." + ИмяФункции + ": " + ОжидаемыйФрагмент);
	ЮТест.ОжидаетЧто(СуммаПодсчета(), Описание + ": объектов фикстуры не прибавилось").Равно(До);

КонецПроцедуры

Процедура ПроверитьПроведенныйДокумент(Документ, ПолноеИмя, Сумма)

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ), ПолноеИмя + ": построитель вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(Документ.Метаданные().ПолноеИмя(), "Тип созданного документа").Равно(ПолноеИмя);
	Реквизиты = РеквизитыСсылки(Документ, "Проведен, СуммаДокумента, Комментарий");
	ЮТест.ОжидаетЧто(Реквизиты.Проведен, ПолноеИмя + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизиты.СуммаДокумента, ПолноеИмя + ": сумма из параметра").Равно(Сумма);
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Реквизиты.Комментарий, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()),
		ПолноеИмя + ": комментарий с префиксом фикстуры").ЭтоИстина();

КонецПроцедуры

// Читает реквизиты ссылки запросом: базовые общие модули из тестового расширения не вызываются.
// Реквизиты - строка имен через запятую; результат - структура с теми же ключами.
Функция РеквизитыСсылки(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + "
		|ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
