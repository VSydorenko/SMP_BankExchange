			.ДобавитьСерверныйТест("ПриходнаяНакладнаяПроводитсяИДаетДолгПоставщику").ВТранзакции()
			.ДобавитьСерверныйТест("ДокументБезПроведенияОстаетсяНепроведенным").ВТранзакции()
			.ДобавитьСерверныйТест("ОплатаПокупателяПроводитсяИОплачиваетЧасть").ВТранзакции()
			.ДобавитьСерверныйТест("ОплатаПоставщикуПроводитсяИОплачиваетЧасть").ВТранзакции()
			// Гигиена тестов перед задачей 10: инвариант дат построителя (договор <= основа <= платеж, одни сутки).
			// Первый тест проверяет правило на любом часе (момент параметром), второй - то, что строит построитель.
			.ДобавитьСерверныйТест("ДатаАктаНеВыходитЗаСуткиМоментаФикстуры")
				.СПараметрами("ровно полночь", 0)
				.СПараметрами("полчаса после полуночи", 1800)
				.СПараметрами("без одной секунды час", 3599)
				.СПараметрами("ровно час", 3600)
				.СПараметрами("полдень", 43200)
				.СПараметрами("последняя секунда суток", 86399)
			.ДобавитьСерверныйТест("ДатыДоговораОснованийИПлатежаСогласованы").ВТранзакции()
		// Настройки документов-оснований (задача 8): номер, дата, организация, пометка удаления без отмены проведения.
		.ДобавитьТестовыйНабор("Документы фикстуры: номер, дата, организация, пометка удаления")
			.ДобавитьСерверныйТест("ДокументСоздаетсяСНомеромДатойОрганизацией").ВТранзакции()
				.СПараметрами("заказ покупателя", "НовыйЗаказПокупателя", "СПокупателем", "ЗаказПокупателя")
				.СПараметрами("счет на оплату", "НовыйСчетНаОплату", "СПокупателем", "СчетНаОплату")
				.СПараметрами("заказ поставщику", "НовыйЗаказПоставщику", "СПоставщиком", "ЗаказПоставщику")
				.СПараметрами("счет на оплату поставщика", "НовыйСчетНаОплатуПоставщика", "СПоставщиком", "СчетНаОплатуПоставщика")
				.СПараметрами("акт выполненных работ", "НовыйАктВыполненныхРабот", "СПокупателем", "АктВыполненныхРабот")
