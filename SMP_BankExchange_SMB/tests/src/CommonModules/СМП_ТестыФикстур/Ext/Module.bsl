// Неструктура отклоняется до записи (пара: структура и Неопределено принимаются, ПроектСоздается).
Процедура ПроектОтклоняетНеструктуру() Экспорт

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовыйПроект("не структура");
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Неструктура дала исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении названа функция и тип").Содержит("СМП_ТестыДанныеУНФ.НовыйПроект: неверный тип параметра Настройки");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), "Проект не создан").Равно(До);

КонецПроцедуры

// Группа доступа контрагентов: создается с префиксом (и видна сторожу - СторожВидитФикстуру), ключ ПометкаУдаления помечает ее,
