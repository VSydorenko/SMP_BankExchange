КонецПроцедуры

// Ключ с опечаткой в имени реквизита не пропускается молча: исключение называет ключ, запись не начинается.
Процедура ПравилоНазначенияОтклоняетЛишнийКлюч() Экспорт

	До = СуммаПодсчета();
	ТекстОшибки = Неопределено;
	Попытка
		СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура("СМП_ВидНалгоа", Неопределено));
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Ключ с опечаткой дал исключение").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(ТекстОшибки, "В исключении названа функция и ключ")
		.Содержит("НовоеПравилоНазначения: неизвестный ключ настроек 'СМП_ВидНалгоа'");
	ЮТест.ОжидаетЧто(СуммаПодсчета(), "Правило не создано").Равно(До);

КонецПроцедуры

// Фраза пишется ровно как задана: без префикса фикстуры и без уникального окончания (в том числе пустая и из пробелов).
Процедура ПравилоНазначенияФразаДословно(Описание, Фраза) Экспорт

	Правило = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура("ФразаДословно", Фраза));

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило), Описание + ": правило создано (не пустая ссылка)").ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Правило, "ФразаДляПоискаВНазначенииПлатежа");
	ЮТест.ОжидаетЧто(Реквизиты.ФразаДляПоискаВНазначенииПлатежа, Описание + ": фраза записана дословно").Равно(Фраза);

КонецПроцедуры

// Пара к предыдущему: без ФразаДословно фраза начинается с префикса фикстуры, а две фразы различаются.
Процедура ПравилоНазначенияФразаПоУмолчаниюСПрефиксомИУникальна() Экспорт

	Первое = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура);
	Второе = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура("Фраза", "Слово"));

	ФразаПервого = РеквизитыСсылки(Первое, "ФразаДляПоискаВНазначенииПлатежа").ФразаДляПоискаВНазначенииПлатежа;
	ФразаВторого = РеквизитыСсылки(Второе, "ФразаДляПоискаВНазначенииПлатежа").ФразаДляПоискаВНазначенииПлатежа;
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(ФразаПервого, СМП_ТестыДанныеУНФ.ПрефиксФикстуры()), "Фраза по умолчанию с префиксом фикстуры").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(ФразаВторого, СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Слово_"), "Фраза с ключом Фраза: префикс, слово, уникальное окончание")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(ФразаПервого, "Фразы двух правил различаются").НеРавно(ФразаВторого);

КонецПроцедуры

// Код (порядок по коду) и пометка удаления - стандартные реквизиты: присваиваются как заданы.
Процедура ПравилоНазначенияПринимаетКодИПометкуУдаления() Экспорт

	Правило = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура("Код, ПометкаУдаления", "ЯЯЯ07", Истина));
	Обычное = СМП_ТестыДанныеУНФ.НовоеПравилоНазначения(Новый Структура);

	Реквизиты = РеквизитыСсылки(Правило, "Код, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.Код, "Код задан").Равно("ЯЯЯ07");
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Правило помечено на удаление").ЭтоИстина();
	Пара = РеквизитыСсылки(Обычное, "Код, ПометкаУдаления");
	ЮТест.ОжидаетЧто(Пара.Код, "Пара: без ключа Код код выдан платформой").НеРавно("ЯЯЯ07");
	ЮТест.ОжидаетЧто(Пара.ПометкаУдаления, "Пара: без ключа пометки нет").ЭтоЛожь();

КонецПроцедуры

