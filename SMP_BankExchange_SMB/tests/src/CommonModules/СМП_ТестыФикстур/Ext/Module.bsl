Процедура ОрганизацияПоПравилу() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Организация), "Организация() вернула заполненную ссылку (не создана)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Организация, "ПометкаУдаления");
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Организация не помечена на удаление")
		.ЭтоЛожь();

КонецПроцедуры

Процедура БанковскийСчетОрганизацииВНациональнойВалюте() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Счет = СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации();

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Счет), "БанковскийСчетОрганизации() вернул заполненную ссылку (не создан)")
		.ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Счет, "Владелец, ВалютаДенежныхСредств, ПометкаУдаления, Недействителен");
	Национальная = Константы.НациональнаяВалюта.Получить();

	ЮТест.ОжидаетЧто(Реквизиты.Владелец, "Владелец счета - организация фикстуры")
		.Равно(Организация);
	ЮТест.ОжидаетЧто(Реквизиты.ВалютаДенежныхСредств, "Валюта счета организации - национальная")
		.Равно(Национальная);
	ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления Или Реквизиты.Недействителен, "Счет живой")
		.ЭтоЛожь();

КонецПроцедуры

