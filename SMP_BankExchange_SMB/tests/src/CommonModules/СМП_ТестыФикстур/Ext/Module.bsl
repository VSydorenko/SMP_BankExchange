// СделатьДоговорОсновным назначает роль уже существующему договору: до вызова договор в регистре основных не числится
// (пара), после - числится, а второй договор того же контрагента остается неосновным.
Процедура ДоговорСтановитсяОсновнымПоПрочитаннымКодам() Экспорт

	Основа = ОсновнаяФикстура();
	Первый = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент);
	Второй = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент);
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Первый), "Предусловие: свежий договор основным не числится").ЭтоЛожь();

	Результат = СМП_ТестыДанныеУНФ.СделатьДоговорОсновным(Первый);

	ЮТест.ОжидаетЧто(Результат, "Функция вернула тот же договор").Равно(Первый);
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Первый), "После вызова договор числится основным").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Второй), "Другой договор того же контрагента основным не стал").ЭтоЛожь();

КонецПроцедуры

