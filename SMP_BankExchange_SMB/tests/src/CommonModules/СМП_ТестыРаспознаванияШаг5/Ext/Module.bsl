#Область Шаг5ДокументПоНомеру

// Шаг 5 (D21, D35.3): заказ, счет или документ расчетов по номеру в назначении платежа. Номер документа (полный и "для печати" -
// хвост из цифр без ведущих нулей) должен стоять в назначении ОТДЕЛЬНЫМ числом: перед и после - не цифра. Каждый тест "не
// найден" сначала доказывает, что тот же документ без единственного отличия находится. Номера документов задаются явно
// (цифровой номер, уникальный в прогоне; платформа выдает номера и коды в этой базе не по порядку создания, поэтому порядок
// номеров нигде не предполагается). Назначение состоит из метки фикстуры и текста теста: правила пользователей не совпадут.

// Каждый вид документа находится по номеру в назначении. Пара: назначение без номера - документ не находится (вид операции
// по умолчанию), поэтому "находится" не могло быть следствием чего-то другого.
Процедура Шаг5_Найден_ПоВидуДокумента(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Название);

	БезНомера = Шаг5_Подготовка(Вид, Новый Структура("Назначение", "СМП_ТЕСТ_ Оплата без номера документа"));
	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(БезНомера), Название + ": пара - назначение без номера");

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, Название);

КонецПроцедуры

// Форма номера: границы "отдельного числа" и варианты номера (полный, без префикса и нулей). Строка таблицы: шаблон номера
// документа и шаблон назначения (% - цифровой номер сценария), ожидаемое - найден или нет. Каждая строка сначала доказывает, что
// тот же документ находится по назначению с его полным номером отдельным числом, и что номер записан в документ как задан.
Процедура Шаг5_Номер_Форма(Название, ШаблонНомера, ШаблонНазначения, Найден) Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера, ШаблонНазначения", ШаблонНомера, ШаблонНазначения));
	Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Название);
	НомерДокумента = СтрЗаменить(ШаблонНомера, "%", Подготовка.Номер);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, Название + ": предусловие - номер документа записан по шаблону")
		.Равно(НомерДокумента);
	Назначение = СтрЗаменить(ШаблонНазначения, "%", Подготовка.Номер);
	ЮТест.ОжидаетЧто(Подготовка.Операция.НазначениеПлатежа, Название + ": предусловие - назначение по шаблону").Равно(Назначение);

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунок № " + НомерДокумента;
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": пара - полный номер документа в назначении");

	Подготовка.Операция.НазначениеПлатежа = Назначение;
	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Если Найден Тогда
		Шаг5_ПроверитьНайден(Подготовка, Результат, Название);
	Иначе
		Шаг5_ПроверитьНеНайден(Результат, Название);
	КонецЕсли;

КонецПроцедуры

// Одно отличие - документ не кандидат: не проведен, помечен на удаление (платформа при этом отменяет проведение), другая
// организация, другой контрагент, другой напрям операции. Для каждого: те же данные без отличия находятся (предусловие), и отличие действительно
// записано в данные (чтением документа и регистра).
Процедура Шаг5_ОдноОтличие_ДокументНеКандидат(Название, Вид, Отличие) Экспорт

	Базовая = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьНайден(Базовая, СМП_ТестыРаспознавания.РаспознатьПодготовку(Базовая), Название + ": предусловие - без отличия документ находится");

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("Отличие", Отличие));
	Шаг5_ПроверитьОтличиеЗаписано(Подготовка, Отличие, Название);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Новый контрагент (в базе его нет): поиска документа нет. Предусловие - тот же документ с контрагентом, найденным по коду,
// находится; у контрагента операции из второго сценария действие "Создать".
Процедура Шаг5_НовыйКонтрагент_ПоискаНет(Название, Вид) Экспорт

	Базовая = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьНайден(Базовая, СМП_ТестыРаспознавания.РаспознатьПодготовку(Базовая), Название + ": предусловие - найденный контрагент");

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("Отличие", "новыйКонтрагент"));
	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, Название + ": предусловие - контрагента в базе нет (будет создан)").Равно("Создать");
	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Документ расчетов только для контрагента с ВестиРасчетыПоДокументам: при Да находится (пара), при Нет - нет. Оба признака
// читаются из базы; остаток документа расчетов в обоих случаях не нулевой (читается из регистра).
Процедура Шаг5_ДокументРасчетов_ЗависитОтПризнакаКонтрагента(Название, Вид) Экспорт

	Да = Шаг5_Подготовка(Вид);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Да.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Название + ": предусловие - у контрагента ВестиРасчетыПоДокументам = Да").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Да), Название + ": предусловие - остаток документа расчетов не нулевой").НеРавно(0);
	Шаг5_ПроверитьНайден(Да, СМП_ТестыРаспознавания.РаспознатьПодготовку(Да), Название + ": ВестиРасчетыПоДокументам = Да");

	Нет = Шаг5_Подготовка(Вид, Новый Структура("Отличие", "расчетыПоДокументамНет"));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Нет.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Название + ": предусловие - у контрагента ВестиРасчетыПоДокументам = Нет").ЭтоЛожь();
	// При Нет регистр хранит долг без документа (измерено): остаток считается по контрагенту, а не по документу.
	ЮТест.ОжидаетЧто(Шаг5_ДолгКонтрагента(Нет) > 0, Название + ": предусловие - долг контрагента по регистру положительный и при Нет").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Нет), Название + ": ВестиРасчетыПоДокументам = Нет");

КонецПроцедуры

// Признак контрагента читается ТЕКУЩИЙ (как у вендора), а не тот, при котором документ проведен: акт проведен при Да (в регистре
// остаток по документу), затем признак снят (запись в режиме загрузки данных - обычная запись платформа отклоняет, пока есть
// движения) - документ расчетов не находится. Пара: до снятия признака акт находится.
Процедура Шаг5_ДокументРасчетов_ПризнакСнятПослеПроведения() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: пока признак Да, акт находится");
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: остаток акта по документу не нулевой").НеРавно(0);

	Объект = Подготовка.Контрагент.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ВестиРасчетыПоДокументам = Ложь;
	Объект.Записать();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		"Предусловие: признак снят и записан").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: остаток акта по документу в регистре не изменился").НеРавно(0);

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Признак снят после проведения акта");

КонецПроцедуры

// Остаток акта - ДОЛГ (тип расчетов "Долг"), знак положительный (измерено), аванса нет; компания организации фикстур - не сама
// организация (предусловие для фильтра по компании). Акт находится.
Процедура Шаг5_Акт_ДолгПоложительныйИКомпанияНеОрганизация() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьКомпаниюНеОрганизация("Акт");
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг") > 0, "Предусловие: остаток акта по типу Долг положительный").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс"), "Предусловие: аванса по акту нет").Равно(0);

	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Акт с долгом при компании, отличной от организации");

КонецПроцедуры

// Документ только с АВАНСОВЫМ остатком (оплата без основания) - предварительный платеж, его номер не ищется. Предусловие:
// остаток аванса не нулевой, долга нет, документ проведен, компания не равна организации. Пара: акт с долгом находится.
Процедура Шаг5_Аванс_НеКандидат(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьКомпаниюНеОрганизация(Название);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, Название + ": предусловие - документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), Название + ": предусловие - остаток документа не нулевой").НеРавно(0);
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс"), Название + ": предусловие - остаток по типу Аванс не нулевой").НеРавно(0);
	// Знак авансного остатка (измерено): отрицательный. Поэтому условие "остаток > 0" само отсекает такой аванс, а отбор по типу
	// расчетов "Долг" отличим только на положительном авансе, которого эти сценарии не строят (мутация "без типа Долг" эквивалентна).
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс") < 0, Название + ": предусловие - аванс в регистре отрицательный").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг"), Название + ": предусловие - долга нет").Равно(0);

	Пара = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Пара, СМП_ТестыРаспознавания.РаспознатьПодготовку(Пара), Название + ": пара - акт с долгом находится");

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Акт с нулевым остатком (долг погашен) не кандидат. Предусловие: до погашения акт находится и остаток не нулевой; после
// погашения остаток по документу нулевой (читается из регистра), а сам акт по-прежнему проведен.
Процедура Шаг5_Акт_НулевойОстаток_НеКандидат() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: акт с долгом находится");
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: остаток акта не нулевой").НеРавно(0);

	СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента, Контрагент, Договор, Сумма, Проведен, РасшифровкаПоДолгам",
		"ПоступлениеНаСчет", Подготовка.Контрагент, Подготовка.Договор, Подготовка.Сумма, Истина, Истина));

	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: после оплаты остаток акта нулевой").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, "Предусловие: акт проведен").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Акт с нулевым остатком");

КонецПроцедуры

// Условие вендора (ЗаполнитьРасшифровкуПлатежа): при контроле договоров и учете расчетов по договорам документ расчетов берется
// только под договором подходящего вида (для поступления - вид, допустимый для операции "от покупателя"). Предусловие: контроль
// договоров контрагентов включен (читается функцией вендора - в тестовом сеансе он включен) и у контрагента учет по договорам.
// Пара: акт под договором вида "с покупателем" находится; акт под договором "с поставщиком" - нет.
Процедура Шаг5_Акт_ДоговорДругогоВида_КонтрольВключен_НеКандидат() Экспорт

	ЮТест.ОжидаетЧто(УправлениеНебольшойФирмойПовтИсп.ТребуетсяКонтрольДоговоровКонтрагентов(), "Предусловие: контроль договоров контрагентов включен").ЭтоИстина();

	Пара = Шаг5_Подготовка("Акт");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Пара.Контрагент, "ВестиРасчетыПоДоговорам").ВестиРасчетыПоДоговорам,
		"Предусловие: у контрагента учет расчетов по договорам").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Пара.Договор, "ВидДоговора").ВидДоговора, "Предусловие: пара - договор акта вида с покупателем")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПокупателем"));
	Шаг5_ПроверитьНайден(Пара, СМП_ТестыРаспознавания.РаспознатьПодготовку(Пара), "Пара: акт под договором с покупателем находится");

	Подготовка = Шаг5_Подготовка("Акт", Новый Структура("ВидДоговораДокумента", "СПоставщиком"));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Договор, "ВидДоговора").ВидДоговора, "Предусловие: договор акта вида с поставщиком")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком"));
	ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), "Предусловие: остаток акта по документу не нулевой").НеРавно(0);

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Акт под договором другого вида при включенном контроле");

КонецПроцедуры

// Строка с НОВЫМ контрагентом (действие "Создать"; в плане контрагент не определен - Неопределено, не пустая ссылка: измерено
// пробой в H-e) не ищет документы, даже если в базе есть
// проведенный счет с ПУСТЫМ контрагентом и номером из назначения (платформа такой счет проводит - измерено; в базе до теста
// проведенных заказов, счетов и документов расчетов с пустым контрагентом нет - измерено запросом). Предусловие: счет проведен,
// контрагент пуст, действие "Создать".
Процедура Шаг5_НовыйКонтрагент_СчетБезКонтрагента_НеБерется() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Отличие", "новыйКонтрагент"));
	Объект = Подготовка.Документ.ПолучитьОбъект();
	Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Данные = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен, Контрагент");
	ЮТест.ОжидаетЧто(Данные.Проведен, "Предусловие: счет без контрагента проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Данные.Контрагент), "Предусловие: у счета пустой контрагент").ЭтоЛожь();

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ДействиеКонтрагент, "Предусловие: контрагента в базе нет (будет создан)").Равно("Создать");
	Шаг5_ПроверитьНеНайден(Результат, "Новый контрагент, счет с пустым контрагентом и номером из назначения");

КонецПроцедуры

// Акт, оплаченный с переплатой (оплата больше долга, расшифрована по долгам), не кандидат. Измерено: превышение платформа относит
// на АВАНС, долг по документу становится нулевым, а не отрицательным - поэтому отрицательный остаток долга этими движениями
// не строится, и условие "остаток > 0" неотличимо от "остаток <> 0" (мутация "<> 0" эквивалентна). Предусловие: до оплаты акт
// находится; после - долг по акту нулевой, аванс по акту отрицательный.
Процедура Шаг5_Акт_Переплата_НеКандидат() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: акт с долгом находится");

	СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента, Контрагент, Договор, Сумма, Проведен, РасшифровкаПоДолгам",
		"ПоступлениеНаСчет", Подготовка.Контрагент, Подготовка.Договор, Подготовка.Сумма * 2, Истина, Истина));

	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг"), "Предусловие: долг по акту после переплаты нулевой (не отрицательный)").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, "Предусловие: акт проведен").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Акт, оплаченный с переплатой");

КонецПроцедуры

// ПОЛОЖИТЕЛЬНЫЙ аванс по проведенному документу расчетов (рухи документа вендора КорректировкаРегистров: долг документа
// закрыт, остаток - аванс > 0) не кандидат: ловит условие "тип расчетов = Долг" (мутация 20; само по себе условие "остаток > 0"
// положительный аванс не отсекает). Предусловия из регистра до вызова: долг по документу нулевой, аванс положительный, документ
// проведен, до корректировки документ находился (пара).
Процедура Шаг5_ПоложительныйАванс_НеКандидат(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьКомпаниюНеОрганизация(Название);
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": предусловие - до корректировки документ с долгом находится");

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Тип, Увеличение, Коэффициент", "Долг", Ложь, 1));
	Строки.Добавить(Новый Структура("Тип, Увеличение, Коэффициент", "Аванс", Истина, 1));
	Корректировка = Шаг5_Корректировка(Подготовка, Строки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Корректировка), Название + ": предусловие - корректировка записана").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг"), Название + ": предусловие - долг по документу нулевой").Равно(0);
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс") > 0, Название + ": предусловие - остаток по типу Аванс положительный").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, Название + ": предусловие - документ проведен").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": положительный аванс");

КонецПроцедуры

// ОТРИЦАТЕЛЬНЫЙ долг по проведенному документу расчетов (корректировка списывает долга больше, чем есть) не кандидат: ловит
// условие "остаток > 0" (мутация 21: "<> 0" взяла бы такой документ). Предусловия из регистра: долг по документу отрицательный,
// аванса нет, документ проведен, до корректировки документ находился (пара).
Процедура Шаг5_ОтрицательныйДолг_НеКандидат(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид);
	Шаг5_ПроверитьКомпаниюНеОрганизация(Название);
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": предусловие - до корректировки документ с долгом находится");

	Строки = Новый Массив;
	Строки.Добавить(Новый Структура("Тип, Увеличение, Коэффициент", "Долг", Ложь, 2));
	Корректировка = Шаг5_Корректировка(Подготовка, Строки);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Корректировка), Название + ": предусловие - корректировка записана").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг") < 0, Название + ": предусловие - остаток по типу Долг отрицательный").ЭтоИстина();
	ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс"), Название + ": предусловие - аванса по документу нет").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, Название + ": предусловие - документ проведен").ЭтоИстина();

	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": отрицательный долг");

КонецПроцедуры

// Счет побеждает документ расчетов с тем же номером. Предусловие: акт сам по себе находится; счет того же контрагента с тем
// же номером добавлен (номер записан) - берется счет.
Процедура Шаг5_СчетИАктСТемЖеНомером_Счет() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: акт сам по себе находится");

	Счет = Шаг5_ДобавитьДокумент(Подготовка, "СчетНаОплату", Подготовка.Номер);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "Номер").Номер, "Предусловие: у счета номер акта").Равно(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, "Взят счет, а не акт").Равно(Счет);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), "Замечаний о документе нет").Равно(0);

КонецПроцедуры

// Заказ и счет с одним номером у одного контрагента - два кандидата одного года: ни один и предупреждение с перечнем (общий
// пул кандидатов, приоритета заказа над счетом нет). Предусловие: заказ по отдельности находится.
Процедура Шаг5_ЗаказИСчетСТемЖеНомером_ЖоденИПредупреждение() Экспорт

	Подготовка = Шаг5_Подготовка("ЗаказПокупателя");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: заказ сам по себе находится");

	Счет = Шаг5_ДобавитьДокумент(Подготовка, "СчетНаОплату", Подготовка.Номер);
	ЮТест.ОжидаетЧто(Счет <> Подготовка.Документ, "Предусловие: это два разных документа").ЭтоИстина();

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, "Заказ и счет с одним номером");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Заказ и счет с одним номером", Подготовка.Номер);

КонецПроцедуры

// Неоднозначность среди заказов и счетов блокирует поиск документов расчетов: у контрагента акт с долгом, заказ и счет - все с одним
// номером. Предусловие: акт сам по себе находится. Заказ и счет совпали по номеру и не разрешены годом - ни один документ (акт
// не берется "в обход") и предупреждение о кандидатах.
Процедура Шаг5_НеоднозначностьЗаказов_БлокируетДокументРасчетов() Экспорт

	Подготовка = Шаг5_Подготовка("Акт");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: акт сам по себе находится");

	Заказ = Шаг5_ДобавитьДокумент(Подготовка, "ЗаказПокупателя", Подготовка.Номер);
	Счет = Шаг5_ДобавитьДокумент(Подготовка, "СчетНаОплату", Подготовка.Номер);
	ЮТест.ОжидаетЧто(Заказ <> Счет, "Предусловие: заказ и счет - разные документы").ЭтоИстина();

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, "Заказ и счет совпали по номеру, акт с тем же номером");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Заказ и счет совпали по номеру, акт с тем же номером", Подготовка.Номер);

КонецПроцедуры

// Два счета с одним номером в разные годы: решает год, найденный в назначении ОТДЕЛЬНЫМ числом (не порядок создания и не
// "последний": дефект B3). Оба порядка создания, оба года в назначении.
Процедура Шаг5_ДваСчета_РешаетГодВНазначении(Название, ПрошлогоднийПервым, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении);
	ЮТест.ОжидаетЧто(Год(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Прошлогодний, "Дата").Дата), Название + ": предусловие - год прошлогоднего другой")
		.НеРавно(Год(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Текущий, "Дата").Дата));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Прошлогодний, "Номер").Номер, Название + ": предусловие - номера счетов равны")
		.Равно(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Текущий, "Номер").Номер);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Ожидаемый = ?(ГодВНазначении = "текущий", Подготовка.Текущий, Подготовка.Прошлогодний);
	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, Название + ": взят счет года из назначения").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, Название + ": источник вида").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Название + ": замечаний нет").Равно(0);

КонецПроцедуры

// Год не решает: ни одного года в назначении, оба года, год третий, год внутри более длинного числа - ни один документ и
// одно предупреждение с перечнем кандидатов (номер и дата каждого). Предусловие: тот же номер при годе, который решает, дает
// документ (Шаг5_ДваСчета_РешаетГодВНазначении), и оба документа проведены, в одной организации и у одного контрагента.
Процедура Шаг5_ДваСчета_ГодНеРешает_ЖоденИПредупреждение(Название, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(Ложь, ГодВНазначении);
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		Данные = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка[Кандидат], "Проведен, ПометкаУдаления, Контрагент, Организация");
		ЮТест.ОжидаетЧто(Данные.Проведен, Название + ": предусловие - " + Кандидат + " проведен").ЭтоИстина();
		ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Название + ": предусловие - " + Кандидат + " не помечен").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Данные.Контрагент, Название + ": предусловие - " + Кандидат + " того же контрагента").Равно(Подготовка.Контрагент);
		ЮТест.ОжидаетЧто(Данные.Организация, Название + ": предусловие - " + Кандидат + " той же организации").Равно(СМП_ТестыДанныеУНФ.Организация());
	КонецЦикла;

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, Название, Подготовка.Номер);
	Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", СМП_ТестыРаспознавания.УровеньПредупреждение());
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		Данные = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка[Кандидат], "Дата");
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Название + ": в предупреждении дата кандидата " + Кандидат)
			.Содержит(Формат(Данные.Дата, "ДФ=dd.MM.yyyy"));
	КонецЦикла;
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоУровню(Результат.Замечания, СМП_ТестыРаспознавания.УровеньОшибка()).Количество(), Название + ": ошибок нет").Равно(0);

КонецПроцедуры

// Год - не условие поиска: единственный кандидат прошлого года находится, хотя в назначении стоит текущий год.
Процедура Шаг5_ГодНеУсловиеПоиска() Экспорт

	Момент = ТекущаяДатаСеанса(); // один раз: иначе на границе нового года предусловия сравниваются с другим годом
	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНазначения, ДатаДокумента",
		"СМП_ТЕСТ_ Оплата за рахунок № % від 15.03." + Формат(Год(Момент), "ЧГ=0"), ДобавитьМесяц(Момент, -12)));
	ЮТест.ОжидаетЧто(Год(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Дата").Дата), "Предусловие: год документа не текущий")
		.НеРавно(Год(Момент));
	ЮТест.ОжидаетЧто(СтрНайти(Подготовка.Операция.НазначениеПлатежа, Формат(Год(Момент), "ЧГ=0")), "Предусловие: в назначении текущий год")
		.НеРавно(0);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Год в назначении другой");

КонецПроцедуры

// Два счета №15 разных лет, в назначении "№15 від 12.10.<год>": год найден внутри даты дд.мм.рррр (для года межа - только "не
// цифра"), поэтому выбирается счет этого года; число 12 даты номером не считается. Оба порядка создания, оба года.
Процедура Шаг5_ДваСчета_ГодВнутриДаты(Название, ПрошлогоднийПервым, ГодВНазначении) Экспорт

	Подготовка = Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении, "15");
	Для Каждого Кандидат Из СтрРазделить("Текущий,Прошлогодний", ",") Цикл
		ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка[Кандидат], "Номер").Номер, Название + ": предусловие - номер " + Кандидат + " равен 15").Равно("15");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Год(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Прошлогодний, "Дата").Дата), Название + ": предусловие - годы документов разные")
		.НеРавно(Год(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Текущий, "Дата").Дата));

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Ожидаемый = ?(ГодВНазначении = "текущийВДате", Подготовка.Текущий, Подготовка.Прошлогодний);
	ЮТест.ОжидаетЧто(Результат.Строка.ДокументПоНомеру, Название + ": взят счет года из даты в назначении").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Название + ": замечаний нет").Равно(0);

КонецПроцедуры

// Число 12 из даты "12.10.2026" номером 12 не считается ("цифра.цифра" - часть одного числа). Счет №12; в назначении только дата
// - не кандидат. Пара: в назначении "№12" отдельным числом (рядом та же дата) - находится.
Процедура Шаг5_КороткийНомер_ДатаНеНомер() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Номер, ШаблонНазначения", "12", "СМП_ТЕСТ_ Оплата за рахунок № % від 14.10.2026"));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, "Предусловие: номер счета 12").Равно("12");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Пара: №12 отдельным числом рядом с датой");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата від 12.10.2026";
	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, "В назначении только дата 12.10.2026");

КонецПроцедуры

// Номер, чей цифровой хвост состоит из одних нулей ("000", "НФ-000"), документ не ищет: ноль не опознает документ. Пара: тот же вид
// документа с ненулевым хвостом ("100", "НФ-100"), записанным в назначении так же, находится; различие только в нулевом хвосте.
Процедура Шаг5_НулевойНомер_НеКандидат(Название, НулевойНомер, НенулевойНомер) Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера, Назначение", НенулевойНомер, "СМП_ТЕСТ_ Оплата за рахунок № " + НенулевойНомер));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, Название + ": предусловие - номер пары записан").Равно(НенулевойНомер);
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": пара - ненулевой хвост находится");

	Нулевая = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера, Назначение", НулевойНомер, "СМП_ТЕСТ_ Оплата за рахунок № " + НулевойНомер));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Нулевая.Документ, "Номер").Номер, Название + ": предусловие - нулевой номер записан").Равно(НулевойНомер);
	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Нулевая), Название);

КонецПроцедуры

// "Номер для печати" вендора (без префикса базы и нулей после него) - отдельный вариант поиска. Номер "ЦБ-1А07": цифровой хвост
// "07" без нулей - "7", но он стоит после нуля и в тексте "1А07" отдельным числом не считается; полный номер в тексте не записан.
// Находит документ только вариант для печати "1А07". Пара: тот же документ по полному номеру "ЦБ-1А07" находится.
Процедура Шаг5_НомерДляПечати_НаходитсяТолькоОн() Экспорт

	// Тот же вызов, что в продукте: тест не зависит молча от префиксов базы.
	ЮТест.ОжидаетЧто(ВРег(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать("ЦБ-1А07", Истина, Истина)), "Предусловие: НомерНаПечать(ЦБ-1А07) вендора")
		.Равно("1А07");

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Номер, ШаблонНомера, Назначение", "7", "ЦБ-1А0%", "СМП_ТЕСТ_ Оплата за рахунок № ЦБ-1А07"));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер").Номер, "Предусловие: номер счета ЦБ-1А07").Равно("ЦБ-1А07");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Пара: полный номер ЦБ-1А07 в назначении");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунок № 1А07";
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Номер для печати 1А07");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунок № 1А0";
	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Часть номера для печати (1А0) - не номер");

КонецПроцедуры

// Дефект B3 (выбор "последнего совпадения"): в назначении два номера двух разных счетов одного контрагента и года - ни один и
// предупреждение. Пара: назначение с одним из номеров находит свой счет (оба по очереди).
Процедура Шаг5_ДваНомераВНазначении_ЖоденИПредупреждение() Экспорт

	Первый = Шаг5_Подготовка("СчетНаОплату");
	Второй = Шаг5_ПодготовкаТогоЖеКонтрагента(Первый, "СчетНаОплату");
	ЮТест.ОжидаетЧто(Второй.Номер, "Предусловие: номера счетов различаются").НеРавно(Первый.Номер);
	Шаг5_ПроверитьНайден(Второй, СМП_ТестыРаспознавания.РаспознатьПодготовку(Второй), "Предусловие: назначение с номером второго - второй счет");
	Шаг5_ПроверитьНайден(Первый, СМП_ТестыРаспознавания.РаспознатьПодготовку(Первый), "Предусловие: назначение с номером первого - первый счет");

	Первый.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата за рахунки № " + Первый.Номер + " и № " + Второй.Номер;
	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Первый);

	Шаг5_ПроверитьНеНайден(Результат, "Два номера в назначении");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Два номера в назначении", Первый.Номер);
	Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", СМП_ТестыРаспознавания.УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, "В предупреждении номер второго счета").Содержит(Второй.Номер);

КонецПроцедуры

// Два счета с одним цифровым хвостом, разные префиксы, один год: оба подходят (номер без префикса и нулей совпадает), год не
// решает - ни один и предупреждение. Предусловие: каждый по отдельности находится.
Процедура Шаг5_ДваСчетаСОдинаковымХвостом_ЖоденИПредупреждение() Экспорт

	Первый = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ШаблонНомера", "НФ-00%"));
	Шаг5_ПроверитьНайден(Первый, СМП_ТестыРаспознавания.РаспознатьПодготовку(Первый), "Предусловие: счет с префиксом находится сам по себе");
	Второй = Шаг5_ПодготовкаТогоЖеКонтрагента(Первый, "СчетНаОплату", "00%", Первый.Номер);
	Второй.Операция.НазначениеПлатежа = Первый.Операция.НазначениеПлатежа;
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Второй.Документ, "Номер").Номер, "Предусловие: номера счетов различаются записью")
		.НеРавно(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Первый.Документ, "Номер").Номер);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Первый);

	Шаг5_ПроверитьНеНайден(Результат, "Одинаковый хвост номера у двух счетов");
	Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, "Одинаковый хвост номера у двух счетов", Первый.Номер);

КонецПроцедуры

// Поставщик: номер документа поставщика - входящий номер, если он есть; свой номер при этом не ищется. Входящий пуст - ищется
// свой (Шаг5_Найден_ПоВидуДокумента для ЗаказПоставщику и СчетНаОплатуПоставщика).
Процедура Шаг5_Поставщик_ВходящийНомерЕсли(Название, Вид) Экспорт

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("ВходящийНомер", Истина));
	Реквизиты = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Номер, НомерВходящегоДокумента");
	ЮТест.ОжидаетЧто(Реквизиты.НомерВходящегоДокумента, Название + ": предусловие - входящий номер записан").Равно(Подготовка.Номер);
	ЮТест.ОжидаетЧто(Реквизиты.Номер, Название + ": предусловие - собственный номер другой").НеРавно(Подготовка.Номер);
	ЮТест.ОжидаетЧто(СтрНайти(Реквизиты.Номер, Подготовка.Номер), Название + ": предусловие - входящий номер не входит в собственный").Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Подготовка.Номер, Реквизиты.Номер), Название + ": предусловие - собственный номер не входит во входящий").Равно(0);

	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": назначение с входящим номером");

	Подготовка.Операция.НазначениеПлатежа = "СМП_ТЕСТ_ Оплата по счету № " + Реквизиты.Номер;
	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), Название + ": назначение с собственным номером при заполненном входящем");

КонецПроцедуры

// Дефект B4: договор берется из найденного поиском документа, а не из текущей записи. Документ с договором, который НЕ
// основной у контрагента: в плане договор документа, действие "Найден". Предусловие: основной договор существует, он другой, и
// без номера в назначении общий выбор дал бы именно его. Вид договора документа любой: фильтр вида не применяется.
Процедура Шаг5_Договор_ИзНайденногоДокумента(Название, Вид, ВидДоговораДокумента) Экспорт

	Подготовка = Шаг5_Подготовка(Вид, Новый Структура("ВидДоговораДокумента", ВидДоговораДокумента));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЕстьВРегистреОсновных(Подготовка.Договор), Название + ": предусловие - договор документа не основной").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЕстьВРегистреОсновных(Подготовка.Основной), Название + ": предусловие - основной договор числится основным").ЭтоИстина();
	ЮТест.ОжидаетЧто(Подготовка.Основной, Название + ": предусловие - основной договор другой").НеРавно(Подготовка.Договор);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Договор").Договор, Название + ": предусловие - договор записан в документ")
		.Равно(Подготовка.Договор);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ДанныеДоговора(Подготовка.Договор).ВидДоговора, Название + ": предусловие - вид договора документа")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + Подготовка.ВидДоговораДокумента));

	БезНомера = СМП_ТестыРаспознавания.РаспознатьПодготовку(Шаг5_КопияСНазначением(Подготовка, "СМП_ТЕСТ_ Оплата без номера"));
	СМП_ТестыРаспознавания.ПроверитьДоговор(БезНомера.Строка, Название + ": предусловие - без номера общий выбор дает основной", Подготовка.Основной, "Найден");

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, Название);
	СМП_ТестыРаспознавания.ПроверитьДоговор(Результат.Строка, Название + ": договор найденного документа", Подготовка.Договор, "Найден");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "Договор").Количество(), Название + ": замечаний о договоре нет").Равно(0);

КонецПроцедуры

// Договор найденного документа пуст: завершение выбирает договор как обычно (основной договор контрагента). Предусловие:
// договор в документе действительно пуст (читается из базы), документ по-прежнему проведен, основной договор существует.
Процедура Шаг5_Договор_УДокументаПуст_ОбычныйВыбор() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ПустойДоговорДокумента", Истина));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Договор").Договор),
		"Предусловие: договор в документе пуст").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен").Проведен, "Предусловие: документ без договора остался проведенным").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЕстьВРегистреОсновных(Подготовка.Основной), "Предусловие: основной договор числится основным").ЭтоИстина();

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Договор документа пуст");
	СМП_ТестыРаспознавания.ПроверитьДоговор(Результат.Строка, "Договор документа пуст: обычный выбор", Подготовка.Основной, "Найден");

КонецПроцедуры

// Место среди шагов: шаг 4 (правило по назначению) побеждает номер документа. Предусловие: без правила документ находится, и
// номер документа не встречается в фразе правила.
Процедура Шаг5_Правило_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: без правила документ находится");

	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Поступило", "ПрочиеРасчеты"));
	ЮТест.ОжидаетЧто(СтрНайти(Правило.Фраза, Подготовка.Номер), "Предусловие: номер документа не входит в фразу правила").Равно(0);
	Подготовка.Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза) + " № " + Подготовка.Номер;

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	СМП_ТестыРаспознавания.ПроверитьПравилоПрименено(Результат, "Правило и номер в одном назначении", Правило, "Поступило", "ПрочиеРасчеты");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с правилом").ЭтоЛожь();

КонецПроцедуры

// Место среди шагов: платежное поручение (шаг 3) побеждает номер документа. Списание: поручение того же контрагента с номером
// операции и суммой; в назначении - номер счета поставщика. Предусловие: без поручения счет находится.
Процедура Шаг5_ПлатежноеПоручение_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплатуПоставщика");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: без поручения счет находится");

	Номер = СМП_ТестыРаспознавания.НовыйЦифровойНомер();
	ЮТест.ОжидаетЧто(Номер, "Предусловие: номер поручения не совпадает с номером счета").НеРавно(Подготовка.Номер);
	Подготовка.Операция.НомерДокумента = Номер;
	СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Контрагент, Договор, Сумма, Номер, Дата, ВидОперации, Статья, Корреспонденция",
		Подготовка.Контрагент, Подготовка.Договор, Подготовка.Операция.Сумма, Номер, НачалоДня(Подготовка.Операция.ДатаОперации),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"), СМП_ТестыРаспознавания.СтатьяПоручения(), СМП_ТестыРаспознавания.КорреспонденцияПоручения()));

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида - платежное поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с поручением").ЭтоЛожь();

КонецПроцедуры

// Место среди шагов: загруженный документ (шаг 0) побеждает номер документа и не получает ДокументПоНомеру. Предусловие: без
// загруженного документа счет находится.
Процедура Шаг5_ЗагруженныйДокумент_ПобеждаетДокументПоНомеру() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Подготовка, СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка), "Предусловие: без загруженного документа счет находится");

	Идентификатор = СМП_ТестыРаспознавания.НовыйИдентификатор();
	Банковский = СМП_ТестыРаспознавания.ДокументПоКлючу(СМП_ТестыРаспознавания.НовыйКлюч("А-1"), "ПоступлениеНаСчет", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
	Подготовка.Операция.ИдентификаторОперации = Идентификатор;

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	ЮТест.ОжидаетЧто(Результат.Строка.ЗагруженныйДокумент, "Предусловие: операция сопоставлена с загруженным документом").Равно(Банковский.Ссылка);
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникВидаОперации, "Источник вида - загруженный документ").Равно("ЗагруженныйДокумент");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Строка.ДокументПоНомеру), "Документ по номеру не записан в строку с загруженным документом").ЭтоЛожь();

КонецПроцедуры

// Пустое назначение или из одних пробелов: поиска нет, ошибки нет, вид по умолчанию. Предусловие: с номером документ находится.
Процедура Шаг5_ПустоеНазначение_ПоискаНет(Название, Назначение) Экспорт

	Базовая = Шаг5_Подготовка("СчетНаОплату");
	Шаг5_ПроверитьНайден(Базовая, СМП_ТестыРаспознавания.РаспознатьПодготовку(Базовая), Название + ": предусловие - с номером документ находится");

	Подготовка = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Назначение", Назначение));

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Шаг5_ПроверитьНеНайден(Результат, Название);

КонецПроцедуры

// Пакет: каждая строка находит свой документ; номер документа одного контрагента в назначении строки другого контрагента
// ничего не находит. Предусловие: каждая строка по отдельности дает ожидаемое.
Процедура Шаг5_Пакет_КаждаяСтрокаСвойДокумент() Экспорт

	А1 = Шаг5_Подготовка("СчетНаОплату");
	А2 = Шаг5_ПодготовкаТогоЖеКонтрагента(А1, "СчетНаОплату");
	Б1 = Шаг5_Подготовка("СчетНаОплатуПоставщика");
	Чужая = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Назначение", "СМП_ТЕСТ_ Оплата за рахунок № " + А1.Номер));
	Для Каждого Элемент Из Новый Структура("А1, А2, Б1", А1, А2, Б1) Цикл
		Шаг5_ПроверитьНайден(Элемент.Значение, СМП_ТестыРаспознавания.РаспознатьПодготовку(Элемент.Значение), "Предусловие: строка " + Элемент.Ключ + " по отдельности");
	КонецЦикла;
	Шаг5_ПроверитьНеНайден(СМП_ТестыРаспознавания.РаспознатьПодготовку(Чужая), "Предусловие: номер чужого контрагента по отдельности ничего не находит");

	А1.Операция.ПорядковыйНомер = 1;
	А2.Операция.ПорядковыйНомер = 2;
	Б1.Операция.ПорядковыйНомер = 3;
	Чужая.Операция.ПорядковыйНомер = 4;
	Таблица = СМП_ТестыРаспознавания.ТаблицаОпераций(А1.Операция, А2.Операция, Б1.Операция, Чужая.Операция);

	План = СМП_ТестыРаспознавания.Распознать(Таблица, СМП_ТестыРаспознавания.КонтекстСОрганизацией());

	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1).ДокументПоНомеру, "Строка 1").Равно(А1.Документ);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 2).ДокументПоНомеру, "Строка 2").Равно(А2.Документ);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3).ДокументПоНомеру, "Строка 3 (списание)").Равно(Б1.Документ);
	Строка4 = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 4);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка4.ДокументПоНомеру), "Строка 4: номер документа чужого контрагента ничего не находит").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка4.ИсточникВидаОперации, "Строка 4: значение по умолчанию").Равно("ПоУмолчанию");

КонецПроцедуры

// Шаг ничего не пишет: количества контрагентов, договоров, счетов и банковских документов до и после не меняются, а документ
// найден (иначе равенство снимков могло бы означать, что шагу нечего было делать).
Процедура Шаг5_НеПишетВБазу() Экспорт

	Подготовка = Шаг5_Подготовка("СчетНаОплату");

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Шаг5_ПроверитьНайден(Подготовка, Результат, "Предусловие: документ найден");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После), "Количества объектов до и после Распознать с шагом 5").Равно(СМП_ТестыРаспознавания.ПредставлениеКоличеств(До));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеШага5

// Сценарий шага 5: контрагент (учет по договорам и документам), его договоры (основной и договор документа), документ нужного
// вида с цифровым номером и операция, в назначении которой стоит этот номер. Вид: СчетНаОплату, ЗаказПокупателя,
// ЗаказПоставщику, СчетНаОплатуПоставщика, Акт (документ расчетов покупателя), РасходСоСчета (документ расчетов поставщика).
// Дополнительно - необязательные ключи:
//  * Отличие - одно из "", "непроведен", "помечен", "другаяОрганизация", "другойКонтрагент", "направлениеДругое",
//    "новыйКонтрагент", "расчетыПоДокументамНет"
//  * ШаблонНомера - номер документа, % - цифровой номер сценария; ШаблонНазначения / Назначение - шаблон / готовый текст
//  * ВходящийНомер - у документа поставщика: цифровой номер сценария записан ВХОДЯЩИМ, собственный - другой
//  * ВидДоговораДокумента - вид договора документа ("СПокупателем" / "СПоставщиком"; по умолчанию вид под вид операции)
//  * ПустойДоговорДокумента - договор документа очищен после проведения (СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента)
//  * ДатаДокумента - дата документа; Основа - подготовка, чьего контрагента и договоры взять
//  * Номер - цифровой номер сценария вместо нового
// Результат: Операция, Документ, Контрагент, Договор (документа), Основной, Номер, Вид, Сумма, Поступление,
// ВидДоговораДокумента.
Функция Шаг5_Подготовка(Вид, Дополнительно = Неопределено) Экспорт

	Параметры = Новый Структура("Отличие, ШаблонНомера, ШаблонНазначения, Назначение, ВходящийНомер, ВидДоговораДокумента, "
		+ "ПустойДоговорДокумента, ДатаДокумента, Основа, Номер", "", "%", "СМП_ТЕСТ_ Оплата за рахунок № %", Неопределено, Ложь, Неопределено,
		Ложь, Неопределено, Неопределено, Неопределено);
	Если Дополнительно <> Неопределено Тогда
		Для Каждого Элемент Из Дополнительно Цикл
			Если Не Параметры.Свойство(Элемент.Ключ) Тогда
				ВызватьИсключение "Шаг5_Подготовка: неизвестный ключ '" + Элемент.Ключ + "'";
			КонецЕсли;
			Параметры[Элемент.Ключ] = Элемент.Значение;
		КонецЦикла;
	КонецЕсли;
	Отличие = Параметры.Отличие;

	Поступление = Шаг5_ЭтоВидПокупателя(Вид);
	Если Отличие = "направлениеДругое" Тогда
		НаправлениеОперации = ?(Поступление, "Списано", "Поступило");
	Иначе
		НаправлениеОперации = ?(Поступление, "Поступило", "Списано");
	КонецЕсли;
	ВидДоговора = ?(Поступление, "СПокупателем", "СПоставщиком");
	ВидДоговораДокумента = ?(Параметры.ВидДоговораДокумента = Неопределено, ВидДоговора, Параметры.ВидДоговораДокумента);

	Если Параметры.Основа <> Неопределено Тогда
		Контрагент = Параметры.Основа.Контрагент;
		Основной = Параметры.Основа.Основной;
		Договор = Параметры.Основа.Договор;
	Иначе
		Контрагент = СМП_ТестыРаспознавания.НовыйКонтрагентТеста(Новый Структура("ВестиРасчетыПоДокументам", Отличие <> "расчетыПоДокументамНет"));
		Основной = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора), СМП_ТестыДанныеУНФ.Организация()));
		Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговораДокумента)));
	КонецЕсли;

	Номер = ?(Параметры.Номер = Неопределено, СМП_ТестыРаспознавания.НовыйЦифровойНомер(), Параметры.Номер);
	Сумма = СМП_ТестыРаспознавания.УникальнаяСумма();
	НомерДокумента = СтрЗаменить(Параметры.ШаблонНомера, "%", Номер);

	// Документ: другой контрагент (отличие) - документ принадлежит другому контрагенту с такими же договорами.
	КонтрагентДокумента = Контрагент;
	ДоговорДокумента = Договор;
	Если Отличие = "другойКонтрагент" Тогда
		КонтрагентДокумента = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		ДоговорДругого = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(КонтрагентДокумента, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора), СМП_ТестыДанныеУНФ.Организация()));
		ДоговорДокумента = ДоговорДругого;
	КонецЕсли;

	Настройки = Новый Структура;
	Если Параметры.ВходящийНомер Тогда
		Настройки.Вставить("НомерВходящегоДокумента", НомерДокумента);
		Собственный = СМП_ТестыРаспознавания.НовыйЦифровойНомер();
		Пока Собственный = Номер Цикл
			Собственный = СМП_ТестыРаспознавания.НовыйЦифровойНомер();
		КонецЦикла;
		Настройки.Вставить("Номер", Собственный);
	Иначе
		Настройки.Вставить("Номер", НомерДокумента);
	КонецЕсли;
	Если Параметры.ДатаДокумента <> Неопределено Тогда
		Настройки.Вставить("Дата", Параметры.ДатаДокумента);
	КонецЕсли;
	Если Отличие = "помечен" Тогда
		Настройки.Вставить("ПометкаУдаления", Истина);
	КонецЕсли;
	ДокументРасчетов = (Вид = "Акт" Или Вид = "ПриходнаяНакладная" Или Вид = "РасходСоСчета" Или Вид = "ПоступлениеНаСчет");
	Если Отличие = "другаяОрганизация" И ДокументРасчетов Тогда
		ВызватьИсключение "Шаг5_Подготовка: для документа расчетов отличие 'другаяОрганизация' не строится (расчеты пишутся на компанию)";
	КонецЕсли;
	Если Отличие = "другаяОрганизация" Тогда
		ДругаяОрганизация = СМП_ТестыДанныеУНФ.НоваяОрганизация();
		ДоговорДокумента = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора, Организация",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговораДокумента), ДругаяОрганизация));
		Настройки.Вставить("Организация", ДругаяОрганизация);
	КонецЕсли;

	Документ = Шаг5_СоздатьДокумент(Вид, КонтрагентДокумента, ДоговорДокумента, Сумма, Отличие <> "непроведен" И Отличие <> "помечен", Настройки);
	Если Параметры.ПустойДоговорДокумента Тогда
		СМП_ТестыДанныеУНФ.ОчиститьДоговорДокумента(Документ);
	КонецЕсли;

	// Организацию документа расчетов отдельным отличием проверить нельзя: вендор пишет расчеты не на организацию документа, а на
	// "компанию" (Константы.УчетПоКомпании.Компания(Организация)), и в этой базе компания одна для всех организаций (измерено).
	// Контекст распознавания - по умолчанию (СМП_ТестыРаспознавания.КонтекстСОрганизацией).

	// Операция: контрагент найденный по коду (или код, которого в базе нет).
	КодКонтрагента = ?(Отличие = "новыйКонтрагент", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), СМП_ТестыРаспознавания.ДанныеКонтрагента(Контрагент).Код);
	Назначение = ?(Параметры.Назначение = Неопределено, СтрЗаменить(Параметры.ШаблонНазначения, "%", Номер), Параметры.Назначение);
	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, КонтрагентКод, КонтрагентНаименование, Сумма, НазначениеПлатежа",
		1, СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.Направление" + НаправлениеОперации), КодКонтрагента, "", Сумма, Назначение));

	Результат = Новый Структура("Операция, Документ, Контрагент, Договор, Основной, Номер, Вид, Сумма, Поступление, ВидДоговораДокумента");
	Результат.Операция = Операция;
	Результат.Документ = Документ;
	Результат.Контрагент = Контрагент;
	Результат.Договор = Договор;
	Результат.Основной = Основной;
	Результат.Номер = Номер;
	Результат.Вид = Вид;
	Результат.Сумма = Сумма;
	Результат.Поступление = Поступление;
	Результат.ВидДоговораДокумента = ВидДоговораДокумента;

	Возврат Результат;

КонецФункции

// Вид, документы которого относятся к покупателю (поступление): остальные - к поставщику (списание).
Функция Шаг5_ЭтоВидПокупателя(Вид)

	Возврат Вид = "СчетНаОплату" Или Вид = "ЗаказПокупателя" Или Вид = "Акт" Или Вид = "ПоступлениеНаСчет";

КонецФункции

Функция Шаг5_СоздатьДокумент(Вид, Контрагент, Договор, Сумма, Провести, Настройки)

	Если Вид = "СчетНаОплату" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "ЗаказПокупателя" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "ЗаказПоставщику" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "СчетНаОплатуПоставщика" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "Акт" Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "ПриходнаяНакладная" Тогда
		Возврат СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Контрагент, Договор, Сумма, Провести, Настройки);
	ИначеЕсли Вид = "РасходСоСчета" Или Вид = "ПоступлениеНаСчет" Тогда
		// Банковский документ без документа-основания оставляет в регистре взаиморасчетов АВАНС (покупателя или поставщику),
		// а не долг; ключи построителя банковского документа свои.
		Если Настройки.Свойство("Организация") Или Настройки.Свойство("НомерВходящегоДокумента") Тогда
			ВызватьИсключение "Шаг5_СоздатьДокумент: банковский документ не принимает Организацию и НомерВходящегоДокумента";
		КонецЕсли;
		Ключи = Новый Структура("ВидДокумента, Контрагент, Договор, Сумма, Проведен", Вид, Контрагент, Договор, Сумма, Провести);
		Если Настройки.Свойство("Номер") Тогда
			Ключи.Вставить("Номер", Настройки.Номер);
		КонецЕсли;
		Если Настройки.Свойство("Дата") Тогда
			Ключи.Вставить("Дата", Настройки.Дата);
		КонецЕсли;
		Если Настройки.Свойство("ПометкаУдаления") Тогда
			Ключи.Вставить("ПометкаУдаления", Настройки.ПометкаУдаления);
		КонецЕсли;
		Возврат СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Ключи);
	КонецЕсли;

	ВызватьИсключение "Шаг5_СоздатьДокумент: неизвестный вид '" + Вид + "'";

КонецФункции

// Еще один документ того же контрагента и договора. НомерДокумента - номер строкой (как записать).
Функция Шаг5_ДобавитьДокумент(Подготовка, Вид, НомерДокумента)

	Возврат Шаг5_СоздатьДокумент(Вид, Подготовка.Контрагент, Подготовка.Договор, Подготовка.Сумма + 1, Истина,
		Новый Структура("Номер", НомерДокумента));

КонецФункции

// Второй сценарий того же контрагента с другим цифровым номером (или заданным), документом вида Вид и своей операцией.
Функция Шаг5_ПодготовкаТогоЖеКонтрагента(Первая, Вид, ШаблонНомера = "%", Номер = Неопределено)

	Новая = Шаг5_Подготовка(Вид, Новый Структура("Основа, ШаблонНомера, Номер", Первая, ШаблонНомера, Номер));
	Новая.Операция.ПорядковыйНомер = 2;

	Возврат Новая;

КонецФункции

// Копия подготовки с другим назначением операции (документ тот же).
Функция Шаг5_КопияСНазначением(Подготовка, Назначение)

	Копия = Новый Структура;
	Для Каждого Элемент Из Подготовка Цикл
		Копия.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Операция = Новый Структура;
	Для Каждого Элемент Из Подготовка.Операция Цикл
		Операция.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Операция.НазначениеПлатежа = Назначение;
	Копия.Операция = Операция;

	Возврат Копия;

КонецФункции

// Два счета покупателю с одним номером в разные годы: текущего года и прошлого. ПрошлогоднийПервым - порядок создания.
// ГодВНазначении: "текущий", "прошлый", "оба", "нет", "третий" (позапрошлый), "внутриЧисла" (текущий год внутри более длинного
// числа). Назначение: номер счета и (кроме "нет") дата с годом.
Функция Шаг5_ПодготовкаДвухГодов(ПрошлогоднийПервым, ГодВНазначении, КороткийНомер = Неопределено)

	Момент = ТекущаяДатаСеанса();
	ДатаПрошлого = ДобавитьМесяц(Момент, -12);
	ГодТекущий = Формат(Год(Момент), "ЧГ=0");
	ГодПрошлый = Формат(Год(ДатаПрошлого), "ЧГ=0");

	Хвост = "";
	Если ГодВНазначении = "текущий" Тогда
		Хвост = " від 15.03." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "прошлый" Тогда
		Хвост = " від 15.03." + ГодПрошлый;
	ИначеЕсли ГодВНазначении = "оба" Тогда
		Хвост = " від 15.03." + ГодПрошлый + " і від 15.03." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "третий" Тогда
		Хвост = " від 15.03." + Формат(Год(ДатаПрошлого) - 1, "ЧГ=0");
	ИначеЕсли ГодВНазначении = "внутриЧисла" Тогда
		Хвост = " на суму 1" + ГодТекущий + "5 грн";
	ИначеЕсли ГодВНазначении = "текущийВДате" Тогда
		// Год внутри даты дд.мм.рррр: для года межа - только "не цифра", точка с цифрами его не соединяет.
		Хвост = " від 12.10." + ГодТекущий;
	ИначеЕсли ГодВНазначении = "прошлыйВДате" Тогда
		Хвост = " від 12.10." + ГодПрошлый;
	ИначеЕсли ГодВНазначении <> "нет" Тогда
		ВызватьИсключение "Шаг5_ПодготовкаДвухГодов: неизвестный год в назначении '" + ГодВНазначении + "'";
	КонецЕсли;

	Первый = Шаг5_Подготовка("СчетНаОплату", Новый Структура("ДатаДокумента, ШаблонНазначения, Номер",
		?(ПрошлогоднийПервым, ДатаПрошлого, Момент), "СМП_ТЕСТ_ Оплата за рахунок № %" + Хвост, КороткийНомер));
	Второй = Шаг5_Подготовка("СчетНаОплату", Новый Структура("Основа, Номер, ДатаДокумента",
		Первый, Первый.Номер, ?(ПрошлогоднийПервым, Момент, ДатаПрошлого)));

	Результат = Новый Структура("Текущий, Прошлогодний, Номер, Контрагент, Операция");
	Результат.Текущий = ?(ПрошлогоднийПервым, Второй.Документ, Первый.Документ);
	Результат.Прошлогодний = ?(ПрошлогоднийПервым, Первый.Документ, Второй.Документ);
	Результат.Номер = Первый.Номер;
	Результат.Контрагент = Первый.Контрагент;
	Результат.Операция = Первый.Операция;

	Возврат Результат;

КонецФункции

// Остаток документа расчетов: число строк регистра взаиморасчетов с ненулевым остатком по организации документа, контрагенту и
// самому документу (Акт - РасчетыСПокупателями, РасходСоСчета - РасчетыСПоставщиками).
Функция Шаг5_ЧислоНенулевыхОстатков(Подготовка)

	ИмяРегистра = Шаг5_ИмяРегистра(Подготовка.Вид);
	// Организация не фильтруется: документ расчетов принадлежит контрагенту и документу, а организация регистра в этой базе
	// не равна организации документа (регистры пишутся на "компанию", см. Шаг5_Подготовка).
	// Остаток - в валюте расчетов (СуммаВалОстаток, как у шага): остаток в валюте учета может давать копейки от разницы курсов, когда
	// акт и оплата попадают в разные сутки (около полуночи сеанса), и не является долгом.
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(ВЫБОР КОГДА О.СуммаВалОстаток <> 0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0) КАК Количество
		|ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки(, Контрагент = &Контрагент И Документ = &Документ) КАК О");
	Запрос.УстановитьПараметр("Контрагент", СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Контрагент").Контрагент);
	Запрос.УстановитьПараметр("Документ", Подготовка.Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Документы, оставляющие ДОЛГ в регистре взаиморасчетов: акт (покупатель), приходная накладная (поставщик).
Функция Шаг5_ЭтоДокументСДолгом(Вид)

	Возврат Вид = "Акт" Или Вид = "ПриходнаяНакладная";

КонецФункции

// Долг (тип "Долг") контрагента по регистру взаиморасчетов целиком, без разреза по документу (сумма в валюте расчетов).
Функция Шаг5_ДолгКонтрагента(Подготовка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(О.СуммаВалОстаток), 0) КАК Сумма
		|ИЗ РегистрНакопления." + Шаг5_ИмяРегистра(Подготовка.Вид) + ".Остатки(, Контрагент = &Контрагент И ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)) КАК О");
	Запрос.УстановитьПараметр("Контрагент", СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Контрагент").Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

// Регистр взаиморасчетов вида документа: покупатель (акт, оплата покупателя) или поставщик.
Функция Шаг5_ИмяРегистра(Вид)

	Возврат ?(Вид = "Акт" Или Вид = "ПоступлениеНаСчет", "РасчетыСПокупателями", "РасчетыСПоставщиками");

КонецФункции

// Рухи регістра розрахунків документом вендора КорректировкаРегистров (він не проводиться, пише рухи при запису - та сама
// модель, що в реальних даних з ручними коригуваннями). Рухи привязані до документа розрахунків Подготовка.Документ (вимір
// "Документ"), решта вимірів і реквізитів береться з власного руху цього документа. Строки - масив структур
// "Тип, Увеличение, Коэффициент": тип розрахунків ("Долг"/"Аванс"), напрямок (Истина - як у власного руху документа, тобто
// збільшує залишок; Ложь - протилежний) і частка сум власного руху (1 = сума документа). Тільки в транзакції тесту.
Функция Шаг5_Корректировка(Подготовка, Строки)

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Шаг5_Корректировка: запись вне транзакции теста";
	КонецЕсли;

	ИмяРегистра = Шаг5_ИмяРегистра(Подготовка.Вид);
	Набор = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Подготовка.Документ);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ВызватьИсключение "Шаг5_Корректировка: у документа расчетов нет собственных рухов в " + ИмяРегистра;
	КонецЕсли;
	Источник = Набор[0];
	ОписаниеРегистра = Метаданные.РегистрыНакопления[ИмяРегистра];

	Документ = Документы.КорректировкаРегистров.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Движения = Документ.Движения[ИмяРегистра];
	Движения.Записывать = Истина;

	Для Каждого Описание Из Строки Цикл
		Запись = Движения.Добавить();
		Для Каждого Поле Из ОписаниеРегистра.Измерения Цикл
			Запись[Поле.Имя] = Источник[Поле.Имя];
		КонецЦикла;
		Для Каждого Поле Из ОписаниеРегистра.Реквизиты Цикл
			Запись[Поле.Имя] = Источник[Поле.Имя];
		КонецЦикла;
		Для Каждого Поле Из ОписаниеРегистра.Ресурсы Цикл
			Запись[Поле.Имя] = Источник[Поле.Имя] * Описание.Коэффициент;
		КонецЦикла;
		Запись.Период = Документ.Дата;
		Запись.ТипРасчетов = ПредопределенноеЗначение("Перечисление.ТипыРасчетов." + Описание.Тип);
		Приход = (Источник.ВидДвижения = ВидДвиженияНакопления.Приход);
		Запись.ВидДвижения = ?(Описание.Увеличение = Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
	КонецЦикла;

	Документ.Записать(РежимЗаписиДокумента.Запись);

	Возврат Документ.Ссылка;

КонецФункции

// Сумма в валюте расчетов (текущий остаток) документа расчетов по типу расчетов: Долг или Аванс. Знак - как в регистре.
Функция Шаг5_ОстатокПоТипу(Подготовка, ИмяТипа)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(О.СуммаВалОстаток), 0) КАК Сумма
		|ИЗ РегистрНакопления." + Шаг5_ИмяРегистра(Подготовка.Вид) + ".Остатки(, Контрагент = &Контрагент И Документ = &Документ И ТипРасчетов = &Тип) КАК О");
	Запрос.УстановитьПараметр("Контрагент", СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Контрагент").Контрагент);
	Запрос.УстановитьПараметр("Документ", Подготовка.Документ);
	Запрос.УстановитьПараметр("Тип", ПредопределенноеЗначение("Перечисление.ТипыРасчетов." + ИмяТипа));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

// Предусловие учета по компании: компания организации фикстур (функция вендора) НЕ равна самой организации - иначе фильтр
// регистра по организации контекста неотличим от фильтра по компании. Читается из базы до вызова распознавания.
Процедура Шаг5_ПроверитьКомпаниюНеОрганизация(Описание)

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Компания = Константы.УчетПоКомпании.Компания(Организация);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Компания), Описание + ": предусловие - компания организации фикстур определена").ЭтоИстина();
	ЮТест.ОжидаетЧто(Компания, Описание + ": предусловие - компания организации фикстур (" + Организация + ") не равна организации")
		.НеРавно(Организация);

КонецПроцедуры

// Документ создан, номер записан, проведен и принадлежит организации по умолчанию; для документа расчетов остаток не нулевой.
Процедура Шаг5_ПроверитьПредусловиеДокумента(Подготовка, Описание)

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Подготовка.Документ), Описание + ": предусловие - документ создан").ЭтоИстина();
	Данные = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен, ПометкаУдаления, Организация");
	ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Описание + ": предусловие - документ не помечен на удаление").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Данные.Организация, Описание + ": предусловие - организация документа - организация контекста").Равно(СМП_ТестыДанныеУНФ.Организация());
	Если Шаг5_ЭтоДокументСДолгом(Подготовка.Вид) Тогда
		ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), Описание + ": предусловие - остаток документа расчетов не нулевой").НеРавно(0);
		ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Долг") > 0, Описание + ": предусловие - долг (тип Долг) положительный").ЭтоИстина();
		ЮТест.ОжидаетЧто(Шаг5_ОстатокПоТипу(Подготовка, "Аванс"), Описание + ": предусловие - аванса по документу нет").Равно(0);
		Шаг5_ПроверитьКомпаниюНеОрганизация(Описание);
	КонецЕсли;

КонецПроцедуры

// Отличие действительно записано в данные (иначе "не кандидат" могло быть следствием ошибки сценария).
Процедура Шаг5_ПроверитьОтличиеЗаписано(Подготовка, Отличие, Описание)

	Данные = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Документ, "Проведен, ПометкаУдаления, Организация, Контрагент");
	Если Отличие = "непроведен" Тогда
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ не проведен").ЭтоЛожь();
	ИначеЕсли Отличие = "помечен" Тогда
		ЮТест.ОжидаетЧто(Данные.ПометкаУдаления, Описание + ": предусловие - документ помечен на удаление").ЭтоИстина();
		// Платформа отменяет проведение при пометке (проведенного помеченного документа не бывает - измерено): помеченный
		// документ отсеивается и по признаку проведения, и по пометке; отдельно пометку удаления тестом не изолировать.
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - платформа отменила проведение помеченного документа").ЭтоЛожь();
		Если Шаг5_ЭтоДокументСДолгом(Подготовка.Вид) Тогда
			ЮТест.ОжидаетЧто(Шаг5_ЧислоНенулевыхОстатков(Подготовка), Описание + ": предусловие - у помеченного остатка нет").Равно(0);
		КонецЕсли;
	ИначеЕсли Отличие = "другаяОрганизация" Тогда
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ другой организации проведен").ЭтоИстина();
		ЮТест.ОжидаетЧто(Данные.Организация, Описание + ": предусловие - организация документа другая").НеРавно(СМП_ТестыДанныеУНФ.Организация());
	ИначеЕсли Отличие = "другойКонтрагент" Тогда
		ЮТест.ОжидаетЧто(Данные.Контрагент, Описание + ": предусловие - контрагент документа другой").НеРавно(Подготовка.Контрагент);
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ другого контрагента проведен").ЭтоИстина();
	ИначеЕсли Отличие = "направлениеДругое" Тогда
		Ожидаемое = СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка." + ?(Подготовка.Поступление, "НаправлениеСписано", "НаправлениеПоступило"));
		ЮТест.ОжидаетЧто(Подготовка.Операция.Направление, Описание + ": предусловие - направление операции другое").Равно(Ожидаемое);
		ЮТест.ОжидаетЧто(Данные.Проведен, Описание + ": предусловие - документ проведен").ЭтоИстина();
	Иначе
		ВызватьИсключение "Шаг5_ПроверитьОтличиеЗаписано: неизвестное отличие '" + Отличие + "'";
	КонецЕсли;

КонецПроцедуры

// Найден: документ, источник вида, вид операции по направлению, контрагент остался найденным, "Проверьте операцию" не стоит,
// замечаний о документе нет.
Процедура Шаг5_ПроверитьНайден(Подготовка, Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ДокументПоНомеру, Описание + ": документ по номеру").Равно(Подготовка.Документ);
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - документ по номеру").Равно("ДокументПоНомеру");
	Если Подготовка.Поступление Тогда
		ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции - от покупателя")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя"));
	Иначе
		ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции - поставщику")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"));
	КонецЕсли;
	ЮТест.ОжидаетЧто(Строка.Контрагент, Описание + ": контрагент остается найденным").Равно(Подготовка.Контрагент);
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": действие над контрагентом").Равно("Найден");
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию' не ставится").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру").Количество(), Описание + ": замечаний о документе нет").Равно(0);

КонецПроцедуры

// Не найден: документ пуст, вид операции дало значение по умолчанию.
Процедура Шаг5_ПроверитьНеНайден(Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.ДокументПоНомеру), Описание + ": документ по номеру не найден").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида - значение по умолчанию").Равно("ПоУмолчанию");

КонецПроцедуры

// Ровно одно предупреждение на поле ДокументПоНомеру с номером документов, ошибок нет.
Процедура Шаг5_ПроверитьПредупреждениеОКандидатах(Результат, Описание, Номер)

	Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", СМП_ТестыРаспознавания.УровеньПредупреждение());
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": одно предупреждение о нескольких документах").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": в предупреждении номер документов").Содержит(Номер);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "ДокументПоНомеру", СМП_ТестыРаспознавания.УровеньОшибка()).Количество(), Описание + ": ошибок о документе нет").Равно(0);

КонецПроцедуры

#КонецОбласти
