// Тесты записи документов банка: основа - ДОКУМЕНТ РАСЧЕТОВ (акт выполненных работ, расходная накладная покупателю, приходная накладная
// поставщика; задача 7 плана 04; D21 "Документ расчетов как основа", D34). Зона: режим суммы (метод Сумма не принимает - всегда "без Сумма"),
// колонка Документ при ВестиРасчетыПоДокументам = Да / Нет, меньше / равно / больше с пересчетом СуммаРасчетов и СуммаНДС, статья ДДС (акт ее
// не ставит - ставит продукт до ПроверитьЗаполнение), способ зачета "Вручную" ставит продукт независимо от метода (D34), проверка основы.
// Заказы и счета - СМП_ТестыЗаписиОснование (ее экспортные помощники используются, не копируются).
//
// ИСТОРИЯ ЦВЕТА (журнал плана 04, задача 7): продукт веток этих типов написан в коммите B раньше тестов этой зоны (вызов методов для документов
// расчетов был в общей функции), поэтому тесты не были красными до продукта; доказательство - мутации веток по типам (журнал).
//
// Методы (параметр Метод): "ПНС.Акт" - ПоступлениеНаСчет.ЗаполнитьПоАктуВыполненныхРабот, "ПНС.Расходная" - ПоступлениеНаСчет.
// ЗаполнитьПоРасходнойНакладной, "РС.Приходная" - РасходСоСчета.ЗаполнитьПоПриходнаяНакладная. Условия измерения - как в
// СМП_ТестыЗаписиОснование (Условия_РежимБазыИзмерения): организация - неплательщик НДС (документ с НДС проводится), UAH, константа способа
// разноса Авто. Фрагменты причин по-русски: условие "русский сеанс".
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: условия");
	Набор.ДобавитьСерверныйТест("Условия_РежимБазыИзмерения").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: режим суммы и колонка Документ (D21, документ расчетов как основа)");
	Набор.ДобавитьСерверныйТест("Сумма_ДокументРасчетов").ВТранзакции()
		// Описание, Метод, ВестиРасчетыПоДокументам, СуммаОсновы, СуммаБанка, СНДС
		.СПараметрами("акт, по документам = Да: меньше, с НДС", "ПНС.Акт", Истина, 1200, 600, Истина)
		.СПараметрами("акт, по документам = Да: равно, с НДС", "ПНС.Акт", Истина, 1200, 1200, Истина)
		.СПараметрами("акт, по документам = Да: больше, с НДС", "ПНС.Акт", Истина, 1200, 1500, Истина)
		.СПараметрами("акт, по документам = Нет: меньше, без НДС", "ПНС.Акт", Ложь, 1000, 400, Ложь)
		.СПараметрами("акт, по документам = Нет: больше, без НДС", "ПНС.Акт", Ложь, 1000, 1300, Ложь)
		.СПараметрами("расходная, по документам = Да: меньше, с НДС", "ПНС.Расходная", Истина, 1500, 900, Истина)
		.СПараметрами("расходная, по документам = Да: больше, без НДС", "ПНС.Расходная", Истина, 1000, 1300, Ложь)
		.СПараметрами("расходная, по документам = Нет: меньше, с НДС", "ПНС.Расходная", Ложь, 1200, 600, Истина)
		.СПараметрами("расходная, по документам = Нет: больше, с НДС", "ПНС.Расходная", Ложь, 1200, 1500, Истина)
		.СПараметрами("приходная, по документам = Да: меньше", "РС.Приходная", Истина, 800, 300, Ложь)
		.СПараметрами("приходная, по документам = Да: больше", "РС.Приходная", Истина, 800, 1000, Ложь)
		.СПараметрами("приходная, по документам = Нет: меньше", "РС.Приходная", Ложь, 800, 300, Ложь)
		.СПараметрами("приходная, по документам = Нет: больше", "РС.Приходная", Ложь, 800, 1000, Ложь);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: статья ДДС ставится продуктом до проверки заполнения (D14)");
	Набор.ДобавитьСерверныйТест("Статья_ДокументРасчетов_ДокументПроводится").ВТранзакции()
		// Описание, Метод, СтатьяВПлане: статья плана важнее статьи вендора по виду; в плане пусто - вендорская статья по виду.
		.СПараметрами("акт, статья плана", "ПНС.Акт", Истина)
		.СПараметрами("акт, статьи в плане нет", "ПНС.Акт", Ложь)
		.СПараметрами("расходная, статья плана", "ПНС.Расходная", Истина)
		.СПараметрами("расходная, статьи в плане нет", "ПНС.Расходная", Ложь)
		.СПараметрами("приходная, статья плана", "РС.Приходная", Истина)
		.СПараметрами("приходная, статьи в плане нет", "РС.Приходная", Ложь);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: способ зачета ставит продукт, не метод (D34)");
	Набор.ДобавитьСерверныйТест("СпособЗачета_ДокументРасчетов_СтавитПродуктДоЗаписи").ВТранзакции()
		// Описание, Метод, ПустойУМетода: метод вендора сам способ не ставит (измерено для расходной накладной).
		.СПараметрами("акт", "ПНС.Акт", Ложь)
		.СПараметрами("расходная", "ПНС.Расходная", Истина)
		.СПараметрами("приходная", "РС.Приходная", Ложь);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: проверка основы до вызова метода (D21)");
	Набор.ДобавитьСерверныйТест("Проверка_ДокументРасчетовНеПроведен_НеБерется").ВТранзакции()
		.СПараметрами("акт", "ПНС.Акт")
		.СПараметрами("расходная", "ПНС.Расходная")
		.СПараметрами("приходная", "РС.Приходная");

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Расчеты: сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Условия

Процедура Условия_РежимБазыИзмерения() Экспорт

	СМП_ТестыЗаписиОснование.Условия_РежимБазыИзмерения();

КонецПроцедуры

#КонецОбласти

#Область Тесты

// D21, "Документ расчетов как основа": метод Сумма не принимает, режим один - "без Сумма"; сумма документа расчетов = остаток, который метод
// кладет в строку. Колонка Документ строки - сам документ при ВестиРасчетыПоДокументам = Да и пуста при Нет (журнал плана 04, задача 2,
// находка 13). Дальше как для заказов: банк заплатил меньше - строка уменьшается, СуммаРасчетов и СуммаНДС пересчитываются продуктом
// (находка 17) и сохраняются проведенным документом; больше - строка аванса на разницу без документа расчетов; равно - одна строка.
// ПризнакАванса основы - Нет (находка 13: метод не считает платеж по документу авансом).
Процедура Сумма_ДокументРасчетов(Описание, Метод, ПоДокументам, СуммаОсновы, СуммаБанка, СНДС) Экспорт

	Основа = НоваяОснова(Метод, СуммаОсновы, ПоДокументам, СНДС);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Контрагент, "ВестиРасчетыПоДокументам"),
		Описание + ": предусловие - ВестиРасчетыПоДокументам в базе").Равно(ПоДокументам);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Основание, "Проведен"), Описание + ": предусловие - документ расчетов проведен")
		.ЭтоИстина();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СМП_ТестыЗаписиОснование.ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	ПроверитьДокументРасчетов(Прогон, Основа, СМП_ТестыЗаписиОснование.ОжидаемыеСтрокиСОснованием(СуммаОсновы, СуммаБанка, СНДС), СуммаБанка,
		ПоДокументам, Описание);

КонецПроцедуры

// Акт не ставит статью ДДС (находка 13): без нее документ не проходит ПроверитьЗаполнение, и продукт ставит статью до проверки - статью
// плана (D14), а когда ее нет, вендорскую по виду операции. Статья плана - "Прочее", не равная статье вида (иначе "статья плана" и "статья
// по виду" не различить). Утверждается итог: документ ПРОВЕДЕН (ПроверитьЗаполнение прошла) и статья на месте (в шапке или в строке - в
// зависимости от положения статьи ответственного, у фикстурного ответственного настроек нет - в шапке).
Процедура Статья_ДокументРасчетов_ДокументПроводится(Описание, Метод, СтатьяВПлане) Экспорт

	Основа = НоваяОснова(Метод, 1000, Истина, Ложь);
	ПоВиду = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств." + ?(СМП_ТестыЗаписиОснование.ЭтоИсходящий(Метод), "ОплатаПоставщикам", "ОплатаОтПокупателей"));
	СтатьяПлана = Справочники.СтатьиДвиженияДенежныхСредств.Прочее;
	ЮТест.ОжидаетЧто(СтатьяПлана, Описание + ": предусловие - статья плана не равна статье по виду").НеРавно(ПоВиду);
	Ожидаемая = ?(СтатьяВПлане, СтатьяПлана, ПоВиду);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СМП_ТестыЗаписиОснование.ДобавитьСтрокуОсновы(План, Основа, 1000, Новый Структура("СтатьяДДС",
		?(СтатьяВПлане, СтатьяПлана, Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка())));

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")")
		.Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята").Равно(Основа.Основание);
	СтатьяДокумента = ?(ЗначениеЗаполнено(Объект.Статья), Объект.Статья, Объект.РасшифровкаПлатежа[0].СтатьяДДС);
	ЮТест.ОжидаетЧто(СтатьяДокумента, Описание + ": статья документа").Равно(Ожидаемая);

КонецПроцедуры

// D34: способ зачета строк основы и аванса на разницу - "Вручную", ставит ПРОДУКТ независимо от того, что поставил метод (акт ставит
// "Вручную", расходная накладная - нет). Тест заполняет ОТКРЫТЫЙ объект (без записи): при записи пустой способ вендор превращает в "Вручную"
// сам, и после записи не отличить. Константа способа разноса = Авто (условие), поэтому цепочка вендора для "ничего не найдено" дала бы Авто.
// ВариантЗаполненияРасшифровки не "Автоматически" (иначе вендор при проведении перезаполнит расшифровку сам - передумова перерасчета).
Процедура СпособЗачета_ДокументРасчетов_СтавитПродуктДоЗаписи(Описание, Метод, ПустойУМетода) Экспорт

	СуммаОсновы = 1000;
	СуммаБанка = 1300;
	Основа = НоваяОснова(Метод, СуммаОсновы, Истина, Ложь);
	Вручную = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;

	Если ПустойУМетода Тогда
		Проба = ?(СМП_ТестыЗаписиОснование.ЭтоИсходящий(Метод), Документы.РасходСоСчета.СоздатьДокумент(), Документы.ПоступлениеНаСчет.СоздатьДокумент());
		Проба.Дата = ТекущаяДатаСеанса();
		Если Метод = "ПНС.Расходная" Тогда
			Проба.ЗаполнитьПоРасходнойНакладной(Основа.Основание);
		КонецЕсли;
		ЮТест.ОжидаетЧто(Проба.РасшифровкаПлатежа.Количество(), Описание + ": предусловие - метод вендора дал строку").Равно(1);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Проба.РасшифровкаПлатежа[0].СпособЗачета), Описание + ": предусловие - метод вендора способ зачета не ставит")
			.ЭтоЛожь();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Константы.СпособРазнесенияОплатыПоУмолчанию.Получить(), Описание + ": предусловие - константа способа разноса Авто")
		.Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = СМП_ТестыЗаписиОснование.ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);
	Объект = ?(СМП_ТестыЗаписиОснование.ЭтоИсходящий(Метод), Документы.РасходСоСчета.СоздатьДокумент(), Документы.ПоступлениеНаСчет.СоздатьДокумент());
	СМП_ТестыЗаписиОснование.ЗаполнитьОткрытыйДокумент(Объект, СтрокаПлана);

	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": две строки (основа и аванс на разницу)").Равно(2);
	Для Каждого Строка Из Объект.РасшифровкаПлатежа Цикл
		ЮТест.ОжидаетЧто(Строка.СпособЗачета, Описание + ": строка " + Строка.НомерСтроки + ": способ зачета - Вручную, поставлен до записи").Равно(Вручную);
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.РасшифровкаПлатежа[1].Документ), Описание + ": строка аванса без документа расчетов").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Объект.ВариантЗаполненияРасшифровки, Описание + ": ВариантЗаполненияРасшифровки не Автоматически")
		.НеРавно(Перечисления.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически);

КонецПроцедуры

// D21: проверка основы ДО вызова действует и для документов расчетов: непроведенная накладная или акт не берется (метод вендора проведение
// не проверяет). Результат - документ без основы, одно предупреждение, причина названа.
Процедура Проверка_ДокументРасчетовНеПроведен_НеБерется(Описание, Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000, Истина, Ложь, Ложь);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиОснование.РеквизитСсылки(Основа.Основание, "Проведен"), Описание + ": предусловие - документ расчетов не проведен").ЭтоЛожь();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СМП_ТестыЗаписиОснование.ДобавитьСтрокуОсновы(План, Основа, 700);

	Прогон = СМП_ТестыЗаписиОснование.ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.ДокументОснование), Описание + ": основа не взята - ДокументОснование пусто").ЭтоЛожь();
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": ровно одно предупреждение (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")")
		.Равно(1);
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": причина названа").Содержит("не проведен");
	Для Каждого Строка Из Объект.РасшифровкаПлатежа Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Документ), Описание + ": в строке нет документа расчетов").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Сторож

Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Контрагент (с расчетами по договорам и признаком ВестиРасчетыПоДокументам), договор нужного вида и документ расчетов нужного типа.
// Возвращает структуру, совместимую с помощниками СМП_ТестыЗаписиОснование: Контрагент, Договор, Основание, Сумма, Метод.
Функция НоваяОснова(Метод, Сумма, ПоДокументам, СНДС, Провести = Истина)

	Признаки = Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, ПоДокументам, Истина, Ложь);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(СМП_ТестыЗаписиОснование.ЭтоИсходящий(Метод), "СПоставщиком", "СПокупателем"))));
	Параметры = Новый Структура;
	Если СНДС Тогда
		Параметры.Вставить("СНДС", Истина);
	КонецЕсли;

	Если Метод = "ПНС.Акт" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Провести, Параметры);
	ИначеЕсли Метод = "ПНС.Расходная" Тогда
		Основание = СМП_ТестыДанныеУНФ.НоваяРасходнаяНакладная(Контрагент, Договор, Сумма, Провести, Параметры);
	ИначеЕсли Метод = "РС.Приходная" Тогда
		Основание = СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Контрагент, Договор, Сумма, Провести, Параметры);
	Иначе
		ВызватьИсключение "СМП_ТестыЗаписиОснованиеРасчеты: неизвестный метод " + Метод;
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор, Основание, Сумма, Метод", Контрагент, Договор, Основание, Сумма, Метод);

КонецФункции

// Проверка документа, записанного с документом расчетов: результат, шапка, строки расшифровки по ожиданию. Колонка Документ строки основы -
// документ расчетов при ВестиРасчетыПоДокументам = Да и пуста при Нет; у строки аванса колонок основы нет; способ зачета - Вручную.
Процедура ПроверитьДокументРасчетов(Прогон, Основа, ОжидаемыеСтроки, СуммаБанка, ПоДокументам, Описание)

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + СМП_ТестыЗаписиОснование.ТекстыЗамечаний(Прогон.Результат) + ")")
		.Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.Проведен, Описание + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": ДокументОснование - документ расчетов").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.Контрагент, Описание + ": контрагент основы").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Объект.СуммаДокумента, Описание + ": сумма документа - сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Итог("СуммаПлатежа"), Описание + ": итог расшифровки = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), Описание + ": предупреждений нет").Равно(0);

	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": строк расшифровки").Равно(ОжидаемыеСтроки.Количество());
	Вручную = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;
	Расхождения = "";
	Для Индекс = 0 По ОжидаемыеСтроки.ВГраница() Цикл
		Ожидание = ОжидаемыеСтроки[Индекс];
		Строка = Объект.РасшифровкаПлатежа[Индекс];
		Для Каждого Колонка Из СтрРазделить("СуммаПлатежа,СуммаРасчетов,СуммаНДС", ",") Цикл
			Если Строка[Колонка] <> Ожидание[Колонка] Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", " + Колонка + ": ожидали " + Ожидание[Колонка]
					+ ", факт " + Строка[Колонка];
			КонецЕсли;
		КонецЦикла;
		Если Строка.Договор <> Основа.Договор Тогда
			Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", Договор: не договор основы";
		КонецЕсли;
		Если Строка.СпособЗачета <> Вручную Тогда
			Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", СпособЗачета: " + Строка.СпособЗачета;
		КонецЕсли;
		Если Ожидание.Аванс Тогда
			Если Не Строка.ПризнакАванса Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ": строка аванса без ПризнакАванса";
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Заказ) Или ЗначениеЗаполнено(Строка.СчетНаОплату) Или ЗначениеЗаполнено(Строка.Документ) Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ": у строки аванса есть колонки основы";
			КонецЕсли;
		Иначе
			Если ПоДокументам И Строка.Документ <> Основа.Основание Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", Документ: не документ расчетов при ВестиРасчетыПоДокументам = Да";
			КонецЕсли;
			Если Не ПоДокументам И ЗначениеЗаполнено(Строка.Документ) Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", Документ: заполнен при ВестиРасчетыПоДокументам = Нет";
			КонецЕсли;
			Если Строка.ПризнакАванса Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ": строка документа расчетов помечена авансом";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Расхождения, Описание + ": строки расшифровки как ожидалось").Равно("");

КонецПроцедуры

#КонецОбласти
