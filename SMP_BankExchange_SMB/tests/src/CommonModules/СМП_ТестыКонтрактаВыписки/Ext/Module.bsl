КонецПроцедуры

#КонецОбласти

#Область ПроверкаКонвертаНаГранице

Процедура Граница_МаксимальнаяДлинаИдентификатораПятьдесят() Экспорт

	ЮТест.ОжидаетЧто(Продукт("МаксимальнаяДлинаИдентификатораОперации"), "МаксимальнаяДлинаИдентификатораОперации()").Равно(50);

КонецПроцедуры

Процедура Граница_ВалидныйКонвертПринятЦеликом() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьВалиднуюСтроку(Выписка, 2);

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Принята, "Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате").Равно(2);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Диагностика: " + ТекстыДиагностики(Результат.Диагностика)).Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "ЕстьНевалидныеСтроки").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.СозданнаяПлатформой = Выписка, "СозданнаяПлатформой - тот же конверт").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции <> Выписка.Операции, "Операции результата - новая таблица").ЭтоИстина();

КонецПроцедуры

// Характеризация действующего поведения (контракт v1): читатель, не вернувший ни одной операции, - не ошибка.
// Конверт принят, строк и диагностики нет, невалидных строк нет (пустая выписка за период бывает).
Процедура Граница_ПустойКонвертБезОперацийПринят() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Предусловие: во входном конверте нет строк операций").Равно(0);

	Результат = Проверить(Выписка);

	Контекст = "Диагностика: " + ТекстыДиагностики(Результат.Диагностика);
	ЮТест.ОжидаетЧто(Результат.Принята, Контекст + ". Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ". Строк в результате").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), Контекст + ". Строк диагностики").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Контекст + ". ЕстьНевалидныеСтроки").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.СозданнаяПлатформой = Выписка, "СозданнаяПлатформой - тот же конверт").ЭтоИстина();

КонецПроцедуры

// Характеризация действующего поведения: набор колонок сверяется по именам и типам, порядок значения не имеет
// (читатель обращается к колонкам по имени). Обе таблицы конверта заменяются таблицами с теми же колонками
// в обратном порядке; контроль, что порядок действительно другой, - в предусловии.
Процедура Граница_ДругойПорядокКолонокПринимается() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьДиагностику(Выписка, "Предупреждение", 0, "предупреждение читателя");
	ИсходныеОперации = Выписка.Операции;
	ИсходнаяДиагностика = Выписка.Диагностика;

	Выписка.Операции = ТаблицаВОбратномПорядке(ИсходныеОперации);
	Выписка.Диагностика = ТаблицаВОбратномПорядке(ИсходнаяДиагностика);

	ЮТест.ОжидаетЧто(Выписка.Операции.Колонки[0].Имя, "Предусловие: первая колонка Операции другая")
		.НеРавно(ИсходныеОперации.Колонки[0].Имя);
	ЮТест.ОжидаетЧто(Выписка.Диагностика.Колонки[0].Имя, "Предусловие: первая колонка Диагностика другая")
		.НеРавно(ИсходнаяДиагностика.Колонки[0].Имя);
	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Предусловие: строка операции перенесена").Равно(1);

	Результат = Проверить(Выписка);

	Контекст = "Диагностика: " + ТекстыДиагностики(Результат.Диагностика);
	ЮТест.ОжидаетЧто(Результат.Принята, Контекст + ". Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ". Строк в результате").Равно(1);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Контекст + ". ЕстьНевалидныеСтроки").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), "предупреждение читателя") > 0,
		"Диагностика читателя сохранена. " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();

КонецПроцедуры

// D3: комиссия банка не имеет контрагента, но остается документом - пустые необязательные
// поля не повод отбросить операцию.
Процедура Граница_ПустыеНеключевыеПоляВалидны() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Операция = ДобавитьВалиднуюСтроку(Выписка, 1);
	Для Каждого Имя Из СтрРазделить("НомерДокумента,ИдентификаторОперации,КонтрагентНаименование,"
		+ "КонтрагентНомерСчета,КонтрагентКод,КонтрагентМФО,НазначениеПлатежа,СырыеДанные", ",") Цикл
		Операция[Имя] = "";
	КонецЦикла;
	Операция.ДатаДокумента = Дата(1, 1, 1);

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате. Диагностика: "
		+ ТекстыДиагностики(Результат.Диагностика)).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Строк диагностики").Равно(0);

КонецПроцедуры

Процедура Граница_ВалидныеЗначенияПолей(Название, Поле, Значение) Экспорт

	Выписка = Продукт("НоваяВыписка");
	Операция = ДобавитьВалиднуюСтроку(Выписка, 1);
	Операция[Поле] = Значение;

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Название + ": строк в результате. Диагностика: "
		+ ТекстыДиагностики(Результат.Диагностика)).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Название + ": ЕстьНевалидныеСтроки").ЭтоЛожь();

КонецПроцедуры

// Невалидная строка стоит первой: платформа не останавливается на ней, остальные проходят.
Процедура Граница_НевалиднаяСтрокаОтбрасываетсяОстальныеПроходят(Название, Поле, Значение) Экспорт

	Выписка = Продукт("НоваяВыписка");
	Плохая = ДобавитьВалиднуюСтроку(Выписка, 7);
	Плохая[Поле] = Значение;
	ДобавитьВалиднуюСтроку(Выписка, 8);

	Результат = Проверить(Выписка);
	Контекст = Название + ". Диагностика: " + ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Принята, Название + ": Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ". Строк в результате").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].ПорядковыйНомер, Название + ": уцелела валидная строка").Равно(8);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), Контекст + ". Строк диагностики").Равно(1);
	Если Результат.Диагностика.Количество() = 1 Тогда
		Сообщение = Результат.Диагностика[0];
		ЮТест.ОжидаетЧто(Сообщение.Уровень, Контекст + ". Уровень").Равно("Ошибка");
		ЮТест.ОжидаетЧто(Сообщение.ПорядковыйНомер, Контекст + ". Адрес строки").Равно(7);
		ЮТест.ОжидаетЧто(СтрНайти(Сообщение.Текст, Поле) > 0, Контекст + ". Текст называет поле " + Поле).ЭтоИстина();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Название + ": ЕстьНевалидныеСтроки").ЭтоИстина();

КонецПроцедуры

Процедура Граница_СредняяИзТрехНевалидна() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 11);
	Средняя = ДобавитьВалиднуюСтроку(Выписка, 12);
	Средняя.Направление = "Иное";
