Процедура Граница_ИзмененнаяСхемаТаблицыОтклоняетКонверт(Название, Таблица, Вид, Колонка) Экспорт

	Выписка = Продукт("НоваяВыписка");

	Если Вид = "добавлена" Тогда
		Выписка[Таблица].Колонки.Добавить(Колонка);
	ИначеЕсли Вид = "удалена" Тогда
		Выписка[Таблица].Колонки.Удалить(Колонка);
	ИначеЕсли Вид = "тип" Тогда
		ЗаменитьТипКолонки(Выписка, Таблица, Колонка, Новый ОписаниеТипов("Строка"));
	ИначеЕсли Вид = "разрядность" Тогда
		ЗаменитьТипКолонки(Выписка, Таблица, Колонка,
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	ИначеЕсли Вид = "частиДаты" Тогда
		ЗаменитьТипКолонки(Выписка, Таблица, Колонка,
			Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ИначеЕсли Вид = "неТаблица" Тогда
		Выписка.Вставить(Таблица, Неопределено);
	КонецЕсли;

	Результат = Проверить(Выписка);

	ПроверитьОтклонение(Результат, Название);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), Колонка) > 0,
		Название + ": диагностика называет " + Колонка + ". " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();

КонецПроцедуры

// Защита от чужой схемы: в диагностике читателя есть сообщение (непустая таблица), но ее схема
// нарушена, поэтому платформа ее не читает и в результат не переносит. На пустой диагностике
// эту защиту не доказать: без проверки схемы тест остался бы зеленым.
Процедура Граница_ДиагностикаЧитателяСЧужойСхемойНеЧитается(Название, Вид, Колонка) Экспорт

	Метка = "ЧУЖАЯ_ДИАГНОСТИКА_ЧИТАТЕЛЯ";

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);

	Если Вид = "добавлена" Тогда
		Выписка.Диагностика.Колонки.Добавить(Колонка);
		ДобавитьДиагностику(Выписка, "Ошибка", 1, Метка);
	ИначеЕсли Вид = "удалена" Тогда
		ДобавитьДиагностику(Выписка, "Ошибка", 1, Метка);
		Выписка.Диагностика.Колонки.Удалить(Колонка);
	ИначеЕсли Вид = "тип" Тогда
		ЗаменитьТипКолонки(Выписка, "Диагностика", Колонка, Новый ОписаниеТипов("Строка"));
		Сообщение = Выписка.Диагностика.Добавить();
		Сообщение.Уровень = "Ошибка";
		Сообщение.ПорядковыйНомер = "не число";
		Сообщение.Текст = Метка;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Выписка.Диагностика.Количество(), "Предусловие: диагностика читателя не пуста").Равно(1);

	Результат = Проверить(Выписка);

	ПроверитьОтклонение(Результат, Название);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), Метка) = 0,
		Название + ": диагностика с чужой схемой не переносится. " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), Колонка) > 0,
		Название + ": причина называет колонку " + Колонка + ". " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();

КонецПроцедуры

// Рівень діагностики читача поза контрактом (рішення планувальника I1): помилка читача має бути
// видимою, а не тихо перетлумаченою як "не Предупреждение". Платформа пише свій рядок "Ошибка"
// з уровнем, що прийшов, і адресою рядка; ЕстьНевалидныеСтроки = Истина.
Процедура Граница_УровеньДиагностикиНеИзКонтрактаДаетОшибкуПлатформы(Название, Уровень) Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьВалиднуюСтроку(Выписка, 2);
	ДобавитьДиагностику(Выписка, Уровень, 7, "сообщение читателя с чужим уровнем");

	Результат = Проверить(Выписка);
	Контекст = Название + ". Диагностика: " + ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Принята, Название + ": Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ". Строк в результате").Равно(2);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Название + ": ЕстьНевалидныеСтроки").ЭтоИстина();

	// Строк "Ошибка" в результате должна быть ровно одна: платформы (сообщение читателя несет чужой уровень).
	СообщенияПлатформы = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = "Ошибка" Тогда
			СообщенияПлатформы.Добавить(Сообщение);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СообщенияПлатформы.Количество(), Контекст + ". Строк уровня Ошибка").Равно(1);
	Если СообщенияПлатформы.Количество() = 1 Тогда
		Текст = СообщенияПлатформы[0].Текст;
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "7") > 0, Контекст + ". Текст называет адрес строки 7").ЭтоИстина();
		Если Не ПустаяСтрока(Уровень) Тогда
			ЮТест.ОжидаетЧто(СтрНайти(Текст, Уровень) > 0, Контекст + ". Текст называет пришедший уровень").ЭтоИстина();
		КонецЕсли;
	КонецЕсли;

	// Сообщение самого читателя сохраняется как есть.
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), "сообщение читателя с чужим уровнем") > 0,
		Контекст + ". Сообщение читателя сохранено").ЭтоИстина();

КонецПроцедуры

// Симметричная пара: уровни из контракта платформа не дублирует своим сообщением.
// "Ошибка" дает ЕстьНевалидныеСтроки = Истина, "Предупреждение" - Ложь; своего рядка платформы нет.
Процедура Граница_УровниИзКонтрактаНеДаютОшибкуПлатформы(Название, Уровень) Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьДиагностику(Выписка, Уровень, 7, "сообщение читателя");

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), Название + ": только сообщение читателя. "
		+ ТекстыДиагностики(Результат.Диагностика)).Равно(1);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Название + ": ЕстьНевалидныеСтроки").Равно(Уровень = "Ошибка");

КонецПроцедуры

// Нулевая сумма - частый след нераспознанного значения (типизированная колонка молча дает 0):
// диагностика подсказывает причину.
Процедура Граница_НулеваяСуммаПодсказываетПроНеразобранноеЗначение() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Операция = ДобавитьВалиднуюСтроку(Выписка, 5);
	Операция.Сумма = 0;

	Результат = Проверить(Выписка);
	Текст = ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате. Диагностика: " + Текст).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "не разобрал") > 0, "Диагностика подсказывает про нераспознанное значение: " + Текст).ЭтоИстина();

КонецПроцедуры

// Симметрия: у отрицательной суммы значение известно, подсказка про "не разобрал" была бы ложной.
Процедура Граница_ОтрицательнаяСуммаБезПодсказкиПроНеразобранное() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Операция = ДобавитьВалиднуюСтроку(Выписка, 5);
	Операция.Сумма = -5;

	Результат = Проверить(Выписка);
	Текст = ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате. Диагностика: " + Текст).Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "не разобрал") = 0, "Подсказки нет у отрицательной суммы: " + Текст).ЭтоИстина();

КонецПроцедуры

// ХАРАКТЕРИЗАЦИЯ поведения платформы 1С, на которое опирается reader-contract.md: типизированная
// колонка Число(15,2) округляет, а не отсекает лишние знаки при присвоении, до проверки платформы.
Процедура Платформа_СуммаБольшеДвухЗнаковОкругляетсяВКолонке() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Операция = ДобавитьВалиднуюСтроку(Выписка, 1);
	Операция.Сумма = 12.345;

	ЮТест.ОжидаетЧто(Операция.Сумма, "Сумма 12.345 в колонке Число(15,2)").Равно(12.35);

КонецПроцедуры

// ХАРАКТЕРИЗАЦИЯ: колонка с квалификатором "Неотрицательный" превращает отрицательное значение в 0,
// а платформа затем подставляет номер строки таблицы (позицию с единицы).
Процедура Платформа_ОтрицательныйПорядковыйНомерСтановитсяНулемИНомеромСтроки() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	Операция = ДобавитьВалиднуюСтроку(Выписка, 0);
	Операция.ПорядковыйНомер = -5;
	ЮТест.ОжидаетЧто(Операция.ПорядковыйНомер, "ПорядковыйНомер -5 в неотрицательной колонке").Равно(0);

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате. Диагностика: "
		+ ТекстыДиагностики(Результат.Диагностика)).Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].ПорядковыйНомер, "Номер второй строки в результате").Равно(2);
	КонецЕсли;

КонецПроцедуры

Процедура Граница_ОтклоненныйКонвертБезОперацийСПояснением() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьВалиднуюСтроку(Выписка, 2);
	ДобавитьДиагностику(Выписка, "Предупреждение", 0, "предупреждение читателя до отказа");
	Выписка.ВерсияКонтракта = 2;

	Результат = Проверить(Выписка);

	ПроверитьОтклонение(Результат, "Отклоненный конверт с двумя валидными строками");
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), "предупреждение читателя до отказа") > 0,
		"Диагностика читателя сохранена. " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();

КонецПроцедуры

// Вход не мутируется: ни строки, ни значения, ни диагностика; таблицы результата независимы от входа.
Процедура Граница_ВходнойКонвертНеМеняется() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 0);
	Плохая = ДобавитьВалиднуюСтроку(Выписка, 0);
	Плохая.Сумма = -1;
	Плохая.ИдентификаторОперации = СтрокаДлиной(80);
	ДобавитьВалиднуюСтроку(Выписка, 0);
	ДобавитьДиагностику(Выписка, "Предупреждение", 0, "сообщение читателя");

	До = СнимокКонверта(Выписка);

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(СнимокКонверта(Выписка), "Снимок входа после проверки").Равно(До);
	ЮТест.ОжидаетЧто(Результат.Операции <> Выписка.Операции, "Операции результата - не таблица входа").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Диагностика <> Выписка.Диагностика, "Диагностика результата - не таблица входа").ЭтоИстина();

	Результат.Операции.Добавить();
	Результат.Диагностика.Добавить();
	ЮТест.ОжидаетЧто(СнимокКонверта(Выписка), "Снимок входа после записи в таблицы результата").Равно(До);

КонецПроцедуры

#КонецОбласти

#Область ОжидаемыйКонтракт

// Ожидаемые поля конверта и тип их начального значения (метка из МеткаЗначения).
Функция ПоляКонверта()

	Поля = Новый Массив;
	ДобавитьОжидаемое(Поля, "ВерсияКонтракта", "Число");
	ДобавитьОжидаемое(Поля, "НачалоПериода", "Дата");
	ДобавитьОжидаемое(Поля, "КонецПериода", "Дата");
	ДобавитьОжидаемое(Поля, "НачальныйОстаток", "Неопределено");
	ДобавитьОжидаемое(Поля, "КонечныйОстаток", "Неопределено");
	ДобавитьОжидаемое(Поля, "ЧтениеПолное", "Булево");
	ДобавитьОжидаемое(Поля, "ГраницаДоверия", "Дата");
	ДобавитьОжидаемое(Поля, "Диагностика", "ТаблицаЗначений");
	ДобавитьОжидаемое(Поля, "Операции", "ТаблицаЗначений");
	Возврат Поля;

КонецФункции

// Колонки таблицы Операции в порядке контракта. Строки - без ограничения длины,
// Сумма - 15.2 с любым знаком (знак проверяет платформа с диагностикой, не тип).
Функция КолонкиОпераций()

	Колонки = Новый Массив;
	ДобавитьОжидаемое(Колонки, "ПорядковыйНомер", "Число(10,0,Неотрицательный)");
	ДобавитьОжидаемое(Колонки, "НомерСчета", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "Валюта", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ДатаОперации", "Дата(ДатаВремя)");
	ДобавитьОжидаемое(Колонки, "НомерДокумента", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ДатаДокумента", "Дата(Дата)");
	ДобавитьОжидаемое(Колонки, "Сумма", "Число(15,2,Любой)");
	ДобавитьОжидаемое(Колонки, "Направление", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ИдентификаторОперации", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентНаименование", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентНомерСчета", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентКод", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентМФО", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "НазначениеПлатежа", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "СырыеДанные", "Строка(длина=0)");
	Возврат Колонки;

КонецФункции

Функция КолонкиДиагностики()

	Колонки = Новый Массив;
	ДобавитьОжидаемое(Колонки, "Уровень", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ПорядковыйНомер", "Число(10,0,Неотрицательный)");
	ДобавитьОжидаемое(Колонки, "Текст", "Строка(длина=0)");
	Возврат Колонки;

КонецФункции

// Валидное описание читателя по контракту D28.
Функция ВалидноеОписание()

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "тест_читатель");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", "Тестовый читатель");
	Описание.Вставить("РасширенияФайлов", СтрРазделить("csv,txt", ","));
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Описание.Вставить("Кодировка", "windows-1251");
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка." + ИмяМетода, Параметры);

КонецФункции

Функция ПроверитьОписание(Описание)

	Параметры = Новый Массив;
	Параметры.Добавить(Описание);

	Ошибки = Продукт("ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(ТипЗнч(Ошибки) = Тип("Массив"), "ПроверитьОписаниеЧитателя возвращает массив").ЭтоИстина();

	Возврат Ошибки;

КонецФункции

// Ошибка с подстрокой есть среди ошибок. Тексты всех ошибок идут в сообщение.
Процедура ПроверитьЕстьОшибкаСПодстрокой(Ошибки, Подстрока, Контекст)

	Найдена = Ложь;
	Для Каждого Текст Из Ошибки Цикл
		Если СтрНайти(Текст, Подстрока) > 0 Тогда
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Найдена, Контекст + ": ожидали ошибку с подстрокой '" + Подстрока
		+ "'. Фактические ошибки: [" + СтрСоединить(Ошибки, " | ") + "]").ЭтоИстина();

КонецПроцедуры

Процедура ДобавитьОжидаемое(Перечень, Имя, Тип)

	Перечень.Добавить(Новый Структура("Имя, Тип", Имя, Тип));

КонецПроцедуры

Функция ЕстьИмяВПеречне(Перечень, Имя)

	Для Каждого Элемент Из Перечень Цикл
		Если Элемент.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Значение поля структуры; Неопределено, если не структура или поля нет.
Функция ЗначениеПоля(Структура, Имя)

	Если ТипЗнч(Структура) <> Тип("Структура") Или Не Структура.Свойство(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Структура[Имя];

КонецФункции

// Поле-таблица значений; Неопределено, если поля нет или оно не таблица.
Функция ПолеТаблицы(Структура, Имя)

	Значение = ЗначениеПоля(Структура, Имя);
	Если ТипЗнч(Значение) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция МеткаЗначения(Значение)

	// Тип() принимает только строковый литерал, поэтому проверки перечислены явно.
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Булево";
	ИначеЕсли ТипЗначения = Тип("Неопределено") Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат "ТаблицаЗначений";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "Массив";
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Возврат "Структура";
	КонецЕсли;
	Возврат "иной тип: " + Строка(ТипЗначения);

КонецФункции

// Сверка колонок таблицы (порядок, имя, тип с квалификаторами) с ожидаемым перечнем.
Функция СверитьКолонки(Таблица, Ожидаемое)

	Расхождения = Новый Массив;
	Если Таблица = Неопределено Тогда
		Расхождения.Добавить("поле не является таблицей значений");
		Возврат Расхождения;
	КонецЕсли;

	Если Таблица.Колонки.Количество() <> Ожидаемое.Количество() Тогда
		Расхождения.Добавить("колонок " + Таблица.Колонки.Количество() + ", ожидали " + Ожидаемое.Количество());
	КонецЕсли;

	Для Индекс = 0 По Ожидаемое.ВГраница() Цикл
		Колонка = Ожидаемое[Индекс];
		Если Индекс > Таблица.Колонки.Количество() - 1 Тогда
			Расхождения.Добавить("нет колонки " + Колонка.Имя + " на позиции " + Индекс);
			Продолжить;
		КонецЕсли;
		Фактическая = Таблица.Колонки[Индекс];
		Если Фактическая.Имя <> Колонка.Имя Тогда
			Расхождения.Добавить("позиция " + Индекс + ": ожидали " + Колонка.Имя + ", фактически " + Фактическая.Имя);
			Продолжить;
		КонецЕсли;
		Описание = ОписаниеТипаКолонки(Фактическая);
		Если Описание <> Колонка.Тип Тогда
			Расхождения.Добавить(Колонка.Имя + ": ожидали " + Колонка.Тип + ", фактически " + Описание);
		КонецЕсли;
	КонецЦикла;

	Возврат Расхождения;

КонецФункции

Функция ОписаниеТипаКолонки(Колонка)

	ОписаниеТипов = Колонка.ТипЗначения;
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат "составной тип из " + Типы.Количество();
	КонецЕсли;

	ТипКолонки = Типы[0];
	Если ТипКолонки = Тип("Строка") Тогда
		Возврат "Строка(длина=" + Формат(ОписаниеТипов.КвалификаторыСтроки.Длина, "ЧН=0; ЧГ=") + ")";
	ИначеЕсли ТипКолонки = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Знак = ?(Квалификаторы.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный, "Неотрицательный", "Любой");
		Возврат "Число(" + Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=") + ","
			+ Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=") + "," + Знак + ")";
	ИначеЕсли ТипКолонки = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат "Дата(Дата)";
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат "Дата(Время)";
		КонецЕсли;
		Возврат "Дата(ДатаВремя)";
	КонецЕсли;

	Возврат "иной тип: " + Строка(ТипКолонки);

КонецФункции

// Вызывает ПроверитьВыписку продукта. Без второго аргумента платформа "держала" тот же конверт.
Функция Проверить(Выписка, СозданнаяПлатформой = Неопределено)

	Параметры = Новый Массив;
	Параметры.Добавить(Выписка);
	Параметры.Добавить(?(СозданнаяПлатформой = Неопределено, Выписка, СозданнаяПлатформой));

	Результат = Продукт("ПроверитьВыписку", Параметры);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат) = Тип("Структура"), "ПроверитьВыписку возвращает структуру").ЭтоИстина();

	Возврат Результат;

КонецФункции

// Отклонение целого конверта: не принят, операций нет, есть сообщение уровня "Ошибка" с текстом.
Процедура ПроверитьОтклонение(Результат, Контекст)

	Диагностика = ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Принята, Контекст + ": Принята").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ": строк в Операции").Равно(0);
	// Курсор этапа 5 не должен считать отклоненное чтение полным (D28, последний абзац).
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Контекст + ": ЕстьНевалидныеСтроки у отклоненного конверта").ЭтоИстина();

	ЕстьОшибка = Ложь;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = "Ошибка" И Не ПустаяСтрока(Сообщение.Текст) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьОшибка, Контекст + ": диагностика объясняет причину. Диагностика: " + Диагностика).ЭтоИстина();

КонецПроцедуры

// Добавляет в конверт валидную строку операции (все поля заполнены допустимыми значениями).
Функция ДобавитьВалиднуюСтроку(Выписка, ПорядковыйНомер)

	Операция = Выписка.Операции.Добавить();
	Операция.ПорядковыйНомер = ПорядковыйНомер;
	Операция.НомерСчета = "UA213223130000026007233566001";
	Операция.Валюта = "980";
	Операция.ДатаОперации = Дата(2026, 10, 1, 12, 30, 0);
	Операция.НомерДокумента = "17";
	Операция.ДатаДокумента = Дата(2026, 10, 1);
	Операция.Сумма = 125.40;
	Операция.Направление = "Поступило";
	Операция.ИдентификаторОперации = "TX-" + Формат(ПорядковыйНомер, "ЧН=0; ЧГ=");
	Операция.КонтрагентНаименование = "ТОВ Ромашка";
	Операция.КонтрагентНомерСчета = "UA903052992990004149123456789";
	Операция.КонтрагентКод = "12345678";
	Операция.КонтрагентМФО = "305299";
	Операция.НазначениеПлатежа = "Оплата за товар";
	Операция.СырыеДанные = "17;01.10.2026;125,40";
	Возврат Операция;

КонецФункции

Процедура ДобавитьДиагностику(Выписка, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

// Все сообщения таблицы диагностики одной строкой - для текста проверок.
Функция ТекстыДиагностики(Диагностика)

	Части = Новый Массив;
	Для Каждого Сообщение Из Диагностика Цикл
		Части.Добавить(Сообщение.Уровень + " [" + Формат(Сообщение.ПорядковыйНомер, "ЧН=0; ЧГ=") + "] " + Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

// Копия таблицы с теми же колонками (имя, описание типа с уточнениями) в обратном порядке и теми же строками.
Функция ТаблицаВОбратномПорядке(Источник)

	Результат = Новый ТаблицаЗначений;
	Для Индекс = 1 По Источник.Колонки.Количество() Цикл
		Колонка = Источник.Колонки[Источник.Колонки.Количество() - Индекс];
		Результат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
	КонецЦикла;
	Для Каждого Строка Из Источник Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка из заданного числа символов. Функции СтрПовторить в платформе нет.
Функция СтрокаДлиной(Длина)

	Результат = "";
	Для Счетчик = 1 По Длина Цикл
		Результат = Результат + "Я";
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заменяет таблицу конверта копией с тем же составом колонок, но другим типом одной из них.
Процедура ЗаменитьТипКолонки(Выписка, ИмяТаблицы, ИмяКолонки, НовыйТип)

	Новая = Новый ТаблицаЗначений;
	Для Каждого Колонка Из Выписка[ИмяТаблицы].Колонки Цикл
		Новая.Колонки.Добавить(Колонка.Имя, ?(Колонка.Имя = ИмяКолонки, НовыйТип, Колонка.ТипЗначения));
	КонецЦикла;
	Выписка.Вставить(ИмяТаблицы, Новая);

КонецПроцедуры

// Текстовый снимок конверта: поля и все ячейки обеих таблиц; для сравнения "до" и "после".
Функция СнимокКонверта(Выписка)

	Части = Новый Массив;
	Для Каждого Поле Из Выписка Цикл
		Если ТипЗнч(Поле.Значение) = Тип("ТаблицаЗначений") Тогда
			Части.Добавить(Поле.Ключ + ": " + СнимокТаблицы(Поле.Значение));
		Иначе
			Части.Добавить(Поле.Ключ + "=" + Строка(Поле.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция СнимокТаблицы(Таблица)

	Части = Новый Массив;
	Части.Добавить("строк " + Таблица.Количество());
	Для Каждого Операция Из Таблица Цикл
		Ячейки = Новый Массив;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Ячейки.Добавить(Колонка.Имя + "=" + Строка(Операция[Колонка.Имя]));
		КонецЦикла;
		Части.Добавить(СтрСоединить(Ячейки, ";"));
	КонецЦикла;
	Возврат СтрСоединить(Части, " / ");

КонецФункции

Функция СтрокиИзМассива(Массив)

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Результат.Добавить(Формат(Элемент, "ЧГ="));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
