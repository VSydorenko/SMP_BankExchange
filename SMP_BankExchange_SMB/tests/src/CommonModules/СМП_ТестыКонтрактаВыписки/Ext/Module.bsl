// Тесты контракта читателя выписок (спека D27, D28): конверт, параметры чтения, проверка
// описания читателя. Без данных в базе: транзакция не нужна.
//
// ИМЕНОВАННОЕ ИСКЛЮЧЕНИЕ из правила «тест не задает условие, которое измеряет»: ожидаемая
// схема конверта (ПоляКонверта, КолонкиОпераций, КолонкиДиагностики, ПоляПараметровЧтения)
// записана здесь, в самом тесте, потому что тест ЗДЕСЬ И ЕСТЬ спецификация контракта. Изменение
// схемы конструктором без изменения этих перечней краснит тест, а изменение перечней видно в
// diff: так смена контракта не проходит молча.
//
// Продукт вызывается только через СМП_ТестыВызовПродукта (позднее связывание).
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Контракт выписки: версия и конверт")
			.ДобавитьСерверныйТест("ВерсияКонтрактаИПоддерживаемыеВерсии")
			.ДобавитьСерверныйТест("СхемаКонверта_ПоляИТипы")
			.ДобавитьСерверныйТест("СхемаКонверта_КолонкиОпераций")
			.ДобавитьСерверныйТест("СхемаКонверта_КолонкиДиагностики")
		.ДобавитьТестовыйНабор("Контракт выписки: проверка описания читателя")
			.ДобавитьСерверныйТест("Описание_ВалидноеДаетПустойМассив")
			.ДобавитьСерверныйТест("Описание_БезОбязательногоПоляДаетОшибкуСИменемПоля")
				.СПараметрами("Идентификатор")
				.СПараметрами("ВерсияКонтракта")
				.СПараметрами("Наименование")
				.СПараметрами("РасширенияФайлов")
				.СПараметрами("ДаетИдентификаторыОпераций")
				.СПараметрами("ДаетОстатки")
				.СПараметрами("Кодировка")
		.ДобавитьТестовыйНабор("Контракт выписки: проверка конверта на границе")
			.ДобавитьСерверныйТест("Граница_ВалидныйКонвертПринятЦеликом")
			.ДобавитьСерверныйТест("Граница_НевалиднаяСтрокаОтбрасываетсяОстальныеПроходят")
				.СПараметрами("Дата операции пуста", "ДатаОперации", Дата(1, 1, 1))
				.СПараметрами("Сумма ноль", "Сумма", 0)
				.СПараметрами("Сумма отрицательная", "Сумма", -5)
				.СПараметрами("Направление иное", "Направление", "Иное")
				.СПараметрами("Направление пусто", "Направление", "")
				.СПараметрами("Направление в другом регистре", "Направление", "поступило")
				.СПараметрами("Валюта две цифры", "Валюта", "98")
				.СПараметрами("Валюта четыре цифры", "Валюта", "9800")
				.СПараметрами("Валюта буквенный код", "Валюта", "UAH")
				.СПараметрами("Валюта цифры с буквой", "Валюта", "98a")
				.СПараметрами("Номер счета пуст", "НомерСчета", "")
				.СПараметрами("Номер счета из пробелов", "НомерСчета", "   ")
			.ДобавитьСерверныйТест("Граница_ПодменаОбъектаОтклоняетКонверт")
			.ДобавитьСерверныйТест("Граница_НеСтруктураОтклоняетсяБезИсключения")
			.ДобавитьСерверныйТест("Граница_ИзмененнаяВерсияОтклоняетКонверт")
				.СПараметрами("версия 2", 2)
				.СПараметрами("версия 0", 0)
				.СПараметрами("версия строкой", "1");

КонецПроцедуры

#Область КонтрактКонверта

Процедура ВерсияКонтрактаИПоддерживаемыеВерсии() Экспорт

	Версия = Продукт("ВерсияКонтракта");
	Поддерживаемые = Продукт("ПоддерживаемыеВерсииКонтракта");

	ЮТест.ОжидаетЧто(Версия, "Версия контракта").Равно(1);

	ТипМассив = ТипЗнч(Поддерживаемые) = Тип("Массив");
	ЮТест.ОжидаетЧто(ТипМассив, "ПоддерживаемыеВерсииКонтракта возвращает массив").ЭтоИстина();

	Если ТипМассив Тогда
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокиИзМассива(Поддерживаемые), ","), "Поддерживаемые версии").Равно("1");
	КонецЕсли;

КонецПроцедуры

Процедура СхемаКонверта_ПоляИТипы() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Ожидаемое = ПоляКонверта();
	Расхождения = Новый Массив;

	Фактические = Новый Массив;
	Если ТипЗнч(Выписка) = Тип("Структура") Тогда
		Для Каждого Элемент Из Выписка Цикл
			Фактические.Добавить(Элемент.Ключ);
		КонецЦикла;
	Иначе
		Расхождения.Добавить("НоваяВыписка вернула не Структуру: " + ТипЗнч(Выписка));
	КонецЕсли;

	Для Каждого Поле Из Ожидаемое Цикл
		Если Не Выписка.Свойство(Поле.Имя) Тогда
			Расхождения.Добавить("нет поля " + Поле.Имя);
			Продолжить;
		КонецЕсли;
		Метка = МеткаЗначения(Выписка[Поле.Имя]);
		Если Метка <> Поле.Тип Тогда
			Расхождения.Добавить(Поле.Имя + ": ожидали " + Поле.Тип + ", фактически " + Метка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из Фактические Цикл
		Если Не ЕстьИмяВПеречне(Ожидаемое, Имя) Тогда
			Расхождения.Добавить("лишнее поле " + Имя);
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения схемы полей конверта с контрактом").Равно("");

КонецПроцедуры

Процедура СхемаКонверта_КолонкиОпераций() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Расхождения = СверитьКолонки(ПолеТаблицы(Выписка, "Операции"), КолонкиОпераций());

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения колонок Операции с контрактом").Равно("");

КонецПроцедуры

Процедура СхемаКонверта_КолонкиДиагностики() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Расхождения = СверитьКолонки(ПолеТаблицы(Выписка, "Диагностика"), КолонкиДиагностики());

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения колонок Диагностика с контрактом").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ПроверкаОписанияЧитателя

Процедура Описание_ВалидноеДаетПустойМассив() Экспорт

	Ошибки = ПроверитьОписание(ВалидноеОписание());

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, "; "), "Ошибки валидного описания").Равно("");

КонецПроцедуры

Процедура Описание_БезОбязательногоПоляДаетОшибкуСИменемПоля(Поле) Экспорт

	Описание = ВалидноеОписание();
	Описание.Удалить(Поле);

	Ошибки = ПроверитьОписание(Описание);

	ПроверитьЕстьОшибкаСПодстрокой(Ошибки, Поле, "Описание без поля " + Поле);

КонецПроцедуры

#КонецОбласти

#Область ПроверкаКонвертаНаГранице

Процедура Граница_ВалидныйКонвертПринятЦеликом() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	ДобавитьВалиднуюСтроку(Выписка, 2);

	Результат = Проверить(Выписка);

	ЮТест.ОжидаетЧто(Результат.Принята, "Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк в результате").Равно(2);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Диагностика: " + ТекстыДиагностики(Результат.Диагностика)).Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "ЕстьНевалидныеСтроки").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.СозданнаяПлатформой = Выписка, "СозданнаяПлатформой - тот же конверт").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции <> Выписка.Операции, "Операции результата - новая таблица").ЭтоИстина();

КонецПроцедуры

// Невалидная строка стоит первой: платформа не останавливается на ней, остальные проходят.
Процедура Граница_НевалиднаяСтрокаОтбрасываетсяОстальныеПроходят(Название, Поле, Значение) Экспорт

	Выписка = Продукт("НоваяВыписка");
	Плохая = ДобавитьВалиднуюСтроку(Выписка, 7);
	Плохая[Поле] = Значение;
	ДобавитьВалиднуюСтроку(Выписка, 8);

	Результат = Проверить(Выписка);
	Контекст = Название + ". Диагностика: " + ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Принята, Название + ": Принята").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ". Строк в результате").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].ПорядковыйНомер, Название + ": уцелела валидная строка").Равно(8);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), Контекст + ". Строк диагностики").Равно(1);
	Если Результат.Диагностика.Количество() = 1 Тогда
		Сообщение = Результат.Диагностика[0];
		ЮТест.ОжидаетЧто(Сообщение.Уровень, Контекст + ". Уровень").Равно("Ошибка");
		ЮТест.ОжидаетЧто(Сообщение.ПорядковыйНомер, Контекст + ". Адрес строки").Равно(7);
		ЮТест.ОжидаетЧто(СтрНайти(Сообщение.Текст, Поле) > 0, Контекст + ". Текст называет поле " + Поле).ЭтоИстина();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Название + ": ЕстьНевалидныеСтроки").ЭтоИстина();

КонецПроцедуры

// Именно идентичность, а не схема: чужой конверт построен тем же НоваяВыписка().
Процедура Граница_ПодменаОбъектаОтклоняетКонверт() Экспорт

	Созданная = Продукт("НоваяВыписка");
	Чужая = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Чужая, 1);

	Результат = Проверить(Чужая, Созданная);

	ПроверитьОтклонение(Результат, "Подмена объекта");
	ЮТест.ОжидаетЧто(Результат.СозданнаяПлатформой = Созданная, "СозданнаяПлатформой - конверт платформы").ЭтоИстина();

КонецПроцедуры

Процедура Граница_НеСтруктураОтклоняетсяБезИсключения() Экспорт

	Созданная = Продукт("НоваяВыписка");

	Результат = Проверить(Неопределено, Созданная);

	ПроверитьОтклонение(Результат, "Вместо конверта Неопределено");

КонецПроцедуры

Процедура Граница_ИзмененнаяВерсияОтклоняетКонверт(Название, Версия) Экспорт

	Выписка = Продукт("НоваяВыписка");
	ДобавитьВалиднуюСтроку(Выписка, 1);
	Выписка.ВерсияКонтракта = Версия;

	Результат = Проверить(Выписка);

	ПроверитьОтклонение(Результат, Название);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстыДиагностики(Результат.Диагностика), "ВерсияКонтракта") > 0,
		Название + ": диагностика называет поле. " + ТекстыДиагностики(Результат.Диагностика)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОжидаемыйКонтракт

// Ожидаемые поля конверта и тип их начального значения (метка из МеткаЗначения).
Функция ПоляКонверта()

	Поля = Новый Массив;
	ДобавитьОжидаемое(Поля, "ВерсияКонтракта", "Число");
	ДобавитьОжидаемое(Поля, "НачалоПериода", "Дата");
	ДобавитьОжидаемое(Поля, "КонецПериода", "Дата");
	ДобавитьОжидаемое(Поля, "НачальныйОстаток", "Неопределено");
	ДобавитьОжидаемое(Поля, "КонечныйОстаток", "Неопределено");
	ДобавитьОжидаемое(Поля, "ЧтениеПолное", "Булево");
	ДобавитьОжидаемое(Поля, "ГраницаДоверия", "Дата");
	ДобавитьОжидаемое(Поля, "КлассОтказа", "Строка");
	ДобавитьОжидаемое(Поля, "ПрочитанныйОтрезок", "Неопределено");
	ДобавитьОжидаемое(Поля, "Диагностика", "ТаблицаЗначений");
	ДобавитьОжидаемое(Поля, "Операции", "ТаблицаЗначений");
	Возврат Поля;

КонецФункции

// Колонки таблицы Операции в порядке контракта. Строки - без ограничения длины,
// Сумма - 15.2 с любым знаком (знак проверяет платформа с диагностикой, не тип).
Функция КолонкиОпераций()

	Колонки = Новый Массив;
	ДобавитьОжидаемое(Колонки, "ПорядковыйНомер", "Число(10,0,Неотрицательный)");
	ДобавитьОжидаемое(Колонки, "НомерСчета", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "Валюта", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ДатаОперации", "Дата(ДатаВремя)");
	ДобавитьОжидаемое(Колонки, "НомерДокумента", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ДатаДокумента", "Дата(Дата)");
	ДобавитьОжидаемое(Колонки, "Сумма", "Число(15,2,Любой)");
	ДобавитьОжидаемое(Колонки, "Направление", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ИдентификаторОперации", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентНаименование", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентНомерСчета", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентКод", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "КонтрагентМФО", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "НазначениеПлатежа", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "СырыеДанные", "Строка(длина=0)");
	Возврат Колонки;

КонецФункции

Функция КолонкиДиагностики()

	Колонки = Новый Массив;
	ДобавитьОжидаемое(Колонки, "Уровень", "Строка(длина=0)");
	ДобавитьОжидаемое(Колонки, "ПорядковыйНомер", "Число(10,0,Неотрицательный)");
	ДобавитьОжидаемое(Колонки, "Текст", "Строка(длина=0)");
	Возврат Колонки;

КонецФункции

// Валидное описание читателя по контракту D28.
Функция ВалидноеОписание()

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "тест_читатель");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", "Тестовый читатель");
	Описание.Вставить("РасширенияФайлов", СтрРазделить("csv,txt", ","));
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Описание.Вставить("Кодировка", "windows-1251");
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка." + ИмяМетода, Параметры);

КонецФункции

Функция ПроверитьОписание(Описание)

	Параметры = Новый Массив;
	Параметры.Добавить(Описание);

	Ошибки = Продукт("ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(ТипЗнч(Ошибки) = Тип("Массив"), "ПроверитьОписаниеЧитателя возвращает массив").ЭтоИстина();

	Возврат Ошибки;

КонецФункции

// Ошибка с подстрокой есть среди ошибок. Тексты всех ошибок идут в сообщение.
Процедура ПроверитьЕстьОшибкаСПодстрокой(Ошибки, Подстрока, Контекст)

	Найдена = Ложь;
	Для Каждого Текст Из Ошибки Цикл
		Если СтрНайти(Текст, Подстрока) > 0 Тогда
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Найдена, Контекст + ": ожидали ошибку с подстрокой '" + Подстрока
		+ "'. Фактические ошибки: [" + СтрСоединить(Ошибки, " | ") + "]").ЭтоИстина();

КонецПроцедуры

Процедура ДобавитьОжидаемое(Перечень, Имя, Тип)

	Перечень.Добавить(Новый Структура("Имя, Тип", Имя, Тип));

КонецПроцедуры

Функция ЕстьИмяВПеречне(Перечень, Имя)

	Для Каждого Элемент Из Перечень Цикл
		Если Элемент.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Значение поля структуры; Неопределено, если не структура или поля нет.
Функция ЗначениеПоля(Структура, Имя)

	Если ТипЗнч(Структура) <> Тип("Структура") Или Не Структура.Свойство(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Структура[Имя];

КонецФункции

// Поле-таблица значений; Неопределено, если поля нет или оно не таблица.
Функция ПолеТаблицы(Структура, Имя)

	Значение = ЗначениеПоля(Структура, Имя);
	Если ТипЗнч(Значение) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция МеткаЗначения(Значение)

	// Тип() принимает только строковый литерал, поэтому проверки перечислены явно.
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Тогда
		Возврат "Число";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "Строка";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Дата";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Булево";
	ИначеЕсли ТипЗначения = Тип("Неопределено") Тогда
		Возврат "Неопределено";
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат "ТаблицаЗначений";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "Массив";
	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Возврат "Структура";
	КонецЕсли;
	Возврат "иной тип: " + Строка(ТипЗначения);

КонецФункции

// Сверка колонок таблицы (порядок, имя, тип с квалификаторами) с ожидаемым перечнем.
Функция СверитьКолонки(Таблица, Ожидаемое)

	Расхождения = Новый Массив;
	Если Таблица = Неопределено Тогда
		Расхождения.Добавить("поле не является таблицей значений");
		Возврат Расхождения;
	КонецЕсли;

	Если Таблица.Колонки.Количество() <> Ожидаемое.Количество() Тогда
		Расхождения.Добавить("колонок " + Таблица.Колонки.Количество() + ", ожидали " + Ожидаемое.Количество());
	КонецЕсли;

	Для Индекс = 0 По Ожидаемое.ВГраница() Цикл
		Колонка = Ожидаемое[Индекс];
		Если Индекс > Таблица.Колонки.Количество() - 1 Тогда
			Расхождения.Добавить("нет колонки " + Колонка.Имя + " на позиции " + Индекс);
			Продолжить;
		КонецЕсли;
		Фактическая = Таблица.Колонки[Индекс];
		Если Фактическая.Имя <> Колонка.Имя Тогда
			Расхождения.Добавить("позиция " + Индекс + ": ожидали " + Колонка.Имя + ", фактически " + Фактическая.Имя);
			Продолжить;
		КонецЕсли;
		Описание = ОписаниеТипаКолонки(Фактическая);
		Если Описание <> Колонка.Тип Тогда
			Расхождения.Добавить(Колонка.Имя + ": ожидали " + Колонка.Тип + ", фактически " + Описание);
		КонецЕсли;
	КонецЦикла;

	Возврат Расхождения;

КонецФункции

Функция ОписаниеТипаКолонки(Колонка)

	ОписаниеТипов = Колонка.ТипЗначения;
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() <> 1 Тогда
		Возврат "составной тип из " + Типы.Количество();
	КонецЕсли;

	ТипКолонки = Типы[0];
	Если ТипКолонки = Тип("Строка") Тогда
		Возврат "Строка(длина=" + Формат(ОписаниеТипов.КвалификаторыСтроки.Длина, "ЧН=0; ЧГ=") + ")";
	ИначеЕсли ТипКолонки = Тип("Число") Тогда
		Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
		Знак = ?(Квалификаторы.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный, "Неотрицательный", "Любой");
		Возврат "Число(" + Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=") + ","
			+ Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=") + "," + Знак + ")";
	ИначеЕсли ТипКолонки = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Если Части = ЧастиДаты.Дата Тогда
			Возврат "Дата(Дата)";
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат "Дата(Время)";
		КонецЕсли;
		Возврат "Дата(ДатаВремя)";
	КонецЕсли;

	Возврат "иной тип: " + Строка(ТипКолонки);

КонецФункции

// Вызывает ПроверитьВыписку продукта. Без второго аргумента платформа "держала" тот же конверт.
Функция Проверить(Выписка, СозданнаяПлатформой = Неопределено)

	Параметры = Новый Массив;
	Параметры.Добавить(Выписка);
	Параметры.Добавить(?(СозданнаяПлатформой = Неопределено, Выписка, СозданнаяПлатформой));

	Результат = Продукт("ПроверитьВыписку", Параметры);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат) = Тип("Структура"), "ПроверитьВыписку возвращает структуру").ЭтоИстина();

	Возврат Результат;

КонецФункции

// Отклонение целого конверта: не принят, операций нет, есть сообщение уровня "Ошибка" с текстом.
Процедура ПроверитьОтклонение(Результат, Контекст)

	Диагностика = ТекстыДиагностики(Результат.Диагностика);

	ЮТест.ОжидаетЧто(Результат.Принята, Контекст + ": Принята").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), Контекст + ": строк в Операции").Равно(0);
	// Курсор этапа 5 не должен считать отклоненное чтение полным (D28, последний абзац).
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, Контекст + ": ЕстьНевалидныеСтроки у отклоненного конверта").ЭтоИстина();

	ЕстьОшибка = Ложь;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = "Ошибка" И Не ПустаяСтрока(Сообщение.Текст) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьОшибка, Контекст + ": диагностика объясняет причину. Диагностика: " + Диагностика).ЭтоИстина();

КонецПроцедуры

// Добавляет в конверт валидную строку операции (все поля заполнены допустимыми значениями).
Функция ДобавитьВалиднуюСтроку(Выписка, ПорядковыйНомер)

	Операция = Выписка.Операции.Добавить();
	Операция.ПорядковыйНомер = ПорядковыйНомер;
	Операция.НомерСчета = "UA213223130000026007233566001";
	Операция.Валюта = "980";
	Операция.ДатаОперации = Дата(2026, 10, 1, 12, 30, 0);
	Операция.НомерДокумента = "17";
	Операция.ДатаДокумента = Дата(2026, 10, 1);
	Операция.Сумма = 125.40;
	Операция.Направление = "Поступило";
	Операция.ИдентификаторОперации = "TX-" + Формат(ПорядковыйНомер, "ЧН=0; ЧГ=");
	Операция.КонтрагентНаименование = "ТОВ Ромашка";
	Операция.КонтрагентНомерСчета = "UA903052992990004149123456789";
	Операция.КонтрагентКод = "12345678";
	Операция.КонтрагентМФО = "305299";
	Операция.НазначениеПлатежа = "Оплата за товар";
	Операция.СырыеДанные = "17;01.10.2026;125,40";
	Возврат Операция;

КонецФункции

// Все сообщения таблицы диагностики одной строкой - для текста проверок.
Функция ТекстыДиагностики(Диагностика)

	Части = Новый Массив;
	Для Каждого Сообщение Из Диагностика Цикл
		Части.Добавить(Сообщение.Уровень + " [" + Формат(Сообщение.ПорядковыйНомер, "ЧН=0; ЧГ=") + "] " + Сообщение.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

Функция СтрокиИзМассива(Массив)

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Результат.Добавить(Формат(Элемент, "ЧГ="));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
