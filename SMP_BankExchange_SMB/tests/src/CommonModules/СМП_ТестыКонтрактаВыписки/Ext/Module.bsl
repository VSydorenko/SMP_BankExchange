// Тесты контракта читателя выписок (спека D27, D28): конверт, параметры чтения, проверка
// описания читателя. Без данных в базе: транзакция не нужна.
//
// ИМЕНОВАННОЕ ИСКЛЮЧЕНИЕ из правила «тест не задает условие, которое измеряет»: ожидаемая
// схема конверта (ПоляКонверта, КолонкиОпераций, КолонкиДиагностики, ПоляПараметровЧтения)
// записана здесь, в самом тесте, потому что тест ЗДЕСЬ И ЕСТЬ спецификация контракта. Изменение
// схемы конструктором без изменения этих перечней краснит тест, а изменение перечней видно в
// diff: так смена контракта не проходит молча.
//
// Продукт вызывается только через СМП_ТестыВызовПродукта (позднее связывание).
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Контракт выписки: версия и конверт")
			.ДобавитьСерверныйТест("ВерсияКонтрактаИПоддерживаемыеВерсии")
			.ДобавитьСерверныйТест("СхемаКонверта_ПоляИТипы")
			.ДобавитьСерверныйТест("СхемаКонверта_КолонкиОпераций")
			.ДобавитьСерверныйТест("СхемаКонверта_КолонкиДиагностики")
			.ДобавитьСерверныйТест("ВерсияВНовомКонвертеРавнаВерсииКонтракта")
			.ДобавитьСерверныйТест("ЧтениеПолноеПоУмолчаниюЛожь")
			.ДобавитьСерверныйТест("ПустыеЗначенияПоУмолчанию")
			.ДобавитьСерверныйТест("СтроковаяКолонкаПринимаетТысячуСимволов")
			.ДобавитьСерверныйТест("ДваКонвертаНезависимы")
			.ДобавитьСерверныйТест("ПараметрыЧтения_ПоляИЗначения")
		.ДобавитьТестовыйНабор("Контракт выписки: проверка описания читателя")
			.ДобавитьСерверныйТест("Описание_ВалидноеДаетПустойМассив")
			.ДобавитьСерверныйТест("Описание_БезОбязательногоПоляДаетОшибкуСИменемПоля")
				.СПараметрами("Идентификатор")
				.СПараметрами("ВерсияКонтракта")
				.СПараметрами("Наименование")
				.СПараметрами("РасширенияФайлов")
				.СПараметрами("ДаетИдентификаторыОпераций")
				.СПараметрами("ДаетОстатки")
			.ДобавитьСерверныйТест("Описание_НеверноеЗначениеПоляДаетОшибкуСИменемПоля")
				.СПараметрами("Идентификатор", "")
				.СПараметрами("Идентификатор", 5)
				.СПараметрами("Наименование", 5)
				.СПараметрами("ДаетОстатки", "Истина")
				.СПараметрами("ДаетИдентификаторыОпераций", 1)
				.СПараметрами("РасширенияФайлов", "csv")
				.СПараметрами("ВерсияКонтракта", "1")
				.СПараметрами("ВерсияКонтракта", 1.5)
			.ДобавитьСерверныйТест("Описание_НеподдерживаемаяВерсияНазываетВерсииВТексте")
				.СПараметрами("версия 2", 2)
				.СПараметрами("версия 7", 7)
			.ДобавитьСерверныйТест("Описание_РасширениеСКрапкойИлиВВерхнемРегистреДаетОшибку")
				.СПараметрами(".csv", ".csv")
				.СПараметрами("CSV", "CSV")
				.СПараметрами("Csv", "Csv")
				.СПараметрами("с пробелом", "c sv")
			.ДобавитьСерверныйТест("Описание_ДопустимыеРасширенияБезОшибок")
				.СПараметрами("csv", "csv")
				.СПараметрами("txt и xml", "txt,xml")
			.ДобавитьСерверныйТест("Описание_ПустойМассивРасширенийДопустимДляAPI")
			.ДобавитьСерверныйТест("Описание_НеСтруктураДаетОшибкуБезИсключения");

КонецПроцедуры

#Область КонтрактКонверта

Процедура ВерсияКонтрактаИПоддерживаемыеВерсии() Экспорт

	Версия = Продукт("ВерсияКонтракта");
	Поддерживаемые = Продукт("ПоддерживаемыеВерсииКонтракта");

	ЮТест.ОжидаетЧто(Версия, "Версия контракта").Равно(1);

	ТипМассив = ТипЗнч(Поддерживаемые) = Тип("Массив");
	ЮТест.ОжидаетЧто(ТипМассив, "ПоддерживаемыеВерсииКонтракта возвращает массив").ЭтоИстина();

	Если ТипМассив Тогда
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокиИзМассива(Поддерживаемые), ","), "Поддерживаемые версии").Равно("1");
	КонецЕсли;

КонецПроцедуры

Процедура СхемаКонверта_ПоляИТипы() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Ожидаемое = ПоляКонверта();
	Расхождения = Новый Массив;

	Фактические = Новый Массив;
	Если ТипЗнч(Выписка) = Тип("Структура") Тогда
		Для Каждого Элемент Из Выписка Цикл
			Фактические.Добавить(Элемент.Ключ);
		КонецЦикла;
	Иначе
		Расхождения.Добавить("НоваяВыписка вернула не Структуру: " + ТипЗнч(Выписка));
	КонецЕсли;

	Для Каждого Поле Из Ожидаемое Цикл
		Если Не Выписка.Свойство(Поле.Имя) Тогда
			Расхождения.Добавить("нет поля " + Поле.Имя);
			Продолжить;
		КонецЕсли;
		Метка = МеткаЗначения(Выписка[Поле.Имя]);
		Если Метка <> Поле.Тип Тогда
			Расхождения.Добавить(Поле.Имя + ": ожидали " + Поле.Тип + ", фактически " + Метка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из Фактические Цикл
		Если Не ЕстьИмяВПеречне(Ожидаемое, Имя) Тогда
			Расхождения.Добавить("лишнее поле " + Имя);
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения схемы полей конверта с контрактом").Равно("");

КонецПроцедуры

Процедура СхемаКонверта_КолонкиОпераций() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Расхождения = СверитьКолонки(ПолеТаблицы(Выписка, "Операции"), КолонкиОпераций());

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения колонок Операции с контрактом").Равно("");

КонецПроцедуры

Процедура СхемаКонверта_КолонкиДиагностики() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Расхождения = СверитьКолонки(ПолеТаблицы(Выписка, "Диагностика"), КолонкиДиагностики());

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения колонок Диагностика с контрактом").Равно("");

КонецПроцедуры

Процедура ВерсияВНовомКонвертеРавнаВерсииКонтракта() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Версия = Продукт("ВерсияКонтракта");

	ЮТест.ОжидаетЧто(ЗначениеПоля(Выписка, "ВерсияКонтракта"), "Выписка.ВерсияКонтракта").Равно(Версия);
	ЮТест.ОжидаетЧто(Версия, "ВерсияКонтракта()").Равно(1);

КонецПроцедуры

// Защита от красивой, но опасной ошибки: читатель, упавший посередине, не должен выглядеть
// полным (курсор этапа 5 перешагнул бы потерянные операции).
Процедура ЧтениеПолноеПоУмолчаниюЛожь() Экспорт

	Выписка = Продукт("НоваяВыписка");

	Значение = ЗначениеПоля(Выписка, "ЧтениеПолное");

	ЮТест.ОжидаетЧто(Значение, "Выписка.ЧтениеПолное нового конверта").Равно(Ложь);

КонецПроцедуры

Процедура ПустыеЗначенияПоУмолчанию() Экспорт

	Выписка = Продукт("НоваяВыписка");
	ПустаяДата = Дата(1, 1, 1);

	Расхождения = Новый Массив;
	Для Каждого Имя Из СтрРазделить("НачалоПериода,КонецПериода,ГраницаДоверия", ",") Цикл
		Если ЗначениеПоля(Выписка, Имя) <> ПустаяДата Тогда
			Расхождения.Добавить(Имя + " не пустая дата");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("НачальныйОстаток,КонечныйОстаток", ",") Цикл
		Если МеткаЗначения(ЗначениеПоля(Выписка, Имя)) <> "Неопределено" Тогда
			Расхождения.Добавить(Имя + " не Неопределено");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Операции,Диагностика", ",") Цикл
		Таблица = ПолеТаблицы(Выписка, Имя);
		Если Таблица = Неопределено Тогда
			Расхождения.Добавить(Имя + " не таблица значений");
		ИначеЕсли Таблица.Количество() <> 0 Тогда
			Расхождения.Добавить(Имя + " не пуста");
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения значений нового конверта по умолчанию").Равно("");

КонецПроцедуры

// Мысль о ловушке: Строка(N) молча обрезала бы. Колонка без ограничения длины хранит все.
Процедура СтроковаяКолонкаПринимаетТысячуСимволов() Экспорт

	Выписка = Продукт("НоваяВыписка");
	Длинная = СтрПовторить("я", 1000);

	Расхождения = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Операции,Диагностика", ",") Цикл
		Таблица = ПолеТаблицы(Выписка, Имя);
		Если Таблица = Неопределено Тогда
			Расхождения.Добавить(Имя + " не таблица значений");
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Таблица.Добавить();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Не Колонка.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока[Колонка.Имя] = Длинная;
			Если СтрДлина(НоваяСтрока[Колонка.Имя]) <> 1000 Тогда
				Расхождения.Добавить(Имя + "." + Колонка.Имя + ": после записи 1000 символов длина "
					+ СтрДлина(НоваяСтрока[Колонка.Имя]));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Обрезание строковых колонок").Равно("");

КонецПроцедуры

Процедура ДваКонвертаНезависимы() Экспорт

	Первая = Продукт("НоваяВыписка");
	Вторая = Продукт("НоваяВыписка");

	ПерваяОперации = ПолеТаблицы(Первая, "Операции");
	ВтораяОперации = ПолеТаблицы(Вторая, "Операции");
	ПерваяДиагностика = ПолеТаблицы(Первая, "Диагностика");
	ВтораяДиагностика = ПолеТаблицы(Вторая, "Диагностика");

	ТаблицыЕсть = ПерваяОперации <> Неопределено И ВтораяОперации <> Неопределено
		И ПерваяДиагностика <> Неопределено И ВтораяДиагностика <> Неопределено;
	ЮТест.ОжидаетЧто(ТаблицыЕсть, "Оба конверта содержат таблицы Операции и Диагностика").ЭтоИстина();
	Если Не ТаблицыЕсть Тогда
		Возврат;
	КонецЕсли;

	ПерваяОперации.Добавить();
	ПерваяДиагностика.Добавить();
	Первая.Вставить("ЧтениеПолное", Истина);

	ЮТест.ОжидаетЧто(ВтораяОперации.Количество(), "Строк в Операции второго конверта").Равно(0);
	ЮТест.ОжидаетЧто(ВтораяДиагностика.Количество(), "Строк в Диагностике второго конверта").Равно(0);
	ЮТест.ОжидаетЧто(ЗначениеПоля(Вторая, "ЧтениеПолное"), "ЧтениеПолное второго конверта").Равно(Ложь);

КонецПроцедуры

Процедура ПараметрыЧтения_ПоляИЗначения() Экспорт

	Параметры = Продукт("НовыеПараметрыЧтения");

	Ожидаемое = Новый Массив;
	Ожидаемое.Добавить(Новый Структура("Имя, Тип", "НомерСчета", "Строка"));
	Ожидаемое.Добавить(Новый Структура("Имя, Тип", "Кодировка", "Строка"));
	Ожидаемое.Добавить(Новый Структура("Имя, Тип", "НачалоПериода", "Дата"));
	Ожидаемое.Добавить(Новый Структура("Имя, Тип", "КонецПериода", "Дата"));
	Ожидаемое.Добавить(Новый Структура("Имя, Тип", "УчетныеДанные", "Неопределено"));

	Расхождения = Новый Массив;
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Расхождения.Добавить("НовыеПараметрыЧтения вернула не Структуру: " + ТипЗнч(Параметры));
	Иначе
		Для Каждого Поле Из Ожидаемое Цикл
			Если Не Параметры.Свойство(Поле.Имя) Тогда
				Расхождения.Добавить("нет поля " + Поле.Имя);
				Продолжить;
			КонецЕсли;
			Метка = МеткаЗначения(Параметры[Поле.Имя]);
			Если Метка <> Поле.Тип Тогда
				Расхождения.Добавить(Поле.Имя + ": ожидали " + Поле.Тип + ", фактически " + Метка);
			КонецЕсли;
		КонецЦикла;
		Если Параметры.Количество() <> Ожидаемое.Количество() Тогда
			Расхождения.Добавить("полей " + Параметры.Количество() + ", ожидали " + Ожидаемое.Количество());
		КонецЕсли;
		// Пустые значения: читатель сам определяет кодировку, если она пуста.
		Если Параметры.Свойство("Кодировка") И Параметры.Кодировка <> "" Тогда
			Расхождения.Добавить("Кодировка по умолчанию не пуста");
		КонецЕсли;
	КонецЕсли;

	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, "; "), "Расхождения параметров чтения с контрактом").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ПроверкаОписанияЧитателя

Процедура Описание_ВалидноеДаетПустойМассив() Экспорт

	Ошибки = ПроверитьОписание(ВалидноеОписание());

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, "; "), "Ошибки валидного описания").Равно("");

КонецПроцедуры

Процедура Описание_БезОбязательногоПоляДаетОшибкуСИменемПоля(Поле) Экспорт

	Описание = ВалидноеОписание();
	Описание.Удалить(Поле);

	Ошибки = ПроверитьОписание(Описание);

	ПроверитьЕстьОшибкаСПодстрокой(Ошибки, Поле, "Описание без поля " + Поле);

КонецПроцедуры

Процедура Описание_НеверноеЗначениеПоляДаетОшибкуСИменемПоля(Поле, Значение) Экспорт

	Описание = ВалидноеОписание();
	Описание[Поле] = Значение;

	Ошибки = ПроверитьОписание(Описание);

	ПроверитьЕстьОшибкаСПодстрокой(Ошибки, Поле, "Описание с полем " + Поле + " = " + Строка(Значение));

КонецПроцедуры

// Текст должен быть понятен администратору (D2, D31): какая версия пришла и какие
// поддерживаются. Язык сообщения тест не фиксирует, поэтому ищет число пришедшей версии,
// число поддерживаемой версии и имя поля.
Процедура Описание_НеподдерживаемаяВерсияНазываетВерсииВТексте(Название, Версия) Экспорт

	Описание = ВалидноеОписание();
	Описание.ВерсияКонтракта = Версия;

	Ошибки = ПроверитьОписание(Описание);

	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Число ошибок для версии " + Версия).Больше(0);

	Текст = СтрСоединить(Ошибки, " | ");
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "ВерсияКонтракта") > 0, "Ошибка называет поле ВерсияКонтракта. Текст: " + Текст).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Текст, Формат(Версия, "ЧГ=")) > 0, "Ошибка называет пришедшую версию " + Версия + ". Текст: " + Текст).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Текст, "1") > 0, "Ошибка называет поддерживаемую версию 1. Текст: " + Текст).ЭтоИстина();

КонецПроцедуры

Процедура Описание_РасширениеСКрапкойИлиВВерхнемРегистреДаетОшибку(Название, Расширение) Экспорт

	Описание = ВалидноеОписание();
	Описание.РасширенияФайлов = Новый Массив;
	Описание.РасширенияФайлов.Добавить(Расширение);

	Ошибки = ПроверитьОписание(Описание);

	ПроверитьЕстьОшибкаСПодстрокой(Ошибки, "РасширенияФайлов", "Расширение '" + Расширение + "'");

КонецПроцедуры

Процедура Описание_ДопустимыеРасширенияБезОшибок(Название, Список) Экспорт

	Описание = ВалидноеОписание();
	Описание.РасширенияФайлов = СтрРазделить(Список, ",");

	Ошибки = ПроверитьОписание(Описание);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, "; "), "Ошибки допустимых расширений " + Список).Равно("");

КонецПроцедуры

Процедура Описание_ПустойМассивРасширенийДопустимДляAPI() Экспорт

	Описание = ВалидноеОписание();
	Описание.РасширенияФайлов = Новый Массив;

	Ошибки = ПроверитьОписание(Описание);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, "; "), "Ошибки описания с пустым списком расширений (API)").Равно("");

КонецПроцедуры

Процедура Описание_НеСтруктураДаетОшибкуБезИсключения() Экспорт

	Ошибки = ПроверитьОписание(Неопределено);

	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Число ошибок для описания, не являющегося структурой").Больше(0);

КонецПроцедуры

#КонецОбласти

