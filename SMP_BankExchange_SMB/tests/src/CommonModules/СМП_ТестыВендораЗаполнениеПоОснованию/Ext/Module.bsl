// Характеризационные тесты вендорских методов заполнения банковских документов "по основанию" (УНФ).
//
// Мера: спека docs/superpowers/specs/2026-10-12-smb-import-platform-design.md, D21 (абзац "Как именно
// вызывать методы по основанию"), D34, D15; исследование temp/research/2026-10-12-api-period/11-fill-by-basis.md.
// Назначение: стать красными, если обновление УНФ изменит поведение, от которого зависит этап 4. Красный на
// первом прогоне - не поломка, а ИЗМЕРЕНИЕ: расхождение с тезой спеки записывается как находка, ожидание
// заменяется на измеренное с комментарием "ВИМІРЯНО <дата>: суперечить спеці D21 - ...".
//
// Метод вендора вызывается НАПРЯМУЮ на созданном программно банковском документе (не Заполнить() и не
// ОбработкаЗаполнения: спека D21 отвергает этот путь). Дата банка ставится ДО вызова (от нее курсы).
//
// Условие измерения: ВалютаУчета = USD, договоры и банковские счета организаций - в национальной валюте (UAH);
// ВестиУчетОплатыПоСчетам = Нет по умолчанию, флаги контрагента в матрице задаются явно.
//
// Правила - docs/architecture/testing.md. Каждый тест с данными работает в СВОЕЙ транзакции (.ВТранзакции()).
// Константы и курсы тесты только читают.
//
// Методы (ВызватьМетод): "ПНС.Счет" - ПоступлениеНаСчет.ЗаполнитьПоСчетуНаОплату, "ПНС.Заказ" -
// ПоступлениеНаСчет.ЗаполнитьПоЗаказуПокупателя, "РС.СчетПоставщика" - РасходСоСчета.ЗаполнитьПоСчетНаОплатуПоставщика,
// "РС.ЗаказПоставщику" - РасходСоСчета.ЗаполнитьПоЗаказПоставщику.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Входящие: сумма и колонки расшифровки")
			.ДобавитьСерверныйТест("ЗаказПокупателяБезСуммыДаетСуммуЗаказаИКолонкиРасшифровки").ВТранзакции()
			.ДобавитьСерверныйТест("ЗаказПокупателяБезСуммыВычитаетПредыдущуюОплату").ВТранзакции()
			.ДобавитьСерверныйТест("СчетБезПредыдущихОплатДаетПолнуюСумму").ВТранзакции()
			.ДобавитьСерверныйТест("СчетБезСуммыВычитаетЧастичнуюОплату").ВТранзакции()
				.СПараметрами("счет с учетом оплат по счетам", Истина)
				.СПараметрами("счет без учета оплат по счетам", Ложь)
			.ДобавитьСерверныйТест("СчетСоСуммойДаетОдинРядокНаВсюСуммуНеВычитаяОплаты").ВТранзакции()
				.СПараметрами("сумма равна сумме счета", 1000)
				.СПараметрами("сумма банка меньше остатка", 300)
				.СПараметрами("сумма банка больше суммы счета", 1500)
			.ДобавитьСерверныйТест("ЗаказСоСуммойДаетОдинРядокНаВсюСуммуНеВычитаяОплаты").ВТранзакции()
			.ДобавитьСерверныйТест("КурсИКратностьСтавятсяПоВалютеДоговора").ВТранзакции()
		.ДобавитьТестовыйНабор("Входящие: матрица признаков контрагента")
			.ДобавитьСерверныйТест("ЗаказПокупателяПризнакиКонтрагентаОпределяютКолонкиОснования").ВТранзакции()
				.СПараметрами("все по умолчанию", Истина, Истина, Истина, Ложь)
				.СПараметрами("все выключены", Ложь, Ложь, Ложь, Ложь)
				.СПараметрами("только по заказам", Ложь, Ложь, Истина, Ложь)
				.СПараметрами("только по счетам", Ложь, Ложь, Ложь, Истина)
				.СПараметрами("только по документам", Ложь, Истина, Ложь, Ложь)
				.СПараметрами("только по договорам", Истина, Ложь, Ложь, Ложь)
			.ДобавитьСерверныйТест("СчетНаОплатуПризнакиКонтрагентаОпределяютКолонкиОснования").ВТранзакции()
				.СПараметрами("все по умолчанию", Истина, Истина, Истина, Ложь)
				.СПараметрами("все выключены", Ложь, Ложь, Ложь, Ложь)
				.СПараметрами("только по заказам", Ложь, Ложь, Истина, Ложь)
				.СПараметрами("только по счетам", Ложь, Ложь, Ложь, Истина)
				.СПараметрами("только по документам", Ложь, Истина, Ложь, Ложь)
				.СПараметрами("только по договорам", Истина, Ложь, Ложь, Ложь)
		.ДобавитьТестовыйНабор("Исходящие")
			.ДобавитьСерверныйТест("ЗаказПоставщикуБезОплатДаетСуммуЗаказаИКолонкиРасшифровки").ВТранзакции()
			.ДобавитьСерверныйТест("ЗаказПоставщикуБезСуммыВычитаетПредыдущуюОплату").ВТранзакции()
			.ДобавитьСерверныйТест("СчетПоставщикаБезОплатДаетПолнуюСуммуИКолонкиРасшифровки").ВТранзакции()
			.ДобавитьСерверныйТест("СчетПоставщикаЗаполняетсяПолнойСуммойНеВычитаяОплаты").ВТранзакции()
				.СПараметрами("с учетом оплат по счетам", Истина)
				.СПараметрами("без учета оплат по счетам", Ложь)
			.ДобавитьСерверныйТест("СчетПоставщикаСоСуммойДаетОдинРядокНаВсюСумму").ВТранзакции()
		.ДобавитьТестовыйНабор("Банк заплатил меньше остатка")
			.ДобавитьСерверныйТест("РаспределениеПоСуммеПлатежаНеПересчитываетСуммуРасчетов").ВТранзакции()
			.ДобавитьСерверныйТест("РаспределениеПоСуммеПлатежаПересчитываетСуммуНДС").ВТранзакции()
		.ДобавитьТестовыйНабор("Банк заплатил больше остатка")
			.ДобавитьСерверныйТест("СтрокаАвансаНаРазницуПроходитПроверкуЗаполненияИПроводится").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("ПНС.Заказ")
				.СПараметрами("РС.СчетПоставщика")
		.ДобавитьТестовыйНабор("Побочные эффекты метода")
			.ДобавитьСерверныйТест("МетодНеМеняетПоляДанныхБанка").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("ПНС.Заказ")
				.СПараметрами("РС.СчетПоставщика")
				.СПараметрами("РС.ЗаказПоставщику")
			.ДобавитьСерверныйТест("МетодНеСтавитСпособЗачетаВСтроках").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("ПНС.Заказ")
				.СПараметрами("РС.СчетПоставщика")
				.СПараметрами("РС.ЗаказПоставщику")
			.ДобавитьСерверныйТест("МетодНеСтавитАвтоматическийВариантЗаполненияРасшифровки").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("ПНС.Заказ")
				.СПараметрами("РС.СчетПоставщика")
				.СПараметрами("РС.ЗаказПоставщику")
			.ДобавитьСерверныйТест("МетодСтавитДокументОснованиеИШапкуПоОснованию").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("ПНС.Заказ")
				.СПараметрами("РС.СчетПоставщика")
				.СПараметрами("РС.ЗаказПоставщику")
		.ДобавитьТестовыйНабор("ПроверкаЗаполнения: точное совпадение сумм")
			.ДобавитьСерверныйТест("СуммаДокументаНеРавнаИтогуРасшифровкиДаетОшибку").ВТранзакции()
				.СПараметрами("ПНС.Счет, на копейку больше", "ПНС.Счет", 0.01)
				.СПараметрами("ПНС.Счет, на 100 меньше", "ПНС.Счет", -100)
				.СПараметрами("РС.СчетПоставщика, на копейку больше", "РС.СчетПоставщика", 0.01)
				.СПараметрами("РС.СчетПоставщика, на 100 меньше", "РС.СчетПоставщика", -100)
			.ДобавитьСерверныйТест("РавныеСуммыНеДаютОшибкиСуммы").ВТранзакции()
				.СПараметрами("ПНС.Счет")
				.СПараметрами("РС.СчетПоставщика")
		.ДобавитьТестовыйНабор("Крайние состояния основания")
			.ДобавитьСерверныйТест("ПолностьюОплаченныйСчетДаетНулевойОстаток").ВТранзакции()
				.СПараметрами("с учетом оплат по счетам", Истина)
				.СПараметрами("без учета оплат по счетам", Ложь)
			.ДобавитьСерверныйТест("НепроведенныйСчетЗаполняетсяКакПроведенный").ВТранзакции()
			.ДобавитьСерверныйТест("ПомеченныйНаУдалениеСчетЗаполняетсяКакОбычный").ВТранзакции()
			.ДобавитьСерверныйТест("ОсноваДругойОрганизацииНеОтклоняетсяМетодомОрганизацияБерется").ВТранзакции()
		// ПОСЛЕДНИМ в модуле и БЕЗ транзакции: итог всех тестов с данными (та же функция подсчета, что в СМП_ТестыФикстур).
		.ДобавитьТестовыйНабор("Сторож остатков: итог")
			.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Входящие

// Теза: без Сумма метод дает сумму документа = остаток к оплате (здесь оплат нет - полная сумма заказа) и одну
// строку расшифровки с основанием в колонке Заказ (спека D21; исследование 11, "Суммы"). Колонки: Договор,
// ПризнакАванса (заказ - аванс), СуммаРасчетов = СуммаПлатежа (договор в UAH), СтавкаНДС из основания.
Процедура ЗаказПокупателяБезСуммыДаетСуммуЗаказаИКолонкиРасшифровки() Экспорт

	Метод = "ПНС.Заказ";
	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = остаток к оплате (оплат нет)").Равно(Основа.Сумма);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, ФлагиКонтрагента(Истина, Истина, Истина, Ложь), Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, "Заказ без суммы");

КонецПроцедуры

// Теза: без Сумма оплаты другими документами вычитаются из суммы заказа (D21, "Сумма банка != остатку":
// "метод вызывается без Сумма - дает остаток к оплате с вычитанием уже оплаченного").
Процедура ЗаказПокупателяБезСуммыВычитаетПредыдущуюОплату() Экспорт

	Метод = "ПНС.Заказ";
	Основа = НоваяОснова(Метод, 1000);
	Оплачено = 400;
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	Остаток = Основа.Сумма - Оплачено;
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма заказа - предыдущая оплата").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "СуммаПлатежа строки = остаток").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаРасчетов, "СуммаРасчетов строки = остаток").Равно(Остаток);

КонецПроцедуры

// Теза: счет без предыдущих оплат и без Сумма - полная сумма счета (D21).
Процедура СчетБезПредыдущихОплатДаетПолнуюСумму() Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1200);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма счета").Равно(Основа.Сумма);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, ФлагиКонтрагента(Истина, Истина, Истина, Ложь), Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, "Счет без оплат");

КонецПроцедуры

// Теза: счет с частичной предыдущей оплатой, без Сумма - остаток с вычитанием оплаченного (D21; поправка к
// 10-settlement-docs.md: "учитывают частичные оплаты" - только в режиме без Сумма).
// Параметр ПоСчетам (ВестиУчетОплатыПоСчетам контрагента): спека тезы от него не ставит; в тексте провала указано,
// сколько оплаты регистр ОплатаСчетовИЗаказов привязал к счету.
Процедура СчетБезСуммыВычитаетЧастичнуюОплату(Имя, ПоСчетам) Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1000, ФлагиКонтрагента(Истина, Истина, Истина, ПоСчетам));
	Оплачено = 400;
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	// ВИМІРЯНО 2026-10-13: суперечить спеці D21 - вирахування оплат працює лише при ВестиУчетОплатыПоСчетам = Да
	// (оплата тоді привʼязується до рахунку в ОплатаСчетовИЗаказов); при Нет у регістрі 0 і сума = повна сума
	// рахунку. Знахідка 2 таблиці знахідок задачі 4.
	Остаток = ?(ПоСчетам, Основа.Сумма - Оплачено, Основа.Сумма);
	ВРегистре = ОплаченоПоРегистру(Основа.Основание);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), Имя + ": строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, Имя + ": сумма документа = сумма счета - предыдущая оплата (в регистре оплат по счету: "
		+ ВРегистре + ")").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "СуммаПлатежа строки = остаток").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаРасчетов, "СуммаРасчетов строки = остаток").Равно(Остаток);

КонецПроцедуры

// Теза: с Сумма - ОДИН рядок на всю переданную сумму, оплаты другими документами НЕ вычитаются (D21; 11, "Суммы").
// Предыдущая оплата 400 существует, но не влияет. Сумма банка: равна сумме счета / меньше остатка / больше суммы счета.
Процедура СчетСоСуммойДаетОдинРядокНаВсюСуммуНеВычитаяОплаты(Имя, СуммаБанка) Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1000);
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, 400);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание, СуммаБанка);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), Имя + ": одна строка расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, Имя + ": СуммаПлатежа = переданная Сумма").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаРасчетов, Имя + ": СуммаРасчетов = переданная Сумма (договор в UAH)").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, Имя + ": СуммаДокумента = переданная Сумма").Равно(СуммаБанка);

КонецПроцедуры

// Теза: то же для заказа покупателя - с Сумма предыдущая оплата не вычитается (D21).
Процедура ЗаказСоСуммойДаетОдинРядокНаВсюСуммуНеВычитаяОплаты() Экспорт

	Метод = "ПНС.Заказ";
	Основа = НоваяОснова(Метод, 1000);
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, 400);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание, Основа.Сумма);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Одна строка расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "СуммаПлатежа = переданная Сумма").Равно(Основа.Сумма);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "СуммаДокумента = переданная Сумма").Равно(Основа.Сумма);

КонецПроцедуры

// Находка консультанта плана (D15): ВалютаУчета (USD) != валюта счета и договора (UAH). Теза: Курс/Кратность
// строки и шапки - курс ВАЛЮТЫ ДОГОВОРА на дату документа (КурсыВалют.СрезПоследних), а не курс валюты учета;
// валюта денежных средств документа - валюта счета организации (национальная). Курс читается, не пишется.
Процедура КурсИКратностьСтавятсяПоВалютеДоговора() Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ВалютаДоговора = РеквизитыСсылки(Основа.Договор, "ВалютаРасчетов").ВалютаРасчетов;
	Национальная = Константы.НациональнаяВалюта.Получить();
	ЮТест.ОжидаетЧто(ВалютаДоговора, "Условие: валюта договора фикстуры - национальная").Равно(Национальная);
	ЮТест.ОжидаетЧто(Документ.ВалютаДенежныхСредств, "Валюта документа = валюта счета организации (национальная), не ВалютаУчета")
		.Равно(Национальная);
	КурсДоговора = КурсВалюты(ВалютаДоговора, Документ.Дата);
	СтрокаТЧ = Документ.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(СтрокаТЧ.Курс, "Курс строки = курс валюты договора на дату").Равно(КурсДоговора.Курс);
	ЮТест.ОжидаетЧто(СтрокаТЧ.Кратность, "Кратность строки = кратность валюты договора на дату").Равно(КурсДоговора.Кратность);
	ЮТест.ОжидаетЧто(Документ.Курс, "Курс шапки = курс валюты договора на дату").Равно(КурсДоговора.Курс);
	ЮТест.ОжидаетЧто(Документ.Кратность, "Кратность шапки = кратность валюты договора на дату").Равно(КурсДоговора.Кратность);

	ВалютаУчета = Константы.ВалютаУчета.Получить();
	КурсУчета = КурсВалюты(ВалютаУчета, Документ.Дата);
	Если КурсУчета.Курс <> КурсДоговора.Курс Или КурсУчета.Кратность <> КурсДоговора.Кратность Тогда
		СовпадаетСУчетом = СтрокаТЧ.Курс = КурсУчета.Курс И СтрокаТЧ.Кратность = КурсУчета.Кратность;
		ЮТест.ОжидаетЧто(СовпадаетСУчетом, "Курс строки не совпадает с курсом валюты учета (она не участвует)").ЭтоЛожь();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Матрица

// Теза (D21: "враховувати налаштування розрахунків у картці контрагента"; 11): колонки расшифровки получают
// основание по признакам контрагента: Заказ - при ВестиРасчетыПоЗаказам; Договор - ВСЕГДА (измерено, см. ОжидаемыеКолонки);
// Документ (документ расчетов) для заказа пуст при любых признаках (заказ без вида "заказ-наряд" - не документ
// расчетов); СчетНаОплату пуст: счета на основании заказа в фикстуре нет.
Процедура ЗаказПокупателяПризнакиКонтрагентаОпределяютКолонкиОснования(Имя, ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам) Экспорт

	Метод = "ПНС.Заказ";
	Флаги = ФлагиКонтрагента(ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам);
	Основа = НоваяОснова(Метод, 1000, Флаги);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), Имя + ": строк расшифровки").Равно(1);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, Флаги, Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

// Теза: для счета на оплату - СчетНаОплату получает основание при ВестиУчетОплатыПоСчетам; Заказ и Документ
// пусты (у фикстурного счета нет документа-основания); Договор - всегда (измерено, см. ОжидаемыеКолонки).
Процедура СчетНаОплатуПризнакиКонтрагентаОпределяютКолонкиОснования(Имя, ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам) Экспорт

	Метод = "ПНС.Счет";
	Флаги = ФлагиКонтрагента(ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам);
	Основа = НоваяОснова(Метод, 1200, Флаги);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), Имя + ": строк расшифровки").Равно(1);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, Флаги, Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

#КонецОбласти

#Область Исходящие

// Теза: заказ поставщику без оплат и без Сумма - полная сумма, основание в колонке Заказ (ВестиРасчетыПоЗаказам).
Процедура ЗаказПоставщикуБезОплатДаетСуммуЗаказаИКолонкиРасшифровки() Экспорт

	Метод = "РС.ЗаказПоставщику";
	Основа = НоваяОснова(Метод, 800);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма заказа").Равно(Основа.Сумма);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, ФлагиКонтрагента(Истина, Истина, Истина, Ложь), Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, "Заказ поставщику без оплат");

КонецПроцедуры

// Теза: заказ поставщику без Сумма вычитает предыдущие оплаты (11: "без Сумма - остаток к оплате ..., кроме
// счета поставщика - там полная сумма всегда").
Процедура ЗаказПоставщикуБезСуммыВычитаетПредыдущуюОплату() Экспорт

	Метод = "РС.ЗаказПоставщику";
	Основа = НоваяОснова(Метод, 800);
	Оплачено = 300;
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	Остаток = Основа.Сумма - Оплачено;
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма заказа - предыдущая оплата").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"), "Итог СуммаПлатежа = остаток").Равно(Остаток);

КонецПроцедуры

// Теза: счет поставщика без оплат и без Сумма - полная сумма, одна строка, колонки как у остальных (Договор,
// ПризнакАванса, СуммаРасчетов = СуммаПлатежа; СчетНаОплату пуст при ВестиУчетОплатыПоСчетам = Нет).
Процедура СчетПоставщикаБезОплатДаетПолнуюСуммуИКолонкиРасшифровки() Экспорт

	Метод = "РС.СчетПоставщика";
	Основа = НоваяОснова(Метод, 900);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма счета").Равно(Основа.Сумма);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, ФлагиКонтрагента(Истина, Истина, Истина, Ложь), Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, "Счет поставщика без оплат");

КонецПроцедуры

// Теза (ГИПОТЕЗА спеки D21, из кода): счет поставщика вендор ВСЕГДА заполняет полной суммой, предыдущие оплаты
// не вычитаются. Предыдущая частичная оплата 300 существует.
// При ПоСчетам = Да оплата привязана к счету в регистре (предусловие ниже) - только тогда "не вычитается" не пусто;
// при ПоСчетам = Нет зелень была бы пустой (оплата к счету не привязывается), поэтому там предусловия нет.
Процедура СчетПоставщикаЗаполняетсяПолнойСуммойНеВычитаяОплаты(Имя, ПоСчетам) Экспорт

	Метод = "РС.СчетПоставщика";
	Основа = НоваяОснова(Метод, 900, ФлагиКонтрагента(Истина, Истина, Истина, ПоСчетам));
	Оплачено = 300;
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	ВРегистре = ОплаченоПоРегистру(Основа.Основание);
	Если ПоСчетам Тогда
		ЮТест.ОжидаетЧто(ВРегистре, Имя + ": предусловие - оплата привязана к счету в регистре").Равно(Оплачено);
	КонецЕсли;
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), Имя + ": строк расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, Имя + ": сумма документа = полная сумма счета поставщика (в регистре оплат по счету: "
		+ ВРегистре + ")").Равно(Основа.Сумма);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, Имя + ": СуммаПлатежа строки = полная сумма").Равно(Основа.Сумма);

КонецПроцедуры

// Теза: с Сумма счет поставщика - один рядок на переданную сумму (D21), оплаты не вычитаются.
Процедура СчетПоставщикаСоСуммойДаетОдинРядокНаВсюСумму() Экспорт

	Метод = "РС.СчетПоставщика";
	Основа = НоваяОснова(Метод, 900);
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, 300);
	СуммаБанка = 900;
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание, СуммаБанка);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Одна строка расшифровки").Равно(1);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "СуммаПлатежа = переданная Сумма").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "СуммаДокумента = переданная Сумма").Равно(СуммаБанка);

КонецПроцедуры

#КонецОбласти

#Область БанкЗаплатилМеньше

// Теза спеки (D21, "Сума банку != залишку", ОПРОВЕРГНУТА измерением, см. ВИМІРЯНО ниже): после метода без Сумма уменьшение строк вендорской
// РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы по колонке СуммаПлатежа ПЕРЕСЧИТЫВАЕТ
// СуммаРасчетов самостоятельно. Условие, заданное тестом: банк заплатил половину остатка (600 из 1200).
Процедура РаспределениеПоСуммеПлатежаНеПересчитываетСуммуРасчетов() Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1200);
	СуммаБанка = 600;
	Документ = НовыйБанковскийДокумент(Метод);
	ВызватьМетод(Документ, Метод, Основа.Основание);

	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(СуммаБанка, Документ.РасшифровкаПлатежа, "СуммаПлатежа");

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "Предусловие: распределение изменило СуммаПлатежа").Равно(СуммаБанка);
	// ВИМІРЯНО 2026-10-13: суперечить спеці D21 - РаспределитьСуммуПоКолонкеТаблицы змінює лише названу колонку,
	// СуммаРасчетов лишається сумою до розподілу (перераховує її платформа окремим розподілом по колонці).
	// Знахідка 4 таблиці знахідок задачі 4.
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаРасчетов, "СуммаРасчетов не пересчитана вслед за СуммаПлатежа")
		.Равно(Основа.Сумма);

КонецПроцедуры

// Теза (D21): то же для СуммаНДС. Измерить НЕЛЬЗЯ: фикстура без НДС (будівник ставки НДС не задает, налогообложение -
// "не облагается"), СуммаНДС строки = 0 и до, и после распределения; ставить НДС в тесте самим и потом измерять -
// тест, задающий измеряемое условие. Остается именованный пропуск до появления фикстуры с НДС.
Процедура РаспределениеПоСуммеПлатежаПересчитываетСуммуНДС() Экспорт

	ЮТест.Пропустить("Фикстура без НДС; построитель ставки НДС не задает: пересчет СуммаНДС не воспроизвести");

КонецПроцедуры

#КонецОбласти

#Область БанкЗаплатилБольше

// Теза (D21/D34): банк заплатил больше остатка - документ с добавленной строкой аванса на разницу (тот же договор,
// без документа расчетов) проходит ПроверитьЗаполнение и проводится. Условия, заданные тестом (это делает
// платформа по D34, не метод): СпособЗачета "Вручную" в обеих строках, СуммаДокумента = сумма банка.
Процедура СтрокаАвансаНаРазницуПроходитПроверкуЗаполненияИПроводится(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Разница = 300;
	СуммаБанка = Основа.Сумма + Разница;
	Документ = НовыйБанковскийДокумент(Метод);
	ВызватьМетод(Документ, Метод, Основа.Основание);
	Способ = ПредопределенноеЗначение("Перечисление.СпособыЗачетаИРаспределенияПлатежей.Вручную");

	Строка1 = Документ.РасшифровкаПлатежа[0];
	Строка1.СпособЗачета = Способ;
	Строка2 = Документ.РасшифровкаПлатежа.Добавить();
	ЗаполнитьЗначенияСвойств(Строка2, Строка1, "Договор, СтавкаНДС, Курс, Кратность");
	Строка2.ПризнакАванса = Истина;
	Строка2.СуммаПлатежа = Разница;
	Строка2.СуммаРасчетов = Разница;
	Строка2.СуммаНДС = 0;
	Строка2.СпособЗачета = Способ;
	Документ.СуммаДокумента = СуммаБанка;
	// Статью ДДС ставит платформа (D14: предопределенная по виду операции); метод ее не ставит.
	ИмяСтатьи = ?(ЭтоИсходящий(Метод), "ОплатаПоставщикам", "ОплатаОтПокупателей");
	Документ.Статья = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств." + ИмяСтатьи);

	Проверка = ПроверитьЗаполнениеСоСообщениями(Документ);
	ЮТест.ОжидаетЧто(Проверка.Успешно, Метод + ": ПроверитьЗаполнение прошла. Сообщения: " + Проверка.Тексты).ЭтоИстина();

	ТекстОшибки = Неопределено;
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЮТест.ОжидаетЧто(ТекстОшибки, Метод + ": проведение без исключения").Равно(Неопределено);
	ЮТест.ОжидаетЧто(Документ.Проведен, Метод + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"), Метод + ": итог расшифровки = сумма банка").Равно(СуммаБанка);

КонецПроцедуры

#КонецОбласти

#Область ПобочныеЭффекты

// Теза (D21; 11): метод не меняет Автор, Дата, НазначениеПлатежа, НомерВходящегоДокумента (и ДатаВходящегоДокумента,
// Комментарий, СМП_ИДТранзакцииБанка). Предусловие - поля заполнены ДО вызова разными значениями, иначе
// "не изменено" было бы пустым равенством.
Процедура МетодНеМеняетПоляДанныхБанка(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);
	Было = СнимокПолей(Документ);
	ПроверитьПоляЗаполнены(Было, Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьПоляНеИзменены(Было, СнимокПолей(Документ), Метод);

КонецПроцедуры

// Теза (D34, поправка к вересневой спеке): методы "за основою" СпособЗачета в строках НЕ ставят - ставит платформа.
Процедура МетодНеСтавитСпособЗачетаВСтроках(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество() > 0, Метод + ": есть строки расшифровки").ЭтоИстина();
	Для Каждого СтрокаТЧ Из Документ.РасшифровкаПлатежа Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаТЧ.СпособЗачета), Метод + ": СпособЗачета строки " + СтрокаТЧ.НомерСтроки + " пуст").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Теза (D34): ВариантЗаполненияРасшифровки после метода не "Автоматически" (вендорский "Зачет долгов. Авто" при
// проведении очистил бы расшифровку).
Процедура МетодНеСтавитАвтоматическийВариантЗаполненияРасшифровки(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	Автоматически = ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически");
	ЮТест.ОжидаетЧто(Документ.ВариантЗаполненияРасшифровки, Метод + ": ВариантЗаполненияРасшифровки не Автоматически")
		.НеРавно(Автоматически);

КонецПроцедуры

// Теза (D21): метод ставит ДокументОснование = основание и шапку по основанию (вид операции, организация,
// контрагент, договор, валюта, банковский счет организации).
Процедура МетодСтавитДокументОснованиеИШапкуПоОснованию(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);

КонецПроцедуры

#КонецОбласти

#Область ПроверкаЗаполнения

// Теза (D21: "перевірка заповнення вендора вимагає точного збігу"): СуммаДокумента != итог СуммаПлатежа расшифровки
// (даже на копейку) -> ошибка суммы. Условие, заданное тестом: после метода СуммаДокумента сдвигается на Дельту.
Процедура СуммаДокументаНеРавнаИтогуРасшифровкиДаетОшибку(Имя, Метод, Дельта) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);
	ВызватьМетод(Документ, Метод, Основа.Основание);
	Документ.СуммаДокумента = Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа") + Дельта;

	Проверка = ПроверитьЗаполнениеСоСообщениями(Документ);

	ЮТест.ОжидаетЧто(Проверка.ЕстьОшибкаСуммы, Имя + ": есть ошибка несовпадения сумм. Сообщения: " + Проверка.Тексты).ЭтоИстина();
	ЮТест.ОжидаетЧто(Проверка.Успешно, Имя + ": ПроверитьЗаполнение не прошла").ЭтоЛожь();

КонецПроцедуры

// Пара: СуммаДокумента равна итогу расшифровки -> ошибки суммы нет.
Процедура РавныеСуммыНеДаютОшибкиСуммы(Метод) Экспорт

	Основа = НоваяОснова(Метод, 1000);
	Документ = НовыйБанковскийДокумент(Метод);
	ВызватьМетод(Документ, Метод, Основа.Основание);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, Метод + ": предусловие - метод поставил СуммаДокумента = итогу")
		.Равно(Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"));

	Проверка = ПроверитьЗаполнениеСоСообщениями(Документ);

	ЮТест.ОжидаетЧто(Проверка.ЕстьОшибкаСуммы, Метод + ": ошибки суммы нет. Сообщения: " + Проверка.Тексты).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область КрайниеСостояния

// Утверждается ФАКТИЧЕСКОЕ поведение вендора. Теза спеки/11: "залишок до сплати" - у полностью оплаченного счета
// остаток 0, метод ничего не проверяет и не отказывает.
Процедура ПолностьюОплаченныйСчетДаетНулевойОстаток(Имя, ПоСчетам) Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1000, ФлагиКонтрагента(Истина, Истина, Истина, ПоСчетам));
	Оплачено = Основа.Сумма;
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	ВРегистре = ОплаченоПоРегистру(Основа.Основание);
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	// ВИМІРЯНО 2026-10-13: суперечить спеці D21 - залишок 0 лише при ВестиУчетОплатыПоСчетам = Да; при Нет оплата
	// до рахунку не привʼязана (у регістрі 0), метод дає повну суму рахунку. Знахідка 2 таблиці знахідок задачі 4.
	Остаток = ?(ПоСчетам, Основа.Сумма - Оплачено, Основа.Сумма);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, Имя + ": сумма документа = остаток к оплате (в регистре оплат по счету: "
		+ ВРегистре + ")").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"), Имя + ": итог расшифровки = остатку").Равно(Остаток);
	ЮТест.ОжидаетЧто(Документ.ДокументОснование, Имя + ": основание проставлено").Равно(Основа.Основание);

КонецПроцедуры

// Теза (D21: "вендор не перевіряє проведеність"): непроведенный счет заполняется как обычный.
Процедура НепроведенныйСчетЗаполняетсяКакПроведенный() Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1200, , Ложь);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Основа.Основание, "Проведен").Проведен, "Предусловие: счет не проведен").ЭтоЛожь();
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма непроведенного счета").Равно(Основа.Сумма);
	Ожидание = ОжидаемыеКолонки(Метод, Основа, Основа.Сумма, ФлагиКонтрагента(Истина, Истина, Истина, Ложь), Документ.Дата);
	ПроверитьСтрокуРасшифровки(Документ.РасшифровкаПлатежа[0], Ожидание, "Непроведенный счет");

КонецПроцедуры

// Теза (D21: "вендор не перевіряє помітку видалення"): помеченный на удаление счет заполняется как обычный.
// Пометка ставится в транзакции теста и откатывается вместе с ней.
Процедура ПомеченныйНаУдалениеСчетЗаполняетсяКакОбычный() Экспорт

	Метод = "ПНС.Счет";
	Основа = НоваяОснова(Метод, 1200);
	Объект = Основа.Основание.ПолучитьОбъект();
	Объект.УстановитьПометкуУдаления(Истина);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Основа.Основание, "ПометкаУдаления").ПометкаУдаления, "Предусловие: счет помечен на удаление")
		.ЭтоИстина();
	Документ = НовыйБанковскийДокумент(Метод);

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ПроверитьШапку(Документ, Метод, Основа, Метод);
	ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "Сумма документа = сумма помеченного счета").Равно(Основа.Сумма);

КонецПроцедуры

// Теза (D21: "вендор не перевіряє організацію"): документ банка заранее получил другую организацию и ее счет;
// метод не отказывает, организация и банковский счет берутся по основанию. Условие "вторая организация" - по
// воспроизводимому правилу (следующая за кодом среди имеющих живой счет в национальной валюте), только читается.
Процедура ОсноваДругойОрганизацииНеОтклоняетсяМетодомОрганизацияБерется() Экспорт

	Метод = "ПНС.Счет";
	Организации = ОрганизацииПоПравилу();
	Если Организации.Количество() < 2 Тогда
		ЮТест.Пропустить("В базе меньше двух организаций с живым банковским счетом в национальной валюте: " +
			"нечем отличить организацию документа банка от организации основания");
		Возврат;
	КонецЕсли;
	ОрганизацияОсновы = Организации[0];
	ДругаяОрганизация = Организации[1];
	ДругойСчет = БанковскийСчетОрганизации(ДругаяОрганизация);

	Основа = НоваяОснова(Метод, 1000);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Основа.Основание, "Организация").Организация, "Предусловие: основание - организации по правилу")
		.Равно(ОрганизацияОсновы);
	Документ = НовыйБанковскийДокумент(Метод);
	Документ.Организация = ДругаяОрганизация;
	Документ.БанковскийСчет = ДругойСчет;

	ВызватьМетод(Документ, Метод, Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.Организация, "Организация документа взята по основанию, не оставлена прежней").Равно(ОрганизацияОсновы);
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Документ.БанковскийСчет, "Владелец").Владелец, "Банковский счет - организации основания")
		.Равно(ОрганизацияОсновы);

КонецПроцедуры

#КонецОбласти

#Область СторожОстатков

// БЕЗ транзакции, ПОСЛЕДНИМ. Тот же подсчет (СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам), что в
// СМП_ТестыФикстур; ждет нуль в каждом типе. Красный здесь - СТОП: остатки руками не удалять, сообщить владельцу.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ЭтоИсходящий(Метод)

	Возврат Лев(Метод, 2) = "РС";

КонецФункции

Функция ЭтоЗаказ(Метод)

	Возврат Метод = "ПНС.Заказ" Или Метод = "РС.ЗаказПоставщику";

КонецФункции

Функция ФлагиКонтрагента(ПоДоговорам, ПоДокументам, ПоЗаказам, ПоСчетам)

	Флаги = Новый Структура;
	Флаги.Вставить("ВестиРасчетыПоДоговорам", ПоДоговорам);
	Флаги.Вставить("ВестиРасчетыПоДокументам", ПоДокументам);
	Флаги.Вставить("ВестиРасчетыПоЗаказам", ПоЗаказам);
	Флаги.Вставить("ВестиУчетОплатыПоСчетам", ПоСчетам);

	Возврат Флаги;

КонецФункции

// Контрагент + договор нужного вида + основание нужного типа (в транзакции вызывающего теста).
// Возвращает структуру: Контрагент, Договор, Основание, Сумма.
Функция НоваяОснова(Метод, Сумма, Флаги = Неопределено, Провести = Истина)

	Если Флаги = Неопределено Тогда
		Флаги = ФлагиКонтрагента(Истина, Истина, Истина, Ложь);
	КонецЕсли;
	// Построитель не создает второй договор контрагенту без учета по договорам ("Для контрагента не ведется учет по
	// договорам"). Поэтому контрагент и договор создаются с учетом по договорам, а запрошенный признак
	// ВестиРасчетыПоДоговорам выставляется записью контрагента ДО создания основания (в транзакции теста).
	ФлагиСоздания = ФлагиКонтрагента(Истина, Флаги.ВестиРасчетыПоДокументам, Флаги.ВестиРасчетыПоЗаказам, Флаги.ВестиУчетОплатыПоСчетам);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ФлагиСоздания);
	ВидДоговора = ?(ЭтоИсходящий(Метод), "СПоставщиком", "СПокупателем");
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент,
		Новый Структура("ВидДоговора", ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ВидДоговора)));
	Если Не Флаги.ВестиРасчетыПоДоговорам Тогда
		ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		ОбъектКонтрагента.ВестиРасчетыПоДоговорам = Ложь;
		ОбъектКонтрагента.Записать();
	КонецЕсли;

	Если Метод = "ПНС.Счет" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Контрагент, Договор, Сумма, Провести);
	ИначеЕсли Метод = "ПНС.Заказ" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Контрагент, Договор, Сумма, Провести);
	ИначеЕсли Метод = "РС.СчетПоставщика" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Контрагент, Договор, Сумма, Провести);
	ИначеЕсли Метод = "РС.ЗаказПоставщику" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Контрагент, Договор, Сумма, Провести);
	Иначе
		ВызватьИсключение "СМП_ТестыВендораЗаполнениеПоОснованию: неизвестный метод " + Метод;
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор, Основание, Сумма", Контрагент, Договор, Основание, Сумма);

КонецФункции

Функция ДатаБанка()

	Возврат ТекущаяДатаСеанса();

КонецФункции

// Банковский документ с датой банка и "чужими" значениями полей, которые метод не должен трогать.
Функция НовыйБанковскийДокумент(Метод)

	Если ЭтоИсходящий(Метод) Тогда
		Документ = Документы.РасходСоСчета.СоздатьДокумент();
	Иначе
		Документ = Документы.ПоступлениеНаСчет.СоздатьДокумент();
	КонецЕсли;
	Документ.Дата = ДатаБанка();

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка ИЗ Справочник.Пользователи КАК П ГДЕ НЕ П.ПометкаУдаления УПОРЯДОЧИТЬ ПО П.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Документ.Автор = Выборка.Ссылка;
	КонецЕсли;
	Документ.НазначениеПлатежа = "СМП_ТЕСТ назначение платежа";
	Документ.НомерВходящегоДокумента = "T-17";
	Документ.ДатаВходящегоДокумента = НачалоДня(Документ.Дата) - 86400 * 2;
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "банк_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ЗаполнитьЗначенияСвойств(Документ, Новый Структура("СМП_ИДТранзакцииБанка", "СМП_ТЕСТ_ID_1"));

	Возврат Документ;

КонецФункции

// Вызов метода вендора напрямую (не Заполнить / ОбработкаЗаполнения).
Процедура ВызватьМетод(Документ, Метод, Основание, Сумма = Неопределено)

	Если Метод = "ПНС.Счет" Тогда
		Документ.ЗаполнитьПоСчетуНаОплату(Основание, , Сумма);
	ИначеЕсли Метод = "ПНС.Заказ" Тогда
		Документ.ЗаполнитьПоЗаказуПокупателя(Основание, , Сумма);
	ИначеЕсли Метод = "РС.СчетПоставщика" Тогда
		Документ.ЗаполнитьПоСчетНаОплатуПоставщика(Основание, , Сумма);
	ИначеЕсли Метод = "РС.ЗаказПоставщику" Тогда
		Документ.ЗаполнитьПоЗаказПоставщику(Основание, , Сумма);
	Иначе
		ВызватьИсключение "СМП_ТестыВендораЗаполнениеПоОснованию: неизвестный метод " + Метод;
	КонецЕсли;

КонецПроцедуры

Функция СнимокПолей(Документ)

	Снимок = Новый Структура("Автор, Дата, НазначениеПлатежа, НомерВходящегоДокумента, ДатаВходящегоДокумента, Комментарий, СМП_ИДТранзакцииБанка");
	ЗаполнитьЗначенияСвойств(Снимок, Документ);

	Возврат Снимок;

КонецФункции

Функция КурсВалюты(Валюта, Дата)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ К.Курс КАК Курс, К.Кратность КАК Кратность
		|ИЗ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК К");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Результат = Новый Структура("Курс, Кратность", 0, 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сколько оплаты регистр ОплатаСчетовИЗаказов привязал к основанию (аванс + оплата). Только читает.
Функция ОплаченоПоРегистру(Основание)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаАванса + Р.СуммаОплаты), 0) КАК Сумма
		|ИЗ РегистрНакопления.ОплатаСчетовИЗаказов КАК Р
		|ГДЕ Р.СчетНаОплату = &Основание");
	Запрос.УстановитьПараметр("Основание", Основание);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

Функция СтавкаНДСОснования(Основание)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.СтавкаНДС КАК СтавкаНДС ИЗ " + Основание.Метаданные().ПолноеИмя()
		+ ".Запасы КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СтавкаНДС;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Организации по правилу фикстуры (как СМП_ТестыДанныеУНФ.Организация), все, по коду. Только читает.
Функция ОрганизацииПоПравилу()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ О.Ссылка КАК Ссылка
		|ИЗ Справочник.Организации КАК О
		|ГДЕ НЕ О.ПометкаУдаления
		|	И О.Ссылка В (ВЫБРАТЬ Б.Владелец ИЗ Справочник.БанковскиеСчета КАК Б
		|		ГДЕ НЕ Б.ПометкаУдаления И НЕ Б.Недействителен И Б.ВалютаДенежныхСредств = &Национальная)
		|УПОРЯДОЧИТЬ ПО О.Код");
	Запрос.УстановитьПараметр("Национальная", Константы.НациональнаяВалюта.Получить());

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция БанковскийСчетОрганизации(Организация)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка ИЗ Справочник.БанковскиеСчета КАК Б
		|ГДЕ Б.Владелец = &Организация И НЕ Б.ПометкаУдаления И НЕ Б.Недействителен И Б.ВалютаДенежныхСредств = &Национальная
		|УПОРЯДОЧИТЬ ПО Б.Код");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Национальная", Константы.НациональнаяВалюта.Получить());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

// Читает реквизиты ссылки запросом (имена через запятую); результат - структура с теми же ключами.
Функция РеквизитыСсылки(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + "
		|ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ожидаемые колонки единственной строки расшифровки. Неопределено в значении = "колонка пуста".
// Все значения выведены из фикстуры (основа, флаги, регистр курсов), не из первого прогона.
Функция ОжидаемыеКолонки(Метод, Основа, Сумма, Флаги, Дата)

	КурсДоговора = КурсВалюты(РеквизитыСсылки(Основа.Договор, "ВалютаРасчетов").ВалютаРасчетов, Дата);
	ЭтоЗаказОснование = ЭтоЗаказ(Метод);

	Ожидание = Новый Структура;
	// ВИМІРЯНО 2026-10-13: припущення не підтвердилось - колонка Договор заповнюється завжди, незалежно від
	// ВестиРасчетыПоДоговорам (дослідження 11 писало "за прапорцями"; очікувалась порожня колонка при Нет).
	// Знахідка 1 таблиці знахідок задачі 4.
	Ожидание.Вставить("Договор", Основа.Договор);
	Ожидание.Вставить("Заказ", ?(ЭтоЗаказОснование И Флаги.ВестиРасчетыПоЗаказам, Основа.Основание, Неопределено));
	Ожидание.Вставить("СчетНаОплату", ?(Не ЭтоЗаказОснование И Флаги.ВестиУчетОплатыПоСчетам, Основа.Основание, Неопределено));
	Ожидание.Вставить("Документ", Неопределено);
	Ожидание.Вставить("ПризнакАванса", Истина);
	Ожидание.Вставить("СуммаПлатежа", Сумма);
	Ожидание.Вставить("СуммаРасчетов", Сумма);
	Ожидание.Вставить("СуммаНДС", 0);
	Ожидание.Вставить("СтавкаНДС", СтавкаНДСОснования(Основа.Основание));
	Ожидание.Вставить("Курс", КурсДоговора.Курс);
	Ожидание.Вставить("Кратность", КурсДоговора.Кратность);

	Возврат Ожидание;

КонецФункции

// Помощник-порівнювач: колонки строки расшифровки против ожидания. Неопределено = колонка пуста. Все расхождения
// копятся и утверждаются разом: первый провал не должен прятать остальные колонки (это измерение).
Процедура ПроверитьСтрокуРасшифровки(СтрокаТЧ, Ожидание, Имя)

	Расхождения = "";
	Для Каждого Элемент Из Ожидание Цикл
		Факт = СтрокаТЧ[Элемент.Ключ];
		Если Элемент.Значение = Неопределено Тогда
			Совпало = Не ЗначениеЗаполнено(Факт);
		Иначе
			Совпало = (Факт = Элемент.Значение);
		КонецЕсли;
		Если Не Совпало Тогда
			Расхождения = Расхождения + Символы.ПС + "  колонка " + Элемент.Ключ + ": ожидали `"
				+ ?(Элемент.Значение = Неопределено, "<пусто>", Строка(Элемент.Значение)) + "`, факт `"
				+ ?(ЗначениеЗаполнено(Факт), Строка(Факт), "<пусто>") + "`";
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": колонки расшифровки как ожидалось").Равно("");

КонецПроцедуры

// Помощник-порівнювач: шапка банковского документа после метода против основания (договор - только в строках:
// у шапки банковского документа реквизита Договор нет). Расхождения копятся и утверждаются разом.
Процедура ПроверитьШапку(Документ, Метод, Основа, Имя)

	Если ЭтоИсходящий(Метод) Тогда
		ОжидаемыйВид = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику");
	Иначе
		ОжидаемыйВид = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя");
	КонецЕсли;
	ОрганизацияОсновы = РеквизитыСсылки(Основа.Основание, "Организация").Организация;
	РеквизитыСчета = РеквизитыСсылки(Документ.БанковскийСчет, "Владелец, ВалютаДенежныхСредств");

	Ожидание = Новый Структура;
	Ожидание.Вставить("ВидОперации", ОжидаемыйВид);
	Ожидание.Вставить("ДокументОснование", Основа.Основание);
	Ожидание.Вставить("Организация", ОрганизацияОсновы);
	Ожидание.Вставить("Контрагент", Основа.Контрагент);
	Ожидание.Вставить("ВалютаДенежныхСредств", Константы.НациональнаяВалюта.Получить());
	Ожидание.Вставить("СуммаДокумента", Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"));

	Расхождения = "";
	Для Каждого Элемент Из Ожидание Цикл
		Если Документ[Элемент.Ключ] <> Элемент.Значение Тогда
			Расхождения = Расхождения + Символы.ПС + "  шапка " + Элемент.Ключ + ": ожидали `" + Строка(Элемент.Значение)
				+ "`, факт `" + Строка(Документ[Элемент.Ключ]) + "`";
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Документ.БанковскийСчет) Тогда
		Расхождения = Расхождения + Символы.ПС + "  шапка БанковскийСчет не заполнен";
	Иначе
		Если РеквизитыСчета.Владелец <> Документ.Организация Тогда
			Расхождения = Расхождения + Символы.ПС + "  банковский счет принадлежит не организации документа";
		КонецЕсли;
		Если РеквизитыСчета.ВалютаДенежныхСредств <> Документ.ВалютаДенежныхСредств Тогда
			Расхождения = Расхождения + Символы.ПС + "  валюта банковского счета != ВалютаДенежныхСредств документа";
		КонецЕсли;
	КонецЕсли;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": шапка по основанию").Равно("");

КонецПроцедуры

// Предусловие "не изменено": все поля снимка заполнены ДО вызова.
Процедура ПроверитьПоляЗаполнены(Было, Имя)

	Для Каждого Элемент Из Было Цикл
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Элемент.Значение), Имя + ": предусловие - поле " + Элемент.Ключ + " заполнено до вызова")
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Помощник-порівнювач: поля снимка после вызова равны полям до вызова. Расхождения копятся и утверждаются разом.
Процедура ПроверитьПоляНеИзменены(Было, Стало, Имя)

	Расхождения = "";
	Для Каждого Элемент Из Было Цикл
		Если Стало[Элемент.Ключ] <> Элемент.Значение Тогда
			Расхождения = Расхождения + Символы.ПС + "  поле " + Элемент.Ключ + ": было `" + Строка(Элемент.Значение)
				+ "`, стало `" + Строка(Стало[Элемент.Ключ]) + "`";
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": поля данных банка не изменены методом").Равно("");

КонецПроцедуры

// Помощник-классификатор: ПроверитьЗаполнение + сообщения; ошибка суммы - сообщение о несоответствии суммы
// документа сумме разнесенных платежей (ru/uk).
Функция ПроверитьЗаполнениеСоСообщениями(Документ)

	ПолучитьСообщенияПользователю(Истина);
	Успешно = Документ.ПроверитьЗаполнение();
	Тексты = "";
	ЕстьОшибкаСуммы = Ложь;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты = Тексты + Символы.ПС + "  - " + Сообщение.Текст;
		Текст = НРег(Сообщение.Текст);
		Если Найти(Текст, "разнесенных") > 0 Или Найти(Текст, "рознесених") > 0 Тогда
			ЕстьОшибкаСуммы = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Успешно, ЕстьОшибкаСуммы, Тексты", Успешно, ЕстьОшибкаСуммы, Тексты);

КонецФункции

#КонецОбласти
