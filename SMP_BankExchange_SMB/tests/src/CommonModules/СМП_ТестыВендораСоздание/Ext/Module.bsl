КонецПроцедуры

// Методы акта/накладной не имеют параметра Сумма (в отличие от методов для заказа и счета): вызов с суммой отказывает. ГИПОТЕЗА ПЛАНА:
// метод принимает Сумму ("з Сумма і без").
Процедура Акт_МетодНеПринимаетСумму() Экспорт

	Основа = НоваяОснова("Акт", 1000, Истина);
	Документ = НовыйПНС();
	ТекстОшибки = Неопределено;

	Попытка
		Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание, 400);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану ("з Сумма і без"): у методу немає параметра Сумма, виклик з сумою відмовляє (текст платформи).
	ЮТест.ОжидаетЧто(ТекстОшибки, "Вызов ЗаполнитьПоАктуВыполненныхРабот(Акт, Сумма) отклонен").Содержит("Слишком много фактических параметров");
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Отклоненный вызов не заполнил расшифровку").Равно(0);

КонецПроцедуры

Процедура Накладная_МетодНеПринимаетСумму() Экспорт

	Основа = НоваяОснова("РасходнаяНакладная", 1500, Истина);
	Документ = НовыйПНС();
	ТекстОшибки = Неопределено;

	Попытка
		Документ.ЗаполнитьПоРасходнойНакладной(Основа.Основание, 400);
