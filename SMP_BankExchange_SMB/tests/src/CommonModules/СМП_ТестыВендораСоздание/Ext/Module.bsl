	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "РС_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Документ.ЗаполнитьПоПриходнаяНакладная(Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Предусловие: метод создал строку расшифровки").Больше(0);
