	ЮТест.ОжидаетЧто(Реквизит(Поручение, "Оплачено"), "Поручение не стало оплаченным, когда основание очищено").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область USD

// Суммы движения ДенежныеСредства проведенного банковского документа в валюте учета (USD). Условие: расчетный счет и документ в национальной
// валюте, валюта учета USD. ГИПОТЕЗА из формулы запросов вендора: строка прихода имеет Сумма = СуммаВал * Курс_нац*Кратность_учета /
// (Кратность_нац*Курс_учета), курсы читаются из регистра на дату документа. ВИМІРЯНО 2026-10-14: гіпотеза про рядок прихода збіглась; окрім неї регістр
// містить ще рядок Расход із СуммаВал = 0 (причину не з'ясовано), тому сума ВСІХ рядків регістратора не дорівнює формулі (404,82 проти 34,18).
// У регістрі ДенежныеСредства колонок курсу/кратності немає.
Процедура USD_СуммаДвиженияВВалютеУчета() Экспорт

	Документ = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("Сумма, Проведен", 1000, Истина));
	Запрос = Новый Запрос(
		"ВЫБРАТЬ Р.ВидДвижения КАК ВидДвижения, Р.Сумма КАК Сумма, Р.СуммаВал КАК СуммаВал
		|ИЗ РегистрНакопления.ДенежныеСредства КАК Р
		|ГДЕ Р.Регистратор = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Таблица = Запрос.Выполнить().Выгрузить();
	Приход = Таблица.НайтиСтроки(Новый Структура("ВидДвижения", ВидДвиженияНакопления.Приход));
	Расход = Таблица.НайтиСтроки(Новый Структура("ВидДвижения", ВидДвиженияНакопления.Расход));

	Дата = Реквизит(Документ, "Дата");
	КурсНац = КурсВалюты(Константы.НациональнаяВалюта.Получить(), Дата);
	КурсУчета = КурсВалюты(Константы.ВалютаУчета.Получить(), Дата);
	ЮТест.ОжидаетЧто(КурсУчета.Курс, "Условие: курс валюты учета отличается от курса национальной (иначе проверка формулы вырождена)").НеРавно(КурсНац.Курс);
	ЮТест.ОжидаетЧто(Приход.Количество(), "Рядков прихода в ДенежныеСредства").Равно(1);
	ЮТест.ОжидаетЧто(Приход[0].СуммаВал, "Сумма прихода в валюте документа").Равно(1000);
	Ожидаемая = Окр(Приход[0].СуммаВал * КурсНац.Курс * КурсУчета.Кратность / (КурсНац.Кратность * КурсУчета.Курс), 2);

	ЮТест.ОжидаетЧто(Приход[0].Сумма, "Сумма прихода в валюте учета (курс UAH " + КурсНац.Курс + "/" + КурсНац.Кратность
		+ ", курс USD " + КурсУчета.Курс + "/" + КурсУчета.Кратность + ")").Равно(Ожидаемая);
	ЮТест.ОжидаетЧто(Расход.Количество(), "Дополнительных строк Расход в регистре (причина не выяснена)").Равно(1);
	ЮТест.ОжидаетЧто(Расход[0].СуммаВал, "Строка Расход: сумма в валюте документа").Равно(0);

КонецПроцедуры

#КонецОбласти

// ПОСЛЕДНИМ в модуле и БЕЗ транзакции: итог всех тестов с данными.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#Область Служебные

Функция ПризнакиУчета()

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", Истина);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);

	Возврат Настройки;

КонецФункции

// Реквизиты ссылки запросом (результат - структура с теми же ключами, что в списке).
Функция РеквизитыСсылки(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + "
		|ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Реквизит(Ссылка, Имя)

	Возврат РеквизитыСсылки(Ссылка, Имя)[Имя];

КонецФункции

Функция ДоговорыКонтрагента(Контрагент)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.ВидДоговора КАК ВидДоговора
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &Контрагент");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ЕстьВРегистреОсновных(Договор)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Т ГДЕ Т.Договор = &Договор");
	Запрос.УстановитьПараметр("Договор", Договор);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество > 0;

КонецФункции

// Договор так, как его создал бы продукт при ДействиеДоговор = "Создать" за нужным видом: Заполнить по контрагенту, затем вид и организация.
Функция НовыйДоговорПродукта(Контрагент, Организация, Вид)

	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Заполнить(Новый Структура("ОснованиеЗаполнения", Контрагент));
	Договор.ВидДоговора = Вид;
	Договор.Организация = Организация;
	Договор.Наименование = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Договор_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Договор.Записать();

	Возврат Договор.Ссылка;

КонецФункции

Функция БанкСШестизначнымКодом()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Б.Ссылка КАК Ссылка, Б.Код КАК Код
		|ИЗ Справочник.Банки КАК Б
		|ГДЕ НЕ Б.ПометкаУдаления И НЕ Б.ЭтоГруппа И Б.Код ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]""
		|УПОРЯДОЧИТЬ ПО Б.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: в справочнике Банки есть банк с шестизначным кодом").ЭтоИстина();

	Возврат Новый Структура("Ссылка, Код", Выборка.Ссылка, Выборка.Код);

КонецФункции

// РНОКПП (10 цифр) с правильной контрольной цифрой: сумма первых девяти цифр с весами -1,5,7,9,4,6,10,5,7; остаток от 11, по модулю 10.
Функция РНОКПП()

	Веса = СтрРазделить("-1,5,7,9,4,6,10,5,7", ",");
	Генератор = Новый ГенераторСлучайныхЧисел(Число(Прав(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"), 6)));
	Цифры = "";
	Сумма = 0;
	Для Индекс = 1 По 9 Цикл
		Цифра = Генератор.СлучайноеЧисло(?(Индекс = 1, 1, 0), 9);
		Цифры = Цифры + Формат(Цифра, "ЧГ=0");
		Сумма = Сумма + Цифра * Число(Веса[Индекс - 1]);
	КонецЦикла;
	Контрольная = ((Сумма % 11) + 11) % 11 % 10;

	Возврат Цифры + Формат(Контрольная, "ЧГ=0");

КонецФункции

Функция ИспортитьПоследнююЦифру(Код)

	Последняя = Число(Прав(Код, 1));

	Возврат Лев(Код, СтрДлина(Код) - 1) + Формат((Последняя + 1) % 10, "ЧГ=0");

КонецФункции

// Основа для метода "по основанию": контрагент с учетом по договорам и запрошенным ВестиРасчетыПоДокументам, договор нужного вида и
// документ расчетов. Возвращает Структуру: Контрагент, Договор, Основание, Сумма.
Функция НоваяОснова(Вид, Сумма, ПоДокументам, СНДС = Ложь)

	Флаги = ПризнакиУчета();
	Флаги.Вставить("ВестиРасчетыПоДокументам", ПоДокументам);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Флаги);
	ВидДоговора = ?(Вид = "ПриходнаяНакладная", "СПоставщиком", "СПокупателем");
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", Перечисления.ВидыДоговоров[ВидДоговора]));
	Настройки = ?(СНДС, Новый Структура("СНДС", Истина), Неопределено);
	Если Вид = "Акт" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Контрагент, Договор, Сумма, Истина, Настройки);
	ИначеЕсли Вид = "РасходнаяНакладная" Тогда
		Основание = СМП_ТестыДанныеУНФ.НоваяРасходнаяНакладная(Контрагент, Договор, Сумма, Истина, Настройки);
	Иначе
		Основание = СМП_ТестыДанныеУНФ.НоваяПриходнаяНакладная(Контрагент, Договор, Сумма, Истина, Настройки);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Реквизит(Основание, "Проведен"), "Предусловие: документ расчетов проведен").ЭтоИстина();

	Возврат Новый Структура("Контрагент, Договор, Основание, Сумма", Контрагент, Договор, Основание, Сумма);

КонецФункции

Функция НовыйПНС()

	Документ = Документы.ПоступлениеНаСчет.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "ПНС_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Возврат Документ;

КонецФункции

Функция НовыйРС()

	Документ = Документы.РасходСоСчета.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "РС_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");

	Возврат Документ;

КонецФункции

// ПНС, готовый к записи и проведению после метода: автор и номер/дата входящего, как у документа выписки.
// Передумова проведення: вариант заполнения расшифровки не "Автоматически" (при нем вендорский ПередЗаписью при проведении очищает и
// перезаполняет расшифровку, и измерение СуммаНДС/СуммаРасчетов после проведения было бы измерением авто-зачета долгов).
Процедура ПроверитьВариантРасшифровки(Документ)

	ЮТест.ОжидаетЧто(Документ.ВариантЗаполненияРасшифровки, "Предусловие: ВариантЗаполненияРасшифровки не 'Автоматически'")
		.НеРавно(Перечисления.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически);

КонецПроцедуры

Функция НовыйПНСДляПроведения(Основа)

	Документ = НовыйПНС();
	Документ.НомерВходящегоДокумента = "T-21";
	Документ.ДатаВходящегоДокумента = НачалоДня(Документ.Дата);

	Возврат Документ;

КонецФункции

Процедура ПроверитьКолонку(Документ, Основа, Поле, ПоДокументам, ИмяВидаОперации, ИмяСтатьи)

	Строка = Документ.РасшифровкаПлатежа[0];
	Если Поле = "Документ" Тогда
		Если ПоДокументам Тогда
			ЮТест.ОжидаетЧто(Строка.Документ, "Колонка Документ при ВестиРасчетыПоДокументам = Да - документ расчетов").Равно(Основа.Основание);
		Иначе
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Документ), "Колонка Документ при ВестиРасчетыПоДокументам = Нет - пуста").ЭтоЛожь();
		КонецЕсли;
	ИначеЕсли Поле = "СпособЗачета" Тогда
		ЮТест.ОжидаетЧто(Строка.СпособЗачета, "СпособЗачета строки после метода").Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную);
	ИначеЕсли Поле = "СуммаПлатежа" Тогда
		ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, "СуммаПлатежа = сумме документа расчетов").Равно(Основа.Сумма);
	ИначеЕсли Поле = "СуммаРасчетов" Тогда
		ЮТест.ОжидаетЧто(Строка.СуммаРасчетов, "СуммаРасчетов = сумме документа расчетов").Равно(Основа.Сумма);
	ИначеЕсли Поле = "ПризнакАванса" Тогда
		ЮТест.ОжидаетЧто(Строка.ПризнакАванса, "ПризнакАванса строки").ЭтоЛожь();
	ИначеЕсли Поле = "Договор" Тогда
		ЮТест.ОжидаетЧто(Строка.Договор, "Договор строки - договор документа расчетов").Равно(Основа.Договор);
	ИначеЕсли Поле = "Заказ" Тогда
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Заказ), "Заказ строки (у акта без заказа) пуст").ЭтоЛожь();
	ИначеЕсли Поле = "ДокументОснование" Тогда
		ЮТест.ОжидаетЧто(Документ.ДокументОснование, "ДокументОснование шапки").Равно(Основа.Основание);
	ИначеЕсли Поле = "ВидОперации" Тогда
		ЮТест.ОжидаетЧто(Документ.ВидОперации, "Вид операции после метода")
			.Равно(Перечисления[?(Документ.Метаданные().Имя = "РасходСоСчета", "ВидыОперацийРасходСоСчета", "ВидыОперацийПоступлениеНаСчет")][ИмяВидаОперации]);
	ИначеЕсли Поле = "СпособЗачетаНеСтавится" Тогда
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СпособЗачета), "СпособЗачета строки после метода для расходной накладной пуст").ЭтоЛожь();
	ИначеЕсли Поле = "Статья" Тогда
		Если ПустаяСтрока(ИмяСтатьи) Тогда
			// ВИМІРЯНО 2026-10-14: суперечить гіпотезі - метод для акта статтю ДДС не ставить (запит методу її не вибирає).
			ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ.Статья), "Статья ДДС шапки после метода для акта пуста").ЭтоЛожь();
		Иначе
			ЮТест.ОжидаетЧто(Документ.Статья, "Статья ДДС шапки после метода").Равно(Справочники.СтатьиДвиженияДенежныхСредств[ИмяСтатьи]);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Сколько оплаты привязано регистром ОплатаДокументов к документу расчетов (аванс + оплата).
Функция ОплаченоПоДокументу(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаАванса + Р.СуммаОплаты), 0) КАК Сумма
		|ИЗ РегистрНакопления.ОплатаДокументов КАК Р
		|ГДЕ Р.Документ = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

Функция СтрокаАкта(Акт)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.СуммаНДС КАК СуммаНДС, С.СтавкаНДС КАК СтавкаНДС ИЗ Документ.АктВыполненныхРабот.РаботыИУслуги КАК С ГДЕ С.Ссылка = &Акт");
	Запрос.УстановитьПараметр("Акт", Акт);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Новый Структура("СуммаНДС, СтавкаНДС", Выборка.СуммаНДС, Выборка.СтавкаНДС);

КонецФункции

// Первая строка расшифровки записанного ПНС: СуммаНДС, СуммаРасчетов, СуммаПлатежа (читается из базы).
Функция СтрокаБанковскогоДокумента(Документ)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 С.СуммаНДС КАК СуммаНДС, С.СуммаРасчетов КАК СуммаРасчетов, С.СуммаПлатежа КАК СуммаПлатежа
		|ИЗ Документ.ПоступлениеНаСчет.РасшифровкаПлатежа КАК С ГДЕ С.Ссылка = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие: у записанного документа есть строка расшифровки").ЭтоИстина();

	Возврат Новый Структура("СуммаНДС, СуммаРасчетов, СуммаПлатежа", Выборка.СуммаНДС, Выборка.СуммаРасчетов, Выборка.СуммаПлатежа);

КонецФункции

// Проведение с отказом в результат: исключение проведения убивает транзакцию теста (зонд задачи 0), поэтому при исключении транзакция
// восстанавливается ОтменитьТранзакцию + НачатьТранзакцию, и после этого НИКАКИЕ данные базы не читаются (все создано в откатанной транзакции).
Функция ПровестиСОтказомВРезультат(Документ)

	Результат = Новый Структура("Проведен, Причина", Ложь, "");
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Проведен = Истина;
	Исключение
		Результат.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОтменитьТранзакцию();
		НачатьТранзакцию();
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ТекстСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

Функция КурсВалюты(Валюта, Дата)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ К.Курс КАК Курс, К.Кратность КАК Кратность
		|ИЗ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК К");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Результат = Новый Структура("Курс, Кратность", 1, 1);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
