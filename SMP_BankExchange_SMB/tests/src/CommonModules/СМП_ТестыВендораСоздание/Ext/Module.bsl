	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Предусловие: метод создал одну строку расшифровки").Равно(1);
	ПроверитьКолонку(Документ, Основа, Поле, ПоДокументам, "ОтПокупателя", "ОплатаОтПокупателей");

КонецПроцедуры

// РС.ЗаполнитьПоПриходнаяНакладная: аналог для документа расчетов поставщика (ГИПОТЕЗА из чтения кода).
Процедура ПриходнаяНакладная_РасходСоСчета_Колонка(Поле, ПоДокументам) Экспорт

	Основа = НоваяОснова("ПриходнаяНакладная", 1400, ПоДокументам);
