		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану ("з Сумма і без"): у методу немає параметра Сумма, виклик з сумою відмовляє (текст платформи).
	ЮТест.ОжидаетЧто(ТекстОшибки, "Вызов ЗаполнитьПоРасходнойНакладной(Накладная, Сумма) отклонен").Содержит("Слишком много фактических параметров");
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Отклоненный вызов не заполнил расшифровку").Равно(0);

КонецПроцедуры

// Частично оплаченный акт: метод вычитает предыдущую оплату по документу (УчестьОплатуДругимиДокументами) только когда оплата привязана к
// документу расчетов, то есть при ВестиРасчетыПоДокументам (ГИПОТЕЗА из чтения кода). Предусловие - оплата проведена и привязана (регистр).
Процедура Акт_ЧастичноОплаченный_ВычитаетОплатуПоДокументу(Описание, ПоДокументам, ОжидаемаяСумма) Экспорт

	Основа = НоваяОснова("Акт", 1000, ПоДокументам);
	Оплата = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("Контрагент, Договор, Сумма, РасшифровкаПоДолгам, Проведен",
		Основа.Контрагент, Основа.Договор, 400, Истина, Истина));
	ПривязаноПоРегистру = ОплаченоПоДокументу(Основа.Основание);

	Документ = НовыйПНС();
	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);

	ЮТест.ОжидаетЧто(Реквизит(Оплата, "Проведен"), "Предусловие: оплата проведена").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПривязаноПоРегистру, Описание + ": оплата, привязанная к акту в регистре ОплатаДокументов")
		.Равно(?(ПоДокументам, 400, 0));
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Итог("СуммаПлатежа"), Описание + ": сумма по методу для акта после частичной оплаты")
		.Равно(ОжидаемаяСумма);

КонецПроцедуры

// Банк заплатил меньше суммы акта: уменьшение вендорским РаспределитьСуммуПоКолонкеТаблицы (по СуммаПлатежа) + СуммаДокумента банка; документ
// проходит ПроверитьЗаполнение и проводится (ГИПОТЕЗА D21).
Процедура Акт_БанкЗаплатилМеньше_ПроведениеИПроверкаЗаполнения() Экспорт

	Основа = НоваяОснова("Акт", 1000, Истина);
	Документ = НовыйПНСДляПроведения(Основа);
	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);
	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(600, Документ.РасшифровкаПлатежа, "СуммаПлатежа");
	Документ.СуммаДокумента = 600;
	ПроверитьВариантРасшифровки(Документ);
	// ВИМІРЯНО 2026-10-14: метод для акта статтю ДДС не ставить, без неї ПроверитьЗаполнение = Ложь ("Поле Статья не заполнено");
	// статтю ставить продукт (D14/D15).
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ.Статья), "Предусловие: после метода для акта статья пуста").ЭтоЛожь();
	Документ.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей;
	Проверка = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстСообщений();

	Результат = ПровестиСОтказомВРезультат(Документ);

	ЮТест.ОжидаетЧто(Проверка, "ПроверитьЗаполнение документа с уменьшенной суммой (" + Сообщения + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Проведен, "Документ проведен (причина отказа: " + Результат.Причина + ")").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область D21_НДС

// Фикстура с НДС: метод для акта переносит ставку и СуммаНДС акта в строку расшифровки (ГИПОТЕЗА из чтения кода). Условие: акт с НДС
// (проверяется предусловием), ВестиРасчетыПоДокументам.
Процедура Акт_СНДС_ЗаполнитьДаетНДСАкта() Экспорт

	Основа = НоваяОснова("Акт", 1200, Истина, Истина);
	Документ = НовыйПНС();

	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);

	Общая = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Общая, ТекущаяДатаСеанса());
	Строка = Документ.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(СтрокаАкта(Основа.Основание).СуммаНДС, "Предусловие: в акте НДС 200").Равно(200);
	ЮТест.ОжидаетЧто(Строка.СтавкаНДС, "Ставка НДС строки расшифровки").Равно(Общая);
	ЮТест.ОжидаетЧто(Строка.СуммаНДС, "СуммаНДС строки расшифровки").Равно(200);
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, "СуммаПлатежа строки расшифровки").Равно(1200);

КонецПроцедуры

// СуммаНДС / СуммаРасчетов после распределения банковской суммы по колонке СуммаПлатежа (600 из 1200): сразу после распределения -
// ГИПОТЕЗА (журнал плана 01, знахідка 4: функция меняет лишь названную колонку); после записи документа - ГИПОТЕЗА ПЛАНА (D21:
// "СуммаРасчетов и СуммаНДС перерахує платформа").
Процедура Акт_СНДС_ПослеРаспределения(Поле, Этап, Ожидаемое) Экспорт

	Основа = НоваяОснова("Акт", 1200, Истина, Истина);
	Документ = НовыйПНСДляПроведения(Основа);
	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);
	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(600, Документ.РасшифровкаПлатежа, "СуммаПлатежа");
	Документ.СуммаДокумента = 600;
	ПроверитьВариантРасшифровки(Документ);
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа[0].СуммаПлатежа, "Предусловие: распределение изменило СуммаПлатежа").Равно(600);

	Если Этап = "послеЗаписи" Тогда
		Документ.Записать(РежимЗаписиДокумента.Запись);
		Значение = СтрокаБанковскогоДокумента(Документ.Ссылка)[Поле];
	Иначе
		Значение = Документ.РасшифровкаПлатежа[0][Поле];
	КонецЕсли;

	ЮТест.ОжидаетЧто(Значение, Поле + " " + Этап).Равно(Ожидаемое);

КонецПроцедуры

// Проведение документа с НДС на неплательщике: проводится ли и какая СуммаНДС остается в строке после проведения (ГИПОТЕЗА: проводится, СуммаНДС
// пересчитана платформой по распределенной сумме, 100).
Процедура Акт_СНДС_ПослеПроведения() Экспорт

	Основа = НоваяОснова("Акт", 1200, Истина, Истина);
	Документ = НовыйПНСДляПроведения(Основа);
	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);
	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(600, Документ.РасшифровкаПлатежа, "СуммаПлатежа");
	Документ.СуммаДокумента = 600;
	ПроверитьВариантРасшифровки(Документ);

	Результат = ПровестиСОтказомВРезультат(Документ);

	ЮТест.ОжидаетЧто(Результат.Проведен, "Документ с НДС проведен (причина отказа: " + Результат.Причина + ")").ЭтоИстина();
	// ВИМІРЯНО 2026-10-14: суперечить D21 - проведення теж не перераховує СуммаНДС: лишається 200, а не 100.
	ЮТест.ОжидаетЧто(СтрокаБанковскогоДокумента(Документ.Ссылка).СуммаНДС, "СуммаНДС после проведения").Равно(200);

КонецПроцедуры

// Что продукт ДОЛЖЕН делать сам: вендорские функции, которыми СуммаНДС и СуммаРасчетов пересчитываются после распределения, дают 100 и 600
// (РассчитатьСуммуНДСНаСервере по ставке строки; РаспределитьСуммуПоКолонкеТаблицы по колонке СуммаРасчетов), и записанный/проведенный
// документ сохраняет именно их (ГИПОТЕЗА из чтения кода).
Процедура Акт_СНДС_ПерерасчетВендорскимиФункциями() Экспорт

	Основа = НоваяОснова("Акт", 1200, Истина, Истина);
	Документ = НовыйПНСДляПроведения(Основа);
	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);
	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(600, Документ.РасшифровкаПлатежа, "СуммаПлатежа");
	Документ.СуммаДокумента = 600;
	ПроверитьВариантРасшифровки(Документ);
	Строка = Документ.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.СуммаНДС, "Предусловие: до пересчета СуммаНДС - от полной суммы").Равно(200);

	РасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(600, Документ.РасшифровкаПлатежа, "СуммаРасчетов");
	РасчетыРаботаСФормамиВызовСервера.РассчитатьСуммуНДСНаСервере(Строка);

	ЮТест.ОжидаетЧто(Строка.СуммаРасчетов, "СуммаРасчетов после РаспределитьСуммуПоКолонкеТаблицы по своей колонке").Равно(600);
	ЮТест.ОжидаетЧто(Строка.СуммаНДС, "СуммаНДС после РассчитатьСуммуНДСНаСервере").Равно(100);

	Результат = ПровестиСОтказомВРезультат(Документ);

	ЮТест.ОжидаетЧто(Результат.Проведен, "Документ с пересчитанными суммами проведен (причина отказа: " + Результат.Причина + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаБанковскогоДокумента(Документ.Ссылка).СуммаНДС, "СуммаНДС после проведения - пересчитанная").Равно(100);
	ЮТест.ОжидаетЧто(СтрокаБанковскогоДокумента(Документ.Ссылка).СуммаРасчетов, "СуммаРасчетов после проведения - пересчитанная").Равно(600);

КонецПроцедуры

#КонецОбласти

#Область ПлатежноеПоручение

// Что РасходСоСчета.ЗаполнитьПоПлатежноеПоручение берет с поручения (ГИПОТЕЗА из чтения кода запроса метода).
Процедура Поручение_ЧтоБерется(Поле) Экспорт

	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Сумма", 321));
	Реквизиты = РеквизитыСсылки(Поручение, "Организация, БанковскийСчет, Контрагент, СуммаДокумента, ВалютаДокумента, Комментарий");
	Документ = НовыйРС();

	Документ.ЗаполнитьПоПлатежноеПоручение(Поручение);

	Если Поле = "Организация" Или Поле = "БанковскийСчет" Или Поле = "Контрагент" Тогда
		ЮТест.ОжидаетЧто(Документ[Поле], Поле + " берется с поручения").Равно(Реквизиты[Поле]);
	ИначеЕсли Поле = "СуммаДокумента" Тогда
		ЮТест.ОжидаетЧто(Документ.СуммаДокумента, "СуммаДокумента берется с поручения").Равно(Реквизиты.СуммаДокумента);
	ИначеЕсли Поле = "НазначениеПлатежа" Тогда
		ЮТест.ОжидаетЧто(Документ.НазначениеПлатежа, "НазначениеПлатежа берется с поручения").Равно(Реквизит(Поручение, "НазначениеПлатежа"));
	ИначеЕсли Поле = "ДокументОснование" Тогда
		ЮТест.ОжидаетЧто(Документ.ДокументОснование, "ДокументОснование - само поручение").Равно(Поручение);
	ИначеЕсли Поле = "ВалютаДенежныхСредств" Тогда
		ЮТест.ОжидаетЧто(Документ.ВалютаДенежныхСредств, "Валюта - валюта банковского счета поручения")
			.Равно(Реквизит(Реквизиты.БанковскийСчет, "ВалютаДенежныхСредств"));
	ИначеЕсли Поле = "СчетКонтрагента" Тогда
		ЮТест.ОжидаетЧто(Документ.СчетКонтрагента, "СчетКонтрагента берется с поручения").Равно(Реквизит(Поручение, "СчетКонтрагента"));
	ИначеЕсли Поле = "НалогообложениеНДС" Тогда
		// ГИПОТЕЗА из чтения кода: метод ставит "облагается" безусловно; организация фикстуры - неплательщик (условие, Условия_РежимБазыИзмерения).
		ЮТест.ОжидаетЧто(Документ.НалогообложениеНДС, "НалогообложениеНДС документа по поручению")
			.Равно(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);
	КонецЕсли;

КонецПроцедуры

// Статья и кореспонденция после метода: пустая статья поручения -> ОплатаПоставщикам для "Оплата" и Прочее для остальных; заданная статья
// сохраняется; корреспонденция поручения сохраняется, КРОМЕ ЛичныеСредстваПредпринимателя - там метод безусловно ставит НераспределеннаяПрибыль
// (ГИПОТЕЗА из чтения кода; D35.10).
Процедура Поручение_СтатьяИКорреспонденцияПоВидуОперации(Описание, ИмяВидаПоручения, СтатьяЗадана, КорреспонденцияЗадана, ИмяОжидаемойСтатьи, ИмяОжидаемойКорреспонденции) Экспорт

	Настройки = Новый Структура("ВидОперации", Перечисления.ВидыОперацийПлатежноеПоручение[ИмяВидаПоручения]);
	Если СтатьяЗадана Тогда
		Настройки.Вставить("Статья", Справочники.СтатьиДвиженияДенежныхСредств.Прочее);
	КонецЕсли;
	Если КорреспонденцияЗадана Тогда
		Настройки.Вставить("Корреспонденция", ПланыСчетов.Управленческий.ПрочиеРасходы);
	КонецЕсли;
	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Настройки);
	Документ = НовыйРС();

	Документ.ЗаполнитьПоПлатежноеПоручение(Поручение);

	ЮТест.ОжидаетЧто(Документ.Статья, Описание + ": статья после метода").Равно(Справочники.СтатьиДвиженияДенежныхСредств[ИмяОжидаемойСтатьи]);
	Если ПустаяСтрока(ИмяОжидаемойКорреспонденции) Тогда
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Документ.Корреспонденция), Описание + ": корреспонденция после метода пуста").ЭтоЛожь();
	Иначе
		ЮТест.ОжидаетЧто(Документ.Корреспонденция, Описание + ": корреспонденция после метода").Равно(ПланыСчетов.Управленческий[ИмяОжидаемойКорреспонденции]);
	КонецЕсли;

КонецПроцедуры

// Проведение РасходСоСчета, заполненного по поручению, ставит поручению "Оплачено" (ГИПОТЕЗА из чтения кода ОбработкаПроведения).
// Предусловие: до проведения "Оплачено" = Нет.
Процедура Поручение_ПроведениеСтавитОплачено() Экспорт

	Поручение = СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Сумма", 321));
	ЮТест.ОжидаетЧто(Реквизит(Поручение, "Оплачено"), "Предусловие: до проведения поручение не оплачено").ЭтоЛожь();
	Документ = НовыйРС();
	Документ.ЗаполнитьПоПлатежноеПоручение(Поручение);

	Результат = ПровестиСОтказомВРезультат(Документ);

	ЮТест.ОжидаетЧто(Результат.Проведен, "РасходСоСчета по поручению проведен (причина отказа: " + Результат.Причина + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизит(Поручение, "Оплачено"), "Поручение после проведения РасходСоСчета на его основании - оплачено").ЭтоИстина();

КонецПроцедуры

// Контроль пары: тот же документ, но ДокументОснование очищено - поручение остается неоплаченным (Оплачено ставит связь с основанием, а не
// проведение вообще).
Процедура Поручение_БезСвязиСДокументомОснованияОплаченоНеСтавится() Экспорт

