Процедура Условия_РежимБазыИзмерения() Экспорт

	ЮТест.ОжидаетЧто(Константы.ВалютаУчета.Получить(), "Условие: валюта учета отличается от национальной")
		.НеРавно(Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(Константы.КонтролироватьОстаткиПриПроведении.Получить(), "Условие: контроль остатков при проведении выключен")
		.ЭтоЛожь();
	Организация = СМП_ТестыДанныеУНФ.Организация();
	ЮТест.ОжидаетЧто(НалогиУНФ.НалогообложениеНДС(Организация,, ТекущаяДатаСеанса()), "Условие: организация фикстуры не платит НДС")
		.Равно(Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	ЮТест.ОжидаетЧто(Организация.ЮридическоеФизическоеЛицо, "Условие: организация фикстуры - физлицо-предприниматель")
		.Равно(Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Пользователи.ТекущийПользователь()), "Условие: пользователь сеанса определен").ЭтоИстина();
	// Умови, від яких залежать висновки журналу (знахідки 1, 3, 6): основна організація за формулою вендора не є організацією фікстури;
	// налаштування "ОсновнойВидКонтрагента" порожнє; користувач сеансу - Администратор. Червоний тут = змінилась база, а не вендор.
	ОсновнаяОрганизация = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.АвторизованныйПользователь(), "ОсновнаяОрганизация");
	Если Не ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
		ОсновнаяОрганизация = Справочники.Организации.ОрганизацияПоУмолчанию();
	КонецЕсли;
	ЮТест.ОжидаетЧто(ОсновнаяОрганизация, "Условие: основная организация (формула вендора) не равна организации фикстуры")
		.НеРавно(Организация);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.ТекущийПользователь(), "ОсновнойВидКонтрагента")),
		"Условие: настройка ОсновнойВидКонтрагента пользователя сеанса порожня").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка(Пользователи.ТекущийПользователь()), "Условие: пользователь сеанса").Равно("Администратор");
	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі "групи доступу не використовуються" - у базі виміру групи доступу контрагентів УВІМКНЕНІ.
	ЮТест.ОжидаетЧто(Справочники.ГруппыДоступаКонтрагентов.ИспользуютсяГруппыДоступа(), "Условие: группы доступа контрагентов используются")
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Контрагент

// Что ставит ОБРАБОТЧИК ЗАПОЛНЕНИЯ контрагента (Заполнить(Неопределено)): ожидание - то, что дают вендорские функции, из которых он
// берет значения (ГИПОТЕЗА из чтения кода ДозаполнитьПоУмолчанию). Предусловие: ожидание заполнено (иначе равенство пустому
// ничего бы не значило).
Процедура Контрагент_ЗаполнитьСтавитЗначения(Поле) Экспорт

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Заполнить(Неопределено);

	Пользователь = Пользователи.ТекущийПользователь();
	Если Поле = "ВалютаРасчетовПоУмолчанию" Тогда
		Ожидаемое = Константы.НациональнаяВалюта.Получить();
	ИначеЕсли Поле = "СпособРазнесенияОплатыПоУмолчанию" Тогда
		Ожидаемое = РасчетыРаботаСФормамиВызовСервера.ПолучитьСпособРазнесенияОплатыПоУмолчанию();
	ИначеЕсли Поле = "СпособЗачетаПредоплатыПоУмолчанию" Тогда
		Ожидаемое = РасчетыРаботаСФормамиВызовСервера.ПолучитьСпособЗачетаПредоплатыПоУмолчанию();
	ИначеЕсли Поле = "ГруппаДоступа" Тогда
		Ожидаемое = Справочники.ГруппыДоступаКонтрагентов.ГруппаДоступаПоУмолчанию();
	ИначеЕсли Поле = "Ответственный" Тогда
		Ожидаемое = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователь, "ОсновнойОтветственный");
	ИначеЕсли Поле = "ВидКонтрагента" Тогда
		Ожидаемое = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователь, "ОсновнойВидКонтрагента");
	Иначе
		ВызватьИсключение "Контрагент_ЗаполнитьСтавитЗначения: неизвестное поле " + Поле;
	КонецЕсли;

	Если Поле = "ВидКонтрагента" Тогда
		// ВИМІРЯНО 2026-10-14: суперечить гіпотезі "вид заповнюється з налаштування" - налаштування "ОсновнойВидКонтрагента" користувача
		// сеансу в базі порожнє, тому Заполнить лишає вид порожнім. Не виміряно: заповнене налаштування (режиму немає; значення утверджено).
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Ожидаемое), "ВидКонтрагента: умова - настройка ОсновнойВидКонтрагента сеанса порожня").ЭтоЛожь();
		// ВИМІРЯНО 2026-10-14: вид НЕ порожній - Заполнить лишає значення за замовчуванням реквізиту з метаданих (FillValue = ЮридическоеЛицо), не з налаштування.
		ЮТест.ОжидаетЧто(Объект[Поле], "ВидКонтрагента после Заполнить при пустой настройке - FillValue реквизита").Равно(Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
		Возврат;
	КонецЕсли;

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Ожидаемое), Поле + ": предусловие - источник значения (функция/настройка вендора) дает заполненное")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект[Поле], Поле + ": Заполнить ставит значение вендорской функции/настройки").Равно(Ожидаемое);

КонецПроцедуры

// Без Заполнить поля обработчика заполнения остаются пустыми (ГИПОТЕЗА из чтения кода: ПередЗаписью/ПриЗаписи их не ставят).
// Предусловие пары: с Заполнить то же поле заполнено.
Процедура Контрагент_БезЗаполнитьПолеПусто(Поле) Экспорт

	С = Справочники.Контрагенты.СоздатьЭлемент();
	С.Заполнить(Неопределено);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(С[Поле]), Поле + ": предусловие - с Заполнить поле заполнено").ЭтоИстина();

	Настройки = ПризнакиУчета();
	Настройки.Вставить("БезЗаполнения", Истина);
	Настройки.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ПустаяСсылка());
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Значение = Реквизит(Контрагент, Поле);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Значение), Поле + ": без Заполнить поле после записи заполнено").ЭтоЛожь();

КонецПроцедуры

// Следствие для D34: у контрагента без Заполнить уровень "способ разноса" пуст, и вендорская цепочка
// СпособРазнесенияОплатыДляДоговора для него дает значение КОНСТАНТЫ (журнал плана 01, задача 5, знахидка 4: у контрагента с Заполнить
// способ уже равен константе; ГИПОТЕЗА - без Заполнить результат цепочки тот же).
Процедура Контрагент_БезЗаполнитьСпособРазносаДляДоговораБерется_ИзКонстанты() Экспорт

	Настройки = ПризнакиУчета();
	Настройки.Вставить("БезЗаполнения", Истина);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизит(Контрагент, "СпособРазнесенияОплатыПоУмолчанию")), "Предусловие: у контрагента без Заполнить способ разноса пуст")
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "Предусловие: договор по умолчанию создан").ЭтоИстина();
	ПустойСпособДоговора = Реквизит(Договор, "СпособРазнесенияОплатыПоУмолчанию");
	Результат = РасчетыРаботаСФормамиВызовСервера.СпособРазнесенияОплатыДляДоговора(Договор, Контрагент);
	Константа = РасчетыРаботаСФормамиВызовСервера.ПолучитьСпособРазнесенияОплатыПоУмолчанию();

	ЮТест.ОжидаетЧто(Результат, "Способ разноса для договора контрагента без Заполнить (договор: '" + Строка(ПустойСпособДоговора) + "')")
		.Равно(Константа);

КонецПроцедуры

// Вендор не определяет вид контрагента по длине кода: без явного вида (после Заполнить) и юрлицо с 8-значным ЕДРПОУ, и ФОП с
// 10-значным РНОКПП получают один и тот же вид - из настройки "ОсновнойВидКонтрагента" (ГИПОТЕЗА из чтения кода).
Процедура Контрагент_ВидНеОпределяетсяПоДлинеКода() Экспорт

	НастройкиЮр = ПризнакиУчета();
	НастройкиЮр.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ПустаяСсылка());
	НастройкиЮр.Вставить("КодПоЕДРПОУ", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ());
	ПоДлинеВосемь = СМП_ТестыДанныеУНФ.НовыйКонтрагент(НастройкиЮр);
	НастройкиФОП = ПризнакиУчета();
	НастройкиФОП.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ПустаяСсылка());
	НастройкиФОП.Вставить("ИНН", РНОКПП());
	ПоДлинеДесять = СМП_ТестыДанныеУНФ.НовыйКонтрагент(НастройкиФОП);

	// ВИМІРЯНО 2026-10-14: налаштування виду контрагента сеансу порожнє; обидва контрагенти (8-значний код, 10-значний РНОКПП в ІПН) отримують один і той же
	// вид - значення за замовчуванням реквізиту (FillValue метаданих = юрособа): вендор вид не виводить ні з довжини коду, ні з поля. Не виміряно: заповнене налаштування.
	Настройка = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.ТекущийПользователь(), "ОсновнойВидКонтрагента");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Настройка), "Условие: настройка вида контрагента сеанса порожня").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Реквизит(ПоДлинеВосемь, "ВидКонтрагента"), "Вид контрагента с 8-значным кодом - значение по умолчанию реквизита (FillValue метаданных)").Равно(Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	ЮТест.ОжидаетЧто(Реквизит(ПоДлинеДесять, "ВидКонтрагента"), "Вид контрагента с 10-значным РНОКПП - то же значение").Равно(Реквизит(ПоДлинеВосемь, "ВидКонтрагента"));

КонецПроцедуры

// Вендорская проверка кодов при записи (ПередЗаписью -> ЗарегистрироватьДублиКонтрагентов): флаги ИННВведенКорректно /
// ЕДРПОУВведенКорректно. ГИПОТЕЗА из чтения кода: РНОКПП ФОП кладется в ИНН и там проходит проверку; РНОКПП в КодПоЕДРПОУ не проходит.
Процедура Контрагент_КорректностьКодов(Описание, ИмяВида, ПолеКода, ВариантКода, ПолеФлага, ОжидаемыйФлаг) Экспорт

	Если ВариантКода = "Буквы" Тогда
		Код = "ABCDEFGHIJ";
	ИначеЕсли ВариантКода = "Короткий" Тогда
		Код = "123";
	ИначеЕсли ВариантКода = "РНОКПП" Тогда
		Код = РНОКПП();
	ИначеЕсли ВариантКода = "РНОКПППлохой" Тогда
		Код = ИспортитьПоследнююЦифру(РНОКПП());
	ИначеЕсли ВариантКода = "ЕДРПОУ" Тогда
		Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Иначе
		Код = ИспортитьПоследнююЦифру(СМП_ТестыДанныеУНФ.НовыйЕДРПОУ());
	КонецЕсли;

	Настройки = ПризнакиУчета();
	Настройки.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов[ИмяВида]);
	Настройки.Вставить(ПолеКода, Код);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	ЮТест.ОжидаетЧто(Реквизит(Контрагент, ПолеКода), Описание + ": код сохранен как есть (" + ПолеКода + ")").Равно(Код);
	ЮТест.ОжидаетЧто(Реквизит(Контрагент, ПолеФлага), Описание + ": " + ПолеФлага).Равно(ОжидаемыйФлаг);

КонецПроцедуры

// ФОП: ИНН после записи не очищается (ПривестиДанныеКСогласованномуСостоянию чистит у ФОП лишь реквизиты юрлица/государственного
// органа), как и поле КодПоЕДРПОУ, если оно задано (ГИПОТЕЗА из чтения кода).
Процедура Контрагент_КодФОПВИННСохраняетсяПослеЗаписи() Экспорт

	Настройки = ПризнакиУчета();
	Настройки.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	Настройки.Вставить("ИНН", РНОКПП());
	Настройки.Вставить("КодПоЕДРПОУ", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ());
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Реквизиты = РеквизитыСсылки(Контрагент, "ИНН, КодПоЕДРПОУ, ВидКонтрагента");
	ЮТест.ОжидаетЧто(Реквизиты.ИНН, "ФОП: ИНН сохранен").Равно(Настройки.ИНН);
	ЮТест.ОжидаетЧто(Реквизиты.КодПоЕДРПОУ, "ФОП: заданный КодПоЕДРПОУ сохранен").Равно(Настройки.КодПоЕДРПОУ);

КонецПроцедуры

#КонецОбласти

#Область Договор

// Вид договора, созданного вендором при записи контрагента: СПокупателем; СПоставщиком, если контрагент - только поставщик;
// Прочее, если только "прочие отношения" (ГИПОТЕЗА из чтения кода ОбработкаЗаполнения договора). Предусловие: договор один.
Процедура ДоговорВендора_ВидПоРолямКонтрагента(Описание, Покупатель, Поставщик, Прочие, ИмяВида) Экспорт

	Настройки = ПризнакиУчета();
	Настройки.Вставить("Покупатель", Покупатель);
	Настройки.Вставить("Поставщик", Поставщик);
	Настройки.Вставить("ПрочиеОтношения", Прочие);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	Договоры = ДоговорыКонтрагента(Контрагент);
	ЮТест.ОжидаетЧто(Договоры.Количество(), Описание + ": предусловие - запись контрагента создала ровно один договор").Равно(1);
	ЮТест.ОжидаетЧто(Договоры[0].ВидДоговора, Описание + ": вид договора, созданного вендором")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ИмяВида));

КонецПроцедуры

// Реквизиты договора, созданного вендором. "ОрганизацияПоФормулеВендора" - организация, которую ОбработкаЗаполнения договора берет
// из настройки "ОсновнаяОрганизация" пользователя сеанса, иначе Справочники.Организации.ОрганизацияПоУмолчанию(); "ОрганизацияФикстуры" -
// организация плана (ГИПОТЕЗА плана: договор, который создал вендор, подходит организации плана).
Процедура ДоговорВендора_Реквизит(Поле) Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "Предусловие: у нового контрагента есть договор по умолчанию").ЭтоИстина();
	Реквизиты = РеквизитыСсылки(Договор, "Организация, ВалютаРасчетов, НомерДоговора, ДатаДоговора, Наименование, ПометкаУдаления");

	Если Поле = "ОрганизацияПоФормулеВендора" Тогда
		Ожидаемое = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.АвторизованныйПользователь(), "ОсновнаяОрганизация");
		Если Не ЗначениеЗаполнено(Ожидаемое) Тогда
			Ожидаемое = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация договора вендора - по формуле вендора").Равно(Ожидаемое);
	ИначеЕсли Поле = "ОрганизацияФикстуры" Тогда
		// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану - договір вендора створюється на "основну організацію" користувача/базу,
		// а не на організацію плану (умова бази: основна організація базу відрізняється від організації фікстури).
		ЮТест.ОжидаетЧто(Реквизиты.Организация, "Организация договора вендора НЕ организация фикстуры (условие бази)")
			.НеРавно(СМП_ТестыДанныеУНФ.Организация());
	ИначеЕсли Поле = "ВалютаРасчетовНациональная" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.ВалютаРасчетов, "Валюта расчетов договора вендора").Равно(Константы.НациональнаяВалюта.Получить());
	ИначеЕсли Поле = "НомерДоговораЗаполнен" Тогда
		// ВИМІРЯНО 2026-10-14: суперечить гіпотезі - у договорі, створеному вендором при записі контрагента, номер ПОРОЖНІЙ.
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.НомерДоговора), "Номер договора вендора пуст").ЭтоЛожь();
	ИначеЕсли Поле = "ДатаДоговораЗаполнена" Тогда
		// ВИМІРЯНО 2026-10-14: суперечить гіпотезі - дата договору вендора ПОРОЖНЯ.
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизиты.ДатаДоговора), "Дата договора вендора пуста").ЭтоЛожь();
	ИначеЕсли Поле = "НаименованиеПоШаблонуВендора" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.Наименование, "Наименование договора вендора = ШаблоныНаименований.НаименованиеДоговораПоУмолчанию")
			.Равно(ШаблоныНаименований.НаименованиеДоговораПоУмолчанию(Договор.ПолучитьОбъект()));
	ИначеЕсли Поле = "ОсновнойВРегистре" Тогда
		ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Договор), "Договор вендора записан в регистр основных договоров").ЭтоИстина();
	ИначеЕсли Поле = "НеПомеченНаУдаление" Тогда
		ЮТест.ОжидаетЧто(Реквизиты.ПометкаУдаления, "Договор вендора не помечен на удаление").ЭтоЛожь();
	Иначе
		ВызватьИсключение "ДоговорВендора_Реквизит: неизвестное поле " + Поле;
	КонецЕсли;

КонецПроцедуры

// Договор вендора ПОДХОДИТ организации плана: вендорская функция выбора договора по документу, контрагенту, организации ПЛАНА и
// виду операции находит именно его (ГИПОТЕЗА плана: "договір, який вендор сам створює, і є договором нового контрагента").
Процедура ДоговорВендора_ПодходитПланаБезПерестройки() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);

	Найденный = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.ПоступлениеНаСчет.ПустаяСсылка(), Контрагент, СМП_ТестыДанныеУНФ.Организация(),
		Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "Предусловие: договор по умолчанию создан").ЭтоИстина();
	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану - договір вендора організації плану НЕ підходить (організація інша), функція вибору
	// повертає порожнє. Умова бази: основна організація відрізняється від організації фікстури.
	ЮТест.ОжидаетЧто(Реквизит(Договор, "Организация"), "Условие: организация договора вендора не организация фикстуры")
		.НеРавно(СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Найденный), "Для организации плана и вида 'От покупателя' договор вендора не найден").ЭтоЛожь();

	// Контроль, что функция МОЖЕТ найти: после перенастройки договора вендора на организацию плана она его находит.
	СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация", СМП_ТестыДанныеУНФ.Организация()));
	ПослеПерестройки = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.ПоступлениеНаСчет.ПустаяСсылка(), Контрагент, СМП_ТестыДанныеУНФ.Организация(),
		Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);
	ЮТест.ОжидаетЧто(ПослеПерестройки, "Контроль: после перенастройки на организацию плана договор находится").Равно(Договор);

КонецПроцедуры

// Валюта договора вендора: при ВестиРасчетыПоДоговорам и заданной валюте контрагента - валюта контрагента; иначе национальная
// (ГИПОТЕЗА из чтения кода). Предусловие: валюта учета отличается от национальной (иначе варианты неразличимы).
Процедура ДоговорВендора_ВалютаСледуетВалютеКонтрагента(Описание, ПоДоговорам, ИмяОжидаемойВалюты) Экспорт

	ВалютаУчета = Константы.ВалютаУчета.Получить();
	ЮТест.ОжидаетЧто(ВалютаУчета, "Предусловие: валюта учета отличается от национальной").НеРавно(Константы.НациональнаяВалюта.Получить());
	Настройки = ПризнакиУчета();
	Настройки.Вставить("ВестиРасчетыПоДоговорам", ПоДоговорам);
	Настройки.Вставить("ВалютаРасчетовПоУмолчанию", ВалютаУчета);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);

	Ожидаемая = ?(ИмяОжидаемойВалюты = "Учета", ВалютаУчета, Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(Реквизит(Договор, "ВалютаРасчетов"), Описание + ": валюта договора вендора").Равно(Ожидаемая);

КонецПроцедуры

// Контрагент без Заполнить (валюта контрагента пуста): договор вендора в национальной валюте (ГИПОТЕЗА из чтения кода).
Процедура ДоговорВендора_БезЗаполнитьКонтрагентаВалютаНациональная() Экспорт

	Настройки = ПризнакиУчета();
	Настройки.Вставить("БезЗаполнения", Истина);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);
	Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Договор), "Предусловие: договор по умолчанию создан").ЭтоИстина();
	ЮТест.ОжидаетЧто(Реквизит(Договор, "ВалютаРасчетов"), "Валюта договора вендора у контрагента без Заполнить")
		.Равно(Константы.НациональнаяВалюта.Получить());

КонецПроцедуры

// "Основной договор" и "договор по виду" различимы только на контрагенте с двумя договорами разных видов (отложено из рецензии
// задачи 1). Вендорская ДоговорПоУмолчанию(Контрагент) возвращает ОДИН договор независимо от вида (ГИПОТЕЗА из чтения кода); выбор по
// виду операции - ПоДокументуКонтрагентуОрганизацииИВидуОперации.
Процедура Договор_ДваДоговораРазныхВидов_ОсновнойИЗаВидом() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Организация = СМП_ТестыДанныеУНФ.Организация();
	Покупатель = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация", Организация));
	Поставщик = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора, Основной",
		Перечисления.ВидыДоговоров.СПоставщиком, Истина));

	ЮТест.ОжидаетЧто(Реквизит(Покупатель, "ВидДоговора"), "Предусловие: договор вендора - с покупателем").Равно(Перечисления.ВидыДоговоров.СПокупателем);
	ЮТест.ОжидаетЧто(Реквизит(Поставщик, "ВидДоговора"), "Предусловие: второй договор - с поставщиком").Равно(Перечисления.ВидыДоговоров.СПоставщиком);
	ЮТест.ОжидаетЧто(ДоговорыКонтрагента(Контрагент).Количество(), "Предусловие: у контрагента ровно два договора").Равно(2);

	ПоВидуПокупателя = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.ПоступлениеНаСчет.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);
	ПоВидуПоставщика = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.РасходСоСчета.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийРасходСоСчета.Поставщику);
	Основной = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Контрагент);

	ЮТест.ОжидаетЧто(ПоВидуПокупателя, "Договор по виду 'От покупателя'").Равно(Покупатель);
	ЮТест.ОжидаетЧто(ПоВидуПоставщика, "Договор по виду 'Поставщику'").Равно(Поставщик);
	// Основной - один из двух (порядок выдачи не утверждается), и он не может быть ответом на оба вида сразу.
	ЮТест.ОжидаетЧто((Основной = Покупатель) <> (Основной = Поставщик), "ДоговорПоУмолчанию(Контрагент) - ровно один из двух договоров")
		.ЭтоИстина();

КонецПроцедуры

// Заполнить договор на двуролевого контрагента (покупатель и поставщик) дает вид СПокупателем: для вида СПоставщиком (РасходСоСчета.Поставщику)
// продукт обязан задать вид сам после Заполнить (ГИПОТЕЗА из чтения кода).
Процедура Договор_ЗаполнитьДвуроловогоКонтрагента_ВидПокупателем_ПродуктМеняетВид() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Заполнить(Новый Структура("ОснованиеЗаполнения", Контрагент));

	ЮТест.ОжидаетЧто(Договор.ВидДоговора, "Вид договора после Заполнить на двуролевого контрагента").Равно(Перечисления.ВидыДоговоров.СПокупателем);
	ЮТест.ОжидаетЧто(Договор.Владелец, "Владелец после Заполнить").Равно(Контрагент);

КонецПроцедуры

// Договор, созданный продуктом (Заполнить -> вид -> организация -> Записать), НЕ становится основным сам (в регистре основных его нет),
// но находится вендорской функцией выбора по виду операции как единственный договор вида (ГИПОТЕЗА).
Процедура Договор_СозданныйПродуктомНеОсновной_НоНаходитсяПоВиду() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Организация = СМП_ТестыДанныеУНФ.Организация();
	СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация", Организация));
	ДоговорПоставщика = НовыйДоговорПродукта(Контрагент, Организация, Перечисления.ВидыДоговоров.СПоставщиком);

	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(ДоговорПоставщика), "Договор, созданный продуктом, в регистре основных не числится").ЭтоЛожь();
	Найденный = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.РасходСоСчета.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийРасходСоСчета.Поставщику);
	ЮТест.ОжидаетЧто(Найденный, "Вендорская функция находит договор вида 'С поставщиком' без регистра основных").Равно(ДоговорПоставщика);

КонецПроцедуры

// Вендорская ЗаписатьДоговорПоУмолчанию делает договор основным для (организация, контрагент, вид), не снимая основной другого вида.
Процедура Договор_ЗаписатьДоговорПоУмолчанию_ДелаетОсновнымПоВиду() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Организация = СМП_ТестыДанныеУНФ.Организация();
	Покупатель = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация", Организация));
	ДоговорПоставщика = НовыйДоговорПродукта(Контрагент, Организация, Перечисления.ВидыДоговоров.СПоставщиком);

	Справочники.ДоговорыКонтрагентов.ЗаписатьДоговорПоУмолчанию(ДоговорПоставщика);

	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(ДоговорПоставщика), "После ЗаписатьДоговорПоУмолчанию новый договор в регистре основных").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьВРегистреОсновных(Покупатель), "Основной договор другого вида остался в регистре").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область БанковскийСчет

// Проверка заполнения счета (ОбработкаПроверкиЗаполнения счета): код банка в позициях 5-10 IBAN обязан совпадать с кодом выбранного банка,
// иначе "Неверно указан банк" (ГИПОТЕЗА из чтения кода). Случайный IBAN (как у фикстурных счетов) банку НЕ соответствует.
Процедура Счет_ПроверкаЗаполнения(Описание, ВариантНомера, БанкЗадан, ОжидаемыйРезультат, ФрагментСообщения) Экспорт

	Банк = БанкСШестизначнымКодом();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);
	Счет.Наименование = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Счет_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Если ВариантНомера = "СКодомБанка" Тогда
		Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN(СокрЛП(Банк.Код));
	ИначеЕсли ВариантНомера = "Случайный" Тогда
		Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN();
		ЮТест.ОжидаетЧто(Сред(Счет.НомерСчета, 5, 6), "Предусловие: код в случайном IBAN отличается от кода банка").НеРавно(СокрЛП(Банк.Код));
	Иначе
		Счет.НомерСчета = "26001234567890";
	КонецЕсли;
	Если БанкЗадан Тогда
		Счет.Банк = Банк.Ссылка;
	КонецЕсли;
	ПолучитьСообщенияПользователю(Истина);

	Результат = Счет.ПроверитьЗаполнение();
	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Сообщения = СтрСоединить(Тексты, " | ");

	ЮТест.ОжидаетЧто(Результат, Описание + ": ПроверитьЗаполнение (сообщения: " + Сообщения + ")").Равно(ОжидаемыйРезультат);
	Если Не ПустаяСтрока(ФрагментСообщения) Тогда
		ЮТест.ОжидаетЧто(Сообщения, Описание + ": сообщение называет проблему").Содержит(ФрагментСообщения);
	КонецЕсли;

КонецПроцедуры

// Поиск банка по МФО вендорской функцией: точное совпадение кода (ГИПОТЕЗА из чтения кода БанкиУНФ.СсылкаНаБанк).
Процедура Банк_ПоискПоТочномуКоду() Экспорт

	Банк = БанкСШестизначнымКодом();

	ЮТест.ОжидаетЧто(БанкиУНФВызовСервера.СсылкаНаБанкИзСправочника(СокрЛП(Банк.Код)), "СсылкаНаБанкИзСправочника по МФО банка")
		.Равно(Банк.Ссылка);
	ЮТест.ОжидаетЧто(Справочники.Банки.НайтиПоКоду(Банк.Код), "НайтиПоКоду по коду банка").Равно(Банк.Ссылка);
	Таблица = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", СокрЛП(Банк.Код));
	ЮТест.ОжидаетЧто(Таблица.Найти(Банк.Ссылка, "Ссылка") <> Неопределено, "ПолучитьТаблицуБанковПоРеквизитам содержит банк (строк: " + Таблица.Количество() + ")")
		.ЭтоИстина();

КонецПроцедуры

// МФО, которого нет в справочнике Банки: вендорский поиск дает ПУСТУЮ ссылку, а не исключение; таблица банков пуста (ГИПОТЕЗА).
// Предусловие: код действительно отсутствует в справочнике (запросом).
Процедура Банк_КодаНетВБазе_ПустаяСсылка() Экспорт

	Код = "";
	Для Номер = 999001 По 999999 Цикл
		Кандидат = Формат(Номер, "ЧГ=0");
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ Справочник.Банки КАК Б ГДЕ Б.Код ПОДОБНО &Код");
		Запрос.УстановитьПараметр("Код", "%" + Кандидат + "%");
		Если Запрос.Выполнить().Пустой() Тогда
			Код = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Код, "Предусловие: найден код, которого нет в справочнике Банки (и не входит в чужие коды)").НеРавно("");

	ЮТест.ОжидаетЧто(БанкиУНФВызовСервера.СсылкаНаБанкИзСправочника(Код), "Поиск по отсутствующему МФО").Равно(Справочники.Банки.ПустаяСсылка());
	ЮТест.ОжидаетЧто(Справочники.Банки.НайтиПоКоду(Код), "НайтиПоКоду по отсутствующему коду").Равно(Справочники.Банки.ПустаяСсылка());
	ЮТест.ОжидаетЧто(Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", Код).Количество(), "Таблица банков по отсутствующему коду")
		.Равно(0);

КонецПроцедуры

// Заполнить(контрагент) ставит валюту, вид счета, счет учета и вариант указания ЕДРПОУ (ГИПОТЕЗА из чтения кода).
Процедура Счет_ЗаполнитьПоВладельцу(Поле) Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);

	Если Поле = "ВалютаДенежныхСредств" Тогда
		Ожидаемое = Константы.НациональнаяВалюта.Получить();
	ИначеЕсли Поле = "ВидСчета" Тогда
		Ожидаемое = "Расчетный";
	ИначеЕсли Поле = "СчетУчета" Тогда
		Ожидаемое = ПланыСчетов.Управленческий.Банк;
	ИначеЕсли Поле = "ВариантУказанияКодПоЕДРПОУ" Тогда
		Ожидаемое = Перечисления.ВариантыУказанияКодПоЕДРПОУ.ВоВсехПлатежныхПоручениях;
	Иначе
		Ожидаемое = Контрагент;
	КонецЕсли;

	ЮТест.ОжидаетЧто(Счет[Поле], Поле + ": после Заполнить(контрагент)").Равно(Ожидаемое);

КонецПроцедуры

// Вендорский СформироватьНаименование: "<номер>, в <банк>" (ГИПОТЕЗА из чтения кода; разделитель зависит от языка, поэтому проверяется
// только состав: номер в начале, представление банка внутри).
Процедура Счет_НаименованиеПоШаблонуВендора() Экспорт

	Банк = БанкСШестизначнымКодом();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);
	Счет.Банк = Банк.Ссылка;
	Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN(СокрЛП(Банк.Код));

	Счет.СформироватьНаименование();

	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Счет.Наименование, СокрЛП(Счет.НомерСчета)), "Наименование счета начинается с номера (" + Счет.Наименование + ")")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(Счет.Наименование, "Наименование счета содержит представление банка").Содержит(Строка(Банк.Ссылка));

КонецПроцедуры

// Запись счета без наименования проходит и наименование не появляется само (ГИПОТЕЗА из чтения кода: СформироватьНаименование
// вызывает форма, не запись): продукт обязан вызвать его сам.
Процедура Счет_ЗаписьБезНаименования() Экспорт

	Банк = БанкСШестизначнымКодом();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Счет.Заполнить(Контрагент);
	Счет.Банк = Банк.Ссылка;
	Счет.НомерСчета = СМП_ТестыДанныеУНФ.НовыйIBAN(СокрЛП(Банк.Код));
	Счет.Записать();

	ЮТест.ОжидаетЧто(Реквизит(Счет.Ссылка, "Наименование"), "Наименование счета, записанного без наименования").Равно("");

КонецПроцедуры

// Первый счет контрагента не становится его БанковскийСчетПоУмолчанию сам (ГИПОТЕЗА: в ObjectModule счета и контрагента этого нет).
Процедура Счет_ЗаписьНеСтавитБанковскийСчетПоУмолчанию() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиУчета());
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизит(Контрагент, "БанковскийСчетПоУмолчанию")), "Предусловие: до записи счета счета по умолчанию нет")
		.ЭтоЛожь();

	СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Контрагент);

	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Реквизит(Контрагент, "БанковскийСчетПоУмолчанию")), "После записи первого счета счет по умолчанию у контрагента")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область D21_ДокументРасчетов

// ПНС.ЗаполнитьПоАктуВыполненныхРабот: колонка Документ строки расшифровки = акт при ВестиРасчетыПоДокументам, пусто без него (ГИПОТЕЗА из
// чтения кода); остальные колонки - как у метода для заказа (журнал плана 01, задача 4).
Процедура Акт_ЗаполнитьПоАкту_Колонка(Поле, ПоДокументам) Экспорт

	Основа = НоваяОснова("Акт", 1000, ПоДокументам);
	Документ = НовыйПНС();

	Документ.ЗаполнитьПоАктуВыполненныхРабот(Основа.Основание);

	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), "Предусловие: метод создал одну строку расшифровки").Равно(1);
	ПроверитьКолонку(Документ, Основа, Поле, ПоДокументам, "ОтПокупателя", "");

КонецПроцедуры

// ПНС.ЗаполнитьПоРасходнойНакладной: то же для расходной накладной (ГИПОТЕЗА из чтения кода).
Процедура Накладная_ЗаполнитьПоРасходнойНакладной_Колонка(Поле, ПоДокументам) Экспорт

	Основа = НоваяОснова("РасходнаяНакладная", 1500, ПоДокументам);
