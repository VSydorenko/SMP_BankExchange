// Тесты записи документов банка: свидомий перезапис наличного документа (этап 6, задача 6 плана 06; D5). Зона: ИНВАРИАНТЫ БЕЗОПАСНОСТИ перезаписи -
// помеченный на удаление документ не перезаписывается, и перезапись без разрешения контекста не выполняется (защита от уничтожения данных, не поведение
// вендора). Каркас записи - СМП_ТестыЗаписиКаркас (помощники используются отсюда). Остальные случаи перезаписи (номер и дата сохраняются, правка
// заменяется, проведенный документ, версия изменена после показа, строка без документа, создание контрагента D6, повторная проверка пакета) проверяются
// временным зондом и в постоянные тесты не входят (решение владельца 2026-11-04: тестировать только ключевое). Правила - docs/architecture/testing.md.
//
// План строится вручную (без Распознать): записи нужен план с заданными решениями. Продукт вызывается только через СМП_ТестыВызовПродукта
// (позднее связывание).
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Перезапись: инварианты безопасности");
	Набор.ДобавитьСерверныйТест("ПомеченныйНаУдаление_НеПерезаписывается_ДокументНеМеняется").ВТранзакции();
	Набор.ДобавитьСерверныйТест("БезРазрешенияКонтекста_НеПерезаписывается_ДокументНеМеняется").ВТранзакции();

	// Сторож остатков: БЕЗ транзакции, последним.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Перезапись: сторож остатков");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Инварианты

// Документ, помеченный на удаление, не перезаписывается и пометка не снимается (D5), даже когда перезапись разрешена и версия совпадает. Контроль, который
// умеет упасть: в том же пакете и с тем же разрешением документ без пометки перезаписывается (без контроля тест прошел бы и при перезаписи, которая не
// работает вовсе).
Процедура ПомеченныйНаУдаление_НеПерезаписывается_ДокументНеМеняется() Экспорт

	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	Помеченный = ДокументСценария(Сценарий, Истина);
	Контрольный = ДокументСценария(Сценарий, Ложь);
	ПомеченныйДо = СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Помеченный);
	ЮТест.ОжидаетЧто(ПомеченныйДо.ПометкаУдаления, "Предусловие: документ помечен на удаление").ЭтоИстина();

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПомеченного = СтрокаПерезаписи(План, Сценарий, Помеченный, 1);
	СтрокаКонтрольного = СтрокаПерезаписи(План, Сценарий, Контрольный, 2);
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи();
	Контекст.РазрешитьПерезапись = Истина;

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	Строка1 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка1.Результат, "Помеченный на удаление: результат").Равно("УжеЗагружен");
	ЮТест.ОжидаетЧто(Строка1.Документ, "Помеченный на удаление: документ в результате - наличный").Равно(Помеченный);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение").Количество(), "Помеченный на удаление: предупреждение")
		.Равно(1);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Ошибка").Количество(), "Помеченный на удаление: ошибок нет").Равно(0);
	ПроверитьДокументНеИзменен(Помеченный, ПомеченныйДо, "Помеченный на удаление");

	// Контроль: тот же пакет, то же разрешение - документ без пометки перезаписан (текст назначения платежа плана, тот же документ).
	Строка2 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Строка2.Результат, "Контроль (без пометки): результат").Равно("Перезаписан");
	ЮТест.ОжидаетЧто(Строка2.Документ, "Контроль (без пометки): тот же документ").Равно(Контрольный);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Контрольный).НазначениеПлатежа, "Контроль (без пометки): назначение платежа плана записано")
		.Равно(СтрокаКонтрольного.НазначениеПлатежа);

КонецПроцедуры

// Перезапись без разрешения контекста не выполняется: строка с Перезаписать = Истина при РазрешитьПерезапись = Ложь (так вызывает регламент)
// даёт "УжеЗагружен" с предупреждением, документ не меняется (не мовчки, D3). Контроль, который умеет упасть: тот же план и тот же документ с
// разрешением перезаписываются - единственное различие вызовов в разрешении.
Процедура БезРазрешенияКонтекста_НеПерезаписывается_ДокументНеМеняется() Экспорт

	Сценарий = СМП_ТестыЗаписиКаркас.НовыйСценарий("ПоступлениеНаСчет");
	Документ = ДокументСценария(Сценарий, Ложь);
	До = СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Документ);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Строка = СтрокаПерезаписи(План, Сценарий, Документ, 1);
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи();
	ЮТест.ОжидаетЧто(Контекст.РазрешитьПерезапись, "Предусловие: перезапись по умолчанию не разрешена").ЭтоЛожь();

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	СтрокаРезультата = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(СтрокаРезультата.Результат, "Без разрешения: результат").Равно("УжеЗагружен");
	ЮТест.ОжидаетЧто(СтрокаРезультата.Документ, "Без разрешения: документ в результате - наличный").Равно(Документ);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение").Количество(), "Без разрешения: предупреждение").Равно(1);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Ошибка").Количество(), "Без разрешения: ошибок нет").Равно(0);
	ПроверитьДокументНеИзменен(Документ, До, "Без разрешения");

	// Контроль: то же с разрешением.
	Контекст.РазрешитьПерезапись = Истина;
	РезультатСРазрешением = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	СтрокаСРазрешением = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(РезультатСРазрешением, 1);
	ЮТест.ОжидаетЧто(СтрокаСРазрешением.Результат, "Контроль (с разрешением): результат").Равно("Перезаписан");
	ЮТест.ОжидаетЧто(СтрокаСРазрешением.Документ, "Контроль (с разрешением): тот же документ").Равно(Документ);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Документ).НазначениеПлатежа, "Контроль (с разрешением): назначение платежа плана записано")
		.Равно(Строка.НазначениеПлатежа);

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Банковский документ сценария, не проведенный; назначение платежа у него пустое (его меняет перезапись), пометка на удаление - по параметру.
Функция ДокументСценария(Сценарий, ПометкаУдаления)

	Настройки = Новый Структура;
	Настройки.Вставить("ВидДокумента", Сценарий.Вид);
	Настройки.Вставить("Контрагент", Сценарий.Контрагент);
	Настройки.Вставить("Договор", Сценарий.Договор);
	Настройки.Вставить("ВидОперации", Сценарий.ВидОперации);
	Настройки.Вставить("ПометкаУдаления", ПометкаУдаления);

	Возврат СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Настройки);

КонецФункции

// Строка плана, отмеченная к перезаписи документа: версия документа - текущая (как зафиксировало бы распознавание).
Функция СтрокаПерезаписи(План, Сценарий, Документ, ПорядковыйНомер)

	Строка = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("ПорядковыйНомер", ПорядковыйНомер));
	Строка.ЗагруженныйДокумент = Документ;
	Строка.ВерсияДокумента = СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Документ).ВерсияДанных;
	Строка.Перезаписать = Истина;

	Возврат Строка;

КонецФункции

// Документ как был: версия данных (любое изменение ее меняет), пометка, проведение, назначение платежа.
Процедура ПроверитьДокументНеИзменен(Документ, До, Подпись)

	После = СМП_ТестыЗаписиКаркас.ПрочитатьДокумент(Документ);
	ЮТест.ОжидаетЧто(После.ВерсияДанных, Подпись + ": версия данных документа не изменилась").Равно(До.ВерсияДанных);
	ЮТест.ОжидаетЧто(После.ПометкаУдаления, Подпись + ": пометка на удаление").Равно(До.ПометкаУдаления);
	ЮТест.ОжидаетЧто(После.Проведен, Подпись + ": проведение").Равно(До.Проведен);
	ЮТест.ОжидаетЧто(После.НазначениеПлатежа, Подпись + ": назначение платежа").Равно(До.НазначениеПлатежа);

КонецПроцедуры

#КонецОбласти

#Область СторожОстатков

// БЕЗ транзакции, ПОСЛЕДНИМ. Тот же подсчет, что в СМП_ТестыЗаписиКаркас: ждет нуль в каждом типе.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
