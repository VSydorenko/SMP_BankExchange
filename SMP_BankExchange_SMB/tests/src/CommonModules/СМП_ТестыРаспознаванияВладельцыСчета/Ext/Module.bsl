// Тесты распознавания банковской выписки: порядок кандидатов, когда один номер счета числится у нескольких контрагентов (задача 8 плана 04,
// спека §1, D25). Выделено из СМП_ТестыРаспознавания: модуль распознавания близок к пределу одного вызова прогона (~300 с). Общие помощники
// (распознать одну операцию, замечания по полю, чтение реквизитов, контрагент теста) живут в СМП_ТестыРаспознавания и вызываются оттуда.
// Правила - docs/architecture/testing.md.
//
// Порядок выбора - как у нынешнего поиска счета (СМП_РаботаСБанкамиПриватБанкAPIСервер, УПОРЯДОЧИТЬ ПО ПриоритетИНН, ПриоритетБИК,
// ПриоритетНаименования): код контрагента (ЕДРПОУ), затем МФО банка счета, затем название; не различило - первый по коду справочника.
// МФО НЕ фильтрует: кандидат с другим МФО не отбрасывается (антипаттерн задачи 8).
//
// Каждый тест "берется владелец X" выбирает X так, чтобы он был НЕ первым по коду справочника счета (коды читаются из базы: платформа
// выдает их не по порядку создания), и сначала доказывает на тех же счетах, что БЕЗ нужного признака берется первый по коду, - иначе
// зеленый цвет ничего не говорил бы о порядке.
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Порядок кандидатов на счет: ЕДРПОУ, МФО, название (задача 8)");
	Набор.ДобавитьСерверныйТест("Порядок_МФО_БерётсяВладелецСМФООперации").ВТранзакции()
		// Описание, Устаревший: номер операции - устаревший номер счетов (практический случай: в IBAN МФО уже входит в номер)
		.СПараметрами("текущий номер счета", Ложь)
		.СПараметрами("устаревший номер счета", Истина);
	Набор.ДобавитьСерверныйТест("Порядок_ЕДРПОУ_БерётсяВладелецСКодомОперации").ВТранзакции()
		.СПараметрами("текущий номер счета", Ложь)
		.СПараметрами("устаревший номер счета", Истина);
	Набор.ДобавитьСерверныйТест("Порядок_Название_БерётсяВладелецСНазваниемОперации").ВТранзакции()
		.СПараметрами("текущий номер счета", Ложь)
		.СПараметрами("устаревший номер счета", Истина);
	Набор.ДобавитьСерверныйТест("Порядок_Название_ЁиЕ_НеРазличаются").ВТранзакции()
		// Описание, буква в названии владельца, буква в названии операции (старый поиск подменял "ё" на "е" в названии операции; здесь - с обеих сторон)
		.СПараметрами("в операции Ё, у владельца Е", "Е", "Ё")
		.СПараметрами("в операции Е, у владельца Ё", "Ё", "Е");
	Набор.ДобавитьСерверныйТест("Порядок_ЕДРПОУ_ПереважаетМФО").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Порядок_МФО_ПереважаетНазвание").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Порядок_НичегоНеРазличило_ПервыйПоКодуСПредупреждением").ВТранзакции()
		// Описание, МФО, Код, Название операции ("чужое" - значение, которого нет ни у одного кандидата)
		.СПараметрами("МФО, код и название ни у кого не совпали", "чужое", "чужое", "чужое")
		.СПараметрами("в операции нет ни МФО, ни кода, ни названия", "", "", "");
	Набор.ДобавитьСерверныйТест("Порядок_РавныеСовпадения_ПервыйПоКодуСредиРавных_ПредупреждениеОстается").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Порядок_ТекущийНомерПереважаетУстаревший_ДажеПротивПризнаков").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Порядок кандидатов на счет: сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Порядок

// МФО: два владельца с одним номером, банки счетов разные. В операции МФО банка ВТОРОГО по коду счета - берется он. Контроль на тех же
// счетах: МФО, которого нет ни у кого, - берется первый по коду.
Процедура Порядок_МФО_БерётсяВладелецСМФООперации(Описание, Устаревший) Экспорт

	Счета = Кандидаты(2, Устаревший);
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, Описание + ": предусловие - у счетов разные МФО").НеРавно(Второй.МФО);

	Без = Распознать(Счета.Номер, "", "", "000001");
	ПроверитьВыбор(Без, Первый, Описание + ": контроль - МФО ни у кого, берется первый по коду", 1);

	С = Распознать(Счета.Номер, "", "", Второй.МФО);
	ПроверитьВыбор(С, Второй, Описание + ": МФО операции - банк второго по коду", 0);

КонецПроцедуры

// ЕДРПОУ: банки счетов одинаковые (МФО не различает). В операции код ВТОРОГО по коду владельца.
Процедура Порядок_ЕДРПОУ_БерётсяВладелецСКодомОперации(Описание, Устаревший) Экспорт

	Счета = Кандидаты(2, Устаревший, СМП_ТестыДанныеУНФ.НовыйБанк());
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, Описание + ": предусловие - банк счетов один (МФО не различает)").Равно(Второй.МФО);
	ЮТест.ОжидаетЧто(Первый.Код, Описание + ": предусловие - у владельцев разные ЕДРПОУ").НеРавно(Второй.Код);

	Без = Распознать(Счета.Номер, "", "", Первый.МФО);
	ПроверитьВыбор(Без, Первый, Описание + ": контроль - кода в операции нет, берется первый по коду справочника", 1);

	С = Распознать(Счета.Номер, Второй.Код, "", Первый.МФО);
	ПроверитьВыбор(С, Второй, Описание + ": код операции - ЕДРПОУ второго по коду", 0);

КонецПроцедуры

// Название: банки одинаковые, кода в операции нет. В операции название ВТОРОГО по коду владельца (регистр и пробелы по краям значения не имеют).
Процедура Порядок_Название_БерётсяВладелецСНазваниемОперации(Описание, Устаревший) Экспорт

	Счета = Кандидаты(2, Устаревший, СМП_ТестыДанныеУНФ.НовыйБанк());
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, Описание + ": предусловие - банк счетов один (МФО не различает)").Равно(Второй.МФО);
	ЮТест.ОжидаетЧто(Первый.Название, Описание + ": предусловие - у владельцев разные названия").НеРавно(Второй.Название);

	Без = Распознать(Счета.Номер, "", "", Первый.МФО);
	ПроверитьВыбор(Без, Первый, Описание + ": контроль - названия в операции нет, берется первый по коду справочника", 1);

	С = Распознать(Счета.Номер, "", " " + ВРег(Второй.Название) + " ", Первый.МФО);
	ПроверитьВыбор(С, Второй, Описание + ": название операции - второго по коду", 0);

КонецПроцедуры

// Название: Ё и Е не различаются (нынешний поиск сверял название операции и с "ё", и с "е"; в базе вендора названия бывают русскими). Банки одинаковые,
// кода нет. Название ВТОРОГО по коду владельца содержит БуквуВладельца, в операции - БуквуОперации.
Процедура Порядок_Название_ЁиЕ_НеРазличаются(Описание, БукваВладельца, БукваОперации) Экспорт

	Счета = Кандидаты(2, Ложь, СМП_ТестыДанныеУНФ.НовыйБанк());
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	Уникальное = Прав(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Второй.Счет, "Код").Код, 6);
	Основа = "СМП_ТЕСТ_{Б}лка_" + Уникальное;
	Объект = Второй.Владелец.ПолучитьОбъект();
	Объект.Наименование = СтрЗаменить(Основа, "{Б}", БукваВладельца);
	Объект.НаименованиеПолное = Объект.Наименование;
	Объект.Записать();
	Второй.Название = Объект.Наименование;
	НазваниеОперации = СтрЗаменить(Основа, "{Б}", БукваОперации);
	ЮТест.ОжидаетЧто(НРег(НазваниеОперации), Описание + ": предусловие - названия отличаются буквой").НеРавно(НРег(Второй.Название));

	Без = Распознать(Счета.Номер, "", "", Первый.МФО);
	ПроверитьВыбор(Без, Первый, Описание + ": контроль - названия в операции нет, берется первый по коду справочника", 1);

	С = Распознать(Счета.Номер, "", НазваниеОперации, Первый.МФО);
	ПроверитьВыбор(С, Второй, Описание + ": название операции с другой буквой - второго по коду", 0);

КонецПроцедуры

// ЕДРПОУ старше МФО: у ВТОРОГО по коду совпал только код, у ПЕРВОГО - только МФО. Берется второй. Предусловия: каждый признак сам по себе
// берет своего владельца (иначе "побеждает ЕДРПОУ" могло бы значить "МФО ничего не весит"). Предусловие для МФО первого не нужно: первый по коду берется и так.
Процедура Порядок_ЕДРПОУ_ПереважаетМФО() Экспорт

	Счета = Кандидаты(2, Ложь);
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, "Предусловие - у счетов разные МФО").НеРавно(Второй.МФО);

	КодВторого = Распознать(Счета.Номер, Второй.Код, "", "000001");
	ЮТест.ОжидаетЧто(КодВторого.Строка.СчетКонтрагента, "Предусловие - код второго сам по себе берет второго").Равно(Второй.Счет);

	Оба = Распознать(Счета.Номер, Второй.Код, "", Первый.МФО);
	ПроверитьВыбор(Оба, Второй, "ЕДРПОУ второго против МФО первого - берется ЕДРПОУ", 0);

КонецПроцедуры

// МФО старше названия: у ВТОРОГО по коду совпало только МФО, у ПЕРВОГО - только название. Берется второй.
Процедура Порядок_МФО_ПереважаетНазвание() Экспорт

	Счета = Кандидаты(2, Ложь);
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, "Предусловие - у счетов разные МФО").НеРавно(Второй.МФО);

	МФОВторого = Распознать(Счета.Номер, "", "", Второй.МФО);
	ЮТест.ОжидаетЧто(МФОВторого.Строка.СчетКонтрагента, "Предусловие - МФО второго само по себе берет второго").Равно(Второй.Счет);

	Оба = Распознать(Счета.Номер, "", Первый.Название, Второй.МФО);
	ПроверитьВыбор(Оба, Второй, "МФО второго против названия первого - берется МФО", 0);

КонецПроцедуры

// Порядок не различил - как раньше: первый по коду справочника и предупреждение, называющее обоих владельцев. Здесь же антипаттерн "МФО -
// фильтр": у операции МФО, которого нет ни у кого, а счет все равно найден (отброшенный кандидат исчез бы без следа).
Процедура Порядок_НичегоНеРазличило_ПервыйПоКодуСПредупреждением(Описание, МФО, Код, Название) Экспорт

	Счета = Кандидаты(2, Ложь);
	Первый = Счета.Список[0];
	Второй = Счета.Список[1];
	ЮТест.ОжидаетЧто(Первый.МФО, Описание + ": предусловие - у счетов разные МФО").НеРавно(Второй.МФО);

	Результат = Распознать(Счета.Номер,
		?(Код = "чужое", СМП_ТестыДанныеУНФ.НовыйЕДРПОУ(), Код),
		?(Название = "чужое", "СМП_ТЕСТ_Чужое название", Название),
		?(МФО = "чужое", "000001", МФО));

	ПроверитьВыбор(Результат, Первый, Описание, 1);
	Предупреждения = СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "СчетКонтрагента", СМП_ТестыРаспознавания.УровеньПредупреждение());
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": предупреждение называет первого владельца").Содержит(Первый.Название);
		ЮТест.ОжидаетЧто(Предупреждения[0].Текст, Описание + ": предупреждение называет второго владельца").Содержит(Второй.Название);
	КонецЕсли;

КонецПроцедуры

// Три владельца: у первого по коду банк свой, у второго и третьего - один, тот, что в операции (равные совпадения по МФО). Берется второй
// (первый по коду СРЕДИ РАВНЫХ, а не первый вообще); предупреждение остается: между вторым и третьим порядок не различил.
Процедура Порядок_РавныеСовпадения_ПервыйПоКодуСредиРавных_ПредупреждениеОстается() Экспорт

	Счета = Кандидаты(3, Ложь);
	Список = Счета.Список;
	УстановитьБанкКакУ(Список[2], Список[1]);
	ЮТест.ОжидаетЧто(Список[0].МФО, "Предусловие - банк первого по коду другой").НеРавно(Список[1].МФО);
	ЮТест.ОжидаетЧто(Список[1].МФО, "Предусловие - у второго и третьего банк один").Равно(Список[2].МФО);

	Результат = Распознать(Счета.Номер, "", "", Список[1].МФО);

	ПроверитьВыбор(Результат, Список[1], "Равные совпадения по МФО", 1);

КонецПроцедуры

// Текущий номер сильнее устаревшего (прежнее правило), даже когда у владельца устаревшего номера совпали ЕДРПОУ, название и МФО: берется счет
// с текущим номером, предупреждения нет (разные уровни совпадения неоднозначностью не считаются).
Процедура Порядок_ТекущийНомерПереважаетУстаревший_ДажеПротивПризнаков() Экспорт

	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN();
	БанкТекущего = СМП_ТестыДанныеУНФ.НовыйБанк();
	БанкУстаревшего = СМП_ТестыДанныеУНФ.НовыйБанк();
	ВладелецТекущего = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	ВладелецУстаревшего = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Текущий = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(ВладелецТекущего, Новый Структура("Банк, НомерСчета", БанкТекущего, Номер));
	Устаревший = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(ВладелецУстаревшего,
		Новый Структура("Банк, НомерСчета, НомерСчетаУстаревший", БанкУстаревшего, СМП_ТестыДанныеУНФ.НовыйIBAN(), Номер));
	КодБанкаУстаревшего = СокрЛП(СМП_ТестыРаспознавания.ЧитатьРеквизиты(БанкУстаревшего, "Код").Код);
	КодБанкаТекущего = СокрЛП(СМП_ТестыРаспознавания.ЧитатьРеквизиты(БанкТекущего, "Код").Код);
	ЮТест.ОжидаетЧто(КодБанкаУстаревшего, "Предусловие - банки счетов разные").НеРавно(КодБанкаТекущего);
	Данные = СМП_ТестыРаспознавания.ДанныеКонтрагента(ВладелецУстаревшего);

	Результат = СМП_ТестыРаспознавания.РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование, КонтрагентМФО",
		Номер, Данные.Код, Данные.Наименование, КодБанкаУстаревшего));

	ЮТест.ОжидаетЧто(Результат.Строка.СчетКонтрагента, "Берется счет с текущим номером, хотя ЕДРПОУ, название и МФО - у устаревшего").Равно(Текущий);
	ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, "Контрагент - владелец текущего номера").Равно(ВладелецТекущего);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "СчетКонтрагента").Количество(),
		"Предупреждения о нескольких владельцах нет: уровни совпадения разные").Равно(0);
	ЮТест.ОжидаетЧто(Устаревший <> Текущий, "Предусловие - счета разные").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Сторож

Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Счета контрагентов с одним номером операции: у каждого свой контрагент и, если Банк не задан, свой банк. Номер операции - текущий номер
// счетов или устаревший (тогда текущий у каждого свой).
//
// Возвращаемое значение:
//  Структура - Номер; Список - Массив структур (Счет, Владелец, Код (ЕДРПОУ), Название, МФО), упорядоченный по коду справочника счета.
Функция Кандидаты(Количество, Устаревший, Банк = Неопределено)

	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN();
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("КодСчета");
	Таблица.Колонки.Добавить("Счет");
	Таблица.Колонки.Добавить("Владелец");
	Для Индекс = 1 По Количество Цикл
		Владелец = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		Настройки = Новый Структура;
		Настройки.Вставить("Банк", ?(Банк = Неопределено, СМП_ТестыДанныеУНФ.НовыйБанк(), Банк));
		Настройки.Вставить("НомерСчета", ?(Устаревший, СМП_ТестыДанныеУНФ.НовыйIBAN(), Номер));
		Настройки.Вставить("НомерСчетаУстаревший", ?(Устаревший, Номер, ""));
		Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетКонтрагента(Владелец, Настройки);
		Строка = Таблица.Добавить();
		Строка.Счет = Счет;
		Строка.Владелец = Владелец;
		Строка.КодСчета = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "Код").Код;
	КонецЦикла;
	Таблица.Сортировать("КодСчета");
	Для Индекс = 1 По Таблица.Количество() - 1 Цикл
		ЮТест.ОжидаетЧто(Таблица[Индекс].КодСчета, "Предусловие - коды справочника счетов различаются").НеРавно(Таблица[Индекс - 1].КодСчета);
	КонецЦикла;

	Список = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Данные = СМП_ТестыРаспознавания.ДанныеКонтрагента(Строка.Владелец);
		Запись = Новый Структура("Счет, Владелец, Код, Название, МФО");
		Запись.Счет = Строка.Счет;
		Запись.Владелец = Строка.Владелец;
		Запись.Код = Данные.Код;
		Запись.Название = Данные.Наименование;
		Запись.МФО = КодБанкаСчета(Строка.Счет);
		Список.Добавить(Запись);
	КонецЦикла;

	Возврат Новый Структура("Номер, Список", Номер, Список);

КонецФункции

Функция КодБанкаСчета(Счет)

	Банк = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "Банк").Банк;

	Возврат СокрЛП(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Банк, "Код").Код);

КонецФункции

// Переводит счет кандидата в банк счета другого кандидата (код справочника счета при перезаписи не меняется).
Процедура УстановитьБанкКакУ(Кандидат, Образец)

	Объект = Кандидат.Счет.ПолучитьОбъект();
	Объект.Банк = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Образец.Счет, "Банк").Банк;
	Объект.Записать();
	Кандидат.МФО = КодБанкаСчета(Кандидат.Счет);

КонецПроцедуры

Функция Распознать(Номер, Код, Название, МФО)

	Возврат СМП_ТестыРаспознавания.РаспознатьОперацию(Новый Структура("КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование, КонтрагентМФО",
		Номер, Код, Название, МФО));

КонецФункции

// Берется ожидаемый кандидат (счет и его владелец); предупреждений о нескольких владельцах счета - ровно столько, сколько ожидается.
Процедура ПроверитьВыбор(Результат, Ожидаемый, Описание, ОжидаемоПредупреждений)

	ЮТест.ОжидаетЧто(Результат.Строка.СчетКонтрагента, Описание + ": счет").Равно(Ожидаемый.Счет);
	ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, Описание + ": контрагент - владелец счета").Равно(Ожидаемый.Владелец);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "СчетКонтрагента",
		СМП_ТестыРаспознавания.УровеньПредупреждение()).Количество(), Описание + ": предупреждений о нескольких владельцах").Равно(ОжидаемоПредупреждений);

КонецПроцедуры

#КонецОбласти
