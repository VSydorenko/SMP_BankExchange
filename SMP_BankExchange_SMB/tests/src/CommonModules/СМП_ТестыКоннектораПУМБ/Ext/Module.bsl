// Тесты конектора ПУМБ (план 05б-2, задача 3). Правило владельца 2026-10-20: «тестировать только ключевое и критически важное» -
// тестов ровно три, перечень в плане - верхняя граница.
//
//   Т1 - сквозной, по ВСЕМ записям банка pumb (синтетика и обезличенные записи run3 и run4, вид набора «run1»: макет Run1): запись -> транспорт
//        воспроизведения (с телами и портом, формат v2) -> конектор через точку чтения -> конверт; сравнение с эталоном оракула
//        («ожидаемое») поле за полем: операции, диагностика (уровень, номер и факты, различающие суть; кода сути в контракте
//        диагностики нет, текст на код не разбирается), ЧтениеПолное, ГраницаДоверия, класс отказа, запросы (метод, адрес с портом;
//        тело сверяет сам транспорт воспроизведения против записи) и паузы. Поля ключа D17 (день, номер, счет контрагента, сумма) -
//        колонки операции в том же сравнении: для ПУМБ ключ без совместимости с предшественником (спека 2b8ff4b), режим «старая
//        обработка» эталона - not-applicable и ключ с ним не сверяется; Т1 проверяет сам признак. Сообщение: «запис X, операція N, поле F».
//   Т2 - инвариант безопасности: синтетические идентификатор клиента, секрет, логин, пароль, выданный банком access_token, значения
//        заголовков ответа аутентификации и идентификаторы счетов (accountId) не встречаются ни в одном тексте результата (признак
//        внутри Т1).
//   Т3 - контроль харнеса: эталон с одним испорченным полем дает красное (без конектора, на конверте, собранном из самого эталона).
//
// Отдельных тестов на случаи нет: каждый случай - запись в наборе (СМП_ТестЗаписиAPI). Перечень «пункт покрытия -> записи» - в журнале
// прогонов плана 05б-2. Чтение без пагинации (Р4): пороги и деление периода заданы записями, шва размера страницы нет.

Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конектор ПУМБ: записи против эталона оракула (план 05б-2, задача 3)");
	Набор = Набор.ДобавитьСерверныйТест("Т1_ЗаписьПротивЭталона");
	Для Каждого Вид Из ВидыНабора() Цикл
		Для Каждого Ид Из СМП_ТестЗаписиAPI.Идентификаторы(БанкНабора(), Вид) Цикл
			Набор = Набор.СПараметрами(Вид + "/" + Ид, Вид, Ид);
		КонецЦикла;
	КонецЦикла;
	Набор.ДобавитьСерверныйТест("Т3_КонтрольХарнеса_ИспорченныйЭталонДаетКрасное");

КонецПроцедуры

#Область Тесты

// Т1 (и Т2 - признаком): одна запись набора.
Процедура Т1_ЗаписьПротивЭталона(Описание, Вид, Ид) Экспорт

	Название = Вид + "/" + Ид;
	Эталон = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), Вид, Ид);
	Чтение = ПрочитатьЗапись(Вид, Ид, Эталон);

	Расхождения = Новый Массив;
	ДобавитьВсе(Расхождения, ПроверитьЭталон(Название, Эталон));
	ДобавитьВсе(Расхождения, Чтение.Проблемы);
	Если Чтение.Результат <> Неопределено Тогда
		ДобавитьВсе(Расхождения, СравнитьКонверт(Название, Эталон, Чтение.Результат.Выписка));
		ДобавитьВсе(Расхождения, СравнитьЗапросыИПаузы(Название, Эталон, Чтение.Транспорт));
		ДобавитьВсе(Расхождения, СекретыВТекстах(Название, Чтение.Результат, Чтение.Секреты));
		ДобавитьВсе(Расхождения, СравнитьРезультатТочкиЧтения(Название, Эталон, Чтение.Результат));
		Если Расхождения.Количество() > 0 Тогда
			// Рядки диагностики точки читания (в них исключение конектора, пойманное точкой чтения): без них красное не объясняет причину.
			Для Каждого Строка Из Чтение.Результат.Диагностика Цикл
				Расхождения.Добавить("запис " + Название + ", діагностика точки читання: " + Строка.Уровень + ": " + Лев(Строка.Текст, 400));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	ЮТест.ОжидаетЧто(ТекстРасхождений(Расхождения), "Запис " + Название + ": расхождения с эталоном оракула").Равно("");

КонецПроцедуры

// Т3: контроль харнеса. Конверт собран из самого эталона, поэтому верный эталон дает пустой список расхождений, а
// эталон с одним испорченным полем - непустой, и сообщение называет запись, операцию и поле.
Процедура Т3_КонтрольХарнеса_ИспорченныйЭталонДаетКрасное() Экспорт

	Ид = "СинтПУМБНеокончательные";
	Выписка = ВыпискаИзЭталона(СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид));

	Верный = СравнитьКонверт("synthetic/" + Ид, СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид), Выписка);
	ЮТест.ОжидаетЧто(ТекстРасхождений(Верный), "Контроль: конверт из эталона против того же эталона - без расхождений").Равно("");

	// Испорчено одно поле операции.
	Испорченный = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	Операция = Испорченный["expected"]["Операции"][0];
	Операция["Сумма"] = "999999.99";
	ПоОперации = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, Испорченный, Выписка));
	ЮТест.ОжидаетЧто(ПоОперации, "Контроль: испорчена Сумма первой операции - красное").Содержит("Сумма");
	ЮТест.ОжидаетЧто(ПоОперации, "Контроль: сообщение называет запись и операцию")
		.Содержит("запис synthetic/" + Ид + ", операція " + Формат(Операция["ПорядковыйНомер"], "ЧГ=0"));

	// Испорчена диагностика: ожидаемый рядок другого уровня.
	ИспорченнаяДиагностика = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	ИспорченнаяДиагностика["expected"]["Диагностика"][0]["Уровень"] = "Ошибка";
	ПоДиагностике = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, ИспорченнаяДиагностика, Выписка));
	ЮТест.ОжидаетЧто(ПоДиагностике, "Контроль: испорчен уровень рядка диагностики - красное").Содержит("діагностика");

	// Испорчен класс отказа.
	ИспорченныйКласс = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	ИспорченныйКласс["expected"]["КлассОтказа"] = "Повторить";
	ПоКлассу = ТекстРасхождений(СравнитьКонверт("synthetic/" + Ид, ИспорченныйКласс, Выписка));
	ЮТест.ОжидаетЧто(ПоКлассу, "Контроль: испорчен класс отказа - красное").Содержит("КлассОтказа");

	// Эталон не для ПУМБ: режим «старая обработка» без признака not-applicable - красное (ключ D17 без совместимости не должен тихо стать обычным).
	БезПризнака = СМП_ТестЗаписиAPI.Эталон(БанкНабора(), "synthetic", Ид);
	БезПризнака["oldProcessing"]["Исключение"]["kind"] = "other";
	ПоПризнаку = ТекстРасхождений(ПроверитьЭталон("synthetic/" + Ид, БезПризнака));
	ЮТест.ОжидаетЧто(ПоПризнаку, "Контроль: режим «старая обработка» не not-applicable - красное").Содержит("not-applicable");

КонецПроцедуры

#КонецОбласти

#Область Чтение

Функция БанкНабора()

	Возврат "pumb";

КонецФункции

// Виды наборов ПУМБ: синтетика и обезличенные записи run3 и run4 (макет Run1; отдельного вида run3 для ПУМБ нет).
Функция ВидыНабора()

	Результат = Новый Массив;
	Результат.Добавить("synthetic");
	Результат.Добавить("run1");
	Возврат Результат;

КонецФункции

// Идентификатор строки реестра конекторов (постоянный, общее пространство с форматами, D36 п. 4).
Функция ИдентификаторСтроки()

	Возврат "ПУМБ_API";

КонецФункции

Функция ИдентификаторКлиентаСинтетический()

	Возврат "СМП_ТЕСТ_КЛИЕНТ_Wm4Rt58Hy";

КонецФункции

Функция СекретКлиентаСинтетический()

	Возврат "СМП_ТЕСТ_СЕКРЕТ_Qp2Vd61Nc";

КонецФункции

Функция ЛогинСинтетический()

	// Значение вымышлено так же, как в записи отказа аутентификации синтетики (tools/statement-samples/apilib/synth_pumb.py, FAKE_LOGIN): банк в ответе называет логин,
	// конектор обязан его вырезать (метка вместо значения), поэтому логин теста - тот же, что в записи.
	Возврат "vymyshlenyi_login_pumb";

КонецФункции

Функция ПарольСинтетический()

	Возврат "СМП_ТЕСТ_ПАРОЛЬ_Zq7Xp93Lk";

КонецФункции

// Читает запись конектором через точку чтения (продуктовым путем по строке реестра, без швов: у ПУМБ нет размера страницы).
//
// Возвращаемое значение:
//  Структура - Результат (результат точки чтения или Неопределено), Транспорт, Секреты (Массив из Структура: Значение, ЭтоЧисло),
//   Проблемы (Массив из Строка).
Функция ПрочитатьЗапись(Вид, Ид, Эталон)

	Итог = Новый Структура("Результат, Транспорт, Секреты, Проблемы", Неопределено, Неопределено, Новый Массив, Новый Массив);
	Название = Вид + "/" + Ид;

	Пакет = СМП_ТестЗаписиAPI.Записи(БанкНабора(), Вид)[Ид];
	Параметры = Эталон["parameters"];
	Начало = ДатаИзISO(Параметры["НачалоПериода"]);
	Конец = ДатаИзISO(Параметры["КонецПериода"]);

	Транспорт = СМП_ТестЗаписиAPI.ТранспортИзПакета(Пакет);
	Итог.Транспорт = Транспорт;
	Итог.Секреты = СекретыЗаписи(Транспорт);

	// Момент чтения транспорта фиксирован записью (D36 п. 11): ТекущийМомент() отдает его, а не момент из startedUtc обменов.
	Если Параметры["МоментЧтения"] <> Неопределено Тогда
		Транспорт.ЗаданныйМомент = ДатаИзISO(Параметры["МоментЧтения"]);
	КонецЕсли;

	Найденная = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.НайтиСтрокуКоннектора", ПараметрыВызова(
		СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.РеестрКоннекторов"),
		ИдентификаторСтроки()));
	Если Найденная.Строка = Неопределено Тогда
		Итог.Проблемы.Добавить("запис " + Название + ": конектор не зарегистрирован - " + Найденная.Отказ);
		Возврат Итог;
	КонецЕсли;

	Счета = Новый Массив;
	Счета.Добавить(Параметры["НомерСчета"]);
	Учетные = Новый Структура("ИдентификаторКлиента, СекретКлиента, Логин, Пароль",
		ИдентификаторКлиентаСинтетический(), СекретКлиентаСинтетический(), ЛогинСинтетический(), ПарольСинтетический());

	// Валюта банковского счета 1С: точка чтения кладет ее в Параметры.ВалютаСчета для API всегда; в параметрах чтения эталона поле есть у всей синтетики ПУМБ.
	ВалютаСчета = Параметры["ВалютаСчета"];
	Если ВалютаСчета = Неопределено Тогда
		ВалютаСчета = "";
	КонецЕсли;

	Попытка
		Итог.Результат = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок.ПрочитатьКоннектором",
			ПараметрыВызова(ИдентификаторСтроки(), Счета, Начало, Конец, Учетные, Транспорт, ВалютаСчета));
	Исключение
		Итог.Проблемы.Добавить("запис " + Название + ": чтение завершилось исключением: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Итог;

КонецФункции

// Аргументы вызова продукта массивом (Null - «аргумента нет»).
Функция ПараметрыВызова(А1, А2 = Null, А3 = Null, А4 = Null, А5 = Null, А6 = Null, А7 = Null)

	Массив = Новый Массив;
	Массив.Добавить(А1);
	Для Каждого Значение Из Новый Структура("Второй, Третий, Четвертый, Пятый, Шестой, Седьмой", А2, А3, А4, А5, А6, А7) Цикл
		Если ТипЗнч(Значение.Значение) = Тип("Null") Тогда
			Прервать;
		КонецЕсли;
		Массив.Добавить(Значение.Значение);
	КонецЦикла;
	Возврат Массив;

КонецФункции

// Секреты, которые банк выдал в записи: access_token и refresh_token ответа аутентификации, значения заголовков этого ответа (Set-Cookie и т.п.)
// и идентификаторы счетов (accountId) из списка счетов. Берутся из самой записи, а не из констант теста.
//
// Возвращаемое значение:
//  Массив из Структура - Значение (Строка), ЭтоЧисло (Булево: искать как отдельное число).
Функция СекретыЗаписи(Транспорт)

	Результат = Новый Массив;
	Для Каждого Обмен Из Транспорт.Обмены Цикл
		Если СтрЗаканчиваетсяНа(Обмен.Путь, "/openid-connect/token") Тогда
			Если ТипЗнч(Обмен.Заголовки) = Тип("Соответствие") Тогда
				Для Каждого Заголовок Из Обмен.Заголовки Цикл
					Если НРег(Заголовок.Ключ) <> "content-type" И НРег(Заголовок.Ключ) <> "content-length" И Не ПустаяСтрока(Заголовок.Значение) Тогда
						Результат.Добавить(Новый Структура("Значение, ЭтоЧисло", Строка(Заголовок.Значение), Ложь));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Данные = ПопыткаРазобратьТело(Обмен.Тело);
			Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
				Для Каждого Имя Из СтрРазделить("access_token,refresh_token", ",") Цикл
					Если ТипЗнч(Данные[Имя]) = Тип("Строка") И СтрДлина(Данные[Имя]) >= 8 Тогда
						Результат.Добавить(Новый Структура("Значение, ЭтоЧисло", Данные[Имя], Ложь));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли СтрЗаканчиваетсяНа(Обмен.Путь, "/account") Тогда
			Данные = ПопыткаРазобратьТело(Обмен.Тело);
			Если ТипЗнч(Данные) = Тип("Массив") Тогда
				Для Каждого Счет Из Данные Цикл
					Если ТипЗнч(Счет) = Тип("Соответствие") И Счет["accountId"] <> Неопределено Тогда
						Идентификатор = Формат(Счет["accountId"], "ЧГ=0");
						Если СтрДлина(Идентификатор) >= 4 Тогда
							Результат.Добавить(Новый Структура("Значение, ЭтоЧисло", Идентификатор, Истина));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПопыткаРазобратьТело(Тело)

	Если ТипЗнч(Тело) <> Тип("ДвоичныеДанные") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Тело, "utf-8"));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Данные;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Сравнение

// Признаки самого эталона: режим «старая обработка» для ПУМБ - not-applicable (D17, исключение ПУМБ); чужих счетов в эталоне нет (фильтр по счету
// делает конектор, а не точка чтения, D30 для ПУМБ неприменим).
Функция ПроверитьЭталон(Название, Эталон)

	Р = Новый Массив;
	Признак = Эталон["oldProcessing"]["Исключение"];
	Если Признак = Неопределено Или Признак["kind"] <> "not-applicable" Тогда
		Р.Добавить("запис " + Название + ", операція 0, поле эталон: режим «старая обработка» не not-applicable (ключ D17 ПУМБ без совместимости с предшественником)");
	КонецЕсли;
	Если Эталон["expected"]["ЧужиеСчета"].Количество() > 0 Тогда
		Р.Добавить("запис " + Название + ", операція 0, поле эталон: в эталоне ПУМБ есть чужие счета (ожидается фильтр конектора с рядком Предупреждение)");
	КонецЕсли;
	Возврат Р;

КонецФункции

// Сравнивает конверт (Выписка после точки чтения) с эталоном. Возвращает тексты расхождений.
Функция СравнитьКонверт(Название, Эталон, Выписка)

	Р = Новый Массив;
	Ожидаемое = Эталон["expected"];

	Сверить(Р, Название, 0, "ЧтениеПолное", Ожидаемое["ЧтениеПолное"], Выписка.ЧтениеПолное);
	Сверить(Р, Название, 0, "ГраницаДоверия", Ожидаемое["ГраницаДоверия"], ДатаВISO(Выписка.ГраницаДоверия));
	Сверить(Р, Название, 0, "КлассОтказа", Ожидаемое["КлассОтказа"], Выписка.КлассОтказа);

	ОжидаемыеОперации = Ожидаемое["Операции"];
	Сверить(Р, Название, 0, "число операций", ОжидаемыеОперации.Количество(), Выписка.Операции.Количество());
	Для Индекс = 0 По Мин(ОжидаемыеОперации.ВГраница(), Выписка.Операции.Количество() - 1) Цикл
		СравнитьОперацию(Р, Название, ОжидаемыеОперации[Индекс], Выписка.Операции[Индекс]);
	КонецЦикла;

	СравнитьДиагностику(Р, Название, Ожидаемое["Диагностика"], Выписка.Диагностика);

	Возврат Р;

КонецФункции

Процедура СравнитьОперацию(Р, Название, Ожидаемая, Фактическая)

	Номер = Ожидаемая["ПорядковыйНомер"];
	Для Каждого Колонка Из СтрРазделить("ПорядковыйНомер,НомерСчета,Валюта,ДатаОперации,НомерДокумента,ДатаДокумента,"
		+ "Сумма,Направление,ИдентификаторОперации,КонтрагентНаименование,КонтрагентНомерСчета,КонтрагентКод,"
		+ "КонтрагентМФО,НазначениеПлатежа", ",") Цикл
		Сверить(Р, Название, Номер, Колонка, ПредставлениеОжидаемого(Колонка, Ожидаемая[Колонка]),
			ПредставлениеФактического(Колонка, Фактическая[Колонка]));
	КонецЦикла;
	Если ПустаяСтрока(Фактическая.СырыеДанные) Тогда
		Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле СырыеДанные: пусто");
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеОжидаемого(Колонка, Значение)

	Если Колонка = "ПорядковыйНомер" Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли Колонка = "ДатаДокумента" Тогда
		Возврат Лев(Значение, 10);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ПредставлениеФактического(Колонка, Значение)

	Если Колонка = "ПорядковыйНомер" Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли Колонка = "Сумма" Тогда
		Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
	ИначеЕсли Колонка = "ДатаОперации" Тогда
		Возврат ДатаВISO(Значение);
	ИначеЕсли Колонка = "ДатаДокумента" Тогда
		Возврат Лев(ДатаВISO(Значение), 10);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Процедура Сверить(Р, Название, Номер, Поле, Ожидаемое, Фактическое)

	Если Ожидаемое <> Фактическое Или ТипЗнч(Ожидаемое) <> ТипЗнч(Фактическое) Тогда
		Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле " + Поле
			+ ": очікувалось «" + Строка(Ожидаемое) + "», отримано «" + Строка(Фактическое) + "»");
	КонецЕсли;

КонецПроцедуры

// Диагностика: каждый ожидаемый рядок находит рядок того же уровня и номера, текст которого называет все факты
// (банк, статус, описание банка, состояние, идентификатор, сутки, количество); рядки без пары - лишние. Текст не привязан к формулировке.
Процедура СравнитьДиагностику(Р, Название, Ожидаемые, Диагностика)

	Занятые = Новый Массив;
	Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
		Занятые.Добавить(Ложь);
	КонецЦикла;

	Для Каждого Ожидаемая Из Ожидаемые Цикл
		Факты = ФактыТекстом(Ожидаемая["Факты"]);
		Нашли = Ложь;
		Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
			Строка = Диагностика[Индекс];
			Если Занятые[Индекс] Или Строка.Уровень <> Ожидаемая["Уровень"]
				Или Строка.ПорядковыйНомер <> Ожидаемая["ПорядковыйНомер"] Тогда
				Продолжить;
			КонецЕсли;
			Подходит = Истина;
			Для Каждого Факт Из Факты Цикл
				Если СтрНайти(Строка.Текст, Факт) = 0 Тогда
					Подходит = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Подходит Тогда
				Занятые[Индекс] = Истина;
				Нашли = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Нашли Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Ожидаемая["ПорядковыйНомер"], "ЧГ=0")
				+ ", діагностика: немає рядка «" + Ожидаемая["Уровень"] + "» (суть " + Ожидаемая["Суть"]
				+ "), що називає " + СтрСоединить(Факты, ", "));
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По Диагностика.Количество() - 1 Цикл
		Если Не Занятые[Индекс] Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Диагностика[Индекс].ПорядковыйНомер, "ЧГ=0")
				+ ", діагностика: зайвий рядок «" + Диагностика[Индекс].Уровень + "»: " + Диагностика[Индекс].Текст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Факты рядка диагностики, которые текст для человека обязан назвать (Вид - служебный код, Момент - формат в тексте не задан, в текст не идут).
Функция ФактыТекстом(Факты)

	Результат = Новый Массив;
	Для Каждого Ключ Из СтрРазделить("Банк,Статус,ОписаниеБанка,Состояние,Ид,Значение,Код,Секунда,Секунда2,Количество,Пауза,Сутки,Документов,Порог,Страниц,Операций,Граница", ",") Цикл
		Значение = Факты[Ключ];
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Текст = СокрЛП(?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0"), Строка(Значение)));
		Если Не ПустаяСтрока(Текст) Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запросы и паузы. Транспорт воспроизведения сам сверяет каждый запрос с записанным (метод, хост с портом, путь, запрос, ТЕЛО) и показывает
// невостребованные обмены (Проверить); здесь же запросы сверяются с эталоном (метод и адрес с портом), проверяется состав ИМЕН заголовков и
// сверяются паузы (секунды по порядку).
Функция СравнитьЗапросыИПаузы(Название, Эталон, Транспорт)

	Р = Новый Массив;
	Ожидаемое = Эталон["expected"];

	Для Каждого Текст Из Транспорт.Проверить() Цикл
		Р.Добавить("запис " + Название + ", транспорт воспроизведення: " + Текст);
	КонецЦикла;

	ОжидаемыеЗапросы = Новый Массив;
	Для Каждого Запрос Из Ожидаемое["Запросы"] Цикл
		Пары = Новый Массив;
		Для Каждого Пара Из Запрос["Запрос"] Цикл
			Пары.Добавить(Пара[0] + "=" + КодироватьСтроку(Пара[1], СпособКодированияСтроки.КодировкаURL));     // эталон хранит значения раскодированными, запрос несет их закодированными
		КонецЦикла;
		Адрес = "https://" + Запрос["Хост"] + ?(Запрос["Порт"] = Неопределено, "", ":" + Формат(Запрос["Порт"], "ЧГ=0")) + Запрос["Путь"];
		Если Пары.Количество() > 0 Тогда
			Адрес = Адрес + "?" + СтрСоединить(Пары, "&");
		КонецЕсли;
		ОжидаемыеЗапросы.Добавить(Запрос["Метод"] + " " + Адрес);
	КонецЦикла;
	ФактическиеЗапросы = Новый Массив;
	Для Каждого Текст Из Транспорт.Запросы Цикл
		ФактическиеЗапросы.Добавить(Текст);
	КонецЦикла;
	Сверить(Р, Название, 0, "число запитів", ОжидаемыеЗапросы.Количество(), ФактическиеЗапросы.Количество());
	// Состав ИМЕН заголовков каждого запроса (значения транспорт не хранит): запрос данных без обязательного заголовка - расхождение.
	Для Номер = 0 По Мин(Транспорт.ИменаЗаголовков.ВГраница(), ФактическиеЗапросы.ВГраница()) Цикл
		Если СтрНайти(ФактическиеЗапросы[Номер], "/openid-connect/token") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Имя Из ИменаЗаголовковАвторизации() Цикл
			Если СтрНайти(Транспорт.ИменаЗаголовков[Номер], "," + Имя + ",") = 0 Тогда
				Р.Добавить("запис " + Название + ", транспорт воспроизведення: у запиті " + Формат(Номер + 1, "ЧГ=0") + " немає заголовка " + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Индекс = 0 По Мин(ОжидаемыеЗапросы.ВГраница(), ФактическиеЗапросы.ВГраница()) Цикл
		Сверить(Р, Название, 0, "запит " + Формат(Индекс + 1, "ЧГ=0"), ОжидаемыеЗапросы[Индекс], ФактическиеЗапросы[Индекс]);
	КонецЦикла;

	Сверить(Р, Название, 0, "число пауз", Ожидаемое["Паузы"].Количество(), Транспорт.Паузы.Количество());
	Для Индекс = 0 По Мин(Ожидаемое["Паузы"].ВГраница(), Транспорт.Паузы.ВГраница()) Цикл
		Сверить(Р, Название, 0, "пауза " + Формат(Индекс + 1, "ЧГ=0") + " (секунди)",
			Формат(Ожидаемое["Паузы"][Индекс]["Секунд"], "ЧГ=0"), Формат(Транспорт.Паузы[Индекс], "ЧГ=0"));
	КонецЦикла;

	Возврат Р;

КонецФункции

// Результат точки чтения = ожидаемые операции минус операции, которые отклонила платформа. Отклоненную платформа называет сама: рядок Ошибка в
// Результат.Диагностика с ПорядковыйНомер операции (СМП_ВыпискаБанка.ПроверитьВыписку). Каждая отсутствующая операция обязана иметь такой рядок,
// а такой рядок - отвечать отсутствующей операции. Чужие счета для ПУМБ отбирает конектор (рядок Предупреждение в эталоне), точка чтения их не отбирает.
Функция СравнитьРезультатТочкиЧтения(Название, Эталон, Результат)

	Р = Новый Массив;
	Ожидаемое = Эталон["expected"];
	Ожидаемые = Новый Соответствие;
	Для Каждого Операция Из Ожидаемое["Операции"] Цикл
		Ожидаемые[Операция["ПорядковыйНомер"]] = Истина;
	КонецЦикла;
	Отклоненные = Новый Соответствие;
	Для Каждого Строка Из Результат.Диагностика Цикл
		Если Строка.Уровень = "Ошибка" И Ожидаемые[Строка.ПорядковыйНомер] <> Неопределено Тогда
			Отклоненные[Строка.ПорядковыйНомер] = Истина;
		КонецЕсли;
	КонецЦикла;
	Есть = Новый Соответствие;
	Для Каждого Строка Из Результат.Операции Цикл
		Есть[Строка.ПорядковыйНомер] = Истина;
	КонецЦикла;

	Для Каждого Операция Из Ожидаемое["Операции"] Цикл
		Номер = Операция["ПорядковыйНомер"];
		Должна = Отклоненные[Номер] = Неопределено;
		Если Должна И Есть[Номер] = Неопределено Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле результат точки читання: операція зникла без рядка Ошибка платформи");
		ИначеЕсли Не Должна И Есть[Номер] <> Неопределено Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Номер, "ЧГ=0") + ", поле результат точки читання: відхилена платформою операція лишилась у результаті");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Номер Из Есть Цикл
		Если Ожидаемые[Номер.Ключ] = Неопределено Тогда
			Р.Добавить("запис " + Название + ", операція " + Формат(Номер.Ключ, "ЧГ=0") + ", поле результат точки читання: зайва операція, якої немає в еталоні");
		КонецЕсли;
	КонецЦикла;
	Возврат Р;

КонецФункции

// Имена заголовков, которые конектор обязан слать в каждом запросе данных (после аутентификации): Bearer-токен и X-Flow-ID банка VegaNet.
Функция ИменаЗаголовковАвторизации()

	Результат = Новый Массив;
	Результат.Добавить("authorization");
	Результат.Добавить("x-flow-id");
	Возврат Результат;

КонецФункции

// Т2: синтетические учетные данные, выданные банком значения и идентификаторы счетов не встречаются ни в одном тексте результата - ни в
// диагностике, ни в колонках операций, ни в конверте платформы.
Функция СекретыВТекстах(Название, Результат, ВыданныеСекреты)

	Р = Новый Массив;
	Секреты = Новый Массив;
	Для Каждого Значение Из СтрРазделить(ИдентификаторКлиентаСинтетический() + "," + СекретКлиентаСинтетический() + ","
		+ ЛогинСинтетический() + "," + ПарольСинтетический(), ",") Цикл
		Секреты.Добавить(Новый Структура("Значение, ЭтоЧисло", Значение, Ложь));
	КонецЦикла;
	Для Каждого Секрет Из ВыданныеСекреты Цикл
		Секреты.Добавить(Секрет);
	КонецЦикла;

	Для Каждого Таблица Из СтрРазделить("Выписка.Диагностика,Выписка.Операции,Диагностика,Операции", ",") Цикл
		Если СтрНачинаетсяС(Таблица, "Выписка.") Тогда
			Данные = Результат.Выписка[Сред(Таблица, 9)];
		Иначе
			Данные = Результат[Таблица];
		КонецЕсли;
		Для Каждого Строка Из Данные Цикл
			Для Каждого Колонка Из Данные.Колонки Цикл
				Значение = Строка[Колонка.Имя];
				Если ТипЗнч(Значение) <> Тип("Строка") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого Секрет Из Секреты Цикл
					Если ТекстСодержитСекрет(Значение, Секрет) Тогда
						Р.Добавить("запис " + Название + ", поле " + Таблица + "." + Колонка.Имя + ": облікові дані, видане банком значення чи accountId у тексті результату");
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;

КонецФункции

// Число (accountId) ищется как отдельное число: соседние цифры, точка и запятая делают вхождение частью другого числа (суммы, даты).
Функция ТекстСодержитСекрет(Текст, Секрет)

	Если Не Секрет.ЭтоЧисло Тогда
		Возврат СтрНайти(Текст, Секрет.Значение) > 0;
	КонецЕсли;

	Длина = СтрДлина(Секрет.Значение);
	Начало = 1;
	Пока Истина Цикл
		Позиция = СтрНайти(Текст, Секрет.Значение, НаправлениеПоиска.СНачала, Начало);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Слева = ?(Позиция = 1, "", Сред(Текст, Позиция - 1, 1));
		Справа = Сред(Текст, Позиция + Длина, 1);
		Если (Слева = "" Или СтрНайти("0123456789.,", Слева) = 0) И (Справа = "" Или СтрНайти("0123456789.,", Справа) = 0) Тогда
			Возврат Истина;
		КонецЕсли;
		Начало = Позиция + 1;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область Помощники

// Конверт, собранный из эталона: то, что вернул бы идеальный конектор.
Функция ВыпискаИзЭталона(Эталон)

	Ожидаемое = Эталон["expected"];
	Выписка = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыпискаБанка.НоваяВыписка");
	Выписка.ЧтениеПолное = Ожидаемое["ЧтениеПолное"];
	Выписка.ГраницаДоверия = ДатаИзISO(Ожидаемое["ГраницаДоверия"]);
	Выписка.КлассОтказа = Ожидаемое["КлассОтказа"];

	Для Каждого Ожидаемая Из Ожидаемое["Операции"] Цикл
		Строка = Выписка.Операции.Добавить();
		Для Каждого Колонка Из Выписка.Операции.Колонки Цикл
			Имя = Колонка.Имя;
			Если Имя = "СырыеДанные" Тогда
				Строка[Имя] = "{}";
			ИначеЕсли Имя = "Сумма" Тогда
				Строка[Имя] = Число(Ожидаемая[Имя]);
			ИначеЕсли Имя = "ДатаОперации" Или Имя = "ДатаДокумента" Тогда
				Строка[Имя] = ДатаИзISO(Ожидаемая[Имя]);
			Иначе
				Строка[Имя] = Ожидаемая[Имя];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Ожидаемая Из Ожидаемое["Диагностика"] Цикл
		Строка = Выписка.Диагностика.Добавить();
		Строка.Уровень = Ожидаемая["Уровень"];
		Строка.ПорядковыйНомер = Ожидаемая["ПорядковыйНомер"];
		Строка.Текст = "Суть " + Ожидаемая["Суть"] + ": " + СтрСоединить(ФактыТекстом(Ожидаемая["Факты"]), ", ");
	КонецЦикла;

	Возврат Выписка;

КонецФункции

Функция ДатаВISO(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция ДатаИзISO(Текст)

	Возврат Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "-", ""), "T", ""), ":", ""));

КонецФункции

Процедура ДобавитьВсе(Приемник, Источник)

	Для Каждого Элемент Из Источник Цикл
		Приемник.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

// Расхождения одним текстом, не больше 25 строк (отчет YaXUnit должен остаться читаемым).
Функция ТекстРасхождений(Расхождения)

	Строки = Новый Массив;
	Для Индекс = 0 По Мин(Расхождения.ВГраница(), 24) Цикл
		Строки.Добавить(Расхождения[Индекс]);
	КонецЦикла;
	Если Расхождения.Количество() > 25 Тогда
		Строки.Добавить("... и еще " + Формат(Расхождения.Количество() - 25, "ЧГ=0"));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

#КонецОбласти
