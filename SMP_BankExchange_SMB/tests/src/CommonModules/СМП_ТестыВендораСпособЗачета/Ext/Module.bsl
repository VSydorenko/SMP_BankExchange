// Характеризационные тесты способа зачета (Авто/Вручную) в банковских документах УНФ: цепочка значений по умолчанию,
// ПередЗаписью и проведение строки "Авто" при наличии долга контрагента.
//
// Мера: спека docs/superpowers/specs/2026-10-12-smb-import-platform-design.md, D14 (цепочка договор -> контрагент -> глобальное)
// и D34 (способ зачета в расшифровке платежа); исследование temp/research/2026-10-12-api-period/12-offset-method.md.
// Назначение: стать красными, если обновление УНФ изменит поведение, от которого зависит этап 4. Красный на первом
// прогоне - не поломка, а ИЗМЕРЕНИЕ: расхождение с тезой записывается как находка, ожидание заменяется на измеренное с
// комментарием "ВИМІРЯНО <дата>: суперечить спеці D34/D14 - ..." (или "припущення не підтвердилось" для не-спеки).
//
// Условие измерения: ВалютаУчета = USD, договоры и банковские счета организаций - в национальной валюте (UAH);
// СпособРазнесенияОплатыПоУмолчанию (константа) = Автоматически (значение перечисления Авто) - только читается;
// ВестиУчетОплатыПоСчетам = Нет по умолчанию, флаги контрагента в матрице задаются явно.
//
// Правила - docs/architecture/testing.md. Каждый тест с данными работает в СВОЕЙ транзакции (.ВТранзакции()).
// Константы и курсы тесты только читают. ВариантЗаполненияРасшифровки = Автоматически не ставится никогда (D34).
//
// Случай 4 брифа (цепочка для статьи ДДС) тестом не покрыт: по поиску в cf/src вендорской функции-цепочки нет, это
// находка для этапа 3 (журнал, таблица находок задачи 5).
//
// Уровни значений (УровеньЗначения): "Пусто" - пустое значение; "Константа" - то же, что у константы
// СпособРазнесенияОплатыПоУмолчанию; "Другой" - противоположное значению константы. Так три уровня различимы,
// а ожидаемое выводится из входов и константы, прочитанной из базы, а не из значений внутри теста.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Цепочка способа разноса оплаты (D14)")
			.ДобавитьСерверныйТест("СпособРазноса_ПоУровням").ВТранзакции()
				.СПараметрами("договор имеет значение, учет по договорам включен", "Другой", "Константа", Истина, "Другой")
				.СПараметрами("учет по договорам выключен: значение контрагента", "Константа", "Другой", Ложь, "Другой")
				.СПараметрами("договор пуст: значение контрагента", "Пусто", "Другой", Истина, "Другой")
				.СПараметрами("учет выключен, у контрагента пусто: константа, договор игнорируется", "Другой", "Пусто", Ложь, "Константа")
				.СПараметрами("договор и контрагент пусты: константа", "Пусто", "Пусто", Истина, "Константа")
				.СПараметрами("договор и контрагент пусты, учет выключен: константа", "Пусто", "Пусто", Ложь, "Константа")
			.ДобавитьСерверныйТест("СпособРазноса_ПустыеСсылкиДаютКонстанту")
		.ДобавитьТестовыйНабор("ПередЗаписью банковского документа: способ зачета в строке (D34)")
			.ДобавитьСерверныйТест("ПередЗаписью_ПустойСпособСтановитсяВручную").ВТранзакции()
				.СПараметрами("поступление, вид взаиморасчетов", "ПНС", Ложь)
				.СПараметрами("расход, вид взаиморасчетов", "РС", Ложь)
				.СПараметрами("поступление, вид не взаиморасчетов", "ПНС", Истина)
				.СПараметрами("расход, вид не взаиморасчетов", "РС", Истина)
			.ДобавитьСерверныйТест("ПередЗаписью_АвтоДаетАвансИОчищаетЗаказ").ВТранзакции()
				.СПараметрами("поступление, учет по документам включен", "ПНС", Истина)
				.СПараметрами("поступление, учет по документам выключен", "ПНС", Ложь)
				.СПараметрами("расход, учет по документам включен", "РС", Истина)
				.СПараметрами("расход, учет по документам выключен", "РС", Ложь)
			.ДобавитьСерверныйТест("ПередЗаписью_АвтоВНевзаиморасчетномВидеНичегоНеМеняет").ВТранзакции()
				.СПараметрами("поступление", "ПНС")
				.СПараметрами("расход", "РС")
			.ДобавитьСерверныйТест("ПередЗаписью_ВручнуюСЗаказомЗаказНеОчищается").ВТранзакции()
				.СПараметрами("поступление, учет по документам включен", "ПНС", Истина)
				.СПараметрами("поступление, учет по документам выключен", "ПНС", Ложь)
				.СПараметрами("расход, учет по документам включен", "РС", Истина)
				.СПараметрами("расход, учет по документам выключен", "РС", Ложь)
			.ДобавитьСерверныйТест("ПередЗаписью_ВручнуюБезДокументаАвансЗависитОтУчетаПоДокументам").ВТранзакции()
				.СПараметрами("поступление, учет по документам включен", "ПНС", Истина, Истина)
				.СПараметрами("поступление, учет по документам выключен", "ПНС", Ложь, Ложь)
				.СПараметрами("расход, учет по документам включен", "РС", Истина, Истина)
				.СПараметрами("расход, учет по документам выключен", "РС", Ложь, Ложь)
		.ДобавитьТестовыйНабор("Проведение строки Авто при долге контрагента (D34)")
			.ДобавитьСерверныйТест("Проведение_АвтоНаВсюСуммуРаспределяетсяПоДолгу").ВТранзакции()
				.СПараметрами("оплата равна долгу", 1000)
				.СПараметрами("оплата меньше долга", 400)
				.СПараметрами("оплата больше долга", 1500)
			.ДобавитьСерверныйТест("Проведение_ВручнуюБезДокументаДолгНеПогашаетсяВесьПлатежАванс").ВТранзакции()
		// ПОСЛЕДНИМ в модуле и БЕЗ транзакции: итог всех тестов с данными (та же функция подсчета, что в СМП_ТестыФикстур).
		.ДобавитьТестовыйНабор("Сторож остатков: итог")
			.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область ЦепочкаСпособаРазноса

// Теза D14: СпособРазнесенияОплатыДляДоговора(Договор, Контрагент): договор (если контрагент ведет расчеты по договорам и
// у договора значение заполнено) -> контрагент -> константа СпособРазнесенияОплатыПоУмолчанию. Источник тезы: спека D14/D34
// и исследование 12. Все три уровня различимы (см. шапку: "Другой" противоположно константе); предусловия - значения,
// прочитанные из базы после записи, а не принятые на веру.
Процедура СпособРазноса_ПоУровням(Имя, УровеньДоговора, УровеньКонтрагента, ПоДоговорам, УровеньОжидаемого) Экспорт

	Константа = ЗначениеКонстантыСпособа();
	ЗначениеДоговора = ЗначениеУровня(УровеньДоговора, Константа);
	ЗначениеКонтрагента = ЗначениеУровня(УровеньКонтрагента, Константа);
	Ожидаемое = ЗначениеУровня(УровеньОжидаемого, Константа);
	Основа = НоваяОснова("ПНС", Новый Структура("СпособДоговора, СпособКонтрагента, ПоДоговорам", ЗначениеДоговора, ЗначениеКонтрагента, ПоДоговорам));

	// Предусловия: фикстура действительно хранит то, что задумано (иначе платформа могла подставить значение сама).
	ПроверитьПредусловиеУровней(Основа, ЗначениеДоговора, ЗначениеКонтрагента, ПоДоговорам, Имя);
	Если УровеньОжидаемого = "Константа" Тогда
		ПроверитьКонстантуАвто(Константа, Имя);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Ожидаемое), Имя + ": предусловие - ожидаемое значение заполнено").ЭтоИстина();

	Результат = РасчетыРаботаСФормамиВызовСервера.СпособРазнесенияОплатыДляДоговора(Основа.Договор, Основа.Контрагент);

	ЮТест.ОжидаетЧто(Результат, Имя + ": способ разноса оплаты по цепочке договор -> контрагент -> константа").Равно(Ожидаемое);

КонецПроцедуры

// Теза D34 (последняя строка таблицы): контрагент или договор еще не существуют (создает импорт) -> константа. Пустые
// ссылки на вход, ничего не пишется (транзакция не нужна).
Процедура СпособРазноса_ПустыеСсылкиДаютКонстанту() Экспорт

	Константа = ЗначениеКонстантыСпособа();
	ПроверитьКонстантуАвто(Константа, "Пустые ссылки");

	Результат = РасчетыРаботаСФормамиВызовСервера.СпособРазнесенияОплатыДляДоговора(
		Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), Справочники.Контрагенты.ПустаяСсылка());

	ЮТест.ОжидаетЧто(Результат, "Пустые договор и контрагент: способ = константе").Равно(Константа);

КонецПроцедуры

#КонецОбласти

#Область ПередЗаписью

// Теза (исследование 12 "ПередЗаписью: порожній -> Вручную"): порожній СпособЗачета строки при записи становится
// Вручную. Для взаиморасчетных видов - теза исследования; для видов вне списка (ПНС/РС "Прочее") и слово "безусловно" -
// ПРИПУЩЕНИЕ ИСПОЛНИТЕЛЯ (из кода вендора: проверка пустого способа стоит до условия вида операции); спеке D34 (строка 1:
// такие виды - вручную) не противоречит.
Процедура ПередЗаписью_ПустойСпособСтановитсяВручную(Имя, Вид, НеВзаиморасчетный) Экспорт

	Основа = НоваяОснова(Вид);
	Документ = НовыйБанковскийДокумент(Вид, Основа, НеВзаиморасчетный);
	Строка = ДобавитьСтроку(Документ, Вид, Основа);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СпособЗачета), Имя + ": предусловие - способ зачета пуст до записи").ЭтоЛожь();

	Объект = ЗаписатьИПеречитать(Документ);

	Ожидание = Новый Структура("СпособЗачета", ПредопределенноеЗначение("Перечисление.СпособыЗачетаИРаспределенияПлатежей.Вручную"));
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

// Теза (спека D34 / исследование 12 "Авто -> аванс, Заказ очищается"): Авто -> строка становится авансом
// (ПризнакАванса = Истина), Заказ очищается. Изоляция фактора: кейс с ПоДокументам = Ложь отличается от кейса
// "Вручную без документа" (ПризнакАванса зависит от учета по документам) ровно способом - при Ложь аванс может дать
// только Авто. Предусловия: до записи ПризнакАванса = Ложь и Заказ заполнен (иначе "стало авансом" и "очищен" вакуумны).
Процедура ПередЗаписью_АвтоДаетАвансИОчищаетЗаказ(Имя, Вид, ПоДокументам) Экспорт

	Основа = НоваяОснова(Вид, Новый Структура("ПоДокументам", ПоДокументам));
	Заказ = НовыйЗаказ(Вид, Основа, 1000);
	Документ = НовыйБанковскийДокумент(Вид, Основа, Ложь);
	Строка = ДобавитьСтроку(Документ, Вид, Основа);
	Строка.СпособЗачета = СпособЗачета("Авто");
	Строка.Заказ = Заказ;
	Строка.ПризнакАванса = Ложь;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Заказ), Имя + ": предусловие - заказ в строке заполнен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строка.ПризнакАванса, Имя + ": предусловие - ПризнакАванса = Ложь до записи").ЭтоЛожь();

	Объект = ЗаписатьИПеречитать(Документ);

	Ожидание = Новый Структура;
	Ожидание.Вставить("СпособЗачета", СпособЗачета("Авто"));
	Ожидание.Вставить("ПризнакАванса", Истина);
	Ожидание.Вставить("Заказ", Неопределено);
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

// ПРИПУЩЕНИЕ ИСПОЛНИТЕЛЯ (код вендора ЗаполнятьРеквизитыВзаиморасчетов; не теза спеки): для вида операции вне списка
// взаиморасчетов Авто НЕ делает строку авансом, НЕ очищает заказ и сам способ не меняет. Спека D34, строка 1 таблицы
// ("такие виды - вручную") описывает то, что СТАВИТ платформа, а не то, что вендор нормализует: вендор Авто в таких
// видах в Вручную не превращает - проверяется утверждением "способ остался Авто".
Процедура ПередЗаписью_АвтоВНевзаиморасчетномВидеНичегоНеМеняет(Имя, Вид) Экспорт

	Основа = НоваяОснова(Вид);
	Заказ = НовыйЗаказ(Вид, Основа, 1000);
	Документ = НовыйБанковскийДокумент(Вид, Основа, Истина);
	Строка = ДобавитьСтроку(Документ, Вид, Основа);
	Строка.СпособЗачета = СпособЗачета("Авто");
	Строка.Заказ = Заказ;
	Строка.ПризнакАванса = Ложь;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Заказ), Имя + ": предусловие - заказ в строке заполнен").ЭтоИстина();

	Объект = ЗаписатьИПеречитать(Документ);

	Ожидание = Новый Структура;
	Ожидание.Вставить("СпособЗачета", СпособЗачета("Авто"));
	Ожидание.Вставить("ПризнакАванса", Ложь);
	Ожидание.Вставить("Заказ", Заказ);
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

// ПРИПУЩЕНИЕ ИСПОЛНИТЕЛЯ (код вендора; не теза спеки): Заказ очищается только способом Авто. Пара к
// АвтоДаетАвансИОчищаетЗаказ; кейсы отличаются от пары ровно способом (тот же ПоДокументам, тот же заказ): Вручную с
// заказом оставляет Заказ; ПризнакАванса определяется только учетом по документам (Вручную без документа).
Процедура ПередЗаписью_ВручнуюСЗаказомЗаказНеОчищается(Имя, Вид, ПоДокументам) Экспорт

	Основа = НоваяОснова(Вид, Новый Структура("ПоДокументам", ПоДокументам));
	Заказ = НовыйЗаказ(Вид, Основа, 1000);
	Документ = НовыйБанковскийДокумент(Вид, Основа, Ложь);
	Строка = ДобавитьСтроку(Документ, Вид, Основа);
	Строка.СпособЗачета = СпособЗачета("Вручную");
	Строка.Заказ = Заказ;
	Строка.ПризнакАванса = Ложь;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Заказ), Имя + ": предусловие - заказ в строке заполнен").ЭтоИстина();
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Основа.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Имя + ": предусловие - флаг учета по документам у контрагента как задан").Равно(ПоДокументам);

	Объект = ЗаписатьИПеречитать(Документ);

	Ожидание = Новый Структура;
	Ожидание.Вставить("СпособЗачета", СпособЗачета("Вручную"));
	Ожидание.Вставить("ПризнакАванса", ПоДокументам);
	Ожидание.Вставить("Заказ", Заказ);
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

// Теза (исследование 12): Вручную без документа расчетов при ВестиРасчетыПоДокументам -> строка становится авансом.
// ПРИПУЩЕНИЕ ИСПОЛНИТЕЛЯ (код вендора): без признака у контрагента ПризнакАванса не меняется (слово "лишь" в тезе). Предусловия: ПризнакАванса = Ложь до записи, флаг контрагента прочитан.
Процедура ПередЗаписью_ВручнуюБезДокументаАвансЗависитОтУчетаПоДокументам(Имя, Вид, ПоДокументам, ОжидаемыйПризнак) Экспорт

	Основа = НоваяОснова(Вид, Новый Структура("ПоДокументам", ПоДокументам));
	Документ = НовыйБанковскийДокумент(Вид, Основа, Ложь);
	Строка = ДобавитьСтроку(Документ, Вид, Основа);
	Строка.СпособЗачета = СпособЗачета("Вручную");
	Строка.ПризнакАванса = Ложь;
	ЮТест.ОжидаетЧто(РеквизитыСсылки(Основа.Контрагент, "ВестиРасчетыПоДокументам").ВестиРасчетыПоДокументам,
		Имя + ": предусловие - флаг учета по документам у контрагента как задан").Равно(ПоДокументам);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Документ), Имя + ": предусловие - документа расчетов в строке нет").ЭтоЛожь();

	Объект = ЗаписатьИПеречитать(Документ);

	Ожидание = Новый Структура;
	Ожидание.Вставить("СпособЗачета", СпособЗачета("Вручную"));
	Ожидание.Вставить("ПризнакАванса", ОжидаемыйПризнак);
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

КонецПроцедуры

#КонецОбласти

#Область Проведение

// Теза D34: "при Авто один рядок на всю суму, розподіляє вендор під час проведення". Борг покупателя создан проведенным
// актом выполненных работ (1000), предусловие - остаток долга 1000 в РасчетыСПокупателями (иначе "вендор не погашает долг" вакуумно).
// Измеряется: строка расшифровки после проведения (одна, способ Авто, суммы, документ расчетов пуст) и движения регистра по
// регистратору - сколько погашает долг (по акту) и сколько уходит авансом. Ожидание (из чтения кода вендора, ГИПОТЕЗА):
// долг гасится на Мин(оплата, долг), остаток оплаты - авансом.
Процедура Проведение_АвтоНаВсюСуммуРаспределяетсяПоДолгу(Имя, СуммаОплаты) Экспорт

	ВеличинаДолга = 1000;
	Основа = НоваяОснова();
	Акт = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, ВеличинаДолга);
	ЮТест.ОжидаетЧто(ОстатокДолга(Основа), Имя + ": предусловие - долг покупателя в РасчетыСПокупателями").Равно(ВеличинаДолга);

	Документ = НовыйБанковскийДокумент("ПНС", Основа, Ложь);
	Строка = ДобавитьСтроку(Документ, "ПНС", Основа, СуммаОплаты);
	Строка.СпособЗачета = СпособЗачета("Авто");
	ЮТест.ОжидаетЧто(Документ.ВариантЗаполненияРасшифровки, Имя + ": предусловие - вариант заполнения расшифровки не Автоматически")
		.НеРавно(ПредопределенноеЗначение("Перечисление.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически"));

	ПровестиДокумент(Документ);

	Объект = Документ.Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(Объект.Проведен, Имя + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Имя + ": после проведения строк расшифровки").Равно(1);
	Ожидание = Новый Структура;
	Ожидание.Вставить("СпособЗачета", СпособЗачета("Авто"));
	Ожидание.Вставить("Договор", Основа.Договор);
	Ожидание.Вставить("Документ", Неопределено);
	Ожидание.Вставить("СуммаПлатежа", СуммаОплаты);
	Ожидание.Вставить("СуммаРасчетов", СуммаОплаты);
	ПроверитьСтроку(Объект.РасшифровкаПлатежа[0], Ожидание, Имя);

	ПогашеноДолга = Мин(СуммаОплаты, ВеличинаДолга);
	Аванс = СуммаОплаты - ПогашеноДолга;
	ОжидаемыеДвижения = Новый Соответствие;
	ОжидаемыеДвижения.Вставить("Долг|Расход|по акту", ПогашеноДолга);
	Если Аванс > 0 Тогда
		// Дефект теста, исправленный в B0 (прогон на e9871b9): аванс покупателя в этом регистре - РАСХОД типа Аванс, не приход.
		ОжидаемыеДвижения.Вставить("Аванс|Расход|без акта", Аванс);
	КонецЕсли;
	ПроверитьДвижения(Документ.Ссылка, Акт, ОжидаемыеДвижения, Имя);

КонецПроцедуры

// Пара к предыдущему: тот же долг и та же сумма, но СпособЗачета = Вручную без документа расчетов -> долг НЕ гасится,
// вся оплата уходит авансом. Доказывает, что погашение долга в предыдущем тесте - следствие способа Авто, а не фона.
Процедура Проведение_ВручнуюБезДокументаДолгНеПогашаетсяВесьПлатежАванс() Экспорт

	ВеличинаДолга = 1000;
	Основа = НоваяОснова();
	Акт = СМП_ТестыДанныеУНФ.НовыйАктВыполненныхРабот(Основа.Контрагент, Основа.Договор, ВеличинаДолга);
	ЮТест.ОжидаетЧто(ОстатокДолга(Основа), "Предусловие - долг покупателя в РасчетыСПокупателями").Равно(ВеличинаДолга);

	Документ = НовыйБанковскийДокумент("ПНС", Основа, Ложь);
	Строка = ДобавитьСтроку(Документ, "ПНС", Основа, ВеличинаДолга);
	Строка.СпособЗачета = СпособЗачета("Вручную");

	ПровестиДокумент(Документ);

	ОжидаемыеДвижения = Новый Соответствие;
	ОжидаемыеДвижения.Вставить("Аванс|Расход|без акта", ВеличинаДолга);
	ПроверитьДвижения(Документ.Ссылка, Акт, ОжидаемыеДвижения, "Вручную без документа");

КонецПроцедуры

#КонецОбласти

#Область СторожОстатков

// БЕЗ транзакции, ПОСЛЕДНИМ. Тот же подсчет (СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам), что в
// СМП_ТестыФикстур; ждет нуль в каждом типе. Красный здесь - СТОП: остатки руками не удалять, сообщить владельцу.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция СпособЗачета(Имя)

	Возврат ПредопределенноеЗначение("Перечисление.СпособыЗачетаИРаспределенияПлатежей." + Имя);

КонецФункции

Функция ЗначениеКонстантыСпособа()

	Возврат Константы.СпособРазнесенияОплатыПоУмолчанию.Получить();

КонецФункции

// Значение уровня: "Пусто" - пустое; "Константа" - значение константы; "Другой" - противоположное константе.
Функция ЗначениеУровня(Уровень, Константа)

	Если Уровень = "Пусто" Тогда
		Возврат Перечисления.СпособыЗачетаИРаспределенияПлатежей.ПустаяСсылка();
	ИначеЕсли Уровень = "Константа" Тогда
		Возврат Константа;
	ИначеЕсли Уровень = "Другой" Тогда
		Возврат ?(Константа = СпособЗачета("Авто"), СпособЗачета("Вручную"), СпособЗачета("Авто"));
	КонецЕсли;

	ВызватьИсключение "СМП_ТестыВендораСпособЗачета: неизвестный уровень " + Уровень;

КонецФункции

// Предусловие среды: константа заполнена и равна Авто (known-state.md). Иначе уровень "константа" не отличить от
// запасного значения Вручную, и тест цепочки стал бы вакуумным.
Процедура ПроверитьКонстантуАвто(Константа, Имя)

	ЮТест.ОжидаетЧто(Константа, Имя + ": предусловие - константа СпособРазнесенияОплатыПоУмолчанию = Авто (Автоматически)")
		.Равно(СпособЗачета("Авто"));

КонецПроцедуры

// Контрагент и договор для банковских документов. Параметры (необязательные ключи структуры): СпособДоговора,
// СпособКонтрагента (способ разноса оплаты), ПоДоговорам (по умолчанию Истина), ПоДокументам (по умолчанию Истина).
// Контрагент создается с учетом по договорам (иначе построитель не создает договор), затем, если нужно, признак
// ВестиРасчетыПоДоговорам выключается записью контрагента (в транзакции теста).
Функция НоваяОснова(Вид = "ПНС", Параметры = Неопределено)

	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	ПоДоговорам = ?(Параметры.Свойство("ПоДоговорам"), Параметры.ПоДоговорам, Истина);
	ПоДокументам = ?(Параметры.Свойство("ПоДокументам"), Параметры.ПоДокументам, Истина);

	Настройки = Новый Структура;
	Настройки.Вставить("ВестиРасчетыПоДоговорам", Истина);
	Настройки.Вставить("ВестиРасчетыПоДокументам", ПоДокументам);
	Настройки.Вставить("ВестиРасчетыПоЗаказам", Истина);
	Настройки.Вставить("ВестиУчетОплатыПоСчетам", Ложь);
	Если Параметры.Свойство("СпособКонтрагента") И ЗначениеЗаполнено(Параметры.СпособКонтрагента) Тогда
		Настройки.Вставить("СпособРазнесенияОплатыПоУмолчанию", Параметры.СпособКонтрагента);
	КонецЕсли;
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Настройки);

	НастройкиДоговора = Новый Структура("ВидДоговора",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(ЭтоИсходящий(Вид), "СПоставщиком", "СПокупателем")));
	Если Параметры.Свойство("СпособДоговора") И ЗначениеЗаполнено(Параметры.СпособДоговора) Тогда
		НастройкиДоговора.Вставить("СпособРазнесенияОплатыПоУмолчанию", Параметры.СпособДоговора);
	КонецЕсли;
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, НастройкиДоговора);

	// Новый контрагент сам получает способ разноса из константы (измерено на прогоне e9871b9: "Пусто" через построитель
	// недостижимо), поэтому пустое значение уровня контрагента выставляется явной записью объекта.
	ПустойСпособКонтрагента = Параметры.Свойство("СпособКонтрагента") И Не ЗначениеЗаполнено(Параметры.СпособКонтрагента);
	Если Не ПоДоговорам Или ПустойСпособКонтрагента Тогда
		ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		Если Не ПоДоговорам Тогда
			ОбъектКонтрагента.ВестиРасчетыПоДоговорам = Ложь;
		КонецЕсли;
		Если ПустойСпособКонтрагента Тогда
			ОбъектКонтрагента.СпособРазнесенияОплатыПоУмолчанию = Перечисления.СпособыЗачетаИРаспределенияПлатежей.ПустаяСсылка();
		КонецЕсли;
		ОбъектКонтрагента.Записать();
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор", Контрагент, Договор);

КонецФункции

// Предусловия цепочки: после записи в базе лежат ровно те значения, что заданы (платформа могла подставить своё).
Процедура ПроверитьПредусловиеУровней(Основа, ЗначениеДоговора, ЗначениеКонтрагента, ПоДоговорам, Имя)

	Расхождения = "";
	СпособДоговора = РеквизитыСсылки(Основа.Договор, "СпособРазнесенияОплатыПоУмолчанию").СпособРазнесенияОплатыПоУмолчанию;
	Если СпособДоговора <> ЗначениеДоговора Тогда
		Расхождения = Расхождения + Символы.ПС + "  договор: задано `" + Строка(ЗначениеДоговора) + "`, в базе `" + Строка(СпособДоговора) + "`";
	КонецЕсли;
	РеквизитыКонтрагента = РеквизитыСсылки(Основа.Контрагент, "СпособРазнесенияОплатыПоУмолчанию, ВестиРасчетыПоДоговорам");
	Если РеквизитыКонтрагента.СпособРазнесенияОплатыПоУмолчанию <> ЗначениеКонтрагента Тогда
		Расхождения = Расхождения + Символы.ПС + "  контрагент: задано `" + Строка(ЗначениеКонтрагента) + "`, в базе `"
			+ Строка(РеквизитыКонтрагента.СпособРазнесенияОплатыПоУмолчанию) + "`";
	КонецЕсли;
	Если РеквизитыКонтрагента.ВестиРасчетыПоДоговорам <> ПоДоговорам Тогда
		Расхождения = Расхождения + Символы.ПС + "  ВестиРасчетыПоДоговорам: задано `" + Строка(ПоДоговорам) + "`, в базе `"
			+ Строка(РеквизитыКонтрагента.ВестиРасчетыПоДоговорам) + "`";
	КонецЕсли;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": предусловие - фикстура хранит заданные значения уровней").Равно("");

КонецПроцедуры

Функция ЭтоИсходящий(Вид)

	Возврат Вид = "РС";

КонецФункции

Функция НовыйЗаказ(Вид, Основа, Сумма)

	Если ЭтоИсходящий(Вид) Тогда
		Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Основа.Контрагент, Основа.Договор, Сумма);
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Основа.Контрагент, Основа.Договор, Сумма);

КонецФункции

// Банковский документ без строк (ПНС "От покупателя" / РС "Поставщику"; при НеВзаиморасчетный - вид "Прочее"). Шапка
// заполняется явно (метод "по основанию" здесь не вызывается): организация и счет по правилу фикстуры, валюта денежных
// средств - национальная.
Функция НовыйБанковскийДокумент(Вид, Основа, НеВзаиморасчетный)

	Если ЭтоИсходящий(Вид) Тогда
		Документ = Документы.РасходСоСчета.СоздатьДокумент();
		Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета."
			+ ?(НеВзаиморасчетный, "Прочее", "Поставщику"));
		ИмяСтатьи = ?(НеВзаиморасчетный, "Прочее", "ОплатаПоставщикам");
	Иначе
		Документ = Документы.ПоступлениеНаСчет.СоздатьДокумент();
		Документ.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет."
			+ ?(НеВзаиморасчетный, "Прочее", "ОтПокупателя"));
		ИмяСтатьи = ?(НеВзаиморасчетный, "Прочее", "ОплатаОтПокупателей");
	КонецЕсли;

	Национальная = Константы.НациональнаяВалюта.Получить();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Организация = СМП_ТестыДанныеУНФ.Организация();
	Документ.БанковскийСчет = СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации();
	Документ.ВалютаДенежныхСредств = Национальная;
	Документ.Контрагент = Основа.Контрагент;
	Документ.Статья = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств." + ИмяСтатьи);
	Документ.Комментарий = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "банк_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Курс = КурсВалюты(Национальная, Документ.Дата);
	ЗаполнитьЗначенияСвойств(Документ, Новый Структура("Курс, Кратность, НалогообложениеНДС",
		?(Курс.Курс = 0, 1, Курс.Курс), ?(Курс.Кратность = 0, 1, Курс.Кратность),
		ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.НеОблагаетсяНДС")));

	Возврат Документ;

КонецФункции

// Добавляет одну строку расшифровки (договор основы, сумма в национальной валюте договора). СпособЗачета не ставится.
Функция ДобавитьСтроку(Документ, Вид, Основа, Сумма = 1000)

	Курс = КурсВалюты(Константы.НациональнаяВалюта.Получить(), Документ.Дата);
	Строка = Документ.РасшифровкаПлатежа.Добавить();
	Строка.Договор = Основа.Договор;
	Строка.СуммаПлатежа = Сумма;
	Строка.СуммаРасчетов = Сумма;
	Строка.Курс = ?(Курс.Курс = 0, 1, Курс.Курс);
	Строка.Кратность = ?(Курс.Кратность = 0, 1, Курс.Кратность);
	Строка.СтавкаНДС = СтавкаНДСБезНалога();
	Строка.СуммаНДС = 0;
	Документ.СуммаДокумента = Сумма;

	Возврат Строка;

КонецФункции

// Запись БЕЗ проведения (в транзакции теста) и повторное чтение объекта из базы: утверждается то, что сохранено.
Функция ЗаписатьИПеречитать(Документ)

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ВызватьИсключение "СМП_ТестыВендораСпособЗачета: документ не записан: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			+ СообщенияПользователю();
	КонецПопытки;

	Возврат Документ.Ссылка.ПолучитьОбъект();

КонецФункции

Процедура ПровестиДокумент(Документ)

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ВызватьИсключение "СМП_ТестыВендораСпособЗачета: документ не проведен: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			+ СообщенияПользователю();
	КонецПопытки;

КонецПроцедуры

Функция СообщенияПользователю()

	Текст = "";
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = Текст + Символы.ПС + "  - " + Сообщение.Текст;
	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция КурсВалюты(Валюта, Дата)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ К.Курс КАК Курс, К.Кратность КАК Кратность
		|ИЗ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК К");
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Результат = Новый Структура("Курс, Кратность", 0, 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СтавкаНДСБезНалога()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ Справочник.СтавкиНДС КАК С ГДЕ НЕ С.ПометкаУдаления И С.НеОблагается УПОРЯДОЧИТЬ ПО С.Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "СМП_ТестыВендораСпособЗачета: нет ставки НДС 'не облагается'";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Читает реквизиты ссылки запросом (имена через запятую); результат - структура с теми же ключами.
Функция РеквизитыСсылки(Ссылка, Реквизиты)

	Результат = Новый Структура(Реквизиты);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого Элемент Из Результат Цикл
		Поля.Добавить("Т." + Элемент.Ключ + " КАК " + Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + "
		|ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т
		|ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Остаток ДОЛГА покупателя по договору основы в РасчетыСПокупателями (в валюте договора). Только читает.
Функция ОстатокДолга(Основа)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаВалОстаток), 0) КАК Сумма
		|ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, Контрагент = &Контрагент И Договор = &Договор И ТипРасчетов = &Долг) КАК Р");
	Запрос.УстановитьПараметр("Контрагент", Основа.Контрагент);
	Запрос.УстановитьПараметр("Договор", Основа.Договор);
	Запрос.УстановитьПараметр("Долг", ПредопределенноеЗначение("Перечисление.ТипыРасчетов.Долг"));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

// Помощник-порівнювач: колонки строки расшифровки против ожидания (структура). Неопределено = колонка пуста. Все
// расхождения копятся и утверждаются разом: первый провал не должен прятать остальные колонки (это измерение).
Процедура ПроверитьСтроку(СтрокаТЧ, Ожидание, Имя)

	Расхождения = "";
	Для Каждого Элемент Из Ожидание Цикл
		Факт = СтрокаТЧ[Элемент.Ключ];
		Если Элемент.Значение = Неопределено Тогда
			Совпало = Не ЗначениеЗаполнено(Факт);
		Иначе
			Совпало = (Факт = Элемент.Значение);
		КонецЕсли;
		Если Не Совпало Тогда
			Расхождения = Расхождения + Символы.ПС + "  колонка " + Элемент.Ключ + ": ожидали `"
				+ ?(Элемент.Значение = Неопределено, "<пусто>", Строка(Элемент.Значение)) + "`, факт `"
				+ ?(ЗначениеЗаполнено(Факт) Или ТипЗнч(Факт) = Тип("Булево") Или ТипЗнч(Факт) = Тип("Число"), Строка(Факт), "<пусто>") + "`";
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": колонки строки расшифровки как ожидалось").Равно("");

КонецПроцедуры

// Помощник-порівнювач: движения РасчетыСПокупателями регистратора, свернутые по ключу "Тип|Вид|по акту/без акта"
// (сумма в валюте договора), против ожидаемого соответствия. Лишние и недостающие ключи - расхождения; копятся и
// утверждаются разом. Акт - документ, создавший долг: "по акту" - строка движения указывает на него в измерении Документ.
Процедура ПроверитьДвижения(Регистратор, Акт, Ожидание, Имя)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Р.ТипРасчетов КАК ТипРасчетов, Р.ВидДвижения КАК ВидДвижения, Р.Документ КАК Документ, Р.СуммаВал КАК СуммаВал
		|ИЗ РегистрНакопления.РасчетыСПокупателями КАК Р
		|ГДЕ Р.Регистратор = &Регистратор");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Факт = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = ?(Выборка.ТипРасчетов = ПредопределенноеЗначение("Перечисление.ТипыРасчетов.Долг"), "Долг", "Аванс")
			+ "|" + ?(Выборка.ВидДвижения = ВидДвиженияНакопления.Расход, "Расход", "Приход")
			+ "|" + ?(Выборка.Документ = Акт, "по акту", "без акта");
		Факт.Вставить(Ключ, ?(Факт.Получить(Ключ) = Неопределено, 0, Факт.Получить(Ключ)) + Выборка.СуммаВал);
	КонецЦикла;

	Ключи = Новый Соответствие;
	Для Каждого Элемент Из Факт Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Ожидание Цикл
		Ключи.Вставить(Элемент.Ключ, Истина);
	КонецЦикла;

	Расхождения = "";
	Для Каждого Элемент Из Ключи Цикл
		ФактическаяСумма = ?(Факт.Получить(Элемент.Ключ) = Неопределено, 0, Факт.Получить(Элемент.Ключ));
		ОжидаемаяСумма = ?(Ожидание.Получить(Элемент.Ключ) = Неопределено, 0, Ожидание.Получить(Элемент.Ключ));
		Если ФактическаяСумма <> ОжидаемаяСумма Тогда
			Расхождения = Расхождения + Символы.ПС + "  движение " + Элемент.Ключ + ": ожидали " + ОжидаемаяСумма + ", факт " + ФактическаяСумма;
		КонецЕсли;
	КонецЦикла;

	ЮТест.ОжидаетЧто(Расхождения, Имя + ": движения РасчетыСПокупателями по регистратору как ожидалось").Равно("");

КонецПроцедуры

#КонецОбласти
