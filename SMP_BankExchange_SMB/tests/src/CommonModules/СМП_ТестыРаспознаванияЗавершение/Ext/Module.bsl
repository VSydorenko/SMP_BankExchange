// Тесты распознавания банковской выписки: завершение (задача 9, D14, D24, D25, D35.6, D35.8) - статья ДДС, корреспонденция,
// "без ПДВ", "Проверьте операцию", контрагент банка для комиссии и сводная таблица приоритетов D25. Отдельный модуль, чтобы
// прогон каждого модуля укладывался в предел одного вызова инструмента (~300 с); общие помощники живут в
// СМП_ТестыРаспознавания (экспортные), сценарии шага 5 - в СМП_ТестыРаспознаванияШаг5. Правила - docs/architecture/testing.md.
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты
		// Статья ДДС (D14): договор (если контрагент ведет расчеты по договорам и договор известен) -> контрагент -> статья по виду.
		// Каждая строка таблицы отличается от соседней одним признаком: на этом строится пара "не берется" / "берется".
		.ДобавитьТестовыйНабор("Завершение: статья ДДС, цепочка D14");

	Набор.ДобавитьСерверныйТест("Статья_Цепочка").ВТранзакции()
		.СПараметрами("статьи у договора и контрагента, расчеты по договорам: договор", Истина, Истина, Истина, "Договор", "ОплатаОтПокупателей")
		.СПараметрами("то же, расчеты по договорам не ведутся: договор пропускается, контрагент", Истина, Истина, Ложь, "Контрагент", "Прочее")
		.СПараметрами("статьи у договора нет, у контрагента есть: контрагент", Ложь, Истина, Истина, "Контрагент", "Прочее")
		.СПараметрами("статья только у договора: договор", Истина, Ложь, Истина, "Договор", "ОплатаОтПокупателей")
		.СПараметрами("статья только у договора, расчеты по договорам не ведутся: по виду операции", Истина, Ложь, Ложь, "ПоВидуОперации", "ОплатаПоставщикам")
		.СПараметрами("статей нет нигде: по виду операции", Ложь, Ложь, Истина, "ПоВидуОперации", "ОплатаПоставщикам");

	Набор.ДобавитьСерверныйТест("Статья_НовыйКонтрагент_ПоВидуОперации").ВТранзакции();

	Набор.ДобавитьСерверныйТест("Статья_Шаг4_НеПеревычисляется").ВТранзакции()
		.СПараметрами("у правила есть статья: правило, а не договор", Истина)
		.СПараметрами("у правила статьи нет: договор", Ложь);

	Набор.ДобавитьСерверныйТест("Статья_Шаг3_НеПеревычисляется").ВТранзакции()
		.СПараметрами("у поручения есть статья: поручение, а не договор", Истина)
		.СПараметрами("у поручения статьи нет: цепочка D14 (договор)", Ложь);

	Набор.ДобавитьСерверныйТест("Статья_ПоВидуОперации").ВТранзакции()
		.СПараметрами("поступление от покупателя", "Поступило", "ОтПокупателя", "ОплатаОтПокупателей")
		.СПараметрами("поступление от поставщика", "Поступило", "ОтПоставщика", "ОплатаПоставщикам")
		.СПараметрами("поступление от нашей организации", "Поступило", "ОтНашейОрганизации", "ОплатаОтПокупателей")
		.СПараметрами("поступление от курьерской компании", "Поступило", "ОтКурьерскойКомпанииПочты", "ОплатаОтПокупателей")
		.СПараметрами("поступление: прочие расчеты", "Поступило", "ПрочиеРасчеты", "Прочее")
		.СПараметрами("поступление: личные средства предпринимателя", "Поступило", "ЛичныеСредстваПредпринимателя", "ЛичныеСредстваПредпринимателя")
		.СПараметрами("поступление вне таблицы: оплата по картам", "Поступило", "ПоступлениеОплатыПоКартам", "Прочее")
		.СПараметрами("списание вне таблицы: расчеты по кредитам", "Списано", "РасчетыПоКредитам", "Прочее")
		.СПараметрами("списание покупателю (возврат)", "Списано", "Покупателю", "ОплатаОтПокупателей")
		.СПараметрами("списание поставщику", "Списано", "Поставщику", "ОплатаПоставщикам")
		.СПараметрами("списание нашей организации", "Списано", "НашейОрганизации", "ОплатаПоставщикам")
		.СПараметрами("списание: прочее", "Списано", "Прочее", "Прочее")
		.СПараметрами("списание: комиссия банка", "Списано", "КомиссияБанка", "Прочее")
		.СПараметрами("списание: перевод на другой счет", "Списано", "ПереводНаДругойСчет", "Прочее")
		.СПараметрами("списание: личные средства предпринимателя", "Списано", "ЛичныеСредстваПредпринимателя", "ЛичныеСредстваПредпринимателя");

	// Корреспонденция (решение консультанта к задаче 9): значение из поручения берется как есть; личные средства
	// предпринимателя без корреспонденции - НераспределеннаяПрибыль для любого источника вида.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Завершение: корреспонденция");
	Набор.ДобавитьСерверныйТест("Корреспонденция_Поручение_ЛичныеСредства").ВТранзакции()
		.СПараметрами("поручение без корреспонденции: нераспределенная прибыль", Ложь, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("поручение с корреспонденцией: как в поручении", Истина, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("поручение другого вида без корреспонденции: пусто", Ложь, "Прочее");
	Набор.ДобавитьСерверныйТест("Корреспонденция_Правило_ЛичныеСредства").ВТранзакции()
		.СПараметрами("списание, правило без корреспонденции", "Списано", Ложь, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("поступление, правило без корреспонденции", "Поступило", Ложь, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("списание, правило с корреспонденцией: как в правиле", "Списано", Истина, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("поступление, правило с корреспонденцией: как в правиле", "Поступило", Истина, "ЛичныеСредстваПредпринимателя")
		.СПараметрами("списание, правило другого вида без корреспонденции: пусто", "Списано", Ложь, "Прочее")
		.СПараметрами("поступление, правило другого вида без корреспонденции: пусто", "Поступило", Ложь, "ПрочиеРасчеты");

	// "Без ПДВ" (D35.6): фиксированный набор фраз обоих языков, без учета регистра, не через НСтр.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Завершение: без ПДВ");
	Набор.ДобавитьСерверныйТест("БезНДС_Фраза").ВТранзакции()
		.СПараметрами("рус.: НДС не облагается", "НДС не облагается", Истина)
		.СПараметрами("рус.: Без НДС", "Без НДС", Истина)
		.СПараметрами("рус.: Без налога (НДС)", "Без налога (НДС)", Истина)
		.СПараметрами("рус.: НДС не предусмотрен", "НДС не предусмотрен", Истина)
		.СПараметрами("укр.: ПДВ не обкладається", "ПДВ не обкладається", Истина)
		.СПараметрами("укр.: Без ПДВ", "Без ПДВ", Истина)
		.СПараметрами("укр.: Без податку (ПДВ)", "Без податку (ПДВ)", Истина)
		.СПараметрами("укр.: ПДВ не передбачений", "ПДВ не передбачений", Истина)
		.СПараметрами("регистр: все строчные (рус.)", "без ндс", Истина)
		.СПараметрами("регистр: все прописные (рус.)", "БЕЗ НДС", Истина)
		.СПараметрами("регистр: все строчные (укр.)", "без пдв", Истина)
		.СПараметрами("регистр: все прописные (укр.)", "БЕЗ ПДВ", Истина)
		.СПараметрами("регистр: смешанный (укр.)", "бЕз ПдВ", Истина)
		.СПараметрами("регистр: смешанный длинная фраза", "пдВ нЕ обкладаЄться", Истина)
		.СПараметрами("внутри предложения", "за договором 5, ціна без ПДВ, оплата", Истина)
		.СПараметрами("без НДС в скобках", "(Без НДС)", Истина)
		.СПараметрами("ставка ПДВ без слова 'без'", "в т.ч. ПДВ 20%", Ложь)
		.СПараметрами("только слово ПДВ", "ПДВ", Ложь)
		.СПараметрами("только слово НДС", "НДС", Ложь)
		.СПараметрами("только слово без", "без", Ложь)
		.СПараметрами("ПДВ с процентом", "сума з ПДВ 20%", Ложь)
		.СПараметрами("НДС включен", "НДС включен", Ложь)
		.СПараметрами("слова в другом порядке", "ПДВ без", Ложь)
		.СПараметрами("обычное назначение", "оплата за товар", Ложь);
	Набор.ДобавитьСерверныйТест("БезНДС_ОбаЯзыкаВОдномСеансе").ВТранзакции();
	Набор.ДобавитьСерверныйТест("БезНДС_НаправлениеИИсточникНеВажны").ВТранзакции()
		.СПараметрами("поступление, вид по умолчанию", "Поступило", Ложь)
		.СПараметрами("списание, вид по умолчанию", "Списано", Ложь)
		.СПараметрами("поступление, вид из правила", "Поступило", Истина)
		.СПараметрами("списание, вид из правила", "Списано", Истина);

	// "Проверьте операцию" (D24) - ровно тоді, коли жодне джерело виду не спрацювало.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Завершение: Проверьте операцию");
	Набор.ДобавитьСерверныйТест("Проверьте_РавноПоУмолчанию_Конверт").ВТранзакции();

	// Контрагент банка для комиссии (D35.8).
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Завершение: контрагент банка для комиссии");
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_Комиссия_БерётсяКонтрагентБанка").ВТранзакции();
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_НеЗаполнен_Невозможно").ВТранзакции();
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_СтарыйКонтекстБезПоля_КакПустой").ВТранзакции();
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_СтрокаДалаКонтрагента_НеПеревычисляется").ВТранзакции()
		.СПараметрами("контрагент строки найден в базе", "найден")
		.СПараметрами("контрагента строки нужно создать (данные есть)", "создать");
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_НеКомиссия_НеПрименяется").ВТранзакции();
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_СтатьяКонтрагентаБанка").ВТранзакции();
	Набор.ДобавитьСерверныйТест("КонтрагентБанка_Пакет_КаждаяСтрокаСвоя").ВТранзакции();

	// Сводная таблица приоритетов D25: строка таблицы - случай; название случая говорит, что побеждает что.
	Набор = ЮТТесты.ДобавитьТестовыйНабор("Завершение: таблица приоритетов D25");
	Тест = Набор.ДобавитьСерверныйТест("D25_Случай").ВТранзакции();
	Для Каждого Случай Из ТаблицаD25() Цикл
		Тест.СПараметрами(Случай.Название, Случай.Ключ);
	КонецЦикла;
	Набор.ДобавитьСерверныйТест("D25_ТаблицаПолна").ВТранзакции();
	Набор.ДобавитьСерверныйТест("D25_ВесьКонверт_НеПишетВБазу").ВТранзакции();

КонецПроцедуры

#Область Статья

// Цепочка D14 на найденном контрагенте и его договоре. Операция - списание; вид по умолчанию - поставщику, поэтому статья по
// виду операции - ОплатаПоставщикам, статья контрагента - Прочее, статья договора - ОплатаОтПокупателей (три разные).
// Предусловия читаются из базы: что записано в контрагенте и договоре, какой договор выбрала платформа.
Процедура Статья_Цепочка(Название, СтатьяДоговора, СтатьяКонтрагента, РасчетыПоДоговорам, ОжидаемыйИсточник, ИмяОжидаемойСтатьи) Экспорт

	Сценарий = НовыйСценарийСтатьи(СтатьяДоговора, СтатьяКонтрагента, РасчетыПоДоговорам);
	ПроверитьПредусловияСценарияСтатьи(Сценарий, Название);

	Результат = РаспознатьОперацию(Сценарий.Операция);

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида (предусловие - вид по умолчанию)").Равно("ПоУмолчанию");
	ЮТест.ОжидаетЧто(Строка.Договор, Название + ": договор строки - договор сценария (предусловие: уровень договора доступен)").Равно(Сценарий.Договор);
	ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья").Равно(Статья(ИмяОжидаемойСтатьи));
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи").Равно(ОжидаемыйИсточник);

КонецПроцедуры

// Контрагента в базе нет (операция с названием и кодом, которых нет): создается, договор создается, статью дает вид операции.
// Пара: тот же контрагент, найденный в базе со статьей, берет статью с карточки (Статья_Цепочка).
Процедура Статья_НовыйКонтрагент_ПоВидуОперации() Экспорт

	Результат = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление",
		Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, "Предусловие: контрагента нужно создать").Равно("Создать");
	ЮТест.ОжидаетЧто(Строка.СтатьяДДС, "Статья по виду операции (поставщику)").Равно(Статья("ОплатаПоставщикам"));
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, "Источник статьи").Равно("ПоВидуОперации");

КонецПроцедуры

// Статья правила (шаг 4) не перевычисляется цепочкой, даже если у договора и контрагента статьи есть. Пара - правило без
// статьи: тот же договор дает статью.
Процедура Статья_Шаг4_НеПеревычисляется(Название, СтатьяУПравила) Экспорт

	Сценарий = НовыйСценарийСтатьи(Истина, Истина, Истина);
	ПроверитьПредусловияСценарияСтатьи(Сценарий, Название);
	Настройки = Новый Структура;
	Если СтатьяУПравила Тогда
		Настройки.Вставить("СтатьяДДС", Статья("ОплатаПоставщикам"));
	КонецЕсли;
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Поставщику", Настройки));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные.СтатьяДДС), Название + ": предусловие - статья в правиле записана").Равно(СтатьяУПравила);
	Операция = Сценарий.Операция;
	Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза);

	Результат = РаспознатьОперацию(Операция);

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ПравилоНазначения, Название + ": правило сработало").Равно(Правило.Правило);
	ЮТест.ОжидаетЧто(Строка.Договор, Название + ": договор строки - договор сценария (уровень договора доступен)").Равно(Сценарий.Договор);
	Если СтатьяУПравила Тогда
		ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья правила").Равно(Статья("ОплатаПоставщикам"));
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - правило").Равно("ПравилоНазначения");
	Иначе
		ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья договора").Равно(Статья("ОплатаОтПокупателей"));
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - договор").Равно("Договор");
	КонецЕсли;

КонецПроцедуры

// Статья платежного поручения (шаг 3) не перевычисляется; пустая статья в поручении - цепочка D14 (решение консультанта).
Процедура Статья_Шаг3_НеПеревычисляется(Название, СтатьяВПоручении) Экспорт

	Сценарий = НовыйСценарийСтатьи(Истина, Истина, Истина);
	ПроверитьПредусловияСценарияСтатьи(Сценарий, Название);
	Дополнительно = Новый Структура("Контрагент, Договор", Сценарий.Контрагент, Сценарий.Договор);
	Дополнительно.Вставить("Статья", ?(СтатьяВПоручении, Статья("ОплатаПоставщикам"),
		ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка")));
	Подготовка = СМП_ТестыРаспознавания.ПодготовкаПоручения("", 1, , , Дополнительно);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Поручение, "Статья").Статья),
		Название + ": предусловие - статья в поручении (из базы)").Равно(СтатьяВПоручении);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ПлатежноеПоручение, Название + ": поручение взято").Равно(Подготовка.Поручение);
	ЮТест.ОжидаетЧто(Строка.Договор, Название + ": договор строки - договор поручения (сценария)").Равно(Сценарий.Договор);
	Если СтатьяВПоручении Тогда
		ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья поручения").Равно(Статья("ОплатаПоставщикам"));
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - поручение").Равно("ПлатежноеПоручение");
	Иначе
		ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Название + ": статья договора").Равно(Статья("ОплатаОтПокупателей"));
		ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Название + ": источник статьи - договор (не поручение)").Равно("Договор");
	КонецЕсли;

КонецПроцедуры

// Статья по виду операции повторяет форму документа вендора (ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС, последний
// уровень). Ожидаемые пары записаны в тест независимо от кода платформы: сверка с вендорским кодом, а не с самим собой.
// Вид задается правилом без статьи; контрагент операции в базе не найден (статью контрагента дать некому).
Процедура Статья_ПоВидуОперации(Название, Направление, ИмяВида, ИмяСтатьи) Экспорт

	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила(Направление, ИмяВида));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные.СтатьяДДС), Название + ": предусловие - в правиле статьи нет").ЭтоЛожь();

	Результат = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление, НазначениеПлатежа",
		Продукт("СМП_ВыпискаБанка.Направление" + Направление), СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза))));

	СМП_ТестыРаспознавания.ПроверитьПравилоПрименено(Результат, Название, Правило, Направление, ИмяВида);
	ЮТест.ОжидаетЧто(Результат.Строка.СтатьяДДС, Название + ": статья").Равно(Статья(ИмяСтатьи));
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникСтатьи, Название + ": источник статьи").Равно("ПоВидуОперации");

КонецПроцедуры

// Контрагент с договором: договор сценария - договор по умолчанию (основной договор поставщика). Возвращает: Контрагент, Договор, Операция (списание, контрагент найден по коду), флаги сценария.
Функция НовыйСценарийСтатьи(СтатьяДоговора, СтатьяКонтрагента, РасчетыПоДоговорам)

	Настройки = Новый Структура("ВестиРасчетыПоДоговорам", РасчетыПоДоговорам);
	Если СтатьяКонтрагента Тогда
		Настройки.Вставить("СтатьяДДСПоУмолчанию", Статья("Прочее"));
	КонецЕсли;
	Контрагент = СМП_ТестыРаспознавания.НовыйКонтрагентТеста(Настройки);

	ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоров.СПоставщиком");
	// Договор сценария - договор по умолчанию, созданный записью контрагента: второй договор вендор позволяет только
	// контрагенту с учетом по договорам, а сценарий должен работать и без него. Статья записывается в сам договор.
	Договор = СМП_ТестыДанныеУНФ.НастроитьДоговорПоУмолчанию(Контрагент, Новый Структура("Организация, ВидДоговора, Основной",
		СМП_ТестыДанныеУНФ.Организация(), ВидДоговора, Истина));
	Если СтатьяДоговора Тогда
		Объект = Договор.ПолучитьОбъект();
		Объект.СтатьяДДСПоУмолчанию = Статья("ОплатаОтПокупателей");
		Объект.Записать();
	КонецЕсли;

	Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление, КонтрагентКод, КонтрагентНаименование, Сумма",
		Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), СМП_ТестыРаспознавания.ДанныеКонтрагента(Контрагент).Код, "",
		СМП_ТестыРаспознавания.УникальнаяСумма()));

	Возврат Новый Структура("Контрагент, Договор, Операция, СтатьяДоговора, СтатьяКонтрагента, РасчетыПоДоговорам",
		Контрагент, Договор, Операция, СтатьяДоговора, СтатьяКонтрагента, РасчетыПоДоговорам);

КонецФункции

// Сценарий построен так, как заявлено: статьи и признак расчетов по договорам прочитаны из базы.
Процедура ПроверитьПредусловияСценарияСтатьи(Сценарий, Название)

	Пустая = ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Сценарий.Контрагент, "ВестиРасчетыПоДоговорам").ВестиРасчетыПоДоговорам,
		Название + ": предусловие - признак расчетов по договорам контрагента (из базы)").Равно(Сценарий.РасчетыПоДоговорам);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Сценарий.Контрагент, "СтатьяДДСПоУмолчанию").СтатьяДДСПоУмолчанию,
		Название + ": предусловие - статья контрагента (из базы)").Равно(?(Сценарий.СтатьяКонтрагента, Статья("Прочее"), Пустая));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Сценарий.Договор, "СтатьяДДСПоУмолчанию").СтатьяДДСПоУмолчанию,
		Название + ": предусловие - статья договора (из базы)").Равно(?(Сценарий.СтатьяДоговора, Статья("ОплатаОтПокупателей"), Пустая));

КонецПроцедуры

#КонецОбласти

#Область Корреспонденция

// (а), (б), вид "Прочее": платежное поручение. Корреспонденция поручения прочитана из базы до вызова.
Процедура Корреспонденция_Поручение_ЛичныеСредства(Название, КорреспонденцияЗаполнена, ИмяВидаПоручения) Экспорт

	Дополнительно = Новый Структура("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение." + ИмяВидаПоручения));
	Если КорреспонденцияЗаполнена Тогда
		Дополнительно.Вставить("Корреспонденция", СМП_ТестыРаспознавания.КорреспонденцияПоручения());
	Иначе
		Дополнительно.Вставить("Корреспонденция", ПредопределенноеЗначение("ПланСчетов.Управленческий.ПустаяСсылка"));
	КонецЕсли;
	Подготовка = СМП_ТестыРаспознавания.ПодготовкаПоручения("", 1, , , Дополнительно);
	Записано = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Подготовка.Поручение, "Корреспонденция").Корреспонденция;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Записано), Название + ": предусловие - корреспонденция в поручении (из базы)").Равно(КорреспонденцияЗаполнена);

	Результат = СМП_ТестыРаспознавания.РаспознатьПодготовку(Подготовка);

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Название + ": источник вида - поручение").Равно("ПлатежноеПоручение");
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид операции")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета." + ИмяВидаПоручения));
	Если КорреспонденцияЗаполнена Тогда
		ОжидаемаяКорреспонденция = СМП_ТестыРаспознавания.КорреспонденцияПоручения();
	ИначеЕсли ИмяВидаПоручения = "ЛичныеСредстваПредпринимателя" Тогда
		ОжидаемаяКорреспонденция = ПредопределенноеЗначение("ПланСчетов.Управленческий.НераспределеннаяПрибыль");
	Иначе
		ОжидаемаяКорреспонденция = ПредопределенноеЗначение("ПланСчетов.Управленческий.ПустаяСсылка");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Строка.Корреспонденция, Название + ": корреспонденция").Равно(ОжидаемаяКорреспонденция);

КонецПроцедуры

// (в): правило справочника. Пары: правило с корреспонденцией берется как есть; правило другого вида без корреспонденции - пусто.
Процедура Корреспонденция_Правило_ЛичныеСредства(Название, Направление, КорреспонденцияЗаполнена, ИмяВида) Экспорт

	Дополнительно = Новый Структура;
	Если КорреспонденцияЗаполнена Тогда
		Дополнительно.Вставить("Корреспонденция", СМП_ТестыРаспознавания.КорреспонденцияПоручения());
	КонецЕсли;
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила(Направление, ИмяВида, Дополнительно));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные.Корреспонденция), Название + ": предусловие - корреспонденция в правиле (из базы)")
		.Равно(КорреспонденцияЗаполнена);

	Результат = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление, НазначениеПлатежа",
		Продукт("СМП_ВыпискаБанка.Направление" + Направление), СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза))));

	СМП_ТестыРаспознавания.ПроверитьПравилоПрименено(Результат, Название, Правило, Направление, ИмяВида);
	Если КорреспонденцияЗаполнена Тогда
		ОжидаемаяКорреспонденция = СМП_ТестыРаспознавания.КорреспонденцияПоручения();
	ИначеЕсли ИмяВида = "ЛичныеСредстваПредпринимателя" Тогда
		ОжидаемаяКорреспонденция = ПредопределенноеЗначение("ПланСчетов.Управленческий.НераспределеннаяПрибыль");
	Иначе
		ОжидаемаяКорреспонденция = ПредопределенноеЗначение("ПланСчетов.Управленческий.ПустаяСсылка");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.Строка.Корреспонденция, Название + ": корреспонденция").Равно(ОжидаемаяКорреспонденция);

КонецПроцедуры

#КонецОбласти

#Область БезНДС

// Фраза в назначении -> признак. Назначение = метка фикстуры + фраза: правил пользователей оно не заденет.
Процедура БезНДС_Фраза(Название, Фраза, Ожидаемо) Экспорт

	Результат = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("НазначениеПлатежа",
		СМП_ТестыРаспознавания.НазначениеСФразами(Фраза))));

	ЮТест.ОжидаетЧто(Результат.Строка.БезНДС, Название + ": признак 'без ПДВ' для назначения '" + Фраза + "'").Равно(Ожидаемо);

КонецПроцедуры

// Фразы не через НСтр: рус. и укр. фразы, не содержащие друг друга, дают признак в ОДНОМ сеансе. Вариант на НСтр понимал бы
// только фразу языка сеанса (НСтр выбирает ровно одну строку), и одна из двух проверок почервонела бы в любом сеансе. Язык
// сеанса тест изменить не может, поэтому измеряется не "каждый язык по очереди", а "оба языка в текущем": условие - язык
// текущего сеанса (приводится в сообщении), результат не зависит от него.
Процедура БезНДС_ОбаЯзыкаВОдномСеансе() Экспорт

	Русская = "НДС не облагается";
	Украинская = "ПДВ не обкладається";
	ЮТест.ОжидаетЧто(СтрНайти(ВРег(Русская), ВРег(Украинская)), "Предусловие: украинская фраза не входит в русскую").Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ВРег(Украинская), ВРег(Русская)), "Предусловие: русская фраза не входит в украинскую").Равно(0);

	Язык = ТекущийЯзык();
	РезультатРус = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("НазначениеПлатежа",
		СМП_ТестыРаспознавания.НазначениеСФразами(Русская))));
	РезультатУкр = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("НазначениеПлатежа",
		СМП_ТестыРаспознавания.НазначениеСФразами(Украинская))));

	ЮТест.ОжидаетЧто(РезультатРус.Строка.БезНДС, "Русская фраза распознана в сеансе с языком '" + Язык + "'").ЭтоИстина();
	ЮТест.ОжидаетЧто(РезультатУкр.Строка.БезНДС, "Украинская фраза распознана в сеансе с языком '" + Язык + "'").ЭтоИстина();

КонецПроцедуры

// Признак не зависит от направления и от источника вида (значение по умолчанию / правило). Пара - то же без фразы.
Процедура БезНДС_НаправлениеИИсточникНеВажны(Название, Направление, ЧерезПравило) Экспорт

	Фразы = Новый Массив;
	Если ЧерезПравило Тогда
		Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила(Направление,
			?(Направление = "Поступило", "ПрочиеРасчеты", "Прочее")));
		Фразы.Добавить(Правило.Фраза);
	КонецЕсли;

	Без = СМП_ТестыРаспознавания.НазначениеСФразами(Фразы);
	ФразыСПризнаком = Новый Массив;
	Для Каждого Фраза Из Фразы Цикл
		ФразыСПризнаком.Добавить(Фраза);
	КонецЦикла;
	ФразыСПризнаком.Добавить("Без ПДВ");
	С_Фразой = СМП_ТестыРаспознавания.НазначениеСФразами(ФразыСПризнаком);

	РезультатБез = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление, НазначениеПлатежа",
		Продукт("СМП_ВыпискаБанка.Направление" + Направление), Без)));
	РезультатС = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("Направление, НазначениеПлатежа",
		Продукт("СМП_ВыпискаБанка.Направление" + Направление), С_Фразой)));

	ЮТест.ОжидаетЧто(РезультатС.Строка.ИсточникВидаОперации = "ПравилоНазначения", Название + ": предусловие - источник вида ожидаемый")
		.Равно(ЧерезПравило);
	ЮТест.ОжидаетЧто(РезультатБез.Строка.БезНДС, Название + ": пара - без фразы признака нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(РезультатС.Строка.БезНДС, Название + ": с фразой признак есть").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПроверьтеОперацию

// Конверт из строк разных источников: признак стоит ровно у строки со значением по умолчанию. Предусловие - источники читаются
// из плана (строки действительно разные), а не заданы тестом.
Процедура Проверьте_РавноПоУмолчанию_Конверт() Экспорт

	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Прочее"));
	Операции = НоваяТаблицаОпераций();
	ДобавитьОперацию(Операции, СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление", 1,
		Продукт("СМП_ВыпискаБанка.НаправлениеСписано"))));
	ДобавитьОперацию(Операции, СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление, НазначениеПлатежа", 2,
		Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза))));
	ДобавитьОперацию(Операции, СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", 3)));

	План = СМП_ТестыРаспознавания.Распознать(Операции, СМП_ТестыРаспознавания.КонтекстСОрганизацией());

	Ожидаемо = Новый Соответствие;
	Ожидаемо.Вставить(1, "ПоУмолчанию");
	Ожидаемо.Вставить(2, "ПравилоНазначения");
	Ожидаемо.Вставить(3, "ПоУмолчанию");
	Для Каждого Элемент Из Ожидаемо Цикл
		Строка = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, Элемент.Ключ);
		ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, "Строка " + Элемент.Ключ + ": источник вида (предусловие)").Равно(Элемент.Значение);
		ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, "Строка " + Элемент.Ключ + ": 'Проверьте операцию' ровно при значении по умолчанию")
			.Равно(Элемент.Значение = "ПоУмолчанию");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КонтрагентБанка

// Комиссия банка, строка контрагента не дала (нет ни названия, ни кода, ни счета), КонтрагентБанка заполнен: контрагент банка,
// "Найден", замечание "Невозможно" снято; договор и счет не нужны.
Процедура КонтрагентБанка_Комиссия_БерётсяКонтрагентБанка() Экспорт

	Банк = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));
	Операция = ОперацияБезДанныхОКонтрагенте(Правило);

	Результат = РаспознатьОперацию(Операция, КонтекстСКонтрагентомБанка(Банк));

	Строка = Результат.Строка;
	СМП_ТестыРаспознавания.ПроверитьПравилоПрименено(Результат, "Комиссия банка", Правило, "Списано", "КомиссияБанка");
	ЮТест.ОжидаетЧто(Строка.Контрагент, "Контрагент - контрагент банка").Равно(Банк);
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, "Действие над контрагентом").Равно("Найден");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "Контрагент").Количество(),
		"Замечание 'Невозможно' с поля контрагента снято").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоУровню(Результат.Замечания, СМП_ТестыРаспознавания.УровеньОшибка()).Количество(),
		"Ошибок в строке нет").Равно(0);
	ЮТест.ОжидаетЧто(Строка.ДействиеДоговор, "Договор комиссии не нужен").Равно("НеТребуется");
	ЮТест.ОжидаетЧто(Строка.ДействиеСчет, "Счет не нужен").Равно("НеТребуется");

КонецПроцедуры

// Пара к предыдущему: то же, КонтрагентБанка не заполнен (явно пустая ссылка) - "Невозможно" и "Ошибка" на поле контрагента.
Процедура КонтрагентБанка_НеЗаполнен_Невозможно() Экспорт

	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));
	Операция = ОперацияБезДанныхОКонтрагенте(Правило);
	Контекст = КонтекстСКонтрагентомБанка(ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));

	Результат = РаспознатьОперацию(Операция, Контекст);

	ПроверитьНевозможно(Результат, "Пустой КонтрагентБанка");

КонецПроцедуры

// Старый контекст - структура с двумя полями (без КонтрагентаБанка): распознавание работает как с пустым полем.
Процедура КонтрагентБанка_СтарыйКонтекстБезПоля_КакПустой() Экспорт

	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));
	Операция = ОперацияБезДанныхОКонтрагенте(Правило);
	Полный = СМП_ТестыРаспознавания.КонтекстСОрганизацией();
	Старый = Новый Структура("Организация, БанковскийСчет", Полный.Организация, Полный.БанковскийСчет);
	ЮТест.ОжидаетЧто(Старый.Количество(), "Предусловие: в старом контексте два поля").Равно(2);
	ЮТест.ОжидаетЧто(Старый.Свойство("КонтрагентБанка"), "Предусловие: поля КонтрагентБанка в старом контексте нет").ЭтоЛожь();

	Результат = РаспознатьОперацию(Операция, Старый);

	ПроверитьНевозможно(Результат, "Контекст без поля КонтрагентБанка");

КонецПроцедуры

// Строка дала контрагента (найденного или такого, что будет создан) - полем контекста он не перевычисляется. Пара - предыдущий
// тест комиссии без данных о контрагенте: там поле контекста берется.
Процедура КонтрагентБанка_СтрокаДалаКонтрагента_НеПеревычисляется(Название, Режим) Экспорт

	Банк = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));
	Настройки = Новый Структура("ПорядковыйНомер, Направление, НазначениеПлатежа", 1,
		Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза));
	Собственный = Неопределено;
	Если Режим = "найден" Тогда
		Собственный = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		Настройки.Вставить("КонтрагентКод", СМП_ТестыРаспознавания.ДанныеКонтрагента(Собственный).Код);
		Настройки.Вставить("КонтрагентНаименование", "");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Собственный <> Банк, Название + ": предусловие - контрагент строки и контрагент банка разные").ЭтоИстина();

	Результат = РаспознатьОперацию(СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки), КонтекстСКонтрагентомБанка(Банк));

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(Строка.ВидОперации, Название + ": вид - комиссия банка (предусловие)")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.КомиссияБанка"));
	ЮТест.ОжидаетЧто(Строка.Контрагент = Банк, Название + ": контрагент банка строку не заменил").ЭтоЛожь();
	Если Режим = "найден" Тогда
		ЮТест.ОжидаетЧто(Строка.Контрагент, Название + ": собственный контрагент строки").Равно(Собственный);
		ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Название + ": действие").Равно("Найден");
	Иначе
		ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Название + ": контрагента строки создадут, а не подменят").Равно("Создать");
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Контрагент), Название + ": ссылки на контрагента нет").ЭтоЛожь();
	КонецЕсли;

КонецПроцедуры

// Только для комиссии банка. Вид "поставщику" без данных о контрагенте: "Невозможно" и ошибка даже при заполненном поле
// контекста. Пара - комиссия (КонтрагентБанка_Комиссия_БерётсяКонтрагентБанка): единственное отличие - вид операции.
Процедура КонтрагентБанка_НеКомиссия_НеПрименяется() Экспорт

	Банк = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Поставщику"));
	Операция = ОперацияБезДанныхОКонтрагенте(Правило);

	Результат = РаспознатьОперацию(Операция, КонтекстСКонтрагентомБанка(Банк));

	ПроверитьНевозможно(Результат, "Вид 'поставщику' при заполненном КонтрагентеБанка");

КонецПроцедуры

// Статья контрагента банка участвует в цепочке D14 (контрагент подставляется до статьи): источник - контрагент.
Процедура КонтрагентБанка_СтатьяКонтрагентаБанка() Экспорт

	Банк = СМП_ТестыРаспознавания.НовыйКонтрагентТеста(Новый Структура("СтатьяДДСПоУмолчанию", Статья("ОплатаПоставщикам")));
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЧитатьРеквизиты(Банк, "СтатьяДДСПоУмолчанию").СтатьяДДСПоУмолчанию,
		"Предусловие: статья контрагента банка (из базы)").Равно(Статья("ОплатаПоставщикам"));
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));

	Результат = РаспознатьОперацию(ОперацияБезДанныхОКонтрагенте(Правило), КонтекстСКонтрагентомБанка(Банк));

	ЮТест.ОжидаетЧто(Результат.Строка.Контрагент, "Предусловие: подставлен контрагент банка").Равно(Банк);
	ЮТест.ОжидаетЧто(Результат.Строка.СтатьяДДС, "Статья контрагента банка").Равно(Статья("ОплатаПоставщикам"));
	ЮТест.ОжидаетЧто(Результат.Строка.ИсточникСтатьи, "Источник статьи - контрагент").Равно("Контрагент");

КонецПроцедуры

// Пакет: у каждой строки свой результат. Комиссия без данных - контрагент банка; "поставщику" без данных - "Невозможно";
// комиссия с собственным контрагентом - он.
Процедура КонтрагентБанка_Пакет_КаждаяСтрокаСвоя() Экспорт

	Банк = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Собственный = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
	Комиссия = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "КомиссияБанка"));
	Поставщику = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Поставщику"));
	Операции = НоваяТаблицаОпераций();
	ДобавитьОперацию(Операции, ОперацияБезДанныхОКонтрагенте(Комиссия, 1));
	ДобавитьОперацию(Операции, ОперацияБезДанныхОКонтрагенте(Поставщику, 2));
	Третья = ОперацияБезДанныхОКонтрагенте(Комиссия, 3);
	Третья.КонтрагентКод = СМП_ТестыРаспознавания.ДанныеКонтрагента(Собственный).Код;
	ДобавитьОперацию(Операции, Третья);

	План = СМП_ТестыРаспознавания.Распознать(Операции, КонтекстСКонтрагентомБанка(Банк));

	Строка1 = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1);
	Строка2 = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 2);
	Строка3 = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3);
	ЮТест.ОжидаетЧто(Строка1.Контрагент, "Строка 1 (комиссия без данных): контрагент банка").Равно(Банк);
	ЮТест.ОжидаетЧто(Строка1.ДействиеКонтрагент, "Строка 1: действие").Равно("Найден");
	ЮТест.ОжидаетЧто(Строка2.ДействиеКонтрагент, "Строка 2 ('поставщику' без данных): невозможно").Равно("Невозможно");
	ЮТест.ОжидаетЧто(Строка3.Контрагент, "Строка 3 (комиссия, свой контрагент): свой").Равно(Собственный);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияСтроки(План, 1).Количество(), "Строка 1: замечаний нет").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(СМП_ТестыРаспознавания.ЗамечанияСтроки(План, 2), "Контрагент",
		СМП_ТестыРаспознавания.УровеньОшибка()).Количество(), "Строка 2: ошибка на поле контрагента").Равно(1);

КонецПроцедуры

Функция ОперацияБезДанныхОКонтрагенте(Правило, ПорядковыйНомер = 1)

	Возврат СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура(
		"ПорядковыйНомер, Направление, НазначениеПлатежа, КонтрагентНаименование, КонтрагентКод, КонтрагентНомерСчета",
		ПорядковыйНомер, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза),
		"", "", ""));

КонецФункции

// Контекст с полем КонтрагентБанка: ключ вставляется, а не присваивается, поэтому до реализации поля тест краснеет значением,
// а не отсутствием ключа.
Функция КонтекстСКонтрагентомБанка(Контрагент)

	Контекст = СМП_ТестыРаспознавания.КонтекстСОрганизацией();
	Контекст.Вставить("КонтрагентБанка", Контрагент);

	Возврат Контекст;

КонецФункции

Процедура ПроверитьНевозможно(Результат, Описание)

	Строка = Результат.Строка;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Контрагент), Описание + ": контрагента нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.ДействиеКонтрагент, Описание + ": действие над контрагентом").Равно("Невозможно");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ЗамечанияПоПолю(Результат.Замечания, "Контрагент",
		СМП_ТестыРаспознавания.УровеньОшибка()).Количество(), Описание + ": ровно одна ошибка на поле контрагента").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ТаблицаD25

// Таблица случаев D25: данные теста, читаются одним циклом. Ключ - сценарий (ПостроитьСлучай); Источник, Вид, Статья,
// ИсточникСтатьи - ожидаемое. Пустой Вид - вид не проверяется (загруженный документ вид не меняет); пустая Статья - статья пуста.
Функция ТаблицаD25()

	Таблица = Новый Массив;
	ДобавитьСлучай(Таблица, "Умолчанию", "шаг 6: ничего не сработало - значение по умолчанию",
		"ПоУмолчанию", "РасходСоСчета.Поставщику", "ОплатаПоставщикам", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "Правило", "шаг 4: правило по назначению платежа",
		"ПравилоНазначения", "РасходСоСчета.Прочее", "ОплатаОтПокупателей", "ПравилоНазначения");
	ДобавитьСлучай(Таблица, "ДокументПоНомеру", "шаг 5: документ по номеру в назначении",
		"ДокументПоНомеру", "РасходСоСчета.Поставщику", "ОплатаПоставщикам", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "ПлатежноеПоручение", "шаг 3: платежное поручение",
		"ПлатежноеПоручение", "РасходСоСчета.Прочее", "ОплатаПоставщикам", "ПлатежноеПоручение");
	ДобавитьСлучай(Таблица, "Сотрудник", "шаг 2: счет действующего сотрудника",
		"Сотрудник", "РасходСоСчета.ЗарплатаСотруднику", "Прочее", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "СвойСчет", "шаг 1: свой счет той же организации",
		"СвойСчет", "РасходСоСчета.ПереводНаДругойСчет", "Прочее", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "НашаОрганизация", "шаг 1: счет другой нашей организации",
		"НашаОрганизация", "ПоступлениеНаСчет.ОтНашейОрганизации", "ОплатаОтПокупателей", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "ЗагруженныйДокумент", "шаг 0: уже загруженный документ",
		"ЗагруженныйДокумент", "", "", "");
	ДобавитьСлучай(Таблица, "СвойСчетПротивПравила", "свой счет побеждает правило с той же фразой",
		"СвойСчет", "РасходСоСчета.ПереводНаДругойСчет", "Прочее", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "СотрудникПротивПравила", "сотрудник побеждает правило",
		"Сотрудник", "РасходСоСчета.ЗарплатаСотруднику", "Прочее", "ПоВидуОперации");
	ДобавитьСлучай(Таблица, "ПоручениеПротивПравила", "платежное поручение побеждает правило",
		"ПлатежноеПоручение", "РасходСоСчета.Прочее", "ОплатаПоставщикам", "ПлатежноеПоручение");
	ДобавитьСлучай(Таблица, "ПравилоПротивДокументаПоНомеру", "правило побеждает документ по номеру",
		"ПравилоНазначения", "РасходСоСчета.Прочее", "ОплатаОтПокупателей", "ПравилоНазначения");
	ДобавитьСлучай(Таблица, "ЗагруженныйПротивВсего", "загруженный документ побеждает свой счет и правило",
		"ЗагруженныйДокумент", "", "", "");
	ДобавитьСлучай(Таблица, "ЗагруженныйПротивПоручения", "загруженный документ побеждает платежное поручение",
		"ЗагруженныйДокумент", "", "", "");
	ДобавитьСлучай(Таблица, "ЗагруженныйПротивДокументаПоНомеру", "загруженный документ побеждает документ по номеру",
		"ЗагруженныйДокумент", "", "", "");

	Возврат Таблица;

КонецФункции

Процедура ДобавитьСлучай(Таблица, Ключ, Название, Источник, Вид, ИмяСтатьи, ИсточникСтатьи)

	Таблица.Добавить(Новый Структура("Ключ, Название, Источник, Вид, ИмяСтатьи, ИсточникСтатьи, ПроверьтеОперацию",
		Ключ, Название, Источник, Вид, ИмяСтатьи, ИсточникСтатьи, Источник = "ПоУмолчанию"));

КонецПроцедуры

Функция СлучайПоКлючу(Ключ)

	Для Каждого Случай Из ТаблицаD25() Цикл
		Если Случай.Ключ = Ключ Тогда
			Возврат Случай;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Таблица D25: нет случая с ключом '" + Ключ + "'";

КонецФункции

// Строит данные случая (в базу пишутся только фикстуры). Результат: Операция; Пара - операция, отличающаяся от основной ОДНИМ
// условием (без него побеждает другой источник) и ИсточникПары - источник, который побеждает в паре; Документ - загруженный.
Функция ПостроитьСлучай(Ключ, Номер)

	Результат = Новый Структура("Операция, Пара, ИсточникПары, Документ", Неопределено, Неопределено, "", Неопределено);
	Списано = Продукт("СМП_ВыпискаБанка.НаправлениеСписано");

	Если Ключ = "Умолчанию" Тогда
		Результат.Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, Направление", Номер, Списано));

	ИначеЕсли Ключ = "Правило" Тогда
		Правило = ПравилоСоСтатьей("Прочее");
		Результат.Операция = ОперацияСФразой(Номер, Правило.Фраза);
		Результат.Пара = ОперацияСФразой(Номер, "");
		Результат.ИсточникПары = "ПоУмолчанию";

	ИначеЕсли Ключ = "ДокументПоНомеру" Или Ключ = "ПравилоПротивДокументаПоНомеру" Тогда
		Подготовка = СМП_ТестыРаспознаванияШаг5.Шаг5_Подготовка("СчетНаОплатуПоставщика");
		Подготовка.Операция.ПорядковыйНомер = Номер;
		БезНомера = Копия(Подготовка.Операция);
		БезНомера.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами("без номера документа");
		Если Ключ = "ДокументПоНомеру" Тогда
			Результат.Операция = Подготовка.Операция;
			Результат.Пара = БезНомера;
			Результат.ИсточникПары = "ПоУмолчанию";
		Иначе
			Правило = ПравилоСоСтатьей("Прочее");
			Результат.Пара = Копия(Подготовка.Операция);
			Результат.ИсточникПары = "ДокументПоНомеру";
			Подготовка.Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза) + " № " + Подготовка.Номер;
			Результат.Операция = Подготовка.Операция;
		КонецЕсли;

	ИначеЕсли Ключ = "ПлатежноеПоручение" Или Ключ = "ПоручениеПротивПравила" Тогда
		Подготовка = СМП_ТестыРаспознавания.ПодготовкаПоручения("", Номер, , , Новый Структура("Статья", Статья("ОплатаПоставщикам")));
		Результат.Операция = Подготовка.Операция;
		Если Ключ = "ПлатежноеПоручение" Тогда
			Результат.Пара = СМП_ТестыРаспознавания.ПодготовкаПоручения("номерДругой", Номер).Операция;
			Результат.ИсточникПары = "ПоУмолчанию";
		Иначе
			Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Налоги",
				Новый Структура("СтатьяДДС, СМП_ВидНалога", Статья("ОплатаОтПокупателей"), ПредопределенноеЗначение("Справочник.ВидыНалогов.Взносы"))));
			Подготовка.Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза);
			Другая = СМП_ТестыРаспознавания.ПодготовкаПоручения("номерДругой", Номер);
			Другая.Операция.НазначениеПлатежа = Подготовка.Операция.НазначениеПлатежа;
			Результат.Пара = Другая.Операция;
			Результат.ИсточникПары = "ПравилоНазначения";
		КонецЕсли;

	ИначеЕсли Ключ = "Сотрудник" Или Ключ = "СотрудникПротивПравила" Тогда
		Данные = СМП_ТестыРаспознавания.НовыйСотрудникСоСчетом("Работает");
		Уволенный = СМП_ТестыРаспознавания.НовыйСотрудникСоСчетом("Уволен");
		Результат.Операция = ОперацияСФразой(Номер, "", Данные.НомерСчета);
		Результат.Пара = ОперацияСФразой(Номер, "", Уволенный.НомерСчета);
		Результат.ИсточникПары = "ПоУмолчанию";
		Если Ключ = "СотрудникПротивПравила" Тогда
			Правило = ПравилоСоСтатьей("Прочее");
			Результат.Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза);
			Результат.Пара.НазначениеПлатежа = Результат.Операция.НазначениеПлатежа;
			Результат.ИсточникПары = "ПравилоНазначения";
		КонецЕсли;

	ИначеЕсли Ключ = "СвойСчет" Или Ключ = "СвойСчетПротивПравила" Тогда
		Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
		Результат.Операция = ОперацияСФразой(Номер, "", СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "НомерСчета").НомерСчета);
		Результат.Пара = ОперацияСФразой(Номер, "", СМП_ТестыДанныеУНФ.НовыйIBAN());
		Результат.ИсточникПары = "ПоУмолчанию";
		Если Ключ = "СвойСчетПротивПравила" Тогда
			Правило = ПравилоСоСтатьей("Прочее");
			Результат.Операция.НазначениеПлатежа = СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза);
			Результат.Пара.НазначениеПлатежа = Результат.Операция.НазначениеПлатежа;
			Результат.ИсточникПары = "ПравилоНазначения";
		КонецЕсли;

	ИначеЕсли Ключ = "НашаОрганизация" Тогда
		Интеркампани = СМП_ТестыРаспознавания.НовыйКонтрагентТеста();
		Другая = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Интеркампани));
		Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Другая);
		Результат.Операция = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер, КонтрагентНомерСчета", Номер,
			СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "НомерСчета").НомерСчета));
		Результат.Пара = СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Новый Структура("ПорядковыйНомер", Номер));
		Результат.ИсточникПары = "ПоУмолчанию";

	ИначеЕсли Ключ = "ЗагруженныйДокумент" Или Ключ = "ЗагруженныйПротивВсего" Тогда
		КлючДокумента = СМП_ТестыРаспознавания.НовыйКлюч("Д-" + Номер);
		Идентификатор = СМП_ТестыРаспознавания.НовыйИдентификатор();
		Основа = СМП_ТестыРаспознавания.ДокументПоКлючу(КлючДокумента, "РасходСоСчета", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
		Дополнительно = Новый Структура("КонтрагентКод, КонтрагентНаименование",
			СМП_ТестыРаспознавания.ДанныеКонтрагента(Основа.Контрагент).Код, "");
		Результат.Документ = Основа.Ссылка;
		Результат.ИсточникПары = "ПоУмолчанию";
		Если Ключ = "ЗагруженныйПротивВсего" Тогда
			Счет = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(СМП_ТестыДанныеУНФ.Организация());
			Правило = ПравилоСоСтатьей("Прочее");
			Дополнительно.Вставить("КонтрагентНомерСчета", СМП_ТестыРаспознавания.ЧитатьРеквизиты(Счет, "НомерСчета").НомерСчета);
			Дополнительно.Вставить("НазначениеПлатежа", СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза));
			Результат.ИсточникПары = "СвойСчет";
		КонецЕсли;
		Результат.Операция = СМП_ТестыРаспознавания.ОперацияПоКлючу(Номер, КлючДокумента, "РасходСоСчета", Идентификатор, Дополнительно);
		// Пара: тот же ключ, но идентификатор операции другой - документ с другим идентификатором складному ключу не подходит.
		Результат.Пара = СМП_ТестыРаспознавания.ОперацияПоКлючу(Номер, КлючДокумента, "РасходСоСчета",
			СМП_ТестыРаспознавания.НовыйИдентификатор(), Дополнительно);

	ИначеЕсли Ключ = "ЗагруженныйПротивПоручения" Тогда
		// Документ загружен (совпал идентификатор), и есть платежное поручение, которое подошло бы операции (тот же контрагент,
		// сумма, номер, дата). Пара: идентификатор операции другой - документ не находится, и поручение берется.
		КлючДокумента = СМП_ТестыРаспознавания.НовыйКлюч(СМП_ТестыРаспознавания.НовыйЦифровойНомер());
		Идентификатор = СМП_ТестыРаспознавания.НовыйИдентификатор();
		Основа = СМП_ТестыРаспознавания.ДокументПоКлючу(КлючДокумента, "РасходСоСчета", Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
		СМП_ТестыДанныеУНФ.НовоеПлатежноеПоручение(Новый Структура("Контрагент, Сумма, Номер, Дата, ВидОперации, Статья, Корреспонденция",
			Основа.Контрагент, КлючДокумента.Сумма, КлючДокумента.Номер, КлючДокумента.День,
			ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.Прочее"), Статья("ОплатаПоставщикам"),
			СМП_ТестыРаспознавания.КорреспонденцияПоручения()));
		Дополнительно = Новый Структура("КонтрагентКод, КонтрагентНаименование",
			СМП_ТестыРаспознавания.ДанныеКонтрагента(Основа.Контрагент).Код, "");
		Результат.Документ = Основа.Ссылка;
		Результат.Операция = СМП_ТестыРаспознавания.ОперацияПоКлючу(Номер, КлючДокумента, "РасходСоСчета", Идентификатор, Дополнительно);
		Результат.Пара = СМП_ТестыРаспознавания.ОперацияПоКлючу(Номер, КлючДокумента, "РасходСоСчета",
			СМП_ТестыРаспознавания.НовыйИдентификатор(), Дополнительно);
		Результат.ИсточникПары = "ПлатежноеПоручение";

	ИначеЕсли Ключ = "ЗагруженныйПротивДокументаПоНомеру" Тогда
		// Документ загружен по идентификатору операции, а в назначении стоит номер счета поставщика. Пара: другой идентификатор
		// операции (и ключ документа не совпадает) - загруженного документа нет, находится счет по номеру.
		Подготовка = СМП_ТестыРаспознаванияШаг5.Шаг5_Подготовка("СчетНаОплатуПоставщика");
		Идентификатор = СМП_ТестыРаспознавания.НовыйИдентификатор();
		Основа = СМП_ТестыРаспознавания.ДокументПоКлючу(СМП_ТестыРаспознавания.НовыйКлюч("А-" + Номер), "РасходСоСчета",
			Новый Структура("СМП_ИДТранзакцииБанка", Идентификатор));
		Подготовка.Операция.ПорядковыйНомер = Номер;
		Результат.Пара = Копия(Подготовка.Операция);
		Результат.Пара.ИдентификаторОперации = СМП_ТестыРаспознавания.НовыйИдентификатор();
		Подготовка.Операция.ИдентификаторОперации = Идентификатор;
		Результат.Операция = Подготовка.Операция;
		Результат.Документ = Основа.Ссылка;
		Результат.ИсточникПары = "ДокументПоНомеру";

	Иначе
		ВызватьИсключение "ПостроитьСлучай: неизвестный ключ '" + Ключ + "'";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Правило "списание, вид Прочее" со статьей ОплатаОтПокупателей (статья по виду для Прочее - "Прочее", поэтому источник
// статьи отличим и по значению).
Функция ПравилоСоСтатьей(ИмяВида)

	Возврат СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", ИмяВида,
		Новый Структура("СтатьяДДС", Статья("ОплатаОтПокупателей"))));

КонецФункции

Функция ОперацияСФразой(Номер, Фраза, НомерСчета = Неопределено)

	Настройки = Новый Структура("ПорядковыйНомер, Направление", Номер, Продукт("СМП_ВыпискаБанка.НаправлениеСписано"));
	Если Не ПустаяСтрока(Фраза) Тогда
		Настройки.Вставить("НазначениеПлатежа", СМП_ТестыРаспознавания.НазначениеСФразами(Фраза));
	КонецЕсли;
	Если НомерСчета <> Неопределено Тогда
		Настройки.Вставить("КонтрагентНомерСчета", НомерСчета);
	КонецЕсли;

	Возврат СМП_ТестыДанныеУНФ.НоваяОперацияКонверта(Настройки);

КонецФункции

Функция Копия(Операция)

	Результат = Новый Структура;
	Для Каждого Элемент Из Операция Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверка строки плана по строке таблицы случаев.
Процедура ПроверитьСтрокуПоСлучаю(Строка, Случай, Описание, ЗагруженныйДокумент = Неопределено)

	ЮТест.ОжидаетЧто(Строка.ИсточникВидаОперации, Описание + ": источник вида").Равно(Случай.Источник);
	Если Не ПустаяСтрока(Случай.Вид) Тогда
		ЮТест.ОжидаетЧто(Строка.ВидОперации, Описание + ": вид операции")
			.Равно(ПредопределенноеЗначение("Перечисление.ВидыОпераций" + Случай.Вид));
	КонецЕсли;
	Если ПустаяСтрока(Случай.ИмяСтатьи) Тогда
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СтатьяДДС), Описание + ": статьи нет").ЭтоЛожь();
	Иначе
		ЮТест.ОжидаетЧто(Строка.СтатьяДДС, Описание + ": статья").Равно(Статья(Случай.ИмяСтатьи));
	КонецЕсли;
	ЮТест.ОжидаетЧто(Строка.ИсточникСтатьи, Описание + ": источник статьи").Равно(Случай.ИсточникСтатьи);
	ЮТест.ОжидаетЧто(Строка.ПроверьтеОперацию, Описание + ": 'Проверьте операцию'").Равно(Случай.ПроверьтеОперацию);
	Если ЗагруженныйДокумент <> Неопределено Тогда
		ЮТест.ОжидаетЧто(Строка.ЗагруженныйДокумент, Описание + ": найденный документ").Равно(ЗагруженныйДокумент);
	КонецЕсли;

КонецПроцедуры

// Один случай таблицы: основная операция даёт ожидаемое; пара (одно отличие) даёт другой источник - то есть условие случая
// действительно причина результата.
Процедура D25_Случай(Название, Ключ) Экспорт

	Случай = СлучайПоКлючу(Ключ);
	Построено = ПостроитьСлучай(Ключ, 1);

	Результат = РаспознатьОперацию(Построено.Операция);

	ПроверитьСтрокуПоСлучаю(Результат.Строка, Случай, Название, Построено.Документ);
	Если Построено.Пара <> Неопределено Тогда
		РезультатПары = РаспознатьОперацию(Построено.Пара);
		ЮТест.ОжидаетЧто(РезультатПары.Строка.ИсточникВидаОперации, Название + " (пара без единого условия): источник вида")
			.Равно(Построено.ИсточникПары);
		ЮТест.ОжидаетЧто(РезультатПары.Строка.ИсточникВидаОперации, Название + " (пара): источник отличается от основного")
			.НеРавно(Случай.Источник);
	КонецЕсли;

КонецПроцедуры

// Таблица покрывает все восемь источников вида (литералы читаются из продукта, не из таблицы) и семь конфликтов; ключи
// уникальны, у каждого есть сценарий.
Процедура D25_ТаблицаПолна() Экспорт

	Литералы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("ИсточникЗагруженныйДокумент,ИсточникСвойСчет,ИсточникНашаОрганизация,ИсточникСотрудник,"
		+ "ИсточникПлатежноеПоручение,ИсточникПравилоНазначения,ИсточникДокументПоНомеру,ИсточникПоУмолчанию", ",") Цикл
		Литералы.Добавить(Продукт("СМП_РаспознаваниеОпераций." + Имя));
	КонецЦикла;
	ЮТест.ОжидаетЧто(Литералы.Количество(), "Предусловие: восемь источников вида").Равно(8);

	Ключи = Новый Соответствие;
	Источники = Новый Соответствие;
	Конфликтов = 0;
	Для Каждого Случай Из ТаблицаD25() Цикл
		ЮТест.ОжидаетЧто(Ключи.Получить(Случай.Ключ) = Неопределено, "Ключ случая уникален: " + Случай.Ключ).ЭтоИстина();
		Ключи.Вставить(Случай.Ключ, Истина);
		Источники.Вставить(Случай.Источник, Истина);
		Если СтрНайти(Случай.Название, "побеждает") > 0 Тогда
			Конфликтов = Конфликтов + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Литерал Из Литералы Цикл
		ЮТест.ОжидаетЧто(Источники.Получить(Литерал) <> Неопределено, "В таблице есть случай с источником '" + Литерал + "'").ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(Конфликтов, "В таблице семь конфликтов 'вышестоящий побеждает нижестоящий'").Равно(7);

КонецПроцедуры

// Review Focus 3 на всем конверте таблицы: все случаи в одном конверте, снимок количеств контрагентов, договоров, банковских
// счетов и документов до и после Распознать равен. Не вакуумно: в конверте есть действия "Создать" (контрагента или договор),
// и каждая строка получила ожидаемый источник вида (то есть конверт действительно разобран).
Процедура D25_ВесьКонверт_НеПишетВБазу() Экспорт

	Операции = НоваяТаблицаОпераций();
	Случаи = ТаблицаD25();
	Номер = 0;
	Построенные = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		Номер = Номер + 1;
		Построено = ПостроитьСлучай(Случай.Ключ, Номер);
		ДобавитьОперацию(Операции, Построено.Операция);
		Построенные.Добавить(Построено);
	КонецЦикла;

	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	План = СМП_ТестыРаспознавания.Распознать(Операции, СМП_ТестыРаспознавания.КонтекстСОрганизацией());
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Создаются = 0;
	Номер = 0;
	Для Каждого Случай Из Случаи Цикл
		Номер = Номер + 1;
		Строка = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, Номер);
		ПроверитьСтрокуПоСлучаю(Строка, Случай, "Конверт, строка " + Номер + " (" + Случай.Название + ")", Построенные[Номер - 1].Документ);
		Если Строка.ДействиеКонтрагент = "Создать" Или Строка.ДействиеДоговор = "Создать" Или Строка.ДействиеСчет = "Создать" Тогда
			Создаются = Создаются + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Создаются > 0, "Предусловие: в конверте есть строки с действием 'Создать'").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После),
		"Количества контрагентов, договоров, счетов и документов до и после Распознать на конверте таблицы D25")
		.Равно(СМП_ТестыРаспознавания.ПредставлениеКоличеств(До));

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыРаспознавания.Продукт(ИмяМетода, Параметры);

КонецФункции

Функция Статья(Имя)

	Возврат ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств." + Имя);

КонецФункции

// Распознает одну операцию. Контекст по умолчанию - по правилу known-state. Результат: План, Строка, Замечания.
Функция РаспознатьОперацию(Операция, Контекст = Неопределено)

	Если Контекст = Неопределено Тогда
		Контекст = СМП_ТестыРаспознавания.КонтекстСОрганизацией();
	КонецЕсли;
	План = СМП_ТестыРаспознавания.Распознать(СМП_ТестыРаспознавания.ТаблицаОпераций(Операция), Контекст);

	Результат = Новый Структура("План, Строка, Замечания");
	Результат.План = План;
	Результат.Строка = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, Операция.ПорядковыйНомер);
	Результат.Замечания = СМП_ТестыРаспознавания.ЗамечанияСтроки(План, Операция.ПорядковыйНомер);

	Возврат Результат;

КонецФункции

Функция НоваяТаблицаОпераций()

	Возврат Продукт("СМП_ВыпискаБанка.НоваяВыписка").Операции;

КонецФункции

Процедура ДобавитьОперацию(Таблица, Операция)

	ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция);

КонецПроцедуры

#КонецОбласти
