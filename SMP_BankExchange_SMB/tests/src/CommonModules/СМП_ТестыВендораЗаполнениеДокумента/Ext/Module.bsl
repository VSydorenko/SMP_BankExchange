		.ЭтоЛожь();

	Контроль = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("Проведен", Истина));
	ЮТест.ОжидаетЧто(ПроведенВБазе(Контроль), Имя + ": предусловие - не испорченный документ проводится").ЭтоИстина();

	Ссылка = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), Имя + ": предусловие - ПроверитьЗаполнение у испорченного документа")
		.ЭтоЛожь();
	ПолучитьСообщенияПользователю(Истина);

	Наблюдения = НаблюдатьОтказПроведения(Объект, ОтдельнаяЗапись);

	// Восстановление: единственный найденный способ. Фикстуры и документ откатываются вместе с транзакцией.
	ОтменитьТранзакцию();
	НачатьТранзакцию();
	ВосстановленаАктивной = ТранзакцияАктивна();
	ВосстановленаЖивой = ЗапросВыполняется();
	ДокументСуществует = СсылкаСуществует(Ссылка);
	КонтрольСуществует = СсылкаСуществует(Контроль);

	ЮТест.ОжидаетЧто(Наблюдения.Исключение, Имя + ": вендор отказал в проведении исключением").ЭтоИстина();
	ЮТест.ОжидаетЧто(Наблюдения.ТранзакцияАктивна, Имя + ": после исключения ТранзакцияАктивна() остается Истина").ЭтоИстина();
	ЮТест.ОжидаетЧто(Наблюдения.ЗапросПосле, Имя + ": запрос в той же транзакции после отказа")
		.Содержит("В данной транзакции уже происходили ошибки");
	ЮТест.ОжидаетЧто(Наблюдения.Причина, Имя + ": причина отказа - в тексте исключения")
		.Содержит("Не заполнен счет кредита");
	ЮТест.ОжидаетЧто(Наблюдения.КоличествоСообщений, Имя + ": ПолучитьСообщенияПользователю(Истина) после исключения")
		.Равно(0);
	ЮТест.ОжидаетЧто(ВосстановленаАктивной, Имя + ": после ОтменитьТранзакцию + НачатьТранзакцию транзакция активна").ЭтоИстина();
	ЮТест.ОжидаетЧто(ВосстановленаЖивой, Имя + ": после восстановления запрос выполняется").ЭтоИстина();
	ЮТест.ОжидаетЧто(ДокументСуществует, Имя + ": документ, которому отказали, после восстановления существует").ЭтоЛожь();
	ЮТест.ОжидаетЧто(КонтрольСуществует, Имя + ": контрольный документ (созданный раньше в той же транзакции) откатился").ЭтоЛожь();

КонецПроцедуры

// (в). ПроверитьЗаполнение() дает Ложь (пуста обязательная статья), вендор при этом проводит: Записать(Проведение)
// проверку заполнения не выполняет. Поэтому продукт вызывает ПроверитьЗаполнение() сам (решение консультанта, п. 1).
// Заодно: ПроверитьЗаполнение не бросает исключение, транзакция жива, текст причины - в сообщениях пользователю.
Процедура ПроверитьЗаполнение_Ложь_ПроведениеПроходит() Экспорт

	Ссылка = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура);
	Объект = Ссылка.ПолучитьОбъект();
	Объект.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();

	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "Предусловие - ПроверитьЗаполнение при пустой статье").ЭтоЛожь();
	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Тексты, " | "), "Сообщения ПроверитьЗаполнение называют поле").Содержит("Статья");
	ЮТест.ОжидаетЧто(ЗапросВыполняется(), "ПроверитьЗаполнение не ломает транзакцию").ЭтоИстина();

	Объект.Записать(РежимЗаписиДокумента.Проведение);

	ЮТест.ОжидаетЧто(ПроведенВБазе(Ссылка), "Записать(Проведение) провел документ, на котором ПроверитьЗаполнение = Ложь")
		.ЭтоИстина();

	// Статья не заполнилась в ходе записи/проведения: перечитанный из базы документ все так же не проходит проверку.
	// Без этого "проведение не проверяет заполнение" могло бы быть "проведение дозаполнило статью, и проверка прошла бы".
	Перечитанный = Ссылка.ПолучитьОбъект();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Перечитанный.Статья), "После проведения статья в базе по-прежнему пуста").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Перечитанный.ПроверитьЗаполнение(), "После проведения ПроверитьЗаполнение перечитанного документа")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Условия

// Условия измерения (шапка модуля) как проверяемые предусловия: красный здесь - сигнал перемерить находки журнала
// (docs/superpowers/plans/2026-10-14-smb-import-platform-04-runs.md, задача 1), а не поломка. Константы и опции только читаются.
Процедура Условия_РежимБазыИзмерения() Экспорт

	ЮТест.ОжидаетЧто(Константы.ВалютаУчета.Получить(), "Условие: валюта учета отличается от национальной")
		.НеРавно(Константы.НациональнаяВалюта.Получить());
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("УчетПоПроектам"), "Условие: учет по проектам включен").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("ОтображатьСчетаУчета"), "Условие: счета учета (корреспонденция) отображаются")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("ПлатежныйКалендарь"), "Условие: платежный календарь включен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Константы.КонтролироватьОстаткиПриПроведении.Получить(), "Условие: контроль остатков при проведении выключен")
		.ЭтоЛожь();
	Организация = СМП_ТестыДанныеУНФ.Организация();
	ЮТест.ОжидаетЧто(НалогиУНФ.НалогообложениеНДС(Организация,, ТекущаяДатаСеанса()), "Условие: организация фикстуры не платит НДС")
		.Равно(Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	ЮТест.ОжидаетЧто(Организация.ЮридическоеФизическоеЛицо, "Условие: организация фикстуры - физлицо-предприниматель")
		.Равно(Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Пользователи.ТекущийПользователь()), "Условие: пользователь сеанса определен").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ТочкаВхода

// D16: Заполнить(Структура) -> ОбработкаЗаполнения -> ЗаполнениеОбъектовУНФ.ЗаполнитьДокумент ставит автора ПОЛЬЗОВАТЕЛЕМ СЕАНСА
// и перезаписывает им переданный в данных ключ Автор (Вставить после данных). Для регламента, идущего от чужого имени, автора
// надо присваивать ПОСЛЕ заполнения.
Процедура Заполнить_АвторСеансаПерезаписываетПереданного(ИмяДокумента) Экспорт

	Двое = ДваПользователя();
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация, Автор", ВидПоУмолчанию(ИмяДокумента),
		СМП_ТестыДанныеУНФ.Организация(), Двое.Другой));

	ЮТест.ОжидаетЧто(Документ.Автор, ИмяДокумента + ": автор после Заполнить(Автор = другому)").Равно(Двое.Сеанс);
	ЮТест.ОжидаетЧто(Двое.Другой, "Предусловие: переданный пользователь отличается от пользователя сеанса").НеРавно(Двое.Сеанс);

КонецПроцедуры

// D16: без ключей в данных подразделение (шапка расхода) и положения статьи/подразделения/проекта берутся из настроек
// пользователя СЕАНСА, а не из настроек другого пользователя.
Процедура Заполнить_БерутНастройкиСеансаКогдаКлючейНет(ИмяДокумента) Экспорт

	Двое = ДваПользователя();
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация", ВидПоУмолчанию(ИмяДокумента), СМП_ТестыДанныеУНФ.Организация()));

	ЮТест.ОжидаетЧто(Документ.ПоложениеСтатьи, ИмяДокумента + ": положение статьи - как у сеанса").Равно(Двое.ПоложенияСеанса.Статья);
	ЮТест.ОжидаетЧто(Документ.ПоложениеПодразделения, ИмяДокумента + ": положение подразделения - как у сеанса")
		.Равно(Двое.ПоложенияСеанса.Подразделение);
	ЮТест.ОжидаетЧто(Документ.ПоложениеПроекта, ИмяДокумента + ": положение проекта - как у сеанса").Равно(Двое.ПоложенияСеанса.Проект);
	Если ИмяДокумента = "РасходСоСчета" Тогда
		ЮТест.ОжидаетЧто(Документ.Подразделение, "РасходСоСчета: подразделение - основное подразделение сеанса").Равно(Двое.ПодрСеанса);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Двое.ПоложенияДругого.Статья, "Предусловие: положение статьи другого пользователя отличается")
		.НеРавно(Двое.ПоложенияСеанса.Статья);

КонецПроцедуры

// D16, замена: ключи, переданные в данных заполнения, побеждают настройки сеанса (ДополнитьСтруктуру без перезаписи), поэтому
// настройки ответственного можно подать ключами и автора присвоить после. Документ после такого заполнения - как у другого пользователя.
Процедура Заполнить_КлючиДанныхПобеждаютНастройкиСеанса(ИмяДокумента) Экспорт

	Двое = ДваПользователя();
	Данные = Новый Структура("ВидОперации, Организация, ПоложениеСтатьи, ПоложениеПодразделения, ПоложениеПроекта",
		ВидПоУмолчанию(ИмяДокумента), СМП_ТестыДанныеУНФ.Организация(), Двое.ПоложенияДругого.Статья,
		Двое.ПоложенияДругого.Подразделение, Двое.ПоложенияДругого.Проект);
	Если ИмяДокумента = "РасходСоСчета" Тогда
		Данные.Вставить("Подразделение", Двое.ПодрДругого);
	КонецЕсли;
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Данные);
	Документ.Автор = Двое.Другой;

	ЮТест.ОжидаетЧто(Документ.ПоложениеСтатьи, ИмяДокумента + ": положение статьи из данных").Равно(Двое.ПоложенияДругого.Статья);
	ЮТест.ОжидаетЧто(Документ.ПоложениеПодразделения, ИмяДокумента + ": положение подразделения из данных")
		.Равно(Двое.ПоложенияДругого.Подразделение);
	ЮТест.ОжидаетЧто(Документ.ПоложениеПроекта, ИмяДокумента + ": положение проекта из данных").Равно(Двое.ПоложенияДругого.Проект);
	Если ИмяДокумента = "РасходСоСчета" Тогда
		ЮТест.ОжидаетЧто(Документ.Подразделение, "РасходСоСчета: подразделение из данных").Равно(Двое.ПодрДругого);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Документ.Автор, ИмяДокумента + ": автор присвоен после заполнения").Равно(Двое.Другой);

КонецПроцедуры

// ЗаполнитьДокумент вставляет Автор (и разыменованные поля) в ТУ ЖЕ структуру, которую передал вызывающий: структуру плана
// нельзя использовать повторно после Заполнить. Контроль: до вызова ключей нет.
Процедура Заполнить_МутируетПереданнуюСтруктуру(ИмяДокумента) Экспорт

	Данные = Новый Структура("ВидОперации, Организация", ВидПоУмолчанию(ИмяДокумента), СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(Данные.Свойство("Автор"), "Предусловие: до Заполнить ключа Автор в структуре нет").ЭтоЛожь();

	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Данные);

	ЮТест.ОжидаетЧто(Данные.Свойство("Автор"), ИмяДокумента + ": после Заполнить в переданной структуре появился ключ Автор").ЭтоИстина();
	ЮТест.ОжидаетЧто(Данные.Количество(), ИмяДокумента + ": структура выросла (разыменованные поля)").Больше(2);

КонецПроцедуры

// D16: функция вендора принимает пользователя ЯВНО и читает настройки именно его (кандидат для регламента).
Процедура ПолучитьЗначениеПоУмолчанию_ЧитаетНастройкиПереданногоПользователя() Экспорт

	Двое = ДваПользователя();
	Подразделение = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Двое.Другой, "ОсновноеПодразделение");
	ПодразделениеСеанса = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Двое.Сеанс, "ОсновноеПодразделение");

	ЮТест.ОжидаетЧто(Подразделение, "Основное подразделение переданного пользователя").Равно(Двое.ПодрДругого);
	ЮТест.ОжидаетЧто(ПодразделениеСеанса, "Основное подразделение пользователя сеанса, переданного явно").Равно(Двое.ПодрСеанса);
	ЮТест.ОжидаетЧто(Двое.ПодрДругого, "Предусловие: подразделения различаются").НеРавно(Двое.ПодрСеанса);

КонецПроцедуры

// Точка входа на УЖЕ ЗАПИСАННОМ документе (заполнение наявного документа тем же кодом, этап 6): Автор перезаписывается
// пользователем сеанса; заполненные настройки (подразделение, положения) и статья не затираются; ключ данных перезаписывает.
Процедура Заполнить_НаЗаписанномДокументе(ИмяДокумента) Экспорт

	Двое = ДваПользователя();
	Ссылка = СМП_ТестыДанныеУНФ.НовыйБанковскийДокумент(Новый Структура("ВидДокумента", ИмяДокумента));
	Документ = Ссылка.ПолучитьОбъект();
	Документ.Автор = Двое.Другой;
	Документ.ПоложениеСтатьи = Двое.ПоложенияДругого.Статья;
	Документ.Статья = Справочники.СтатьиДвиженияДенежныхСредств.Прочее;
	Если ИмяДокумента = "РасходСоСчета" Тогда
		Документ.Подразделение = Двое.ПодрДругого;
	КонецЕсли;
	Контрагент = Документ.Контрагент;

	Документ.Заполнить(Новый Структура("ВидОперации", Документ.ВидОперации));

	ЮТест.ОжидаетЧто(Документ.Автор, ИмяДокумента + ": автор записанного документа перезаписан пользователем сеанса").Равно(Двое.Сеанс);
	ЮТест.ОжидаетЧто(Документ.ПоложениеСтатьи, ИмяДокумента + ": заполненное положение статьи не затерто").Равно(Двое.ПоложенияДругого.Статья);
	ЮТест.ОжидаетЧто(Документ.Статья, ИмяДокумента + ": заполненная статья не затерта").Равно(Справочники.СтатьиДвиженияДенежныхСредств.Прочее);
	ЮТест.ОжидаетЧто(Документ.Контрагент, ИмяДокумента + ": контрагент записанного документа не затерт").Равно(Контрагент);
	Если ИмяДокумента = "РасходСоСчета" Тогда
		ЮТест.ОжидаетЧто(Документ.Подразделение, "РасходСоСчета: заполненное подразделение не затерто").Равно(Двое.ПодрДругого);
	КонецЕсли;

	// Ключ данных перезаписывает заполненный реквизит.
	Документ.Заполнить(Новый Структура("ВидОперации, ПоложениеСтатьи", Документ.ВидОперации, Двое.ПоложенияСеанса.Статья));
	ЮТест.ОжидаетЧто(Документ.ПоложениеСтатьи, ИмяДокумента + ": ключ данных перезаписал заполненное положение статьи")
		.Равно(Двое.ПоложенияСеанса.Статья);

КонецПроцедуры

#КонецОбласти

#Область ЗначенияПоУмолчанию

// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану (стаття "як формою", по виду операції): Заполнить ставить статтю за ДОКУМЕНТОМ
// (ПоступлениеНаСчет - "Оплата від покупців", РасходСоСчета - "Оплата постачальникам"), вид операції не враховує; по виду операції
// статтю виправляє лише обробник форми (УстановитьСтатьюДДСПриСменеВидаОперации), якого з сервера не викликати. Для виду "по виду" є
// вендорська функція ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС (див. СтатьяПоВидуОперации_ВендорскаяФункцияБезФормы).
Процедура Заполнить_СтатьяПоУмолчаниюПоДокументуНеПоВиду(Вид, ИмяСтатьи) Экспорт

	Документ = НовыйПустойДокументВида(Вид);

	ЮТест.ОжидаетЧто(Документ.Статья, Вид + ": статья после Заполнить (по документу, не по виду)")
		.Равно(Справочники.СтатьиДвиженияДенежныхСредств[ИмяСтатьи]);

КонецПроцедуры

// D15: вендорская функция статьи вызывается с сервера БЕЗ формы (достаточно структуры с ключом Объект) и дает статью по виду.
Процедура СтатьяПоВидуОперации_ВендорскаяФункцияБезФормы(Вид, ИмяСтатьи) Экспорт

	Документ = НовыйПустойДокументВида(Вид);
	Документ.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();

	Данные = ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС(Новый Структура("Объект", Документ));

	ЮТест.ОжидаетЧто(Данные.Статья, Вид + ": статья вендорской функции ПолучитьДанныеСтатьиДДС")
		.Равно(Справочники.СтатьиДвиженияДенежныхСредств[ИмяСтатьи]);

КонецПроцедуры

// D15: статья контрагента по умолчанию приоритетнее статьи вида операции (первая ветка ПолучитьДанныеСтатьиДДС).
Процедура СтатьяПоВидуОперации_СтатьяКонтрагентаПриоритетнее() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам,СтатьяДДСПоУмолчанию",
		Истина, Ложь, Ложь, Ложь, Справочники.СтатьиДвиженияДенежныхСредств.Прочее));
	Документ = НовыйПустойДокументВида("РасходСоСчета.Поставщику");
	Документ.Контрагент = Контрагент;

	Данные = ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС(Новый Структура("Объект", Документ));

	ЮТест.ОжидаетЧто(Данные.Статья, "Статья контрагента вместо статьи вида операции").Равно(Справочники.СтатьиДвиженияДенежныхСредств.Прочее);

КонецПроцедуры

// D15, гипотеза: Заполнить(Структура с контрагентом и договором) создает строку расшифровки с договором и ставкой НДС.
Процедура Заполнить_СДоговоромСтрокуРасшифровкиНеСоздает(ИмяДокумента) Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", Перечисления.ВидыДоговоров.СПокупателем));
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация, Контрагент, Договор", ВидПоУмолчанию(ИмяДокумента),
		СМП_ТестыДанныеУНФ.Организация(), Контрагент, Договор));

	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану (Заполнить з контрагентом і договором створює рядок): ОбработкаЗаполнения
	// зі структурою (ЗаполнитьПоСтруктуре) без ключів Основание/Документ нічого не робить з ТЧ; договір, ставку НДС, курс,
	// статтю ДДС і проект рядка ставить обробник ФОРМИ (КонтрагентПриИзменении), який з сервера не викликається.
	ЮТест.ОжидаетЧто(Документ.РасшифровкаПлатежа.Количество(), ИмяДокумента + ": строк расшифровки после Заполнить с договором")
		.Равно(0);
	ЮТест.ОжидаетЧто(Документ.Контрагент, ИмяДокумента + ": контрагент из данных заполнения попал в шапку").Равно(Контрагент);

КонецПроцедуры

// D15: ставка НДС по договору. Источник - вендорская функция формы РасходСоСчета (в форме ПоступлениеНаСчет ее вызова нет).
// Способ "Автоматически" функция способа договора возвращает ПУСТЫМ (читает регистр ставок по договорам), поэтому ставка - по организации.
Процедура СтавкаНДСПоДоговору_ПоСпособуЗаполнения(ИмяСпособа, ЧтоОжидаем, ИмяОжидаемогоСпособа) Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Дата = ТекущаяДатаСеанса();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь));
	Настройки = ?(ИмяСпособа = "Пусто", Новый Структура,
		Новый Структура("СпособЗаполненияСтавкиНДС", Перечисления.СпособыЗаполненияСтавкиНДС[ИмяСпособа]));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Настройки);

	Способ = Справочники.ДоговорыКонтрагентов.СпособЗаполненияСтавкиНДСПоДоговору(Договор);
	Ставка = РасчетыРаботаСФормамиВызовСервера.СтавкаНДСПоОрганизацииНалогообложениеНДСИСпособуЗаполнения(Организация, Дата, Способ);

	Если ЧтоОжидаем = "Организация" Тогда
		Ожидаемая = Справочники.СтавкиНДС.СтавкаНДС(Организация.ВидСтавкиНДСПоУмолчанию, Дата);
	ИначеЕсли ЧтоОжидаем = "БезНДС" Тогда
		Ожидаемая = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.БезНДС, Дата);
	Иначе
		Ожидаемая = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Общая, Дата);
	КонецЕсли;
	// Способ договора утверждается отдельно (функция способа отдает пусто для 'Пусто' и 'Автоматически'). Ставки 'Пусто'/'Автоматически'
	// (за организацией: 'Не ПДВ'), 'БезНДС' ('Без ПДВ') и 'ИзКарточкиНоменклатуры' ('Общая') на этой организации различимы по ставке.
	ОжидаемыйСпособ = ?(ПустаяСтрока(ИмяОжидаемогоСпособа), Перечисления.СпособыЗаполненияСтавкиНДС.ПустаяСсылка(),
		Перечисления.СпособыЗаполненияСтавкиНДС[ИмяОжидаемогоСпособа]);
	ЮТест.ОжидаетЧто(Способ, "Способ, который отдает функция способа договора при '" + ИмяСпособа + "'").Равно(ОжидаемыйСпособ);
	ЮТест.ОжидаетЧто(Справочники.СтавкиНДС.СтавкаНДС(Организация.ВидСтавкиНДСПоУмолчанию, Дата),
		"Предусловие: ставка организации фикстуры (""Не ПДВ"") отличается от ставки ""Без ПДВ"": ""за организацией"" и ""БезНДС"" по ставке различимы")
		.НеРавно(Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.БезНДС, Дата));
	ЮТест.ОжидаетЧто(Ставка, "Ставка НДС по способу '" + ИмяСпособа + "' (источник ставки: " + ЧтоОжидаем + ")").Равно(Ожидаемая);

КонецПроцедуры

// D15: "без ПДВ" - ставка "Без ПДВ" с числом 0, отдельная от ставки "0%"; СуммаНДС считает вендорская
// РасчетыРаботаСФормамиВызовСервера.РассчитатьСуммуНДСНаСервере (без собственной копии формулы). Контроль, что функция
// считает, а не обнуляет: на ставке "Общая" та же функция дает ненулевую сумму.
Процедура БезПДВ_СтавкаИСуммаНДС() Экспорт

	БезНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС();
	Ноль = УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСНоль();
	Число = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(БезНДС);

	Строка = Документы.ПоступлениеНаСчет.СоздатьДокумент().РасшифровкаПлатежа.Добавить();
	Строка.СуммаПлатежа = 120;
	Строка.СтавкаНДС = БезНДС;
	Строка.СуммаНДС = 5;
	РасчетыРаботаСФормамиВызовСервера.РассчитатьСуммуНДСНаСервере(Строка);
	СуммаБезНДС = Строка.СуммаНДС;
	Строка.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Перечисления.ВидыСтавокНДС.Общая, ТекущаяДатаСеанса());
	РасчетыРаботаСФормамиВызовСервера.РассчитатьСуммуНДСНаСервере(Строка);

	ЮТест.ОжидаетЧто(БезНДС, "Ставки 'Без ПДВ' и '0%' - разные значения").НеРавно(Ноль);
	ЮТест.ОжидаетЧто(Число, "Числовое значение ставки 'Без ПДВ'").Равно(0);
	ЮТест.ОжидаетЧто(СуммаБезНДС, "СуммаНДС, посчитанная вендором по ставке 'Без ПДВ' (до вызова была 5)").Равно(0);
	ЮТест.ОжидаетЧто(Строка.СуммаНДС, "Контроль: СуммаНДС вендора по ставке 'Общая' (20%) от 120").Равно(20);
	Ставка = Неопределено;
	ЧислоСтавки = Неопределено;
	РасчетыРаботаСФормамиВызовСервера.ЗаполнитьСтавкуНДСПоУмолчанию(Ставка, ЧислоСтавки,
		Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС, СМП_ТестыДанныеУНФ.Организация());
	ЮТест.ОжидаетЧто(Ставка, "Ставка по умолчанию при налогообложении 'Не облагается'").Равно(БезНДС);

КонецПроцедуры

// D15: проект договора при включенном учете по проектам - вендорской функцией; нет проекта у договора - пусто.
// Дату функция берет от ТекущаяДатаСеанса(), а не от даты документа.
Процедура ПроектПоДоговору_ВендорскаяФункция() Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент);
	БезПроекта = Справочники.Проекты.ПолучитьПроектПоДоговору(Договор);
	Проект = СМП_ТестыДанныеУНФ.НовыйПроект(Новый Структура("Договор", Договор));
	СПроектом = Справочники.Проекты.ПолучитьПроектПоДоговору(Договор);

	ЮТест.ОжидаетЧто(ПолучитьФункциональнуюОпцию("УчетПоПроектам"), "Условие: учет по проектам включен").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(БезПроекта), "Проект договора без проектов").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СПроектом, "Проект договора").Равно(Проект);

КонецПроцедуры

// D15: Заполнить с договором, у которого есть проект, проект документа НЕ ставит (его ставит обработчик формы).
Процедура Заполнить_ПроектДоговораВДокументНеСтавится(ИмяДокумента) Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент);
	Проект = СМП_ТестыДанныеУНФ.НовыйПроект(Новый Структура("Договор", Договор));
	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация, Контрагент, Договор", ВидПоУмолчанию(ИмяДокумента),
		СМП_ТестыДанныеУНФ.Организация(), Контрагент, Договор));

	// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану (проект за договором ставить Заполнить): проект порожній; його ставить
	// обробник форми з Справочники.Проекты.ПолучитьПроектПоДоговору (див. ПроектПоДоговору_ВендорскаяФункция).
	ЮТест.ОжидаетЧто(Проект, "Предусловие: у договора есть проект").НеРавно(Справочники.Проекты.ПустаяСсылка());
	ЮТест.ОжидаетЧто(Документ.Проект, ИмяДокумента + ": проект в шапке после Заполнить с договором").Равно(Справочники.Проекты.ПустаяСсылка());

КонецПроцедуры

// D15: договор по умолчанию для документа - вендорской функцией (форма: ПолучитьДанныеКонтрагентПриИзменении).
Процедура ДоговорПоУмолчанию_ВендорскаяФункцияДаетОсновнойДоговорВида() Экспорт

	Организация = СМП_ТестыДанныеУНФ.Организация();
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора, Основной", Перечисления.ВидыДоговоров.СПокупателем, Истина));

	Найденный = Справочники.ДоговорыКонтрагентов.ПоДокументуКонтрагентуОрганизацииИВидуОперации(
		Документы.ПоступлениеНаСчет.ПустаяСсылка(), Контрагент, Организация, Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);

	ЮТест.ОжидаетЧто(Найденный, "Договор по умолчанию для вида 'От покупателя'").Равно(Договор);

КонецПроцедуры

// D15: положение статьи/проекта/подразделения определяет, где живет значение после записи. ВШапке - значение шапки
// переносится в строки; ВТабличнойЧасти - значение строки переносится в шапку (РасчетыПроведениеДокументов.
// ОбработатьРеквизитыШапкаТабличнаяЧастьПередЗаписью). Подразделение в ПоступлениеНаСчет - реквизит ПодразделениеЗатраты.
Процедура Положение_ГдеЖиветЗначениеПослеЗаписи(ИмяДокумента, Реквизит, ВШапке) Экспорт

	Положение = ?(ВШапке, Перечисления.ПоложениеРеквизитаНаФорме.ВШапке, Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти);
	ИмяШапки = Реквизит;
	Если Реквизит = "Подразделение" И ИмяДокумента = "ПоступлениеНаСчет" Тогда
		ИмяШапки = "ПодразделениеЗатраты";
	КонецЕсли;
	ИмяСтроки = ?(Реквизит = "Статья", "СтатьяДДС", Реквизит);
	ИменаПоложений = Новый Структура("Статья, Проект, Подразделение", "ПоложениеСтатьи", "ПоложениеПроекта", "ПоложениеПодразделения");
	ИмяПоложения = ИменаПоложений[Реквизит];
	Если Реквизит = "Статья" Тогда
		ЗначениеШапки = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей;
		ЗначениеСтроки = Справочники.СтатьиДвиженияДенежныхСредств.Прочее;
	ИначеЕсли Реквизит = "Проект" Тогда
		ЗначениеШапки = СМП_ТестыДанныеУНФ.НовыйПроект();
		ЗначениеСтроки = СМП_ТестыДанныеУНФ.НовыйПроект();
	Иначе
		ЗначениеШапки = СМП_ТестыДанныеУНФ.НовоеПодразделение();
		ЗначениеСтроки = СМП_ТестыДанныеУНФ.НовоеПодразделение();
	КонецЕсли;

	Документ = СобратьДокументПоВиду(ИмяДокумента + "." + ?(ИмяДокумента = "ПоступлениеНаСчет", "ОтПокупателя", "Поставщику"), СМП_ТестыДанныеУНФ.Организация());
	Документ[ИмяШапки] = ЗначениеШапки;
	Документ.РасшифровкаПлатежа[0][ИмяСтроки] = ЗначениеСтроки;
	Документ[ИмяПоложения] = Положение;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	Прочитанный = Документ.Ссылка.ПолучитьОбъект();
	Если ВШапке Тогда
		ЮТест.ОжидаетЧто(Прочитанный[ИмяШапки], ИмяДокумента + "/" + Реквизит + "/ВШапке: шапка хранит свое значение").Равно(ЗначениеШапки);
		ЮТест.ОжидаетЧто(Прочитанный.РасшифровкаПлатежа[0][ИмяСтроки], ИмяДокумента + "/" + Реквизит + "/ВШапке: строка получила значение шапки")
			.Равно(ЗначениеШапки);
	Иначе
		ЮТест.ОжидаетЧто(Прочитанный.РасшифровкаПлатежа[0][ИмяСтроки], ИмяДокумента + "/" + Реквизит + "/ВТабличнойЧасти: строка хранит свое значение")
			.Равно(ЗначениеСтроки);
		ЮТест.ОжидаетЧто(Прочитанный[ИмяШапки], ИмяДокумента + "/" + Реквизит + "/ВТабличнойЧасти: шапка получила значение строки")
			.Равно(ЗначениеСтроки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВидыОперации

// Минимальный набор: рецепт СобратьДокументПоВиду - документ проходит ПроверитьЗаполнение() и проводится.
Процедура ВидОперации_ДостаточныйНаборПроходитПроверкуИПроводится(Вид) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	ПолучитьСообщенияПользователю(Истина);
	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();

	Проведение = ПровестиСВосстановлением(Документ);
	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение(); сообщения: " + Сообщения).ЭтоИстина();
	ЮТест.ОжидаетЧто(Проведение.Исключение, Вид + ": исключение проведения").Равно("");
	ЮТест.ОжидаетЧто(Проведение.Проведен, Вид + ": документ проведен").ЭтоИстина();

КонецПроцедуры

// Без обязательного для вида реквизита ПроверитьЗаполнение() дает Ложь и называет поле в сообщении пользователю.
Процедура ВидОперации_БезОбязательногоРеквизитаСообщаетПоле(Вид, Реквизит, ФрагментСообщения) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	ПустоеЗначение = Документ.Метаданные().Реквизиты[Реквизит].Тип.ПривестиЗначение(Неопределено);
	Документ[Реквизит] = ПустоеЗначение;
	ПолучитьСообщенияПользователю(Истина);

	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();

	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение без '" + Реквизит + "'").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Сообщения, Вид + ": сообщение называет поле '" + Реквизит + "'").Содержит(ФрагментСообщения);

КонецПроцедуры

// ВИМІРЯНО 2026-10-14: для кореспонденції "Прочие расходы" (ТипСчета не "Расходы") ПроверитьЗаполнение проходить і з порожнім
// Подразделением (ВидыОперации Прочее, НаРасходы, КомиссияБанка). Позитивна половина (тип "Расходы" -> підрозділ
// обов'язковий) - тест ВидОперации_ПодразделениеШапкиПроверкойНеТребуетсяИДляСчетаТипаРасходы.
Процедура ВидОперации_ПодразделениеНеОбязательноДляПрочихРасходов(Вид) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	Документ.Подразделение = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	ПолучитьСообщенияПользователю(Истина);

	Прошла = Документ.ПроверитьЗаполнение();

	ЮТест.ОжидаетЧто(Документ.Корреспонденция.ТипСчета, Вид + ": предусловие - тип счета корреспонденции не ""Расходы""")
		.НеРавно(Перечисления.ТипыСчетов.Расходы);
	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение с пустым подразделением; сообщения: " + ТекстыСообщений()).ЭтоИстина();

КонецПроцедуры

// ВИМІРЯНО 2026-10-14: позитивна половина гіпотези ("для рахунку типу Расходы підрозділ обов'язковий", з читання коду) СПРОСТОВАНА:
// з першим не помеченим рахунком типу "Расходы" і порожнім Подразделением ПроверитьЗаполнение проходить. Реквізит шапки Подразделение у
// метаданих має FillChecking = DontCheck, а УдалитьПроверяемыйРеквизит у модулі його лише знімає, тож пояснення "за ТипСчета" було хибним:
// шапка не перевіряється ні для яких типів (виміряно на одному рахунку типу "Расходы"; інші типи не мірялись).
Процедура ВидОперации_ПодразделениеШапкиПроверкойНеТребуетсяИДляСчетаТипаРасходы(Вид) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ ПланСчетов.Управленческий КАК С
		|ГДЕ С.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Расходы) И НЕ С.ПометкаУдаления УПОРЯДОЧИТЬ ПО С.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Предусловие (база): в плане счетов есть счет типа ""Расходы""").ЭтоИстина();

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	Документ.Корреспонденция = Выборка.Ссылка;
	Документ.Подразделение = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
	ПолучитьСообщенияПользователю(Истина);

	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();

	ЮТест.ОжидаетЧто(Документ.Корреспонденция.ТипСчета, Вид + ": предусловие - тип счета корреспонденции ""Расходы""")
		.Равно(Перечисления.ТипыСчетов.Расходы);
	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение без подразделения при счете ""Расходы""; сообщения: " + Сообщения).ЭтоИстина();

КонецПроцедуры

// Виды, для проведения которых нужны данные вендорских подсистем (эквайринг, кредиты и займы, платежная ведомость):
// ПроверитьЗаполнение без них отклоняет документ. Проведение с этими данными НЕ измерено (нужны терминал, договор кредита,
// ведомость - фикстур нет).
Процедура ВидОперации_ТребуетДанныхВендорскихПодсистем(Вид, ФрагментСообщения) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	ПолучитьСообщенияПользователю(Истина);

	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();

	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение без данных вендорской подсистемы").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Сообщения, Вид + ": сообщение называет недостающее").Содержит(ФрагментСообщения);

КонецПроцедуры

// ВИМІРЯНО 2026-10-14: суперечить гіпотезі плану (Заполнить ставить кореспонденцію видів без розрахунків): не ставить, порожньо.
// Кореспонденцію "Нерозподілений прибуток" (особисті кошти) і "Інші витрати" (комісія банку) ставить лише приватна процедура форми
// ФормыДокументовДеньги.ЗаполнитьКорреспонденцию (не експортна) - власний код продукту з цим джерелом.
Процедура Заполнить_КорреспонденциюВидаБезРасчетовНеСтавит(Вид, ИмяСчета) Экспорт

	Документ = НовыйПустойДокументВида(Вид);

	ЮТест.ОжидаетЧто(Документ.Корреспонденция, Вид + ": корреспонденция после Заполнить (вендор не ставит; форма поставила бы " + ИмяСчета + ")")
		.Равно(ПланыСчетов.Управленческий.ПустаяСсылка());

КонецПроцедуры

// Перевод между своими счетами: корреспонденцию вендор ставит при ЗАПИСИ (ПередЗаписью), "Переводы в пути", когда в базе
// применяются переводы в пути; второй счет - в СчетКонтрагента (реквизит, а не контрагент).
Процедура Перевод_КорреспонденцияСтавитсяПриЗаписи(Вид) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	Применяются = РегистрыСведений.ПрименениеПереводовВПути.ИспользуютсяПереводыВПути(Документ.Дата,
		Константы.УчетПоКомпании.Компания(Документ.Организация));
	ЮТест.ОжидаетЧто(Применяются, "Условие: в базе применяются переводы в пути").ЭтоИстина();
	ЮТест.ОжидаетЧто(Документ.Корреспонденция, Вид + ": корреспонденция до записи пуста").Равно(ПланыСчетов.Управленческий.ПустаяСсылка());

	Документ.Записать(РежимЗаписиДокумента.Запись);

	ЮТест.ОжидаетЧто(Документ.Корреспонденция, Вид + ": корреспонденция после записи").Равно(ПланыСчетов.Управленческий.ПереводыВПути);
	ЮТест.ОжидаетЧто(ТипЗнч(Документ.СчетКонтрагента.Владелец), Вид + ": владелец второго счета - организация")
		.Равно(Тип("СправочникСсылка.Организации"));
	ЮТест.ОжидаетЧто(Документ.Контрагент, Вид + ": контрагент не нужен").Равно(Справочники.Контрагенты.ПустаяСсылка());

КонецПроцедуры

// Вид "Нашей организации" / "От нашей организации": вендор принимает СчетКонтрагента с владельцем-ОРГАНИЗАЦИЕЙ, контрагент -
// КонтрагентИнтеркампани этой организации; документ проходит проверку и проводится (рецепт СобратьДокументПоВиду).
Процедура НашаОрганизация_ПринимаетСчетСВладельцемОрганизацией(Вид) Экспорт

	Документ = СобратьДокументПоВиду(Вид, СМП_ТестыДанныеУНФ.Организация());
	ВладелецСчета = Документ.СчетКонтрагента.Владелец;
	ПолучитьСообщенияПользователю(Истина);
	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();
	Проведение = ПровестиСВосстановлением(Документ);

	ЮТест.ОжидаетЧто(ТипЗнч(ВладелецСчета), Вид + ": предусловие - владелец счета контрагента - организация")
		.Равно(Тип("СправочникСсылка.Организации"));
	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение; сообщения: " + Сообщения).ЭтоИстина();
	ЮТест.ОжидаетЧто(Проведение.Проведен, Вид + ": проведен (исключение: " + Проведение.Исключение + ")").ЭтоИстина();

КонецПроцедуры

// "Личные средства предпринимателя" при организации - ЮРЛИЦЕ. Вендорский ОбработкаЗаполнения очищает организацию-юрлицо, но
// ВИМІРЯНО 2026-10-14 (суперечить очікуванню "для документа з виписки організацію очищено"): очищення спрацьовує лише на
// Заполнить(Неопределено) після присвоєння виду. На Заполнить(Структура) - з ключем Организация чи без нього (тоді організацію
// сеансу в дані вставляє ЗаполнитьДокумент) - організація-юрлице ЛИШАЄТЬСЯ в документі (МЕХАНІЗМ - ГІПОТЕЗА, не доведена: код ОбработкаЗаполнения очищає
// організацію безумовно, а виміряно лише результат), і документ проходить проверку и проводится
// (см. ЛичныеСредства_ЮрлицоВДокументеПроверкаИПроведение). Продукт передает организацию плана ключом: вендорское очищение его не касается.
// Организация-юрлицо берется из базы (первая не помеченная; нет - тест пропускает себя явно).
Процедура ЛичныеСредства_ОчищениеОрганизацииЮрлицаТолькоНаПустыхДанных(ИмяДокумента) Экспорт

	Организация = ОрганизацияЮрлицо();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ЮТест.Пропустить("В базе нет организации-юрлица: измерение невозможно");
		Возврат;
	КонецЕсли;
	Вид = ИмяДокумента + ".ЛичныеСредстваПредпринимателя";
	ВидОперации = ВидПоУмолчанию(ИмяДокумента, "ЛичныеСредстваПредпринимателя");

	БезКлюча = Документы[ИмяДокумента].СоздатьДокумент();
	БезКлюча.Заполнить(Новый Структура("ВидОперации", ВидОперации));
	СКлючом = Документы[ИмяДокумента].СоздатьДокумент();
	СКлючом.Заполнить(Новый Структура("ВидОперации, Организация", ВидОперации, Организация));
	БезДанных = Документы[ИмяДокумента].СоздатьДокумент();
	БезДанных.ВидОперации = ВидОперации;
	БезДанных.Заполнить(Неопределено);

	ОрганизацияСеанса = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Пользователи.ТекущийПользователь(), "ОсновнаяОрганизация");
	ЮТест.ОжидаетЧто(ОрганизацияСеанса.ЮридическоеФизическоеЛицо, "Предусловие (база): основная организация пользователя сеанса - юрлицо (иначе тест БезКлюча не о том)")
		.Равно(Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	ЮТест.ОжидаетЧто(БезКлюча.Организация, "Предусловие: организация, подставленная заполнением, - основная организация сеанса").Равно(ОрганизацияСеанса);
	ЮТест.ОжидаетЧто(Организация.ЮридическоеФизическоеЛицо, "Предусловие: организация из базы - юрлицо").Равно(Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	ЮТест.ОжидаетЧто(БезДанных.Организация, Вид + ": Заполнить(Неопределено) после присвоения вида очищает организацию-юрлицо (вендорская ветка)")
		.Равно(Справочники.Организации.ПустаяСсылка());
	ЮТест.ОжидаетЧто(БезКлюча.Организация.ЮридическоеФизическоеЛицо, Вид + ": Заполнить(Структура) без ключа организации оставляет организацию сеанса (юрлицо)")
		.Равно(Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	ЮТест.ОжидаетЧто(СКлючом.Организация, Вид + ": организация, переданная ключом данных, остается в документе").Равно(Организация);

КонецПроцедуры

// Документ "Личные средства предпринимателя" для организации-юрлица (организация осталась в документе): проходит ли он
// проверку заполнения и проводится ли.
Процедура ЛичныеСредства_ЮрлицоВДокументеПроверкаИПроведение(ИмяДокумента) Экспорт

	Организация = ОрганизацияЮрлицо();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ЮТест.Пропустить("В базе нет организации-юрлица: измерение невозможно");
		Возврат;
	КонецЕсли;
	Вид = ИмяДокумента + ".ЛичныеСредстваПредпринимателя";

	Документ = СобратьДокументПоВиду(Вид, Организация);
	ПолучитьСообщенияПользователю(Истина);
	Прошла = Документ.ПроверитьЗаполнение();
	Сообщения = ТекстыСообщений();
	Проведение = ПровестиСВосстановлением(Документ);

	ЮТест.ОжидаетЧто(Прошла, Вид + ": ПроверитьЗаполнение для юрлица; сообщения: " + Сообщения).ЭтоИстина();
	ЮТест.ОжидаетЧто(Проведение.Проведен, Вид + ": проведен для юрлица (исключение: " + Проведение.Исключение + ")").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СторожОстатков

// БЕЗ транзакции, ПОСЛЕДНИМ. Тот же подсчет (СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам), что в
// СМП_ТестыФикстур; ждет нуль в каждом типе. Красный здесь - СТОП: остатки руками не удалять, сообщить владельцу.
// Для этого модуля дополнительно контролирует, что восстановленная ОтменитьТранзакцию + НачатьТранзакцию транзакция
// ничего не оставила в базе.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста")
			.Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Пытается провести объект и собирает наблюдения БЕЗ утверждений (транзакция после отказа мертва).
// Возвращает: Исключение (Булево), Причина (краткое представление ошибки), КоличествоСообщений
// (ПолучитьСообщенияПользователю(Истина) после исключения), ТранзакцияАктивна, ЗапросПосле (текст ошибки запроса в той же
// транзакции или пустая строка, если запрос выполнился).
Функция НаблюдатьОтказПроведения(Объект, ОтдельнаяЗапись)

	Наблюдения = Новый Структура("Исключение, Причина, КоличествоСообщений, ТранзакцияАктивна, ЗапросПосле",
		Ложь, "", -1, Ложь, "");
	Попытка
		Если ОтдельнаяЗапись Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Наблюдения.Исключение = Истина;
		Наблюдения.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Наблюдения.КоличествоСообщений = ПолучитьСообщенияПользователю(Истина).Количество();
	Наблюдения.ТранзакцияАктивна = ТранзакцияАктивна();
	Наблюдения.ЗапросПосле = ОшибкаЗапроса();

	Возврат Наблюдения;

КонецФункции

// Текст ошибки простого запроса или пустая строка, если запрос выполнился.
Функция ОшибкаЗапроса()

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Справочник.Валюты КАК Т");
		Запрос.Выполнить();
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ЗапросВыполняется()

	Возврат ПустаяСтрока(ОшибкаЗапроса());

КонецФункции

Функция СсылкаСуществует(Ссылка)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Документ." + Ссылка.Метаданные().Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ПроведенВБазе(Ссылка)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Проведен КАК Проведен ИЗ Документ." + Ссылка.Метаданные().Имя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий() И Выборка.Проведен;

КонецФункции


// Первая не помеченная организация-юрлицо из базы; пустая ссылка, если такой нет.
Функция ОрганизацияЮрлицо()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК О
		|ГДЕ НЕ О.ПометкаУдаления И О.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|УПОРЯДОЧИТЬ ПО О.Код");
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Организации.ПустаяСсылка());

КонецФункции

// Вид по умолчанию документа ("От покупателя" / "Поставщику") либо вид с заданным именем.
Функция ВидПоУмолчанию(ИмяДокумента, ИмяВида = Неопределено)

	Если ИмяДокумента = "ПоступлениеНаСчет" Тогда
		Возврат Перечисления.ВидыОперацийПоступлениеНаСчет[?(ИмяВида = Неопределено, "ОтПокупателя", ИмяВида)];
	КонецЕсли;

	Возврат Перечисления.ВидыОперацийРасходСоСчета[?(ИмяВида = Неопределено, "Поставщику", ИмяВида)];

КонецФункции

// Новый документ вида "Документ.Вид", заполненный штатно Заполнить(Структура) только видом и организацией.
Функция НовыйПустойДокументВида(Вид)

	Части = СтрРазделить(Вид, ".");
	Документ = Документы[Части[0]].СоздатьДокумент();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация", ВидПоУмолчанию(Части[0], Части[1]), СМП_ТестыДанныеУНФ.Организация()));

	Возврат Документ;

КонецФункции

// Пользователь сеанса и фикстурный "другой" с РАЗЛИЧНЫМИ настройками. Настройки сеанса читаются из базы как есть (их
// не пишем: кэш повторно используемых значений вендора пережил бы откат транзакции), настройки другого - противоположные
// по положениям и с другим основным подразделением. Пустое положение вендор трактует как "В шапке".
// Возвращает: Сеанс, Другой, ПодрСеанса, ПодрДругого, ПоложенияСеанса, ПоложенияДругого (структуры Статья, Подразделение, Проект).
Функция ДваПользователя()

	ВШапке = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	ВТабличной = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	Результат = Новый Структура("Сеанс, Другой, ПодрСеанса, ПодрДругого, ПоложенияСеанса, ПоложенияДругого");
	Результат.Сеанс = Пользователи.ТекущийПользователь();
	Результат.ПодрСеанса = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Результат.Сеанс, "ОсновноеПодразделение");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.ПодрСеанса), "Предусловие (база): у пользователя сеанса задано основное подразделение").ЭтоИстина();

	Имена = Новый Структура("Статья, Подразделение, Проект", "ПоложениеСтатьи", "ПоложениеПодразделенияВДенежныхДокументах", "ПоложениеПроекта");
	Результат.ПоложенияСеанса = Новый Структура("Статья, Подразделение, Проект");
	Результат.ПоложенияДругого = Новый Структура("Статья, Подразделение, Проект");
	Для Каждого Элемент Из Имена Цикл
		Значение = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Результат.Сеанс, Элемент.Значение);
		Результат.ПоложенияСеанса[Элемент.Ключ] = ?(ЗначениеЗаполнено(Значение), Значение, ВШапке);
		Результат.ПоложенияДругого[Элемент.Ключ] = ?(Результат.ПоложенияСеанса[Элемент.Ключ] = ВШапке, ВТабличной, ВШапке);
	КонецЦикла;

	Результат.Другой = СМП_ТестыДанныеУНФ.НовыйПользователь();
	Результат.ПодрДругого = СМП_ТестыДанныеУНФ.НовоеПодразделение();
	СМП_ТестыДанныеУНФ.УстановитьНастройкиПользователя(Результат.Другой, Новый Структура(
		"ОсновноеПодразделение, ПоложениеСтатьи, ПоложениеПодразделения, ПоложениеПроекта", Результат.ПодрДругого,
		Результат.ПоложенияДругого.Статья, Результат.ПоложенияДругого.Подразделение, Результат.ПоложенияДругого.Проект));

	Возврат Результат;

КонецФункции

Функция ТекстыСообщений()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

// Проводит документ; исключение проведения убивает транзакцию теста (задача 0), поэтому при исключении транзакция
// восстанавливается ОтменитьТранзакцию + НачатьТранзакцию (откатывается все, что тест создал) и базу после этого читать нельзя.
// Возвращает: Проведен (Булево, из базы), Исключение (Строка, пусто если не было).
Функция ПровестиСВосстановлением(Документ)

	Результат = Новый Структура("Проведен, Исключение", Ложь, "");
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Результат.Исключение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ПустаяСтрока(Результат.Исключение) Тогда
		Результат.Проведен = ПроведенВБазе(Документ.Ссылка);
	Иначе
		ОтменитьТранзакцию();
		НачатьТранзакцию();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Рецепт документа вида "Документ.Вид" (достаточный набор реквизитов - рецепт; необходимость каждого реквизита не измерялась, измеренный в журнале плана 04, задача 1).
// Не записывает. Заполнение - штатное Заполнить(Структура) видом, организацией и банковским счетом организации.
Функция СобратьДокументПоВиду(Вид, Организация)

	Части = СтрРазделить(Вид, ".");
	ЭтоПоступление = (Части[0] = "ПоступлениеНаСчет");
	Имя = Части[1];
	Документ = Документы[Части[0]].СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Заполнить(Новый Структура("ВидОперации, Организация, БанковскийСчет", ВидПоУмолчанию(Части[0], Имя), Организация,
		СМП_ТестыДанныеУНФ.БанковскийСчетОрганизации()));
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.СуммаДокумента = 100;
	Признаки = Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Ложь, Ложь, Ложь);
	СКонтрагентом = СтрРазделить("ОтПокупателя,ОтПоставщика,ОтНашейОрганизации,Поставщику,Покупателю,НашейОрганизации", ",").Найти(Имя) <> Неопределено;
	Если СКонтрагентом Тогда
		Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);
		Если Имя = "ОтНашейОрганизации" Или Имя = "НашейОрганизации" Тогда
			Организация2 = СМП_ТестыДанныеУНФ.НоваяОрганизация(Новый Структура("КонтрагентИнтеркампани", Контрагент));
			Документ.СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация2);
		КонецЕсли;
		ВидДоговора = ?(Имя = "ОтПокупателя" Или Имя = "Покупателю", Перечисления.ВидыДоговоров.СПокупателем, Перечисления.ВидыДоговоров.СПоставщиком);
		Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора", ВидДоговора));
		Документ.Контрагент = Контрагент;
		Строка = Документ.РасшифровкаПлатежа.Добавить();
		Строка.Договор = Договор;
		Строка.СуммаПлатежа = 100;
		Строка.СуммаРасчетов = 100;
		Строка.Курс = 1;
		Строка.Кратность = 1;
		Строка.СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС();
		Строка.ПризнакАванса = Истина;
	ИначеЕсли Имя = "ПереводСДругогоСчета" Или Имя = "ПереводНаДругойСчет" Тогда
		Документ.СчетКонтрагента = СМП_ТестыДанныеУНФ.НовыйБанковскийСчетОрганизации(Организация);
	ИначеЕсли Имя = "ЗарплатаСотруднику" Или Имя = "Подотчетнику" Тогда
		Документ.Подотчетник = СМП_ТестыДанныеУНФ.НовыйСотрудник(СМП_ТестыДанныеУНФ.НовоеФизЛицо());
	ИначеЕсли Имя = "Налоги" Тогда
		Документ.ВидНалога = Справочники.ВидыНалогов.ВоенныйСбор;
	ИначеЕсли Имя = "КомиссияБанка" Тогда
		Документ.Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Признаки);
		Документ.Корреспонденция = ПланыСчетов.Управленческий.ПрочиеРасходы;
	ИначеЕсли Имя = "Прочее" Или Имя = "НаРасходы" Или Имя = "ПрочиеРасчеты" Тогда
		Документ.Корреспонденция = ?(ЭтоПоступление, ПланыСчетов.Управленческий.ПрочиеДоходы, ПланыСчетов.Управленческий.ПрочиеРасходы);
	ИначеЕсли Имя = "ЛичныеСредстваПредпринимателя" Тогда
		Документ.Корреспонденция = ПланыСчетов.Управленческий.НераспределеннаяПрибыль;
	КонецЕсли;

	Возврат Документ;

КонецФункции

#КонецОбласти
