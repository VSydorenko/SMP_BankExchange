// Тесты реестра читателей и единой точки чтения (план 03, задача 5): СМП_ЧитателиВыписок.
//
// Читатели-дублеры - обработки СМП_ТестЧитатель* этого расширения: поведением управляют их
// экспортные переменные. Положительная и отрицательная внешние обработки - двоичные макеты
// СМП_ТестЧитательВнешний и СМП_ТестЧитательСтарый обработки СМП_ТестыМакеты (собраны платформой
// из tests/epf-src скриптом build-epf.ps1; синтетика, реальных данных нет).
//
// С задачи 6 в реестре есть строки (формат iFOBS CSV). Кейс, которому не хватает условия (например,
// выведенных идентификаторов нет по плану), остается именованным Пропустить с точной причиной,
// а не зеленым: вакуумный зеленый ничего не доказывает.
//
// Без данных в базе: транзакция не нужна. Продукт вызывается только через СМП_ТестыВызовПродукта.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Читатели выписок: реестр")
			.ДобавитьСерверныйТест("Реестр_СхемаКолонок")
			.ДобавитьСерверныйТест("Реестр_ИнвариантыПоСтрокам")
			.ДобавитьСерверныйТест("Реестр_ПроверкаИнвариантовУмеетПадать")
			.ДобавитьСерверныйТест("Реестр_ВыведенныеИдентификаторыЭтоМассив")
			.ДобавитьСерверныйТест("Реестр_УКаждойСтрокиЕстьВеткаДиспетчера")
		.ДобавитьТестовыйНабор("Читатели выписок: ПрочитатьФайл")
			.ДобавитьСерверныйТест("ПрочитатьФайл_НеизвестныйИдентификатор")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ВыведенныйИдентификатор")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ФайлНеТогоФормата")
			.ДобавитьСерверныйТест("ПрочитатьФайл_УспешноеЧтение")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ФорматБезВеткиДиспетчера")
			.ДобавитьСерверныйТест("ПрочитатьФайл_ИсключениеМодуляФормата")
			.ДобавитьСерверныйТест("ПрочитатьФайл_НезакрытаяКавычкаДаетОтказАнеЧастичнуюВыписку")
			.ДобавитьСерверныйТест("СтрокиРеестраДляФайла_СрезРвущийЗаписьВКавычкахНеМешаетУзнатьФормат")
			.ДобавитьСерверныйТест("СтрокиРеестраДляФайла_УзнаетСтрокиСвоегоФормата")
		.ДобавитьТестовыйНабор("Читатели выписок: ПрочитатьЧитателем")
			.ДобавитьСерверныйТест("Читатель_КорректныйОдинСчет")
			.ДобавитьСерверныйТест("Читатель_ФормаРезультата")
			.ДобавитьСерверныйТест("Читатель_ПараметрыПереданыИзОписания")
			.ДобавитьСерверныйТест("Читатель_ПустаяКодировкаОписанияПередаетсяПустой")
			.ДобавитьСерверныйТест("Читатель_ВторойНомерСчетаСвой")
			.ДобавитьСерверныйТест("Читатель_ЧужойСчетВыбрасываетсяПредупреждениемСКоличеством")
			.ДобавитьСерверныйТест("Читатель_ДваЧужихСчетаДваПредупреждения")
			.ДобавитьСерверныйТест("Читатель_ЧужойСчетВДругомРегистреЭтоОдноПредупреждение")
			.ДобавитьСерверныйТест("Читатель_ПробелыИРегистрВНомереСчетаНеДелаютЕгоЧужим")
				.СПараметрами("пробелы и регистр в файле", " ua 11 ", "UA11")
				.СПараметрами("пробелы в нашем номере", "ua11", "UA 11")
				.СПараметрами("неразрывный пробел в файле", "UA" + Символ(160) + "11", "UA11")
				.СПараметрами("точное совпадение", "UA11", "UA11")
			.ДобавитьСерверныйТест("Читатель_ПустойНомерСчетаЭтоОшибкаГраницыАНеЧужой")
				.СПараметрами("пустая строка", "")
				.СПараметрами("только пробелы", "   ")
			.ДобавитьСерверныйТест("Читатель_НевалидныйЧужойРядокЭтоОшибкаАНеПредупреждение")
			.ДобавитьСерверныйТест("Читатель_ЧужойИНевалидныйВместе")
			.ДобавитьСерверныйТест("Читатель_ИсключениеЧитателяНеВыходитНаружу")
			.ДобавитьСерверныйТест("Читатель_ОтклоненныйКонвертНеПолный")
			.ДобавитьСерверныйТест("Читатель_БезОписанияЧитателя")
			.ДобавитьСерверныйТест("Читатель_ВерсияКонтрактаДва")
			.ДобавитьСерверныйТест("Читатель_ОписаниеСОшибкамиЧтениеНеВызывается")
			.ДобавитьСерверныйТест("Читатель_НеОбъектВместоЧитателя")
			.ДобавитьСерверныйТест("Читатель_НетНомеровСчета")
			.ДобавитьСерверныйТест("Читатель_НомераСчетаНеМассив")
				.СПараметрами("строка вместо массива", "строка")
				.СПараметрами("неопределено", "неопределено")
				.СПараметрами("число", "число")
			.ДобавитьСерверныйТест("Читатель_ПервыйНомерПустойВторойВалидный")
			.ДобавитьСерверныйТест("Читатель_ДиагностикаЧитателяПереживаетИсключение")
			.ДобавитьСерверныйТест("Читатель_ПодменаКонвертаНеВыходитНаружу")
				.СПараметрами("структура той же схемы", "Структура", "")
				.СПараметрами("неопределено", "Неопределено", "")
				.СПараметрами("структура и исключение", "Структура", "авария после подмены 7788")
				.СПараметрами("неопределено и исключение", "Неопределено", "авария после подмены 7788")
			.ДобавитьСерверныйТест("Читатель_ДефектнаяДиагностикаНеСкрываетИсключение")
				.СПараметрами("не таблица", "НеТаблица")
				.СПараметрами("чужие колонки", "ЧужиеКолонки")
			.ДобавитьСерверныйТест("Читатель_ЧужойУровеньПриИсключенииПриводитсяКОшибке")
		.ДобавитьТестовыйНабор("Читатели выписок: внешняя обработка")
			.ДобавитьСерверныйТест("Внешний_ПоложительныйСоздаетЧитателяИЧитает")
			.ДобавитьСерверныйТест("Внешний_СтараяОбработкаСоздаетсяНоЧитателемНеЯвляется")
			.ДобавитьСерверныйТест("Внешний_МусорныеДанныеДаютОшибкиБезИсключения")
			.ДобавитьСерверныйТест("Внешний_НеопределеноДаетОшибкиБезИсключения")
			.ДобавитьСерверныйТест("Внешний_ВременныхФайловНеОстаетсяПослеУспехаИОшибки")
			.ДобавитьСерверныйТест("Внешний_СверкаКаталогаВременныхФайловУмеетПадать");

КонецПроцедуры

#Область Реестр

Процедура Реестр_СхемаКолонок() Экспорт

	Реестр = Продукт("РеестрЧитателей");

	ЮТест.ОжидаетЧто(ТипЗнч(Реестр) = Тип("ТаблицаЗначений"), "Реестр - таблица значений").ЭтоИстина();
	Колонки = Новый Массив;
	Для Каждого Колонка Из Реестр.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрСоединить(Колонки, ","), "Колонки реестра")
		.Равно("Идентификатор,Банк,ТипФайла,Представление,КодыБанка,Формат,Вариант,РасширенияФайлов,ИмяСтаройОбработки");

КонецПроцедуры

Процедура Реестр_ИнвариантыПоСтрокам() Экспорт

	Реестр = Продукт("РеестрЧитателей");
	// Реестр не пуст: иначе инварианты вакуумны. Задача 6 дала шесть строк формата iFOBS CSV.
	ЮТест.ОжидаетЧто(Реестр.Количество() > 0, "В реестре есть строки").ЭтоИстина();

	Нарушения = НарушенияРеестра(Реестр, Продукт("ВыведенныеИдентификаторы"));

	ЮТест.ОжидаетЧто(СтрСоединить(Нарушения, Символы.ПС), "Нарушения инвариантов реестра").Равно("");

КонецПроцедуры

// Контроль: проверка инвариантов умеет падать на заведомо плохих реестрах. Без него пустой
// результат на настоящем реестре не доказывал бы, что проверка вообще смотрит.
Процедура Реестр_ПроверкаИнвариантовУмеетПадать() Экспорт

	Хороший = ТестовыйРеестр();
	СтрокаХорошая = Хороший.Добавить();
	СтрокаХорошая.Идентификатор = "ТестА";
	СтрокаХорошая.Банк = "БанкА";
	СтрокаХорошая.ТипФайла = "CSV";
	СтрокаХорошая.Представление = "БанкА — CSV";
	СтрокаХорошая.КодыБанка = Новый Массив;
	СтрокаХорошая.Формат = "СМП_ВыпискаБанка";
	СтрокаХорошая.Вариант = "";
	СтрокаХорошая.РасширенияФайлов = Новый Массив;
	СтрокаХорошая.ИмяСтаройОбработки = "СМП_ОбработкаВыпискиБанка_БанкА";
	ЮТест.ОжидаетЧто(НарушенияРеестра(Хороший, Новый Массив).Количество(), "Корректный реестр без нарушений").Равно(0);

	Дубль = Хороший.Скопировать();
	ЗаполнитьЗначенияСвойств(Дубль.Добавить(), Дубль[0]);
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(Дубль, Новый Массив), "повторяется"), "Дубль идентификатора пойман").ЭтоИстина();

	Выведенный = Новый Массив;
	Выведенный.Добавить("ТестА");
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(Хороший, Выведенный), "выведен"), "Выведенный идентификатор в реестре пойман").ЭтоИстина();

	НетМодуля = Хороший.Скопировать();
	НетМодуля[0].Формат = "СМП_НетТакогоМодуляФормата";
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(НетМодуля, Новый Массив), "модуля формата"), "Несуществующий модуль формата пойман").ЭтоИстина();

	Представление = Хороший.Скопировать();
	Представление[0].Представление = "БанкА CSV";
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(Представление, Новый Массив), "представление"), "Неверное представление поймано").ЭтоИстина();

	// Типы колонок: КодыБанка и РасширенияФайлов - массивы строк, остальные - строки.
	КодыСтрокой = Хороший.Скопировать();
	КодыСтрокой[0].КодыБанка = "380634";
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(КодыСтрокой, Новый Массив), "тип"), "КодыБанка не массив - поймано").ЭтоИстина();

	КодыЧисла = Хороший.Скопировать();
	КодыЧисла[0].КодыБанка = Новый Массив;
	КодыЧисла[0].КодыБанка.Добавить(380634);
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(КодыЧисла, Новый Массив), "тип"), "Элемент КодыБанка - число - поймано").ЭтоИстина();

	РасширенияСтрокой = Хороший.Скопировать();
	РасширенияСтрокой[0].РасширенияФайлов = "csv";
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(РасширенияСтрокой, Новый Массив), "тип"), "РасширенияФайлов не массив - поймано").ЭтоИстина();

	БанкЧислом = Хороший.Скопировать();
	БанкЧислом[0].Банк = 5;
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(БанкЧислом, Новый Массив), "тип"), "Банк - число - поймано").ЭтоИстина();

	ВариантНеопределено = Хороший.Скопировать();
	ВариантНеопределено[0].Вариант = Неопределено;
	ЮТест.ОжидаетЧто(СодержитТекст(НарушенияРеестра(ВариантНеопределено, Новый Массив), "тип"), "Вариант - Неопределено - поймано").ЭтоИстина();

КонецПроцедуры

Процедура Реестр_ВыведенныеИдентификаторыЭтоМассив() Экспорт

	Результат = Продукт("ВыведенныеИдентификаторы");

	ЮТест.ОжидаетЧто(ТипЗнч(Результат) = Тип("Массив"), "Выведенные идентификаторы - массив").ЭтоИстина();

КонецПроцедуры

// У каждой строки реестра есть ветка диспетчера: иначе чтение вернуло бы «формат не поддерживается
// диспетчером». Подмены реестра и крючков в продукте нет намеренно, поэтому проверяется каждая настоящая строка.
Процедура Реестр_УКаждойСтрокиЕстьВеткаДиспетчера() Экспорт

	Реестр = Продукт("РеестрЧитателей");
	ЮТест.ОжидаетЧто(Реестр.Количество() > 0, "В реестре есть строки").ЭтоИстина();
	Для Каждого СтрокаРеестра Из Реестр Цикл
		Результат = ПрочитатьФайл(СтрокаРеестра.Идентификатор, ДанныеТекста("x"), НомераСчета("UA11"));
		ЮТест.ОжидаетЧто(ЭтоОтказДиспетчера(Результат), "Строка " + СтрокаРеестра.Идентификатор + ": формат известен диспетчеру").ЭтоЛожь();
	КонецЦикла;

	// Контроль: распознавание отказа диспетчера находит его сообщение и не путает с «файл не похож».
	Отказ = НовыйРезультатДляКонтроля("Формат ""X"" строки реестра ""Y"" не поддерживается диспетчером чтения.");
	НеПохож = НовыйРезультатДляКонтроля("Файл не похож на формат строки реестра ""Y"".");
	ЮТест.ОжидаетЧто(ЭтоОтказДиспетчера(Отказ), "Контроль: отказ диспетчера узнан").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЭтоОтказДиспетчера(НеПохож), "Контроль: «файл не похож» - не отказ диспетчера").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПрочитатьФайл

Процедура ПрочитатьФайл_НеизвестныйИдентификатор() Экспорт

	Номера = НомераСчета("UA11");

	Результат = ПрочитатьФайл("СМП_НетТакойСтрокиРеестра", ДанныеТекста("x"), Номера);

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Неизвестный идентификатор: файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка для администратора").Равно(1);
	Если Ошибки.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Текст называет идентификатор").Содержит("СМП_НетТакойСтрокиРеестра");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Отказ - неполное чтение для курсора").ЭтоИстина();

КонецПроцедуры

Процедура ПрочитатьФайл_ВыведенныйИдентификатор() Экспорт

	Выведенные = Продукт("ВыведенныеИдентификаторы");
	Если Выведенные.Количество() = 0 Тогда
		ЮТест.Пропустить("ВыведенныеИдентификаторы пуст по плану этапа 2 (интерфейс; выведенных строк еще нет), "
			+ "особое сообщение «строка выведена» нечем вызвать без подмены реестра");
		Возврат;
	КонецЕсли;

	Результат = ПрочитатьФайл(Выведенные[0], ДанныеТекста("x"), НомераСчета("UA11"));

	ЮТест.ОжидаетЧто(Результат.Принята, "Выведенная строка: файл не принят").ЭтоЛожь();
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка").Равно(1);
	Если Ошибки.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Текст говорит, что строка выведена").Содержит("выведен");
	КонецЕсли;

КонецПроцедуры

Процедура ПрочитатьФайл_ФайлНеТогоФормата() Экспорт

	СтрокаРеестра = СтрокаРеестраПоИдентификатору("Акорд_CSV");
	Данные = Обработки.СМП_ТестыМакеты.ПолучитьМакет("СМП_ТестВыпискаCSVУкрГаз");
	Параметры = Новый Массив;
	Параметры.Добавить(Данные);

	Результат = ПрочитатьФайл("Акорд_CSV", Данные, НомераСчета("UA11"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Файл другого формата не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет: частичной выписки из чужого файла не бывает").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Отказ - неполное чтение для курсора").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Читатель не вызывался и ничего не прочитал").ЭтоЛожь();
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка с названием строки реестра").Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Текст называет строку реестра").Содержит(СтрокаРеестра.Представление);
	КонецЕсли;
	Ожидаемые = Продукт("СтрокиРеестраДляФайла", Параметры);
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "ПохожиеСтрокиРеестра - то, что узнает СтрокиРеестраДляФайла")
		.Равно(СтрСоединить(Ожидаемые, ","));
	// Ожидание задано явно (а не берется из продукта): образец УкрГаза, прочитанный строкой Акорда, узнает только
	// строка УкрГаза. Без этого мутация «ПохожиеСтрокиРеестра не заполняется» на одном формате была бы незаметна.
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "ПохожиеСтрокиРеестра называет строку формата файла")
		.Равно("УкрГазБанк_CSV");

КонецПроцедуры

Процедура ПрочитатьФайл_УспешноеЧтение() Экспорт

	Данные = Обработки.СМП_ТестыМакеты.ПолучитьМакет("СМП_ТестВыпискаCSVАкорд");

	Результат = ПрочитатьФайл("Акорд_CSV", Данные, НомераСчета("UA173806340000026004884150490"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Файл формата принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Прочитаны все 17 операций образца").Равно(17);
	ЮТест.ОжидаетЧто(Результат.ПохожиеСтрокиРеестра.Количество(), "Подсказок реестра нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "ЧтениеПолное из конверта после чтения").ЭтоИстина();

КонецПроцедуры

// Строка реестра без ветки диспетчера в продукте невозможна: Реестр_УКаждойСтрокиЕстьВеткаДиспетчера
// требует ветку у каждой строки. Подмена реестра или крючок в продукте заради этого кейса - антипатерн,
// поэтому «формат без ветки» не воспроизвести; кейс заменен инвариантом реестра.
Процедура ПрочитатьФайл_ФорматБезВеткиДиспетчера() Экспорт

	ЮТест.Пропустить("Строку реестра без ветки диспетчера не создать без подмены реестра в продукте; "
		+ "ее отсутствие гарантирует Реестр_УКаждойСтрокиЕстьВеткаДиспетчера");

КонецПроцедуры

// Исключение ФайлПохожНаФормат модуля формата не выходит наружу и не прячется за «файл не похож»:
// Принята = Ложь, «Ошибка» с подробным представлением исключения (называет модуль формата),
// ПохожиеСтрокиРеестра пуст, форма результата прежняя. Крючков в продукте нет: сбой дает вход, на
// котором ФайлПохожНаФормат модуля iFOBS CSV действительно падает (не двоичные данные).
Процедура ПрочитатьФайл_ИсключениеМодуляФормата() Экспорт

	Результат = ПрочитатьФайл("Акорд_CSV", Неопределено, НомераСчета("UA11"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Исключение модуля формата: файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.ПохожиеСтрокиРеестра.Количество(), "Подсказок реестра нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Неполное чтение для курсора").ЭтоИстина();
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка").Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Ошибка называет модуль формата, а не «файл не похож»").Содержит("СМП_ЧитательВыпискиiFOBS_CSV");
	КонецЕсли;

КонецПроцедуры

// Файл iFOBS CSV с незакрытой кавычкой в последней записи: формат узнан по заголовку, но чтение
// отказывает с текстом для администратора, а не отдает часть строк.
Процедура ПрочитатьФайл_НезакрытаяКавычкаДаетОтказАнеЧастичнуюВыписку() Экспорт

	Идентификатор = ИдентификаторСтрокиФормата("СМП_ЧитательВыпискиiFOBS_CSV");
	Данные = ДанныеWindows1251(ЗаголовокiFOBSCSV() + Символы.ВК + Символы.ПС
		+ СтрСоединить(КолонкиiFOBSБезЗначений("x"), ";") + Символы.ВК + Символы.ПС + "1;""оборвано;2");

	Результат = ПрочитатьФайл(Идентификатор, Данные, НомераСчета("UA11"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Незакрытая кавычка - файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Частичной выписки нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.ПохожиеСтрокиРеестра.Количество(), "Формат узнан, подсказок реестра нет").Равно(0);
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество() > 0, "Есть текст для администратора").ЭтоИстина();
	Если Ошибки.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(НРег(Ошибки[0]), "Текст называет незакрытую кавычку").Содержит("незакрытая кавычка");
	КонецЕсли;

КонецПроцедуры

// Срез первых 4096 байт законно рвет запись, у которой все поля в кавычках: формат все равно узнается.
Процедура СтрокиРеестраДляФайла_СрезРвущийЗаписьВКавычкахНеМешаетУзнатьФормат() Экспорт

	Идентификатор = ИдентификаторСтрокиФормата("СМП_ЧитательВыпискиiFOBS_CSV");
	Части = Новый Массив;
	Для Индекс = 1 По 5000 Цикл
		Части.Добавить("я");
	КонецЦикла;
	Длинное = СтрСоединить(Части, "");
	Данные = ДанныеWindows1251(ЗаголовокiFOBSCSV() + Символы.ВК + Символы.ПС + """" + Длинное + """;""2""");
	Параметры = Новый Массив;
	Параметры.Добавить(Данные);

	Узнанные = Продукт("СтрокиРеестраДляФайла", Параметры);

	ЮТест.ОжидаетЧто(Узнанные.Найти(Идентификатор) <> Неопределено, "Формат узнан по заголовку при обрыве среза внутри кавычек").ЭтоИстина();

КонецПроцедуры

Процедура СтрокиРеестраДляФайла_УзнаетСтрокиСвоегоФормата() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Обработки.СМП_ТестыМакеты.ПолучитьМакет("СМП_ТестВыпискаCSVАкорд"));
	Результат = Продукт("СтрокиРеестраДляФайла", Параметры);

	ЮТест.ОжидаетЧто(ТипЗнч(Результат) = Тип("Массив"), "Результат - массив").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Количество() > 0, "Файл формата узнан хотя бы одной строкой").ЭтоИстина();
	Для Каждого Идентификатор Из Результат Цикл
		ЮТест.ОжидаетЧто(СтрокаРеестраПоИдентификатору(Идентификатор) <> Неопределено, "Узнанный идентификатор есть в реестре: " + Идентификатор).ЭтоИстина();
	КонецЦикла;

	Мусор = Новый Массив;
	Мусор.Добавить(ДанныеТекста("x"));
	ЮТест.ОжидаетЧто(Продукт("СтрокиРеестраДляФайла", Мусор).Количество(), "Мусор не узнан ни одной строкой").Равно(0);

	// Проверка формата, упавшая на чужом входе, означает «не узнан» (подсказка, а не чтение).
	Непригодный = Новый Массив;
	Непригодный.Добавить(Неопределено);
	ЮТест.ОжидаетЧто(Продукт("СтрокиРеестраДляФайла", Непригодный).Количество(), "Непригодный вход: не узнан, без исключения").Равно(0);

КонецПроцедуры

#КонецОбласти

