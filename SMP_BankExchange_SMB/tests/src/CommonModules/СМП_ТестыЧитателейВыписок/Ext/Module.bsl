// Тесты реестра читателей и единой точки чтения (план 03, задача 5): СМП_ЧитателиВыписок.
//
// Читатели-дублеры - обработки СМП_ТестЧитатель* этого расширения: поведением управляют их
// экспортные переменные. Положительная и отрицательная внешние обработки - двоичные макеты
// СМП_ТестЧитательВнешний и СМП_ТестЧитательСтарый обработки СМП_ТестыМакеты (собраны платформой
// из tests/epf-src скриптом build-epf.ps1; синтетика, реальных данных нет).
//
// С задачи 6 в реестре есть строки (формат iFOBS CSV). Кейс, которому не хватает условия (например,
// выведенных идентификаторов нет по плану), остается именованным Пропустить с точной причиной,
// а не зеленым: вакуумный зеленый ничего не доказывает.
//
// Без данных в базе: транзакция не нужна. Продукт вызывается только через СМП_ТестыВызовПродукта.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Читатели выписок: внешняя обработка")
			.ДобавитьСерверныйТест("Внешний_ПоложительныйСоздаетЧитателяИЧитает")
			.ДобавитьСерверныйТест("Внешний_СтараяОбработкаСоздаетсяНоЧитателемНеЯвляется");

КонецПроцедуры

#Область ВнешняяОбработка

Процедура Внешний_ПоложительныйСоздаетЧитателяИЧитает() Экспорт

	Данные = Обработки.СМП_ТестыМакеты.ПолучитьМакет("СМП_ТестЧитательВнешний");

	Создание = СоздатьВнешнийЧитатель(Данные);

	ЮТест.ОжидаетЧто(СтрСоединить(Создание.Ошибки, Символы.ПС), "Ошибки создания").Равно("");
	ЮТест.ОжидаетЧто(Создание.Читатель <> Неопределено, "Читатель создан").ЭтоИстина();
	Если Создание.Читатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = ПрочитатьЧитателем(Создание.Читатель, ДанныеТекста("x"), НомераСчета("UA11", "OLD22"));

	ЮТест.ОжидаетЧто(Результат.Принята, "Внешний читатель принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Одна операция").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].НазначениеПлатежа, "Читатель получил первый номер счета и кодировку из своего описания")
			.Равно("UA11|windows-1251");
	КонецЕсли;

КонецПроцедуры

Процедура Внешний_СтараяОбработкаСоздаетсяНоЧитателемНеЯвляется() Экспорт

	Данные = Обработки.СМП_ТестыМакеты.ПолучитьМакет("СМП_ТестЧитательСтарый");

	Создание = СоздатьВнешнийЧитатель(Данные);

	ЮТест.ОжидаетЧто(СтрСоединить(Создание.Ошибки, Символы.ПС), "Старая обработка создается без ошибок").Равно("");
	ЮТест.ОжидаетЧто(Создание.Читатель <> Неопределено, "Объект создан").ЭтоИстина();
	Если Создание.Читатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = ПрочитатьЧитателем(Создание.Читатель, ДанныеТекста("x"), НомераСчета("UA11"));

	ЮТест.ОжидаетЧто(Результат.Принята, "Без ОписаниеЧитателя файл не принят").ЭтоЛожь();
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество() > 0, "Есть текст для администратора").ЭтоИстина();
	Если Ошибки.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Текст называет отсутствующую функцию").Содержит("ОписаниеЧитателя");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьЧитателем(Читатель, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(Читатель);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьЧитателем", Параметры);

КонецФункции

Функция СоздатьВнешнийЧитатель(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат Продукт("СоздатьВнешнийЧитатель", Параметры);

КонецФункции

Функция ДанныеТекста(Текст)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст, "utf-8", Ложь);

КонецФункции

// Массив номеров нашего счета из одного-двух значений.
Функция НомераСчета(Первый, Второй = Неопределено)

	Номера = Новый Массив;
	Номера.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Номера.Добавить(Второй);
	КонецЕсли;
	Возврат Номера;

КонецФункции

// Тексты диагностики результата с заданным уровнем.
Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

#КонецОбласти
