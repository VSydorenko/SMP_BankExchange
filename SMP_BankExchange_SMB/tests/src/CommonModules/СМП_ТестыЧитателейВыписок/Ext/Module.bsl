	Отказ = СоздатьВнешнийЧитатель(ДанныеТекста("это не внешняя обработка"));
	После2 = ВсеВременные();

	ЮТест.ОжидаетЧто(Успех.Читатель <> Неопределено, "Создание удалось").ЭтоИстина();
	ЮТест.ОжидаетЧто(Отказ.Читатель = Неопределено, "Создание из мусора не удалось").ЭтоИстина();
	ЮТест.ОжидаетЧто(Новые(До, После1), "После успешного создания новых временных файлов нет").Равно("");
	ЮТест.ОжидаетЧто(Новые(До, После2), "После неудачного создания новых временных файлов нет").Равно("");

КонецПроцедуры

// Контроль: сверка каталога временных файлов видит новый файл.
Процедура Внешний_СверкаКаталогаВременныхФайловУмеетПадать() Экспорт

	До = ВсеВременные();
	Имя = ПолучитьИмяВременногоФайла("txt");
	Запись = Новый ТекстовыйДокумент;
	Запись.УстановитьТекст("x");
	Запись.Записать(Имя);
	Во = ВсеВременные();
	УдалитьФайлы(Имя);
	После = ВсеВременные();

	ЮТест.ОжидаетЧто(Во, "Список видит новый файл").НеРавно(До);
	СозданныйФайл = Новый Файл(Имя);
	ИмяБезКаталога = СозданныйФайл.Имя;
	ЮТест.ОжидаетЧто(Новые(До, Во), "Сверка новых файлов называет созданный файл").Содержит(ИмяБезКаталога);
	ЮТест.ОжидаетЧто(После, "После удаления список прежний").Равно(До);

КонецПроцедуры

