		ЮТест.ОжидаетЧто(Результат.Диагностика[0].Уровень, "Уровень сообщения читателя сохранен").Равно("Предупреждение");
		ЮТест.ОжидаетЧто(Результат.Диагностика[1].Уровень, "Вторым - ошибка исключения").Равно("Ошибка");
		ЮТест.ОжидаетЧто(Результат.Диагностика[1].Текст, "Текст ошибки - исключение читателя").Содержит("авария читателя 4711");
	КонецЕсли;

КонецПроцедуры

// Дефектная диагностика читателя (не таблица, чужие колонки) не должна скрыть исключение читателя
// и не должна выбросить новое исключение наружу.
Процедура Читатель_ДефектнаяДиагностикаНеСкрываетИсключение(Описание, Порча) Экспорт

	Читатель = НовыйЧитатель();
	Читатель.ПорчаДиагностики = Порча;
	Читатель.ТекстИсключения = "авария читателя 4711";

	Результат = ПрочитатьЧитателем(Читатель, ДанныеТекста("x"), НомераСчета("UA11"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Читатель с исключением не принят: " + Описание).ЭтоЛожь();
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка - исключение читателя: " + Описание).Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0], "Текст - исключение читателя: " + Описание).Содержит("авария читателя 4711");
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Дефектная диагностика не переносится: " + Описание).Равно(1);

КонецПроцедуры

// Уровень сообщения читателя вне контракта на пути исключения приводится к «Ошибка» (так платформа
// трактует чужой уровень на обычном пути), текст сохраняется.
Процедура Читатель_ЧужойУровеньПриИсключенииПриводитсяКОшибке() Экспорт

	Читатель = НовыйЧитатель();
	Читатель.ПорчаДиагностики = "ЧужойУровень";
	Читатель.ТекстИсключения = "авария читателя 4711";

	Результат = ПрочитатьЧитателем(Читатель, ДанныеТекста("x"), НомераСчета("UA11"));

	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Сообщение читателя и сообщение об исключении").Равно(2);
	Если Результат.Диагностика.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Диагностика[0].Текст, "Текст сообщения читателя сохранен").Содержит("уровень вне контракта 6060");
		ЮТест.ОжидаетЧто(Результат.Диагностика[0].Уровень, "Чужой уровень приведен к контракту").Равно("Ошибка");
	КонецЕсли;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		ЮТест.ОжидаетЧто(Сообщение.Уровень = "Ошибка" Или Сообщение.Уровень = "Предупреждение", "Каждый уровень - из контракта").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Читатель присваивает параметру Выписка другой объект: платформа проверяет конверт, который сама
// создала, и ничто не выходит наружу исключением. Результат держит конверт платформы.
Процедура Читатель_ПодменаКонвертаНеВыходитНаружу(Описание, Подмена, ТекстИсключения) Экспорт

	Читатель = НовыйЧитатель();
	Читатель.ПодменаКонверта = Подмена;
	Читатель.ТекстИсключения = ТекстИсключения;
	Читатель.СообщениеДиагностики = "замечание до подмены 6021";

	Результат = ПрочитатьЧитателем(Читатель, ДанныеТекста("x"), НомераСчета("UA11"));

	ПроверитьФормуРезультата(Результат);
	ЮТест.ОжидаетЧто(Результат.Принята, "Подмена конверта - файл не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строк нет: " + Описание).Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Неполное чтение для курсора: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Выписка) = Тип("Структура"), "Результат держит конверт платформы: " + Описание).ЭтоИстина();
	Если ТипЗнч(Результат.Выписка) = Тип("Структура") Тогда
		ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Конверт не полный: " + Описание).ЭтоЛожь();
		// Конверт платформы хранит то, что читатель успел в него записать до подмены; подмененный - пуст.
		ЮТест.ОжидаетЧто(Результат.Выписка.Диагностика.Количество(), "Результат держит именно конверт платформы: " + Описание).Равно(1);
	КонецЕсли;
	Ошибки = ТекстыПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество() > 0, "Есть текст для администратора: " + Описание).ЭтоИстина();
	Если Не ПустаяСтрока(ТекстИсключения) Тогда
		ЮТест.ОжидаетЧто(СодержитТекст(ТекстыПоУровню(Результат, "Предупреждение"), "замечание до подмены 6021"),
			"Замечание читателя до падения не потеряно: " + Описание).ЭтоИстина();
	КонецЕсли;
	Если ПустаяСтрока(ТекстИсключения) Тогда
		ЮТест.ОжидаетЧто(СодержитТекст(Ошибки, "не тот конверт"), "Текст называет подмену конверта: " + Описание).ЭтоИстина();
	Иначе
		ЮТест.ОжидаетЧто(СодержитТекст(Ошибки, "авария после подмены 7788"), "Текст называет исключение читателя: " + Описание).ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

