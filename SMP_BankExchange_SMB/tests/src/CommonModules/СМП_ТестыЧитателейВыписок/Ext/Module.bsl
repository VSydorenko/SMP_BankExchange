// Тексты диагностики результата с заданным уровнем.
Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Результат чтения имеет одну форму независимо от пути: ровно эти поля и типы.
Процедура ПроверитьФормуРезультата(Результат)

	Ключи = Новый Массив;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Для Каждого Элемент Из Результат Цикл
			Ключи.Добавить(Элемент.Ключ);
		КонецЦикла;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Ключи);
	Список.СортироватьПоЗначению();
	ЮТест.ОжидаетЧто(СтрСоединить(Список.ВыгрузитьЗначения(), ","), "Поля результата чтения")
		.Равно("Выписка,Диагностика,ЕстьНевалидныеСтроки,Операции,ПохожиеСтрокиРеестра,Принята");

	Если Ключи.Количество() <> 6 Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Принята) = Тип("Булево"), "Принята - Булево").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.ЕстьНевалидныеСтроки) = Тип("Булево"), "ЕстьНевалидныеСтроки - Булево").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Операции) = Тип("ТаблицаЗначений"), "Операции - таблица значений").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Диагностика) = Тип("ТаблицаЗначений"), "Диагностика - таблица значений").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.Выписка) = Тип("Структура"), "Выписка - структура конверта").ЭтоИстина();
	ЮТест.ОжидаетЧто(ТипЗнч(Результат.ПохожиеСтрокиРеестра) = Тип("Массив"), "ПохожиеСтрокиРеестра - массив").ЭтоИстина();

КонецПроцедуры

Функция СодержитТекст(Тексты, Подстрока)

	Для Каждого Текст Из Тексты Цикл
		Если СтрНайти(НРег(Текст), НРег(Подстрока)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТестовыйРеестр()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("Идентификатор,Банк,ТипФайла,Представление,Формат", ",") Цикл
		Таблица.Колонки.Добавить(Имя);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Нарушения инвариантов реестра: уникальность идентификаторов, отсутствие совпадений с
// выведенными, существование модуля формата, представление «<Банк> — <тип файла>».
Функция НарушенияРеестра(Реестр, Выведенные)

	Нарушения = Новый Массив;
	Виденные = Новый Соответствие;
	Для Каждого СтрокаРеестра Из Реестр Цикл
		Если Виденные[СтрокаРеестра.Идентификатор] <> Неопределено Тогда
			Нарушения.Добавить("Идентификатор " + СтрокаРеестра.Идентификатор + " повторяется");
		КонецЕсли;
		Виденные[СтрокаРеестра.Идентификатор] = Истина;

		Если Выведенные.Найти(СтрокаРеестра.Идентификатор) <> Неопределено Тогда
			Нарушения.Добавить("Идентификатор " + СтрокаРеестра.Идентификатор + " выведен, но есть в реестре");
		КонецЕсли;

		Если Метаданные.ОбщиеМодули.Найти(СтрШаблон("%1", СтрокаРеестра.Формат)) = Неопределено Тогда
			Нарушения.Добавить("Строка " + СтрокаРеестра.Идентификатор + ": модуля формата " + СтрокаРеестра.Формат + " нет");
		КонецЕсли;

		Если СтрокаРеестра.Представление <> СтрШаблон("%1 — %2", СтрокаРеестра.Банк, СтрокаРеестра.ТипФайла) Тогда
			Нарушения.Добавить("Строка " + СтрокаРеестра.Идентификатор + ": представление «" + СтрокаРеестра.Представление
				+ "» не равно «<Банк> — <тип файла>»");
		КонецЕсли;
	КонецЦикла;
	Возврат Нарушения;

КонецФункции

// Элементы второго снимка каталога временных файлов, которых не было в первом. Служебные файлы
// самой платформы v8_<hex>_d<n>.tmp не считаются: платформа создает их при подключении и
// при сбое загрузки внешней обработки (измерено на обоих способах создания) и сама убирает при
// завершении сеанса. Файлы продукта (.epf и прочие) считаются.
Функция Новые(До, После)

	Были = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(До, Символы.ПС) Цикл
		Были[Имя] = Истина;
	КонецЦикла;
	Новые = Новый Массив;
	Для Каждого Имя Из СтрРазделить(После, Символы.ПС) Цикл
		Если Были[Имя] = Неопределено И Не СлужебныйФайлПлатформы(Имя) Тогда
			Новые.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Новые, Символы.ПС);

КонецФункции

Функция СлужебныйФайлПлатформы(ПолноеИмя)

	Файл = Новый Файл(ПолноеИмя);
	Возврат Лев(Файл.Имя, 3) = "v8_" И Файл.Расширение = ".tmp";

КонецФункции

// Все элементы каталога временных файлов одной строкой.
Функция ВсеВременные()

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из НайтиФайлы(КаталогВременныхФайлов(), "*") Цикл
		Список.Добавить(Элемент.ПолноеИмя);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС);

КонецФункции

#КонецОбласти
