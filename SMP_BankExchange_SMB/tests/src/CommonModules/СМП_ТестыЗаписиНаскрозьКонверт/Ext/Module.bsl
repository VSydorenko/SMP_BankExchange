// Тесты записи документов банка: весь конверт наскрозь (задача 9 плана 04, D3, D5, D7, D22; Review Focus 3 и 4 плана 04).
// Конверт из всех случаев таблицы СМП_ТестыЗаписиНаскрозь -> Распознать -> Записать -> повторная загрузка; гонка двух запусков;
// исключение проведения на шаге пакета. Случаи, их построители и общие утверждения (в том числе правило уровней замечаний
// "Результат записи") живут в СМП_ТестыЗаписиНаскрозь; здесь - то, что требует пакета. Отдельный модуль: предел прогона ~300 с.
//
// ГОНКУ воспроизводит последовательность в одном сеансе, не потоки: распознать пакет -> "другой запуск" записывает его часть (или
// всё) -> записать первый план. Исключение проведения убивает транзакцию теста (журнал задачи 0): строка-исключение в пакете
// ПОСЛЕДНЯЯ, тест сам восстанавливает транзакцию (ОтменитьТранзакцию + НачатьТранзакцию) и утверждает только результат Записать,
// базу после этого не читает (откат унес и документы соседей: что они проведены, видно по их результату "Создан", который
// продукт ставит только при Документ.Проведен).
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конверт наскрозь: все случаи таблицы, повторная загрузка (D5, D7, Review Focus 4)");
	Набор.ДобавитьСерверныйТест("Конверт_ВсеСлучаи_СоздаетСтолькоСколькоНужно_ПовторНичегоНеСоздает").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конверт наскрозь: гонка запусков (Review Focus 4)");
	Набор.ДобавитьСерверныйТест("Гонка_ДваЗапускаОдинаковыхОпераций_ВторойНичегоНеСоздает").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Гонка_ДругойЗапускЗагрузилЧасть_НеДублируется").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Гонка_ДругойЗапускЗагрузилОперациюОбщегоНовогоКонтрагента_КонтрагентОдин").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Гонка_ДругойЗапускСоздалКонтрагентаСоСчетомИДоговором_НичегоНеДублируется").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Гонка_ДругойЗапускСоздалНесколькихОдногоКода_Берется_ПервыйПоКоду").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Транзакция_ВложеннаяОтмена_Измерение").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конверт наскрозь: отказы проведения, решта пакета записана (Review Focus 3)");
	Набор.ДобавитьСерверныйТест("Отказы_ТриПричиныВОдномПакете_СоседиЗаписаны").ВТранзакции();
	Набор.ДобавитьСерверныйТест("Отказы_ИсключениеПроведенияПоследним_РестПакетаЗаписан").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Конверт наскрозь: сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Конверт

// Все случаи таблицы одним конвертом. Утверждается: каждая строка - как в таблице; документов создано ровно операции минус "уже
// загружено"; контрагентов, договоров, счетов создано ровно столько, сколько строк с "Создан"; ни один существующий объект не изменился
// и не помечен (D5, D7); повторная загрузка того же конверта (Распознать заново) не создает ничего и не меняет созданное.
Процедура Конверт_ВсеСлучаи_СоздаетСтолькоСколькоНужно_ПовторНичегоНеСоздает() Экспорт

	Ключи = Новый Массив;
	Для Каждого Случай Из СМП_ТестыЗаписиНаскрозь.ТаблицаСлучаев() Цикл
		Ключи.Добавить(Случай.Ключ);
	КонецЦикла;
	Данные = Конверт(Ключи);
	Ответственный = СМП_ТестыЗаписиНаскрозь.НовыйОтветственный();
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(Ответственный);

	План = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	Для Номер = 1 По Ключи.Количество() Цикл
		СМП_ТестыЗаписиНаскрозь.ПроверитьПланСлучая(Данные.Случаи[Номер - 1], СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, Номер),
			"Конверт, строка " + Номер + " (" + Ключи[Номер - 1] + ")");
	КонецЦикла;

	Снимок = ОбщийСнимок(Данные.Построенные);
	Поручение = Данные.Построенные[Ключи.Найти("ПлатежноеПоручение")].Поручение;
	ЮТест.ОжидаетЧто(Оплачено(Поручение), "Предусловие: платежное поручение случая не оплачено до записи").ЭтоЛожь();
	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "В результате строка на строку конверта").Равно(Ключи.Количество());
	УжеЗагружено = 0;
	Контрагентов = 0;
	Договоров = 0;
	Счетов = 0;
	Для Номер = 1 По Ключи.Количество() Цикл
		Случай = Данные.Случаи[Номер - 1];
		СМП_ТестыЗаписиНаскрозь.ПроверитьСлучай(Случай, Данные.Построенные[Номер - 1], СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, Номер),
			Результат, Номер, "Конверт, строка " + Номер + " (" + Ключи[Номер - 1] + ")", Ответственный);
		УжеЗагружено = УжеЗагружено + ?(Случай.Результат = "УжеЗагружен", 1, 0);
		Контрагентов = Контрагентов + ?(Случай.Контрагент = "Создан", 1, 0);
		Договоров = Договоров + ?(Случай.Договор = "Создан", 1, 0);
		Счетов = Счетов + ?(Случай.Счет = "Создан", 1, 0);
	КонецЦикла;
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Конверт");
	СМП_ТестыЗаписиНаскрозь.ПроверитьСуществующиеНеИзменены(Снимок, Неопределено, "Конверт");

	ЮТест.ОжидаетЧто(УжеЗагружено > 0 И УжеЗагружено < Ключи.Количество(), "Предусловие: в конверте есть и загруженные, и новые операции").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.КоличествоДокументов(После) - СМП_ТестыЗаписиНаскрозь.КоличествоДокументов(До),
		"Создано документов = операций минус уже загруженных").Равно(Ключи.Количество() - УжеЗагружено);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты") - До.Получить("Справочник.Контрагенты"), "Создано контрагентов").Равно(Контрагентов);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.ДоговорыКонтрагентов") - До.Получить("Справочник.ДоговорыКонтрагентов"), "Создано договоров").Равно(Договоров);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.БанковскиеСчета") - До.Получить("Справочник.БанковскиеСчета"), "Создано счетов").Равно(Счетов);
	// Платежное поручение: единственный существующий объект, который меняет не запись, а вендор при проведении документа за ним.
	ЮТест.ОжидаетЧто(Оплачено(Поручение), "Вендор пометил поручение 'Оплачено' при проведении документа за ним (исключение из 'не меняется')").ЭтоИстина();

	// Повторная загрузка того же конверта.
	Созданное = Новый Массив;
	Для Каждого СтрокаРезультата Из Результат.Операции Цикл
		Для Каждого Имя Из СтрРазделить("Документ,СозданКонтрагент,СозданДоговор,СозданСчет", ",") Цикл
			Если ЗначениеЗаполнено(СтрокаРезультата[Имя]) Тогда
				Созданное.Добавить(СтрокаРезультата[Имя]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СнимокСозданного = СМП_ТестыЗаписиНаскрозь.СнимокВерсийСсылок(Созданное);
	СнимокПослеПервого = ОбъединитьСнимки(Снимок, СнимокСозданного);

	План2 = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	Для Номер = 1 По Ключи.Количество() Цикл
		Строка2 = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План2, Номер);
		ЮТест.ОжидаетЧто(Строка2.ИсточникВидаОперации, "Повтор, строка " + Номер + " (" + Ключи[Номер - 1] + "): все операции узнаны как загруженные")
			.Равно("ЗагруженныйДокумент");
		ЮТест.ОжидаетЧто(Строка2.ЗагруженныйДокумент, "Повтор, строка " + Номер + ": найден документ первой загрузки")
			.Равно(СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, Номер).Документ);
	КонецЦикла;
	Результат2 = СМП_ТестыЗаписиКаркас.Записать(План2, Контекст);
	После2 = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Для Номер = 1 По Ключи.Количество() Цикл
		Строка2 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат2, Номер);
		ЮТест.ОжидаетЧто(Строка2.Результат, "Повтор, строка " + Номер + " (" + Ключи[Номер - 1] + "): результат").Равно("УжеЗагружен");
	КонецЦикла;
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат2, "Повтор");
	ЮТест.ОжидаетЧто(Результат2.Замечания.Количество(), "Повтор: замечаний нет совсем (ничего не делалось)").Равно(0);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После2), "Повтор: количества контрагентов, договоров, счетов и документов не изменились")
		.Равно(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После));
	СМП_ТестыЗаписиНаскрозь.ПроверитьСуществующиеНеИзменены(СнимокПослеПервого, Неопределено, "Повтор");

КонецПроцедуры

#КонецОбласти

#Область Гонка

// Два запуска распознали ОДНИ И ТЕ ЖЕ операции до записи; первый записал; второй записывает свой (устаревший) план: все операции уже
// загружены - ничего не создается (ни документов, ни контрагента второй раз); повторная проверка называет строку ровно одним
// предупреждением, а строка, документ которой нашло уже распознавание (шаг 0), предупреждения не получает. Минор задачи 3.
Процедура Гонка_ДваЗапускаОдинаковыхОпераций_ВторойНичегоНеСоздает() Экспорт

	Ключи = СтрРазделить("Умолчанию,КонтрагентСоздать_ФОП,УжеЗагружен", ",");
	Данные = Конверт(Ключи);
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(СМП_ТестыЗаписиНаскрозь.НовыйОтветственный());

	План1 = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	План2 = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	Для Номер = 1 По 2 Цикл
		ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План2, Номер).ДействиеКонтрагент, "Предусловие: второй запуск тоже решил создать контрагента, строка " + Номер)
			.Равно("Создать");
	КонецЦикла;

	Результат1 = СМП_ТестыЗаписиКаркас.Записать(План1, Контекст);
	После1 = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();
	Результат2 = СМП_ТестыЗаписиКаркас.Записать(План2, Контекст);
	После2 = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Для Номер = 1 По 3 Цикл
		Строка1 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат1, Номер);
		Строка2 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат2, Номер);
		ЮТест.ОжидаетЧто(Строка2.Результат, "Второй запуск, строка " + Номер + ": уже загружена").Равно("УжеЗагружен");
		ЮТест.ОжидаетЧто(Строка2.Документ, "Второй запуск, строка " + Номер + ": документ первого запуска").Равно(Строка1.Документ);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка2.СозданКонтрагент) Или ЗначениеЗаполнено(Строка2.СозданДоговор)
			Или ЗначениеЗаполнено(Строка2.СозданСчет), "Второй запуск, строка " + Номер + ": объектов не создавал").ЭтоЛожь();
		// Предупреждение повторной проверки: ровно одно для строк 1-2 (найдены после распознавания), нуль для строки 3 (найдена распознаванием).
		ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат2, Номер, "Предупреждение").Количество(),
			"Второй запуск, строка " + Номер + ": предупреждений повторной проверки").Равно(?(Номер < 3, 1, 0));
	КонецЦикла;
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат1, "Первый запуск");
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат2, "Второй запуск");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После2), "Второй запуск не создал ни контрагентов, ни договоров, ни счетов, ни документов")
		.Равно(СМП_ТестыРаспознавания.ПредставлениеКоличеств(После1));

КонецПроцедуры

// Операцию загрузил другой запуск между Распознать и Записать: она не дублируется, а контрагент нового плательщика не создается второй раз
// (для строки, чей документ нашла повторная проверка, объекты не создаются - проход 2 ее пропускает).
Процедура Гонка_ДругойЗапускЗагрузилЧасть_НеДублируется() Экспорт

	Данные = Конверт(СтрРазделить("Умолчанию,КонтрагентСоздать_ФОП", ","));
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(СМП_ТестыЗаписиНаскрозь.НовыйОтветственный());
	Операция2 = Данные.Построенные[1].Операция;

	План = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 2).ДействиеКонтрагент, "Предусловие: в плане контрагент операции 2 - 'Создать'").Равно("Создать");

	// Другой запуск: та же операция 2 (под номером 1 его конверта).
	Другая = Копия(Операция2);
	Другая.ПорядковыйНомер = 1;
	ПланДругого = СМП_ТестыЗаписиНаскрозь.Распознать(Другая);
	РезультатДругого = СМП_ТестыЗаписиКаркас.Записать(ПланДругого, Контекст);
	Загруженный = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(РезультатДругого, 1);
	ЮТест.ОжидаетЧто(Загруженный.Результат, "Предусловие: другой запуск создал документ операции 2").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Загруженный.СозданКонтрагент), "Предусловие: другой запуск создал контрагента операции 2").ЭтоИстина();
	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Строка1 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	Строка2 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 2);
	ЮТест.ОжидаетЧто(Строка1.Результат, "Операция 1 (не загружена) создана").Равно("Создан");
	ЮТест.ОжидаетЧто(Строка2.Результат, "Операция 2 (загружена другим запуском) не дублируется").Равно("УжеЗагружен");
	ЮТест.ОжидаетЧто(Строка2.Документ, "Операция 2: документ другого запуска").Равно(Загруженный.Документ);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка2.СозданКонтрагент), "Операция 2: контрагента второй раз не создавали").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 2, "Предупреждение").Количество(), "Операция 2: ровно одно предупреждение повторной проверки").Равно(1);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.КоличествоДокументов(После) - СМП_ТестыЗаписиНаскрозь.КоличествоДокументов(До), "Создан ровно один документ (операции 1)").Равно(1);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты") - До.Получить("Справочник.Контрагенты"), "Создан ровно один контрагент (операции 1)").Равно(1);
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Операция2.КонтрагентКод), "Контрагент операции 2 - один на весь прогон").Равно(1);
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Гонка, часть загружена");

КонецПроцедуры

// ГРАНИЦА ЗАЩИТЫ (измерение). Две РАЗНЫЕ операции одного нового плательщика (общий код): первый запуск распознал обе, "другой запуск" успел
// записать одну (и создал контрагента), первый записывает вторую со своим планом "Создать контрагента". Ожидание (D6: один контрагент на
// одного плательщика; Review Focus 2/4): контрагент ОДИН.
Процедура Гонка_ДругойЗапускЗагрузилОперациюОбщегоНовогоКонтрагента_КонтрагентОдин() Экспорт

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Название = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Общий_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);
	Общее = Новый Структура("КонтрагентКод, КонтрагентНаименование, КонтрагентНомерСчета", Код, Название, "");
	Операция1 = СМП_ТестыЗаписиНаскрозь.Операция(1, СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), Общее);
	Операция2 = СМП_ТестыЗаписиНаскрозь.Операция(2, СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НаправлениеСписано"), Общее);
	Таблица = СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НоваяВыписка").Операции;
	ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция1);
	ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция2);
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(СМП_ТестыЗаписиНаскрозь.НовыйОтветственный());

	План = СМП_ТестыЗаписиНаскрозь.Распознать(Таблица.Скопировать());
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1).ДействиеКонтрагент, "Предусловие: операция 1 - контрагента создать").Равно("Создать");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 2).ДействиеКонтрагент, "Предусловие: операция 2 - контрагента создать").Равно("Создать");

	Другая = Копия(Операция2);
	Другая.ПорядковыйНомер = 1;
	РезультатДругого = СМП_ТестыЗаписиКаркас.Записать(СМП_ТестыЗаписиНаскрозь.Распознать(Другая), Контекст);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(РезультатДругого, 1).Результат, "Предусловие: другой запуск записал операцию 2").Равно("Создан");
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Код), "Предусловие: после другого запуска контрагент один").Равно(1);

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1).Результат, "Операция 1 создана (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Код), "Контрагент общего плательщика один после записи обоих запусков").Равно(1);

КонецПроцедуры

// Другой запуск создал не только контрагента, но и его счет и договор (D35.5, D6): план первого - "Создать" для всех трех. После записи:
// контрагент один, счет с этим номером один, договор тот, что создал другой запуск (версия и реквизиты не изменены - чужой основной договор
// не доналаштовывается), документ первого лег на найденные объекты, строка названа предупреждением.
Процедура Гонка_ДругойЗапускСоздалКонтрагентаСоСчетомИДоговором_НичегоНеДублируется() Экспорт

	МФО = СМП_ТестыЗаписиНаскрозь.МФОКоторогоНетВБазе();
	СМП_ТестыДанныеУНФ.НовыйБанк(Новый Структура("Код", МФО));
	Номер = СМП_ТестыДанныеУНФ.НовыйIBAN(МФО);
	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Название = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "ОбщийСоСчетом_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);
	Общее = Новый Структура("КонтрагентКод, КонтрагентНаименование, КонтрагентНомерСчета, КонтрагентМФО", Код, Название, Номер, МФО);
	Списано = СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НаправлениеСписано");
	Операция1 = СМП_ТестыЗаписиНаскрозь.Операция(1, Списано, Общее);
	Операция2 = СМП_ТестыЗаписиНаскрозь.Операция(1, Списано, Общее);
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(СМП_ТестыЗаписиНаскрозь.НовыйОтветственный());

	План = СМП_ТестыЗаписиНаскрозь.Распознать(Операция1);
	СтрокаПлана = СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1);
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеКонтрагент, "Предусловие: план - контрагента создать").Равно("Создать");
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеСчет, "Предусловие: план - счет создать").Равно("Создать");
	ЮТест.ОжидаетЧто(СтрокаПлана.ДействиеДоговор, "Предусловие: план - договор создать").Равно("Создать");

	// Другой запуск: та же сторона операции (другие идентификатор и сумма) создает контрагента, счет и договор.
	РезультатДругого = СМП_ТестыЗаписиКаркас.Записать(СМП_ТестыЗаписиНаскрозь.Распознать(Операция2), Контекст);
	Другой = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(РезультатДругого, 1);
	ЮТест.ОжидаетЧто(Другой.Результат, "Предусловие: другой запуск записал документ (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(РезультатДругого) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Другой.СозданКонтрагент) И ЗначениеЗаполнено(Другой.СозданСчет) И ЗначениеЗаполнено(Другой.СозданДоговор),
		"Предусловие: другой запуск создал контрагента, счет и договор").ЭтоИстина();

	Объекты = Новый Массив;
	Объекты.Добавить(Другой.СозданКонтрагент);
	Объекты.Добавить(Другой.СозданСчет);
	Объекты.Добавить(Другой.СозданДоговор);
	Снимок = СМП_ТестыЗаписиНаскрозь.СнимокВерсийСсылок(Объекты);
	ДоДоговора = СМП_ТестыРаспознавания.ДанныеДоговора(Другой.СозданДоговор);
	До = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	После = СМП_ТестыДанныеУНФ.КоличестваОбъектовДляПроверкиЗаписи();

	Строка1 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(Строка1.Результат, "Документ первого запуска создан (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Код), "Контрагент один").Равно(1);
	ЮТест.ОжидаетЧто(СчетовСНомером(Номер), "Счет с этим номером один").Равно(1);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.Контрагенты") - До.Получить("Справочник.Контрагенты"), "Контрагентов не прибавилось").Равно(0);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.БанковскиеСчета") - До.Получить("Справочник.БанковскиеСчета"), "Счетов не прибавилось").Равно(0);
	ЮТест.ОжидаетЧто(После.Получить("Справочник.ДоговорыКонтрагентов") - До.Получить("Справочник.ДоговорыКонтрагентов"), "Договоров не прибавилось").Равно(0);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка1.СозданКонтрагент) Или ЗначениеЗаполнено(Строка1.СозданСчет) Или ЗначениеЗаполнено(Строка1.СозданДоговор),
		"Первый запуск ничего не создавал (создал другой)").ЭтоЛожь();
	Данные = СМП_ТестыЗаписиНаскрозь.ДанныеДокумента(Строка1.Документ);
	ЮТест.ОжидаетЧто(Данные.Контрагент, "Документ лег на контрагента другого запуска").Равно(Другой.СозданКонтрагент);
	ЮТест.ОжидаетЧто(Данные.СчетКонтрагента, "Документ лег на счет другого запуска").Равно(Другой.СозданСчет);
	ЮТест.ОжидаетЧто(Данные.Договор, "Документ лег на договор другого запуска").Равно(Другой.СозданДоговор);
	ЮТест.ОжидаетЧто(Данные.Проведен, "Документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 1, "Предупреждение").Количество() > 0, "Есть предупреждение о найденном вместо созданного").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, 1), "Предупреждение называет причину: создан другим запуском").Содержит("другим запуском");

	// Чужие объекты не изменены: версии те же, договор не доналадили (реквизиты те же).
	СМП_ТестыЗаписиНаскрозь.ПроверитьСуществующиеНеИзменены(Снимок, Неопределено, "Гонка со счетом и договором");
	ПослеДоговора = СМП_ТестыРаспознавания.ДанныеДоговора(Другой.СозданДоговор);
	Для Каждого Имя Из СтрРазделить("Владелец,Организация,ВидДоговора,Наименование", ",") Цикл
		ЮТест.ОжидаетЧто(ПослеДоговора[Имя], "Договор другого запуска не изменен: " + Имя).Равно(ДоДоговора[Имя]);
	КонецЦикла;
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Гонка со счетом и договором");

КонецПроцедуры

// Контрагентов с этим кодом оказалось несколько (другие запуски создали дубли): поведение - как в распознавании при "несколько по коду" (шаг
// ШагКонтрагентСчет): документ ложится на ПЕРВОГО по коду справочника, предупреждение того шага называет число и выбранного; нового
// контрагента не создается. Дубли строят фикстуры (запись продукта дубль бы не создала - это и есть защита).
Процедура Гонка_ДругойЗапускСоздалНесколькихОдногоКода_Берется_ПервыйПоКоду() Экспорт

	Код = СМП_ТестыДанныеУНФ.НовыйЕДРПОУ();
	Название = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Дубль_" + Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 8);
	Операция = СМП_ТестыЗаписиНаскрозь.Операция(1, СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НаправлениеСписано"),
		Новый Структура("КонтрагентКод, КонтрагентНаименование, КонтрагентНомерСчета", Код, Название, ""));
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(СМП_ТестыЗаписиНаскрозь.НовыйОтветственный());
	План = СМП_ТестыЗаписиНаскрозь.Распознать(Операция);
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 1).ДействиеКонтрагент, "Предусловие: план - контрагента создать").Равно("Создать");

	Первый = СМП_ТестыРаспознавания.НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", Код));
	Второй = СМП_ТестыРаспознавания.НовыйКонтрагентТеста(Новый Структура("КодПоЕДРПОУ", Код));
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Код), "Предусловие: контрагентов с кодом два").Равно(2);
	КодПервого = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Первый, "Код").Код;
	КодВторого = СМП_ТестыРаспознавания.ЧитатьРеквизиты(Второй, "Код").Код;
	ЮТест.ОжидаетЧто(КодПервого, "Предусловие: коды справочника различаются").НеРавно(КодВторого);
	ОжидаемыйКонтрагент = ?(КодПервого < КодВторого, Первый, Второй);

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);

	Строка1 = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);
	ЮТест.ОжидаетЧто(КонтрагентовСКодом(Код), "Третий контрагент не создан").Равно(2);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка1.СозданКонтрагент), "Результат не называет контрагента созданным").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка1.Документ), "Документ записан (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат) + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.ДанныеДокумента(Строка1.Документ).Контрагент, "Документ лег на первого по коду справочника").Равно(ОжидаемыйКонтрагент);
	Тексты = СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, 1);
	ЮТест.ОжидаетЧто(Тексты, "Предупреждение шага распознавания: несколько, взят первый по коду").Содержит("взят первый по коду справочника");
	ЮТест.ОжидаетЧто(Тексты, "Предупреждение записи: создан другим запуском").Содержит("другим запуском");
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Несколько найденных");

КонецПроцедуры

// ИЗМЕРЕНИЕ (условие: транзакция теста YaXUnit - внешняя, запись по контракту модуля идет вне транзакции, поэтому транзакция записи в
// проде внешняя, а в тесте вложенная). Вложенные Начать + Отменить внутри транзакции теста: отменяет ли это и внешнюю. От этого зависит,
// можно ли исключение вендорского вызова внутри транзакции группы тестировать в тестовой транзакции (нельзя, если внешняя гибнет).
Процедура Транзакция_ВложеннаяОтмена_Измерение() Экспорт

	ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Предусловие: транзакция теста активна").ЭтоИстина();
	НачатьТранзакцию();
	ОтменитьТранзакцию();
	Активна = ТранзакцияАктивна();
	ЗапросРаботает = Истина;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Справочник.Валюты КАК Т");
		Запрос.Выполнить();
	Исключение
		ЗапросРаботает = Ложь;
	КонецПопытки;
	// Внешняя транзакция теста после вложенной отмены "жива" по ТранзакцияАктивна, но мертва для запросов: как после исключения проведения.
	// Восстановление для харнеса - как в тесте исключения проведения (отмена + новая транзакция); все утверждения после него.
	ОтменитьТранзакцию();
	НачатьТранзакцию();

	// ИЗМЕРЕНО (условие: транзакция теста YaXUnit, платформа 8.3.27): ТранзакцияАктивна остается Истина, но первый же запрос падает.
	// Вывод: вложенная отмена внутри тестовой транзакции убивает ее - исключение вендорского вызова внутри транзакции группы нельзя
	// проверить в тестовой транзакции (и нельзя "поймать" и продолжить). В проде запись идет вне транзакции, и отмена группы
	// откатывает только группу.
	ЮТест.ОжидаетЧто(Активна, "Внешняя транзакция теста после вложенной отмены формально активна").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗапросРаботает, "Запрос после вложенной отмены внутри транзакции теста НЕ работает (транзакция мертва)").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Отказы

// Три разные причины непроведения в одном пакете (Review Focus 3): контрагента создать нельзя; вид налога не задан (правило "Налоги" без
// вида налога). Соседи (до, между и после) записаны и проведены; причина каждого отказа - замечание "Ошибка".
Процедура Отказы_ТриПричиныВОдномПакете_СоседиЗаписаны() Экспорт

	// Налоги без вида налога: правило "списание, Налоги" со статьей, без вида налога (в правиле СМП_ВидНалога пуст).
	Правило = СМП_ТестыРаспознавания.НовоеПравило(СМП_ТестыРаспознавания.НастройкиПравила("Списано", "Налоги",
		Новый Структура("СтатьяДДС", ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.Прочее"))));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Правило.Данные.СМП_ВидНалога), "Предусловие: у правила вид налога не задан").ЭтоЛожь();
	Налоги = СМП_ТестыЗаписиНаскрозь.Операция(3, СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НаправлениеСписано"),
		Новый Структура("КонтрагентНомерСчета, НазначениеПлатежа", "", СМП_ТестыРаспознавания.НазначениеСФразами(Правило.Фраза)));

	Данные = Конверт(СтрРазделить("Умолчанию,КонтрагентНевозможно", ","));
	ДобавитьВТаблицу(Данные.Таблица, Налоги);
	Хвост = СМП_ТестыЗаписиНаскрозь.ПостроитьСлучай("КонтрагентСоздать_ФОП", 4);
	ДобавитьВТаблицу(Данные.Таблица, Хвост.Операция);
	Ответственный = СМП_ТестыЗаписиНаскрозь.НовыйОтветственный();

	План = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3).ИсточникВидаОперации, "Предусловие: строка 3 определена правилом").Равно("ПравилоНазначения");
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3).ВидОперации, "Предусловие: строка 3 - налоги")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Налоги"));
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3).ВидНалога), "Предусловие: вида налога в плане нет").ЭтоЛожь();

	Результат = СМП_ТестыЗаписиКаркас.Записать(План, СМП_ТестыЗаписиКаркас.КонтекстЗаписи(Ответственный));

	Ожидаемые = СтрРазделить("Создан,СозданНепроведенным,СозданНепроведенным,Создан", ",");
	Для Номер = 1 По 4 Цикл
		СтрокаРезультата = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, Номер);
		ЮТест.ОжидаетЧто(СтрокаРезультата.Результат, "Строка " + Номер + " (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, Номер) + ")").Равно(Ожидаемые[Номер - 1]);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаРезультата.Документ), "Строка " + Номер + ": документ записан").ЭтоИстина();
		ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.ДанныеДокумента(СтрокаРезультата.Документ).Проведен, "Строка " + Номер + ": проведен в базе")
			.Равно(Ожидаемые[Номер - 1] = "Создан");
	КонецЦикла;
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, 3), "Причина строки 3 названа: вид налога").Содержит("Вид налога");
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, 2), "Причина строки 2 названа: контрагент").Содержит("Контрагент");
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Отказы");

КонецПроцедуры

// Вендор отказал в проведении ИСКЛЮЧЕНИЕМ (M5 журнала задачи 5): зарплата сотруднику при ответственном БЕЗ основного подразделения. Строка
// последняя в пакете; соседи до нее записаны и проведены (результат "Создан"), сама - записана непроведенной (результат
// "СозданНепроведенным", документ в результате), причина - замечание "Ошибка" с текстом исключения. Состояние базы после исключения не
// читается (транзакция теста мертва; откат унес и документы); "документ остался записанным непроведенным" вне транзакции - гипотеза плана 4б.
Процедура Отказы_ИсключениеПроведенияПоследним_РестПакетаЗаписан() Экспорт

	Данные = Конверт(СтрРазделить("Умолчанию,КонтрагентСоздать_ФОП,Сотрудник", ","));
	Ответственный = СМП_ТестыЗаписиНаскрозь.НовыйОтветственныйБезПодразделения();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Ответственный, "ОсновноеПодразделение")),
		"Предусловие: у ответственного основного подразделения нет").ЭтоЛожь();
	План = СМП_ТестыЗаписиНаскрозь.Распознать(Данные.Таблица.Скопировать());
	ЮТест.ОжидаетЧто(СМП_ТестыРаспознавания.СтрокаПланаПоНомеру(План, 3).ВидОперации, "Предусловие: последняя строка - зарплата сотруднику")
		.Равно(ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ЗарплатаСотруднику"));
	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(Ответственный);
	ПолучитьСообщенияПользователю(Истина);

	Результат = Неопределено;
	ТекстОшибки = Неопределено;
	Попытка
		Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Транзакция теста после исключения проведения непригодна: восстановление, чтобы счетчик харнеса сошелся; БД не читается.
	ОтменитьТранзакцию();
	НачатьТранзакцию();

	ЮТест.ОжидаетЧто(ТекстОшибки, "Записать не пропускает исключение проведения наружу").Равно(Неопределено);
	Ожидаемые = СтрРазделить("Создан,Создан,СозданНепроведенным", ",");
	Для Номер = 1 По 3 Цикл
		СтрокаРезультата = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, Номер);
		ЮТест.ОжидаетЧто(СтрокаРезультата.Результат, "Строка " + Номер + " (замечания: " + СМП_ТестыЗаписиНаскрозь.ТекстыЗамечаний(Результат, Номер) + ")").Равно(Ожидаемые[Номер - 1]);
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(СтрокаРезультата.Документ), "Строка " + Номер + ": документ записан и назван в результате").ЭтоИстина();
	КонецЦикла;
	Причины = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Результат, 3, "Ошибка");
	ЮТест.ОжидаетЧто(Причины.Количество() > 0, "Причина строки-исключения - замечание уровня Ошибка").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Причины[0].Текст), "Текст причины (из исключения) не пуст").ЭтоЛожь();
	СМП_ТестыЗаписиНаскрозь.ПроверитьПравилоУровней(Результат, "Исключение проведения");

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Конверт из случаев по ключам: Таблица (операции с порядковыми номерами 1..N), Построенные, Случаи, Ключи.
Функция Конверт(Ключи) Экспорт

	Таблица = СМП_ТестыРаспознавания.Продукт("СМП_ВыпискаБанка.НоваяВыписка").Операции;
	Построенные = Новый Массив;
	Случаи = Новый Массив;
	Номер = 0;
	Для Каждого Ключ Из Ключи Цикл
		Номер = Номер + 1;
		Построено = СМП_ТестыЗаписиНаскрозь.ПостроитьСлучай(Ключ, Номер);
		ДобавитьВТаблицу(Таблица, Построено.Операция);
		Построенные.Добавить(Построено);
		Случаи.Добавить(СМП_ТестыЗаписиНаскрозь.СлучайПоКлючу(Ключ));
	КонецЦикла;

	Возврат Новый Структура("Таблица, Построенные, Случаи, Ключи", Таблица, Построенные, Случаи, Ключи);

КонецФункции

Процедура ДобавитьВТаблицу(Таблица, Операция)

	ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Операция);

КонецПроцедуры

Функция Копия(Операция)

	Результат = Новый Структура;
	Для Каждого Элемент Из Операция Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Снимок версий существующих объектов всех построенных случаев.
Функция ОбщийСнимок(Построенные)

	Снимок = Новый Соответствие;
	Для Каждого Построено Из Построенные Цикл
		Для Каждого Элемент Из СМП_ТестыЗаписиНаскрозь.СнимокВерсийСуществующих(Построено) Цикл
			Снимок.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Снимок;

КонецФункции

Функция ОбъединитьСнимки(Первый, Второй)

	Результат = Новый Соответствие;
	Для Каждого Элемент Из Первый Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Для Каждого Элемент Из Второй Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Оплачено(Поручение)

	Возврат СМП_ТестыРаспознавания.ЧитатьРеквизиты(Поручение, "Оплачено").Оплачено;

КонецФункции

// Сколько банковских счетов (всех) несут номер.
Функция СчетовСНомером(Номер)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.БанковскиеСчета КАК Т ГДЕ Т.НомерСчета = &Номер");
	Запрос.УстановитьПараметр("Номер", Номер);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Сколько контрагентов (всех) несут код в КодПоЕДРПОУ или в ИНН (код ФОП лежит в ИНН).
Функция КонтрагентовСКодом(Код)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.Контрагенты КАК Т ГДЕ Т.КодПоЕДРПОУ = &Код ИЛИ Т.ИНН = &Код");
	Запрос.УстановитьПараметр("Код", СокрЛП(Код));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти

#Область Сторож

// БЕЗ транзакции, ПОСЛЕДНИМ. Контролирует и то, что транзакция, восстановленная тестом исключения проведения, ничего не оставила в базе.
Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
