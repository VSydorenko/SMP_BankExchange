// Помощник позднего связывания с продуктовым расширением SMP_BankExchange_SMB.
//
// Прямой вызов общего модуля соседнего расширения из тестового расширения не компилируется
// (измерено: SMP_SimplyConnect, docs/architecture/prro/testing.md, раздел 3), поэтому
// продукт тесты вызывают ТОЛЬКО здесь: одно место, исправность которого доказывает пара
// СМП_ТестыПозднееСвязывание. Рассыпанные по тестам строки Вычислить(...) запрещены.
//
// НЕ тестовый набор: ИсполняемыеСценарии здесь нет намеренно.

#Область ПрограммныйИнтерфейс

// Вызывает экспортную ФУНКЦИЮ общего модуля продукта по полному имени.
// Исключение продукта не перехватывается: оно уходит наверх с полным текстом.
//
// Параметры:
//  ИмяМетода - Строка - полное имя "Модуль.Функция", например "СМП_ВыпискаБанка.НоваяВыписка".
//  Параметры - Массив - значения аргументов по порядку; Неопределено - вызов без аргументов.
//
// Возвращаемое значение:
//  Произвольный - результат функции продукта.
Функция Вызвать(ИмяМетода, Параметры = Неопределено) Экспорт

	// Вычислить видит локальные переменные этой функции: аргументы адресуются как П[0], П[1]...
	П = ?(Параметры = Неопределено, Новый Массив, Параметры);

	Части = Новый Массив;
	Для Индекс = 0 По П.ВГраница() Цикл
		Части.Добавить("П[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]");
	КонецЦикла;

	Возврат Вычислить(ИмяМетода + "(" + СтрСоединить(Части, ", ") + ")");

КонецФункции

// Вызывает экспортную ПРОЦЕДУРУ общего модуля продукта по полному имени (Вычислить процедуру не вызывает,
// поэтому Выполнить). Аргументы-объекты (структура, соответствие, таблица) процедура заполняет на месте:
// изменения видны вызывающему через те же значения в Параметры.
// Исключение продукта не перехватывается: оно уходит наверх с полным текстом.
//
// Параметры:
//  ИмяМетода - Строка - полное имя "Модуль.Процедура", например "СМП_ЧитательВыпискиiFOBS_XML.Прочитать".
//  Параметры - Массив - значения аргументов по порядку; Неопределено - вызов без аргументов.
Процедура ВызватьПроцедуру(ИмяМетода, Параметры = Неопределено) Экспорт

	// Выполнить видит локальные переменные этой процедуры: аргументы адресуются как П[0], П[1]...
	П = ?(Параметры = Неопределено, Новый Массив, Параметры);

	Части = Новый Массив;
	Для Индекс = 0 По П.ВГраница() Цикл
		Части.Добавить("П[" + Формат(Индекс, "ЧН=0; ЧГ=") + "]");
	КонецЦикла;

	Выполнить(ИмяМетода + "(" + СтрСоединить(Части, ", ") + ");");

КонецПроцедуры

#КонецОбласти
