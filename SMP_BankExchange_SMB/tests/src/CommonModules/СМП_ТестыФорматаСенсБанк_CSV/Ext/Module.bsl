	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе строки прочитаны").Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].КонтрагентНомерСчета, "Счет контрагента пуст, не из колонки 3").Равно("");
		ЮТест.ОжидаетЧто(Результат.Операции[1].КонтрагентМФО, "МФО контрагента из колонки 5").Равно(ПоляЗаписи("ТОВ", 1)[5]);
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПоляСтрокиИПериод

// Запись с переносом строки внутри кавычек занимает две физические строки; следующая запись нумеруется физической строкой.
Процедура ПорядковыйНомер_ФизическаяСтрокаФайлаПослеМногострочногоПоля() Экспорт

	Многострочная = ПоляЗаписи("ФОП", 1);
	Многострочная[15] = "первая строка" + Символы.ВК + Символы.ПС + "вторая строка";
	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(ПоляЗаписи("ФОП", 0)));
	Строки.Добавить(СтрокаCSV(Многострочная));
	Строки.Добавить(СтрокаCSV(ПоляЗаписи("ФОП", 1)));

	Результат = ПрочитатьСинтетику("ФОП", ФайлИзТекстовыхСтрок(Строки));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе записи прочитаны").Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].ПорядковыйНомер, "Многострочная запись - строка файла 2").Равно(2);
		ЮТест.ОжидаетЧто(Результат.Операции[1].ПорядковыйНомер, "Следующая запись - строка файла 4 (в редакторе)").Равно(4);
		ЮТест.ОжидаетЧто(Результат.Операции[0].НазначениеПлатежа, "Перенос внутри поля сохранен").Содержит("вторая строка");
	КонецЕсли;

КонецПроцедуры

// Период выписки - из дат операций (начало первого и конец последнего дня): в файле шапки с периодом нет.
Процедура Период_ИзДатОперацийЧтениеПолноеТолькоБезПотерь(Описание, ИдОбразца) Экспорт

	Эталон = РазобратьЭталон(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);

	Наименьшая = Неопределено;
	Наибольшая = Неопределено;
	Для Каждого Операция Из Эталон.Операции Цикл
		Момент = ДатаЭталона(Операция.ДатаОперации);
		Наименьшая = ?(Наименьшая = Неопределено, Момент, Мин(Наименьшая, Момент));
		Наибольшая = ?(Наибольшая = Неопределено, Момент, Макс(Наибольшая, Момент));
	КонецЦикла;

	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Начало периода - начало суток первой операции: " + Описание).Равно(НачалоДня(Наименьшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Конец периода - конец суток последней операции: " + Описание).Равно(КонецДня(Наибольшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Без потерь чтение полное: " + Описание).ЭтоИстина();

КонецПроцедуры

// Файл только с заголовком, без операций: выписка принимается как пустая (ничего не потеряно), диагностики нет,
// ЧтениеПолное = Истина, период остается пустым.
Процедура ТолькоЗаголовок_ПустаяВыпискаБезОшибок(Описание, Раскладка) Экспорт

	Результат = ПрочитатьСинтетику(Раскладка, ФайлИзЗаписей(Раскладка, Новый Соответствие, Ложь, 0));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл с одним заголовком принят: " + Раскладка).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет: " + Раскладка).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Диагностики нет: " + Раскладка).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Ничего не потеряно: " + Раскладка).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Период пуст: начало: " + Раскладка).Равно(Дата(1, 1, 1));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Период пуст: конец: " + Раскладка).Равно(Дата(1, 1, 1));

КонецПроцедуры

Процедура ЧужойСчетВФайле_УходитВПредупреждениеПлатформы(Описание, Раскладка, КолонкаСчета) Экспорт

	Замены = Новый Соответствие;
	Замены[КолонкаСчета] = "UA999999999999999999999999999";

	Результат = ПрочитатьСинтетику(Раскладка, ФайлИзЗаписей(Раскладка, Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Осталась строка нашего счета: " + Раскладка).Равно(1);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Предупреждение").Количество(), "Одно предупреждение о чужом счете: " + Раскладка).Равно(1);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет: чужой счет не потеря данных: " + Раскладка).Равно(0);
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Фильтр чужих счетов признак невалидных строк не ставит: " + Раскладка).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ФайлПохожНаФормат

Процедура ФайлПохож_СвоиОбразцыДа(Описание, ИдОбразца) Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыписка" + ИдОбразца)), "Образец узнан: " + Описание).ЭтоИстина();

КонецПроцедуры

Процедура ФайлПохож_ОбразцыДругихФорматовНет(Описание, ИдОбразца) Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыписка" + ИдОбразца)), "Образец другого формата не узнан: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Узнавание идет по заголовку и позициям колонок: число колонок и названия, перечисленные в сценариях; регистр не важен.
Процедура ФайлПохож_ЗаголовокПоПозициямКолонок(Описание, Раскладка, Колонка, НовоеИмя, Ожидание) Экспорт

	Заголовок = ПоляЗаписи(Раскладка, 0);
	Заголовок[Колонка] = НовоеИмя;
	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(Заголовок));
	Строки.Добавить(СтрокаCSV(ПоляЗаписи(Раскладка, 1)));

	ЮТест.ОжидаетЧто(ФайлПохож(ФайлИзТекстовыхСтрок(Строки)), "ФайлПохожНаФормат: " + Описание).Равно(Ожидание);

КонецПроцедуры

Процедура ФайлПохож_НеТекстовыйМусорПустойИКороткийЗаголовок(Описание, Раскладка, Вид) Экспорт

	Если Вид = "пустой" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
	ИначеЕсли Вид = "текст" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("это совсем не выписка", "windows-1251", Ложь);
	Иначе
		Заголовок = ПоляЗаписи(Раскладка, 0);
		Заголовок.Удалить(Заголовок.ВГраница());
		Строки = Новый Массив;
		Строки.Добавить(СтрокаCSV(Заголовок));
		Строки.Добавить(СтрокаCSV(ПоляЗаписи(Раскладка, 1)));
		Файл = ФайлИзТекстовыхСтрок(Строки);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "Не выписка формата: " + Описание).ЭтоЛожь();

КонецПроцедуры

Процедура ФайлПохож_СтрокиРеестраДляФайлаУзнаютТолькоСвою(Описание, ИдОбразца) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Узнанные = Продукт("СтрокиРеестраДляФайла", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Узнанные, ","), "Образец узнает только строка Сенса: " + Описание).Равно("СенсБанк_CSV");

КонецПроцедуры

// XLS под расширением .csv не узнан ни одним форматом: ФайлПохожНаФормат = Ложь, реестр не называет ни одной строки.
Процедура ФайлПохож_XLSПодCSVЛожьИРеестрНеУзнаетНичего() Экспорт

	Данные = Макет("СМП_ТестВыпискаXLSСенсТОВ");
	Параметры = Новый Массив;
	Параметры.Добавить(Данные);

	ЮТест.ОжидаетЧто(ФайлПохож(Данные), "XLS под .csv: ФайлПохожНаФормат Ложь").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Продукт("СтрокиРеестраДляФайла", Параметры).Количество(), "XLS под .csv не узнан ни одной строкой реестра").Равно(0);

КонецПроцедуры

// Контроль: проверка формата умеет отвечать Ложь на файл, который она обязана отвергнуть, и Истина - на допустимый.
Процедура ФайлПохож_ПроверкаУмеетПадать() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаCSVСенсТОВ")), "Допустимый вход: Истина").ЭтоИстина();
	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаXMLПивденный")), "Недопустимый вход: Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПодсказкиРеестра

// Файл Сенса, прочитанный строкой другого формата, отвергается, а ПохожиеСтрокиРеестра называет строку Сенса
// (ожидание задано явно, а не берется из продукта).
Процедура ПохожиеСтрокиРеестра_ФайлСенсаЧерезДругуюСтрокуНазываетСенс(Описание, ИдОбразца, ИдСтроки) Экспорт

	Эталон = РазобратьЭталон(ИдОбразца);
	Результат = ПрочитатьФайл(ИдСтроки, Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз(Эталон.НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл другого формата не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "ПохожиеСтрокиРеестра называет строку Сенса: " + Описание)
		.Равно("СенсБанк_CSV");

КонецПроцедуры

Процедура ПохожиеСтрокиРеестра_XLSПодCSVПодсказокНет() Экспорт

	Результат = ПрочитатьФайл("СенсБанк_CSV", Макет("СМП_ТестВыпискаXLSСенсТОВ"), НомераИз("UA000000000000000000000000000"));

	ЮТест.ОжидаетЧто(Результат.Принята, "XLS под .csv не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.ПохожиеСтрокиРеестра.Количество(), "Подсказок реестра нет: XLS не узнан ни одним форматом").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ФорматМодуля()

	Возврат "СМП_ЧитательВыпискиСенсБанк_CSV";

КонецФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Если СтрНайти(ИмяМетода, ".") = 0 Тогда
		Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(ИдентификаторСтроки);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьФайл", Параметры);

КонецФункции

Функция НомераИз(Номер)

	Номера = Новый Массив;
	Номера.Добавить(Номер);
	Возврат Номера;

КонецФункции

Функция ЗаписьЭталонаДиагностики(Уровень, ПорядковыйНомер, СырьеЗначение)

	Возврат Новый Структура("Уровень, ПорядковыйНомер, Что, СырьеЗначение", Уровень, ПорядковыйНомер, "amount", СырьеЗначение);

КонецФункции

Функция МассивИз(Элемент)

	Массив = Новый Массив;
	Массив.Добавить(Элемент);
	Возврат Массив;

КонецФункции

// Читает образец через реестр, номер нашего счета - из эталона.
Функция ПрочитатьОбразец(ИдОбразца)

	Возврат ПрочитатьФайл("СенсБанк_CSV", Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз(РазобратьЭталон(ИдОбразца).НомерСчетаЧтения));

КонецФункции

// Читает синтетический файл строкой реестра Сенса; наш счет - счет базовой записи раскладки.
Функция ПрочитатьСинтетику(Раскладка, Файл)

	Возврат ПрочитатьФайл("СенсБанк_CSV", Файл, НомераИз(ПоляЗаписи(Раскладка, 1)[?(Раскладка = "ТОВ", 1, 4)]));

КонецФункции

Функция ФайлПохож(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат Продукт(ФорматМодуля() + ".ФайлПохожНаФормат", Параметры);

КонецФункции

Функция Макет(Имя)

	Возврат Обработки.СМП_ТестыМакеты.ПолучитьМакет(Имя);

КонецФункции

Функция Текст1251(Данные)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "windows-1251");

КонецФункции

// Записи файла тем же контейнером, что и продукт, но независимо от модуля формата.
Функция ЗаписиФайла(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Параметры.Добавить("windows-1251");
	Параметры.Добавить(";");
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ЗаписиCSV", Параметры);

КонецФункции

// Соответствие: номер строки файла -> поля записи образца (образцы без многострочных полей).
Функция ЗаписиПоНомеру(ИдОбразца)

	Результат = Новый Соответствие;
	Для Каждого Запись Из ЗаписиФайла(Макет("СМП_ТестВыписка" + ИдОбразца)) Цикл
		Результат[Запись.НомерВИсточнике] = Запись.Поля;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Число из текста общим разбором суммы продукта (проверен в задаче 3), независимо от модуля формата.
Функция Число_(Текст)

	Параметры = Новый Массив;
	Параметры.Добавить(Текст);
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.РазобратьСумму", Параметры);

КонецФункции

Функция СтрокаРеестраПоИдентификатору(Идентификатор)

	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ДиагностикаПоУровню(Результат, Уровень)

	Сообщения = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Сообщения.Добавить(Новый Структура("ПорядковыйНомер, Текст", Сообщение.ПорядковыйНомер, Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

#КонецОбласти

#Область Синтетика

Функция ИдОбразцаРаскладки(Раскладка)

	Возврат ?(Раскладка = "ТОВ", "CSVСенсТОВ", "CSVСенсФОП");

КонецФункции

// Поля записи образца раскладки (0 - заголовок, 1 - первая запись данных), независимо от модуля формата.
Функция ПоляЗаписи(Раскладка, Номер)

	Записи = ЗаписиФайла(Макет("СМП_ТестВыписка" + ИдОбразцаРаскладки(Раскладка)));
	Копия = Новый Массив;
	Для Каждого Поле Из Записи[Номер].Поля Цикл
		Копия.Добавить(Поле);
	КонецЦикла;
	Возврат Копия;

КонецФункции

// Строка CSV: каждое поле в кавычках, кавычка внутри поля удваивается (разбор контейнером возвращает поля как были).
Функция СтрокаCSV(Поля)

	Части = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Части.Добавить("""" + СтрЗаменить(Поле, """", """""") + """");
	КонецЦикла;
	Возврат СтрСоединить(Части, ";");

КонецФункции

Функция ФайлИзТекстовыхСтрок(Строки)

	Возврат ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС,
		"windows-1251", Ложь);

КонецФункции

// Заголовок и Записей записей образца раскладки (первая - как в образце или с заменами, если ЗаменятьВПервой;
// вторая - с заменами: номер колонки -> текст).
Функция ФайлИзЗаписей(Раскладка, Замены, ЗаменятьВПервой = Ложь, Записей = 2)

	Первая = ПоляЗаписи(Раскладка, 1);
	Вторая = ПоляЗаписи(Раскладка, 1);
	Для Каждого Замена Из Замены Цикл
		Вторая[Замена.Ключ] = Замена.Значение;
		Если ЗаменятьВПервой Тогда
			Первая[Замена.Ключ] = Замена.Значение;
		КонецЕсли;
	КонецЦикла;
	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(ПоляЗаписи(Раскладка, 0)));
	Если Записей >= 1 Тогда
		Строки.Добавить(СтрокаCSV(Первая));
	КонецЕсли;
	Если Записей >= 2 Тогда
		Строки.Добавить(СтрокаCSV(Вторая));
	КонецЕсли;
	Возврат ФайлИзТекстовыхСтрок(Строки);

КонецФункции

#КонецОбласти

#Область Эталон

// Разбор эталона версии 1. Значения экранированы (\\, \t, \n, \r), поля разделены TAB.
Функция РазобратьЭталон(ИдОбразца)

	Документ = Макет("СМП_ТестЭталон" + ИдОбразца);
	Результат = Новый Структура("НомерСчетаЧтения, ЗаписейИсточника, ПропущенныхСтрок, Счета, Операции, Диагностика, ЧужиеСчета",
		"", 0, 0, Новый Массив, Новый Массив, Новый Массив, Новый Массив);

	Раздел = "";
	Шапка = Неопределено;
	Для Номер = 1 По Документ.КоличествоСтрок() Цикл
		Строка = СтрЗаменить(Документ.ПолучитьСтроку(Номер), Символ(65279), "");
		Если Строка = "" Или Лев(Строка, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Строка, 1) = "[" Тогда
			Раздел = Строка;
			Шапка = Неопределено;
			Продолжить;
		КонецЕсли;

		Если Раздел = "[Образец]" Или Лев(Строка, 17) = "НомерСчетаЧтения=" Тогда
			Позиция = СтрНайти(Строка, "=");
			Ключ = Лев(Строка, Позиция - 1);
			Значение = РазэкранироватьЭталон(Сред(Строка, Позиция + 1));
			Если Ключ = "НомерСчетаЧтения" Тогда
				Результат.НомерСчетаЧтения = Значение;
			ИначеЕсли Ключ = "ЗаписейИсточника" Тогда
				Результат.ЗаписейИсточника = Число(Значение);
			ИначеЕсли Ключ = "ПропущенныхСтрок" Тогда
				Результат.ПропущенныхСтрок = Число(Значение);
			КонецЕсли;
		ИначеЕсли Раздел = "[Счета]" Тогда
			ПоляСчета = СтрРазделить(Строка, Символы.Таб, Истина);
			Результат.Счета.Добавить(Новый Структура("НомерСчета, Количество", РазэкранироватьЭталон(ПоляСчета[0]), Число(ПоляСчета[1])));
		Иначе
			Поля = СтрРазделить(Строка, Символы.Таб, Истина);
			Для Индекс = 0 По Поля.ВГраница() Цикл
				Поля[Индекс] = РазэкранироватьЭталон(Поля[Индекс]);
			КонецЦикла;
			Если Шапка = Неопределено Тогда
				Шапка = Поля;
				Продолжить;
			КонецЕсли;
			Запись = Новый Структура;
			Для Индекс = 0 По Шапка.ВГраница() Цикл
				Запись.Вставить(Шапка[Индекс], ?(Индекс <= Поля.ВГраница(), Поля[Индекс], ""));
			КонецЦикла;
			Если Раздел = "[Операции]" Тогда
				Запись.ПорядковыйНомер = Число(Запись.ПорядковыйНомер);
				Результат.Операции.Добавить(Запись);
			ИначеЕсли Раздел = "[Диагностика]" Тогда
				Результат.Диагностика.Добавить(Запись);
			ИначеЕсли Раздел = "[ЧужиеСчета]" Тогда
				Результат.ЧужиеСчета.Добавить(Запись);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазэкранироватьЭталон(Текст)

	Если СтрНайти(Текст, "\") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "\" И Позиция < Длина Тогда
			Следующий = Сред(Текст, Позиция + 1, 1);
			Если Следующий = "t" Тогда
				Части.Добавить(Символы.Таб);
			ИначеЕсли Следующий = "n" Тогда
				Части.Добавить(Символы.ПС);
			ИначеЕсли Следующий = "r" Тогда
				Части.Добавить(Символы.ВК);
			ИначеЕсли Следующий = "\" Тогда
				Части.Добавить("\");
			Иначе
				Части.Добавить(Символ + Следующий);
			КонецЕсли;
			Позиция = Позиция + 2;
		Иначе
			Части.Добавить(Символ);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// ГГГГ-ММ-ДДTгг:хх:сс -> Дата.
Функция ДатаЭталона(Текст)

	Возврат Дата(Лев(Текст, 4) + Сред(Текст, 6, 2) + Сред(Текст, 9, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2) + Сред(Текст, 18, 2));

КонецФункции

Функция ТекстДаты(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция ТекстСуммы(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=");

КонецФункции

// Сверка конверта с эталоном: период, счета, ЗаписейИсточника, диагностика.
Процедура СверитьКонверт(Описание, Результат, Эталон, ИдОбразца)

	Наименьшая = Неопределено;
	Наибольшая = Неопределено;
	Для Каждого Операция Из Эталон.Операции Цикл
		Момент = ДатаЭталона(Операция.ДатаОперации);
		Наименьшая = ?(Наименьшая = Неопределено, Момент, Мин(Наименьшая, Момент));
		Наибольшая = ?(Наибольшая = Неопределено, Момент, Макс(Наибольшая, Момент));
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Образец " + Описание + ": НачалоПериода (начало суток минимальной даты операции эталона)")
		.Равно(НачалоДня(Наименьшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Образец " + Описание + ": КонецПериода (конец суток максимальной даты операции эталона)")
		.Равно(КонецДня(Наибольшая));

	Порядок = Новый Массив;
	Количества = Новый Соответствие;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Количества[Операция.НомерСчета] = Неопределено Тогда
			Количества[Операция.НомерСчета] = 0;
			Порядок.Добавить(Операция.НомерСчета);
		КонецЕсли;
		Количества[Операция.НомерСчета] = Количества[Операция.НомерСчета] + 1;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Порядок.Количество(), "Образец " + Описание + ": число счетов в операциях").Равно(Эталон.Счета.Количество());
	Для Индекс = 0 По Мин(Порядок.Количество(), Эталон.Счета.Количество()) - 1 Цикл
		ЮТест.ОжидаетЧто(Порядок[Индекс], "Образец " + Описание + ": счет №" + (Индекс + 1)).Равно(Эталон.Счета[Индекс].НомерСчета);
		ЮТест.ОжидаетЧто(Количества[Порядок[Индекс]], "Образец " + Описание + ": число операций счета №" + (Индекс + 1))
			.Равно(Эталон.Счета[Индекс].Количество);
	КонецЦикла;
	Если Порядок.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(Порядок[0], "Образец " + Описание + ": первый счет - НомерСчетаЧтения").Равно(Эталон.НомерСчетаЧтения);
	КонецЕсли;

	Записи = ЗаписиФайла(Макет("СМП_ТестВыписка" + ИдОбразца));
	ЮТест.ОжидаетЧто(Записи.Количество() - 1, "Образец " + Описание + ": записей источника (независимый разбор)").Равно(Эталон.ЗаписейИсточника);
	Потеряно = ДиагностикаПоУровню(Результат, "Ошибка").Количество();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() + Потеряно, "Образец " + Описание + ": операции + потерянные строки = ЗаписейИсточника")
		.Равно(Эталон.ЗаписейИсточника - Эталон.ПропущенныхСтрок);

	Расхождения = РасхожденияДиагностики(Результат, Эталон.Диагностика);
	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, Символы.ПС), "Образец " + Описание + ": диагностика против эталона").Равно("");

КонецПроцедуры

Функция РасхожденияДиагностики(Результат, ЭталонДиагностика)

	Расхождения = Новый Массив;
	Если Результат.Диагностика.Количество() <> ЭталонДиагностика.Количество() Тогда
		Расхождения.Добавить("Число записей диагностики: ожидалось " + ЭталонДиагностика.Количество() + ", получено "
			+ Результат.Диагностика.Количество());
		Возврат Расхождения;
	КонецЕсли;
	Для Индекс = 0 По ЭталонДиагностика.ВГраница() Цикл
		Ожидаемая = ЭталонДиагностика[Индекс];
		Полученная = Результат.Диагностика[Индекс];
		Если Полученная.Уровень <> Ожидаемая.Уровень Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": уровень «" + Полученная.Уровень + "», ожидался «" + Ожидаемая.Уровень + "»");
		КонецЕсли;
		Если Формат(Полученная.ПорядковыйНомер, "ЧГ=") <> Ожидаемая.ПорядковыйНомер Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": порядковый номер " + Полученная.ПорядковыйНомер + ", ожидался " + Ожидаемая.ПорядковыйНомер);
		КонецЕсли;
		Если Не ПустаяСтрока(Ожидаемая.СырьеЗначение) И СтрНайти(Полученная.Текст, Ожидаемая.СырьеЗначение) = 0 Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": текст не содержит сырое значение «" + Ожидаемая.СырьеЗначение + "»");
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождения;

КонецФункции

// Сверка одной операции с эталоном поле за полем: «образец, строка файла, поле, ожидаемое, полученное».
// Известное отступление (поле ПолеОтступления): Валюта - эталон пуст, получено "980", а колонка «Валюта» записи
// файла (5, раскладка ФОП) - UAH.
Процедура СверитьОперацию(Образец, Операция, Ожидаемая, ПолеОтступления, Отступления, Записи)

	Сообщение = "Образец " + Образец + ", строка " + Ожидаемая.ПорядковыйНомер + ", поле ";

	Сверка = Новый Структура;
	Сверка.Вставить("ПорядковыйНомер", Новый Структура("Ожидаемое, Полученное", Формат(Ожидаемая.ПорядковыйНомер, "ЧГ="), Формат(Операция.ПорядковыйНомер, "ЧГ=")));
	Сверка.Вставить("НомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерСчета, Операция.НомерСчета));
	Сверка.Вставить("Валюта", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Валюта, Операция.Валюта));
	Сверка.Вставить("ДатаОперации", Новый Структура("Ожидаемое, Полученное", Ожидаемая.ДатаОперации, ТекстДаты(Операция.ДатаОперации)));
	Сверка.Вставить("НомерДокумента", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерДокумента, Операция.НомерДокумента));
	Сверка.Вставить("Сумма", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Сумма, ТекстСуммы(Операция.Сумма)));
	Сверка.Вставить("Направление", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Направление, Операция.Направление));
	Сверка.Вставить("КонтрагентНаименование", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНаименование, Операция.КонтрагентНаименование));
	Сверка.Вставить("КонтрагентНомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНомерСчета, Операция.КонтрагентНомерСчета));
	Сверка.Вставить("КонтрагентКод", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентКод, Операция.КонтрагентКод));
	Сверка.Вставить("КонтрагентМФО", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентМФО, Операция.КонтрагентМФО));
	Сверка.Вставить("НазначениеПлатежа", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НазначениеПлатежа, Операция.НазначениеПлатежа));

	Для Каждого Поле Из Сверка Цикл
		Ожидаемое = Поле.Значение.Ожидаемое;
		Полученное = Поле.Значение.Полученное;
		Если Полученное <> Ожидаемое Тогда
			Если Поле.Ключ = ПолеОтступления И ЭтоИзвестноеОтступление(Поле.Ключ, Ожидаемое, Полученное, Операция, Записи) Тогда
				Отступления.Добавить(Операция.ПорядковыйНомер);
				Продолжить;
			КонецЕсли;
			ЮТест.ОжидаетЧто(Полученное, Сообщение + Поле.Ключ + ": ожидалось «" + Ожидаемое + "»").Равно(Ожидаемое);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Известное отступление: Валюта - эталон пуст, получено "980", колонка 5 записи файла - UAH.
Функция ЭтоИзвестноеОтступление(Поле, Ожидаемое, Полученное, Операция, Записи)

	Если Поле = "Валюта" Тогда
		Поля = Записи[Операция.ПорядковыйНомер];
		Возврат Ожидаемое = "" И Полученное = "980" И Поля <> Неопределено И СокрЛП(Поля[5]) = "UAH";
	КонецЕсли;
	Возврат Ложь;

КонецФункции

#КонецОбласти
