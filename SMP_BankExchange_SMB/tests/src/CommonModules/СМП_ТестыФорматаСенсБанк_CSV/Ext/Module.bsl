#Область Реестр

Процедура Реестр_ОднаСтрокаСенсНаДвеРаскладки() Экспорт

	Найдено = 0;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат <> ФорматМодуля() Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ЮТест.ОжидаетЧто(СтрокаРеестра.Идентификатор, "Идентификатор строки").Равно("СенсБанк_CSV");
		ЮТест.ОжидаетЧто(СтрокаРеестра.ИмяСтаройОбработки, "Имя старой обработки").Равно("СМП_ОбработкаВыпискиБанка_СенсБанк");
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокаРеестра.РасширенияФайлов, ","), "Расширения файлов").Равно("csv");
		ЮТест.ОжидаетЧто(СтрокаРеестра.Представление, "Представление").Равно(СтрокаРеестра.Банк + " — " + СтрокаРеестра.ТипФайла);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено, "Строк реестра формата Сенс CSV (ТОВ и ФОП - одна строка)").Равно(1);

КонецПроцедуры

// Правило КодыБанка: МФО из IBAN собственного счета образца (позиции 5-10); счет берется из эталона, а не из кода продукта.
Процедура Реестр_КодыБанкаВключаютМФОИзIBANСчетаОбразцов(Описание, ИдОбразца) Экспорт

	МФО = Сред(РазобратьЭталон(ИдОбразца).НомерСчетаЧтения, 5, 6);
	СтрокаРеестра = СтрокаРеестраПоИдентификатору("СенсБанк_CSV");

	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть: " + Описание).ЭтоИстина();
	Если СтрокаРеестра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаРеестра.КодыБанка) = Тип("Массив"), "КодыБанка - массив: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрокаРеестра.КодыБанка.Найти(МФО) <> Неопределено, "КодыБанка содержат МФО из IBAN счета образца " + МФО + ": " + Описание).ЭтоИстина();
	Виденные = Новый Соответствие;
	Для Каждого Код Из СтрокаРеестра.КодыБанка Цикл
		ЮТест.ОжидаетЧто(СтрДлина(Код) = 6 И ТолькоЦифры(Код), "Код банка - шесть цифр: " + Описание).ЭтоИстина();
		ЮТест.ОжидаетЧто(Виденные[Код] = Неопределено, "Код банка не повторяется: " + Описание).ЭтоИстина();
		Виденные[Код] = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура Реестр_ВариантаНет() Экспорт

	СтрокаРеестра = СтрокаРеестраПоИдентификатору("СенсБанк_CSV");
	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра <> Неопределено Тогда
		ЮТест.ОжидаетЧто(СтрокаРеестра.Вариант, "Вариант строки: раскладки - ветки модуля по признаку файла").Равно("");
	КонецЕсли;

КонецПроцедуры

Процедура Описание_КодировкаИдентификаторыОстатки() Экспорт

	Описание = Продукт(ФорматМодуля() + ".ОписаниеЧитателя");

	ЮТест.ОжидаетЧто(Описание.Кодировка, "Кодировка образцов").Равно("windows-1251");
	ЮТест.ОжидаетЧто(Описание.ДаетИдентификаторыОпераций, "Старая обработка идентификатор банка не читала").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Описание.ДаетОстатки, "Остатков в файле нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Описание.РасширенияФайлов, ","), "Расширения файлов").Равно("csv");

КонецПроцедуры

Процедура Описание_ПроходитПроверкуКонтракта() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Продукт(ФорматМодуля() + ".ОписаниеЧитателя"));
	Ошибки = Продукт("СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, Символы.ПС), "Ошибки описания читателя").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбразцыПротивЭталона

// Конверт на образце равен эталону поле за полем. Сообщение: образец, строка файла, поле, ожидаемое, полученное.
//
// Известное отступление от эталона (уточнение отступления 2, решение планувальника, журнал задачи 7):
//  - ФОП, Валюта, 8 строк: эталон (старая обработка + отступление 2 в прежней редакции) валюту ФОП оставляет
//    пустой, продукт берет код из колонки «Валюта» файла (5): UAH -> 980. Отступление - ожидаемое пусто,
//    полученное "980", а колонка 5 записи - "UAH". ТОВ отступлений не имеет.
// Любое другое расхождение, как и иное число отступлений, - красный.
// ДатаДокумента: эталон поля не содержит, продукт его не заполняет (спека D17, коммит 1db1c65): старая обработка
// кладет в ДатаДок день операции, а при пустой ДатаДокумента ключ берет дату операции. Тест требует пустую
// ДатаДокумента во всех строках.
//
// Сверяется конверт целиком: период (по датам операций ЭТАЛОНА), счета и их порядок, НомерСчетаЧтения,
// ЗаписейИсточника (независимый разбор контейнером), диагностика (уровень, номер, сырое значение).
Процедура Образец_КонвертРавенЭталону(Описание, ИдОбразца, ПолеОтступления, ЧислоОтступлений) Экспорт

	Эталон = РазобратьЭталон(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);
	Записи = ЗаписиПоНомеру(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл принят: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Эталон.Операции.Количество(), "Эталон не пуст: " + Описание).НеРавно(0);
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Число операций: " + Описание).Равно(Эталон.Операции.Количество());
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(),
		"Диагностика пуста (в эталоне " + Эталон.Диагностика.Количество() + ", чужих счетов " + Эталон.ЧужиеСчета.Количество() + "): " + Описание)
		.Равно(Эталон.Диагностика.Количество() + Эталон.ЧужиеСчета.Количество());
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Файл прочитан полностью: " + Описание).ЭтоИстина();

	Отступления = Новый Массив;
	Для Индекс = 0 По Мин(Результат.Операции.Количество(), Эталон.Операции.Количество()) - 1 Цикл
		СверитьОперацию(Описание, Результат.Операции[Индекс], Эталон.Операции[Индекс], ПолеОтступления, Отступления, Записи);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Отступления.Количество(), "Образец " + Описание + ": строк с известным отступлением в поле «" + ПолеОтступления + "»")
		.Равно(ЧислоОтступлений);

	СверитьКонверт(Описание, Результат, Эталон, ИдОбразца);

	СДатой = 0;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Операция.ДатаДокумента <> Дата(1, 1, 1) Тогда
			СДатой = СДатой + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СДатой, "Образец " + Описание + ": строк с непустой ДатаДокумента (отступление - пуста во всех)").Равно(0);

КонецПроцедуры

Процедура Образец_СырыеДанныеДословно(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);
	Строки = СтрРазделить(Текст1251(Макет("СМП_ТестВыписка" + ИдОбразца)), Символы.ПС);

	Для Каждого Операция Из Результат.Операции Цикл
		Ожидаемое = СтрЗаменить(Строки[Операция.ПорядковыйНомер - 1], Символы.ВК, "");
		ЮТест.ОжидаетЧто(Операция.СырыеДанные, "Образец " + Описание + ", строка " + Операция.ПорядковыйНомер
			+ ", поле СырыеДанные: ожидалась запись файла").Равно(Ожидаемое);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны: " + Описание).ЭтоИстина();

КонецПроцедуры

// Контроль: на образцах эталонная диагностика пуста, и сверка диагностики там вакуумна. Здесь она выполняется
// на синтетическом файле с нераспознанной суммой против «эталонной» диагностики, верной и испорченной.
Процедура Образец_СверкаДиагностикиУмеетПадать() Экспорт

	Замены = Новый Соответствие;
	Замены[11] = "-";
	Результат = ПрочитатьСинтетику("ТОВ", ФайлИзЗаписей("ТОВ", Замены));

	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "-"))).Количество(),
		"Верная эталонная диагностика: расхождений нет").Равно(0);
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Предупреждение", "3", "-"))).Количество() > 0,
		"Иной уровень пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "4", "-"))).Количество() > 0,
		"Иной порядковый номер пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "12ab"))).Количество() > 0,
		"Иное сырое значение пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, Новый Массив).Количество() > 0,
		"Пустая эталонная диагностика против непустой пойман").ЭтоИстина();

КонецПроцедуры

Процедура Образец_ИдентификаторОперацииПуст(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);

	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.ИдентификаторОперации, "Идентификатора банка в файле нет, " + Описание + ", строка " + Операция.ПорядковыйНомер).Равно("");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны: " + Описание).ЭтоИстина();

КонецПроцедуры

// Известная особенность: НомерСчета операции берется из колонки файла (ТОВ - «Наш IBAN», ФОП - «Счет»), а не из
// Параметры.НомерСчета: так фильтр чужих счетов платформы видит настоящий счет строки.
Процедура Образец_НашСчетСтрокиИзКолонкиФайла(Описание, ИдОбразца) Экспорт

	Эталон = РазобратьЭталон(ИдОбразца);

	Результат = ПрочитатьФайл("СенсБанк_CSV", Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз("UA000000000000000000000000000"));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Все строки файла - чужого счета и отфильтрованы: " + Описание).Равно(0);
	Предупреждения = ТекстыПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о чужом счете: " + Описание).Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет счет из файла: " + Описание).Содержит(Эталон.НомерСчетаЧтения);
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет число строк: " + Описание).Содержит(Формат(Эталон.Операции.Количество(), "ЧГ="));
	КонецЕсли;

КонецПроцедуры

Процедура Образец_ОстатковВФайлеНет(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Выписка.НачальныйОстаток, "Начальный остаток не задан: " + Описание).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Результат.Выписка.КонечныйОстаток, "Конечный остаток не задан: " + Описание).Равно(Неопределено);

КонецПроцедуры

// Правило направления ТОВ «Кредит - поступило, Дебет - списано» доказано образцом: оба значения есть в колонке 2,
// кроме них других нет, а эталон называет «Поступило» ровно там, где «Кредит».
Процедура Образец_НаправлениеТОВДоказаноОбразцом() Экспорт

	Эталон = РазобратьЭталон("CSVСенсТОВ");
	Записи = ЗаписиПоНомеру("CSVСенсТОВ");
	НаправлениеПоСтроке = Новый Соответствие;
	Для Каждого Операция Из Эталон.Операции Цикл
		НаправлениеПоСтроке[Операция.ПорядковыйНомер] = Операция.Направление;
	КонецЦикла;

	Кредитов = 0;
	Дебетов = 0;
	Для Каждого Элемент Из Записи Цикл
		Если Элемент.Ключ = 1 Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Элемент.Значение[2]);
		ЮТест.ОжидаетЧто(Значение = "Кредит" Или Значение = "Дебет", "Строка " + Элемент.Ключ + ": операция - Дебет или Кредит").ЭтоИстина();
		ЮТест.ОжидаетЧто(НаправлениеПоСтроке[Элемент.Ключ], "Строка " + Элемент.Ключ + ", поле Направление")
			.Равно(?(Значение = "Кредит", "Поступило", "Списано"));
		Если Значение = "Кредит" Тогда
			Кредитов = Кредитов + 1;
		Иначе
			Дебетов = Дебетов + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Кредитов > 0 И Дебетов > 0, "В образце есть обе стороны").ЭтоИстина();
	ЮТест.ОжидаетЧто(Кредитов + Дебетов, "Проверено строк").Равно(Эталон.Операции.Количество());

КонецПроцедуры

// Правило направления ФОП «ненулевая колонка» доказано образцом: в каждой строке одна из колонок 13 «Дебет» и
// 14 «Кредит» - строка "0", другая - ненулевая сумма; эталон называет «Списано» ровно там, где ненулевой дебет.
Процедура Образец_НаправлениеФОПДоказаноОбразцом() Экспорт

	Эталон = РазобратьЭталон("CSVСенсФОП");
	Записи = ЗаписиПоНомеру("CSVСенсФОП");
	НаправлениеПоСтроке = Новый Соответствие;
	Для Каждого Операция Из Эталон.Операции Цикл
		НаправлениеПоСтроке[Операция.ПорядковыйНомер] = Операция.Направление;
	КонецЦикла;

	Дебетов = 0;
	Кредитов = 0;
	Для Каждого Элемент Из Записи Цикл
		Если Элемент.Ключ = 1 Тогда
			Продолжить;
		КонецЕсли;
		Дебет = Число_(Элемент.Значение[13]);
		Кредит = Число_(Элемент.Значение[14]);
		ЮТест.ОжидаетЧто((Дебет = 0) <> (Кредит = 0), "Строка " + Элемент.Ключ + ": ненулевая ровно одна из колонок").ЭтоИстина();
		ЮТест.ОжидаетЧто(НаправлениеПоСтроке[Элемент.Ключ], "Строка " + Элемент.Ключ + ", поле Направление")
			.Равно(?(Дебет <> 0, "Списано", "Поступило"));
		Если Дебет <> 0 Тогда
			Дебетов = Дебетов + 1;
		Иначе
			Кредитов = Кредитов + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Кредитов > 0 И Дебетов > 0, "В образце есть обе стороны").ЭтоИстина();
	ЮТест.ОжидаетЧто(Кредитов + Дебетов, "Проверено строк").Равно(Эталон.Операции.Количество());

КонецПроцедуры

#КонецОбласти

#Область ВыборРаскладки

// Раскладка ТОВ - первая колонка данных длиннее десяти символов (в образце 14).
Процедура Раскладка_ТОВПоДлинеПервойКолонкиБольшеДесяти() Экспорт

	Замены = Новый Соответствие;
	Замены[0] = "12345678901";
	Образцовая = ПоляЗаписи("ТОВ", 1);

	Результат = ПрочитатьСинтетику("ТОВ", ФайлИзЗаписей("ТОВ", Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Одиннадцать символов - раскладка ТОВ, обе строки прочитаны").Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].НомерДокумента, "Номер документа из колонки 10 (раскладка ТОВ)").Равно(Образцовая[10]);
	КонецЕсли;

КонецПроцедуры

// Раскладка ФОП - первая колонка данных не длиннее десяти символов: строка ТОВ с десятью символами в колонке 0 читается
// как ФОП, и ее колонка 0 - не дата: «Ошибка» с сырым значением.
Процедура Раскладка_ФОППриДлинеПервойКолонкиДесять() Экспорт

	Замены = Новый Соответствие;
	Замены[0] = "1234567890";

	Результат = ПрочитатьСинтетику("ТОВ", ФайлИзЗаписей("ТОВ", Замены));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Десять символов - раскладка ФОП, строка отброшена").Равно(1);
	Ошибки = ДиагностикаПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка").Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0].ПорядковыйНомер, "Ошибка привязана к строке файла 3").Равно(3);
		ЮТест.ОжидаетЧто(Ошибки[0].Текст, "Текст ошибки содержит сырое значение").Содержит("1234567890");
	КонецЕсли;

КонецПроцедуры

// Раскладка выбирается по каждой записи, а не по файлу (как в старой обработке): в одном файле запись ТОВ и запись ФОП
// читаются каждая по своей раскладке.
Процедура Раскладка_ВФайлеСмешанныеСтрокиЧитаютсяКаждаяПоСвоей() Экспорт

	ПоляТОВ = ПоляЗаписи("ТОВ", 1);
	ПоляФОП = ПоляЗаписи("ФОП", 1);
	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(ПоляЗаписи("ТОВ", 0)));
	Строки.Добавить(СтрокаCSV(ПоляТОВ));
	Строки.Добавить(СтрокаCSV(ПоляФОП));
	Номера = Новый Массив;
	Номера.Добавить(ПоляТОВ[1]);
	Номера.Добавить(ПоляФОП[4]);

	Результат = ПрочитатьФайл("СенсБанк_CSV", ФайлИзТекстовыхСтрок(Строки), Номера);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе записи прочитаны").Равно(2);
	Если Результат.Операции.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].НомерДокумента, "Запись ТОВ: номер из колонки 10").Равно(ПоляТОВ[10]);
		ЮТест.ОжидаетЧто(Результат.Операции[0].НомерСчета, "Запись ТОВ: счет из колонки 1").Равно(ПоляТОВ[1]);
