// NUMBER = Прав(Номер, 10): теряется ЛЕВАЯ часть; предупреждение тоже (иначе потеря номера была бы немой).
Процедура Номер_Прав10_КакВЭталоне(Описание, Номер, Ожидаемый, ЖдатьПредупреждение) Экспорт

	Поручение = Поручение();
	Поручение.Номер = Номер;
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(ЗаписиФайла(Результат.Данные)[0]["NUMBER"], Описание + ": NUMBER").Равно(Ожидаемый);
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": число предупреждений").Равно(?(ЖдатьПредупреждение, 1, 0));
	Если ЖдатьПредупреждение И Результат.Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Поле, Описание + ": поле").Равно("NUMBER");
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Предел, Описание + ": предел").Равно(10);
	КонецЕсли;

КонецПроцедуры

Процедура Предупреждения_СоставЗаписи() Экспорт

	Поручение = Поручение();
	Поручение.Плательщик.Наименование = Повтор("Ж", 50);
	Поручение.НазначениеПлатежа = "а=б";
	Результат = Сформировать(ВМассив(Поручение));

	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), "Два предупреждения: обрезано имя, очищено назначение").Равно(2);
	Для Каждого Предупреждение Из Результат.Предупреждения Цикл
		Для Каждого Свойство Из СтрРазделить("ИндексПоручения,Поле,Действие,Предел,Символы,Текст", ",") Цикл
			Нашлось = ТипЗнч(Предупреждение) = Тип("Структура") И Предупреждение.Свойство(Свойство);
			ЮТест.ОжидаетЧто(Нашлось, "Свойство " + Свойство).ЭтоИстина();
		КонецЦикла;
	КонецЦикла;
	Если Результат.Предупреждения.Количество() = 2 Тогда
		Обрезано = Результат.Предупреждения[0];
		Очищено = Результат.Предупреждения[1];
		ЮТест.ОжидаетЧто(Обрезано.Действие, "Первое - обрезание").Равно("Обрезано");
		ЮТест.ОжидаетЧто(Обрезано.Символы, "Обрезание: набор символов пуст").Равно("");
		ЮТест.ОжидаетЧто(Очищено.Действие, "Второе - очистка").Равно("Очищено");
		ЮТест.ОжидаетЧто(Очищено.Предел, "Очистка: предел 0").Равно(0);
		ЮТест.ОжидаетЧто(Очищено.Символы, "Очистка: набор прибранного").Равно("=");
		ЮТест.ОжидаетЧто(Очищено.Поле, "Очистка: поле").Равно("DETAILS");
	КонецЕсли;

КонецПроцедуры

