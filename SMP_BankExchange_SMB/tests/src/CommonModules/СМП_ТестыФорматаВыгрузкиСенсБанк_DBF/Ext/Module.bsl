// Тесты модуля формата вывода DBF Сенса (СМП_ФорматВыгрузкиСенсБанк_DBF) и записи DBF в памяти
// (СМП_ЧтениеВыписокОбщее.ДвоичныеДанныеDBF); план 07, задача 4.
//
// Один модуль на оба уровня: запись DBF проверяется и прямым вызовом (круг с собственным чтением DBF этапа 2,
// границы, ошибки), и через модуль формата - это один путь "поручение - байты - прочитанное".
//
// Эталон - Выгрузить_Бух копии обработки СенсБанк (гарнес СМП_ТестыЭталонаВыгрузки.ФайлЭталона): вход эталона
// строится из ТЕХ ЖЕ нормализованных поручений, файлы сравниваются БАЙТ В БАЙТ. В заголовке DBF эталона стоит ТЕКУЩАЯ
// дата (байты 1-3: год-1900, месяц, день), модуль пишет дату из момента-параметра; поэтому сравнение идет после
// маскирования ровно этих трех байт на смещении 1 и больше ничего не маскируется (тест Маска_...). Отступления плана:
//  - байты формируются в памяти собственной записью DBF, без XBase и без временного файла;
//  - имя файла и дата заголовка - из момента-параметра; в имени 24-часовой формат (в эталоне ДФ=yyMMhhmm - 12-часовой).
//  Отступлений по кодам нет: DBF Сенса эталон пишет по смыслу (OKPO_A - организация, OKPO_B - контрагент).
//
// Таблица входа гарнеса обрезает значения длиннее колонки (коды 10, счет 34, МФО 9) молча, поэтому сравнение
// байт-в-байт на таких значениях доказывало бы только обрезание гарнеса; случаи длиннее колонок идут прямым вызовом
// модуля с явным ожиданием (по ширине поля файла), а тесты называются ПрямойВызов_...
//
// Продукт вызывается только через СМП_ТестыВызовПродукта. Данные выдуманные (СМП_ТЕСТ_...), база не читается.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Формат Сенса DBF: описание и имя файла")
			.ДобавитьСерверныйТест("Описание_ИдентификаторКодировкаРасширение")
			.ДобавитьСерверныйТест("Описание_РасширениеКакУКопииОбработки")
			.ДобавитьСерверныйТест("ИмяФайла_ИзМоментаИРасширения")
				.СПараметрами("день, 13:45:30", Дата(2026, 10, 15, 13, 45, 30), "Sens_20261015_134530.dbf")
				.СПараметрами("после полуночи, 00:05:09", Дата(2026, 1, 2, 0, 5, 9), "Sens_20260102_000509.dbf")
				.СПараметрами("вечер, 23:59:58", Дата(2027, 12, 31, 23, 59, 58), "Sens_20271231_235958.dbf")
			.ДобавитьСерверныйТест("ИмяФайла_ЗависитТолькоОтМомента")
