КонецФункции

Процедура УстановитьПоле(Поручение, Путь, Значение)

	Части = СтрРазделить(Путь, ".");
	Текущее = Поручение;
	Для Индекс = 0 По Части.ВГраница() - 1 Цикл
		Текущее = Текущее[Части[Индекс]];
	КонецЦикла;
	Текущее[Части[Части.ВГраница()]] = Значение;

КонецПроцедуры

Функция ВМассив(Значение)

	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

Функция ВМассивИз(Первое, Второе, Третье = Неопределено, Четвертое = Неопределено)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);
	Если Третье <> Неопределено Тогда
		Результат.Добавить(Третье);
	КонецЕсли;
	Если Четвертое <> Неопределено Тогда
		Результат.Добавить(Четвертое);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Повтор(Символы, Количество)

	Части = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Части.Добавить(Символы);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// Снимок значения (структура, массив, примитивы) строкой XML: для сравнения "до и после" и "первый и второй раз".
Функция Снимок(Значение)

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

