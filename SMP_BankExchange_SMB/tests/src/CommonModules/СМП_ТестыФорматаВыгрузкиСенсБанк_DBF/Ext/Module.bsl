// Два поручения с разными кодами сторон, ведущими нулями, длинными и спецсимвольными полями. Значения в пределах
// колонок таблицы эталона (коды 10, счет 34, МФО 9).
Функция БогатыйНабор()

	Результат = Новый Массив;
	Результат.Добавить(Поручение("12", 1234567.5));

