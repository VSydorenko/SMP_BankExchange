#Область ОбрезаниеИПредупреждения

Процедура Обрезание_ПолеДлиннееШирины_КакВЭталонеИПредупреждение(Описание, Путь, Ключ, Предел) Экспорт

	Значение = Повтор("Ж", 200);
	Поручение = Поручение();
	УстановитьПоле(Поручение, Путь, Значение);
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);
	Записи = ЗаписиФайла(Результат.Данные);

	ЮТест.ОжидаетЧто(СтрДлина(Записи[0][Ключ]), Описание + ": длина " + Ключ).Равно(Предел);
	ЮТест.ОжидаетЧто(Записи[0][Ключ], Описание + ": начало значения").Равно(Лев(Значение, Предел));
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": число предупреждений").Равно(1);
	Если Результат.Предупреждения.Количество() = 1 Тогда
		Предупреждение = Результат.Предупреждения[0];
		ЮТест.ОжидаетЧто(Предупреждение.ИндексПоручения, Описание + ": индекс поручения").Равно(0);
		ЮТест.ОжидаетЧто(Предупреждение.Поле, Описание + ": поле").Равно(Ключ);
		ЮТест.ОжидаетЧто(Предупреждение.Действие, Описание + ": действие").Равно("Обрезано");
		ЮТест.ОжидаетЧто(Предупреждение.Предел, Описание + ": предел").Равно(Предел);
		ЮТест.ОжидаетЧто(Предупреждение.Текст, Описание + ": текст называет поле").Содержит(Ключ);
		ЮТест.ОжидаетЧто(Предупреждение.Текст, Описание + ": текст называет предел").Содержит(Формат(Предел, "ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

