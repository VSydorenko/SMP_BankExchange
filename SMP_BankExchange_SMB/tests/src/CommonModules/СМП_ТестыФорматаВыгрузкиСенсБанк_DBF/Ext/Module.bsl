// Тесты модуля формата вывода DBF Сенса (СМП_ФорматВыгрузкиСенсБанк_DBF) и записи DBF в памяти
// (СМП_ЧтениеВыписокОбщее.ДвоичныеДанныеDBF); план 07, задача 4.
//
// Один модуль на оба уровня: запись DBF проверяется и прямым вызовом (круг с собственным чтением DBF этапа 2,
// границы, ошибки), и через модуль формата - это один путь "поручение - байты - прочитанное".
//
// Эталон - Выгрузить_Бух копии обработки СенсБанк (гарнес СМП_ТестыЭталонаВыгрузки.ФайлЭталона): вход эталона
// строится из ТЕХ ЖЕ нормализованных поручений, файлы сравниваются БАЙТ В БАЙТ. В заголовке DBF эталона стоит ТЕКУЩАЯ
// дата (байты 1-3: год-1900, месяц, день), модуль пишет дату из момента-параметра; поэтому сравнение идет после
// маскирования ровно этих трех байт на смещении 1 и больше ничего не маскируется (тест Маска_...). Отступления плана:
//  - байты формируются в памяти собственной записью DBF, без XBase и без временного файла;
//  - имя файла и дата заголовка - из момента-параметра; в имени 24-часовой формат (в эталоне ДФ=yyMMhhmm - 12-часовой).
//  Отступлений по кодам нет: DBF Сенса эталон пишет по смыслу (OKPO_A - организация, OKPO_B - контрагент).
//
// Таблица входа гарнеса обрезает значения длиннее колонки (коды 10, счет 34, МФО 9) молча, поэтому сравнение
// байт-в-байт на таких значениях доказывало бы только обрезание гарнеса; случаи длиннее колонок идут прямым вызовом
// модуля с явным ожиданием (по ширине поля файла), а тесты называются ПрямойВызов_...
//
// Продукт вызывается только через СМП_ТестыВызовПродукта. Данные выдуманные (СМП_ТЕСТ_...), база не читается.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Формат Сенса DBF: байт в байт с эталоном")
			.ДобавитьСерверныйТест("Эталон_БайтВБайтКромеДатыЗаголовка");

КонецПроцедуры

#Область БайтВБайт

Процедура Эталон_БайтВБайтКромеДатыЗаголовка() Экспорт

	СравнитьСЭталоном("Богатый набор", БогатыйНабор());

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Вызов продукта с моментом по умолчанию; исключение продукта уходит наверх.
Функция Сформировать(Поручения, Параметры = Неопределено)

	Если Параметры = Неопределено Тогда
		Параметры = НовыеПараметры();
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.Сформировать", ВМассивИз(Поручения, Параметры));

КонецФункции

Функция НовыеПараметры()

	Параметры = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.НовыеПараметры");
	// Вставить, а не присвоение свойства: на заглушке структура пуста, и тест должен краснеть по смыслу, а не по ошибке.
	Параметры.Вставить("Момент", Дата(2026, 10, 15, 13, 45, 30));
	Возврат Параметры;

КонецФункции

// Сравнение байт в байт с эталоном ПОСЛЕ маски даты заголовка (байты 1-3, больше ничего); при расхождении сообщение
// называет позиции различающихся байтов.
Процедура СравнитьСЭталоном(Описание, Поручения)

	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона("СенсБанк", Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Результат.Данные), СМаскойДаты(Эталон)),
		Описание + ": позиции байтов, которыми файл отличается от эталона (после маски даты)").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(СМаскойДаты(Результат.Данные)), Описание + ": байты").Равно(Base64Строка(СМаскойДаты(Эталон)));

КонецПроцедуры

// Дата последнего обновления в заголовке: РОВНО три байта на смещении 1 обнуляются. Больше ничего не маскируется.
Функция СМаскойДаты(Данные)

	Если Данные.Размер() < 4 Тогда
		Возврат Данные;
	КонецЕсли;
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Для Индекс = 1 По 3 Цикл
		Б[Индекс] = 0;
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Б);

КонецФункции

// Позиции различающихся байтов через запятую (не больше 12); пусто - данные равны; при разном размере - "размер N и M".
Функция ПозицииРазличий(ДанныеА, ДанныеБ)

	Если ДанныеА.Размер() <> ДанныеБ.Размер() Тогда
		Возврат "размер " + ДанныеА.Размер() + " и " + ДанныеБ.Размер();
	КонецЕсли;
	Если ДанныеА.Размер() = 0 Тогда
		Возврат "";
	КонецЕсли;
	А = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеА);
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеБ);
	Позиции = Новый Массив;
	Для Индекс = 0 По А.Размер - 1 Цикл
		Если А[Индекс] <> Б[Индекс] Тогда
			Позиции.Добавить(XMLСтрока(Индекс));
			Если Позиции.Количество() >= 12 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Позиции, ",");

КонецФункции

// Поручение с различимыми значениями сторон; номер и сумма настраиваются. Данные выдуманные.
Функция Поручение(Номер = "000012", Сумма = 1234567.5)

	Поручение = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыгрузкаПлатежей.НовоеПоручение");
	Поручение.Номер = Номер;
	Поручение.Дата = Дата(2026, 10, 5, 13, 45, 0);
	Поручение.Сумма = Сумма;
	Поручение.НазначениеПлатежа = "Оплата за товар " + Номер;

	Плательщик = Поручение.Плательщик;
	Плательщик.Наименование = "СМП_ТЕСТ_Организация";
	Плательщик.Код = "90000001";
	Плательщик.ВидКода = "ЕДРПОУ";
	Плательщик.НомерСчета = "UA159999910000026000000000001";
	Плательщик.IBAN = Плательщик.НомерСчета;
	Плательщик.Банк = "СМП_ТЕСТ_Банк организации";
	Плательщик.МФО = "999991";
	Плательщик.Город = "СМП_ТЕСТ_Город П";

	Получатель = Поручение.Получатель;
	Получатель.Наименование = "СМП_ТЕСТ_Контрагент";
	Получатель.Код = "90000002";
	Получатель.ВидКода = "ЕДРПОУ";
	Получатель.НомерСчета = "UA229999920000026000000000002";
	Получатель.IBAN = Получатель.НомерСчета;
	Получатель.Банк = "СМП_ТЕСТ_Банк контрагента";
	Получатель.МФО = "999992";
	Получатель.Город = "СМП_ТЕСТ_Город Д";

	Возврат Поручение;

КонецФункции

// Два поручения с разными кодами сторон, ведущими нулями, длинными и спецсимвольными полями. Значения в пределах
// колонок таблицы эталона (коды 10, счет 34, МФО 9).
Функция БогатыйНабор()

	Результат = Новый Массив;
	Результат.Добавить(Поручение("12", 1234567.5));

	Второе = Поручение("13", 100);
	Второе.Дата = Дата(2027, 2, 3, 8, 0, 0);
	Второе.Плательщик.Наименование = "ТОВ " + Символ(171) + "Київ" + Символ(187) + " іїєґ " + Символ(39) + " " + Символ(34) + " = Є";
	Второе.Плательщик.Код = "01234567";
	Второе.Плательщик.НомерСчета = "00026007233566";
	Второе.Плательщик.Банк = Повтор("Банк ", 12);
	Второе.Плательщик.МФО = "044525";
	Второе.Получатель.Наименование = Повтор("Контрагент ", 5);
	Второе.Получатель.Код = "0123456789";
	Второе.Получатель.НомерСчета = "UA159999910000026000000000099";
	Второе.Получатель.Банк = "Банк, де = і ґ";
	Второе.Получатель.МФО = "5";
	Второе.НазначениеПлатежа = "Оплата за рахунок " + Символ(8470) + "5 (ПДВ 20%) - " + Символ(171) + "тест" + Символ(187) + Символ(160) + "ґ " + Повтор("довге ", 30);
	Результат.Добавить(Второе);
	Возврат Результат;

КонецФункции

Функция ВМассивИз(Первое, Второе, Третье = Неопределено, Четвертое = Неопределено)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);
	Если Третье <> Неопределено Тогда
		Результат.Добавить(Третье);
	КонецЕсли;
	Если Четвертое <> Неопределено Тогда
		Результат.Добавить(Четвертое);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Повтор(Символы, Количество)

	Части = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Части.Добавить(Символы);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

#КонецОбласти
