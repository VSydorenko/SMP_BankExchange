// Структура заголовка закреплена литералами (спецификация, независимая от эталона).
Процедура Заголовок_СтруктураЛитералами() Экспорт

	Результат = Сформировать(ВМассивИз(Поручение("12", 1234567.5), Поручение("7", 100)));
	Данные = Результат.Данные;

	ЮТест.ОжидаетЧто(Байт(Данные, 0), "Версия (dBASE III без memo)").Равно(3);
	ЮТест.ОжидаетЧто(Байт(Данные, 4) + Байт(Данные, 5) * 256, "Число записей").Равно(2);
	ЮТест.ОжидаетЧто(Байт(Данные, 8) + Байт(Данные, 9) * 256, "Длина заголовка").Равно(577);
	ЮТест.ОжидаетЧто(Байт(Данные, 10) + Байт(Данные, 11) * 256, "Длина записи").Равно(533);
	ЮТест.ОжидаетЧто(Байт(Данные, 29), "Байт 29 - язык (0xC9: русская Windows, 1251)").Равно(201);
	ЮТест.ОжидаетЧто(Байт(Данные, 576), "Завершитель описаний полей").Равно(13);
	ЮТест.ОжидаетЧто(Байт(Данные, Данные.Размер() - 1), "Последний байт файла (маркер конца)").Равно(26);
	ЮТест.ОжидаетЧто(Данные.Размер(), "Размер = заголовок + записи + маркер").Равно(577 + 2 * 533 + 1);
	ЮТест.ОжидаетЧто(Байт(Данные, 577), "Признак первой записи (пробел)").Равно(32);
	ЮТест.ОжидаетЧто(Байт(Данные, 577 + 533), "Признак второй записи (пробел)").Равно(32);

КонецПроцедуры

Процедура Заголовок_ПеречньПолей() Экспорт

	Данные = Сформировать(ВМассив(Поручение())).Данные;
	Поля = Новый Массив;
	Если Данные.Размер() >= 577 Тогда
		Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
		Для Номер = 0 По 16 Цикл
			Смещение = 32 + Номер * 32;
			Имя = "";
			Для Индекс = 0 По 10 Цикл
				Если Б[Смещение + Индекс] <> 0 Тогда
					Имя = Имя + Символ(Б[Смещение + Индекс]);
				КонецЕсли;
			КонецЦикла;
			Поля.Добавить(Имя + ":" + Символ(Б[Смещение + 11]) + ":" + XMLСтрока(Б[Смещение + 16]) + ":" + XMLСтрока(Б[Смещение + 17]));
		КонецЦикла;
	КонецЕсли;

	Ожидаемые = "A:C:38:0,B:C:38:0,ACCOUNT_A:C:19:0,IBAN_A:C:29:0,ACCOUNT_B:C:19:0,IBAN_B:C:29:0,MFO_A:C:9:0,MFO_B:C:9:0,"
		+ "OKPO_A:C:14:0,OKPO_B:C:14:0,BANK_A:C:38:0,BANK_B:C:38:0,CITY_A:C:25:0,CITY_B:C:25:0,AMOUNT:C:18:0,NUMBER:C:10:0,DETAILS:C:160:0";
	ЮТест.ОжидаетЧто(СтрСоединить(Поля, ","), "Имя:тип:длина:дробная по порядку").Равно(Ожидаемые);

КонецПроцедуры

