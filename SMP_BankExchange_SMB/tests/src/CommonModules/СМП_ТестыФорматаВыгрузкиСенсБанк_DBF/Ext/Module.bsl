// Счет длиннее ширины IBAN_* (29), но в пределах колонки гарнеса (34): эталон (XBase) режет по ширине поля, модуль -
// так же, плюс предупреждение с названием поля.
Процедура Счет_ДлиннееШириныIBAN_КакВЭталонеИПредупреждение(Описание, Длина) Экспорт

	Счет = "UA" + Повтор("7", Длина - 2);
	Поручение = Поручение();
	Поручение.Плательщик.НомерСчета = Счет;
	Поручение.Получатель.НомерСчета = Счет;
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);
	Записи = ЗаписиФайла(Результат.Данные);

	ЮТест.ОжидаетЧто(Записи[0]["IBAN_A"], Описание + ": IBAN_A обрезан по ширине поля").Равно(Лев(Счет, 29));
	ЮТест.ОжидаетЧто(ПредупрежденияСтрокой(Результат), Описание + ": предупреждения").Равно("IBAN_A:Обрезано:29,IBAN_B:Обрезано:29");

КонецПроцедуры

// Тесты ПрямойВызов_...: таблица входа эталона режет код до 10, счет до 34, МФО до 9 знаков, поэтому сравнение
// с эталоном на таких значениях доказывало бы только обрезание гарнеса. Ожидание здесь явное: по ширине поля файла
// (OKPO_* 14, MFO_* 9, IBAN_* 29), как обрезает XBase (измерено на 30-34 знаках счета: тест
// Счет_ДлиннееШириныIBAN_КакВЭталонеИПредупреждение), с предупреждением.
Процедура ПрямойВызов_ДлинныйКод_ОбрезаетсяДо14СПредупреждением() Экспорт

	Код = "01234567890123456";
	Поручение = Поручение();
	Поручение.Плательщик.Код = Код;
	Результат = Сформировать(ВМассив(Поручение));
	Записи = ЗаписиФайла(Результат.Данные);

	ЮТест.ОжидаетЧто(Записи[0]["OKPO_A"], "OKPO_A обрезан до 14").Равно(Лев(Код, 14));
	ЮТест.ОжидаетЧто(Записи[0]["OKPO_B"], "OKPO_B не тронут").Равно("90000002");
	ЮТест.ОжидаетЧто(ПредупрежденияСтрокой(Результат), "Предупреждения").Равно("OKPO_A:Обрезано:14");

КонецПроцедуры

Процедура ПрямойВызов_ДлинноеМФО_ОбрезаетсяДо9СПредупреждением() Экспорт

	МФО = "0123456789";
	Поручение = Поручение();
	Поручение.Получатель.МФО = МФО;
	Результат = Сформировать(ВМассив(Поручение));
	Записи = ЗаписиФайла(Результат.Данные);

	ЮТест.ОжидаетЧто(Записи[0]["MFO_B"], "MFO_B обрезан до 9").Равно(Лев(МФО, 9));
	ЮТест.ОжидаетЧто(Записи[0]["MFO_A"], "MFO_A не тронут").Равно("999991");
	ЮТест.ОжидаетЧто(ПредупрежденияСтрокой(Результат), "Предупреждения").Равно("MFO_B:Обрезано:9");

КонецПроцедуры

Процедура ПрямойВызов_ДлинныйСчет_ОбрезаетсяДо29СПредупреждением() Экспорт

	Счет = "UA15999991000002600000000000100000000";
