// Порядок предупреждений - порядок полей в записи файла (A, B, IBAN, MFO, OKPO, BANK, NUMBER, DETAILS); внутри
// DETAILS сначала очистка, потом обрезание (порядок эталона).
Процедура Предупреждения_ПорядокПолейКакВФайле() Экспорт

	Поручение = Поручение();
	Поручение.Номер = "12345678901";
	Поручение.Плательщик.Наименование = Повтор("Ж", 50);
	Поручение.Получатель.Наименование = Повтор("Ж", 50);
	Поручение.Плательщик.Банк = Повтор("Ж", 50);
	Поручение.НазначениеПлатежа = "=" + Повтор("Ж", 170);
	Результат = Сформировать(ВМассив(Поручение));

	ЮТест.ОжидаетЧто(ПредупрежденияСтрокой(Результат), "Порядок").Равно("A:Обрезано:38,B:Обрезано:38,BANK_A:Обрезано:38,NUMBER:Обрезано:10,DETAILS:Очищено:0,DETAILS:Обрезано:160");

КонецПроцедуры

Процедура Предупреждения_ХорошееПоручениеБезПредупреждений() Экспорт

	Результат = Сформировать(БогатыйНабор());
	Хорошее = Сформировать(ВМассив(Поручение()));

	ЮТест.ОжидаетЧто(Хорошее.Предупреждения.Количество(), "Хорошее поручение без предупреждений").Равно(0);
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество() > 0, "В богатом наборе предупреждения есть (проверка не пуста)").ЭтоИстина();

КонецПроцедуры

// Назначение: сначала очистка, потом обрезание до 160: 155 + "=" + 10 = 166 знаков до очистки, 165 после - обрезается
// до 160, и "=" в результате нет (порядок эталона; при обратном порядке в 160 знаков попала бы "=" и вышло бы иначе).
Процедура Назначение_ОчисткаИОбрезаниеВПорядкеЭталона() Экспорт

	Поручение = Поручение();
	Поручение.НазначениеПлатежа = Повтор("Ж", 155) + "=" + Повтор("Ш", 10);
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном("Очистка и обрезание", Поручения);
	Результат = Сформировать(Поручения);
	Записи = ЗаписиФайла(Результат.Данные);

	ЮТест.ОжидаетЧто(Записи[0]["DETAILS"], "DETAILS").Равно(Повтор("Ж", 155) + Повтор("Ш", 5));
	ЮТест.ОжидаетЧто(ПредупрежденияСтрокой(Результат), "Предупреждения").Равно("DETAILS:Очищено:0,DETAILS:Обрезано:160");

КонецПроцедуры

#КонецОбласти

#Область ОчисткаНазначения

Процедура Назначение_ОчисткаКакВiFOBS(Описание, Проверяемый) Экспорт

	Поручение = Поручение();
	Поручение.НазначениеПлатежа = "а" + Проверяемый + "б";
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(ЗаписиФайла(Результат.Данные)[0]["DETAILS"], Описание + ": назначение очищено").Равно("аб");
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": число предупреждений").Равно(1);
	Если Результат.Предупреждения.Количество() = 1 Тогда
		Предупреждение = Результат.Предупреждения[0];
		ЮТест.ОжидаетЧто(Предупреждение.Действие, Описание + ": действие").Равно("Очищено");
		ЮТест.ОжидаетЧто(Предупреждение.Поле, Описание + ": поле").Равно("DETAILS");
		// Называется НАБОР прибранных символов, а не их число (рішення 3).
		ЮТест.ОжидаетЧто(Предупреждение.Символы, Описание + ": набор прибранного").Равно(Проверяемый);
		ЮТест.ОжидаетЧто(Предупреждение.Текст, Описание + ": текст называет символ").Содержит(?(Проверяемый = Символ(160), "U+00A0", Проверяемый));
	КонецЕсли;

КонецПроцедуры

Процедура Назначение_ДопустимыеСимволы_ОстаютсяБезПредупреждения(Описание, Проверяемый) Экспорт

	Поручение = Поручение();
	Поручение.НазначениеПлатежа = "а" + Проверяемый + "б";
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);

	// Пробел в конце значения DBF снимается чтением, поэтому символ стоит внутри строки.
	ЮТест.ОжидаетЧто(ЗаписиФайла(Результат.Данные)[0]["DETAILS"], Описание + ": назначение не тронуто").Равно("а" + Проверяемый + "б");
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": предупреждений нет").Равно(0);

КонецПроцедуры

// ПС, ВК и Таб не входят в допустимый набор и удаляются: запись DBF не сдвигается (533 байта на запись).
// Значение с управляющим символом кладется в новую переменную (пастка YaXUnit: сырой перевод строки в сообщении).
Процедура Назначение_ПереводыСтрокИТабуляция_УдаляютсяЗаписьНеРвется(Описание, Код) Экспорт

	Управляющие = Новый Соответствие;
	Управляющие.Вставить("ПС", Символы.ПС);
	Управляющие.Вставить("ВК", Символы.ВК);
	Управляющие.Вставить("Таб", Символы.Таб);
	Управляющий = Управляющие[Код];
	Поручение = Поручение();
	Поручение.НазначениеПлатежа = "а" + Управляющий + "б";
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(Результат.Данные.Размер(), Описание + ": размер файла").Равно(577 + 533 + 1);
	ЮТест.ОжидаетЧто(ЗаписиФайла(Результат.Данные)[0]["DETAILS"], Описание + ": назначение").Равно("аб");
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": предупреждение об очистке").Равно(1);
	Если Результат.Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Символы = Управляющий, Описание + ": набор прибранного - сам управляющий символ").ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

// Названия сторон и банки не чистятся (как в эталоне): апостроф, кавычки, = и ґ проходят, предупреждения нет.
Процедура Назначение_НазваниеСторонНеЧистится_БезПредупреждений() Экспорт

	Имя = "ТОВ " + Символ(171) + "Київ" + Символ(187) + " ґ " + Символ(39) + " " + Символ(34) + " = Є";
	Поручение = Поручение();
	Поручение.Плательщик.Наименование = Имя;
	Поручение.Получатель.Наименование = Имя;
	Поручение.Плательщик.Банк = Имя;
