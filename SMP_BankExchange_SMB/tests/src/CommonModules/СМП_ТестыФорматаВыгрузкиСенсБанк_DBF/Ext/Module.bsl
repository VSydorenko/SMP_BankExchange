// Контроль: различие вне байтов 1-3 (здесь байт 4) после маски даты остается видимым - маска не шире даты.
// Данные синтетические, от продукта не зависят.
Процедура Маска_РазличиеВнеДатыВидно() Экспорт

	Б = Новый БуферДвоичныхДанных(10);
	Другой = Новый БуферДвоичныхДанных(10);
	Для Индекс = 0 По 9 Цикл
		Б[Индекс] = 50 + Индекс;
		Другой[Индекс] = 50 + Индекс;
	КонецЦикла;
	Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Б);

	Другой[4] = 7;
	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Данные), СМаскойДаты(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Другой))),
		"Различие в байте 4 видно").Равно("4");

	Другой[2] = 7;
	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Данные), СМаскойДаты(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Другой))),
		"Различие в байте 2 (дата) скрыто маской, байт 4 виден").Равно("4");

	Третий = Новый БуферДвоичныхДанных(10);
	Для Индекс = 0 По 9 Цикл
		Третий[Индекс] = 50 + Индекс;
	КонецЦикла;
	Третий[0] = 9;
	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Данные), СМаскойДаты(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Третий))),
		"Различие в байте 0 (версия) маской не скрыто").Равно("0");
	Третий[0] = 50;
	Третий[4] = 9;
	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Данные), СМаскойДаты(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Третий))),
		"Различие в байте 4 не скрыто маской").Равно("4");

КонецПроцедуры

