#Область ОписаниеИИмя

Процедура Описание_ИдентификаторКодировкаРасширение() Экспорт

	Описание = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ОписаниеФормата");

	ЮТест.ОжидаетЧто(Описание.Идентификатор, "Идентификатор").Равно("СМП_ФорматВыгрузкиСенсБанк_DBF");
	ЮТест.ОжидаетЧто(Описание.РасширениеФайла, "Расширение").Равно("dbf");
	ЮТест.ОжидаетЧто(Описание.Кодировка, "Кодировка").Равно("windows-1251");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Описание.Наименование), "Наименование пусто").ЭтоЛожь();

КонецПроцедуры

// Расширение имени пакета - ФорматФайлаВыгрузки() копии обработки в ее регистре (рішення 6): у Сенса это "dbf".
Процедура Описание_РасширениеКакУКопииОбработки() Экспорт

	Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_СенсБанк.Создать");
	Формат = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ОписаниеФормата");

	ЮТест.ОжидаетЧто(Формат.РасширениеФайла, "Расширение").Равно(Обработка.ФорматФайлаВыгрузки());

КонецПроцедуры

Процедура ИмяФайла_ИзМоментаИРасширения(Описание, Момент, Ожидаемое) Экспорт

	Имя = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ПредлагаемоеИмяФайла", ВМассив(Момент));

	ЮТест.ОжидаетЧто(Имя, Описание).Равно(Ожидаемое);

КонецПроцедуры

Процедура ИмяФайла_ЗависитТолькоОтМомента() Экспорт

	Момент = Дата(2026, 10, 15, 13, 45, 30);
	Первое = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ПредлагаемоеИмяФайла", ВМассив(Момент));
	Второе = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ПредлагаемоеИмяФайла", ВМассив(Момент));
	Другое = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.ПредлагаемоеИмяФайла", ВМассив(Момент + 1));

	ЮТест.ОжидаетЧто(Второе, "Тот же момент - то же имя").Равно(Первое);
	ЮТест.ОжидаетЧто(Другое <> Первое, "Другой момент - другое имя").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Первое), "Имя непустое").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область БайтВБайт

Процедура Эталон_БайтВБайтКромеДатыЗаголовка() Экспорт

	СравнитьСЭталоном("Богатый набор", БогатыйНабор());

КонецПроцедуры

Процедура Эталон_ДваПоручения_БайтВБайтКромеДатыЗаголовка() Экспорт

	СравнитьСЭталоном("Два простых поручения", ВМассивИз(Поручение("12", 1234567.5), Поручение("7", 100)));

КонецПроцедуры

// Без поручений эталон все равно пишет заголовок и маркер конца: 577 + 1 = 578 байт, ноль записей (рішення: пакет без
// файла - дело точки выгрузки, на прямом вызове модуля байты как у эталона).
Процедура Эталон_НульПоручений_578БайтКромеДаты() Экспорт

	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона("СенсБанк", Новый Массив);
	Результат = Сформировать(Новый Массив);

	ЮТест.ОжидаетЧто(Эталон.Размер(), "Размер файла эталона").Равно(578);
	ЮТест.ОжидаетЧто(Результат.Данные.Размер(), "Размер файла").Равно(578);
	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Результат.Данные), СМаскойДаты(Эталон)), "Позиции различий после маски даты").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(СМаскойДаты(Результат.Данные)), "Байты после маски даты").Равно(Base64Строка(СМаскойДаты(Эталон)));

КонецПроцедуры

