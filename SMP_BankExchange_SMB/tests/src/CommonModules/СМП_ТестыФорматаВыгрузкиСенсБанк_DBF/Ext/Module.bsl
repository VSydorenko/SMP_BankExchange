#Область Помощники

// Вызов продукта с моментом по умолчанию; исключение продукта уходит наверх.
Функция Сформировать(Поручения, Параметры = Неопределено)

	Если Параметры = Неопределено Тогда
		Параметры = НовыеПараметры();
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.Сформировать", ВМассивИз(Поручения, Параметры));

КонецФункции

// Текст исключения продукта или Неопределено, если исключения не было.
Функция ТекстИсключения(Поручения, Параметры = Неопределено)

	Текст = Неопределено;
	Попытка
		Сформировать(Поручения, Параметры);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Текст;

КонецФункции

Функция НовыеПараметры()

	Параметры = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиСенсБанк_DBF.НовыеПараметры");
	// Вставить, а не присвоение свойства: на заглушке структура пуста, и тест должен краснеть по смыслу, а не по ошибке.
	Параметры.Вставить("Момент", Дата(2026, 10, 15, 13, 45, 30));
	Возврат Параметры;

КонецФункции

// Запись DBF напрямую: Поля - Массив структур (Имя, Тип, Длина), Записи - Массив соответствий.
Функция Записать(Поля, Записи, Кодировка = "windows-1251", Момент = Неопределено)

	Если Момент = Неопределено Тогда
		Момент = Дата(2026, 10, 15, 13, 45, 30);
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ДвоичныеДанныеDBF", ВМассивИз(Поля, Записи, Кодировка, Момент));

КонецФункции

Функция ТекстИсключенияЗаписи(Поля, Записи, Кодировка)

	Текст = Неопределено;
	Попытка
		Записать(Поля, Записи, Кодировка);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Текст;

КонецФункции

Функция НовоеПоле(Имя, Длина)

	Возврат Новый Структура("Имя,Тип,Длина", Имя, "C", Длина);

КонецФункции

// Сравнение байт в байт с эталоном ПОСЛЕ маски даты заголовка (байты 1-3, больше ничего); при расхождении сообщение
// называет позиции различающихся байтов.
Процедура СравнитьСЭталоном(Описание, Поручения)

	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона("СенсБанк", Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(ПозицииРазличий(СМаскойДаты(Результат.Данные), СМаскойДаты(Эталон)),
		Описание + ": позиции байтов, которыми файл отличается от эталона (после маски даты)").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(СМаскойДаты(Результат.Данные)), Описание + ": байты").Равно(Base64Строка(СМаскойДаты(Эталон)));

КонецПроцедуры

// Дата последнего обновления в заголовке: РОВНО три байта на смещении 1 обнуляются. Больше ничего не маскируется.
Функция СМаскойДаты(Данные)

	Если Данные.Размер() < 4 Тогда
		Возврат Данные;
	КонецЕсли;
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Для Индекс = 1 По 3 Цикл
		Б[Индекс] = 0;
	КонецЦикла;
	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Б);

КонецФункции

// Позиции различающихся байтов через запятую (не больше 12); пусто - данные равны; при разном размере - "размер N и M".
Функция ПозицииРазличий(ДанныеА, ДанныеБ)

	Если ДанныеА.Размер() <> ДанныеБ.Размер() Тогда
		Возврат "размер " + ДанныеА.Размер() + " и " + ДанныеБ.Размер();
	КонецЕсли;
	Если ДанныеА.Размер() = 0 Тогда
		Возврат "";
	КонецЕсли;
	А = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеА);
	Б = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеБ);
	Позиции = Новый Массив;
	Для Индекс = 0 По А.Размер - 1 Цикл
		Если А[Индекс] <> Б[Индекс] Тогда
			Позиции.Добавить(XMLСтрока(Индекс));
			Если Позиции.Количество() >= 12 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Позиции, ",");

КонецФункции

// Байт файла по индексу или -1, если файл короче (чтобы тест на заглушке краснел утверждением, а не выходом за границу).
Функция Байт(Данные, Индекс)

	Если Данные.Размер() <= Индекс Тогда
		Возврат -1;
	КонецЕсли;
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные)[Индекс];

КонецФункции

// Записи файла собственным чтением DBF этапа 2 как массив Соответствий "поле - значение"; файл, который не читается,
// дает падающее утверждение и пустые соответствия (до Минимум), а не выход за границу массива.
Функция ЗаписиФайла(Данные, Минимум = 1)

	Записи = Новый Массив;
	Попытка
		Прочитанные = СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ЗаписиDBF", ВМассивИз(Данные, "windows-1251"));
		Для Каждого Прочитанная Из Прочитанные Цикл
			Записи.Добавить(Прочитанная.Поля);
		КонецЦикла;
		Ошибка = "";
	Исключение
		Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЮТест.ОжидаетЧто(Ошибка, "Файл читается собственным чтением DBF").Равно("");
	ЮТест.ОжидаетЧто(Записи.Количество() >= Минимум, "В файле записей не меньше " + Минимум + ", найдено " + Записи.Количество()).ЭтоИстина();
	Пока Записи.Количество() < Минимум Цикл
		Записи.Добавить(Новый Соответствие);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Записи Поручения по полям файла (спецификация, независимая от эталона; в пределах ширин).
Процедура ПроверитьЗапись(З, Поручение, Подпись)

	ЮТест.ОжидаетЧто(З["A"], Подпись + " A").Равно(Поручение.Плательщик.Наименование);
	ЮТест.ОжидаетЧто(З["B"], Подпись + " B").Равно(Поручение.Получатель.Наименование);
	ЮТест.ОжидаетЧто(З["IBAN_A"], Подпись + " IBAN_A").Равно(Поручение.Плательщик.НомерСчета);
	ЮТест.ОжидаетЧто(З["IBAN_B"], Подпись + " IBAN_B").Равно(Поручение.Получатель.НомерСчета);
	ЮТест.ОжидаетЧто(З["MFO_A"], Подпись + " MFO_A").Равно(Поручение.Плательщик.МФО);
	ЮТест.ОжидаетЧто(З["MFO_B"], Подпись + " MFO_B").Равно(Поручение.Получатель.МФО);
	ЮТест.ОжидаетЧто(З["OKPO_A"], Подпись + " OKPO_A").Равно(Поручение.Плательщик.Код);
	ЮТест.ОжидаетЧто(З["OKPO_B"], Подпись + " OKPO_B").Равно(Поручение.Получатель.Код);
	ЮТест.ОжидаетЧто(З["BANK_A"], Подпись + " BANK_A").Равно(Поручение.Плательщик.Банк);
	ЮТест.ОжидаетЧто(З["BANK_B"], Подпись + " BANK_B").Равно(Поручение.Получатель.Банк);
	ЮТест.ОжидаетЧто(З["AMOUNT"], Подпись + " AMOUNT").Равно(Формат(Поручение.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
	ЮТест.ОжидаетЧто(З["NUMBER"], Подпись + " NUMBER").Равно(Поручение.Номер);
	ЮТест.ОжидаетЧто(З["DETAILS"], Подпись + " DETAILS").Равно(Поручение.НазначениеПлатежа);

КонецПроцедуры

// "Поле:Действие:Предел" по порядку предупреждений, через запятую.
Функция ПредупрежденияСтрокой(Результат)

	Части = Новый Массив;
	Для Каждого Предупреждение Из Результат.Предупреждения Цикл
		Части.Добавить(Предупреждение.Поле + ":" + Предупреждение.Действие + ":" + XMLСтрока(Предупреждение.Предел));
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");

КонецФункции

// "Индекс:Поле:Действие" по порядку предупреждений, через запятую.
Функция ПредупрежденияСИндексом(Результат)

	Части = Новый Массив;
	Для Каждого Предупреждение Из Результат.Предупреждения Цикл
		Части.Добавить(XMLСтрока(Предупреждение.ИндексПоручения) + ":" + Предупреждение.Поле + ":" + Предупреждение.Действие);
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");

КонецФункции

