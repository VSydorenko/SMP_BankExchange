// Имена полей в файле могут быть любого регистра (старая обработка обращалась к полям без учета регистра): файл с
// именами ВЕРХНИМ РЕГИСТРОМ (NDOC, DT, ...) читается так же, как обычный, операции совпадают колонка за колонкой.
Процедура Файл_ИменаПолейВерхнимРегистромЧитаютсяКакОбычные() Экспорт

	Записи = Новый Массив;
	ЗаписиВерхние = Новый Массив;
	Для Номер = 1 По 2 Цикл
		Запись = ЗаписьСПодменой(Номер, Новый Структура("ndoc, summa, dk, namecor", "N" + Номер, Формат(Номер * 10 + 0.5, "ЧДЦ=2; ЧРД=.; ЧГ="), ?(Номер = 1, "0", "1"), "Имя " + Номер));
		Записи.Добавить(Запись);
		Верхние = Новый Соответствие;
		Для Каждого Элемент Из Запись Цикл
			Верхние.Вставить(ВРег(Элемент.Ключ), Элемент.Значение);
		КонецЦикла;
		ЗаписиВерхние.Добавить(Верхние);
	КонецЦикла;
	СхемаВерхняя = СхемаПолей(Ложь);
	Для Каждого Поле Из СхемаВерхняя Цикл
		Поле.Имя = ВРег(Поле.Имя);
	КонецЦикла;

	Обычный = Читать(ФайлDBF(Ложь, Записи));
	Верхний = Читать(ФайлDBFПоСхеме(СхемаВерхняя, ЗаписиВерхние, Неопределено));

	ЮТест.ОжидаетЧто(Обычный.Операции.Количество(), "Обычный файл: операции прочитаны").Равно(2);
	ЮТест.ОжидаетЧто(Верхний.Принята, "Файл с именами полей верхним регистром принят").ЭтоИстина();
	ЮТест.ОжидаетЧто(Верхний.Операции.Количество(), "Файл с именами верхним регистром: операции прочитаны").Равно(2);
	ЮТест.ОжидаетЧто(Верхний.Диагностика.Количество(), "Диагностики нет").Равно(0);
	Если Обычный.Операции.Количество() = 2 И Верхний.Операции.Количество() = 2 Тогда
		Для Индекс = 0 По 1 Цикл
			Для Каждого Колонка Из Обычный.Операции.Колонки Цикл
				ЮТест.ОжидаетЧто(Верхний.Операции[Индекс][Колонка.Имя], "Запись " + (Индекс + 1) + ", колонка " + Колонка.Имя + ": верхний регистр = обычный")
					.Равно(Обычный.Операции[Индекс][Колонка.Имя]);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Файл без обязательного поля. Через реестр (строка Ощад_DBF выбрана явно) до чтения дело не доходит: ФайлПохожНаФормат
// такой файл не узнает, пользователь видит отказ «файл не похож» (Принята = Ложь, одна «Ошибка» ко всей выписке, ни
// одна строка реестра файл не узнает). Прямой вызов Прочитать модуля формата (в обход проверки формата) дает ровно одну
// «Ошибку» на файл с названием поля, без исключения и без операций. Две записи: при проверке «на каждую запись» ошибок
// было бы две.
Процедура Файл_БезОбязательногоПоляДаетОшибкуСНазваниемПоля(Описание, ИмяПоля) Экспорт

	Схема = СхемаПолей(Ложь);
	Для Индекс = 0 По Схема.ВГраница() Цикл
		Если Схема[Индекс].Имя = ИмяПоля Тогда
			Схема.Удалить(Индекс);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Записи = Новый Массив;
	Записи.Добавить(ЗаписьСПодменой(1, Новый Структура));
	Записи.Добавить(ЗаписьСПодменой(2, Новый Структура));
	Файл = ФайлDBFПоСхеме(Схема, Записи, Неопределено);

	// 1. Что видит пользователь: явно выбранная строка Ощад_DBF.
	Результат = Читать(Файл);
	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "ФайлПохожНаФормат файл без поля не узнает: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Принята, "Через реестр файл не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Через реестр операций нет: " + Описание).Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Через реестр одно сообщение об ошибке: " + Описание).Равно(1);
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "Ни одна строка реестра файл не узнает: " + Описание).Равно("");

	// 2. Прямой вызов Прочитать модуля формата: «Ошибка» с названием поля.
	Выписка = ПрочитатьМодулемФормата(Файл);
	ЮТест.ОжидаетЧто(Выписка.Операции.Количество(), "Прямо: операций нет: " + Описание).Равно(0);
	ЮТест.ОжидаетЧто(Выписка.ЧтениеПолное, "Прямо: чтение не полное: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Выписка.Диагностика.Количество(), "Прямо: одна запись диагностики на файл (не на каждую запись): " + Описание).Равно(1);
	Если Выписка.Диагностика.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Выписка.Диагностика[0].Уровень, "Прямо: уровень: " + Описание).Равно("Ошибка");
		ЮТест.ОжидаетЧто(Выписка.Диагностика[0].ПорядковыйНомер, "Прямо: ко всей выписке: " + Описание).Равно(0);
		ЮТест.ОжидаетЧто(Выписка.Диагностика[0].Текст, "Прямо: текст называет поле: " + Описание).Содержит(ИмяПоля);
	КонецЕсли;

КонецПроцедуры

// DBF без записей: читать нечего - «Ошибка» ко всей выписке (как пустой файл у других форматов), операций нет.
Процедура Файл_БезЗаписейДаетОшибку() Экспорт

	Результат = Читать(ФайлDBF(Ложь, Новый Массив));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество() > 0, "Есть сообщение об ошибке").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Чтение не полное").ЭтоЛожь();

КонецПроцедуры

// Заголовок верный (формат узнан), а тело оборвано: исключение контейнера наружу не выходит, это «Ошибка».
Процедура Файл_ОбрезанныйПослеЗаголовкаДаетОшибкуБезИсключения() Экспорт

	Полный = ФайлDBF(Ложь, МассивИз(ЗаписьСПодменой(1, Новый Структура)));
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Полный);
	ДлинаЗаголовка = Буфер.ПрочитатьЦелое16(8, ПорядокБайтов.LittleEndian);
	Обрезанный = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.ПолучитьСрез(0, ДлинаЗаголовка + 10));

	Результат = Читать(Обрезанный);

	ЮТест.ОжидаетЧто(Результат.Принята, "Оборванный файл не принят").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет").Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество() > 0, "Есть сообщение об ошибке").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Чтение не полное").ЭтоЛожь();

КонецПроцедуры

// Отступ 5: чтение не создает файлов в каталоге временных файлов (контейнер работает в памяти) и ничего не перемещает.
// Служебные файлы платформы v8_<hex>.tmp не считаются.
Процедура Временные_ЧтениеНеСоздаетФайлов() Экспорт

	До = ВсеВременные();
	Результат16 = ПрочитатьОбразец("DBFОщад16");
	Результат17 = ПрочитатьОбразец("DBFОщад17");
	Синтетика = Читать(ФайлDBF(Истина, МассивИз(ЗаписьСПодменой(1, Новый Структура))));
	Отказ = Читать(ПолучитьДвоичныеДанныеИзСтроки("не DBF", "windows-1251", Ложь));
	После = ВсеВременные();

	ЮТест.ОжидаетЧто(Результат16.Операции.Количество() > 0 И Результат17.Операции.Количество() > 0 И Синтетика.Операции.Количество() = 1,
		"Чтение удалось (проверка не вакуумна)").ЭтоИстина();
	ЮТест.ОжидаетЧто(Отказ.Принята, "Не DBF отвергнут").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Новые(До, После), "Новых временных файлов после чтения нет").Равно("");
	ЮТест.ОжидаетЧто(ВсеВременные(), "Каталог временных файлов прежний").Равно(До);

КонецПроцедуры

// Контроль: сверка каталога временных файлов видит новый файл.
Процедура Временные_СверкаКаталогаУмеетПадать() Экспорт

	До = ВсеВременные();
	Имя = ПолучитьИмяВременногоФайла("txt");
	Запись = Новый ТекстовыйДокумент;
	Запись.УстановитьТекст("x");
	Запись.Записать(Имя);
	Во = ВсеВременные();
	УдалитьФайлы(Имя);
	После = ВсеВременные();

	ЮТест.ОжидаетЧто(Во, "Список видит новый файл").НеРавно(До);
	СозданныйФайл = Новый Файл(Имя);
	ИмяБезКаталога = СозданныйФайл.Имя;
	ЮТест.ОжидаетЧто(Новые(До, Во), "Сверка новых файлов называет созданный файл").Содержит(ИмяБезКаталога);
	ЮТест.ОжидаетЧто(После, "После удаления список прежний").Равно(До);

КонецПроцедуры

#КонецОбласти

#Область ФайлПохожНаФормат

Процедура ФайлПохож_ОбразцыДа(Описание, ИдОбразца) Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыписка" + ИдОбразца)), "Образец узнан: " + Описание).ЭтоИстина();

КонецПроцедуры

Процедура ФайлПохож_ОбразцыДругихФорматовНет(Описание, ИдОбразца) Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыписка" + ИдОбразца)), "Образец другого формата не узнан: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Колизия форматов: образцы Ощада не узнает ни один из ранее сделанных модулей форматов.
Процедура ФайлПохож_ДругиеМодулиФорматовОбразцыОщадаНеУзнают(Описание, Модуль, ИдОбразца) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Ответ = СМП_ТестыВызовПродукта.Вызвать(Модуль + ".ФайлПохожНаФормат", Параметры);

	ЮТест.ОжидаетЧто(Ответ, "Образец Ощада не узнан модулем: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Набор имен полей: 16 полей Ощада или те же с uetr; регистр имен не важен. Режим: «» - как есть, «РЕГИСТР» - имена
// верхним регистром, «-имя» - поле убрано, «+имя» - лишнее поле добавлено, «~имя» - поле переименовано.
Процедура ФайлПохож_НаборПолейШестнадцатьИлиСемнадцатьСUetr(Описание, ЕстьUetr, Режим, Ожидание) Экспорт

	Схема = СхемаПолей(ЕстьUetr);
	Если Режим = "РЕГИСТР" Тогда
		Для Каждого Поле Из Схема Цикл
			Поле.Имя = ВРег(Поле.Имя);
		КонецЦикла;
	ИначеЕсли Лев(Режим, 1) = "-" Тогда
		Для Индекс = 0 По Схема.ВГраница() Цикл
			Если Схема[Индекс].Имя = Сред(Режим, 2) Тогда
				Схема.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Лев(Режим, 1) = "+" Тогда
		Схема.Добавить(Новый Структура("Имя, Тип, Длина, Дес", Сред(Режим, 2), "C", 10, 0));
	ИначеЕсли Лев(Режим, 1) = "~" Тогда
		Для Каждого Поле Из Схема Цикл
			Если Поле.Имя = Сред(Режим, 2) Тогда
				Поле.Имя = "other";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Файл = ФайлDBFПоСхеме(Схема, Новый Массив, Неопределено);

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "ФайлПохожНаФормат: " + Описание).Равно(Ожидание);

КонецПроцедуры

// Проверка дешевая: достаточно заголовка. Файл обрезан сразу после заголовка (тела нет), контейнер такой файл не
// прочел бы, а формат узнан по заголовку.
Процедура ФайлПохож_ТолькоЗаголовокDBF() Экспорт

	Для Каждого ИдОбразца Из СтрРазделить("DBFОщад16,DBFОщад17", ",") Цикл
		Полный = Макет("СМП_ТестВыписка" + ИдОбразца);
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Полный);
		ДлинаЗаголовка = Буфер.ПрочитатьЦелое16(8, ПорядокБайтов.LittleEndian);
		Голова = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.ПолучитьСрез(0, ДлинаЗаголовка));
		ЮТест.ОжидаетЧто(ФайлПохож(Голова), "Только заголовок: файл узнан, " + ИдОбразца).ЭтоИстина();
		ЮТест.ОжидаетЧто(Голова.Размер() < Полный.Размер(), "Контроль: это именно заголовок, а не весь файл, " + ИдОбразца).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура ФайлПохож_НеDBFМусорПустойКороткийИДругаяВерсия(Описание, Вид) Экспорт

	Если Вид = "пусто" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
	ИначеЕсли Вид = "текст" Тогда
		Файл = ПолучитьДвоичныеДанныеИзСтроки("это совсем не выписка, а просто текст достаточной длины для заголовка", "windows-1251", Ложь);
	ИначеЕсли Вид = "короткий" Тогда
		Файл = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Макет("СМП_ТестВыпискаDBFОщад16")).ПолучитьСрез(0, 20));
	Иначе
		Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Макет("СМП_ТестВыпискаDBFОщад16"));
		Буфер[0] = 131;
		Файл = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(Файл), "Не выписка формата: " + Описание).ЭтоЛожь();

КонецПроцедуры

Процедура ФайлПохож_СтрокиРеестраДляФайлаУзнаютТолькоСвою(Описание, ИдОбразца, Ожидание) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Узнанные = Продукт("СтрокиРеестраДляФайла", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Узнанные, ","), "Какие строки реестра узнают файл: " + Описание).Равно(Ожидание);

КонецПроцедуры

// Контроль: проверка формата умеет отвечать Ложь на файл, который она обязана отвергнуть, и Истина - на допустимый.
Процедура ФайлПохож_ПроверкаУмеетПадать() Экспорт

	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаDBFОщад16")), "Допустимый вход: Истина").ЭтоИстина();
	ЮТест.ОжидаетЧто(ФайлПохож(Макет("СМП_ТестВыпискаDBFОТП")), "Недопустимый вход (DBF ОТП): Ложь").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПодсказкиРеестра

// Файл Ощада, прочитанный строкой другого формата, отвергается, а ПохожиеСтрокиРеестра называет строку Ощада.
Процедура ПохожиеСтрокиРеестра_ФайлОщадаЧерезДругуюСтрокуНазываетОщад(Описание, ИдентификаторСтроки) Экспорт

	Эталон = РазобратьЭталон("DBFОщад16");
	Результат = ПрочитатьФайл(ИдентификаторСтроки, Макет("СМП_ТестВыпискаDBFОщад16"), НомераИз(Эталон.НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл другого формата не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "ПохожиеСтрокиРеестра называет строку Ощада: " + Описание).Равно("Ощад_DBF");

КонецПроцедуры

// DBF ОТП и .dat ОТП - не наши форматы (D30): строкой Ощад_DBF они отвергаются; ни одна строка реестра, кроме
// ОТП_DAT для .dat, их не узнает; DBF ОТП - пустой список (ожидание задано явно).
Процедура ПохожиеСтрокиРеестра_ОтклоняемыеФорматыСтрокойОщадаНеНазываютНичего(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз(РазобратьЭталон("DBFОщад16").НомерСчетаЧтения));

	ЮТест.ОжидаетЧто(Результат.Принята, "Отклоняемый формат не принят: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Операций нет: " + Описание).Равно(0);
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество() > 0, "Есть сообщение об ошибке: " + Описание).ЭтоИстина();
	Ожидание = ?(ИдОбразца = "DATОТП1191", "ОТП_DAT", "");
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.ПохожиеСтрокиРеестра, ","), "Какие строки реестра узнают файл: " + Описание).Равно(Ожидание);

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ФорматМодуля()

	Возврат "СМП_ЧитательВыпискиОщадБанк_DBF";

КонецФункции

Функция Продукт(ИмяМетода, Параметры = Неопределено)

	Если СтрНайти(ИмяМетода, ".") = 0 Тогда
		Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧитателиВыписок." + ИмяМетода, Параметры);
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать(ИмяМетода, Параметры);

КонецФункции

Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, Номера)

	Параметры = Новый Массив;
	Параметры.Добавить(ИдентификаторСтроки);
	Параметры.Добавить(Данные);
	Параметры.Добавить(Номера);
	Возврат Продукт("ПрочитатьФайл", Параметры);

КонецФункции

Функция НомераИз(Номер)

	Номера = Новый Массив;
	Номера.Добавить(Номер);
	Возврат Номера;

КонецФункции

Функция МассивИз(Элемент)

	Массив = Новый Массив;
	Массив.Добавить(Элемент);
	Возврат Массив;

КонецФункции

Функция ЗаписьЭталонаДиагностики(Уровень, ПорядковыйНомер, СырьеЗначение)

	Возврат Новый Структура("Уровень, ПорядковыйНомер, Что, СырьеЗначение", Уровень, ПорядковыйНомер, "amount", СырьеЗначение);

КонецФункции

// Читает образец через реестр, номер нашего счета - из эталона.
Функция ПрочитатьОбразец(ИдОбразца)

	Возврат ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыписка" + ИдОбразца), НомераИз(РазобратьЭталон(ИдОбразца).НомерСчетаЧтения));

КонецФункции

Функция Макет(Имя)

	Возврат Обработки.СМП_ТестыМакеты.ПолучитьМакет(Имя);

КонецФункции

Функция ФайлПохож(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	Возврат Продукт(ФорматМодуля() + ".ФайлПохожНаФормат", Параметры);

КонецФункции

Функция ТекстыПоУровню(Результат, Уровень)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Тексты.Добавить(Сообщение.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

Функция ДиагностикаПоУровню(Результат, Уровень)

	Сообщения = Новый Массив;
	Для Каждого Сообщение Из Результат.Диагностика Цикл
		Если Сообщение.Уровень = Уровень Тогда
			Сообщения.Добавить(Новый Структура("ПорядковыйНомер, Текст", Сообщение.ПорядковыйНомер, Сообщение.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения;

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция СтрокаРеестраПоИдентификатору(Идентификатор)

	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Потерянная строка: в Операции ее нет (первая запись прочитана), одна «Ошибка» на запись файла с сырым значением,
// признак невалидных строк, чтение не полное. Плохое значение кладется во вторую запись: первая остается образцом
// прочитанной строки.
Процедура ПроверитьПотерянуюСтроку(Результат, НомерЗаписи, Сырье, Описание)

	ЮТест.ОжидаетЧто(Результат.Принята, "Конверт принят, отброшена одна запись: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Записи в Операции нет, первая прочитана: " + Описание).Равно(1);
	Ошибки = ДиагностикаПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка по записи: " + Описание).Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0].ПорядковыйНомер, "Ошибка привязана к записи файла " + НомерЗаписи + ": " + Описание).Равно(НомерЗаписи);
		Если Не ПустаяСтрока(Сырье) Тогда
			ЮТест.ОжидаетЧто(Ошибки[0].Текст, "Текст ошибки содержит сырое значение: " + Описание).Содержит(Сырье);
		КонецЕсли;
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Признак невалидных строк: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Потеря записи: чтение не полное: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Служебные файлы самой платформы v8_<hex>_d<n>.tmp не считаются: платформа создает их сама и сама убирает при
// завершении сеанса. Файлы продукта считаются.
Функция Новые(До, После)

	Были = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(До, Символы.ПС) Цикл
		Были[Имя] = Истина;
	КонецЦикла;
	Новые = Новый Массив;
	Для Каждого Имя Из СтрРазделить(После, Символы.ПС) Цикл
		Если Были[Имя] = Неопределено И Не СлужебныйФайлПлатформы(Имя) Тогда
			Новые.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Новые, Символы.ПС);

КонецФункции

Функция СлужебныйФайлПлатформы(ПолноеИмя)

	Файл = Новый Файл(ПолноеИмя);
	Возврат Лев(Файл.Имя, 3) = "v8_" И Файл.Расширение = ".tmp";

КонецФункции

// Все элементы каталога временных файлов одной строкой, без служебных файлов платформы.
Функция ВсеВременные()

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из НайтиФайлы(КаталогВременныхФайлов(), "*") Цикл
		Если Не СлужебныйФайлПлатформы(Элемент.ПолноеИмя) Тогда
			Список.Добавить(Элемент.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС);

КонецФункции

#КонецОбласти

#Область Синтетика

// Записи образца контейнером: независимый разбор (имена полей как в файле, значения справа без пробелов).
Функция ЗаписиОбразца(ИдОбразца)

	Параметры = Новый Массив;
	Параметры.Добавить(Макет("СМП_ТестВыписка" + ИдОбразца));
	Параметры.Добавить("windows-1251");
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ЧтениеВыписокОбщее.ЗаписиDBF", Параметры);

КонецФункции

Функция НашСчетСинтетики()

	Возврат "UA" + ПовторитьСтроку("1", 27);

КонецФункции

Функция ПовторитьСтроку(Символ, Количество)

	Части = Новый Массив;
	Для Номер = 1 По Количество Цикл
		Части.Добавить(Символ);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// Схема полей: 16 полей Ощада (ndoc ... val), с uetr - 17. Имена и длины - как в образцах.
Функция СхемаПолей(ЕстьUetr)

	Схема = Новый Массив;
	Для Каждого Описание Из СтрРазделить("ndoc:C:35,dt:D:8,mfocli:C:12,okpocli:C:14,acccli:C:29,namecli:C:140,bankcli:C:60,"
		+ "mfocor:C:12,acccor:C:29,okpocor:C:14,namecor:C:140,bankcor:C:60,dk:N:1,summa:N:20:2,nazn:C:420,val:N:4", ",") Цикл
		Части = СтрРазделить(Описание, ":");
		Схема.Добавить(Новый Структура("Имя, Тип, Длина, Дес", Части[0], Части[1], Число(Части[2]), ?(Части.Количество() > 3, Число(Части[3]), 0)));
	КонецЦикла;
	Если ЕстьUetr Тогда
		Схема.Добавить(Новый Структура("Имя, Тип, Длина, Дес", "uetr", "C", 36, 0));
	КонецЕсли;
	Возврат Схема;

КонецФункции

// Запись файла по умолчанию (значения вымышленные) с подменой полей; Номер - только чтобы значения записей различались.
Функция ЗаписьСПодменой(Номер, Подмена)

	Запись = Новый Соответствие;
	Запись.Вставить("ndoc", "DOC" + Номер);
	Запись.Вставить("dt", "20240301");
	Запись.Вставить("mfocli", "300001");
	Запись.Вставить("okpocli", "11111111");
	Запись.Вставить("acccli", НашСчетСинтетики());
	Запись.Вставить("namecli", "Наш клиент");
	Запись.Вставить("bankcli", "Наш банк");
	Запись.Вставить("mfocor", "300002");
	Запись.Вставить("acccor", "UA" + ПовторитьСтроку("2", 27));
	Запись.Вставить("okpocor", "22222222");
	Запись.Вставить("namecor", "Контрагент");
	Запись.Вставить("bankcor", "Банк контрагента");
	Запись.Вставить("dk", "0");
	Запись.Вставить("summa", "100.50");
	Запись.Вставить("nazn", "оплата по счету");
	Запись.Вставить("val", "980");
	Запись.Вставить("uetr", "00000000-0000-0000-0000-000000000000");
	Для Каждого Элемент Из Подмена Цикл
		Запись.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Запись;

КонецФункции

// Файл DBF из записей по схеме Ощада (с uetr или без). Опции (Структура, необязательно): Год - байт года заголовка,
// Конец26 - писать ли завершающий байт 26 (по умолчанию Истина), Вычеркнутые - массив номеров записей с признаком «*».
Функция ФайлDBF(ЕстьUetr, Записи, Опции = Неопределено)

	Возврат ФайлDBFПоСхеме(СхемаПолей(ЕстьUetr), Записи, Опции);

КонецФункции

Функция ФайлDBFПоСхеме(Схема, Записи, Опции)

	Год = 124;
	Конец26 = Истина;
	Вычеркнутые = Новый Массив;
	Если Опции <> Неопределено Тогда
		Если Опции.Свойство("Год") Тогда
			Год = Опции.Год;
		КонецЕсли;
		Если Опции.Свойство("Конец26") Тогда
			Конец26 = Опции.Конец26;
		КонецЕсли;
		Если Опции.Свойство("Вычеркнутые") Тогда
			Вычеркнутые = Опции.Вычеркнутые;
		КонецЕсли;
	КонецЕсли;

	ДлинаЗаписи = 1;
	Для Каждого Поле Из Схема Цикл
		ДлинаЗаписи = ДлинаЗаписи + Поле.Длина;
	КонецЦикла;
	ДлинаЗаголовка = 33 + 32 * Схема.Количество();
	Размер = ДлинаЗаголовка + Записи.Количество() * ДлинаЗаписи + ?(Конец26, 1, 0);

	Буфер = Новый БуферДвоичныхДанных(Размер);
	Буфер[0] = 3;
	Буфер[1] = Год;
	Буфер[2] = 6;
	Буфер[3] = 24;
	Буфер.ЗаписатьЦелое32(4, Записи.Количество(), ПорядокБайтов.LittleEndian);
	Буфер.ЗаписатьЦелое16(8, ДлинаЗаголовка, ПорядокБайтов.LittleEndian);
	Буфер.ЗаписатьЦелое16(10, ДлинаЗаписи, ПорядокБайтов.LittleEndian);

	Позиция = 32;
	Для Каждого Поле Из Схема Цикл
		Буфер.Записать(Позиция, ПолучитьБуферДвоичныхДанныхИзСтроки(Поле.Имя, "windows-1251", Ложь));
		Буфер[Позиция + 11] = КодСимвола(Поле.Тип);
		Если Поле.Тип = "C" Тогда
			Буфер.ЗаписатьЦелое16(Позиция + 16, Поле.Длина, ПорядокБайтов.LittleEndian);
		Иначе
			Буфер[Позиция + 16] = Поле.Длина;
			Буфер[Позиция + 17] = Поле.Дес;
		КонецЕсли;
		Позиция = Позиция + 32;
	КонецЦикла;
	Буфер[ДлинаЗаголовка - 1] = 13;

	Для Номер = 1 По Записи.Количество() Цикл
		Начало = ДлинаЗаголовка + (Номер - 1) * ДлинаЗаписи;
		Буфер[Начало] = ?(Вычеркнутые.Найти(Номер) <> Неопределено, 42, 32);
		Позиция = Начало + 1;
		Для Каждого Поле Из Схема Цикл
			Значение = Записи[Номер - 1].Получить(Поле.Имя);
			Значение = ?(Значение = Неопределено, "", Значение);
			Добивка = ПовторитьСтроку(" ", Макс(0, Поле.Длина - СтрДлина(Значение)));
			// Числа выровнены вправо, текст и дата - влево, как в файлах банка.
			Текст = Лев(?(Поле.Тип = "N", Добивка + Значение, Значение + Добивка), Поле.Длина);
			Буфер.Записать(Позиция, ПолучитьБуферДвоичныхДанныхИзСтроки(Текст, "windows-1251", Ложь));
			Позиция = Позиция + Поле.Длина;
		КонецЦикла;
	КонецЦикла;
	Если Конец26 Тогда
		Буфер[Размер - 1] = 26;
	КонецЕсли;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

// Прямой вызов Прочитать модуля формата в обход реестра и ФайлПохожНаФормат; возвращает заполненный конверт.
// Исключение: СМП_ТестыВызовПродукта вызывает только функции, а Прочитать - процедура, поэтому здесь Выполнить
// (позднее связывание с продуктом, как там; локальные Данные, Параметры, Выписка видны выполняемой строке).
Функция ПрочитатьМодулемФормата(Данные)

	Выписка = Продукт("СМП_ВыпискаБанка.НоваяВыписка");
	Параметры = Продукт("СМП_ВыпискаБанка.НовыеПараметрыЧтения");
	Параметры.Кодировка = "windows-1251";
	Выполнить("СМП_ЧитательВыпискиОщадБанк_DBF.Прочитать(Данные, Параметры, Выписка)");
	Возврат Выписка;

КонецФункции

// Читает синтетический файл строкой реестра Ощада; нашим считается счет синтетики.
Функция Читать(Данные)

	Возврат ПрочитатьФайл("Ощад_DBF", Данные, НомераИз(НашСчетСинтетики()));

КонецФункции

// Две записи: первая верная, вторая - с подменой полей. Плохое значение во второй записи.
Функция ПотерянаВторая(Подмена)

	Записи = Новый Массив;
	Записи.Добавить(ЗаписьСПодменой(1, Новый Структура));
	Записи.Добавить(ЗаписьСПодменой(2, Подмена));
	Возврат Читать(ФайлDBF(Ложь, Записи));

КонецФункции

#КонецОбласти

#Область Эталон

// Разбор эталона версии 1. Значения экранированы (\\, \t, \n, \r), поля разделены TAB.
Функция РазобратьЭталон(ИдОбразца)

	Документ = Макет("СМП_ТестЭталон" + ИдОбразца);
	Результат = Новый Структура("НомерСчетаЧтения, ЗаписейИсточника, ПропущенныхСтрок, Счета, Операции, Диагностика, ЧужиеСчета",
		"", 0, 0, Новый Массив, Новый Массив, Новый Массив, Новый Массив);

	Раздел = "";
	Шапка = Неопределено;
	Для Номер = 1 По Документ.КоличествоСтрок() Цикл
		Строка = СтрЗаменить(Документ.ПолучитьСтроку(Номер), Символ(65279), "");
		Если Строка = "" Или Лев(Строка, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(Строка, 1) = "[" Тогда
			Раздел = Строка;
			Шапка = Неопределено;
			Продолжить;
		КонецЕсли;

		Если Раздел = "[Образец]" Или Лев(Строка, 17) = "НомерСчетаЧтения=" Тогда
			Позиция = СтрНайти(Строка, "=");
			Ключ = Лев(Строка, Позиция - 1);
			Значение = РазэкранироватьЭталон(Сред(Строка, Позиция + 1));
			Если Ключ = "НомерСчетаЧтения" Тогда
				Результат.НомерСчетаЧтения = Значение;
			ИначеЕсли Ключ = "ЗаписейИсточника" Тогда
				Результат.ЗаписейИсточника = Число(Значение);
			ИначеЕсли Ключ = "ПропущенныхСтрок" Тогда
				Результат.ПропущенныхСтрок = Число(Значение);
			КонецЕсли;
		ИначеЕсли Раздел = "[Счета]" Тогда
			ПоляСчета = СтрРазделить(Строка, Символы.Таб, Истина);
			Результат.Счета.Добавить(Новый Структура("НомерСчета, Количество", РазэкранироватьЭталон(ПоляСчета[0]), Число(ПоляСчета[1])));
		Иначе
			Поля = СтрРазделить(Строка, Символы.Таб, Истина);
			Для Индекс = 0 По Поля.ВГраница() Цикл
				Поля[Индекс] = РазэкранироватьЭталон(Поля[Индекс]);
			КонецЦикла;
			Если Шапка = Неопределено Тогда
				Шапка = Поля;
				Продолжить;
			КонецЕсли;
			Запись = Новый Структура;
			Для Индекс = 0 По Шапка.ВГраница() Цикл
				Запись.Вставить(Шапка[Индекс], ?(Индекс <= Поля.ВГраница(), Поля[Индекс], ""));
			КонецЦикла;
			Если Раздел = "[Операции]" Тогда
				Запись.ПорядковыйНомер = Число(Запись.ПорядковыйНомер);
				Результат.Операции.Добавить(Запись);
			ИначеЕсли Раздел = "[Диагностика]" Тогда
				Результат.Диагностика.Добавить(Запись);
			ИначеЕсли Раздел = "[ЧужиеСчета]" Тогда
				Результат.ЧужиеСчета.Добавить(Запись);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазэкранироватьЭталон(Текст)

	Если СтрНайти(Текст, "\") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "\" И Позиция < Длина Тогда
			Следующий = Сред(Текст, Позиция + 1, 1);
			Если Следующий = "t" Тогда
				Части.Добавить(Символы.Таб);
			ИначеЕсли Следующий = "n" Тогда
				Части.Добавить(Символы.ПС);
			ИначеЕсли Следующий = "r" Тогда
				Части.Добавить(Символы.ВК);
			ИначеЕсли Следующий = "\" Тогда
				Части.Добавить("\");
			Иначе
				Части.Добавить(Символ + Следующий);
			КонецЕсли;
			Позиция = Позиция + 2;
		Иначе
			Части.Добавить(Символ);
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// ГГГГ-ММ-ДДTгг:хх:сс -> Дата.
Функция ДатаЭталона(Текст)

	Возврат Дата(Лев(Текст, 4) + Сред(Текст, 6, 2) + Сред(Текст, 9, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2) + Сред(Текст, 18, 2));

КонецФункции

Функция ТекстДаты(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции

Функция ТекстСуммы(Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=");

КонецФункции

// Сверка конверта с эталоном: период, счета, ЗаписейИсточника, диагностика.
Процедура СверитьКонверт(Описание, Результат, Эталон, ИдОбразца)

	Наименьшая = Неопределено;
	Наибольшая = Неопределено;
	Для Каждого Операция Из Эталон.Операции Цикл
		Момент = ДатаЭталона(Операция.ДатаОперации);
		Наименьшая = ?(Наименьшая = Неопределено, Момент, Мин(Наименьшая, Момент));
		Наибольшая = ?(Наибольшая = Неопределено, Момент, Макс(Наибольшая, Момент));
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Выписка.НачалоПериода, "Образец " + Описание + ": НачалоПериода (начало суток минимальной даты операции эталона)")
		.Равно(НачалоДня(Наименьшая));
	ЮТест.ОжидаетЧто(Результат.Выписка.КонецПериода, "Образец " + Описание + ": КонецПериода (конец суток максимальной даты операции эталона)")
		.Равно(КонецДня(Наибольшая));

	Порядок = Новый Массив;
	Количества = Новый Соответствие;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Количества[Операция.НомерСчета] = Неопределено Тогда
			Количества[Операция.НомерСчета] = 0;
			Порядок.Добавить(Операция.НомерСчета);
		КонецЕсли;
		Количества[Операция.НомерСчета] = Количества[Операция.НомерСчета] + 1;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Порядок.Количество(), "Образец " + Описание + ": число счетов в операциях").Равно(Эталон.Счета.Количество());
	Для Индекс = 0 По Мин(Порядок.Количество(), Эталон.Счета.Количество()) - 1 Цикл
		ЮТест.ОжидаетЧто(Порядок[Индекс], "Образец " + Описание + ": счет №" + (Индекс + 1)).Равно(Эталон.Счета[Индекс].НомерСчета);
		ЮТест.ОжидаетЧто(Количества[Порядок[Индекс]], "Образец " + Описание + ": число операций счета №" + (Индекс + 1))
			.Равно(Эталон.Счета[Индекс].Количество);
	КонецЦикла;
	Если Порядок.Количество() > 0 Тогда
		ЮТест.ОжидаетЧто(Порядок[0], "Образец " + Описание + ": первый счет - НомерСчетаЧтения").Равно(Эталон.НомерСчетаЧтения);
	КонецЕсли;

	Записи = ЗаписиОбразца(ИдОбразца);
	ЮТест.ОжидаетЧто(Записи.Количество(), "Образец " + Описание + ": записей источника (независимый разбор)").Равно(Эталон.ЗаписейИсточника);
	Потеряно = ДиагностикаПоУровню(Результат, "Ошибка").Количество();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() + Потеряно, "Образец " + Описание + ": операции + потерянные строки = ЗаписейИсточника")
		.Равно(Эталон.ЗаписейИсточника - Эталон.ПропущенныхСтрок);

	Расхождения = РасхожденияДиагностики(Результат, Эталон.Диагностика);
	ЮТест.ОжидаетЧто(СтрСоединить(Расхождения, Символы.ПС), "Образец " + Описание + ": диагностика против эталона").Равно("");

КонецПроцедуры

Функция РасхожденияДиагностики(Результат, ЭталонДиагностика)

	Расхождения = Новый Массив;
	Если Результат.Диагностика.Количество() <> ЭталонДиагностика.Количество() Тогда
		Расхождения.Добавить("Число записей диагностики: ожидалось " + ЭталонДиагностика.Количество() + ", получено "
			+ Результат.Диагностика.Количество());
		Возврат Расхождения;
	КонецЕсли;
	Для Индекс = 0 По ЭталонДиагностика.ВГраница() Цикл
		Ожидаемая = ЭталонДиагностика[Индекс];
		Полученная = Результат.Диагностика[Индекс];
		Если Полученная.Уровень <> Ожидаемая.Уровень Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": уровень «" + Полученная.Уровень + "», ожидался «" + Ожидаемая.Уровень + "»");
		КонецЕсли;
		Если Формат(Полученная.ПорядковыйНомер, "ЧГ=") <> Ожидаемая.ПорядковыйНомер Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": порядковый номер " + Полученная.ПорядковыйНомер + ", ожидался " + Ожидаемая.ПорядковыйНомер);
		КонецЕсли;
		Если Не ПустаяСтрока(Ожидаемая.СырьеЗначение) И СтрНайти(Полученная.Текст, Ожидаемая.СырьеЗначение) = 0 Тогда
			Расхождения.Добавить("Запись " + (Индекс + 1) + ": текст не содержит сырое значение «" + Ожидаемая.СырьеЗначение + "»");
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождения;

КонецФункции

// Сверка одной операции с эталоном поле за полем: «образец, строка файла, поле, ожидаемое, полученное».
Процедура СверитьОперацию(Образец, Операция, Ожидаемая)

	Сообщение = "Образец " + Образец + ", запись " + Ожидаемая.ПорядковыйНомер + ", поле ";

	Сверка = Новый Структура;
	Сверка.Вставить("ПорядковыйНомер", Новый Структура("Ожидаемое, Полученное", Формат(Ожидаемая.ПорядковыйНомер, "ЧГ="), Формат(Операция.ПорядковыйНомер, "ЧГ=")));
	Сверка.Вставить("НомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерСчета, Операция.НомерСчета));
	Сверка.Вставить("Валюта", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Валюта, Операция.Валюта));
	Сверка.Вставить("ДатаОперации", Новый Структура("Ожидаемое, Полученное", Ожидаемая.ДатаОперации, ТекстДаты(Операция.ДатаОперации)));
	Сверка.Вставить("НомерДокумента", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НомерДокумента, Операция.НомерДокумента));
	Сверка.Вставить("Сумма", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Сумма, ТекстСуммы(Операция.Сумма)));
	Сверка.Вставить("Направление", Новый Структура("Ожидаемое, Полученное", Ожидаемая.Направление, Операция.Направление));
	Сверка.Вставить("КонтрагентНаименование", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНаименование, Операция.КонтрагентНаименование));
	Сверка.Вставить("КонтрагентНомерСчета", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентНомерСчета, Операция.КонтрагентНомерСчета));
	Сверка.Вставить("КонтрагентКод", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентКод, Операция.КонтрагентКод));
	Сверка.Вставить("КонтрагентМФО", Новый Структура("Ожидаемое, Полученное", Ожидаемая.КонтрагентМФО, Операция.КонтрагентМФО));
	Сверка.Вставить("НазначениеПлатежа", Новый Структура("Ожидаемое, Полученное", Ожидаемая.НазначениеПлатежа, Операция.НазначениеПлатежа));

	Для Каждого Поле Из Сверка Цикл
		ЮТест.ОжидаетЧто(Поле.Значение.Полученное, Сообщение + Поле.Ключ + ": ожидалось «" + Поле.Значение.Ожидаемое + "»")
			.Равно(Поле.Значение.Ожидаемое);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
