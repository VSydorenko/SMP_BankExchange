КонецПроцедуры

Процедура Описание_ПроходитПроверкуКонтракта() Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(Продукт(ФорматМодуля() + ".ОписаниеЧитателя"));
	Ошибки = Продукт("СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя", Параметры);

	ЮТест.ОжидаетЧто(СтрСоединить(Ошибки, Символы.ПС), "Ошибки описания читателя").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбразецПротивЭталона

// Конверт на образце равен эталону поле за полем (сообщение: образец, строка файла, поле, ожидаемое, полученное).
//
// Отступлений от эталона на образцах нет (измерено прототипом до кода): ПС в назначении на образцах нет, dk всегда 0
// или 1. ДатаДокумента: эталон поля не содержит, продукт его не заполняет (решение D17, коммит 1db1c65), тест требует
// пустую ДатаДокумента во всех строках.
//
// Сверяется конверт целиком: период, счета (номер, число операций, порядок), ЗаписейИсточника (независимый разбор
// контейнера), диагностика (пуста на образцах).
Процедура Образец_КонвертРавенЭталону(Описание, ИдОбразца) Экспорт

	Эталон = РазобратьЭталон(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Принята, "Файл принят: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Эталон.Операции.Количество(), "Эталон не пуст: " + Описание).НеРавно(0);
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Число операций: " + Описание).Равно(Эталон.Операции.Количество());
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(),
		"Диагностика пуста (в эталоне " + Эталон.Диагностика.Количество() + ", чужих счетов " + Эталон.ЧужиеСчета.Количество() + "): " + Описание)
		.Равно(Эталон.Диагностика.Количество() + Эталон.ЧужиеСчета.Количество());
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Невалидных строк нет: " + Описание).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Файл прочитан полностью: " + Описание).ЭтоИстина();

	Для Индекс = 0 По Мин(Результат.Операции.Количество(), Эталон.Операции.Количество()) - 1 Цикл
		СверитьОперацию(Описание, Результат.Операции[Индекс], Эталон.Операции[Индекс]);
	КонецЦикла;

	СверитьКонверт(Описание, Результат, Эталон, ИдОбразца);

	СДатой = 0;
	Для Каждого Операция Из Результат.Операции Цикл
		Если Операция.ДатаДокумента <> Дата(1, 1, 1) Тогда
			СДатой = СДатой + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(СДатой, "Образец " + Описание + ": строк с непустой ДатаДокумента (отступление - пуста во всех)").Равно(0);

КонецПроцедуры

Процедура Образец_СырыеДанныеДословно(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);
	Записи = ЗаписиОбразца(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны: " + Описание).ЭтоИстина();
	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.СырыеДанные, "Образец " + Описание + ", запись " + Операция.ПорядковыйНомер + ", поле СырыеДанные: ожидалась запись файла")
			.Равно(Записи[Операция.ПорядковыйНомер - 1].Сырые);
	КонецЦикла;

КонецПроцедуры

// uetr (образец 17 полей, у всех строк разный) в ИдентификаторОперации не кладется: старая обработка его не читала.
Процедура Образец_ИдентификаторОперацииПуст(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);
	Записи = ЗаписиОбразца(ИдОбразца);

	Если ИдОбразца = "DBFОщад17" Тогда
		ЕстьUetr = 0;
		Для Каждого Запись Из Записи Цикл
			Если Не ПустаяСтрока(Запись.Поля["uetr"]) Тогда
				ЕстьUetr = ЕстьUetr + 1;
			КонецЕсли;
		КонецЦикла;
		ЮТест.ОжидаетЧто(ЕстьUetr, "Контроль: в образце uetr заполнен во всех строках").Равно(Записи.Количество());
	КонецЕсли;

	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.ИдентификаторОперации,
			"Идентификатор (uetr) не читается, образец " + Описание + ", строка " + Операция.ПорядковыйНомер).Равно("");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны: " + Описание).ЭтоИстина();

КонецПроцедуры

// Наш счет строки берется из поля файла acccli (одно и то же значение во всех строках образцов), а не из
// Параметры.НомерСчета: поэтому фильтр чужих счетов платформы видит настоящий счет строки.
Процедура Образец_НашСчетСтрокиИзПоляAcccli(Описание, ИдОбразца) Экспорт

	Результат = ПрочитатьОбразец(ИдОбразца);
	Записи = ЗаписиОбразца(ИдОбразца);
	Эталон = РазобратьЭталон(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Число операций: " + Описание).Равно(Записи.Количество());
	Для Индекс = 0 По Мин(Результат.Операции.Количество(), Записи.Количество()) - 1 Цикл
		ЮТест.ОжидаетЧто(Результат.Операции[Индекс].НомерСчета, "Образец " + Описание + ", запись " + (Индекс + 1) + ": НомерСчета из acccli")
			.Равно(СокрЛП(Записи[Индекс].Поля["acccli"]));
		ЮТест.ОжидаетЧто(Результат.Операции[Индекс].НомерСчета, "Образец " + Описание + ", запись " + (Индекс + 1) + ": НомерСчета - НомерСчетаЧтения эталона")
			.Равно(Эталон.НомерСчетаЧтения);
	КонецЦикла;

КонецПроцедуры

Процедура Образец_ЧужойСчетУходитВПредупреждениеПлатформы() Экспорт

	Эталон = РазобратьЭталон("DBFОщад16");
	Результат = ПрочитатьФайл("Ощад_DBF", Макет("СМП_ТестВыпискаDBFОщад16"), НомераИз("UA000000000000000000000000000"));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Все строки файла - чужого счета и отфильтрованы").Равно(0);
	Предупреждения = ТекстыПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о чужом счете").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет счет из файла").Содержит(Эталон.НомерСчетаЧтения);
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет число строк").Содержит(Формат(Эталон.Операции.Количество(), "ЧГ="));
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТекстыПоУровню(Результат, "Ошибка").Количество(), "Ошибок нет: чужой счет не потеря данных").Равно(0);

КонецПроцедуры

// Контроль: на образцах эталонная диагностика пуста, и сверка диагностики там вакуумна. Здесь она выполняется
// на синтетическом файле с нераспознанной суммой против «эталонной» диагностики, верной и испорченной.
Процедура Образец_СверкаДиагностикиУмеетПадать() Экспорт

	Результат = ПотерянаВторая(Новый Структура("summa", "1.2.3"));

	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "2", "1.2.3"))).Количество(),
		"Верная эталонная диагностика: расхождений нет").Равно(0);
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Предупреждение", "2", "1.2.3"))).Количество() > 0,
		"Иной уровень пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "3", "1.2.3"))).Количество() > 0,
		"Иной порядковый номер пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "2", "XYZ"))).Количество() > 0,
		"Иное сырое значение пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, Новый Массив).Количество() > 0,
		"Пустая эталонная диагностика против непустой пойман").ЭтоИстина();

КонецПроцедуры

// Сумма всегда положительна (на образцах), dk - только «0» или «1»: на образцах строк с иным dk нет (0 из 54, измерено
// по обоим образцам), отсюда пустая диагностика в эталоне.
Процедура Образец_СуммыПоложительныеНаправлениеТолькоНольИлиОдин(Описание, ИдОбразца) Экспорт

	Записи = ЗаписиОбразца(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);

	Иное = 0;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Поля["dk"] <> "0" И Запись.Поля["dk"] <> "1" Тогда
			Иное = Иное + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Иное, "Строк образца с dk не «0» и не «1»: " + Описание).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Операции.Количество() > 0, "Операции прочитаны: " + Описание).ЭтоИстина();
	Для Каждого Операция Из Результат.Операции Цикл
		ЮТест.ОжидаетЧто(Операция.Сумма > 0, "Образец " + Описание + ", строка " + Операция.ПорядковыйНомер + ": сумма больше нуля").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПоляКлюча

// Поля составного ключа D17 равны тому, что давала старая обработка: НомерДокумента = СокрЛП(ndoc), КонтрагентНомерСчета =
// СокрЛП(acccor) (в обе стороны направления), Сумма = summa, день ДатаДокумента старой = dt = день ДатаОперации
// (ДатаДокумента пуста). Ожидание считается из сырых полей контейнера, а не продуктом.
Процедура Ключ_ПоляКакВСтаройОбработкеНаОбразце(Описание, ИдОбразца) Экспорт

	Записи = ЗаписиОбразца(ИдОбразца);
	Результат = ПрочитатьОбразец(ИдОбразца);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Число операций: " + Описание).Равно(Записи.Количество());
	Для Индекс = 0 По Мин(Результат.Операции.Количество(), Записи.Количество()) - 1 Цикл
		Поля = Записи[Индекс].Поля;
		Операция = Результат.Операции[Индекс];
		Сообщение = "Образец " + Описание + ", запись " + (Индекс + 1) + ", поле ";
		ЮТест.ОжидаетЧто(Операция.НомерДокумента, Сообщение + "НомерДокумента (СокрЛП ndoc)").Равно(СокрЛП(Поля["ndoc"]));
		ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, Сообщение + "КонтрагентНомерСчета (СокрЛП acccor)").Равно(СокрЛП(Поля["acccor"]));
		ЮТест.ОжидаетЧто(Операция.Сумма, Сообщение + "Сумма (summa)").Равно(Число(СокрЛП(Поля["summa"])));
		ЮТест.ОжидаетЧто(Формат(Операция.ДатаОперации, "ДФ=yyyyMMdd"), Сообщение + "ДатаОперации (dt)").Равно(СокрЛП(Поля["dt"]));
		ЮТест.ОжидаетЧто(Операция.ДатаДокумента, Сообщение + "ДатаДокумента (пуста, день операции)").Равно(Дата(1, 1, 1));
	КонецЦикла;

КонецПроцедуры

// Ведущие и замыкающие пробелы снимаются (СокрЛП), ведущие нули сохраняются: Формат(Строка, "ЧГ=0") строку не меняет
// (измерено в 1С), число из строки никто не делает.
Процедура Ключ_ПробелыПоКраямСнимаютсяВедущиеНулиСохраняются() Экспорт

	Результат = Читать(ФайлDBF(Ложь, МассивИз(ЗаписьСПодменой(1,
		Новый Структура("ndoc, acccor, okpocor, mfocor", "   007  ", "  0026001123456  ", " 00112233 ", " 0300002")))));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		Операция = Результат.Операции[0];
		ЮТест.ОжидаетЧто(Операция.НомерДокумента, "НомерДокумента: ведущие нули, пробелы сняты").Равно("007");
		ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, "КонтрагентНомерСчета: ведущие нули, пробелы сняты").Равно("0026001123456");
		ЮТест.ОжидаетЧто(Операция.КонтрагентКод, "КонтрагентКод: ведущие нули, пробелы сняты").Равно("00112233");
		ЮТест.ОжидаетЧто(Операция.КонтрагентМФО, "КонтрагентМФО: ведущий нуль, пробел снят").Равно("0300002");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОтображениеПолей

// Каждое свойство операции берется из своего поля файла, независимо от направления: наш счет - acccli, контрагент -
// поля ...cor. У каждого поля свое значение-маркер; поля, которые старая обработка не читает (...cli кроме acccli,
// bankcor), в операцию не попадают.
Процедура Поля_КаждоеПолеИзСвоегоИсточника(Описание, Флаг, ОжидаемоеНаправление) Экспорт

	Поля = Новый Структура;
	Поля.Вставить("dk", Флаг);
	Поля.Вставить("ndoc", "NDOC-M");
	Поля.Вставить("acccli", "ACC-OWN");
	Поля.Вставить("acccor", "ACC-COR");
	Поля.Вставить("okpocor", "KOD-COR");
	Поля.Вставить("mfocor", "MFO-COR");
	Поля.Вставить("namecor", "NAME-COR");
	Поля.Вставить("nazn", "PURPOSE-M");
	Поля.Вставить("mfocli", "MFO-OWN");
	Поля.Вставить("okpocli", "KOD-OWN");
	Поля.Вставить("namecli", "NAME-OWN");
	Поля.Вставить("bankcli", "BANK-OWN");
	Поля.Вставить("bankcor", "BANK-COR");
	Результат = ПрочитатьФайл("Ощад_DBF", ФайлDBF(Ложь, МассивИз(ЗаписьСПодменой(1, Поля))), НомераИз("ACC-OWN"));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана: " + Описание).Равно(1);
	Если Результат.Операции.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	Операция = Результат.Операции[0];
	ЮТест.ОжидаетЧто(Операция.Направление, "Направление: " + Описание).Равно(ОжидаемоеНаправление);
	ЮТест.ОжидаетЧто(Операция.НомерСчета, "НомерСчета - acccli: " + Описание).Равно("ACC-OWN");
	ЮТест.ОжидаетЧто(Операция.НомерДокумента, "НомерДокумента - ndoc: " + Описание).Равно("NDOC-M");
	ЮТест.ОжидаетЧто(Операция.КонтрагентНомерСчета, "КонтрагентНомерСчета - acccor: " + Описание).Равно("ACC-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентКод, "КонтрагентКод - okpocor: " + Описание).Равно("KOD-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентМФО, "КонтрагентМФО - mfocor: " + Описание).Равно("MFO-COR");
	ЮТест.ОжидаетЧто(Операция.КонтрагентНаименование, "КонтрагентНаименование - namecor: " + Описание).Равно("NAME-COR");
	ЮТест.ОжидаетЧто(Операция.НазначениеПлатежа, "НазначениеПлатежа - nazn: " + Описание).Равно("PURPOSE-M");

	Прочитанное = Новый Массив;
	Для Каждого Колонка Из Результат.Операции.Колонки Цикл
		Значение = Операция[Колонка.Имя];
		// СырыеДанные - запись файла целиком, там по определению все поля, в том числе не читаемые.
		Если ТипЗнч(Значение) = Тип("Строка") И Колонка.Имя <> "СырыеДанные" Тогда
			Прочитанное.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Прочитанное = СтрСоединить(Прочитанное, "|");
	Для Каждого Маркер Из СтрРазделить("MFO-OWN,KOD-OWN,NAME-OWN,BANK-OWN,BANK-COR", ",") Цикл
		ЮТест.ОжидаетЧто(СтрНайти(Прочитанное, Маркер), "Поле, которое старая обработка не читает, в операцию не попало: " + Маркер + ", " + Описание).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Те же значения полей в файле на 16 и на 17 полей (с uetr) дают одну и ту же операцию.
Процедура Поля_ОбаНабораПолейЧитаютсяОдинаково() Экспорт

	Запись = ЗаписьСПодменой(1, Новый Структура("uetr", "11111111-2222-3333-4444-555555555555"));
	Результат16 = Читать(ФайлDBF(Ложь, МассивИз(Запись)));
	Результат17 = Читать(ФайлDBF(Истина, МассивИз(Запись)));

	ЮТест.ОжидаетЧто(Результат16.Операции.Количество(), "16 полей: строка прочитана").Равно(1);
	ЮТест.ОжидаетЧто(Результат17.Операции.Количество(), "17 полей: строка прочитана").Равно(1);
	Если Результат16.Операции.Количество() = 1 И Результат17.Операции.Количество() = 1 Тогда
		Для Каждого Колонка Из Результат16.Операции.Колонки Цикл
			// СырыеДанные - запись файла как есть: у файла с uetr она длиннее.
			Если Колонка.Имя = "СырыеДанные" Тогда
				Продолжить;
			КонецЕсли;
			ЮТест.ОжидаетЧто(Результат17.Операции[0][Колонка.Имя], "Колонка " + Колонка.Имя + ": 17 полей = 16 полей").Равно(Результат16.Операции[0][Колонка.Имя]);
		КонецЦикла;
		ЮТест.ОжидаетЧто(Результат17.Операции[0].ИдентификаторОперации, "uetr не читается").Равно("");
	КонецЕсли;

КонецПроцедуры

// NUL внутри поля контейнер читает как апостроф (отступ 2, как в CSV); сквозная проверка. Значение кладется в новую
// переменную: NUL в тексте утверждения ломает отчет YaXUnit.
