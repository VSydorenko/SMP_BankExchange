#Область Реестр

Процедура Реестр_СтрокаОщад() Экспорт

	Найдено = 0;
	Для Каждого СтрокаРеестра Из Продукт("РеестрЧитателей") Цикл
		Если СтрокаРеестра.Формат <> ФорматМодуля() Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		ЮТест.ОжидаетЧто(СтрокаРеестра.Идентификатор, "Идентификатор строки").Равно("Ощад_DBF");
		ЮТест.ОжидаетЧто(СтрокаРеестра.ИмяСтаройОбработки, "Имя старой обработки").Равно("СМП_ОбработкаВыпискиБанка_ОщадБанк");
		ЮТест.ОжидаетЧто(СтрСоединить(СтрокаРеестра.РасширенияФайлов, ","), "Расширения файлов").Равно("dbf");
		ЮТест.ОжидаетЧто(СтрокаРеестра.Представление, "Представление").Равно(СтрокаРеестра.Банк + " — " + СтрокаРеестра.ТипФайла);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найдено, "Строк реестра формата Ощад DBF").Равно(1);

КонецПроцедуры

// Правило КодыБанка: МФО из IBAN собственного счета образцов (позиции 5-10), только измеренные. МФО в двух образцах
// разные (измерено), справочник НБУ не подключался, код Ощадбанка из памяти не добавлен.
Процедура Реестр_КодыБанкаТолькоМФОИзСчетовОбразцов() Экспорт

	Ожидаемые = Новый Массив;
	Ожидаемые.Добавить(Сред(РазобратьЭталон("DBFОщад16").НомерСчетаЧтения, 5, 6));
	Ожидаемые.Добавить(Сред(РазобратьЭталон("DBFОщад17").НомерСчетаЧтения, 5, 6));
	СтрокаРеестра = СтрокаРеестраПоИдентификатору("Ощад_DBF");

	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
	Если СтрокаРеестра = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЮТест.ОжидаетЧто(ТипЗнч(СтрокаРеестра.КодыБанка) = Тип("Массив"), "КодыБанка - массив").ЭтоИстина();
	ЮТест.ОжидаетЧто(Ожидаемые[0] <> Ожидаемые[1], "МФО в счетах двух образцов различаются").ЭтоИстина();
	Для Каждого МФО Из Ожидаемые Цикл
		ЮТест.ОжидаетЧто(СтрокаРеестра.КодыБанка.Найти(МФО) <> Неопределено, "КодыБанка содержат МФО из IBAN образца " + МФО).ЭтоИстина();
	КонецЦикла;
	ЮТест.ОжидаетЧто(СтрокаРеестра.КодыБанка.Количество(), "Других кодов, кроме измеренных, нет").Равно(2);
	Виденные = Новый Соответствие;
	Для Каждого Код Из СтрокаРеестра.КодыБанка Цикл
		ЮТест.ОжидаетЧто(СтрДлина(Код) = 6 И ТолькоЦифры(Код), "Код банка - шесть цифр").ЭтоИстина();
		ЮТест.ОжидаетЧто(Виденные[Код] = Неопределено, "Код банка не повторяется").ЭтоИстина();
		Виденные[Код] = Истина;
	КонецЦикла;

КонецПроцедуры

Процедура Реестр_ВариантаНет() Экспорт

	СтрокаРеестра = СтрокаРеестраПоИдентификатору("Ощад_DBF");
	ЮТест.ОжидаетЧто(СтрокаРеестра <> Неопределено, "Строка реестра есть").ЭтоИстина();
