		ЮТест.ОжидаетЧто(Результат.Операции[0].НомерДокумента, "Номер: позиции 133-142, позиция 143 не читается").Равно("ABCDEFGHIJ");
	КонецЕсли;

КонецПроцедуры

// Сумма: начало поля - позиция 117 (позиция 116 не читается), значение 117 = «1» и 14 нулей.
Процедура Позиции_СуммаНачалоПоля() Экспорт

	Строки = ЛинииОбразца();
	Линия = ЗаменитьПоле(Строки[0], 116, "9");
