// Узнавание по первой строке: длина ровно 1191; флаг (115) - «0» или «1»; позиции 1186-1191 - шесть цифр.
// Длина 0 в параметрах означает «длину не менять» (подмена поля в строке нормальной длины).
Процедура ФайлПохож_ПервыйРядокПоДлинеФлагуИДате(Описание, Длина, Позиция, Подмена, Ожидание) Экспорт

	Линия = ЛинииОбразца()[0];
	Если Позиция > 0 Тогда
		Линия = ЗаменитьПоле(Линия, Позиция, Подмена);
	КонецЕсли;
	Если Длина < 1191 Тогда
		Линия = Лев(Линия, Длина);
	ИначеЕсли Длина > 1191 Тогда
		Линия = Линия + ПовторитьСтроку(" ", Длина - 1191);
	КонецЕсли;

	ЮТест.ОжидаетЧто(ФайлПохож(ФайлИзТекстовыхСтрок(МассивИз(Линия))), "ФайлПохожНаФормат: " + Описание).Равно(Ожидание);

КонецПроцедуры

// Проверка дешевая: смотрит только начало файла. Первая строка верная, остальное - не 1191-е строки.
