	КонецЕсли;

КонецПроцедуры

// Флаг направления - позиция 115; соседи 114 и 116 несут противоположное значение и читаться не должны.
Процедура Позиции_ФлагНаправленияРовноВОднойПозиции(Описание, Флаг, Ожидаемое) Экспорт

	Противоположный = ?(Флаг = "0", "1", "0");
	Строки = ЛинииОбразца();
