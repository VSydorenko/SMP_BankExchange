	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].Направление, "Направление: " + Описание).Равно(Ожидаемое);
	КонецЕсли;

КонецПроцедуры

// Известная особенность: к номеру документа приклеен вид документа (первый символ с позиции 133). Составной
// ключ D17 берет номер как есть, поэтому префикс воспроизводится.
Процедура Известное_ПрефиксВидаДокументаВНомереКакВСтаройОбработке() Экспорт

	Строки = ЛинииОбразца();
	Линия = ЗаменитьПоле(Строки[0], 132, " 7" + "12345" + "    ");
	Строки[0] = Линия;

	Результат = ПрочитатьСинтетику(Строки);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана").Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0].НомерДокумента, "Вид документа «7» + номер «12345»").Равно("712345");
	КонецЕсли;

	Эталон = РазобратьЭталон("DATОТП1191");
	Образец = ПрочитатьОбразец("DATОТП1191");
	Совпало = 0;
	Для Индекс = 0 По Мин(Образец.Операции.Количество(), Эталон.Операции.Количество()) - 1 Цикл
		Если Образец.Операции[Индекс].НомерДокумента = Эталон.Операции[Индекс].НомерДокумента Тогда
			Совпало = Совпало + 1;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Совпало, "Номера образца с префиксом вида документа, как в эталоне").Равно(Эталон.Операции.Количество());

КонецПроцедуры

// Известная особенность: наименование платника читается с позиции 185 (поле начинается на 184), первая буква
// теряется. Не поле ключа. Позиция 184 не читается.
