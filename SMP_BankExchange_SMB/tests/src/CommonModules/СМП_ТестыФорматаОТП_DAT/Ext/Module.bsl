// Решение: строка короче 1191 символа - «Ошибка» с номером строки файла, остальные строки читаются.
Процедура Строка_КороченеЧем1191ДаетОшибкуСНомеромСтроки(Описание, Длина) Экспорт

	Строки = ЛинииОбразца();
	Строки.Вставить(1, Лев(Строки[1], Длина));
	// Строки: 0 - полная, 1 - короткая (строка файла 2), 2.. - остальные полные
	Результат = ПрочитатьСинтетику(Строки);

	ЮТест.ОжидаетЧто(Результат.Принята, "Конверт принят, отброшена одна строка: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Короткая строка не стала данными: " + Описание).Равно(Строки.Количество() - 1);
	Ошибки = ДиагностикаПоУровню(Результат, "Ошибка");
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Одна ошибка по короткой строке: " + Описание).Равно(1);
	Если Ошибки.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Ошибки[0].ПорядковыйНомер, "Ошибка привязана к строке файла 2: " + Описание).Равно(2);
		ЮТест.ОжидаетЧто(Ошибки[0].Текст, "Текст называет длину строки: " + Описание).Содержит(Формат(Длина, "ЧГ="));
	КонецЕсли;
	ЮТест.ОжидаетЧто(Результат.ЕстьНевалидныеСтроки, "Признак невалидных строк: " + Описание).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Выписка.ЧтениеПолное, "Потеря строки: чтение не полное: " + Описание).ЭтоЛожь();

КонецПроцедуры

// Решение планувальника: строка длиннее 1191 читается теми же позициями, без ошибки (позиции 1-1191 те же).
