// Тесты формата «ОТП Банк, текст фиксированной ширины (.dat), поколение 1191» (план 03, задача 8):
// СМП_ЧитательВыпискиОТП_DAT и строка реестра ОТП_DAT.
//
// Образец - макет обработки СМП_ТестыМакеты (знеособленный файл), эталон - макет СМП_ТестЭталон<Ид>
// (формат версии 1, tools/statement-samples/README.md). Эталон посчитан оракулом на Python из
// знеособленного файла (эмуляция старой обработки), а не этим кодом. Реальных данных в тестах нет.
//
// Продукт вызывается только через СМП_ТестыВызовПродукта. Без данных в базе: транзакция не нужна.
//
// Позиции полей - как в старой обработке (Сред, с единицы):
//   номер документа (132, 11)   дата ррммдд (1186, 6)   сумма в копейках (117, 16)   флаг направления (115, 1)
//   платник: счет (29, 29) МФО (1, 10) код (976, 14) наименование (185, 138)
//   получатель: счет (86, 29) МФО (58, 9) код (1005, 14) наименование (324, 138)
//   назначение (464, 500)
//
// Решения, на которых стоят тесты (названы, чтобы их легко переписать, если планувальник решит иначе):
//  - известная особенность: номер документа берется с позиции 132 (а не 134): к нему приклеен вид документа
//    (первый символ). Составной ключ D17 берет номер как есть, поэтому префикс воспроизводится;
//  - известная особенность: наименование платника на один символ сдвинуто (позиция 185 вместо 184), первая
//    буква теряется; не поле ключа;
//  - известная особенность: поля номера документа (132, 11) и суммы (117, 16) перекрываются на позиции 132;
//  - направление строго: «1» - поступило (наш счет - получатель), «0» - списано (наш счет - плательщик),
//    любое другое значение - «Ошибка» с сырым значением (старая обработка: «1» поступило, остальное списано);
//  - валюта пуста (старая обработка ее не читает), времени в файле нет (00:00:00), остатков нет,
//    ДатаДокумента не заполняется (день операции, D17), идентификатор банка не читается;
//  - строка короче 1191 - «Ошибка» с номером строки; строка длиннее 1191 читается теми же позициями (без ошибки).
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("ОТП DAT: реестр и описание")
			.ДобавитьСерверныйТест("Реестр_СтрокаОТП")
			.ДобавитьСерверныйТест("Реестр_КодыБанкаВключаютМФОИзIBANСчетаОбразца")
			.ДобавитьСерверныйТест("Реестр_ВариантаНет")
			.ДобавитьСерверныйТест("Описание_КодировкаИдентификаторыОстатки")
			.ДобавитьСерверныйТест("Описание_ПроходитПроверкуКонтракта")
		.ДобавитьТестовыйНабор("ОТП DAT: образец против эталона")
			.ДобавитьСерверныйТест("Образец_КонвертРавенЭталону")
			.ДобавитьСерверныйТест("Образец_СырыеДанныеДословно")
			.ДобавитьСерверныйТест("Образец_ИдентификаторОперацииПуст")
			.ДобавитьСерверныйТест("Образец_ВалютаПустаВремяНулевое")
			.ДобавитьСерверныйТест("Образец_НашСчетСтрокиИзПолейФайла")
			.ДобавитьСерверныйТест("Образец_СверкаДиагностикиУмеетПадать")
		.ДобавитьТестовыйНабор("ОТП DAT: позиции полей (каждая граница)")
			.ДобавитьСерверныйТест("Позиции_ТекстовоеПолеЧитаетсяРовноВСвоихГраницах")
				.СПараметрами("наш счет при списании", "0", 29, 29, "НомерСчета")
				.СПараметрами("счет контрагента при списании", "0", 86, 29, "КонтрагентНомерСчета")
				.СПараметрами("МФО контрагента при списании", "0", 58, 9, "КонтрагентМФО")
				.СПараметрами("код контрагента при списании", "0", 1005, 14, "КонтрагентКод")
				.СПараметрами("наименование контрагента при списании", "0", 324, 138, "КонтрагентНаименование")
				.СПараметрами("наш счет при поступлении", "1", 86, 29, "НомерСчета")
