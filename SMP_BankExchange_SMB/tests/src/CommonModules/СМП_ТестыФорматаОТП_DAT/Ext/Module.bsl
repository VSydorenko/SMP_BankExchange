// Известная особенность: НомерСчета операции берется из полей файла (по направлению), а не из Параметры.НомерСчета.
// Поэтому фильтр чужих счетов платформы видит настоящий счет строки.
Процедура Образец_НашСчетСтрокиИзПолейФайла() Экспорт

	Эталон = РазобратьЭталон("DATОТП1191");
	Результат = ПрочитатьФайл("ОТП_DAT", Макет("СМП_ТестВыпискаDATОТП1191"), НомераИз("UA000000000000000000000000000"));

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Все строки файла - чужого счета и отфильтрованы").Равно(0);
	Предупреждения = ТекстыПоУровню(Результат, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Одно предупреждение о чужом счете").Равно(1);
	Если Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет счет из файла").Содержит(Эталон.НомерСчетаЧтения);
		ЮТест.ОжидаетЧто(Предупреждения[0], "Предупреждение называет число строк").Содержит(Формат(Эталон.Операции.Количество(), "ЧГ="));
	КонецЕсли;

КонецПроцедуры

// Контроль: на образце эталонная диагностика пуста, и сверка диагностики там вакуумна. Здесь она выполняется
// на синтетическом файле с нераспознанной суммой против «эталонной» диагностики, верной и испорченной.
Процедура Образец_СверкаДиагностикиУмеетПадать() Экспорт

	Строки = ЛинииОбразца();
	Строки[0] = ЗаменитьПоле(Строки[0], 117, "00000000000ABC00");
	Результат = ПрочитатьСинтетику(Строки);

	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "1", "ABC"))).Количество(),
		"Верная эталонная диагностика: расхождений нет").Равно(0);
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Предупреждение", "1", "ABC"))).Количество() > 0,
		"Иной уровень пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "2", "ABC"))).Количество() > 0,
		"Иной порядковый номер пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, МассивИз(ЗаписьЭталонаДиагностики("Ошибка", "1", "XYZ"))).Количество() > 0,
		"Иное сырое значение пойман").ЭтоИстина();
	ЮТест.ОжидаетЧто(РасхожденияДиагностики(Результат, Новый Массив).Количество() > 0,
		"Пустая эталонная диагностика против непустой пойман").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПозицииПолей

// Поле читается ровно в своих границах: значение «A»*длина внутри, сторожевой «#» по обе стороны (позиция до поля и
// позиция после него). Если граница сдвинута, в результат попадет «#» или потеряется «A».
// Эталонная сторона (флаг) задает, какое из двух полей (плательщик или получатель) наше.
Процедура Позиции_ТекстовоеПолеЧитаетсяРовноВСвоихГраницах(Описание, Флаг, Позиция, Длина, Свойство) Экспорт

	Строки = ЛинииОбразца();
	Линия = ЗаменитьПоле(Строки[0], 115, Флаг);
	Значение = ПовторитьСтроку("A", Длина);
	Линия = ЗаменитьПоле(Линия, Позиция, Значение);
	Если Позиция > 1 Тогда
		Линия = ЗаменитьПоле(Линия, Позиция - 1, "#");
	КонецЕсли;
	Линия = ЗаменитьПоле(Линия, Позиция + Длина, "#");
	// Позиция 115 - флаг, он стоит сразу за счетом получателя (86, 29): после подстановки соседей возвращается.
	Линия = ЗаменитьПоле(Линия, 115, Флаг);
	Строки[0] = Линия;

	Результат = ПрочитатьСинтетику(Строки);

	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Строка прочитана: " + Описание).Равно(1);
	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[0][Свойство], "Поле " + Свойство + " (" + Позиция + ", " + Длина + "): " + Описание).Равно(Значение);
	КонецЕсли;

КонецПроцедуры

// Номер документа (132, 11): позиции 133...142 читаются, 143 - нет. Позиция 132 перекрыта суммой (117, 16) и
// не используется (известная особенность); начало границы 131 проверяется суммой (см. Позиции_СуммаКонецПоля).
