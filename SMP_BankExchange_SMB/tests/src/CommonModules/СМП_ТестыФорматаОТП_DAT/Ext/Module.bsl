	Если Результат.Операции.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Лев(Результат.Операции[0].КонтрагентНаименование, 2), "Первая буква поля (позиция 184) потеряна").Равно("YZ");
	КонецЕсли;

КонецПроцедуры

// Известная особенность: позиция 132 входит и в число суммы (117, 16), и в номер документа (132, 11).
