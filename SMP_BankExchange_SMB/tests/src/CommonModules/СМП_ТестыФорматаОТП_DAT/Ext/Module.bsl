		ЮТест.ОжидаетЧто(Результат.Операции[0].Сумма, "Сумма: позиция 132 входит в поле").Равно(0.05);
	КонецЕсли;

КонецПроцедуры

// Дата ррммдд (1186, 6): позиция 1185 не читается (там «9»), 1191 читается.
