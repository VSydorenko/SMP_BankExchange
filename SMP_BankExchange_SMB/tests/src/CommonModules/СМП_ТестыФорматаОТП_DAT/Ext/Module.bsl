	ЮТест.ОжидаетЧто(Результат.Операции.Количество(), "Обе строки прочитаны").Равно(Строки.Количество());
	ЮТест.ОжидаетЧто(Результат.Диагностика.Количество(), "Диагностики нет").Равно(0);
	Если Результат.Операции.Количество() > 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Операции[1].НомерДокумента, "Строка длиннее 1191 читается как обычная").Равно(Эталон.Операции[1].НомерДокумента);
		ЮТест.ОжидаетЧто(ТекстСуммы(Результат.Операции[1].Сумма), "Сумма строки длиннее 1191").Равно(Эталон.Операции[1].Сумма);
	КонецЕсли;

КонецПроцедуры

// Запись нумеруется физической строкой файла: пустая строка номер занимает, но записью не является.
Процедура ПорядковыйНомер_ФизическаяСтрокаФайлаПослеПустойСтроки() Экспорт

