				.СПараметрами("МФО контрагента при поступлении", "1", 1, 10, "КонтрагентМФО")
				.СПараметрами("код контрагента при поступлении", "1", 976, 14, "КонтрагентКод")
				.СПараметрами("наименование контрагента при поступлении", "1", 185, 138, "КонтрагентНаименование")
				.СПараметрами("назначение платежа", "0", 464, 500, "НазначениеПлатежа")
			.ДобавитьСерверныйТест("Позиции_НомерДокументаРовноВСвоихГраницах")
			.ДобавитьСерверныйТест("Позиции_СуммаНачалоПоля")
