// Тесты записи документов банка: основа - заказ или счет на оплату (покупателя и поставщика), найденный по номеру в назначении
// платежа, и вендорский метод "по основанию" (задача 7 плана 04; D21, D34, Review Focus 5). Зона: проверка основы ДО вызова метода,
// режим суммы (меньше / равно / больше остатка, с НДС и без), учет оплат, строка аванса на разницу, способ зачета строк основы,
// данные банка поверх метода. Документы расчетов - СМП_ТестыЗаписиОснованиеРасчеты, платежное поручение -
// СМП_ТестыЗаписиОснованиеПоручение; помощники этого модуля (НоваяОснова, ДобавитьСтрокуОсновы, ЗаписатьПлан и другие экспортные)
// используются ими, не копируются. Правила - docs/architecture/testing.md.
//
// План строится вручную (без Распознать): записи нужен план с заданными решениями. Продукт вызывается только через
// СМП_ТестыВызовПродукта (позднее связывание); вендорские функции в тесте вызываются прямо (они - предмет сравнения).
//
// Методы (параметр Метод): "ПНС.Счет" - ПоступлениеНаСчет.ЗаполнитьПоСчетуНаОплату, "ПНС.Заказ" - ПоступлениеНаСчет.
// ЗаполнитьПоЗаказуПокупателя, "РС.СчетПоставщика" - РасходСоСчета.ЗаполнитьПоСчетНаОплатуПоставщика, "РС.ЗаказПоставщику" -
// РасходСоСчета.ЗаполнитьПоЗаказПоставщику.
//
// Условия измерения (утверждает Условия_РежимБазыИзмерения): константа СпособРазнесенияОплатыПоУмолчанию = Авто; организация фикстуры -
// ФОП, не плательщик НДС (документы основы с НДС при этом проводятся - журнал плана 04, задача 2, находка 17); договор и банковский
// счет - в национальной валюте. Фрагменты причин (NСтр продукта) сверяются по русскому тексту: условие "русский сеанс".
Процедура ИсполняемыеСценарии() Экспорт

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: условия");
	Набор.ДобавитьСерверныйТест("Условия_РежимБазыИзмерения").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: проверка ДО вызова метода (D21)");
	Набор.ДобавитьСерверныйТест("Проверка_ОсноваНеПроходит_НеБерется").ВТранзакции()
		.СПараметрами("основа другой организации", "ДругаяОрганизация", "другой организации")
		.СПараметрами("основа не проведена", "НеПроведена", "не проведен")
		.СПараметрами("основа помечена на удаление", "ПомеченаНаУдаление", "удаление")
		.СПараметрами("проведение основы отменили после распознавания", "ПроведениеОтменено", "не проведен")
		.СПараметрами("контрагент основы не контрагент строки плана", "КонтрагентДругой", "контрагент");
	Набор.ДобавитьСерверныйТест("Проверка_МетодВендораОтказал_НеБерется").ВТранзакции();

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: режим суммы, учет оплат ведется (метод без Сумма; D21, Review Focus 5)");
	Набор.ДобавитьСерверныйТест("Сумма_УчетОплатВедется").ВТранзакции()
		// Описание, Метод, СуммаОсновы, СуммаБанка, СНДС
		.СПараметрами("заказ покупателя: меньше, с НДС", "ПНС.Заказ", 1200, 600, Истина)
		.СПараметрами("заказ покупателя: равно, с НДС", "ПНС.Заказ", 1200, 1200, Истина)
		.СПараметрами("заказ покупателя: больше, с НДС", "ПНС.Заказ", 1200, 1500, Истина)
		.СПараметрами("заказ покупателя: меньше, без НДС", "ПНС.Заказ", 1000, 400, Ложь)
		.СПараметрами("заказ покупателя: больше, без НДС", "ПНС.Заказ", 1000, 1300, Ложь)
		.СПараметрами("счет покупателю: меньше, с НДС", "ПНС.Счет", 1200, 600, Истина)
		.СПараметрами("счет покупателю: равно, с НДС", "ПНС.Счет", 1200, 1200, Истина)
		.СПараметрами("счет покупателю: больше, с НДС", "ПНС.Счет", 1200, 1500, Истина)
		.СПараметрами("счет покупателю: меньше, без НДС", "ПНС.Счет", 1000, 400, Ложь)
		.СПараметрами("заказ поставщику: меньше, с НДС", "РС.ЗаказПоставщику", 1200, 600, Истина)
		.СПараметрами("заказ поставщику: больше, с НДС", "РС.ЗаказПоставщику", 1200, 1500, Истина)
		.СПараметрами("заказ поставщику: равно, без НДС", "РС.ЗаказПоставщику", 800, 800, Ложь);
	Набор.ДобавитьСерверныйТест("Сумма_ПредыдущаяОплата_ВычитаетВендор_АвансНаРазницу").ВТранзакции()
		.СПараметрами("заказ покупателя", "ПНС.Заказ")
		.СПараметрами("счет покупателю (ВестиУчетОплатыПоСчетам = Да)", "ПНС.Счет")
		.СПараметрами("заказ поставщику", "РС.ЗаказПоставщику");
	Набор.ДобавитьСерверныйТест("Сумма_ФразаБезПДВВНазначении_СтавкаОсновыНеМеняется").ВТранзакции()
		// Описание, Метод, СуммаБанка (сумма основы 1200 с НДС 20%): "без ПДВ" в назначении банка ставку и НДС строк основы не меняет (D15, решение владельца)
		.СПараметрами("заказ покупателя: меньше", "ПНС.Заказ", 600)
		.СПараметрами("заказ покупателя: больше", "ПНС.Заказ", 1500)
		.СПараметрами("заказ поставщику: меньше", "РС.ЗаказПоставщику", 600);
	Набор.ДобавитьСерверныйТест("Сумма_ОсноваПолностьюОплачена_АвансЗаДоговоромОсновы").ВТранзакции()
		// Описание, Метод, ДоговорПлана: договор плана пуст или другой договор того же контрагента - аванс все равно за договором ОСНОВЫ
		.СПараметрами("заказ покупателя, договор плана пуст", "ПНС.Заказ", "Пусто")
		.СПараметрами("заказ покупателя, договор плана другой", "ПНС.Заказ", "Другой")
		.СПараметрами("заказ поставщику, договор плана пуст", "РС.ЗаказПоставщику", "Пусто")
		.СПараметрами("заказ поставщику, договор плана другой", "РС.ЗаказПоставщику", "Другой");
	Набор.ДобавитьСерверныйТест("Сумма_ОсноваПолностьюОплачена_АвансНаВсюСумму").ВТранзакции()
		.СПараметрами("заказ покупателя", "ПНС.Заказ")
		.СПараметрами("счет покупателю (ВестиУчетОплатыПоСчетам = Да)", "ПНС.Счет")
		.СПараметрами("заказ поставщику", "РС.ЗаказПоставщику");

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: режим суммы, учет оплат не ведется (метод с Сумма = сумма банка; решение владельца)");
	Набор.ДобавитьСерверныйТест("Сумма_УчетОплатНеВедется_ОдинРядокНаСуммуБанка").ВТранзакции()
		// Описание, Метод, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам, СуммаБанка (сумма основы 1000)
		.СПараметрами("счет покупателю, ВестиУчетОплатыПоСчетам = Нет: больше", "ПНС.Счет", Истина, Ложь, 1300)
		.СПараметрами("счет покупателю, ВестиУчетОплатыПоСчетам = Нет: меньше", "ПНС.Счет", Истина, Ложь, 400)
		.СПараметрами("заказ покупателя, ВестиРасчетыПоЗаказам = Нет: больше", "ПНС.Заказ", Ложь, Истина, 1300)
		.СПараметрами("заказ поставщику, ВестиРасчетыПоЗаказам = Нет: больше", "РС.ЗаказПоставщику", Ложь, Истина, 1300)
		// Счет поставщика - учет оплат не ведется НИКОГДА (журнал плана 01, задача 4), даже при обоих признаках = Да.
		.СПараметрами("счет поставщика, признаки = Да: больше", "РС.СчетПоставщика", Истина, Истина, 1300)
		.СПараметрами("счет поставщика, признаки = Да: меньше", "РС.СчетПоставщика", Истина, Истина, 400);

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: способ зачета и данные банка поверх метода (D34, D21)");
	Набор.ДобавитьСерверныйТест("СпособЗачета_СтрокиОсновыИАвансаНаРазницу_СтавитПродуктДоЗаписи").ВТранзакции()
		.СПараметрами("заказ покупателя", "ПНС.Заказ")
		.СПараметрами("счет покупателю", "ПНС.Счет")
		.СПараметрами("заказ поставщику", "РС.ЗаказПоставщику")
		.СПараметрами("счет поставщика", "РС.СчетПоставщика");
	Набор.ДобавитьСерверныйТест("ДанныеБанка_ПоверхМетода_ОрганизацияСчетАвторНалогообложение").ВТранзакции()
		.СПараметрами("счет покупателю", "ПНС.Счет")
		.СПараметрами("заказ поставщику", "РС.ЗаказПоставщику");

	Набор = ЮТТесты.ДобавитьТестовыйНабор("Основа: сторож остатков (последним, без транзакции)");
	Набор.ДобавитьСерверныйТест("ДанныхТестовНеОсталось");

КонецПроцедуры

#Область Условия

Процедура Условия_РежимБазыИзмерения() Экспорт

	СМП_ТестыЗаписиЗачет.Условия_РежимБазыИзмерения();

	Организация = СМП_ТестыДанныеУНФ.Организация();
	ЮТест.ОжидаетЧто(НалогиУНФ.НалогообложениеНДС(Организация, , ТекущаяДатаСеанса()),
		"Условие: организация фикстуры не плательщик НДС (налогообложение по организации не ""облагается"")")
		.НеРавно(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);

КонецПроцедуры

#КонецОбласти

#Область Проверка

// D21: проверка основы ДО вызова вендорского метода обязательна - метод не проверяет ни проведение, ни пометку, а организацию и банковский
// счет документа ПЕРЕЗАПИСЫВАЕТ данными основы (журнал плана 01, задача 4). Распознавание уже отобрало кандидатов, но между ним и записью
// основу могли изменить, поэтому запись проверяет сама. Провал - основа не берется, документ заполняется без нее, причина - одно
// предупреждение. Признак "не взята" - пустое ДокументОснование (его ставит метод вендора) и строка расшифровки без колонок основы.
// Случаи: основа чужой организации; не проведена; помечена на удаление (помеченный документ всегда непроведен - платформа, поэтому проверку
// пометки от проверки проведения тест не отделяет); проведение отменили между распознаванием и записью; контрагент основы не контрагент
// СТРОКИ ПЛАНА (в плане контрагент другой; правило контрагента - СМП_ТестыЗаписиОснованиеПоручение).
Процедура Проверка_ОсноваНеПроходит_НеБерется(Описание, Случай, ФрагментПричины) Экспорт

	Метод = "ПНС.Счет";
	Настройки = Новый Структура;
	Провести = Истина;
	Если Случай = "ДругаяОрганизация" Тогда
		ДругаяОрганизация = СМП_ТестыДанныеУНФ.ДругаяОрганизация();
		Если Не ЗначениеЗаполнено(ДругаяОрганизация) Тогда
			ЮТест.Пропустить("В базе нет второй организации: нечем отличить организацию основы от организации документа");
			Возврат;
		КонецЕсли;
		Настройки.Вставить("Организация", ДругаяОрганизация);
	ИначеЕсли Случай = "НеПроведена" Тогда
		Провести = Ложь;
	ИначеЕсли Случай = "ПомеченаНаУдаление" Тогда
		Провести = Ложь;
		Настройки.Вставить("ПометкаУдаления", Истина);
	КонецЕсли;

	Основа = НоваяОснова(Метод, 1000,, Ложь, Провести, Настройки);
	Сумма = 700;
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Сценарий = СценарийОсновы(Основа);
	Если Случай = "КонтрагентДругой" Тогда
		Другой = СценарийДругогоКонтрагента(Метод);
		Сценарий.Контрагент = Другой.Контрагент;
		Сценарий.Договор = Другой.Договор;
	КонецЕсли;
	СтрокаПлана = СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, Сценарий, Новый Структура("Сумма, ДокументПоНомеру", Сумма, Основа.Основание));
	Если Случай = "ПроведениеОтменено" Тогда
		// Основа прошла бы проверку распознавания (проведена), а к записи ее проведение отменили.
		ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "Проведен"), Описание + ": предусловие - к моменту плана основа проведена").ЭтоИстина();
		ОбъектОсновы = Основа.Основание.ПолучитьОбъект();
		ОбъектОсновы.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	ЮТест.ОжидаетЧто(СтрокаПлана.Организация, Описание + ": предусловие - организация плана").Равно(СМП_ТестыДанныеУНФ.Организация());
	Если Случай = "ДругаяОрганизация" Тогда
		ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "Организация"), Описание + ": предусловие - организация основы не организация плана")
			.НеРавно(СтрокаПлана.Организация);
	КонецЕсли;
	Если Случай = "НеПроведена" Или Случай = "ПомеченаНаУдаление" Тогда
		ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "Проведен"), Описание + ": предусловие - основа не проведена").ЭтоЛожь();
	КонецЕсли;
	Если Случай = "ПомеченаНаУдаление" Тогда
		ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "ПометкаУдаления"), Описание + ": предусловие - основа помечена на удаление").ЭтоИстина();
	КонецЕсли;

	Прогон = ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.ДокументОснование), Описание + ": основа не взята - ДокументОснование пусто (его ставит метод вендора)")
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(Объект.Организация, Описание + ": организация документа - организация плана").Равно(СтрокаПлана.Организация);
	ЮТест.ОжидаетЧто(Объект.БанковскийСчет, Описание + ": банковский счет документа - счет плана").Равно(СтрокаПлана.БанковскийСчет);
	ЮТест.ОжидаетЧто(Объект.Контрагент, Описание + ": контрагент документа - контрагент плана").Равно(Сценарий.Контрагент);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": одна строка расшифровки, как для платежа без основы").Равно(1);
	Строка = Объект.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.Договор, Описание + ": договор строки - договор плана").Равно(Сценарий.Договор);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.СчетНаОплату) Или ЗначениеЗаполнено(Строка.Заказ) Или ЗначениеЗаполнено(Строка.Документ),
		Описание + ": в строке нет колонок основы").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, Описание + ": строка на всю сумму банка").Равно(Сумма);

	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": ровно одно предупреждение (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")")
		.Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, Описание + ": поле предупреждения").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": причина названа").Содержит(НРег(ФрагментПричины));
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Ошибка").Количество(), Описание + ": ошибок нет").Равно(0);

КонецПроцедуры

// Метод вендора отказал исключением (заказ покупателя ждет выбора варианта коммерческого предложения - вендорская проверка
// ПроверитьВозможностьВводаНаОснованииЗаказаПокупателя): основа не берется, документ создается без нее, причина - предупреждение с
// текстом вендора. Исключение не должно остановить запись документа ("Ошибка").
Процедура Проверка_МетодВендораОтказал_НеБерется() Экспорт

	Основа = НоваяОснова("ПНС.Заказ", 1000, ФлагиУчета(Истина, Ложь));
	ОбъектОсновы = Основа.Основание.ПолучитьОбъект();
	ОбъектОсновы.ОбменДанными.Загрузка = Истина;
	ОбъектОсновы.ОжидаетсяВыборВариантаКП = Истина;
	ОбъектОсновы.Записать();
	ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "Проведен"), "Предусловие: заказ остался проведенным").ЭтоИстина();

	// Предусловие: метод вендора на этом заказе отказывает исключением (оба режима суммы проходят ту же проверку).
	Проба = Документы.ПоступлениеНаСчет.СоздатьДокумент();
	ТекстОтказа = Неопределено;
	Попытка
		Проба.ЗаполнитьПоЗаказуПокупателя(Основа.Основание);
	Исключение
		ТекстОтказа = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЮТест.ОжидаетЧто(ТекстОтказа, "Предусловие: метод вендора отказал исключением").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(НРег(ТекстОтказа), "Предусловие: причина отказа - вариант коммерческого предложения").Содержит("коммерческого предложения");

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	Сумма = 700;
	ДобавитьСтрокуОсновы(План, Основа, Сумма);
	Прогон = ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, "Результат: документ создан, исключение метода запись не остановило (замечания: "
		+ ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.ДокументОснование), "Основа не взята: ДокументОснование пусто").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), "Одна строка расшифровки, как без основы").Равно(1);
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Объект.РасшифровкаПлатежа[0].Заказ), "В строке нет заказа").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа[0].СуммаПлатежа, "Строка на всю сумму банка").Равно(Сумма);
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), "Ровно одно предупреждение (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, "Поле предупреждения").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), "Текст вендора в предупреждении").Содержит("коммерческого предложения");

КонецПроцедуры

#КонецОбласти

#Область РежимСуммы

// Review Focus 5 и D21: учет оплат за этим видом основы ведется (признак контрагента = Да) - метод БЕЗ Сумма, остаток к оплате ему
// известен. Банк заплатил меньше - строка уменьшается, а СуммаРасчетов и СуммаНДС пересчитывает ПРОДУКТ (сама 1С их не пересчитывает ни при
// распределении, ни при записи, ни при проведении - журнал плана 04, задача 2, находка 17): документ ПРОВЕДЕН, значения читаются из базы.
// Равно - одна строка на всю сумму. Больше - ВТОРАЯ строка аванса на разницу (тот же договор, без документа, без заказа и счета).
// Ожидаемые значения выводятся из входов и ставки "Общая", прочитанной вендорской функцией, не из ответа продукта. Условие: НДС в UAH,
// организация - неплательщик (документ внутренне противоречив, но проводится).
Процедура Сумма_УчетОплатВедется(Описание, Метод, СуммаОсновы, СуммаБанка, СНДС) Экспорт

	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), СНДС);
	ПроверитьПредусловиеФлагов(Основа, Истина, Истина, Описание);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Прогон = ЗаписатьПлан(План);

	ПроверитьДокументСОсновой(Прогон, Основа, ОжидаемыеСтрокиСОснованием(СуммаОсновы, СуммаБанка, СНДС), СуммаБанка, Описание);

КонецПроцедуры

// Оплата другим документом (400 из 1000) вычитается ВЕНДОРОМ: остаток 600 - не наш расчет. Банк заплатил 800 - основа на остаток 600 и
// аванс на разницу 200. Если бы продукт брал метод с Сумма = 800, строка была бы одна на 800 (оплаты метод с Сумма не вычитает).
// Предусловие: оплата привязана к основанию в регистре (иначе "вычитается" вакуумно).
Процедура Сумма_ПредыдущаяОплата_ВычитаетВендор_АвансНаРазницу(Описание, Метод) Экспорт

	СуммаОсновы = 1000;
	Оплачено = 400;
	СуммаБанка = 800;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Ложь);
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, Оплачено);
	ЮТест.ОжидаетЧто(ОплаченоПоРегистру(Основа.Основание), Описание + ": предусловие - оплата привязана к основанию в регистре").Равно(Оплачено);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Прогон = ЗаписатьПлан(План);

	ПроверитьДокументСОсновой(Прогон, Основа, ОжидаемыеСтрокиСОснованием(СуммаОсновы - Оплачено, СуммаБанка, Ложь), СуммаБанка, Описание);

КонецПроцедуры

// D15 (решение владельца 2026-10-15, спека e8bed01): "без ПДВ" в назначении банка НЕ меняет ставку и под основой - ставка и НДС строк основы остаются
// ставкой основы (платить может ФОП без НДС, а организация-получатель - плательщик НДС), предупреждения нет. Основа с НДС 20% (1200 / НДС 200);
// банк заплатил меньше (600, НДС 100) и больше (1500: строка основы 1200 / 200 и аванс на разницу 300 / 50). Пара без основы -
// СМП_ТестыЗаписиЗаполнение.СтавкаНДС_БезПДВВНазначении_СтавкаПоПравиламВендора. Ожидаемые суммы выводятся из ставки "Общая".
Процедура Сумма_ФразаБезПДВВНазначении_СтавкаОсновыНеМеняется(Описание, Метод, СуммаБанка) Экспорт

	СуммаОсновы = 1200;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Истина);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);
	СтрокаПлана.НазначениеПлатежа = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Оплата по основанию, без ПДВ";
	ЮТест.ОжидаетЧто(СтрНайти(НРег(СтрокаПлана.НазначениеПлатежа), "без пдв") > 0, Описание + ": предусловие - в назначении фраза ""без ПДВ""").ЭтоИстина();
	ЮТест.ОжидаетЧто(НДСИзСуммы(СуммаОсновы, Истина), Описание + ": предусловие - НДС основы не нулевой").НеРавно(0);

	Прогон = ЗаписатьПлан(План);

	ПроверитьДокументСОсновой(Прогон, Основа, ОжидаемыеСтрокиСОснованием(СуммаОсновы, СуммаБанка, Истина), СуммаБанка, Описание);
	Общая = Справочники.СтавкиНДС.СтавкаНДС(ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.Общая"), ТекущаяДатаСеанса());
	Для Каждого Строка Из Прогон.Объект.РасшифровкаПлатежа Цикл
		ЮТест.ОжидаетЧто(Строка.СтавкаНДС, Описание + ": строка " + Строка.НомерСтроки + ": ставка основы, не ""Без ПДВ"" из назначения").Равно(Общая);
	КонецЦикла;

КонецПроцедуры

// Основа полностью оплачена, договор плана ПУСТ или ДРУГОЙ: строка аванса лежит за договором ОСНОВЫ (D21: "за тем же договором"), предупреждение
// "основание найдено, но уже полностью оплачено" - только когда строка реально создана. Тест НЕ подставляет договор плана договором основы
// (СценарийОсновы делает это по умолчанию - здесь план перебит). Ставка строки - по правилам вендора для ДОГОВОРА ОСНОВЫ: у договора основы
// способ "из карточки номенклатуры" (расход: ставка "Общая"), а ставка организации другая, так что договор плана (способа не имеет) отличается
// от договора основы ставкой; для поступления ставка по организации (способ договора там не читается). Ожидаемую ставку дает вендорская функция в тесте.
Процедура Сумма_ОсноваПолностьюОплачена_АвансЗаДоговоромОсновы(Описание, Метод, ДоговорПлана) Экспорт

	СуммаОсновы = 1000;
	СуммаБанка = 700;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Ложь);
	ОбъектДоговора = Основа.Договор.ПолучитьОбъект();
	ОбъектДоговора.СпособЗаполненияСтавкиНДС = Перечисления.СпособыЗаполненияСтавкиНДС.ИзКарточкиНоменклатуры;
	ОбъектДоговора.Записать();
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, СуммаОсновы);
	ЮТест.ОжидаетЧто(ОплаченоПоРегистру(Основа.Основание), Описание + ": предусловие - основа полностью оплачена").Равно(СуммаОсновы);

	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);
	Если ДоговорПлана = "Пусто" Тогда
		СтрокаПлана.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Иначе
		СтрокаПлана.Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Основа.Контрагент, Новый Структура("ВидДоговора",
			ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(ЭтоИсходящий(Метод), "СПоставщиком", "СПокупателем"))));
	КонецЕсли;
	ЮТест.ОжидаетЧто(СтрокаПлана.Договор, Описание + ": предусловие - договор плана не договор основы").НеРавно(Основа.Договор);

	Прогон = ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Объект <> Неопределено, Описание + ": документ записан (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": одна строка аванса").Равно(1);
	Строка = Объект.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.Договор, Описание + ": договор строки - договор ОСНОВЫ, не плана").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, Описание + ": сумма строки - сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Строка.ПризнакАванса, Описание + ": аванс").ЭтоИстина();
	ЮТест.ОжидаетЧто(Строка.СпособЗачета, Описание + ": способ зачета - Вручную").Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную);
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": ровно одно предупреждение (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно(1);
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": причина названа").Содержит("найдено, но уже полностью оплачено");

	// Ставка строки - вендорская функция для договора основы (расход) или по организации (поступление); эталон считается в тесте.
	Организация = СтрокаПлана.Организация;
	Если ЭтоИсходящий(Метод) Тогда
		Способ = Справочники.ДоговорыКонтрагентов.СпособЗаполненияСтавкиНДСПоДоговору(Основа.Договор);
		Ожидаемая = РасчетыРаботаСФормамиВызовСервера.СтавкаНДСПоОрганизацииНалогообложениеНДСИСпособуЗаполнения(Организация, Объект.Дата, Способ);
		СпособПлана = Справочники.ДоговорыКонтрагентов.СпособЗаполненияСтавкиНДСПоДоговору(СтрокаПлана.Договор);
		ПоПлану = РасчетыРаботаСФормамиВызовСервера.СтавкаНДСПоОрганизацииНалогообложениеНДСИСпособуЗаполнения(Организация, Объект.Дата, СпособПлана);
		ЮТест.ОжидаетЧто(Ожидаемая, Описание + ": предусловие - ставка по договору основы отличается от ставки по договору плана").НеРавно(ПоПлану);
	Иначе
		Ожидаемая = Неопределено;
		ЧислоСтавки = Неопределено;
		РасчетыРаботаСФормамиВызовСервера.ЗаполнитьСтавкуНДСПоУмолчанию(Ожидаемая, ЧислоСтавки, Объект.НалогообложениеНДС, Организация);
	КонецЕсли;
	ЮТест.ОжидаетЧто(Строка.СтавкаНДС, Описание + ": ставка строки - по правилам вендора для договора основы").Равно(Ожидаемая);

КонецПроцедуры

// Основа полностью оплачена (оплата 1000 из 1000, учет оплат ведется): вендорский метод без Сумма строк НЕ дает (журнал плана 04, задача 7:
// 0 строк, СуммаДокумента 0; условие - база SMB, оплата проведена, признаки = Да). Банк заплатил 700 - вся сумма это "разница": одна строка
// аванса по договору основы, без колонок основы, "Вручную", и предупреждение "уже полностью оплачено". Предусловие: оплата привязана к
// основанию в регистре и равна сумме основы.
Процедура Сумма_ОсноваПолностьюОплачена_АвансНаВсюСумму(Описание, Метод) Экспорт

	СуммаОсновы = 1000;
	СуммаБанка = 700;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Ложь);
	СМП_ТестыДанныеУНФ.НоваяОплата(Основа.Основание, СуммаОсновы);
	ЮТест.ОжидаетЧто(ОплаченоПоРегистру(Основа.Основание), Описание + ": предусловие - оплата привязана к основанию в регистре и равна сумме основы")
		.Равно(СуммаОсновы);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Прогон = ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.СуммаДокумента, Описание + ": сумма документа - сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": одна строка аванса").Равно(1);
	Строка = Объект.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, Описание + ": СуммаПлатежа = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Строка.СуммаРасчетов, Описание + ": СуммаРасчетов = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Строка.Договор, Описание + ": договор основы").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(Строка.ПризнакАванса, Описание + ": аванс").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Строка.Заказ) Или ЗначениеЗаполнено(Строка.СчетНаОплату) Или ЗначениеЗаполнено(Строка.Документ),
		Описание + ": колонок основы нет").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.СпособЗачета, Описание + ": способ зачета - Вручную").Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную);
	Предупреждения = СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение");
	ЮТест.ОжидаетЧто(Предупреждения.Количество(), Описание + ": ровно одно предупреждение (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно(1);
	ЮТест.ОжидаетЧто(Предупреждения[0].Поле, Описание + ": поле предупреждения").Равно("ДокументПоНомеру");
	ЮТест.ОжидаетЧто(НРег(Предупреждения[0].Текст), Описание + ": причина названа").Содержит("найдено, но уже полностью оплачено");

КонецПроцедуры

// Решение владельца (D21): учет оплат за этим видом основы не ведется (признак контрагента = Нет; для счета поставщика - никогда) -
// метод С Сумма = сумма банка: ОДНА строка на всю сумму, договор и остальное - из основы, аванс на разницу не выделяется.
// Предусловие: признаки контрагента в базе - заданные. Для счета поставщика признаки Да нарочно: он не ведет учет и при них.
// Сумма основы 1000.
Процедура Сумма_УчетОплатНеВедется_ОдинРядокНаСуммуБанка(Описание, Метод, ПоЗаказам, ПоСчетам, СуммаБанка) Экспорт

	СуммаОсновы = 1000;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(ПоЗаказам, ПоСчетам), Ложь);
	ПроверитьПредусловиеФлагов(Основа, ПоЗаказам, ПоСчетам, Описание);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Прогон = ЗаписатьПлан(План);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": одна строка, аванс на разницу не выделяется").Равно(1);
	Строка = Объект.РасшифровкаПлатежа[0];
	ЮТест.ОжидаетЧто(Строка.СуммаПлатежа, Описание + ": СуммаПлатежа = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Строка.СуммаРасчетов, Описание + ": СуммаРасчетов = сумма банка (договор в национальной валюте)").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Объект.СуммаДокумента, Описание + ": СуммаДокумента = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Строка.Договор, Описание + ": договор - из основы").Равно(Основа.Договор);
	ЮТест.ОжидаетЧто(Объект.Проведен, Описание + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), Описание + ": предупреждений нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СпособЗачетаИДанныеБанка

// D34: строки найденной основы - "Вручную" с этим документом; строка аванса на разницу - "Вручную" без документа. Тест заполняет ОТКРЫТЫЙ
// объект (без записи): при записи пустой способ вендор сам превращает в "Вручную" (журнал задачи 6), и после записи поставленное продуктом
// не отличить от значения платформы. Метод вендора способ зачета в строках не ставит (журнал плана 04, задача 2, находка 13: акт - ставит,
// остальные - нет; для заказов и счетов - нет, МетодНеСтавитСпособЗачетаВСтроках). Константа = Авто (условие), поэтому цепочка вендора для
// строки "ничего не найдено" дала бы Авто - строки основы от нее отличаются. Счет поставщика берется с Сумма (одна строка).
// ВариантЗаполненияРасшифровки продукт не ставит "Автоматически" (передумова перерахунку: иначе вендор при проведении перезаполнит
// расшифровку сам).
Процедура СпособЗачета_СтрокиОсновыИАвансаНаРазницу_СтавитПродуктДоЗаписи(Описание, Метод) Экспорт

	СуммаОсновы = 1000;
	СуммаБанка = 1300;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Ложь);
	ЮТест.ОжидаетЧто(Константы.СпособРазнесенияОплатыПоУмолчанию.Получить(), Описание + ": предусловие - константа способа разноса Авто")
		.Равно(Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто);
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);

	Объект = ?(ЭтоИсходящий(Метод), Документы.РасходСоСчета.СоздатьДокумент(), Документы.ПоступлениеНаСчет.СоздатьДокумент());
	ЗаполнитьОткрытыйДокумент(Объект, СтрокаПлана);

	Вручную = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": строк расшифровки (основа и аванс на разницу)")
		.Равно(?(Метод = "РС.СчетПоставщика", 1, 2));
	Для Каждого Строка Из Объект.РасшифровкаПлатежа Цикл
		ЮТест.ОжидаетЧто(Строка.СпособЗачета, Описание + ": строка " + Строка.НомерСтроки + ": способ зачета - Вручную, поставлен до записи")
			.Равно(Вручную);
	КонецЦикла;
	Если Метод <> "РС.СчетПоставщика" Тогда
		Аванс = Объект.РасшифровкаПлатежа[1];
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Аванс.Документ), Описание + ": строка аванса без документа расчетов").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Аванс.ПризнакАванса, Описание + ": строка аванса - ПризнакАванса").ЭтоИстина();
	КонецЕсли;
	ЮТест.ОжидаетЧто(Объект.ВариантЗаполненияРасшифровки, Описание + ": ВариантЗаполненияРасшифровки не Автоматически")
		.НеРавно(Перечисления.ВариантыЗаполненияРасшифровкиПлатежа.Автоматически);

КонецПроцедуры

// Данные банка ложатся ПОВЕРХ метода: метод перезаписывает организацию, банковский счет, валюту и налогообложение НДС данными основы
// (D21; находка 19), поэтому продукт ставит свои значения после метода. Основа с НДС: налогообложение основы - "облагается", а у
// организации плана - нет (предусловие), то есть значение основы и значение организации различимы. Автор - ответственный из контекста,
// не пользователь сеанса (D16). Банковский счет плана - счет фикстуры: метод берет счет по умолчанию организации основы, и совпадение
// двух счетов тест не исключает (второй счет организации без счета учета документ не проводит - журнал плана 04, задача 3), поэтому
// счет утверждается как "счет плана", но мутацией не доказан.
Процедура ДанныеБанка_ПоверхМетода_ОрганизацияСчетАвторНалогообложение(Описание, Метод) Экспорт

	СуммаОсновы = 1000;
	СуммаБанка = 1300;
	Основа = НоваяОснова(Метод, СуммаОсновы, ФлагиУчета(Истина, Истина), Истина);
	ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Основание, "НалогообложениеНДС"), Описание + ": предусловие - налогообложение основы ""облагается""")
		.Равно(Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);

	Организация = СМП_ТестыДанныеУНФ.Организация();
	План = СМП_ТестыЗаписиКаркас.НовыйПлан();
	СтрокаПлана = ДобавитьСтрокуОсновы(План, Основа, СуммаБанка);
	СтрокаПлана.НазначениеПлатежа = СМП_ТестыДанныеУНФ.ПрефиксФикстуры() + "Основа, назначение платежа из банка";
	Ответственный = СМП_ТестыДанныеУНФ.НовыйПользователь();
	ЮТест.ОжидаетЧто(Ответственный, Описание + ": предусловие - ответственный не пользователь сеанса").НеРавно(Пользователи.ТекущийПользователь());

	Прогон = ЗаписатьПлан(План, Ответственный);

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": основа взята").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.БанковскийСчет, Описание + ": банковский счет - счет плана").Равно(СтрокаПлана.БанковскийСчет);
	ЮТест.ОжидаетЧто(Объект.Организация, Описание + ": организация плана").Равно(Организация);
	ЮТест.ОжидаетЧто(Объект.ВалютаДенежныхСредств, Описание + ": валюта - валюта счета плана")
		.Равно(РеквизитСсылки(СтрокаПлана.БанковскийСчет, "ВалютаДенежныхСредств"));
	ЮТест.ОжидаетЧто(Объект.НалогообложениеНДС, Описание + ": налогообложение НДС - по организации, не ""облагается"" основы")
		.Равно(НалогиУНФ.НалогообложениеНДС(Организация, , Объект.Дата));
	ЮТест.ОжидаетЧто(Объект.НазначениеПлатежа, Описание + ": назначение платежа из банка").Равно(СтрокаПлана.НазначениеПлатежа);
	ЮТест.ОжидаетЧто(Объект.Автор, Описание + ": автор - ответственный").Равно(Ответственный);

КонецПроцедуры

#КонецОбласти

#Область Сторож

Процедура ДанныхТестовНеОсталось() Экспорт

	Для Каждого Элемент Из СМП_ТестыДанныеУНФ.КоличествоОбъектовФикстурыПоТипам() Цикл
		ЮТест.ОжидаетЧто(Элемент.Значение, Элемент.Ключ + ": объекты фикстуры (СМП_ТЕСТ_*) пережили откат теста").Равно(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Признаки учета оплат контрагента основы (расчеты по договорам и документам - всегда Да).
Функция ФлагиУчета(ПоЗаказам, ПоСчетам) Экспорт

	Возврат Новый Структура("ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам", ПоЗаказам, ПоСчетам);

КонецФункции

Функция ЭтоИсходящий(Метод) Экспорт

	Возврат Лев(Метод, 2) = "РС";

КонецФункции

// Контрагент, договор нужного вида и основа нужного типа (в транзакции вызывающего теста). Основа проводится, если не сказано иное.
// Настройки - ключи построителя основы (Организация, ПометкаУдаления, Дата, Номер).
// Возвращает структуру: Контрагент, Договор, Основание, Сумма, Метод.
Функция НоваяОснова(Метод, Сумма, Флаги = Неопределено, СНДС = Ложь, Провести = Истина, Настройки = Неопределено) Экспорт

	Если Флаги = Неопределено Тогда
		Флаги = ФлагиУчета(Истина, Ложь);
	КонецЕсли;
	ПризнакиКонтрагента = Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Истина, Флаги.ВестиРасчетыПоЗаказам, Флаги.ВестиУчетОплатыПоСчетам);
	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(ПризнакиКонтрагента);
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(ЭтоИсходящий(Метод), "СПоставщиком", "СПокупателем"))));

	ПараметрыОсновы = Новый Структура;
	Если СНДС Тогда
		ПараметрыОсновы.Вставить("СНДС", Истина);
	КонецЕсли;
	Если Настройки <> Неопределено Тогда
		Для Каждого Элемент Из Настройки Цикл
			ПараметрыОсновы.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Метод = "ПНС.Счет" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплату(Контрагент, Договор, Сумма, Провести, ПараметрыОсновы);
	ИначеЕсли Метод = "ПНС.Заказ" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйЗаказПокупателя(Контрагент, Договор, Сумма, Провести, ПараметрыОсновы);
	ИначеЕсли Метод = "РС.СчетПоставщика" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйСчетНаОплатуПоставщика(Контрагент, Договор, Сумма, Провести, ПараметрыОсновы);
	ИначеЕсли Метод = "РС.ЗаказПоставщику" Тогда
		Основание = СМП_ТестыДанныеУНФ.НовыйЗаказПоставщику(Контрагент, Договор, Сумма, Провести, ПараметрыОсновы);
	Иначе
		ВызватьИсключение "СМП_ТестыЗаписиОснование: неизвестный метод " + Метод;
	КонецЕсли;

	Возврат Новый Структура("Контрагент, Договор, Основание, Сумма, Метод", Контрагент, Договор, Основание, Сумма, Метод);

КонецФункции

// Сценарий для СМП_ТестыЗаписиКаркас.ДобавитьСтроку: вид документа, контрагент и договор основы, статья и вид операции по направлению.
Функция СценарийОсновы(Основа) Экспорт

	ЭтоРасход = ЭтоИсходящий(Основа.Метод);
	Сценарий = Новый Структура;
	Сценарий.Вставить("Вид", ?(ЭтоРасход, "РасходСоСчета", "ПоступлениеНаСчет"));
	Сценарий.Вставить("Контрагент", Основа.Контрагент);
	Сценарий.Вставить("Договор", Основа.Договор);
	Сценарий.Вставить("Статья", ПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств."
		+ ?(ЭтоРасход, "ОплатаПоставщикам", "ОплатаОтПокупателей")));
	Сценарий.Вставить("ВидОперации", ?(ЭтоРасход, ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.Поставщику"),
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ОтПокупателя")));

	Возврат Сценарий;

КонецФункции

// Контрагент и договор для случая "контрагент плана не контрагент основы" (вид договора по направлению метода).
Функция СценарийДругогоКонтрагента(Метод) Экспорт

	Контрагент = СМП_ТестыДанныеУНФ.НовыйКонтрагент(Новый Структура("ВестиРасчетыПоДоговорам, ВестиРасчетыПоДокументам, ВестиРасчетыПоЗаказам, ВестиУчетОплатыПоСчетам",
		Истина, Истина, Истина, Ложь));
	Договор = СМП_ТестыДанныеУНФ.НовыйДоговор(Контрагент, Новый Структура("ВидДоговора",
		ПредопределенноеЗначение("Перечисление.ВидыДоговоров." + ?(ЭтоИсходящий(Метод), "СПоставщиком", "СПокупателем"))));

	Возврат Новый Структура("Контрагент, Договор", Контрагент, Договор);

КонецФункции

// Добавляет в план строку с основой (колонка ДокументПоНомеру), сумма банка - СуммаБанка. Решения - значения колонок плана сверх основы.
Функция ДобавитьСтрокуОсновы(План, Основа, СуммаБанка, Решения = Неопределено) Экспорт

	Настройки = Новый Структура("Сумма, ДокументПоНомеру", СуммаБанка, Основа.Основание);
	Если Решения <> Неопределено Тогда
		Для Каждого Элемент Из Решения Цикл
			Настройки.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат СМП_ТестыЗаписиКаркас.ДобавитьСтроку(План, СценарийОсновы(Основа), Настройки);

КонецФункции

// Записывает план (продукт, Записать) и читает документ первой строки из базы.
// Возвращает: Результат (результат записи), СтрокаРезультата (первая строка), Документ (ссылка), Объект (объект документа из базы),
// Контекст.
Функция ЗаписатьПлан(План, Ответственный = Неопределено) Экспорт

	Контекст = СМП_ТестыЗаписиКаркас.КонтекстЗаписи(Ответственный);
	Результат = СМП_ТестыЗаписиКаркас.Записать(План, Контекст);
	СтрокаРезультата = СМП_ТестыЗаписиКаркас.СтрокаРезультатаПоНомеру(Результат, 1);

	Возврат Новый Структура("Результат, СтрокаРезультата, Документ, Объект, Контекст", Результат, СтрокаРезультата, СтрокаРезультата.Документ,
		?(ЗначениеЗаполнено(СтрокаРезультата.Документ), СтрокаРезультата.Документ.ПолучитьОбъект(), Неопределено), Контекст);

КонецФункции

// Заполняет открытый объект документа по строке плана продуктом (ЗаполнитьДокументПоСтрокеПлана), без записи.
Процедура ЗаполнитьОткрытыйДокумент(Объект, СтрокаПлана, Замечания = Неопределено) Экспорт

	Аргументы = Новый Массив;
	Аргументы.Добавить(Объект);
	Аргументы.Добавить(СтрокаПлана);
	Аргументы.Добавить(СМП_ТестыЗаписиКаркас.КонтекстЗаписи());
	Если Замечания <> Неопределено Тогда
		Аргументы.Добавить(Неопределено);
		Аргументы.Добавить(Замечания);
	КонецЕсли;
	СМП_ТестыВызовПродукта.ВызватьПроцедуру("СМП_ЗаписьДокументовБанка.ЗаполнитьДокументПоСтрокеПлана", Аргументы);

КонецПроцедуры

// Ставка "Общая" на дату фикстуры в процентах (вендорская функция значения ставки; фикстура использует ее же).
Функция СтавкаОбщая() Экспорт

	Ставка = Справочники.СтавкиНДС.СтавкаНДС(ПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.Общая"), ТекущаяДатаСеанса());

	Возврат УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(Ставка);

КонецФункции

// НДС, выделенный из суммы, которая его включает (формула фикстуры и вендорских методов: сумма · ставка / (100 + ставка)).
Функция НДСИзСуммы(Сумма, СНДС) Экспорт

	Если Не СНДС Тогда
		Возврат 0;
	КонецЕсли;
	Ставка = СтавкаОбщая();

	Возврат Окр(Сумма * Ставка / (100 + Ставка), 2);

КонецФункции

// Ожидаемые строки расшифровки документа с основой: основа на меньшую из сумм (остаток к оплате, сумма банка) и - если банк заплатил
// больше остатка - строка аванса на разницу. Структура строки: СуммаПлатежа, СуммаРасчетов, СуммаНДС, Аванс (Булево).
Функция ОжидаемыеСтрокиСОснованием(Остаток, СуммаБанка, СНДС) Экспорт

	Строки = Новый Массив;
	СуммаОсновы = Мин(Остаток, СуммаБанка);
	Строки.Добавить(Новый Структура("СуммаПлатежа, СуммаРасчетов, СуммаНДС, Аванс", СуммаОсновы, СуммаОсновы, НДСИзСуммы(СуммаОсновы, СНДС), Ложь));
	Если СуммаБанка > Остаток Тогда
		Разница = СуммаБанка - Остаток;
		Строки.Добавить(Новый Структура("СуммаПлатежа, СуммаРасчетов, СуммаНДС, Аванс", Разница, Разница, НДСИзСуммы(Разница, СНДС), Истина));
	КонецЕсли;

	Возврат Строки;

КонецФункции

// Проверка документа, записанного с основой: результат, шапка по основе и данным банка, строки расшифровки по ожиданию. Колонка основы
// первой строки (Заказ для заказа, СчетНаОплату для счета) - основание, когда учет оплат ведется; у строки аванса колонок основы нет.
// Сумма документа - сумма банка и равна итогу расшифровки (вендор требует точного совпадения). Значения читаются из объекта, прочитанного
// из базы после проведения.
Процедура ПроверитьДокументСОсновой(Прогон, Основа, ОжидаемыеСтроки, СуммаБанка, Описание) Экспорт

	Объект = Прогон.Объект;
	ЮТест.ОжидаетЧто(Прогон.СтрокаРезультата.Результат, Описание + ": результат (замечания: " + ТекстыЗамечаний(Прогон.Результат) + ")").Равно("Создан");
	ЮТест.ОжидаетЧто(Объект.Проведен, Описание + ": документ проведен").ЭтоИстина();
	ЮТест.ОжидаетЧто(Объект.ДокументОснование, Описание + ": ДокументОснование - основа").Равно(Основа.Основание);
	ЮТест.ОжидаетЧто(Объект.Контрагент, Описание + ": контрагент основы").Равно(Основа.Контрагент);
	ЮТест.ОжидаетЧто(Объект.СуммаДокумента, Описание + ": сумма документа - сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Итог("СуммаПлатежа"), Описание + ": итог расшифровки = сумма банка").Равно(СуммаБанка);
	ЮТест.ОжидаетЧто(СМП_ТестыЗаписиКаркас.ЗамечанияСтроки(Прогон.Результат, 1, "Предупреждение").Количество(), Описание + ": предупреждений нет").Равно(0);

	ЮТест.ОжидаетЧто(Объект.РасшифровкаПлатежа.Количество(), Описание + ": строк расшифровки").Равно(ОжидаемыеСтроки.Количество());
	ИмяКолонкиОсновы = ?(Основа.Метод = "ПНС.Счет" Или Основа.Метод = "РС.СчетПоставщика", "СчетНаОплату", "Заказ");
	Вручную = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;
	Расхождения = "";
	Для Индекс = 0 По ОжидаемыеСтроки.ВГраница() Цикл
		Ожидание = ОжидаемыеСтроки[Индекс];
		Строка = Объект.РасшифровкаПлатежа[Индекс];
		Для Каждого Колонка Из СтрРазделить("СуммаПлатежа,СуммаРасчетов,СуммаНДС", ",") Цикл
			Если Строка[Колонка] <> Ожидание[Колонка] Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", " + Колонка + ": ожидали " + Ожидание[Колонка]
					+ ", факт " + Строка[Колонка];
			КонецЕсли;
		КонецЦикла;
		Если Строка.Договор <> Основа.Договор Тогда
			Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", Договор: не договор основы";
		КонецЕсли;
		Если Строка.СпособЗачета <> Вручную Тогда
			Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", СпособЗачета: " + Строка.СпособЗачета;
		КонецЕсли;
		Если Ожидание.Аванс Тогда
			Если Не Строка.ПризнакАванса Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ": строка аванса без ПризнакАванса";
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Заказ) Или ЗначениеЗаполнено(Строка.СчетНаОплату) Или ЗначениеЗаполнено(Строка.Документ) Тогда
				Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ": у строки аванса есть колонки основы";
			КонецЕсли;
		ИначеЕсли Строка[ИмяКолонкиОсновы] <> Основа.Основание Тогда
			Расхождения = Расхождения + Символы.ПС + "  строка " + (Индекс + 1) + ", " + ИмяКолонкиОсновы + ": не основа";
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Расхождения, Описание + ": строки расшифровки как ожидалось").Равно("");

КонецПроцедуры

// Признаки контрагента основы в базе - заданные (построитель мог не поставить, платформа - подставить свое).
Процедура ПроверитьПредусловиеФлагов(Основа, ПоЗаказам, ПоСчетам, Описание) Экспорт

	ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Контрагент, "ВестиРасчетыПоЗаказам"), Описание + ": предусловие - ВестиРасчетыПоЗаказам в базе").Равно(ПоЗаказам);
	ЮТест.ОжидаетЧто(РеквизитСсылки(Основа.Контрагент, "ВестиУчетОплатыПоСчетам"), Описание + ": предусловие - ВестиУчетОплатыПоСчетам в базе").Равно(ПоСчетам);

КонецПроцедуры

// Сколько оплаты регистр ОплатаСчетовИЗаказов привязал к основанию (аванс + оплата). Только читает.
Функция ОплаченоПоРегистру(Основание) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаАванса + Р.СуммаОплаты), 0) КАК Сумма
		|ИЗ РегистрНакопления.ОплатаСчетовИЗаказов КАК Р
		|ГДЕ Р.СчетНаОплату = &Основание");
	Запрос.УстановитьПараметр("Основание", Основание);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Сумма;

КонецФункции

// Реквизит ссылки запросом (значение из базы, не из кэша объекта).
Функция РеквизитСсылки(Ссылка, Имя) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Т." + Имя + " КАК Значение ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Значение;

КонецФункции

// Тексты замечаний результата записи одной строкой ("Уровень: текст"), для сообщения утверждения (NUL показан как <NUL>).
Функция ТекстыЗамечаний(Результат) Экспорт

	Тексты = Новый Массив;
	Для Каждого Замечание Из Результат.Замечания Цикл
		Тексты.Добавить(Замечание.Уровень + ": " + СтрЗаменить(Замечание.Текст, Символ(0), "<NUL>"));
	КонецЦикла;

	Возврат СтрСоединить(Тексты, " | ");

КонецФункции

#КонецОбласти
