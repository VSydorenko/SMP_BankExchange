// iFOBS не пишет время в файл: параметр Момент на байты не влияет (он нужен имени файла и форматам с датой создания).
Процедура Формат_МоментНеВлияетНаБайты() Экспорт

	Поручения = ВМассив(Поручение());
	Параметры1 = НовыеПараметры();
	Параметры1.Вставить("Момент", Дата(2020, 1, 1, 0, 0, 0));
	Параметры2 = НовыеПараметры();
	Параметры2.Вставить("Момент", Дата(2030, 12, 31, 23, 59, 59));

