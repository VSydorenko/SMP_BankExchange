#Область ОписаниеИИмя

Процедура Описание_ИдентификаторКодировкаРасширение() Экспорт

	Описание = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ОписаниеФормата");

	ЮТест.ОжидаетЧто(Описание.Идентификатор, "Идентификатор").Равно("СМП_ФорматВыгрузкиiFOBS_TXT");
	ЮТест.ОжидаетЧто(Описание.РасширениеФайла, "Расширение").Равно("txt");
	ЮТест.ОжидаетЧто(Описание.Кодировка, "Кодировка").Равно("windows-1251");
	ЮТест.ОжидаетЧто(ПустаяСтрока(Описание.Наименование), "Наименование пусто").ЭтоЛожь();

КонецПроцедуры

// Расширение имени пакета - ФорматФайлаВыгрузки() копии обработки в ее регистре (рішення 6), а не ФорматФайла() (csv).
Процедура Описание_РасширениеКакУКопииОбработки(Описание, ИмяБанка) Экспорт

	Обработка = СМП_ТестыВызовПродукта.Вызвать("Обработки.СМП_ОбработкаВыпискиБанка_" + ИмяБанка + ".Создать");
	Формат = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ОписаниеФормата");

	ЮТест.ОжидаетЧто(Формат.РасширениеФайла, Описание + ": расширение").Равно(Обработка.ФорматФайлаВыгрузки());

КонецПроцедуры

Процедура ИмяФайла_ИзМоментаИРасширения(Описание, Момент, Ожидаемое) Экспорт

	Имя = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ПредлагаемоеИмяФайла", ВМассив(Момент));

	ЮТест.ОжидаетЧто(Имя, Описание).Равно(Ожидаемое);

КонецПроцедуры

Процедура ИмяФайла_ЗависитТолькоОтМомента() Экспорт

	Момент = Дата(2026, 10, 15, 13, 45, 30);
	Первое = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ПредлагаемоеИмяФайла", ВМассив(Момент));
	Второе = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ПредлагаемоеИмяФайла", ВМассив(Момент));
	Другое = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.ПредлагаемоеИмяФайла", ВМассив(Момент + 1));

	ЮТест.ОжидаетЧто(Второе, "Тот же момент - то же имя").Равно(Первое);
	ЮТест.ОжидаетЧто(Другое <> Первое, "Другой момент - другое имя").ЭтоИстина();
	ЮТест.ОжидаетЧто(ПустаяСтрока(Первое), "Имя непустое").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область БайтВБайт

Процедура Эталон_БайтВБайт(Описание, ИмяБанка) Экспорт

	Поручения = БогатыйНабор();
	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона(ИмяБанка, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(СтрСоединить(РазличающиесяКлючи(ТекстWindows1251(Результат.Данные), ТекстWindows1251(Эталон)), ","),
		Описание + ": строки, которыми файл отличается от эталона").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(Результат.Данные), Описание + ": байты").Равно(Base64Строка(Эталон));

КонецПроцедуры

// Акорд, УкрГаз, Универсал: эталон ставит в CLN_OKPO код получателя (дефект, рішення 2 - не воспроизводится).
// Различие РОВНО в строках CLN_OKPO/RCPT_OKPO, значения - по смыслу: CLN = наша организация (Плательщик.Код).
Процедура Эталон_БайтВБайтКромеОКПО(Описание, ИмяБанка) Экспорт

	Поручения = БогатыйНабор();
	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона(ИмяБанка, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(СтрСоединить(РазличающиесяКлючи(ТекстWindows1251(Результат.Данные), ТекстWindows1251(Эталон)), ","),
		Описание + ": строки, которыми файл отличается от эталона").Равно("CLN_OKPO,RCPT_OKPO");

