// Тесты модуля формата вывода iFOBS doc/ua_payment (СМП_ФорматВыгрузкиiFOBS_TXT; план 07, задача 3).
//
// Эталон - Выгрузить_Бух копий обработок банков (гарнес СМП_ТестыЭталонаВыгрузки.ФайлЭталона): вход эталона строится
// из ТЕХ ЖЕ нормализованных поручений, что получает модуль формата, и файлы сравниваются БАЙТ В БАЙТ (не текст:
// текстовое сравнение пропустило бы BOM, одиночный LF и хвост). Названные отступления плана:
//  - CLN_OKPO/RCPT_OKPO: у Акорда, УкрГаза и Универсала эталон переставляет коды (CLN_OKPO берет код получателя);
//    модуль пишет по смыслу (CLN - наша организация, RCPT - получатель) у всех банков. Для этих трех банков тест
//    утверждает различие РОВНО в двух строках и значения по смыслу. Восток и Райффайзен совпадают байт в байт.
//  - байты формируются в памяти, без временного файла; время - параметр.
//  Отступления 4 нет (рішення планувальника 1): коды с ведущим нулем совпадают байт в байт.
//
// Таблица входа гарнеса обрезает значения длиннее колонки (коды 10, счет 34, МФО 9) молча, поэтому сравнение
// байт-в-байт на таких значениях ничего не доказывает; случаи длиннее колонок идут прямым вызовом модуля с явным
// ожиданием, а тесты называются ПрямойВызов_...
//
// Продукт вызывается только через СМП_ТестыВызовПродукта. Данные выдуманные (СМП_ТЕСТ_...), база не читается.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Формат iFOBS: байт в байт с эталоном")
			.ДобавитьСерверныйТест("Эталон_БайтВБайт")
				.СПараметрами("iFOBS Восток", "БанкВосток")
				.СПараметрами("iFOBS Райффайзен", "РайффайзенБанк");

КонецПроцедуры

#Область БайтВБайт

Процедура Эталон_БайтВБайт(Описание, ИмяБанка) Экспорт

	Поручения = БогатыйНабор();
	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона(ИмяБанка, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(СтрСоединить(РазличающиесяКлючи(ТекстWindows1251(Результат.Данные), ТекстWindows1251(Эталон)), ","),
		Описание + ": строки, которыми файл отличается от эталона").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(Результат.Данные), Описание + ": байты").Равно(Base64Строка(Эталон));

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Вызов продукта с моментом по умолчанию; исключение продукта уходит наверх.
Функция Сформировать(Поручения, Параметры = Неопределено)

	Если Параметры = Неопределено Тогда
		Параметры = НовыеПараметры();
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.Сформировать", ВМассивИз(Поручения, Параметры));

КонецФункции

Функция НовыеПараметры()

	Параметры = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.НовыеПараметры");
	// Вставить, а не присвоение свойства: на заглушке структура пуста, и тест должен краснеть по смыслу, а не по ошибке.
	Параметры.Вставить("Момент", Дата(2026, 10, 15, 13, 45, 30));
	Возврат Параметры;

КонецФункции

// Поручение с различимыми значениями сторон; номер и сумма настраиваются. Данные выдуманные.
Функция Поручение(Номер = "000012", Сумма = 1234567.5)

	Поручение = СМП_ТестыВызовПродукта.Вызвать("СМП_ВыгрузкаПлатежей.НовоеПоручение");
	Поручение.Номер = Номер;
	Поручение.Дата = Дата(2026, 10, 5, 13, 45, 0);
	Поручение.Сумма = Сумма;
	Поручение.НазначениеПлатежа = "Оплата за товар " + Номер;

	Плательщик = Поручение.Плательщик;
	Плательщик.Наименование = "СМП_ТЕСТ_Организация";
	Плательщик.Код = "90000001";
	Плательщик.ВидКода = "ЕДРПОУ";
	Плательщик.НомерСчета = "UA159999910000026000000000001";
	Плательщик.IBAN = Плательщик.НомерСчета;
	Плательщик.Банк = "СМП_ТЕСТ_Банк организации";
	Плательщик.МФО = "999991";
	Плательщик.Город = "СМП_ТЕСТ_Город П";

	Получатель = Поручение.Получатель;
	Получатель.Наименование = "СМП_ТЕСТ_Контрагент";
	Получатель.Код = "90000002";
	Получатель.ВидКода = "ЕДРПОУ";
	Получатель.НомерСчета = "UA229999920000026000000000002";
	Получатель.IBAN = Получатель.НомерСчета;
	Получатель.Банк = "СМП_ТЕСТ_Банк контрагента";
	Получатель.МФО = "999992";
	Получатель.Город = "СМП_ТЕСТ_Город Д";

	Возврат Поручение;

КонецФункции

// Два поручения с разными кодами сторон, ведущими нулями, длинными и спецсимвольными полями. Значения в пределах
// колонок таблицы эталона (коды 10, счет 34, МФО 9).
Функция БогатыйНабор()

	Результат = Новый Массив;
	Результат.Добавить(Поручение("12", 1234567.5));

	Второе = Поручение("13", 100);
	Второе.Дата = Дата(2027, 2, 3, 8, 0, 0);
	Второе.Плательщик.Наименование = "ТОВ " + Символ(171) + "Київ" + Символ(187) + " іїєґ " + Символ(39) + " " + Символ(34) + " = Є";
	Второе.Плательщик.Код = "01234567";
	Второе.Плательщик.НомерСчета = "00026007233566";
	Второе.Плательщик.Банк = Повтор("Банк ", 12);
	Второе.Плательщик.МФО = "044525";
	Второе.Получатель.Наименование = Повтор("Контрагент ", 5);
	Второе.Получатель.Код = "0123456789";
	Второе.Получатель.НомерСчета = "UA159999910000026000000000099";
	Второе.Получатель.Банк = "Банк, де = і ґ";
	Второе.Получатель.МФО = "5";
	Второе.НазначениеПлатежа = "Оплата за рахунок " + Символ(8470) + "5 (ПДВ 20%) - " + Символ(171) + "тест" + Символ(187) + Символ(160) + "ґ " + Повтор("довге ", 30);
	Результат.Добавить(Второе);
	Возврат Результат;

КонецФункции

Функция ВМассивИз(Первое, Второе, Третье = Неопределено)

	Результат = Новый Массив;
	Результат.Добавить(Первое);
	Результат.Добавить(Второе);
	Если Третье <> Неопределено Тогда
		Результат.Добавить(Третье);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Повтор(Символы, Количество)

	Части = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Части.Добавить(Символы);
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

Функция ТекстWindows1251(Байты)

	Возврат ПолучитьСтрокуИзДвоичныхДанных(Байты, "windows-1251");

КонецФункции

// Ключи строк, которыми отличаются два текста (по порядку, без повторов); при разном числе строк - "<число строк>".
Функция РазличающиесяКлючи(ТекстА, ТекстБ)

	СтрокиА = СтрРазделить(ТекстА, Символы.ПС);
	СтрокиБ = СтрРазделить(ТекстБ, Символы.ПС);
	Результат = Новый Массив;
	Если СтрокиА.Количество() <> СтрокиБ.Количество() Тогда
		Результат.Добавить("<число строк>");
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 0 По СтрокиА.ВГраница() Цикл
		Если СтрокиА[Индекс] <> СтрокиБ[Индекс] Тогда
			Позиция = СтрНайти(СтрокиА[Индекс], "=");
			Ключ = ?(Позиция > 0, Лев(СтрокиА[Индекс], Позиция - 1), "<строка " + Индекс + ">");
			Если Результат.Найти(Ключ) = Неопределено Тогда
				Результат.Добавить(Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
