			.ДобавитьСерверныйТест("Описание_РасширениеКакУКопииОбработки")
				.СПараметрами("iFOBS Акорд", "АкордБанк")
				.СПараметрами("iFOBS Восток", "БанкВосток")
				.СПараметрами("iFOBS Райффайзен", "РайффайзенБанк")
				.СПараметрами("iFOBS УкрГаз", "УкрГазБанк")
