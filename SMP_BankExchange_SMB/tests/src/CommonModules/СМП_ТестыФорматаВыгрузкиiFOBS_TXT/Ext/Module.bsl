// Вызов продукта с моментом по умолчанию; исключение продукта уходит наверх.
Функция Сформировать(Поручения, Параметры = Неопределено)

	Если Параметры = Неопределено Тогда
		Параметры = НовыеПараметры();
	КонецЕсли;
	Возврат СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.Сформировать", ВМассивИз(Поручения, Параметры));

КонецФункции

// Текст исключения продукта или Неопределено, если исключения не было.
Функция ТекстИсключения(Поручения, Параметры = Неопределено)

	Текст = Неопределено;
	Попытка
		Сформировать(Поручения, Параметры);
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Текст;

КонецФункции

Функция НовыеПараметры()

	Параметры = СМП_ТестыВызовПродукта.Вызвать("СМП_ФорматВыгрузкиiFOBS_TXT.НовыеПараметры");
	// Вставить, а не присвоение свойства: на заглушке структура пуста, и тест должен краснеть по смыслу, а не по ошибке.
	Параметры.Вставить("Момент", Дата(2026, 10, 15, 13, 45, 30));
	Возврат Параметры;

КонецФункции

// Сравнение байт в байт с эталоном; при расхождении сообщение называет строки, которыми файлы отличаются.
Процедура СравнитьСЭталоном(Описание, ИмяБанка, Поручения)

	Эталон = СМП_ТестыЭталонаВыгрузки.ФайлЭталона(ИмяБанка, Поручения);
	Результат = Сформировать(Поручения);

	ЮТест.ОжидаетЧто(СтрСоединить(РазличающиесяКлючи(ТекстWindows1251(Результат.Данные), ТекстWindows1251(Эталон)), ","),
		Описание + ": строки, которыми файл отличается от эталона").Равно("");
	ЮТест.ОжидаетЧто(Base64Строка(Результат.Данные), Описание + ": байты").Равно(Base64Строка(Эталон));

КонецПроцедуры

