// Записи файла с проверкой, что их не меньше Минимум; недостающие дополняются пустыми соответствиями, чтобы тест,
// читающий Записи[0], краснел утверждением «записей мало», а не ошибкой выхода за границу массива (на заглушке
// продукта файл пуст).
Функция ЗаписиФайла(Байты, Минимум = 1)

	Записи = ЗаписиiFOBS(Байты);
	ЮТест.ОжидаетЧто(Записи.Количество() >= Минимум, "В файле записей не меньше " + Минимум + ", найдено " + Записи.Количество()).ЭтоИстина();
	Пока Записи.Количество() < Минимум Цикл
		Записи.Добавить(Новый Соответствие);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Записи файла iFOBS: Соответствие "ключ -> значение" на запись (17 строк на запись, значение - после первого "=").
Функция ЗаписиiFOBS(Байты)

	Строки = СтрРазделить(СтрЗаменить(ТекстWindows1251(Байты), Символы.ВК, ""), Символы.ПС);
	Результат = Новый Массив;
	Начало = 0;
	Пока Начало + 16 < Строки.Количество() Цикл
		Запись = Новый Соответствие;
		Для Индекс = 2 По 15 Цикл
			Строка = Строки[Начало + Индекс];
			Позиция = СтрНайти(Строка, "=");
			Запись.Вставить(Лев(Строка, Позиция - 1), Сред(Строка, Позиция + 1));
		КонецЦикла;
		Результат.Добавить(Запись);
		Начало = Начало + 17;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключи строк, которыми отличаются два текста (по порядку, без повторов); при разном числе строк - "<число строк>".
Функция РазличающиесяКлючи(ТекстА, ТекстБ)

	СтрокиА = СтрРазделить(ТекстА, Символы.ПС);
	СтрокиБ = СтрРазделить(ТекстБ, Символы.ПС);
	Результат = Новый Массив;
	Если СтрокиА.Количество() <> СтрокиБ.Количество() Тогда
		Результат.Добавить("<число строк>");
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 0 По СтрокиА.ВГраница() Цикл
		Если СтрокиА[Индекс] <> СтрокиБ[Индекс] Тогда
			Позиция = СтрНайти(СтрокиА[Индекс], "=");
			Ключ = ?(Позиция > 0, Лев(СтрокиА[Индекс], Позиция - 1), "<строка " + Индекс + ">");
			Если Результат.Найти(Ключ) = Неопределено Тогда
				Результат.Добавить(Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Снимок значения (структура, массив, примитивы) строкой XML: для сравнения «до и после» и «первый и второй раз».
Функция Снимок(Значение)

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

