// ПС, ВК и Таб не входят в допустимый набор и удаляются: строка PAYMENT_DETAILS не рвется, запись остается 17 строк.
// Значение с управляющим символом кладется в новую переменную и показывается через замену (пастка YaXUnit: сырой
// перевод строки в сообщении утверждения путает отчет).
Процедура Назначение_ПереводыСтрокИТабуляция_УдаляютсяСтрокаНеРвется(Описание, Код) Экспорт

	Управляющие = Новый Соответствие;
	Управляющие.Вставить("ПС", Символы.ПС);
	Управляющие.Вставить("ВК", Символы.ВК);
	Управляющие.Вставить("Таб", Символы.Таб);
	Управляющие.Вставить("ВКПС", Символы.ВК + Символы.ПС);
	Управляющий = Управляющие[Код];
	Поручение = Поручение();
	Поручение.НазначениеПлатежа = "а" + Управляющий + "б";
	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном(Описание, "БанкВосток", Поручения);
	Результат = Сформировать(Поручения);
	Строки = СтрРазделить(СтрЗаменить(ТекстWindows1251(Результат.Данные), Символы.ВК, ""), Символы.ПС);

	// 17 строк записи плюс хвост после последнего CRLF.
	ЮТест.ОжидаетЧто(Строки.Количество(), Описание + ": число строк файла").Равно(18);
	ЮТест.ОжидаетЧто(ЗаписиФайла(Результат.Данные)[0]["PAYMENT_DETAILS"], Описание + ": назначение").Равно("аб");
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), Описание + ": предупреждение об очистке").Равно(1);
	Если Результат.Предупреждения.Количество() = 1 Тогда
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Символы = Управляющий, Описание + ": набор прибранного - сам управляющий символ").ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

