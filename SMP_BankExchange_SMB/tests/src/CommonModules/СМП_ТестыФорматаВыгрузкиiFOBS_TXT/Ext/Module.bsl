	Поручения = ВМассив(Поручение);

	СравнитьСЭталоном("Очистка и срез", "БанкВосток", Поручения);
	Результат = Сформировать(Поручения);
	Значение = ЗаписиФайла(Результат.Данные)[0]["PAYMENT_DETAILS"];

	ЮТест.ОжидаетЧто(Значение, "Назначение").Равно(Повтор("а", 150) + Повтор("б", 10));
	ЮТест.ОжидаетЧто(Результат.Предупреждения.Количество(), "Два предупреждения").Равно(2);
	Если Результат.Предупреждения.Количество() = 2 Тогда
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Действие, "Сначала очистка").Равно("Очищено");
		ЮТест.ОжидаетЧто(Результат.Предупреждения[0].Символы, "Что прибрано").Равно("=");
		ЮТест.ОжидаетЧто(Результат.Предупреждения[1].Действие, "Потом обрезание").Равно("Обрезано");
		ЮТест.ОжидаетЧто(Результат.Предупреждения[1].Предел, "Предел обрезания").Равно(160);
	КонецЕсли;

КонецПроцедуры

