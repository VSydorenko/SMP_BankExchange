// Независимо от эталона: без BOM, CRLF, ни одного голого LF/CR, файл кончается пустой строкой (CRLF CRLF),
// 17 строк на запись.
Процедура Эталон_КонцыСтрокBOMХвост() Экспорт

	Результат = Сформировать(ВМассив(Поручение()));
	Текст = ТекстWindows1251(Результат.Данные);
	Чтение = Новый ЧтениеДанных(Результат.Данные);
	ПервыйБайт = Чтение.ПрочитатьБайт();
	Чтение.Закрыть();

	ЮТест.ОжидаетЧто(ПервыйБайт <> 239, "Первый байт не EF (нет BOM UTF-8)").ЭтоИстина();
	// UTF-8 BOM, прочитанный как windows-1251, выглядит как "п»ї".
	ЮТест.ОжидаетЧто(Лев(Текст, 3) <> Символ(1087) + Символ(187) + Символ(1111), "Нет BOM в начале текста").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Текст, Символы.ПС), "Число LF").Равно(17);
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Текст, Символы.ВК + Символы.ПС), "Число CRLF").Равно(17);
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Текст, Символы.ВК), "Число CR").Равно(17);
	ЮТест.ОжидаетЧто(Прав(Текст, 4) = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС, "Хвост: пустая строка в конце").ЭтоИстина();

КонецПроцедуры

