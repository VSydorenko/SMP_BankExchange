// Минимальная внешняя обработка-читатель для тестов платформы (план 03, задача 5).
// Только функции контракта читателя (docs/architecture/reader-contract.md) и синтетические
// данные: ни одного обращения к объектам конфигурации. Собирается платформой в .epf скриптом build-epf.ps1 и
// кладется двоичным макетом в тестовое расширение.

#Область ПрограммныйИнтерфейс

Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ТестЧитательВнешний");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", "Тестовый внешний читатель");
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "windows-1251");
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	// Одна операция нашего счета; в назначении - то, что платформа передала в параметрах.
	Операция = Выписка.Операции.Добавить();
	Операция.НомерСчета = Параметры.НомерСчета;
	Операция.ДатаОперации = Дата(2024, 1, 2, 3, 4, 5);
	Операция.ДатаДокумента = Дата(2024, 1, 2);
	Операция.Сумма = 12.5;
	Операция.Направление = "Поступило";
	Операция.НазначениеПлатежа = Параметры.НомерСчета + "|" + Параметры.Кодировка;

	Выписка.НачалоПериода = Дата(2024, 1, 1);
	Выписка.КонецПериода = Дата(2024, 1, 31);
	Выписка.ЧтениеПолное = Истина;

КонецПроцедуры

#КонецОбласти
