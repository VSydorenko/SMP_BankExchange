// Конектор API ПриватБанку (Автоклієнт, acp.privatbank.ua): читач за контрактом D28 (план 05а, задача 6, D36).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только с типами платформы и с другими
// воротами (СМП_КоннекторыБанковОбщее, СМП_ЧтениеВыписокОбщее). Базу, метаданные, сеанс, локаль и серверные часы не читает; даты и числа
// форматирует явным форматом; сеть и паузу видит только через Параметры.Транспорт (ВыполнитьЗапрос, Пауза, ТекущийМомент). Исключений наружу
// не бросает: отказ банка классифицирует сам в Выписка.КлассОтказа (D36 п. 8), прочитанное до отказа остается в конверте.
//
// Что читает за одно чтение: /settings (признак регламента банка work_balance), транзакции за период страницами followId, подобовые балансы /balance
// (граница остаточности банка, D36 п. 10; из них же - валюта счета). Поведение предшественника (СМП_РаботаСБанкамиПриватБанкAPIСервер) сохранено в
// полях ключа D17 и в наборе операций; отступы от него - только ухваленные планом 05а:
//  - PR_PR = p дает рядок Предупреждение и сдвигает ГраницуДоверия, PR_PR = n - рядок Предупреждение без документа (предшественник грузил обе);
//  - PR_PR = t с идентификатором оригинала - рядок Ошибка (случай «б», D36 п. 5), с собственным идентификатором - обычная операция своего направления;
//  - операция в валюте, отличной от валюты счета, - рядок Предупреждение, документа нет (отступ 1);
//  - назначение платежа без обрезания (у предшественника Привата его и не было); буквенный код валюты переводит СМП_ЧтениеВыписокОбщее;
//  - идентификатор операции - ID (D36 п. 6); все даты - как в ответе банка (киевское время), момент чтения и границы периода сравниваются в
//    одной шкале через пояс Europe/Kiev;
//  - запрос цельными днями (D36 п. 11, спека d392bc4): от дня НачалоПериода до дня меньшего из КонецПериода и момента чтения транспорта; обе даты
//    банк включает, запаса в день нет; точный период - отбор по дню DAT_OD и времени DATE_TIME_DAT_OD_TIM_P, операции вне периода в днях запроса
//    отбрасываются молча; DAT_KL не используется;
//  - пауза между запросами и пауза по заголовку при 429 (одна повторная попытка, предел паузы ПотолокПаузы).
//
// Чужие счета конектор не отбирает: НомерСчета операции - AUT_MY_ACC как есть, отбирает точка чтения (D30). Сравнивать номер счета по 14 последним
// цифрам здесь нельзя. В запросе acc - 14 последних цифр номера счета (как у предшественника).
//
// Конец чтения - по exist_next_page (D36 п. 11); next_page_id банк отдает и на последней странице. exist_next_page без next_page_id, а также
// next_page_id, который уже был followId в этом чтении, - чтение неполное, «Повторить» (иначе цикл не закончился бы).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок, docs/architecture/reader-contract.md).
//
// Возвращаемое значение:
//  Структура - описание: читач API, идентификаторы операций есть (ID банка), остатков нет.
Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_КоннекторБанкаПриватБанк");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'ПриватБанк (API)'; uk = 'ПриватБанк (API)'"));
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "");
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает выписку в конверт платформы с рабочим размером страницы.
//
// Параметры:
//  Данные - Неопределено - у конектора API данных-файла нет (D36 п. 2).
//  Параметры - Структура - параметры чтения (НомерСчета, НачалоПериода, КонецПериода, УчетныеДанные.Идентификатор и .Токен, Транспорт).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РабочийРазмерСтраницы());

КонецПроцедуры

// Читает выписку с заданным размером страницы (limit). Продукт всегда читает рабочим размером (Прочитать); параметр нужен тесту: запись run1
// снята рекордером с другим limit, а транспорт воспроизведения сверяет запрос с записанным. Шов для тестов: лишь меньший (или равный)
// рабочего лимита; больший - исключение.
//
// Параметры:
//  Параметры - Структура - см. Прочитать.
//  Выписка - Структура - конверт платформы.
//  РазмерСтраницы - Число - limit запроса транзакций; от 1 до рабочего.
Процедура ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РазмерСтраницы) Экспорт

	Если ТипЗнч(РазмерСтраницы) <> Тип("Число") Или РазмерСтраницы < 1 Или РазмерСтраницы > РабочийРазмерСтраницы() Тогда
		ВызватьИсключение НСтр("ru = 'Размер страницы должен быть от 1 до рабочего лимита.'; uk = 'Розмір сторінки має бути від 1 до робочого ліміту.'");
	КонецЕсли;

	Выписка.НачалоПериода = Параметры.НачалоПериода;
	Выписка.КонецПериода = Параметры.КонецПериода;

	Состояние = Новый Структура;
	Состояние.Вставить("Транспорт", Параметры.Транспорт);
	Состояние.Вставить("УчетныеДанные", Параметры.УчетныеДанные);
	Состояние.Вставить("НомерСчета", Параметры.НомерСчета);
	Состояние.Вставить("Записи", Новый Массив);
	Состояние.Вставить("Отказ", Неопределено);
	Состояние.Вставить("БылЗапрос", Ложь);
	Состояние.Вставить("Пауза", ПаузаМеждуЗапросами());
	Состояние.Вставить("МоментUnix", 0);
	Состояние.Вставить("ДеньС", Дата(1, 1, 1));
	Состояние.Вставить("ДеньПо", Дата(1, 1, 1));
	Состояние.Вставить("ГраницаБанка", Неопределено);
	Состояние.Вставить("ВалютаСчета", "");
	Состояние.Вставить("ВалютаНеОпределена", Ложь);

	Если Состояние.Транспорт = Неопределено Или ТипЗнч(Состояние.УчетныеДанные) <> Тип("Структура")
		Или Не Состояние.УчетныеДанные.Свойство("Идентификатор") Или Не Состояние.УчетныеДанные.Свойство("Токен") Тогда
		Отказать(Состояние, "ДействиеЧеловека", НСтр("ru = 'Банк ПриватБанк: не переданы транспорт, идентификатор клиента или токен.';
			|uk = 'Банк ПриватБанк: не передано транспорт, ідентифікатор клієнта або токен.'"));
	Иначе
		ПодготовитьОкно(Состояние, Параметры);
		Если Состояние.Отказ = Неопределено Тогда
			Если ЧтениеБудущегоПериода(Состояние, Параметры, Выписка) Тогда
				Возврат;
			КонецЕсли;
			Если ПрочитатьНастройки(Состояние) Тогда
				ПрочитатьСтраницы(Состояние, Параметры, РазмерСтраницы);
				Если Состояние.Отказ = Неопределено Тогда
					ПрочитатьГраницуБанка(Состояние, Параметры);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Операции читаются и тогда, когда чтение оборвалось: прочитанное лежит в конверте.
	Неостаточные = Новый Массив;
	ОбработатьЗаписи(Состояние, Параметры, Выписка, Неостаточные);

	Если Состояние.Отказ <> Неопределено Тогда
		Выписка.КлассОтказа = Состояние.Отказ.Класс;
		Выписка.ЧтениеПолное = Ложь;
		Выписка.ГраницаДоверия = Параметры.НачалоПериода;
		Для Каждого Текст Из Состояние.Отказ.Тексты Цикл
			ДобавитьДиагностику(Выписка, "Предупреждение", 0, Текст);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Если Состояние.ВалютаНеОпределена Тогда
		ДобавитьДиагностику(Выписка, "Предупреждение", 0, СтрШаблон(
			НСтр("ru = 'Банк %1: валюта счета в ответе балансов не определена, отбор операций по валюте не выполняется.';
				|uk = 'Банк %1: валюту рахунку у відповіді балансів не визначено, відбір операцій за валютою не виконується.'"), НазваниеБанка()));
	КонецЕсли;

	// Граница доверия (D36 п. 10): самая ранняя из КонецПериода, момента чтения, момента первой неостаточной операции и банковской границы; не раньше
	// НачалоПериода.
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Параметры.КонецПериода);
	Кандидаты.Добавить(СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Состояние.МоментUnix));
	Для Каждого Момент Из Неостаточные Цикл
		Кандидаты.Добавить(Момент);
	КонецЦикла;
	Если Состояние.ГраницаБанка <> Неопределено Тогда
		Кандидаты.Добавить(Состояние.ГраницаБанка);
	КонецЕсли;
	Самая = Кандидаты[0];
	Для Каждого Кандидат Из Кандидаты Цикл
		Самая = Мин(Самая, Кандидат);
	КонецЦикла;

	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Макс(Параметры.НачалоПериода, Самая);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НазваниеБанка()

	Возврат "ПриватБанк";

КонецФункции

// Рабочий размер страницы (limit запроса транзакций): рекомендация банка «не больше 100» (privat.txt, параметр limit). Конец чтения - по
// exist_next_page, а не по короткой странице, поэтому ограничения «не больше измеренного максимума страницы» здесь нет (D36 п. 11).
Функция РабочийРазмерСтраницы()

	Возврат 100;

КонецФункции

// Пауза между запросами, секунды. Рекомендация банка: документация ПриватБанка (temp/research/2026-10-13-readers/docs/privat.txt, строка 62):
// «Рекомендовано відправляти запити не частіше 1 запиту в секунду.» Пауза выполняется перед каждым запросом, кроме первого.
Функция ПаузаМеждуЗапросами()

	Возврат 1;

КонецФункции

// Предел паузы по заголовку банка (D36 п. 8, спека a90f7ea), секунды: как у конекторов monobank - 120 с. Банк просит больше - конектор не ждет:
// «Повторить», а диагностика называет запрошенную паузу (иначе один заголовок остановил бы регламент на часы). Документация ПриватБанка 429 и
// заголовок паузы не описывает; поведение конектора здесь синтетическое (записи СинтЛимит429*), как и у monobank.
Функция ПотолокПаузы()

	Возврат 120;

КонецФункции

// Окно чтения (D36 п. 11, спека d392bc4): цельные дни от дня НачалоПериода до дня меньшего из КонецПериода и момента чтения. Транспорт дает момент
// в UTC, а границы периода - киевское время: сравниваются в одной шкале. Часы сервера не читаются.
Процедура ПодготовитьОкно(Состояние, Параметры)

	МоментЧтения = Состояние.Транспорт.ТекущийМомент();
	Если ТипЗнч(МоментЧтения) <> Тип("Дата") Или Не ЗначениеЗаполнено(МоментЧтения) Тогда
		Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
			НСтр("ru = 'Банк %1: транспорт не вернул момент чтения.'; uk = 'Банк %1: транспорт не повернув момент читання.'"), НазваниеБанка()));
		Возврат;
	КонецЕсли;

	Состояние.МоментUnix = МоментЧтения - Дата(1970, 1, 1, 0, 0, 0);
	Конец = Мин(Параметры.КонецПериода, СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Состояние.МоментUnix));
	Состояние.ДеньС = НачалоДня(Параметры.НачалоПериода);
	Состояние.ДеньПо = НачалоДня(Конец);

КонецПроцедуры

// НачалоПериода позже момента чтения (D36 п. 11): запросов нет, конверт пуст, чтение полное, граница доверия - НачалоПериода. Порядок проверок:
// период наоборот (точка чтения) -> эта ветка -> обычное чтение. ЕДИНСТВЕННОЕ место ветки.
Функция ЧтениеБудущегоПериода(Состояние, Параметры, Выписка)

	Если СМП_КоннекторыБанковОбщее.КиевскоеВремяВМоментUnix(Параметры.НачалоПериода) <= Состояние.МоментUnix Тогда
		Возврат Ложь;
	КонецЕсли;
	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Параметры.НачалоПериода;
	Возврат Истина;

КонецФункции

Функция АдресЗапроса(Метод, Состояние, Параметры, Дополнительно)

	Возврат "https://acp.privatbank.ua/api/statements/" + Метод + ?(ПустаяСтрока(Дополнительно), "", "?" + Дополнительно);

КонецФункции

// Часть запроса acc, startDate, endDate: 14 последних цифр счета (как у предшественника) и цельные дни окна.
Функция ЗапросСчетаИДат(Состояние)

	Возврат СтрШаблон("acc=%1&startDate=%2&endDate=%3", Прав(Состояние.НомерСчета, 14),
		Формат(Состояние.ДеньС, "ДФ=dd-MM-yyyy"), Формат(Состояние.ДеньПо, "ДФ=dd-MM-yyyy"));

КонецФункции

// /settings: обязательный первый обмен каждого чтения. work_balance = Y - идет регламент банка, запросы не делать: «Повторить». date_final_statement
// границей доверия не является (D36 п. 10). Возвращает Истина, если читать дальше.
Функция ПрочитатьНастройки(Состояние)

	Тело = ВыполнитьЗапросОбъекта(Состояние, "https://acp.privatbank.ua/api/statements/settings");
	Если Тело = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПроверитьОшибкуВТеле(Состояние, Тело) Тогда
		Возврат Ложь;
	КонецЕсли;
	Настройки = Тело["settings"];
	Если ТипЗнч(Настройки) <> Тип("Соответствие") Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
			НСтр("ru = 'в ответе нет настроек'; uk = 'у відповіді немає налаштувань'"), Состояние.УчетныеДанные));
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(СокрЛП(СтрокаИзJSON(Настройки["work_balance"]))) = "Y" Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
			НСтр("ru = 'идет регламентная работа банка (work_balance = Y), запросы транзакций не выполняются'; uk = 'триває регламентна робота банку (work_balance = Y), запити транзакцій не виконуються'"),
			Состояние.УчетныеДанные));
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Страницы транзакций по followId. Конец - exist_next_page (D36 п. 11). Записи складываются в Состояние.Записи, отказ - в Состояние.Отказ.
Процедура ПрочитатьСтраницы(Состояние, Параметры, РазмерСтраницы)

	Использованные = Новый Соответствие;
	Курсор = "";
	Номер = 0;

	Пока Истина Цикл

		Запрос = СтрШаблон("%1&limit=%2", ЗапросСчетаИДат(Состояние), Формат(РазмерСтраницы, "ЧГ=0"));
		Если Не ПустаяСтрока(Курсор) Тогда
			Запрос = Запрос + "&followId=" + Курсор;
		КонецЕсли;
		Тело = ВыполнитьЗапросОбъекта(Состояние, АдресЗапроса("transactions", Состояние, Параметры, Запрос));
		Если Тело = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ПроверитьОшибкуВТеле(Состояние, Тело) Тогда
			Возврат;
		КонецЕсли;
		Если СтрокаИзJSON(Тело["status"]) <> "SUCCESS" Тогда
			Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
				СтрокаИзJSON(Тело["message"]), Состояние.УчетныеДанные));
			Возврат;
		КонецЕсли;

		Транзакции = Тело["transactions"];
		Если ТипЗнч(Транзакции) = Тип("Массив") Тогда
			Для Каждого Запись Из Транзакции Цикл
				Номер = Номер + 1;
				Состояние.Записи.Добавить(Новый Структура("Номер, Данные", Номер, Запись));
			КонецЦикла;
		КонецЕсли;

		// Конец чтения: exist_next_page <> true. next_page_id на последней странице есть и ничего не значит.
		Если Не (ТипЗнч(Тело["exist_next_page"]) = Тип("Булево") И Тело["exist_next_page"]) Тогда
			Возврат;
		КонецЕсли;

		Курсор = СтрокаИзJSON(Тело["next_page_id"]);
		Если ПустаяСтрока(Курсор) Тогда
			Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
				НСтр("ru = 'есть следующая страница, но банк не дал идентификатор для продолжения; чтение неполное'; uk = 'є наступна сторінка, але банк не дав ідентифікатор для продовження; читання неповне'"),
				Состояние.УчетныеДанные));
			Возврат;
		КонецЕсли;
		Если Использованные[Курсор] <> Неопределено Тогда
			Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
				НСтр("ru = 'идентификатор продолжения не изменился (курсор банка не продвигается); чтение неполное'; uk = 'ідентифікатор продовження не змінився (курсор банку не просувається); читання неповне'"),
				Состояние.УчетныеДанные));
			Возврат;
		КонецЕсли;
		Использованные[Курсор] = Истина;

	КонецЦикла;

КонецПроцедуры

// Банковская граница остаточности (D36 п. 10): начало первого дня окна без is_final_bal = true в /balance (день без рядка - неостаточный; день рядка -
// dpd). Из тех же рядков - валюта счета (рядок currency): нужна отступу 1. Сбой обмена - отказ (D36 п. 8).
Процедура ПрочитатьГраницуБанка(Состояние, Параметры)

	Тело = ВыполнитьЗапросОбъекта(Состояние, АдресЗапроса("balance", Состояние, Параметры, ЗапросСчетаИДат(Состояние)));
	Если Тело = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПроверитьОшибкуВТеле(Состояние, Тело) Тогда
		Возврат;
	КонецЕсли;
	Балансы = Тело["balances"];
	Если ТипЗнч(Балансы) <> Тип("Массив") Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
			НСтр("ru = 'в ответе нет балансов'; uk = 'у відповіді немає балансів'"), Состояние.УчетныеДанные));
		Возврат;
	КонецЕсли;

	Остаточные = Новый Соответствие;
	Валюты = Новый Соответствие;
	Для Каждого Баланс Из Балансы Цикл
		Если ТипЗнч(Баланс) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Валюты[ВРег(СокрЛП(СтрокаИзJSON(Баланс["currency"])))] = Истина;
		День = ДатаВремяИзТекста(СтрокаИзJSON(Баланс["dpd"]));
		Если День = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Формат(День, "ДФ=yyyy-MM-dd");
		// День остаточен, только если остаточны ВСЕ его рядки.
		Было = Остаточные[Ключ];
		Остаточные[Ключ] = (Было = Неопределено Или Было = Истина) И Баланс["is_final_bal"] = Истина;
	КонецЦикла;

	Если Валюты.Количество() = 1 Тогда
		Для Каждого Элемент Из Валюты Цикл
			Состояние.ВалютаСчета = Элемент.Ключ;
		КонецЦикла;
	КонецЕсли;
	// Обмен удался, а валюта счета не определена (нет рядков, пустая или разная): фильтр валюты не применяется, об этом отдельный рядок.
	Состояние.ВалютаНеОпределена = ПустаяСтрока(Состояние.ВалютаСчета);

	День = Состояние.ДеньС;
	Пока День <= Состояние.ДеньПо Цикл
		Если Остаточные[Формат(День, "ДФ=yyyy-MM-dd")] <> Истина Тогда
			Состояние.ГраницаБанка = День;
			Возврат;
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;

КонецПроцедуры

// Тело, в котором банк сообщает status = ERROR (в том числе при HTTP 200): класс по содержанию ответа (D36 п. 8). Автентификация (serviceCode
// CLIENT_AUTH...) и 4xx в code, кроме 408 и 429, - «ДействиеЧеловека»; остальное - «Повторить». Возвращает Истина, если отказ записан.
Функция ПроверитьОшибкуВТеле(Состояние, Тело)

	Если СтрокаИзJSON(Тело["status"]) <> "ERROR" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = СокрЛП(СтрокаИзJSON(Тело["code"]));
	Сервис = СокрЛП(СтрокаИзJSON(Тело["serviceCode"]));
	Класс = "Повторить";
	Если СтрНачинаетсяС(Сервис, "CLIENT_AUTH") Тогда
		Класс = "ДействиеЧеловека";
	ИначеЕсли ЭтоЦелоеЧисло(Код) Тогда
		Число = Число(Код);
		Если Число >= 400 И Число < 500 И Число <> 408 И Число <> 429 Тогда
			Класс = "ДействиеЧеловека";
		КонецЕсли;
	КонецЕсли;
	Отказать(Состояние, Класс, СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200, СтрокаИзJSON(Тело["message"]),
		Состояние.УчетныеДанные));
	Возврат Истина;

КонецФункции

Функция ЭтоЦелоеЧисло(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТолькоЦифры(Текст);

КонецФункции

// GET, ответ которого должен быть JSON-объектом. Пауза перед каждым запросом, кроме первого; одна повторная попытка после 429 (пауза по
// заголовку, предел ПотолокПаузы). Любая отмена - Отказать и Неопределено.
Функция ВыполнитьЗапросОбъекта(Состояние, Адрес)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("id", Состояние.УчетныеДанные.Идентификатор);
	Заголовки.Вставить("token", Состояние.УчетныеДанные.Токен);
	Заголовки.Вставить("Content-Type", "application/json;charset=utf8");

	Ответ = Неопределено;
	Для НомерПопытки = 1 По 2 Цикл
		Если Состояние.БылЗапрос Тогда
			Состояние.Транспорт.Пауза(Состояние.Пауза);
		КонецЕсли;
		Состояние.Пауза = ПаузаМеждуЗапросами();
		Ответ = Состояние.Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки, Неопределено);
		Состояние.БылЗапрос = Истина;
		Если Не Ответ.Сбой И Ответ.Статус = 429 И НомерПопытки = 1 Тогда
			Запрошено = СекундыПаузы(Ответ);
			Если Запрошено > ПотолокПаузы() Тогда
				Отказать(Состояние, "Повторить", СтрШаблон(
					НСтр("ru = 'Банк %1: статус 429 (%4), банк просит паузу %2 с, это больше предела %3 с; ожидание не выполняется, чтение неполное, повторите позже.';
						|uk = 'Банк %1: статус 429 (%4), банк просить паузу %2 с, це більше за межу %3 с; очікування не виконується, читання неповне, повторіть пізніше.'"),
					НазваниеБанка(), Формат(Запрошено, "ЧГ=0"), Формат(ПотолокПаузы(), "ЧГ=0"),
					ОписаниеБанка(СМП_КоннекторыБанковОбщее.ПрочитатьJSONИзТела(Ответ.Тело,
						СМП_КоннекторыБанковОбщее.КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8")))));
				Возврат Неопределено;
			КонецЕсли;
			Состояние.Пауза = Запрошено;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если Ответ.Сбой Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: ответа нет (%2): %3';
				|uk = 'Банк %1: відповіді немає (%2): %3'"),
			НазваниеБанка(), Ответ.ВидСбоя, Ответ.ТекстСбоя));
		Возврат Неопределено;
	КонецЕсли;

	Тело = СМП_КоннекторыБанковОбщее.ПрочитатьJSONИзТела(Ответ.Тело, СМП_КоннекторыБанковОбщее.КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8"));

	Если Ответ.Статус <> 200 Тогда
		Класс = СМП_КоннекторыБанковОбщее.КлассОтказаПоСтатусуHTTP(Ответ.Статус);
		Если Класс = "" Тогда
			Класс = "Повторить";
		КонецЕсли;
		Отказать(Состояние, Класс, СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			ОписаниеБанка(Тело), Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Если Не Тело.Успех Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			Тело.Текст, Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Тело.Значение) <> Тип("Соответствие") Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			НСтр("ru = 'ожидался объект'; uk = 'очікувався об''єкт'"), Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Тело.Значение;

КонецФункции

// Пауза по заголовкам ответа: x-rate-limit-retry-after-seconds, затем retry-after (целое число секунд); иначе 60 секунд. Заголовок, который не
// разобран (в том числе retry-after в виде HTTP-даты), означает паузу конектора по умолчанию - 60 с, а не ошибку.
Функция СекундыПаузы(Ответ)

	Для Каждого Имя Из СтрРазделить("x-rate-limit-retry-after-seconds,retry-after", ",") Цикл
		Значение = Ответ.Заголовки[Имя];
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Секунд = ЦелоеИзJSON(СокрЛП(Значение));
		Если Секунд <> Неопределено И Секунд > 0 Тогда
			Возврат Секунд;
		КонецЕсли;
	КонецЦикла;
	Возврат 60;

КонецФункции

// Описание ошибки банка из тела: message; пусто, если тела нет или оно не объект.
Функция ОписаниеБанка(Тело)

	Если Тело.Успех И ТипЗнч(Тело.Значение) = Тип("Соответствие") Тогда
		Значение = Тело.Значение["message"];
		Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
			Возврат СтрокаИзJSON(Значение);
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

// Первый отказ определяет класс (причина, остановившая чтение или сделавшая его неполным); тексты копятся все.
Процедура Отказать(Состояние, Класс, Текст)

	Если Состояние.Отказ = Неопределено Тогда
		Состояние.Отказ = Новый Структура("Класс, Тексты", Класс, Новый Массив);
	КонецЕсли;
	Состояние.Отказ.Тексты.Добавить(СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(Текст, Состояние.УчетныеДанные));

КонецПроцедуры

// Записи принадлежащие периоду: день DAT_OD и время DATE_TIME_DAT_OD_TIM_P (D36 п. 11, d392bc4). Операции вне НачалоПериода...КонецПериода, но в
// днях запроса, отбрасываются молча; их номера остаются занятыми. Запись, у которой дата не читается, остается (ее разберет обработка записей).
Функция ЗаписиПериода(Состояние, Параметры)

	Результат = Новый Массив;
	Для Каждого Запись Из Состояние.Записи Цикл
		Если ТипЗнч(Запись.Данные) = Тип("Соответствие") Тогда
			Размещение = РазмещениеЗаписи(Запись.Данные);
			Если Размещение <> Неопределено И (Размещение < Параметры.НачалоПериода Или Размещение > Параметры.КонецПериода) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Момент для отбора по периоду: день DAT_OD и время суток DATE_TIME_DAT_OD_TIM_P. Неопределено, если дата или день не читаются.
Функция РазмещениеЗаписи(Данные)

	Момент = ДатаВремяИзТекста(СтрокаИзJSON(Данные["DATE_TIME_DAT_OD_TIM_P"]));
	День = ДатаИзТекста(СтрокаИзJSON(Данные["DAT_OD"]));
	Если Момент = Неопределено Или День = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат День + (Момент - НачалоДня(Момент));

КонецФункции

// Записи -> операции и диагностика. Неостаточные - моменты (DATE_TIME_DAT_OD_TIM_P) операций p для границы доверия.
Процедура ОбработатьЗаписи(Состояние, Параметры, Выписка, Неостаточные)

	Записи = ЗаписиПериода(Состояние, Параметры);
	Тексты = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Тексты[Запись.Номер] = ТекстJSON(Запись.Данные);
	КонецЦикла;

	Пропустить = ДедупликацияПоИдентификатору(Записи, Тексты, Выписка);

	// Остаточные записи (r, t) по ID: запись t с ID оригинала обнаруживается по ним.
	ПоИдентификатору = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Если Не ЭтоСоответствие(Запись) Или Не Остаточная(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = ИдентификаторЗаписи(Запись);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоИдентификатору[Идентификатор];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоИдентификатору[Идентификатор] = Список;
		КонецЕсли;
		Список.Добавить(Запись);
	КонецЦикла;

	Для Каждого Запись Из Записи Цикл

		Номер = Запись.Номер;
		Если Пропустить[Номер] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоСоответствие(Запись) Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, НСтр("ru = 'ПриватБанк: запись выписки не объект JSON.';
				|uk = 'ПриватБанк: запис виписки не є об''єктом JSON.'"));
			Продолжить;
		КонецЕсли;

		Данные = Запись.Данные;
		Идентификатор = ИдентификаторДляДиагностики(Запись);
		Состояние_ = ПС_Состояние(Данные);
		Момент = ДатаВремяИзТекста(СтрокаИзJSON(Данные["DATE_TIME_DAT_OD_TIM_P"]));
		День = ДатаИзТекста(СтрокаИзJSON(Данные["DAT_OD"]));
		Если Момент = Неопределено Или День = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: у операции %1 не читается дата (DATE_TIME_DAT_OD_TIM_P или DAT_OD).';
					|uk = 'ПриватБанк: в операції %1 не читається дата (DATE_TIME_DAT_OD_TIM_P або DAT_OD).'"), Идентификатор));
			Продолжить;
		КонецЕсли;

		ПредупредитьОРазбежностиДней(Выписка, Номер, Идентификатор, День, Момент);

		Если Состояние_ = "p" Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: операция %1 в состоянии %2 еще не проведена и не загружена; граница доверия не позже ее времени.';
					|uk = 'ПриватБанк: операція %1 у стані %2 ще не проведена і не завантажена; межа довіри не пізніше її часу.'"),
				Идентификатор, Состояние_));
			Неостаточные.Добавить(Момент);
			Продолжить;
		ИначеЕсли Состояние_ = "n" Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: операция %1 забракована банком (состояние %2) и не загружена.';
					|uk = 'ПриватБанк: операція %1 забракована банком (стан %2) і не завантажена.'"),
				Идентификатор, Состояние_));
			Продолжить;
		ИначеЕсли Состояние_ = "t" Тогда
			// Случай «б» (D36 п. 5): запись t с ID оригинала - состояние оригинала изменилось, подать ее отдельной операцией нельзя. Случай «а»
			// (свой ID) - обычная операция ниже.
			Совпала = Ложь;
			Если Не ПустаяСтрока(ИдентификаторЗаписи(Запись)) Тогда
				Для Каждого Другая Из ?(ПоИдентификатору[ИдентификаторЗаписи(Запись)] = Неопределено, Новый Массив, ПоИдентификатору[ИдентификаторЗаписи(Запись)]) Цикл
					Если Другая.Номер <> Номер Тогда
						Совпала = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если Совпала Тогда
				ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
					НСтр("ru = 'ПриватБанк: запись %1 (состояние %2) повторяет идентификатор исходной операции: банк изменил состояние переданной операции, отдельного документа возврата нет.';
						|uk = 'ПриватБанк: запис %1 (стан %2) повторює ідентифікатор вихідної операції: банк змінив стан переданої операції, окремого документа повернення немає.'"),
					Идентификатор, Состояние_));
				Продолжить;
			КонецЕсли;
		ИначеЕсли Состояние_ <> "r" Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: операция %1 в неизвестном состоянии %2.';
					|uk = 'ПриватБанк: операція %1 у невідомому стані %2.'"), Идентификатор, Состояние_));
			Продолжить;
		КонецЕсли;

		Направление = СтрокаИзJSON(Данные["TRANTYPE"]);
		Если Направление <> "D" И Направление <> "C" Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: у операции %1 неизвестное направление TRANTYPE %2.';
					|uk = 'ПриватБанк: в операції %1 невідомий напрям TRANTYPE %2.'"), Идентификатор, Направление));
			Продолжить;
		КонецЕсли;

		Сумма = СуммаИзТекста(СтрокаИзJSON(Данные["SUM"]));
		Если Сумма = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: у операции %1 сумма не число.'; uk = 'ПриватБанк: в операції %1 сума не є числом.'"), Идентификатор));
			Продолжить;
		КонецЕсли;

		ТекстВалюты = СтрокаИзJSON(Данные["CCY"]);
		Валюта = ?(ПустаяСтрока(ТекстВалюты), "", СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(ТекстВалюты));
		Если Валюта = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: у операции %1 неизвестный код валюты %2.';
					|uk = 'ПриватБанк: в операції %1 невідомий код валюти %2.'"), Идентификатор, ТекстВалюты));
			Продолжить;
		КонецЕсли;

		Если ЧужаяВалюта(Состояние, Выписка, Номер, ТекстВалюты, Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		Операция = Выписка.Операции.Добавить();
		Операция.ПорядковыйНомер = Номер;
		Операция.НомерСчета = СтрокаИзJSON(Данные["AUT_MY_ACC"]);
		Операция.Валюта = Валюта;
		Операция.ДатаОперации = Момент;
		Операция.НомерДокумента = СтрокаИзJSON(Данные["NUM_DOC"]);
		Операция.ДатаДокумента = НачалоДня(Момент);
		Операция.Сумма = Сумма;
		Операция.Направление = ?(Направление = "D", "Списано", "Поступило");
		Операция.ИдентификаторОперации = ИдентификаторЗаписи(Запись);
		Операция.КонтрагентНаименование = СтрокаИзJSON(Данные["AUT_CNTR_NAM"]);
		Операция.КонтрагентНомерСчета = СтрокаИзJSON(Данные["AUT_CNTR_ACC"]);
		Операция.КонтрагентКод = СтрокаИзJSON(Данные["AUT_CNTR_CRF"]);
		Операция.КонтрагентМФО = СтрокаИзJSON(Данные["AUT_CNTR_MFO"]);
		Операция.НазначениеПлатежа = СокрЛП(СтрокаИзJSON(Данные["OSND"]));
		Операция.СырыеДанные = Тексты[Номер];

	КонецЦикла;

КонецПроцедуры

// Расхождение дней DAT_OD и DATE_TIME_DAT_OD_TIM_P (D36 п. 11): операция остается в периоде по дню DAT_OD, а ДатаОперации и день документа -
// DATE_TIME_DAT_OD_TIM_P как есть (ключ D17), поэтому дата документа может лежать вне запрошенного периода. ЕДИНСТВЕННОЕ место правила.
Процедура ПредупредитьОРазбежностиДней(Выписка, Номер, Идентификатор, ДеньОД, Момент)

	Если ДеньОД = НачалоДня(Момент) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
		НСтр("ru = 'ПриватБанк: операция %1: день DAT_OD (%2) и день DATE_TIME_DAT_OD_TIM_P (%3) различаются. Операция отнесена к периоду по дню DAT_OD, а дата операции и дата документа взяты из DATE_TIME_DAT_OD_TIM_P, поэтому дата документа может лежать вне запрошенного периода.';
			|uk = 'ПриватБанк: операція %1: день DAT_OD (%2) і день DATE_TIME_DAT_OD_TIM_P (%3) різняться. Операцію віднесено до періоду за днем DAT_OD, а дату операції і дату документа взято з DATE_TIME_DAT_OD_TIM_P, тому дата документа може лежати поза запитаним періодом.'"),
		Идентификатор, Формат(ДеньОД, "ДФ=dd.MM.yyyy"), Формат(НачалоДня(Момент), "ДФ=dd.MM.yyyy")));

КонецПроцедуры

// Отступ 1 плана: операция в валюте, отличной от валюты счета, - рядок Предупреждение (рівень, як у точки чтения для чужого счета), документа нет.
// Валюта счета берется из рядков /balance (в Параметрах ее нет). Неизвестна валюта счета - не применяется. ЕДИНСТВЕННОЕ место правила; Истина -
// операция отброшена.
Функция ЧужаяВалюта(Состояние, Выписка, Номер, ТекстВалюты, Идентификатор)

	Код = ВРег(СокрЛП(ТекстВалюты));
	Если ПустаяСтрока(Состояние.ВалютаСчета) Или ПустаяСтрока(Код) Или Код = Состояние.ВалютаСчета Тогда
		Возврат Ложь;
	КонецЕсли;
	ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
		НСтр("ru = 'ПриватБанк: операция %1 в валюте %2, а валюта счета %3: операция не загружена.';
			|uk = 'ПриватБанк: операція %1 у валюті %2, а валюта рахунку %3: операцію не завантажено.'"),
		Идентификатор, Код, Состояние.ВалютаСчета));
	Возврат Истина;

КонецФункции

// Дедупликация внутри одного чтения по ID (повторы страницы). Фильтр состояния - СПЕРШУ, как у предшественника: неостаточная запись в «виденных» не
// остается. Тождественный повтор - один раз; тот же ID с другим содержанием, не пара t, - рядок Ошибка, повтор пропускается.
//
// Возвращаемое значение:
//  Соответствие - номера записей, которые дальше не обрабатываются.
Функция ДедупликацияПоИдентификатору(Записи, Тексты, Выписка)

	Пропустить = Новый Соответствие;
	Виденные = Новый Соответствие;
	ВиденныеНеостаточные = Новый Соответствие;

	Для Каждого Запись Из Записи Цикл
		Если Не ЭтоСоответствие(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = ИдентификаторЗаписи(Запись);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ?(Остаточная(Запись), Виденные, ВиденныеНеостаточные);
		Предыдущая = Таблица[Идентификатор];
		Если Предыдущая = Неопределено Тогда
			Таблица[Идентификатор] = Запись;
		ИначеЕсли Тексты[Предыдущая.Номер] = Тексты[Запись.Номер] Тогда
			Пропустить[Запись.Номер] = Истина;
		ИначеЕсли Таблица = Виденные И Не (ПС_Состояние(Запись.Данные) = "t" Или ПС_Состояние(Предыдущая.Данные) = "t") Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Запись.Номер, СтрШаблон(
				НСтр("ru = 'ПриватБанк: идентификатор %1 повторяется с другим содержанием (конфликтный дубль); повтор пропущен.';
					|uk = 'ПриватБанк: ідентифікатор %1 повторюється з іншим змістом (конфліктний дубль); повтор пропущено.'"),
				Идентификатор));
			Пропустить[Запись.Номер] = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Пропустить;

КонецФункции

Функция ЭтоСоответствие(Запись)

	Возврат ТипЗнч(Запись.Данные) = Тип("Соответствие");

КонецФункции

// Состояние PR_PR; нет значения - «r» (проведена).
Функция ПС_Состояние(Данные)

	Значение = СтрокаИзJSON(Данные["PR_PR"]);
	Возврат ?(Значение = "", "r", Значение);

КонецФункции

Функция Остаточная(Запись)

	Состояние = ПС_Состояние(Запись.Данные);
	Возврат Состояние = "r" Или Состояние = "t";

КонецФункции

// Идентификатор операции - ID (D36 п. 6).
Функция ИдентификаторЗаписи(Запись)

	Возврат СтрокаИзJSON(Запись.Данные["ID"]);

КонецФункции

// Идентификатор для текста диагностики: ID, а если его нет, TECHNICAL_TRANSACTION_ID.
Функция ИдентификаторДляДиагностики(Запись)

	Результат = ИдентификаторЗаписи(Запись);
	Возврат ?(ПустаяСтрока(Результат), СтрокаИзJSON(Запись.Данные["TECHNICAL_TRANSACTION_ID"]), Результат);

КонецФункции

// Дата и время из «дд.мм.гггг чч:мм:сс» (время обязательно); не читается - Неопределено.
Функция ДатаВремяИзТекста(Текст)

	Части = СтрРазделить(СокрЛП(Текст), " ", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	День = ДатаИзТекста(Части[0]);
	Время = СтрРазделить(Части[1], ":");
	Если День = Неопределено Или Время.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Часть Из Время Цикл
		Если Не ЭтоЦелоеЧисло(Часть) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Часы = Число(Время[0]);
	Минуты = Число(Время[1]);
	Секунды = Число(Время[2]);
	Если Часы > 23 Или Минуты > 59 Или Секунды > 59 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат День + Часы * 3600 + Минуты * 60 + Секунды;

КонецФункции

// День из «дд.мм.гггг» (начало суток); не читается - Неопределено.
Функция ДатаИзТекста(Текст)

	Части = СтрРазделить(СокрЛП(Текст), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если Не ЭтоЦелоеЧисло(Часть) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Части[2]) <> 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Д = Число(Части[0]);
	М = Число(Части[1]);
	Г = Число(Части[2]);
	Результат = Неопределено;
	Попытка
		Результат = Дата(Г, М, Д);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если День(Результат) <> Д Или Месяц(Результат) <> М Или Год(Результат) <> Г Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Сумма по модулю из текста (запятая или точка); не число - Неопределено.
Функция СуммаИзТекста(Текст)

	Очищенный = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), ",", ".");
	Если ПустаяСтрока(Очищенный) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Неопределено;
	Попытка
		Результат = Число(Очищенный);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(Результат < 0, -Результат, Результат);

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Целое из значения JSON: число или строка-число; иначе Неопределено.
Функция ЦелоеИзJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Цел(Число(СокрЛП(Значение)));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Строка из значения JSON: нет значения и null - пусто (не слово «Неопределено»); число - без разделителей групп.
Функция СтрокаИзJSON(Значение)

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		// Массив или объект JSON вместо скаляра - пусто, а не представление платформы.
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ДобавитьДиагностику(Выписка, Уровень, Номер, Текст)

	Строка = Выписка.Диагностика.Добавить();
	Строка.Уровень = Уровень;
	Строка.ПорядковыйНомер = Номер;
	Строка.Текст = Текст;

КонецПроцедуры

#КонецОбласти
