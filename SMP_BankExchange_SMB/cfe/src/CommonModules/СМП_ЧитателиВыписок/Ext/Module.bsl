// Реестр читателей выписок и единая точка чтения файла (спека D26, D28, D30, D31).
//
// Модуль намеренно не ссылается на объекты конфигурации (справочники, документы, регистры,
// БСП): только типы платформы и контракт читателя СМП_ВыпискаБанка. Благодаря этому он
// переносится копией в другие конфигурации (D27, D29). Всё конфигурационное - двоичные данные
// обработки из справочника БСП, номера счета организации - готовит вызывающий и передает сюда
// примитивами.
//
// Явная диспетчеризация (D30): каждый формат - ветка Если Формат = "..." в трех служебных
// функциях этого модуля (ОписаниеФормата, ФайлПохожНаФормат, ПрочитатьМодулемФормата) и вызов
// модуля формата по имени в тексте. Имя модуля из строки не собирается ни в каком виде:
// компилятор видит каждый вызов.
//
// Фильтр чужих счетов - один, здесь, для всех читателей, в том числе внешних. Внутри модулей
// форматов его нет. Результат чтения один для встроенного и внешнего читателя (НовыйРезультатЧтения).
//
// Рядом с реестром форматов - реестр конекторов API (D36 п. 4): идентификаторы строк обоих реестров
// живут в одном пространстве (учетная запись хранит один идентификатор, D26), и ПроблемыИдентификаторов
// это проверяет. Конектор читается той же точкой (ВыполнитьЧтение): конверт создает платформа, она же
// проверяет его на границе и отбирает чужие счета; исключение конектора наружу не выходит и становится
// отказом с классом "ДействиеЧеловека" (D36 п. 8).

#Область ПрограммныйИнтерфейс

// Реестр читателей: по строке на банк и формат файла. Данных в базе нет (D30).
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр:
//   * Идентификатор - Строка - постоянный, никогда не переиспользуется (D26).
//   * Банк - Строка - для человека.
//   * ТипФайла - Строка - для человека.
//   * Представление - Строка - "<Банк> - <тип файла>".
//   * КодыБанка - Массив из Строка - МФО.
//   * Формат - Строка - имя модуля формата.
//   * Вариант - Строка - пустая по умолчанию.
//   * РасширенияФайлов - Массив из Строка - из описания формата.
//   * ИмяСтаройОбработки - Строка - подсказка этапа 8 (D23).
Функция РеестрЧитателей() Экспорт

	Реестр = НоваяТаблицаРеестра();

	// Строки добавляют задачи 6-10: по строке на банк и формат.

	// CSV клиент-банка (iFOBS): шесть банков, один модуль формата. Идентификатор строки постоянный
	// (D26): менять и переиспользовать нельзя. КодыБанка - МФО банка: из IBAN нашего счета в образцах (позиции 5-10); довідник НБУ не підключався.
	Формат = "СМП_ЧитательВыпискиiFOBS_CSV";
	ТипФайла = НСтр("ru = 'файл выписки (.csv)'; uk = 'файл виписки (.csv)'");
	ДобавитьСтрокуРеестра(Реестр, "ПроКредит_CSV", НСтр("ru = 'ПроКредит Банк'; uk = 'ПроКредит Банк'"), ТипФайла,
		МФО("320984"), Формат, "СМП_ОбработкаВыпискиБанка_ПроКредитБанк");
	ДобавитьСтрокуРеестра(Реестр, "УкрСиб_CSV", НСтр("ru = 'УкрСиббанк'; uk = 'Укрсиббанк'"), ТипФайла,
		МФО("351005"), Формат, "СМП_ОбработкаВыпискиБанка_УкрСибБанк");
	ДобавитьСтрокуРеестра(Реестр, "Восток_CSV", НСтр("ru = 'Банк Восток'; uk = 'Банк Восток'"), ТипФайла,
		МФО("307123"), Формат, "СМП_ОбработкаВыпискиБанка_БанкВосток");
	ДобавитьСтрокуРеестра(Реестр, "Райффайзен_CSV", НСтр("ru = 'Райффайзен Банк'; uk = 'Райффайзен Банк'"), ТипФайла,
		МФО("380805"), Формат, "СМП_ОбработкаВыпискиБанка_РайффайзенБанк");
	ДобавитьСтрокуРеестра(Реестр, "Универсал_CSV", НСтр("ru = 'Универсал Банк'; uk = 'Універсал Банк'"), ТипФайла,
		МФО("322001"), Формат, "СМП_ОбработкаВыпискиБанка_УниверсалБанк");
	ДобавитьСтрокуРеестра(Реестр, "Акорд_CSV", НСтр("ru = 'Акордбанк'; uk = 'Акордбанк'"), ТипФайла,
		МФО("380634"), Формат, "СМП_ОбработкаВыпискиБанка_АкордБанк");

	// CSV УкрГазБанка: один банк, свой формат (31 колонка, остатки в файле). Наш счет строки - из колонки файла.
	// КодыБанка - МФО из IBAN нашего счета образца; справочник НБУ не подключался.
	ДобавитьСтрокуРеестра(Реестр, "УкрГазБанк_CSV", НСтр("ru = 'УкрГазБанк'; uk = 'Укргазбанк'"), ТипФайла,
		МФО("320478"), "СМП_ЧитательВыпискиУкрГазБанк_CSV", "СМП_ОбработкаВыпискиБанка_УкрГазБанк");

	// CSV Сенс Банка: одна строка реестра, две раскладки файла (юридическое лицо и ФОП) - ветки одного модуля,
	// раскладку выбирает признак файла, а не строка реестра: пользователь выбирает банк, а не раскладку.
	ДобавитьСтрокуРеестра(Реестр, "СенсБанк_CSV", НСтр("ru = 'Сенс Банк'; uk = 'Сенс Банк'"), ТипФайла,
		МФО("300346"), "СМП_ЧитательВыпискиСенсБанк_CSV", "СМП_ОбработкаВыпискиБанка_СенсБанк");

	// ОТП Банк: текст фиксированной ширины (.dat), поколение 1191. Наш счет строки - из полей файла (по направлению).
	// Поколение 660 и DBF/XML ОТП не читаются (D30). КодыБанка - МФО из IBAN нашего счета образца; справочник НБУ не подключался.
	ТипФайлаDAT = НСтр("ru = 'файл выписки (.dat)'; uk = 'файл виписки (.dat)'");
	ДобавитьСтрокуРеестра(Реестр, "ОТП_DAT", НСтр("ru = 'ОТП Банк'; uk = 'ОТП Банк'"), ТипФайлаDAT,
		МФО("300528"), "СМП_ЧитательВыпискиОТП_DAT", "СМП_ОбработкаВыпискиБанка_ОТП");

	// Ощадбанк: DBF (16 и 17 полей, второй - с uetr). Наш счет строки - поле acccli (в обоих поколениях файла это
	// всегда наш счет, направление его не меняет). КодыБанка - МФО из IBAN нашего счета двух образцов (позиции 5-10);
	// они различаются, справочник НБУ не подключался, поэтому код Ощадбанка из памяти не добавлен.
	ДобавитьСтрокуРеестра(Реестр, "Ощад_DBF", НСтр("ru = 'Ощадбанк'; uk = 'Ощадбанк'"),
		НСтр("ru = 'файл выписки (.dbf)'; uk = 'файл виписки (.dbf)'"),
		МФОИзСписка("352457,322669"), "СМП_ЧитательВыпискиОщадБанк_DBF", "СМП_ОбработкаВыпискиБанка_ОщадБанк");

	// Южный банк (Пивденный): XML ROWDATA/ROW, все данные - атрибуты ROW. Наш счет строки - атрибут IBAN (в обоих
	// направлениях); в файле может быть несколько наших счетов (фильтр платформы). КодыБанка - МФО из IBAN нашего счета
	// образца (позиции 5-10); справочник НБУ не подключался. ОТП в XML - не наш формат (D30), строки для него нет.
	ДобавитьСтрокуРеестра(Реестр, "Пивденный_XML", НСтр("ru = 'Южный банк'; uk = 'Південний банк'"),
		НСтр("ru = 'файл выписки (.xml)'; uk = 'файл виписки (.xml)'"),
		МФО("328209"), "СМП_ЧитательВыпискиiFOBS_XML", "СМП_ОбработкаВыпискиБанка_Пивденный");

	Возврат Реестр;

КонецФункции

// Реестр конекторов API (D36 п. 4): по строке на банк API. Идентификатор постоянный, никогда не
// переиспользуется и лежит в одном пространстве с идентификаторами реестра форматов (D26). Данных в
// базе нет. Строки добавляют задачи 4-6 вместе с модулем конектора и веткой диспетчера
// ОписаниеКоннектора / ПрочитатьМодулемКоннектора.
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр:
//   * Идентификатор - Строка - постоянный, никогда не переиспользуется, не совпадает с реестром форматов.
//   * Банк - Строка - для человека.
//   * Представление - Строка - "<Банк> - API".
//   * Модуль - Строка - имя модуля конектора (общий модуль СМП_КоннекторБанка<Банк>).
//   * ПерекрытиеДней - Число, Неопределено - перекрытие чтения в днях (D18 п. 2); значение задает этап 5б.
//   * СоставУчетныхДанных - Массив из Строка - имена обязательных рядковых полей Параметры.УчетныеДанные.
Функция РеестрКоннекторов() Экспорт

	Реестр = НоваяТаблицаРеестраКоннекторов();

	// Строки добавляют задачи 4-6: ПриватБанк, monobank ФОП, monobank юросіб.

	Возврат Реестр;

КонецФункции

// Идентификаторы строк реестра конекторов, которых в нем уже нет. Идентификатор не переиспользуется (D26):
// выведенный не должен совпасть ни с одной строкой обоих реестров.
//
// Возвращаемое значение:
//  Массив из Строка - выведенные идентификаторы.
Функция ВыведенныеИдентификаторыКоннекторов() Экспорт

	Возврат Новый Массив;

КонецФункции

// Проверка общего пространства идентификаторов: идентификаторы реестра форматов и реестра конекторов не
// пусты, не повторяются и не совпадают друг с другом, а выведенный идентификатор не вернулся ни в один
// реестр. Чистая функция: реестры и выведенные идентификаторы получает параметрами, чтобы проверку
// можно было доказать на входе, который она обязана отвергнуть.
//
// Параметры:
//  РеестрФорматов - ТаблицаЗначений - строки с колонкой Идентификатор (см. РеестрЧитателей).
//  РеестрКоннекторов - ТаблицаЗначений - строки с колонкой Идентификатор (см. РеестрКоннекторов).
//  Выведенные - Массив из Строка - выведенные идентификаторы обоих реестров.
//
// Возвращаемое значение:
//  Массив из Строка - тексты проблем; пустой массив - пространство идентификаторов в порядке.
Функция ПроблемыИдентификаторов(РеестрФорматов, РеестрКоннекторов, Выведенные) Экспорт

	Проблемы = Новый Массив;
	Форматы = Новый Соответствие;
	Коннекторы = Новый Соответствие;

	Для Каждого Строка Из РеестрФорматов Цикл
		Идентификатор = Строка.Идентификатор;
		Если ПустаяСтрока(Идентификатор) Тогда
			Проблемы.Добавить(НСтр("ru = 'В реестре форматов есть строка с пустым идентификатором.';
				|uk = 'У реєстрі форматів є рядок з порожнім ідентифікатором.'"));
			Продолжить;
		КонецЕсли;
		Если Форматы[Идентификатор] <> Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Идентификатор ""%1"" повторяется в реестре форматов.';
				|uk = 'Ідентифікатор ""%1"" повторюється в реєстрі форматів.'"), Идентификатор));
		КонецЕсли;
		Форматы[Идентификатор] = Истина;
	КонецЦикла;

	Для Каждого Строка Из РеестрКоннекторов Цикл
		Идентификатор = Строка.Идентификатор;
		Если ПустаяСтрока(Идентификатор) Тогда
			Проблемы.Добавить(НСтр("ru = 'В реестре конекторов есть строка с пустым идентификатором.';
				|uk = 'У реєстрі конекторів є рядок з порожнім ідентифікатором.'"));
			Продолжить;
		КонецЕсли;
		Если Форматы[Идентификатор] <> Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Идентификатор конектора ""%1"" совпадает с идентификатором строки реестра форматов: пространство идентификаторов общее.';
				|uk = 'Ідентифікатор конектора ""%1"" збігається з ідентифікатором рядка реєстру форматів: простір ідентифікаторів спільний.'"), Идентификатор));
		ИначеЕсли Коннекторы[Идентификатор] <> Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Идентификатор ""%1"" повторяется в реестре конекторов.';
				|uk = 'Ідентифікатор ""%1"" повторюється в реєстрі конекторів.'"), Идентификатор));
		КонецЕсли;
		Коннекторы[Идентификатор] = Истина;
	КонецЦикла;

	Для Каждого Идентификатор Из Выведенные Цикл
		Если Форматы[Идентификатор] <> Неопределено Или Коннекторы[Идентификатор] <> Неопределено Тогда
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Выведенный идентификатор ""%1"" снова есть в реестре: идентификатор не переиспользуется.';
				|uk = 'Виведений ідентифікатор ""%1"" знову є в реєстрі: ідентифікатор не перевикористовується.'"), Идентификатор));
		КонецЕсли;
	КонецЦикла;

	Возврат Проблемы;

КонецФункции

// Строка реестра конекторов по идентификатору без исключения: неизвестный или выведенный идентификатор -
// результат с причиной (текст для человека), а не исключение.
//
// Параметры:
//  Реестр - ТаблицаЗначений - реестр конекторов (см. РеестрКоннекторов).
//  Выведенные - Массив из Строка - выведенные идентификаторы.
//  Идентификатор - Строка - идентификатор строки.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Строка - СтрокаТаблицыЗначений, Неопределено - найденная строка.
//   * Отказ - Строка - причина, если строки нет; пустая, если найдена.
Функция НайтиСтрокуКоннектора(Реестр, Выведенные, Идентификатор) Экспорт

	Результат = Новый Структура("Строка, Отказ", Неопределено, "");

	Если Выведенные.Найти(Идентификатор) <> Неопределено Тогда
		Результат.Отказ = СтрШаблон(
			НСтр("ru = 'Строка реестра конекторов ""%1"" выведена из реестра и больше не поддерживается. Выберите другую строку.';
				|uk = 'Рядок реєстру конекторів ""%1"" виведено з реєстру і більше не підтримується. Оберіть інший рядок.'"),
			Идентификатор);
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаРеестра Из Реестр Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Результат.Строка = СтрокаРеестра;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Результат.Отказ = СтрШаблон(
		НСтр("ru = 'Строка реестра конекторов ""%1"" не найдена.';
			|uk = 'Рядок реєстру конекторів ""%1"" не знайдено.'"),
		Идентификатор);
	Возврат Результат;

КонецФункции

// Читает выписку конектором API, найденным в реестре по идентификатору строки (D36). Данные конектору -
// Неопределено; конверт создает платформа, проверяет на границе, отбирает чужие счета. Исключение конектора
// наружу не выходит: неизвестная или выведенная строка, неполные учетные данные и исключение конектора -
// результат с классом отказа и причиной.
//
// Параметры:
//  ИдентификаторСтроки - Строка - Идентификатор строки реестра конекторов.
//  НомераСчета - Массив из Строка - номера нашего счета; первый идет в Параметры.НомерСчета, остальные
//    считаются нашими при отборе чужих счетов.
//  НачалоПериода - Дата - начало периода, киевское местное время.
//  КонецПериода - Дата - конец периода, киевское местное время.
//  УчетныеДанные - Структура - рядковые поля, состав - СоставУчетныхДанных строки реестра.
//  Транспорт - Произвольный - объект с методами ВыполнитьЗапрос, Пауза, ТекущийМомент (D36 п. 1).
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения; класс отказа - Результат.Выписка.КлассОтказа.
Функция ПрочитатьКоннектором(ИдентификаторСтроки, НомераСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт) Экспорт

	Найденная = НайтиСтрокуКоннектора(РеестрКоннекторов(), ВыведенныеИдентификаторыКоннекторов(), ИдентификаторСтроки);
	Если Найденная.Строка = Неопределено Тогда
		Возврат НовыйРезультатОтказаКоннектора(ТекстВМассиве(Найденная.Отказ), НачалоПериода);
	КонецЕсли;
	СтрокаРеестра = Найденная.Строка;

	Описание = Неопределено;
	ТекстИсключенияМодуля = "";
	Попытка
		Описание = ОписаниеКоннектора(СтрокаРеестра.Модуль);
	Исключение
		ТекстИсключенияМодуля = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстИсключенияМодуля) Тогда
		Возврат НовыйРезультатОтказаКоннектора(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Модуль конектора ""%2"" строки реестра ""%1"" завершился с исключением: %3';
				|uk = 'Модуль конектора ""%2"" рядка реєстру ""%1"" завершився з винятком: %3'"),
			ИдентификаторСтроки, СтрокаРеестра.Модуль,
			СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(ТекстИсключенияМодуля, УчетныеДанные))), НачалоПериода);
	КонецЕсли;

	Если Описание = Неопределено Тогда
		Возврат НовыйРезультатОтказаКоннектора(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Модуль конектора ""%2"" строки реестра ""%1"" не поддерживается диспетчером чтения.';
				|uk = 'Модуль конектора ""%2"" рядка реєстру ""%1"" не підтримується диспетчером читання.'"),
			ИдентификаторСтроки, СтрокаРеестра.Модуль)), НачалоПериода);
	КонецЕсли;

	Возврат ЧитатьКоннектор(Неопределено, СтрокаРеестра, Описание, НомераСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт);

КонецФункции

// Читает выписку конектором-объектом: внутренняя точка, через которую идет и чтение по идентификатору
// строки реестра (ПрочитатьКоннектором). Конектор передается значением, как внешний читатель
// (ПрочитатьЧитателем): так тесты читают двойниками конектора, а в продуктовом реестре не нужны ни
// строки-двойники, ни глобальный флаг «тестовый режим». Описание конектора проверяется как описание
// читателя; ошибки не бросают исключение.
//
// Параметры:
//  Коннектор - Произвольный - объект с функциями ОписаниеЧитателя и Прочитать.
//  СтрокаРеестра - Структура, СтрокаТаблицыЗначений - строка реестра конекторов: Идентификатор,
//    Банк, Представление, СоставУчетныхДанных.
//  НомераСчета - Массив из Строка - номера нашего счета; первый идет в Параметры.НомерСчета.
//  НачалоПериода - Дата - начало периода, киевское местное время.
//  КонецПериода - Дата - конец периода, киевское местное время.
//  УчетныеДанные - Структура - рядковые поля, состав - СоставУчетныхДанных строки.
//  Транспорт - Произвольный - объект с методами ВыполнитьЗапрос, Пауза, ТекущийМомент.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения; класс отказа - Результат.Выписка.КлассОтказа.
Функция ПрочитатьОбъектомКоннектора(Коннектор, СтрокаРеестра, НомераСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт) Экспорт

	Если Коннектор = Неопределено Тогда
		Возврат НовыйРезультатОтказаКоннектора(ТекстВМассиве(
			НСтр("ru = 'Конектор не передан.'; uk = 'Конектор не передано.'")), НачалоПериода);
	КонецЕсли;

	Описание = Неопределено;
	ТекстОшибкиОписания = "";
	Попытка
		Описание = Коннектор.ОписаниеЧитателя();
	Исключение
		ТекстОшибкиОписания = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстОшибкиОписания) Тогда
		Возврат НовыйРезультатОтказаКоннектора(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'У конектора нет рабочей функции ОписаниеЧитателя: %1';
				|uk = 'У конектора немає робочої функції ОписаниеЧитателя: %1'"),
			СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(ТекстОшибкиОписания, УчетныеДанные))), НачалоПериода);
	КонецЕсли;

	Ошибки = СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя(Описание);
	Если Ошибки.Количество() > 0 Тогда
		Возврат НовыйРезультатОтказаКоннектора(Ошибки, НачалоПериода);
	КонецЕсли;

	Возврат ЧитатьКоннектор(Коннектор, СтрокаРеестра, Описание, НомераСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт);

КонецФункции

// Идентификаторы строк реестра, которых в нем уже нет. Идентификатор не переиспользуется (D26),
// поэтому выведенный не должен совпасть ни с одной строкой реестра.
//
// Возвращаемое значение:
//  Массив из Строка - выведенные идентификаторы.
Функция ВыведенныеИдентификаторы() Экспорт

	Возврат Новый Массив;

КонецФункции

// Читает файл читателем, найденным в реестре по идентификатору строки. Перед чтением проверяет,
// что файл похож на формат строки реестра (D30). Исключение читателя наружу не выходит.
//
// Параметры:
//  ИдентификаторСтроки - Строка - Идентификатор строки реестра.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета (IBAN и устаревший); первый идет в
//    Параметры.НомерСчета, остальные считаются нашими при отборе чужих счетов.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, НомераСчета) Экспорт

	Если ВыведенныеИдентификаторы().Найти(ИдентификаторСтроки) <> Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Строка реестра читателей ""%1"" выведена из реестра и больше не поддерживается. Выберите другую строку.';
				|uk = 'Рядок реєстру читачів ""%1"" виведено з реєстру і більше не підтримується. Оберіть інший рядок.'"),
			ИдентификаторСтроки)), Новый Массив);
	КонецЕсли;

	СтрокаРеестра = НайтиСтрокуРеестра(ИдентификаторСтроки);
	Если СтрокаРеестра = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Строка реестра читателей ""%1"" не найдена.';
				|uk = 'Рядок реєстру читачів ""%1"" не знайдено.'"),
			ИдентификаторСтроки)), Новый Массив);
	КонецЕсли;

	// Исключение модуля формата - дефект модуля, а не свойство файла: оно не выходит наружу и не
	// трактуется как «файл не похож» (это спрятало бы дефект), а становится ошибкой для администратора.
	Описание = Неопределено;
	ПохожНаФормат = Неопределено;
	ТекстИсключенияМодуля = "";
	Попытка
		Описание = ОписаниеФормата(СтрокаРеестра.Формат);
		Если Описание <> Неопределено Тогда
			ПохожНаФормат = ФайлПохожНаФормат(СтрокаРеестра.Формат, Данные);
		КонецЕсли;
	Исключение
		ТекстИсключенияМодуля = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстИсключенияМодуля) Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Модуль формата ""%2"" строки реестра ""%1"" завершился с исключением: %3';
				|uk = 'Модуль формату ""%2"" рядка реєстру ""%1"" завершився з винятком: %3'"),
			ИдентификаторСтроки, СтрокаРеестра.Формат, ТекстИсключенияМодуля)), Новый Массив);
	КонецЕсли;

	Если Описание = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Формат ""%2"" строки реестра ""%1"" не поддерживается диспетчером чтения.';
				|uk = 'Формат ""%2"" рядка реєстру ""%1"" не підтримується диспетчером читання.'"),
			ИдентификаторСтроки, СтрокаРеестра.Формат)), Новый Массив);
	КонецЕсли;

	// Неопределено от диспетчера - тоже отказ, а не пропуск проверки формата.
	Если ПохожНаФормат <> Истина Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Файл не похож на формат строки реестра ""%1"". Проверьте, что выбрана нужная строка и нужный файл.';
				|uk = 'Файл не схожий на формат рядка реєстру ""%1"". Перевірте, що обрано потрібний рядок і потрібний файл.'"),
			СтрокаРеестра.Представление)), СтрокиРеестраДляФайла(Данные));
	КонецЕсли;

	Возврат ВыполнитьЧтение(Неопределено, СтрокаРеестра.Формат, Описание.Кодировка, Данные, НомераСчета);

КонецФункции

// Читает файл читателем-объектом (внешняя обработка, D31). Описание читателя проверяется
// СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя; при ошибках чтение не вызывается. Содержимое не
// проверяется на соответствие формату: читатель сам отвечает за свой вход.
//
// Параметры:
//  Читатель - Произвольный - объект с функциями ОписаниеЧитателя и Прочитать.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета; первый идет в Параметры.НомерСчета.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьЧитателем(Читатель, Данные, НомераСчета) Экспорт

	Если Читатель = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(
			НСтр("ru = 'Читатель не передан.';
				|uk = 'Читача не передано.'")), Новый Массив);
	КонецЕсли;

	Описание = Неопределено;
	ТекстОшибкиОписания = "";
	Попытка
		Описание = Читатель.ОписаниеЧитателя();
	Исключение
		ТекстОшибкиОписания = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстОшибкиОписания) Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'У читателя нет рабочей функции ОписаниеЧитателя (по контракту читателя она обязательна): %1';
				|uk = 'У читача немає робочої функції ОписаниеЧитателя (за контрактом читача вона обов''язкова): %1'"),
			ТекстОшибкиОписания)), Новый Массив);
	КонецЕсли;

	Ошибки = СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя(Описание);
	Если Ошибки.Количество() > 0 Тогда
		Возврат НовыйРезультатОтказа(Ошибки, Новый Массив);
	КонецЕсли;

	Возврат ВыполнитьЧтение(Читатель, "", Описание.Кодировка, Данные, НомераСчета);

КонецФункции

// Создает объект внешней обработки-читателя из двоичных данных, без исключения наружу.
// Обработка подключается из временного хранилища, файл на диске не создается; безопасный режим
// задает БезопасныйРежимВнешнегоЧитателя.
//
// Параметры:
//  ДвоичныеДанныеОбработки - ДвоичныеДанные - внешняя обработка (.epf).
//
// Возвращаемое значение:
//  Структура - результат:
//   * Читатель - Произвольный, Неопределено - объект обработки или Неопределено.
//   * Ошибки - Массив из Строка - тексты для администратора.
Функция СоздатьВнешнийЧитатель(ДвоичныеДанныеОбработки) Экспорт

	Результат = Новый Структура("Читатель, Ошибки", Неопределено, Новый Массив);

	Если ТипЗнч(ДвоичныеДанныеОбработки) <> Тип("ДвоичныеДанные") Тогда
		Результат.Ошибки.Добавить(
			НСтр("ru = 'Для создания внешнего читателя нужны двоичные данные обработки.';
				|uk = 'Для створення зовнішнього читача потрібні двійкові дані обробки.'"));
		Возврат Результат;
	КонецЕсли;

	Адрес = "";
	Попытка
		Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки, Новый УникальныйИдентификатор);
		Имя = "СМП_ВнешнийЧитатель_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		// Подключенное имя живет до конца сеанса: платформа не умеет его отключать, поэтому имя
		// уникально на вызов, а долгий сеанс (регламентное задание) копит подключения.
		ВнешниеОбработки.Подключить(Адрес, Имя, БезопасныйРежимВнешнегоЧитателя());
		Результат.Читатель = ВнешниеОбработки.Создать(Имя, БезопасныйРежимВнешнегоЧитателя());
	Исключение
		Результат.Читатель = Неопределено;
		Результат.Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Не удалось создать внешний читатель из обработки: %1';
				|uk = 'Не вдалося створити зовнішній читач з обробки: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Если Не ПустаяСтрока(Адрес) Тогда
		Попытка
			УдалитьИзВременногоХранилища(Адрес);
		Исключение
			// Очистка хранилища не должна менять результат создания.
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Идентификаторы строк реестра, чей формат узнал файл (дешевая проверка начала файла).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Массив из Строка - Идентификаторы строк реестра.
Функция СтрокиРеестраДляФайла(Данные) Экспорт

	Результат = Новый Массив;
	Для Каждого СтрокаРеестра Из РеестрЧитателей() Цикл
		Узнан = Ложь;
		Попытка
			Узнан = ФайлПохожНаФормат(СтрокаРеестра.Формат, Данные) = Истина;
		Исключение
			// Проверка формата - подсказка администратору, а не чтение: сбой проверки
			// на чужом файле означает «не узнан».
			Узнан = Ложь;
		КонецПопытки;
		Если Узнан Тогда
			Результат.Добавить(СтрокаРеестра.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Безопасный режим создания внешнего читателя.
// D31; решение архитектора может измениться. Сейчас Ложь: сторонняя обработка может писать
// временный файл, как большинство нынешних обработок. То, что безопасный режим запрещает работу
// с файлами, - утверждение документации, не измерено. Встроенных читателей это не касается.
// Единственное место, где это значение задано.
//
// Возвращаемое значение:
//  Булево - Ложь: без безопасного режима.
Функция БезопасныйРежимВнешнегоЧитателя()

	Возврат Ложь;

КонецФункции

// Единый путь чтения для встроенного читателя файла, внешнего читателя и конектора API: конверт и
// параметры платформы -> вызов Прочитать -> проверка конверта -> отбор чужих счетов -> результат одной
// формы. Для конектора (Подключение задано) добавлено: период, учетные данные и транспорт в параметрах;
// исключение конектора не отбрасывает прочитанное (конверт проверяется как обычно) и становится отказом
// с классом "ДействиеЧеловека" (D36 п. 8); из текстов диагностики вырезаются значения учетных данных.
//
// Параметры:
//  Читатель - Произвольный, Неопределено - объект-читатель; Неопределено - читает модуль (формата или конектора).
//  Формат - Строка - имя модуля формата или конектора (когда Читатель не задан).
//  Кодировка - Строка - кодировка из описания читателя.
//  Данные - ДвоичныеДанные, Неопределено - содержимое выписки; для конектора Неопределено.
//  НомераСчета - Массив из Строка - номера нашего счета.
//  Подключение - Структура, Неопределено - для конектора: НачалоПериода, КонецПериода, УчетныеДанные, Транспорт.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ВыполнитьЧтение(Читатель, Формат, Кодировка, Данные, НомераСчета, Подключение = Неопределено)

	ЭтоКоннектор = Подключение <> Неопределено;
	НачалоПериодаЧтения = ?(ЭтоКоннектор, Подключение.НачалоПериода, Дата(1, 1, 1));

	Нормализованные = Новый Массив;
	Если ТипЗнч(НомераСчета) = Тип("Массив") Тогда
		Для Каждого Номер Из НомераСчета Цикл
			Если ТипЗнч(Номер) = Тип("Строка") И Не ПустаяСтрока(Номер) Тогда
				Нормализованные.Добавить(НормализованныйНомерСчета(Номер));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Нормализованные.Количество() = 0 Тогда
		Тексты = ТекстВМассиве(
			НСтр("ru = 'Не передан ни один номер нашего счета: без него нельзя отделить операции чужих счетов.';
				|uk = 'Не передано жодного номера нашого рахунку: без нього не можна відокремити операції чужих рахунків.'"));
		Если ЭтоКоннектор Тогда
			Возврат НовыйРезультатОтказаКоннектора(Тексты, НачалоПериодаЧтения);
		КонецЕсли;
		Возврат НовыйРезультатОтказа(Тексты, Новый Массив);
	КонецЕсли;

	// Конверт платформы держим отдельно от переменной читателя: параметры передаются по ссылке, и
	// читатель может присвоить Выписке другой объект или Неопределено. Проверка «создано платформой»
	// и результат опираются только на СозданнаяПлатформой.
	СозданнаяПлатформой = СМП_ВыпискаБанка.НоваяВыписка();
	ВыпискаЧитателя = СозданнаяПлатформой;
	Параметры = СМП_ВыпискаБанка.НовыеПараметрыЧтения();
	Параметры.НомерСчета = НомераСчета[ПервыйНепустойИндекс(НомераСчета)];
	Параметры.Кодировка = Кодировка;
	Если ЭтоКоннектор Тогда
		Параметры.НачалоПериода = Подключение.НачалоПериода;
		Параметры.КонецПериода = Подключение.КонецПериода;
		Параметры.УчетныеДанные = Подключение.УчетныеДанные;
		Параметры.Транспорт = Подключение.Транспорт;
	КонецЕсли;

	ТекстИсключения = "";
	Попытка
		Если Читатель <> Неопределено Тогда
			Читатель.Прочитать(Данные, Параметры, ВыпискаЧитателя);
		ИначеЕсли ЭтоКоннектор Тогда
			ПрочитатьМодулемКоннектора(Формат, Данные, Параметры, ВыпискаЧитателя);
		Иначе
			ПрочитатьМодулемФормата(Формат, Данные, Параметры, ВыпискаЧитателя);
		КонецЕсли;
	Исключение
		ТекстИсключения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат = НовыйРезультатЧтения();

	Если Не ПустаяСтрока(ТекстИсключения) И Не ЭтоКоннектор Тогда
		// Упавший посередине читатель не может считаться прочитавшим всё.
		СозданнаяПлатформой.ЧтениеПолное = Ложь;
		Результат.Выписка = СозданнаяПлатформой;
		Результат.ЕстьНевалидныеСтроки = Истина;
		// Замечания, которые читатель успел записать до падения, не теряются: идут перед ошибкой.
		ПеренестиДиагностикуЧитателя(СозданнаяПлатформой, Результат.Диагностика);
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньОшибка(), СтрШаблон(
			НСтр("ru = 'Читатель завершился с исключением: %1';
				|uk = 'Читач завершився з винятком: %1'"),
			ТекстИсключения));
		Возврат Результат;
	КонецЕсли;

	// Конектор, упавший с исключением, проходит ту же проверку: то, что он успел положить в конверт
	// платформы, не теряется (D36 п. 8).
	Проверенная = СМП_ВыпискаБанка.ПроверитьВыписку(ВыпискаЧитателя, СозданнаяПлатформой);

	Результат.Принята = Проверенная.Принята;
	Результат.Операции = Проверенная.Операции;
	Результат.Диагностика = Проверенная.Диагностика;
	Результат.ЕстьНевалидныеСтроки = Проверенная.ЕстьНевалидныеСтроки;
	Результат.Выписка = СозданнаяПлатформой;

	Если Не Результат.Принята Тогда
		// Отклоненный конверт никогда не считается полным для курсора, что бы ни поставил читатель.
		СозданнаяПлатформой.ЧтениеПолное = Ложь;
	Иначе
		// Порядок важен: сначала проверка конверта, потом отбор. Невалидная строка чужого счета уже
		// записана ошибкой и сюда не доходит.
		ОтобратьЧужиеСчета(Результат, Нормализованные);
	КонецЕсли;

	ПрименитьКлассОтказа(Результат, СозданнаяПлатформой, НачалоПериодаЧтения, ТекстИсключения, ЭтоКоннектор);

	Если ЭтоКоннектор Тогда
		УбратьУчетныеДанныеИзДиагностики(Результат.Диагностика, Подключение.УчетныеДанные);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Класс отказа конверта (D36 п. 8, 10): непустой класс делает чтение неполным и ставит границу доверия в
// начало периода, что бы ни поставил читатель; исключение конектора - отказ "ДействиеЧеловека" с рядком
// Предупреждение (прочитанное не потеряно, неполное чтение курсор удерживает). Недопустимое значение
// класса не молчит: оно принимается как "ДействиеЧеловека" с Предупреждением, называющим значение.
//
// Параметры:
//  Результат - Структура - результат чтения (см. НовыйРезультатЧтения).
//  СозданнаяПлатформой - Структура - конверт платформы (Результат.Выписка).
//  НачалоПериода - Дата - начало периода чтения.
//  ТекстИсключения - Строка - текст исключения читателя; пустой, если исключения не было.
//  ЭтоКоннектор - Булево - исключение конектора не бросается наружу и оформляется отказом.
Процедура ПрименитьКлассОтказа(Результат, СозданнаяПлатформой, НачалоПериода, ТекстИсключения, ЭтоКоннектор)

	Класс = СМП_ВыпискаБанка.КлассОтказаНет();
	Если СозданнаяПлатформой.Свойство("КлассОтказа") Тогда
		Класс = СозданнаяПлатформой.КлассОтказа;
	КонецЕсли;

	Если Не СМП_ВыпискаБанка.КлассОтказаДопустим(Класс) Тогда
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньПредупреждение(), СтрШаблон(
			НСтр("ru = 'Читатель вернул недопустимый класс отказа ""%1"": принят класс ""%2"".';
				|uk = 'Читач повернув недопустимий клас відмови ""%1"": прийнято клас ""%2"".'"),
			Лев(Строка(Класс), 50), СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека()));
		Класс = СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека();
	КонецЕсли;

	Если ЭтоКоннектор И Не ПустаяСтрока(ТекстИсключения) Тогда
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньПредупреждение(), СтрШаблон(
			НСтр("ru = 'Конектор завершился с исключением: %1';
				|uk = 'Конектор завершився з винятком: %1'"),
			ТекстИсключения));
		Класс = СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека();
	КонецЕсли;

	СозданнаяПлатформой.КлассОтказа = Класс;
	Если Класс <> СМП_ВыпискаБанка.КлассОтказаНет() Тогда
		СозданнаяПлатформой.ЧтениеПолное = Ложь;
		СозданнаяПлатформой.ГраницаДоверия = НачалоПериода;
	КонецЕсли;

КонецПроцедуры

// Вырезает значения учетных данных из текстов диагностики (D36 п. 3).
//
// Параметры:
//  Диагностика - ТаблицаЗначений - таблица диагностики результата.
//  УчетныеДанные - Структура, Неопределено - учетные данные чтения.
Процедура УбратьУчетныеДанныеИзДиагностики(Диагностика, УчетныеДанные)

	Для Каждого Сообщение Из Диагностика Цикл
		Сообщение.Текст = СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(Сообщение.Текст, УчетныеДанные);
	КонецЦикла;

КонецПроцедуры

// Общая часть чтения конектором: проверка состава учетных данных, затем единый путь чтения.
//
// Параметры:
//  Коннектор - Произвольный, Неопределено - конектор-объект; Неопределено - читает модуль строки реестра.
//  СтрокаРеестра - Структура, СтрокаТаблицыЗначений - строка реестра конекторов.
//  Описание - Структура - проверенное описание конектора.
//  НомераСчета - Массив из Строка - номера нашего счета.
//  НачалоПериода - Дата - начало периода.
//  КонецПериода - Дата - конец периода.
//  УчетныеДанные - Структура - учетные данные.
//  Транспорт - Произвольный - транспорт.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ЧитатьКоннектор(Коннектор, СтрокаРеестра, Описание, НомераСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт)

	Проблемы = ПроблемыСоставаУчетныхДанных(СтрокаРеестра.СоставУчетныхДанных, УчетныеДанные, СтрокаРеестра.Представление);
	Если Проблемы.Количество() > 0 Тогда
		Возврат НовыйРезультатОтказаКоннектора(Проблемы, НачалоПериода);
	КонецЕсли;

	Подключение = Новый Структура;
	Подключение.Вставить("НачалоПериода", НачалоПериода);
	Подключение.Вставить("КонецПериода", КонецПериода);
	Подключение.Вставить("УчетныеДанные", УчетныеДанные);
	Подключение.Вставить("Транспорт", Транспорт);

	ИмяМодуля = "";
	Если Коннектор = Неопределено Тогда
		ИмяМодуля = СтрокаРеестра.Модуль;
	КонецЕсли;
	Возврат ВыполнитьЧтение(Коннектор, ИмяМодуля, Описание.Кодировка, Неопределено, НомераСчета, Подключение);

КонецФункции

// Состав учетных данных конектора: каждое поле состава - непустая строка. Тексты называют поля, но не
// значения учетных данных (D36 п. 3, 8: неполный состав - «действие человека»).
//
// Параметры:
//  Состав - Массив из Строка - имена обязательных полей.
//  УчетныеДанные - Структура, Произвольный - переданные учетные данные.
//  Представление - Строка - название строки реестра для текста.
//
// Возвращаемое значение:
//  Массив из Строка - тексты проблем; пустой массив - состав полный.
Функция ПроблемыСоставаУчетныхДанных(Состав, УчетныеДанные, Представление)

	Проблемы = Новый Массив;
	Если ТипЗнч(Состав) <> Тип("Массив") Или Состав.Количество() = 0 Тогда
		Возврат Проблемы;
	КонецЕсли;

	Если ТипЗнч(УчетныеДанные) <> Тип("Структура") Тогда
		Проблемы.Добавить(СтрШаблон(
			НСтр("ru = 'Для %1 не переданы учетные данные (нужны поля: %2).';
				|uk = 'Для %1 не передано облікові дані (потрібні поля: %2).'"),
			Представление, СтрСоединить(Состав, ", ")));
		Возврат Проблемы;
	КонецЕсли;

	Для Каждого Имя Из Состав Цикл
		Значение = Неопределено;
		Если Не УчетныеДанные.Свойство(Имя, Значение) Или ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
			Проблемы.Добавить(СтрШаблон(
				НСтр("ru = 'Учетные данные для %1: не заполнено поле ""%2"".';
					|uk = 'Облікові дані для %1: не заповнено поле ""%2"".'"),
				Представление, Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Проблемы;

КонецФункции

// Результат отказа конектора до чтения: Принята = Ложь, по "Предупреждение" на каждый текст (отказ -
// факт без потери данных, D36 п. 8), класс "ДействиеЧеловека", чтение неполное, граница доверия -
// начало периода. Не бросает исключение.
//
// Параметры:
//  Тексты - Массив из Строка - тексты для администратора.
//  НачалоПериода - Дата - начало периода чтения.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция НовыйРезультатОтказаКоннектора(Тексты, НачалоПериода)

	Результат = НовыйРезультатЧтения();
	Для Каждого Текст Из Тексты Цикл
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньПредупреждение(), Текст);
	КонецЦикла;
	Результат.Выписка.КлассОтказа = СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека();
	Результат.Выписка.ЧтениеПолное = Ложь;
	Результат.Выписка.ГраницаДоверия = НачалоПериода;
	Возврат Результат;

КонецФункции

// Описание конектора модуля. Диспетчер: ветки добавляют задачи 4-6, по ветке на модуль, с прямым вызовом
// модуля конектора по имени в тексте (имя из строки не собирается).
//
// Параметры:
//  Модуль - Строка - имя модуля конектора.
//
// Возвращаемое значение:
//  Структура, Неопределено - ОписаниеЧитателя модуля или Неопределено, если модуль диспетчеру неизвестен.
Функция ОписаниеКоннектора(Модуль)

	Возврат Неопределено;

КонецФункции

// Чтение модулем конектора. Диспетчер: ветки добавляют задачи 4-6.
//
// Параметры:
//  Модуль - Строка - имя модуля конектора.
//  Данные - ДвоичныеДанные, Неопределено - для конектора Неопределено.
//  Параметры - Структура - параметры чтения (см. СМП_ВыпискаБанка.НовыеПараметрыЧтения).
//  Выписка - Структура - конверт платформы, который заполняет конектор.
Процедура ПрочитатьМодулемКоннектора(Модуль, Данные, Параметры, Выписка)

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Модуль конектора ""%1"" не поддерживается диспетчером чтения.';
			|uk = 'Модуль конектора ""%1"" не підтримується диспетчером читання.'"),
		Модуль);

КонецПроцедуры

// Пустая таблица реестра конекторов со схемой колонок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РеестрКоннекторов.
Функция НоваяТаблицаРеестраКоннекторов()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Идентификатор,Банк,Представление,Модуль,ПерекрытиеДней,СоставУчетныхДанных", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Переносит сообщения, записанные читателем в Выписка.Диагностика, в таблицу диагностики результата
// (колонки Уровень, ПорядковыйНомер, Текст). Дефектная диагностика читателя (не таблица, чужие
// колонки, неверные значения) не должна скрыть само исключение читателя.
//
// Параметры:
//  Выписка - Структура - конверт, который читатель заполнял.
//  Диагностика - ТаблицаЗначений - таблица диагностики результата.
Процедура ПеренестиДиагностикуЧитателя(Выписка, Диагностика)

	Попытка
		Если ТипЗнч(Выписка.Диагностика) <> Тип("ТаблицаЗначений") Тогда
			Возврат;
		КонецЕсли;
		Для Каждого ИмяКолонки Из СтрРазделить("Уровень,ПорядковыйНомер,Текст", ",") Цикл
			Если Выписка.Диагностика.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Сообщение Из Выписка.Диагностика Цикл
			НоваяСтрока = Диагностика.Добавить();
			// Уровень вне контракта приводится к «Ошибка»: так платформа трактует чужой уровень на обычном
			// пути (ПроверитьВыписку), а здесь проверки конверта нет.
			Если Сообщение.Уровень = СМП_ВыпискаБанка.УровеньПредупреждение() Тогда
				НоваяСтрока.Уровень = СМП_ВыпискаБанка.УровеньПредупреждение();
			Иначе
				НоваяСтрока.Уровень = СМП_ВыпискаБанка.УровеньОшибка();
			КонецЕсли;
			НоваяСтрока.ПорядковыйНомер = Сообщение.ПорядковыйНомер;
			НоваяСтрока.Текст = Сообщение.Текст;
		КонецЦикла;
	Исключение
		// Диагностика читателя - вторична: исключение читателя все равно записывается ошибкой.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Убирает из Результат.Операции строки, чей номер счета не совпал ни с одним нашим (без пробелов
// и регистра), и пишет на каждый чужой счет одно предупреждение с номером и числом строк.
// Уровень «Предупреждение»: данные не потеряны, эти операции загружаются из того же файла для
// другого счета. ЕстьНевалидныеСтроки не меняется.
//
// Параметры:
//  Результат - Структура - результат чтения после проверки конверта.
//  Нормализованные - Массив из Строка - наши номера счета в нормализованном виде.
Процедура ОтобратьЧужиеСчета(Результат, Нормализованные)

	Операции = Результат.Операции;
	КоличествоПоСчету = Новый Соответствие;
	ПорядокСчетов = Новый Массив;
	Образцы = Новый Соответствие;
	Удаляемые = Новый Массив;

	Для Индекс = 0 По Операции.Количество() - 1 Цикл
		Номер = Операции[Индекс].НомерСчета;
		Ключ = НормализованныйНомерСчета(Номер);
		Если Нормализованные.Найти(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Удаляемые.Добавить(Индекс);
		Если КоличествоПоСчету[Ключ] = Неопределено Тогда
			КоличествоПоСчету[Ключ] = 0;
			Образцы[Ключ] = СокрЛП(Номер);
			ПорядокСчетов.Добавить(Ключ);
		КонецЕсли;
		КоличествоПоСчету[Ключ] = КоличествоПоСчету[Ключ] + 1;
	КонецЦикла;

	Для Индекс = 0 По Удаляемые.ВГраница() Цикл
		Операции.Удалить(Удаляемые[Удаляемые.ВГраница() - Индекс]);
	КонецЦикла;

	Для Каждого Ключ Из ПорядокСчетов Цикл
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньПредупреждение(), СтрШаблон(
			НСтр("ru = 'Счет %1 в файле не является нашим: %2 строк не загружены из этого чтения. Они загружаются для своего счета из того же файла.';
				|uk = 'Рахунок %1 у файлі не є нашим: %2 рядків не завантажено з цього читання. Вони завантажуються для свого рахунку з того ж файлу.'"),
			Образцы[Ключ], Формат(КоличествоПоСчету[Ключ], "ЧН=0; ЧГ=")));
	КонецЦикла;

КонецПроцедуры

// Номер счета для сравнения: без пробелов (в том числе неразрывных) и без учета регистра.
//
// Параметры:
//  Номер - Строка - номер счета.
//
// Возвращаемое значение:
//  Строка - нормализованный номер.
Функция НормализованныйНомерСчета(Номер)

	Результат = ВРег(Номер);
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Возврат Результат;

КонецФункции

// Индекс первого непустого номера нашего счета (он идет в Параметры.НомерСчета).
//
// Параметры:
//  НомераСчета - Массив из Строка - номера нашего счета; хотя бы один непустой.
//
// Возвращаемое значение:
//  Число - индекс.
Функция ПервыйНепустойИндекс(НомераСчета)

	Для Индекс = 0 По НомераСчета.ВГраница() Цикл
		Если ТипЗнч(НомераСчета[Индекс]) = Тип("Строка") И Не ПустаяСтрока(НомераСчета[Индекс]) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Строка реестра по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор строки реестра.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка реестра или Неопределено.
Функция НайтиСтрокуРеестра(Идентификатор)

	Для Каждого СтрокаРеестра Из РеестрЧитателей() Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание читателя модуля формата. Диспетчер: ветки форматов добавляют задачи 6-10, по ветке
// на формат, с прямым вызовом модуля формата по имени в тексте.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//
// Возвращаемое значение:
//  Структура, Неопределено - ОписаниеЧитателя модуля или Неопределено, если формат диспетчеру неизвестен.
Функция ОписаниеФормата(Формат)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиУкрГазБанк_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиСенсБанк_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		Возврат СМП_ЧитательВыпискиОТП_DAT.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОщадБанк_DBF" Тогда
		Возврат СМП_ЧитательВыпискиОщадБанк_DBF.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиiFOBS_XML" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_XML.ОписаниеЧитателя();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Дешевая проверка начала файла модулем формата. Диспетчер: ветки форматов добавляют задачи 6-10.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево, Неопределено - ФайлПохожНаФормат модуля или Неопределено, если формат диспетчеру неизвестен.
Функция ФайлПохожНаФормат(Формат, Данные)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиУкрГазБанк_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиСенсБанк_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		Возврат СМП_ЧитательВыпискиОТП_DAT.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОщадБанк_DBF" Тогда
		Возврат СМП_ЧитательВыпискиОщадБанк_DBF.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиiFOBS_XML" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_XML.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Чтение модулем формата. Диспетчер: ветки форматов добавляют задачи 6-10.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (см. СМП_ВыпискаБанка.НовыеПараметрыЧтения).
//  Выписка - Структура - конверт платформы, который заполняет модуль формата.
Процедура ПрочитатьМодулемФормата(Формат, Данные, Параметры, Выписка)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		СМП_ЧитательВыпискиiFOBS_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		СМП_ЧитательВыпискиУкрГазБанк_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		СМП_ЧитательВыпискиСенсБанк_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		СМП_ЧитательВыпискиОТП_DAT.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОщадБанк_DBF" Тогда
		СМП_ЧитательВыпискиОщадБанк_DBF.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиiFOBS_XML" Тогда
		СМП_ЧитательВыпискиiFOBS_XML.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Формат ""%1"" не поддерживается диспетчером чтения.';
			|uk = 'Формат ""%1"" не підтримується диспетчером читання.'"),
		Формат);

КонецПроцедуры

// Массив кодов банка (МФО) из строки через запятую.
Функция МФОИзСписка(Коды)

	Возврат СтрРазделить(Коды, ",");

КонецФункции

// Массив из одного кода банка (МФО).
Функция МФО(Код)

	Результат = Новый Массив;
	Результат.Добавить(Код);
	Возврат Результат;

КонецФункции

// Добавляет строку реестра. Расширения файлов берутся из описания модуля формата (источник один).
//
// Параметры:
//  Реестр - ТаблицаЗначений - см. РеестрЧитателей.
//  Идентификатор - Строка - постоянный идентификатор строки.
//  Банк - Строка - название банка для человека.
//  ТипФайла - Строка - тип файла для человека.
//  КодыБанка - Массив из Строка - МФО.
//  Формат - Строка - имя модуля формата.
//  ИмяСтаройОбработки - Строка - имя обработки epf/ (подсказка этапа 8).
//  Вариант - Строка - вариант строки внутри формата.
Процедура ДобавитьСтрокуРеестра(Реестр, Идентификатор, Банк, ТипФайла, КодыБанка, Формат, ИмяСтаройОбработки, Вариант = "")

	Строка = Реестр.Добавить();
	Строка.Идентификатор = Идентификатор;
	Строка.Банк = Банк;
	Строка.ТипФайла = ТипФайла;
	Строка.Представление = СтрШаблон("%1 — %2", Банк, ТипФайла);
	Строка.КодыБанка = КодыБанка;
	Строка.Формат = Формат;
	Строка.Вариант = Вариант;
	Строка.РасширенияФайлов = ОписаниеФормата(Формат).РасширенияФайлов;
	Строка.ИмяСтаройОбработки = ИмяСтаройОбработки;

КонецПроцедуры

// Пустая таблица реестра со схемой колонок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РеестрЧитателей.
Функция НоваяТаблицаРеестра()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Идентификатор,Банк,ТипФайла,Представление,КодыБанка,Формат,Вариант,РасширенияФайлов,ИмяСтаройОбработки", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Результат чтения: результат проверки конверта плюс конверт и подсказки реестра.
//
// Возвращаемое значение:
//  Структура - результат чтения:
//   * Принята - Булево - Ложь, если файл не прочитан или конверт отклонен целиком.
//   * Операции - ТаблицаЗначений - только валидные строки нашего счета (схема НоваяВыписка().Операции).
//   * Диагностика - ТаблицаЗначений - сообщения читателя и платформы.
//   * ЕстьНевалидныеСтроки - Булево - отброшена невалидная строка или читатель записал "Ошибка".
//   * Выписка - Структура - конверт после чтения (период, остатки, ЧтениеПолное).
//   * ПохожиеСтрокиРеестра - Массив из Строка - заполнен, когда файл не узнан.
Функция НовыйРезультатЧтения()

	Выписка = СМП_ВыпискаБанка.НоваяВыписка();

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("Операции", Выписка.Операции);
	Результат.Вставить("Диагностика", Выписка.Диагностика);
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);
	Результат.Вставить("Выписка", Выписка);
	Результат.Вставить("ПохожиеСтрокиРеестра", Новый Массив);
	Возврат Результат;

КонецФункции

// Результат отказа до чтения: Принята = Ложь, по "Ошибка" на каждый текст.
//
// Параметры:
//  Тексты - Массив из Строка - тексты для администратора.
//  ПохожиеСтрокиРеестра - Массив из Строка - подсказки реестра.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция НовыйРезультатОтказа(Тексты, ПохожиеСтрокиРеестра)

	Результат = НовыйРезультатЧтения();
	Результат.ЕстьНевалидныеСтроки = Истина;
	Результат.ПохожиеСтрокиРеестра = ПохожиеСтрокиРеестра;
	Для Каждого Текст Из Тексты Цикл
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньОшибка(), Текст);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дописывает сообщение ко всей выписке (ПорядковыйНомер = 0).
//
// Параметры:
//  Диагностика - ТаблицаЗначений - таблица схемы Диагностика.
//  Уровень - Строка - "Ошибка" или "Предупреждение".
//  Текст - Строка - текст сообщения.
Процедура ДобавитьСообщение(Диагностика, Уровень, Текст)

	Сообщение = Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = 0;
	Сообщение.Текст = Текст;

КонецПроцедуры

// Массив из одной строки.
//
// Параметры:
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  Массив из Строка - массив с одним элементом.
Функция ТекстВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

#КонецОбласти
