// Реестр читателей выписок и единая точка чтения файла (спека D26, D28, D30, D31).
//
// Модуль намеренно не ссылается на объекты конфигурации (справочники, документы, регистры,
// БСП): только типы платформы и контракт читателя СМП_ВыпискаБанка. Благодаря этому он
// переносится копией в другие конфигурации (D27, D29). Всё конфигурационное - двоичные данные
// обработки из справочника БСП, номера счета организации - готовит вызывающий и передает сюда
// примитивами.
//
// Явная диспетчеризация (D30): каждый формат - ветка Если Формат = "..." в трех служебных
// функциях этого модуля и вызов модуля формата по имени в тексте. Имя модуля из строки не
// собирается ни в каком виде: компилятор видит каждый вызов.
//
// Фильтр чужих счетов - один, здесь, для всех читателей, в том числе внешних. Внутри модулей
// форматов его нет.

#Область ПрограммныйИнтерфейс

// Реестр читателей: по строке на банк и формат файла. Данных в базе нет (D30).
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр:
//   * Идентификатор - Строка - постоянный, никогда не переиспользуется (D26).
//   * Банк - Строка - для человека.
//   * ТипФайла - Строка - для человека.
//   * Представление - Строка - "<Банк> - <тип файла>".
//   * КодыБанка - Массив из Строка - МФО.
//   * Формат - Строка - имя модуля формата.
//   * Вариант - Строка - пустая по умолчанию.
//   * РасширенияФайлов - Массив из Строка - из описания формата.
//   * ИмяСтаройОбработки - Строка - подсказка этапа 8 (D23).
Функция РеестрЧитателей() Экспорт

	Реестр = НоваяТаблицаРеестра();

	// Строки добавляют задачи 6-10: по строке на банк и формат.

	Возврат Реестр;

КонецФункции

// Идентификаторы строк реестра, которых в нем уже нет. Идентификатор не переиспользуется (D26),
// поэтому выведенный не должен совпасть ни с одной строкой реестра.
//
// Возвращаемое значение:
//  Массив из Строка - выведенные идентификаторы.
Функция ВыведенныеИдентификаторы() Экспорт

	Возврат Новый Массив;

КонецФункции

// Читает файл читателем, найденным в реестре по идентификатору строки.
//
// Параметры:
//  ИдентификаторСтроки - Строка - Идентификатор строки реестра.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета (IBAN и устаревший); первый идет в
//    Параметры.НомерСчета.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, НомераСчета) Экспорт

	Возврат НовыйРезультатОтказа(СтрокаВМассив("Не реализовано."), Новый Массив);

КонецФункции

// Читает файл читателем-объектом (внешняя обработка, D31). Содержимое не проверяется
// на соответствие формату: читатель сам отвечает за свой вход.
//
// Параметры:
//  Читатель - Произвольный - объект с функциями ОписаниеЧитателя и Прочитать.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета; первый идет в Параметры.НомерСчета.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьЧитателем(Читатель, Данные, НомераСчета) Экспорт

	Возврат НовыйРезультатОтказа(СтрокаВМассив("Не реализовано."), Новый Массив);

КонецФункции

// Создает объект внешней обработки-читателя из двоичных данных, без исключения наружу.
//
// Параметры:
//  ДвоичныеДанныеОбработки - ДвоичныеДанные - внешняя обработка (.epf).
//
// Возвращаемое значение:
//  Структура - результат:
//   * Читатель - Произвольный, Неопределено - объект обработки или Неопределено.
//   * Ошибки - Массив из Строка - тексты для администратора.
Функция СоздатьВнешнийЧитатель(ДвоичныеДанныеОбработки) Экспорт

	Результат = Новый Структура("Читатель, Ошибки", Неопределено, Новый Массив);
	Результат.Ошибки.Добавить("Не реализовано.");
	Возврат Результат;

КонецФункции

// Идентификаторы строк реестра, чей формат узнал файл (дешевая проверка начала файла).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Массив из Строка - Идентификаторы строк реестра.
Функция СтрокиРеестраДляФайла(Данные) Экспорт

	Возврат Новый Массив;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустая таблица реестра со схемой колонок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РеестрЧитателей.
Функция НоваяТаблицаРеестра()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Идентификатор,Банк,ТипФайла,Представление,КодыБанка,Формат,Вариант,РасширенияФайлов,ИмяСтаройОбработки", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Результат чтения: результат проверки конверта плюс конверт и подсказки реестра.
//
// Возвращаемое значение:
//  Структура - результат чтения:
//   * Принята - Булево - Ложь, если файл не прочитан или конверт отклонен целиком.
//   * Операции - ТаблицаЗначений - только валидные строки нашего счета (схема НоваяВыписка().Операции).
//   * Диагностика - ТаблицаЗначений - сообщения читателя и платформы.
//   * ЕстьНевалидныеСтроки - Булево - отброшена невалидная строка или читатель записал "Ошибка".
//   * Выписка - Структура - конверт после чтения (период, остатки, ЧтениеПолное).
//   * ПохожиеСтрокиРеестра - Массив из Строка - заполнен, когда файл не узнан.
Функция НовыйРезультатЧтения()

	Выписка = СМП_ВыпискаБанка.НоваяВыписка();

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("Операции", Выписка.Операции);
	Результат.Вставить("Диагностика", Выписка.Диагностика);
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);
	Результат.Вставить("Выписка", Выписка);
	Результат.Вставить("ПохожиеСтрокиРеестра", Новый Массив);
	Возврат Результат;

КонецФункции

// Результат отказа до чтения или после него: Принята = Ложь, по "Ошибка" на каждый текст.
//
// Параметры:
//  Тексты - Массив из Строка - тексты для администратора.
//  ПохожиеСтрокиРеестра - Массив из Строка - подсказки реестра.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция НовыйРезультатОтказа(Тексты, ПохожиеСтрокиРеестра)

	Результат = НовыйРезультатЧтения();
	Результат.ЕстьНевалидныеСтроки = Истина;
	Результат.ПохожиеСтрокиРеестра = ПохожиеСтрокиРеестра;
	Для Каждого Текст Из Тексты Цикл
		Сообщение = Результат.Диагностика.Добавить();
		Сообщение.Уровень = СМП_ВыпискаБанка.УровеньОшибка();
		Сообщение.ПорядковыйНомер = 0;
		Сообщение.Текст = Текст;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Массив из одной строки.
//
// Параметры:
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  Массив из Строка - массив с одним элементом.
Функция СтрокаВМассив(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

#КонецОбласти
