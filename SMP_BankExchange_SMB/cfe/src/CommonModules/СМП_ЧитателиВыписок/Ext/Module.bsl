// Реестр читателей выписок и единая точка чтения файла (спека D26, D28, D30, D31).
//
// Модуль намеренно не ссылается на объекты конфигурации (справочники, документы, регистры,
// БСП): только типы платформы и контракт читателя СМП_ВыпискаБанка. Благодаря этому он
// переносится копией в другие конфигурации (D27, D29). Всё конфигурационное - двоичные данные
// обработки из справочника БСП, номера счета организации - готовит вызывающий и передает сюда
// примитивами.
//
// Явная диспетчеризация (D30): каждый формат - ветка Если Формат = "..." в трех служебных
// функциях этого модуля (ОписаниеФормата, ФайлПохожНаФормат, ПрочитатьМодулемФормата) и вызов
// модуля формата по имени в тексте. Имя модуля из строки не собирается ни в каком виде:
// компилятор видит каждый вызов.
//
// Фильтр чужих счетов - один, здесь, для всех читателей, в том числе внешних. Внутри модулей
// форматов его нет. Результат чтения один для встроенного и внешнего читателя (НовыйРезультатЧтения).

#Область ПрограммныйИнтерфейс

// Реестр читателей: по строке на банк и формат файла. Данных в базе нет (D30).
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр:
//   * Идентификатор - Строка - постоянный, никогда не переиспользуется (D26).
//   * Банк - Строка - для человека.
//   * ТипФайла - Строка - для человека.
//   * Представление - Строка - "<Банк> - <тип файла>".
//   * КодыБанка - Массив из Строка - МФО.
//   * Формат - Строка - имя модуля формата.
//   * Вариант - Строка - пустая по умолчанию.
//   * РасширенияФайлов - Массив из Строка - из описания формата.
//   * ИмяСтаройОбработки - Строка - подсказка этапа 8 (D23).
Функция РеестрЧитателей() Экспорт

	Реестр = НоваяТаблицаРеестра();

	// Строки добавляют задачи 6-10: по строке на банк и формат.

	// CSV клиент-банка (iFOBS): шесть банков, один модуль формата. Идентификатор строки постоянный
	// (D26): менять и переиспользовать нельзя. КодыБанка - МФО банка: из IBAN нашего счета в образцах (позиции 5-10); довідник НБУ не підключався.
	Формат = "СМП_ЧитательВыпискиiFOBS_CSV";
	ТипФайла = НСтр("ru = 'файл выписки (.csv)'; uk = 'файл виписки (.csv)'");
	ДобавитьСтрокуРеестра(Реестр, "ПроКредит_CSV", НСтр("ru = 'ПроКредит Банк'; uk = 'ПроКредит Банк'"), ТипФайла,
		МФО("320984"), Формат, "СМП_ОбработкаВыпискиБанка_ПроКредитБанк");
	ДобавитьСтрокуРеестра(Реестр, "УкрСиб_CSV", НСтр("ru = 'УкрСиббанк'; uk = 'Укрсиббанк'"), ТипФайла,
		МФО("351005"), Формат, "СМП_ОбработкаВыпискиБанка_УкрСибБанк");
	ДобавитьСтрокуРеестра(Реестр, "Восток_CSV", НСтр("ru = 'Банк Восток'; uk = 'Банк Восток'"), ТипФайла,
		МФО("307123"), Формат, "СМП_ОбработкаВыпискиБанка_БанкВосток");
	ДобавитьСтрокуРеестра(Реестр, "Райффайзен_CSV", НСтр("ru = 'Райффайзен Банк'; uk = 'Райффайзен Банк'"), ТипФайла,
		МФО("380805"), Формат, "СМП_ОбработкаВыпискиБанка_РайффайзенБанк");
	ДобавитьСтрокуРеестра(Реестр, "Универсал_CSV", НСтр("ru = 'Универсал Банк'; uk = 'Універсал Банк'"), ТипФайла,
		МФО("322001"), Формат, "СМП_ОбработкаВыпискиБанка_УниверсалБанк");
	ДобавитьСтрокуРеестра(Реестр, "Акорд_CSV", НСтр("ru = 'Акордбанк'; uk = 'Акордбанк'"), ТипФайла,
		МФО("380634"), Формат, "СМП_ОбработкаВыпискиБанка_АкордБанк");

	// CSV УкрГазБанка: один банк, свой формат (31 колонка, остатки в файле). Наш счет строки - из колонки файла.
	// КодыБанка - МФО из IBAN нашего счета образца; справочник НБУ не подключался.
	ДобавитьСтрокуРеестра(Реестр, "УкрГазБанк_CSV", НСтр("ru = 'УкрГазБанк'; uk = 'Укргазбанк'"), ТипФайла,
		МФО("320478"), "СМП_ЧитательВыпискиУкрГазБанк_CSV", "СМП_ОбработкаВыпискиБанка_УкрГазБанк");

	// CSV Сенс Банка: одна строка реестра, две раскладки файла (юридическое лицо и ФОП) - ветки одного модуля,
	// раскладку выбирает признак файла, а не строка реестра: пользователь выбирает банк, а не раскладку.
	ДобавитьСтрокуРеестра(Реестр, "СенсБанк_CSV", НСтр("ru = 'Сенс Банк'; uk = 'Сенс Банк'"), ТипФайла,
		МФО("300346"), "СМП_ЧитательВыпискиСенсБанк_CSV", "СМП_ОбработкаВыпискиБанка_СенсБанк");

	// ОТП Банк: текст фиксированной ширины (.dat), поколение 1191. Наш счет строки - из полей файла (по направлению).
	// Поколение 660 и DBF/XML ОТП не читаются (D30). КодыБанка - МФО из IBAN нашего счета образца; справочник НБУ не подключался.
	ТипФайлаDAT = НСтр("ru = 'файл выписки (.dat)'; uk = 'файл виписки (.dat)'");
	ДобавитьСтрокуРеестра(Реестр, "ОТП_DAT", НСтр("ru = 'ОТП Банк'; uk = 'ОТП Банк'"), ТипФайлаDAT,
		МФО("300528"), "СМП_ЧитательВыпискиОТП_DAT", "СМП_ОбработкаВыпискиБанка_ОТП");

	Возврат Реестр;

КонецФункции

// Идентификаторы строк реестра, которых в нем уже нет. Идентификатор не переиспользуется (D26),
// поэтому выведенный не должен совпасть ни с одной строкой реестра.
//
// Возвращаемое значение:
//  Массив из Строка - выведенные идентификаторы.
Функция ВыведенныеИдентификаторы() Экспорт

	Возврат Новый Массив;

КонецФункции

// Читает файл читателем, найденным в реестре по идентификатору строки. Перед чтением проверяет,
// что файл похож на формат строки реестра (D30). Исключение читателя наружу не выходит.
//
// Параметры:
//  ИдентификаторСтроки - Строка - Идентификатор строки реестра.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета (IBAN и устаревший); первый идет в
//    Параметры.НомерСчета, остальные считаются нашими при отборе чужих счетов.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьФайл(ИдентификаторСтроки, Данные, НомераСчета) Экспорт

	Если ВыведенныеИдентификаторы().Найти(ИдентификаторСтроки) <> Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Строка реестра читателей ""%1"" выведена из реестра и больше не поддерживается. Выберите другую строку.';
				|uk = 'Рядок реєстру читачів ""%1"" виведено з реєстру і більше не підтримується. Оберіть інший рядок.'"),
			ИдентификаторСтроки)), Новый Массив);
	КонецЕсли;

	СтрокаРеестра = НайтиСтрокуРеестра(ИдентификаторСтроки);
	Если СтрокаРеестра = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Строка реестра читателей ""%1"" не найдена.';
				|uk = 'Рядок реєстру читачів ""%1"" не знайдено.'"),
			ИдентификаторСтроки)), Новый Массив);
	КонецЕсли;

	// Исключение модуля формата - дефект модуля, а не свойство файла: оно не выходит наружу и не
	// трактуется как «файл не похож» (это спрятало бы дефект), а становится ошибкой для администратора.
	Описание = Неопределено;
	ПохожНаФормат = Неопределено;
	ТекстИсключенияМодуля = "";
	Попытка
		Описание = ОписаниеФормата(СтрокаРеестра.Формат);
		Если Описание <> Неопределено Тогда
			ПохожНаФормат = ФайлПохожНаФормат(СтрокаРеестра.Формат, Данные);
		КонецЕсли;
	Исключение
		ТекстИсключенияМодуля = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстИсключенияМодуля) Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Модуль формата ""%2"" строки реестра ""%1"" завершился с исключением: %3';
				|uk = 'Модуль формату ""%2"" рядка реєстру ""%1"" завершився з винятком: %3'"),
			ИдентификаторСтроки, СтрокаРеестра.Формат, ТекстИсключенияМодуля)), Новый Массив);
	КонецЕсли;

	Если Описание = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Формат ""%2"" строки реестра ""%1"" не поддерживается диспетчером чтения.';
				|uk = 'Формат ""%2"" рядка реєстру ""%1"" не підтримується диспетчером читання.'"),
			ИдентификаторСтроки, СтрокаРеестра.Формат)), Новый Массив);
	КонецЕсли;

	Если ПохожНаФормат = Ложь Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'Файл не похож на формат строки реестра ""%1"". Проверьте, что выбрана нужная строка и нужный файл.';
				|uk = 'Файл не схожий на формат рядка реєстру ""%1"". Перевірте, що обрано потрібний рядок і потрібний файл.'"),
			СтрокаРеестра.Представление)), СтрокиРеестраДляФайла(Данные));
	КонецЕсли;

	Возврат ВыполнитьЧтение(Неопределено, СтрокаРеестра.Формат, Описание.Кодировка, Данные, НомераСчета);

КонецФункции

// Читает файл читателем-объектом (внешняя обработка, D31). Описание читателя проверяется
// СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя; при ошибках чтение не вызывается. Содержимое не
// проверяется на соответствие формату: читатель сам отвечает за свой вход.
//
// Параметры:
//  Читатель - Произвольный - объект с функциями ОписаниеЧитателя и Прочитать.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета; первый идет в Параметры.НомерСчета.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ПрочитатьЧитателем(Читатель, Данные, НомераСчета) Экспорт

	Если Читатель = Неопределено Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(
			НСтр("ru = 'Читатель не передан.';
				|uk = 'Читача не передано.'")), Новый Массив);
	КонецЕсли;

	Описание = Неопределено;
	ТекстОшибкиОписания = "";
	Попытка
		Описание = Читатель.ОписаниеЧитателя();
	Исключение
		ТекстОшибкиОписания = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстОшибкиОписания) Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(СтрШаблон(
			НСтр("ru = 'У читателя нет рабочей функции ОписаниеЧитателя (по контракту читателя она обязательна): %1';
				|uk = 'У читача немає робочої функції ОписаниеЧитателя (за контрактом читача вона обов''язкова): %1'"),
			ТекстОшибкиОписания)), Новый Массив);
	КонецЕсли;

	Ошибки = СМП_ВыпискаБанка.ПроверитьОписаниеЧитателя(Описание);
	Если Ошибки.Количество() > 0 Тогда
		Возврат НовыйРезультатОтказа(Ошибки, Новый Массив);
	КонецЕсли;

	Возврат ВыполнитьЧтение(Читатель, "", Описание.Кодировка, Данные, НомераСчета);

КонецФункции

// Создает объект внешней обработки-читателя из двоичных данных, без исключения наружу.
// Обработка подключается из временного хранилища, файл на диске не создается; безопасный режим
// задает БезопасныйРежимВнешнегоЧитателя.
//
// Параметры:
//  ДвоичныеДанныеОбработки - ДвоичныеДанные - внешняя обработка (.epf).
//
// Возвращаемое значение:
//  Структура - результат:
//   * Читатель - Произвольный, Неопределено - объект обработки или Неопределено.
//   * Ошибки - Массив из Строка - тексты для администратора.
Функция СоздатьВнешнийЧитатель(ДвоичныеДанныеОбработки) Экспорт

	Результат = Новый Структура("Читатель, Ошибки", Неопределено, Новый Массив);

	Если ТипЗнч(ДвоичныеДанныеОбработки) <> Тип("ДвоичныеДанные") Тогда
		Результат.Ошибки.Добавить(
			НСтр("ru = 'Для создания внешнего читателя нужны двоичные данные обработки.';
				|uk = 'Для створення зовнішнього читача потрібні двійкові дані обробки.'"));
		Возврат Результат;
	КонецЕсли;

	Адрес = "";
	Попытка
		Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки, Новый УникальныйИдентификатор);
		Имя = "СМП_ВнешнийЧитатель_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
		// Подключенное имя живет до конца сеанса: платформа не умеет его отключать, поэтому имя
		// уникально на вызов, а долгий сеанс (регламентное задание) копит подключения.
		ВнешниеОбработки.Подключить(Адрес, Имя, БезопасныйРежимВнешнегоЧитателя());
		Результат.Читатель = ВнешниеОбработки.Создать(Имя, БезопасныйРежимВнешнегоЧитателя());
	Исключение
		Результат.Читатель = Неопределено;
		Результат.Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Не удалось создать внешний читатель из обработки: %1';
				|uk = 'Не вдалося створити зовнішній читач з обробки: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	Если Не ПустаяСтрока(Адрес) Тогда
		Попытка
			УдалитьИзВременногоХранилища(Адрес);
		Исключение
			// Очистка хранилища не должна менять результат создания.
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Идентификаторы строк реестра, чей формат узнал файл (дешевая проверка начала файла).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Массив из Строка - Идентификаторы строк реестра.
Функция СтрокиРеестраДляФайла(Данные) Экспорт

	Результат = Новый Массив;
	Для Каждого СтрокаРеестра Из РеестрЧитателей() Цикл
		Узнан = Ложь;
		Попытка
			Узнан = ФайлПохожНаФормат(СтрокаРеестра.Формат, Данные) = Истина;
		Исключение
			// Проверка формата - подсказка администратору, а не чтение: сбой проверки
			// на чужом файле означает «не узнан».
			Узнан = Ложь;
		КонецПопытки;
		Если Узнан Тогда
			Результат.Добавить(СтрокаРеестра.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Безопасный режим создания внешнего читателя.
// D31; решение архитектора может измениться. Сейчас Ложь: сторонняя обработка может писать
// временный файл, как большинство нынешних обработок. То, что безопасный режим запрещает работу
// с файлами, - утверждение документации, не измерено. Встроенных читателей это не касается.
// Единственное место, где это значение задано.
//
// Возвращаемое значение:
//  Булево - Ложь: без безопасного режима.
Функция БезопасныйРежимВнешнегоЧитателя()

	Возврат Ложь;

КонецФункции

// Единый путь чтения для встроенного и внешнего читателя: конверт и параметры платформы ->
// вызов Прочитать -> проверка конверта -> отбор чужих счетов -> результат одной формы.
//
// Параметры:
//  Читатель - Произвольный, Неопределено - объект-читатель; Неопределено - читает модуль формата.
//  Формат - Строка - имя модуля формата (когда Читатель не задан).
//  Кодировка - Строка - кодировка из описания читателя.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  НомераСчета - Массив из Строка - номера нашего счета.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция ВыполнитьЧтение(Читатель, Формат, Кодировка, Данные, НомераСчета)

	Нормализованные = Новый Массив;
	Если ТипЗнч(НомераСчета) = Тип("Массив") Тогда
		Для Каждого Номер Из НомераСчета Цикл
			Если ТипЗнч(Номер) = Тип("Строка") И Не ПустаяСтрока(Номер) Тогда
				Нормализованные.Добавить(НормализованныйНомерСчета(Номер));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Нормализованные.Количество() = 0 Тогда
		Возврат НовыйРезультатОтказа(ТекстВМассиве(
			НСтр("ru = 'Не передан ни один номер нашего счета: без него нельзя отделить операции чужих счетов.';
				|uk = 'Не передано жодного номера нашого рахунку: без нього не можна відокремити операції чужих рахунків.'"))
			, Новый Массив);
	КонецЕсли;

	Выписка = СМП_ВыпискаБанка.НоваяВыписка();
	Параметры = СМП_ВыпискаБанка.НовыеПараметрыЧтения();
	Параметры.НомерСчета = НомераСчета[ПервыйНепустойИндекс(НомераСчета)];
	Параметры.Кодировка = Кодировка;

	ТекстИсключения = "";
	Попытка
		Если Читатель = Неопределено Тогда
			ПрочитатьМодулемФормата(Формат, Данные, Параметры, Выписка);
		Иначе
			Читатель.Прочитать(Данные, Параметры, Выписка);
		КонецЕсли;
	Исключение
		ТекстИсключения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Результат = НовыйРезультатЧтения();

	Если Не ПустаяСтрока(ТекстИсключения) Тогда
		// Упавший посередине читатель не может считаться прочитавшим всё.
		Выписка.ЧтениеПолное = Ложь;
		Результат.Выписка = Выписка;
		Результат.ЕстьНевалидныеСтроки = Истина;
		// Замечания, которые читатель успел записать до падения, не теряются: идут перед ошибкой.
		ПеренестиДиагностикуЧитателя(Выписка, Результат.Диагностика);
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньОшибка(), СтрШаблон(
			НСтр("ru = 'Читатель завершился с исключением: %1';
				|uk = 'Читач завершився з винятком: %1'"),
			ТекстИсключения));
		Возврат Результат;
	КонецЕсли;

	Проверенная = СМП_ВыпискаБанка.ПроверитьВыписку(Выписка, Выписка);

	Результат.Принята = Проверенная.Принята;
	Результат.Операции = Проверенная.Операции;
	Результат.Диагностика = Проверенная.Диагностика;
	Результат.ЕстьНевалидныеСтроки = Проверенная.ЕстьНевалидныеСтроки;
	Результат.Выписка = Выписка;

	Если Не Результат.Принята Тогда
		// Отклоненный конверт никогда не считается полным для курсора, что бы ни поставил читатель.
		Выписка.ЧтениеПолное = Ложь;
		Возврат Результат;
	КонецЕсли;

	// Порядок важен: сначала проверка конверта, потом отбор. Невалидная строка чужого счета уже
	// записана ошибкой и сюда не доходит.
	ОтобратьЧужиеСчета(Результат, Нормализованные);

	Возврат Результат;

КонецФункции

// Переносит сообщения, записанные читателем в Выписка.Диагностика, в таблицу диагностики результата
// (колонки Уровень, ПорядковыйНомер, Текст). Дефектная диагностика читателя (не таблица, чужие
// колонки, неверные значения) не должна скрыть само исключение читателя.
//
// Параметры:
//  Выписка - Структура - конверт, который читатель заполнял.
//  Диагностика - ТаблицаЗначений - таблица диагностики результата.
Процедура ПеренестиДиагностикуЧитателя(Выписка, Диагностика)

	Попытка
		Если ТипЗнч(Выписка.Диагностика) <> Тип("ТаблицаЗначений") Тогда
			Возврат;
		КонецЕсли;
		Для Каждого ИмяКолонки Из СтрРазделить("Уровень,ПорядковыйНомер,Текст", ",") Цикл
			Если Выписка.Диагностика.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Сообщение Из Выписка.Диагностика Цикл
			НоваяСтрока = Диагностика.Добавить();
			// Уровень вне контракта приводится к «Ошибка»: так платформа трактует чужой уровень на обычном
			// пути (ПроверитьВыписку), а здесь проверки конверта нет.
			Если Сообщение.Уровень = СМП_ВыпискаБанка.УровеньПредупреждение() Тогда
				НоваяСтрока.Уровень = СМП_ВыпискаБанка.УровеньПредупреждение();
			Иначе
				НоваяСтрока.Уровень = СМП_ВыпискаБанка.УровеньОшибка();
			КонецЕсли;
			НоваяСтрока.ПорядковыйНомер = Сообщение.ПорядковыйНомер;
			НоваяСтрока.Текст = Сообщение.Текст;
		КонецЦикла;
	Исключение
		// Диагностика читателя - вторична: исключение читателя все равно записывается ошибкой.
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Убирает из Результат.Операции строки, чей номер счета не совпал ни с одним нашим (без пробелов
// и регистра), и пишет на каждый чужой счет одно предупреждение с номером и числом строк.
// Уровень «Предупреждение»: данные не потеряны, эти операции загружаются из того же файла для
// другого счета. ЕстьНевалидныеСтроки не меняется.
//
// Параметры:
//  Результат - Структура - результат чтения после проверки конверта.
//  Нормализованные - Массив из Строка - наши номера счета в нормализованном виде.
Процедура ОтобратьЧужиеСчета(Результат, Нормализованные)

	Операции = Результат.Операции;
	КоличествоПоСчету = Новый Соответствие;
	ПорядокСчетов = Новый Массив;
	Образцы = Новый Соответствие;
	Удаляемые = Новый Массив;

	Для Индекс = 0 По Операции.Количество() - 1 Цикл
		Номер = Операции[Индекс].НомерСчета;
		Ключ = НормализованныйНомерСчета(Номер);
		Если Нормализованные.Найти(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Удаляемые.Добавить(Индекс);
		Если КоличествоПоСчету[Ключ] = Неопределено Тогда
			КоличествоПоСчету[Ключ] = 0;
			Образцы[Ключ] = СокрЛП(Номер);
			ПорядокСчетов.Добавить(Ключ);
		КонецЕсли;
		КоличествоПоСчету[Ключ] = КоличествоПоСчету[Ключ] + 1;
	КонецЦикла;

	Для Индекс = 0 По Удаляемые.ВГраница() Цикл
		Операции.Удалить(Удаляемые[Удаляемые.ВГраница() - Индекс]);
	КонецЦикла;

	Для Каждого Ключ Из ПорядокСчетов Цикл
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньПредупреждение(), СтрШаблон(
			НСтр("ru = 'Счет %1 в файле не является нашим: %2 строк не загружены из этого чтения. Они загружаются для своего счета из того же файла.';
				|uk = 'Рахунок %1 у файлі не є нашим: %2 рядків не завантажено з цього читання. Вони завантажуються для свого рахунку з того ж файлу.'"),
			Образцы[Ключ], Формат(КоличествоПоСчету[Ключ], "ЧН=0; ЧГ=")));
	КонецЦикла;

КонецПроцедуры

// Номер счета для сравнения: без пробелов (в том числе неразрывных) и без учета регистра.
//
// Параметры:
//  Номер - Строка - номер счета.
//
// Возвращаемое значение:
//  Строка - нормализованный номер.
Функция НормализованныйНомерСчета(Номер)

	Результат = ВРег(Номер);
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Возврат Результат;

КонецФункции

// Индекс первого непустого номера нашего счета (он идет в Параметры.НомерСчета).
//
// Параметры:
//  НомераСчета - Массив из Строка - номера нашего счета; хотя бы один непустой.
//
// Возвращаемое значение:
//  Число - индекс.
Функция ПервыйНепустойИндекс(НомераСчета)

	Для Индекс = 0 По НомераСчета.ВГраница() Цикл
		Если ТипЗнч(НомераСчета[Индекс]) = Тип("Строка") И Не ПустаяСтрока(НомераСчета[Индекс]) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Строка реестра по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - Идентификатор строки реестра.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка реестра или Неопределено.
Функция НайтиСтрокуРеестра(Идентификатор)

	Для Каждого СтрокаРеестра Из РеестрЧитателей() Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание читателя модуля формата. Диспетчер: ветки форматов добавляют задачи 6-10, по ветке
// на формат, с прямым вызовом модуля формата по имени в тексте.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//
// Возвращаемое значение:
//  Структура, Неопределено - ОписаниеЧитателя модуля или Неопределено, если формат диспетчеру неизвестен.
Функция ОписаниеФормата(Формат)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиУкрГазБанк_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиСенсБанк_CSV.ОписаниеЧитателя();
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		Возврат СМП_ЧитательВыпискиОТП_DAT.ОписаниеЧитателя();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Дешевая проверка начала файла модулем формата. Диспетчер: ветки форматов добавляют задачи 6-10.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево, Неопределено - ФайлПохожНаФормат модуля или Неопределено, если формат диспетчеру неизвестен.
Функция ФайлПохожНаФормат(Формат, Данные)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		Возврат СМП_ЧитательВыпискиiFOBS_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиУкрГазБанк_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		Возврат СМП_ЧитательВыпискиСенсБанк_CSV.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		Возврат СМП_ЧитательВыпискиОТП_DAT.ФайлПохожНаФормат(Данные);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Чтение модулем формата. Диспетчер: ветки форматов добавляют задачи 6-10.
//
// Параметры:
//  Формат - Строка - имя модуля формата.
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (см. СМП_ВыпискаБанка.НовыеПараметрыЧтения).
//  Выписка - Структура - конверт платформы, который заполняет модуль формата.
Процедура ПрочитатьМодулемФормата(Формат, Данные, Параметры, Выписка)

	Если Формат = "СМП_ЧитательВыпискиiFOBS_CSV" Тогда
		СМП_ЧитательВыпискиiFOBS_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиУкрГазБанк_CSV" Тогда
		СМП_ЧитательВыпискиУкрГазБанк_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиСенсБанк_CSV" Тогда
		СМП_ЧитательВыпискиСенсБанк_CSV.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	Если Формат = "СМП_ЧитательВыпискиОТП_DAT" Тогда
		СМП_ЧитательВыпискиОТП_DAT.Прочитать(Данные, Параметры, Выписка);
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Формат ""%1"" не поддерживается диспетчером чтения.';
			|uk = 'Формат ""%1"" не підтримується диспетчером читання.'"),
		Формат);

КонецПроцедуры

// Массив из одного кода банка (МФО).
Функция МФО(Код)

	Результат = Новый Массив;
	Результат.Добавить(Код);
	Возврат Результат;

КонецФункции

// Добавляет строку реестра. Расширения файлов берутся из описания модуля формата (источник один).
//
// Параметры:
//  Реестр - ТаблицаЗначений - см. РеестрЧитателей.
//  Идентификатор - Строка - постоянный идентификатор строки.
//  Банк - Строка - название банка для человека.
//  ТипФайла - Строка - тип файла для человека.
//  КодыБанка - Массив из Строка - МФО.
//  Формат - Строка - имя модуля формата.
//  ИмяСтаройОбработки - Строка - имя обработки epf/ (подсказка этапа 8).
//  Вариант - Строка - вариант строки внутри формата.
Процедура ДобавитьСтрокуРеестра(Реестр, Идентификатор, Банк, ТипФайла, КодыБанка, Формат, ИмяСтаройОбработки, Вариант = "")

	Строка = Реестр.Добавить();
	Строка.Идентификатор = Идентификатор;
	Строка.Банк = Банк;
	Строка.ТипФайла = ТипФайла;
	Строка.Представление = СтрШаблон("%1 — %2", Банк, ТипФайла);
	Строка.КодыБанка = КодыБанка;
	Строка.Формат = Формат;
	Строка.Вариант = Вариант;
	Строка.РасширенияФайлов = ОписаниеФормата(Формат).РасширенияФайлов;
	Строка.ИмяСтаройОбработки = ИмяСтаройОбработки;

КонецПроцедуры

// Пустая таблица реестра со схемой колонок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - см. РеестрЧитателей.
Функция НоваяТаблицаРеестра()

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Идентификатор,Банк,ТипФайла,Представление,КодыБанка,Формат,Вариант,РасширенияФайлов,ИмяСтаройОбработки", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Результат чтения: результат проверки конверта плюс конверт и подсказки реестра.
//
// Возвращаемое значение:
//  Структура - результат чтения:
//   * Принята - Булево - Ложь, если файл не прочитан или конверт отклонен целиком.
//   * Операции - ТаблицаЗначений - только валидные строки нашего счета (схема НоваяВыписка().Операции).
//   * Диагностика - ТаблицаЗначений - сообщения читателя и платформы.
//   * ЕстьНевалидныеСтроки - Булево - отброшена невалидная строка или читатель записал "Ошибка".
//   * Выписка - Структура - конверт после чтения (период, остатки, ЧтениеПолное).
//   * ПохожиеСтрокиРеестра - Массив из Строка - заполнен, когда файл не узнан.
Функция НовыйРезультатЧтения()

	Выписка = СМП_ВыпискаБанка.НоваяВыписка();

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("Операции", Выписка.Операции);
	Результат.Вставить("Диагностика", Выписка.Диагностика);
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);
	Результат.Вставить("Выписка", Выписка);
	Результат.Вставить("ПохожиеСтрокиРеестра", Новый Массив);
	Возврат Результат;

КонецФункции

// Результат отказа до чтения: Принята = Ложь, по "Ошибка" на каждый текст.
//
// Параметры:
//  Тексты - Массив из Строка - тексты для администратора.
//  ПохожиеСтрокиРеестра - Массив из Строка - подсказки реестра.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЧтения.
Функция НовыйРезультатОтказа(Тексты, ПохожиеСтрокиРеестра)

	Результат = НовыйРезультатЧтения();
	Результат.ЕстьНевалидныеСтроки = Истина;
	Результат.ПохожиеСтрокиРеестра = ПохожиеСтрокиРеестра;
	Для Каждого Текст Из Тексты Цикл
		ДобавитьСообщение(Результат.Диагностика, СМП_ВыпискаБанка.УровеньОшибка(), Текст);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дописывает сообщение ко всей выписке (ПорядковыйНомер = 0).
//
// Параметры:
//  Диагностика - ТаблицаЗначений - таблица схемы Диагностика.
//  Уровень - Строка - "Ошибка" или "Предупреждение".
//  Текст - Строка - текст сообщения.
Процедура ДобавитьСообщение(Диагностика, Уровень, Текст)

	Сообщение = Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = 0;
	Сообщение.Текст = Текст;

КонецПроцедуры

// Массив из одной строки.
//
// Параметры:
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  Массив из Строка - массив с одним элементом.
Функция ТекстВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

#КонецОбласти
