// Общие контейнеры и разбор значений для читателей выписок (план 03, этап 2).
//
// Модуль ПЕРЕНОСИМЫЙ: копируется в другие конфигурации, поэтому не обращается к объектам
// конфигурации и к библиотеке стандартных подсистем, даже в комментариях. Справочник валют
// конфигурации здесь тоже не используется: таблица кодов статическая.
// Модуль не знает ни одного банка: ни колонок, ни направлений, ни отборов. Он отдает поля как
// есть, а смысл полей придает модуль формата.
//
// Вывод (план 07) - зеркало чтения: запись DBF в память (ДвоичныеДанныеDBF) пользуется ТЕМИ ЖЕ
// определениями структуры файла (СтруктураDBF), что и чтение, а не второй версией формата; очистка
// назначения платежа и предупреждения вывода общие для модулей форматов вывода.
//
// Символ NUL (код 0) в значении поля (CSV, фиксированная ширина, DBF) заменяется апострофом: в
// образцах он стоит на месте апострофа. Длина значения не меняется, строка не обрезается. В Сырых
// записях NUL остается как в файле.
//
// Принцип разбора значений: нераспознанное значение не становится данными. Функции
// возвращают Неопределено («не разобрано»), а модуль формата пишет в диагностику сырое
// значение. Ни ноль вместо суммы, ни пустая дата вместо даты здесь не возвращаются.

#Область ПрограммныйИнтерфейс

// Разбирает CSV из двоичных данных в записи. Конечный автомат по символам, без временного
// файла: текст берется из двоичных данных в памяти.
//
// Правила:
//  - поле в кавычках может содержать разделитель, перевод строки и удвоенную кавычку (одна
//    кавычка в значении); кавычка не в начале поля - обычный символ;
//  - концы строк CRLF, LF и CR равнозначны; пустые строки вне кавычек пропускаются;
//  - BOM UTF-8 снимает сама платформа при декодировании в utf-8 (измерено), отдельной обработки нет;
//  - символ NUL (код 0) внутри поля заменяется апострофом, строка не обрезается;
//  - конец данных внутри кавычек - исключение «незакрытая кавычка, запись начинается в строке N»
//    (физическая строка начала записи): иначе остаток файла молча стал бы последним полем и
//    поглотил бы следующие строки. Для срезов начала файла (дешевые проверки формата) есть
//    ДопуститьОбрыв: срез законно рвет запись, у которой все поля в кавычках, и оборванная запись
//    просто отбрасывается.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла.
//  Кодировка - Строка - "windows-1251", "utf-8" и т.п.
//  Разделитель - Строка - один символ, кроме кавычки, CR и LF (иначе исключение).
//  ДопуститьОбрыв - Булево - Истина: оборванная кавычкой последняя запись отбрасывается без исключения
//    (только для срезов начала файла); Ложь (по умолчанию) - исключение.
//
// Возвращаемое значение:
//  Массив из Структура - записи:
//   * НомерВИсточнике - Число - номер физической строки файла, с единицы; для записи с переносом
//                       строки в кавычках - номер первой строки записи;
//   * Поля - Массив из Строка - значения полей по порядку (завершающий разделитель дает
//            лишнее пустое поле);
//   * Сырые - Строка - запись как в файле, без завершающего перевода строки.
Функция ЗаписиCSV(Данные, Кодировка, Разделитель, ДопуститьОбрыв = Ложь) Экспорт

	Если ТипЗнч(Разделитель) <> Тип("Строка") Или СтрДлина(Разделитель) <> 1 Тогда
		ВызватьИсключение "Разделитель CSV должен быть одним символом.";
	КонецЕсли;
	// Кавычка, CR и LF - служебные символы автомата: как разделитель они ломали бы разбор молча.
	Если КодСимвола(Разделитель) = 34 Или КодСимвола(Разделитель) = 13 Или КодСимвола(Разделитель) = 10 Тогда
		ВызватьИсключение "Разделитель CSV не может быть кавычкой, возвратом каретки или переводом строки.";
	КонецЕсли;

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, Кодировка);

	КодРазделителя = КодСимвола(Разделитель);
	Длина = СтрДлина(Текст);
	Записи = Новый Массив;

	Позиция = 1;
	НомерСтроки = 1;
	Пока Позиция <= Длина Цикл

		НачалоЗаписи = Позиция;
		НомерЗаписи = НомерСтроки;
		Поля = Новый Массив;
		Поле = "";
		НачалоПоля = Истина;
		ВКавычках = Ложь;
		КонецЗаписи = 0;

		Пока Позиция <= Длина Цикл

			Код = КодСимвола(Текст, Позиция);

			Если ВКавычках Тогда
				Если Код = 34 Тогда
					Если Позиция < Длина И КодСимвола(Текст, Позиция + 1) = 34 Тогда
						Поле = Поле + """";
						Позиция = Позиция + 2;
					Иначе
						ВКавычках = Ложь;
						Позиция = Позиция + 1;
					КонецЕсли;
				ИначеЕсли Код = 13 Тогда
					Поле = Поле + Символы.ВК;
					Если Позиция < Длина И КодСимвола(Текст, Позиция + 1) = 10 Тогда
						Поле = Поле + Символы.ПС;
						Позиция = Позиция + 1;
					КонецЕсли;
					НомерСтроки = НомерСтроки + 1;
					Позиция = Позиция + 1;
				ИначеЕсли Код = 10 Тогда
					Поле = Поле + Символы.ПС;
					НомерСтроки = НомерСтроки + 1;
					Позиция = Позиция + 1;
				Иначе
					Поле = Поле + СимволПоля(Текст, Позиция, Код);
					Позиция = Позиция + 1;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Если Код = 34 И НачалоПоля Тогда
				ВКавычках = Истина;
				НачалоПоля = Ложь;
				Позиция = Позиция + 1;
			ИначеЕсли Код = КодРазделителя Тогда
				Поля.Добавить(Поле);
				Поле = "";
				НачалоПоля = Истина;
				Позиция = Позиция + 1;
			ИначеЕсли Код = 13 Или Код = 10 Тогда
				КонецЗаписи = Позиция;
				Позиция = Позиция + 1;
				Если Код = 13 И Позиция <= Длина И КодСимвола(Текст, Позиция) = 10 Тогда
					Позиция = Позиция + 1;
				КонецЕсли;
				НомерСтроки = НомерСтроки + 1;
				Прервать;
			Иначе
				Поле = Поле + СимволПоля(Текст, Позиция, Код);
				НачалоПоля = Ложь;
				Позиция = Позиция + 1;
			КонецЕсли;

		КонецЦикла;

		Если ВКавычках Тогда
			Если ДопуститьОбрыв Тогда
				Прервать;
			КонецЕсли;
			ВызватьИсключение СтрШаблон(
				"В CSV незакрытая кавычка, запись начинается в строке %1.", Формат(НомерЗаписи, "ЧН=0; ЧГ="));
		КонецЕсли;

		Если КонецЗаписи = 0 Тогда
			КонецЗаписи = Длина + 1;
		КонецЕсли;

		// Пустая строка вне кавычек: терминатор стоит в самом начале записи.
		Если КонецЗаписи = НачалоЗаписи Тогда
			Продолжить;
		КонецЕсли;

		Поля.Добавить(Поле);
		Запись = Новый Структура;
		Запись.Вставить("НомерВИсточнике", НомерЗаписи);
		Запись.Вставить("Поля", Поля);
		Запись.Вставить("Сырые", Сред(Текст, НачалоЗаписи, КонецЗаписи - НачалоЗаписи));
		Записи.Добавить(Запись);

	КонецЦикла;

	Возврат Записи;

КонецФункции

// Начало данных: из потока читаются первые байты (не больше Размер), файл целиком в буфер не копируется.
// Для дешевых проверок формата (ФайлПохожНаФормат): им нужен только заголовок. Поток закрывается на всех путях; исключение
// (например, вход - не двоичные данные) после закрытия потока пробрасывается: диспетчер превращает его в ошибку для
// администратора, а не в «файл не похож».
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла.
//  Размер - Число - сколько байт начала взять не больше.
//
// Возвращаемое значение:
//  ДвоичныеДанные - начало файла (пустое для пустого файла).
Функция НачалоДанных(Данные, Размер) Экспорт

	Поток = Неопределено;
	Попытка
		Нужно = Мин(Данные.Размер(), Размер);
		Если Нужно = 0 Тогда
			Возврат ПолучитьДвоичныеДанныеИзСтроки("", "windows-1251", Ложь);
		КонецЕсли;
		Поток = Данные.ОткрытьПотокДляЧтения();
		Буфер = Новый БуферДвоичныхДанных(Нужно);
		Прочитано = 0;
		Пока Прочитано < Нужно Цикл
			Порция = Поток.Прочитать(Буфер, Прочитано, Нужно - Прочитано);
			Если Порция = 0 Тогда
				Прервать;
			КонецЕсли;
			Прочитано = Прочитано + Порция;
		КонецЦикла;
		Поток.Закрыть();
		Поток = Неопределено;
		Если Прочитано < Нужно Тогда
			Буфер = Буфер.ПолучитьСрез(0, Прочитано);
		КонецЕсли;
		Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Исключение
		Если Поток <> Неопределено Тогда
			Попытка
				Поток.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Разбирает текст фиксированной ширины (например, .dat банка) в записи-строки. Поля из записи
// берет ПолеФиксированнойШирины: позиции и длины знает модуль формата, а не контейнер.
//
// Правила:
//  - концы строк CRLF, LF и CR равнозначны; пустые строки пропускаются, номер остается физическим;
//  - позиции считаются в символах декодированного текста (для однобайтной кодировки - в байтах).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла.
//  Кодировка - Строка - "windows-1251", "utf-8" и т.п.
//
// Возвращаемое значение:
//  Массив из Структура - записи:
//   * НомерВИсточнике - Число - номер физической строки файла, с единицы;
//   * Сырые - Строка - строка как в файле, без перевода строки (NUL не заменяется).
Функция СтрокиФиксированнойШирины(Данные, Кодировка) Экспорт

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, Кодировка);
	Длина = СтрДлина(Текст);
	Записи = Новый Массив;

	Позиция = 1;
	НомерСтроки = 0;
	Пока Позиция <= Длина Цикл

		НомерСтроки = НомерСтроки + 1;
		НачалоСтроки = Позиция;
		Пока Позиция <= Длина Цикл
			Код = КодСимвола(Текст, Позиция);
			Если Код = 13 Или Код = 10 Тогда
				Прервать;
			КонецЕсли;
			Позиция = Позиция + 1;
		КонецЦикла;
		КонецСтроки = Позиция;

		Если Позиция <= Длина Тогда
			Если КодСимвола(Текст, Позиция) = 13 И Позиция < Длина И КодСимвола(Текст, Позиция + 1) = 10 Тогда
				Позиция = Позиция + 1;
			КонецЕсли;
			Позиция = Позиция + 1;
		КонецЕсли;

		Если КонецСтроки = НачалоСтроки Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("НомерВИсточнике", НомерСтроки);
		Запись.Вставить("Сырые", Сред(Текст, НачалоСтроки, КонецСтроки - НачалоСтроки));
		Записи.Добавить(Запись);

	КонецЦикла;

	Возврат Записи;

КонецФункции

// Поле строки фиксированной ширины по позиции и длине, без пробелов по краям.
// Строка короче позиции - не ошибка контейнера: поле пустое (ошибка ли это, решает модуль формата).
// Символ NUL в поле заменяется апострофом, как в полях CSV.
//
// Параметры:
//  Строка - Строка - Сырые записи из СтрокиФиксированнойШирины.
//  Позиция - Число - первая позиция поля, с единицы (как в Сред).
//  Длина - Число - длина поля, не меньше единицы.
//
// Возвращаемое значение:
//  Строка - значение поля; для строки короче позиции - пустая строка, для строки короче конца
//           поля - доступная часть.
Функция ПолеФиксированнойШирины(Строка, Позиция, Длина) Экспорт

	Если Позиция < 1 Или Длина < 1 Тогда
		ВызватьИсключение "Позиция и длина поля фиксированной ширины должны быть не меньше единицы.";
	КонецЕсли;

	Значение = Сред(Строка, Позиция, Длина);
	Значение = СтрЗаменить(Значение, Символ(0), "'");
	Возврат СокрЛП(Значение);

КонецФункции

// Разбирает DBF (dBase III) из двоичных данных в записи: собственный разбор в памяти, без XBase и
// без временных файлов. XBase не годится: он принимает имя файла не длиннее 8 символов, читает
// только ANSI/OEM по локали сервера, молча превращает мусор в числовом поле в 0, а NUL в тексте
// обрезает значение (все измерено на платформе 8.3.27).
//
// Правила:
//  - кодировка - только из параметра (в образцах банков байт языка в заголовке равен 0, а локаль
//    сервера не источник); имена полей и значения декодируются ею же; длина поля - в байтах;
//  - значения полей - сырые строки как в файле: разбор числа и даты - дело РазобратьСумму и
//    РазобратьДату в модуле формата. Справа снимаются только пробелы (код 32, добивка формата);
//    ведущие пробелы (числа выровнены вправо), табуляция и неразрывный пробел остаются;
//    символ NUL (код 0) в значении заменяется апострофом, как в полях CSV и фиксированной ширины
//    (NUL стоит на месте апострофа), длина значения не меняется и строка не обрезается;
//  - допустимые типы полей: C, N, D, L, F; любой другой (в том числе M - memo лежит в отдельном
//    файле) - исключение с именем поля и типом; длина C может быть больше 255 (длина хранится
//    двумя байтами: младший - длина, старший - в байте десятичных знаков);
//  - заголовок проверяется на границах: версия 3, длина заголовка, терминатор описания полей (код
//    13) ровно на последнем байте заголовка, сумма длин полей + 1 = длина записи, размер данных
//    = заголовок + записи * длина записи (маркер конца 26 допустим, отсутствие тоже); противоречивый
//    или оборванный файл - исключение, а не часть записей;
//  - вычеркнутые записи (первый байт "*") не отдаются, как это делал XBase в старой обработке.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла DBF.
//  Кодировка - Строка - "windows-1251", "cp866", "utf-8" и т.п.
//
// Возвращаемое значение:
//  Массив из Структура - записи:
//   * НомерВИсточнике - Число - физический номер записи в файле, с единицы; вычеркнутые записи
//                       номер занимают (запись после одной вычеркнутой посреди файла получает
//                       номер на единицу больше), чтобы человек нашел запись в файле;
//   * Поля - Соответствие из Строка - значения по именам полей как в файле (регистр сохранен);
//   * Сырые - Строка - запись как в файле, без признака вычеркивания, с дополнением полей;
//                NUL в Сырых не заменяется.
Функция ЗаписиDBF(Данные, Кодировка) Экспорт

	Если ТипЗнч(Кодировка) <> Тип("Строка") Или ПустаяСтрока(Кодировка) Тогда
		ВызватьИсключение "Кодировка DBF не распознана: """ + Кодировка + """.";
	КонецЕсли;
	Попытка
		ПолучитьСтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки("A", "windows-1251"), Кодировка);
	Исключение
		ВызватьИсключение "Кодировка DBF не распознана: """ + Кодировка + """.";
	КонецПопытки;

	Попытка
		Возврат ПрочитатьЗаписиDBF(Данные, Кодировка);
	Исключение
		ВызватьИсключение "Файл не удалось прочитать как DBF: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Читает записи-элементы XML: атрибуты элемента с заданным именем, например ROW в ROWDATA.
// Чтение из потока двоичных данных, временного файла нет. Поврежденный XML (в том числе
// оборванный посреди файла) - исключение, а не часть записей.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое файла; кодировку берет из объявления XML.
//  ИмяЭлемента - Строка - имя (локальное) элемента-записи.
//
// Возвращаемое значение:
//  Массив из Структура - записи:
//   * НомерВИсточнике - Число - порядковый номер элемента в файле, с единицы;
//   * Поля - Соответствие из Строка - атрибут -> значение (строка, без разбора);
//   * Сырые - Строка - элемент, собранный из атрибутов: <ИмяЭлемента имя="значение" .../>
//             (значения экранированы); не точная копия текста файла.
Функция ЗаписиXML(Данные, ИмяЭлемента) Экспорт

	Если ТипЗнч(ИмяЭлемента) <> Тип("Строка") Или ПустаяСтрока(ИмяЭлемента) Тогда
		ВызватьИсключение "Имя элемента XML не задано.";
	КонецЕсли;

	Записи = Новый Массив;
	Поток = Данные.ОткрытьПотокДляЧтения();
	Чтение = Новый ЧтениеXML;

	Попытка
		Чтение.ОткрытьПоток(Поток);
		Глубина = 0;
		БылКорень = Ложь;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				БылКорень = Истина;
				Глубина = Глубина + 1;
				Если Чтение.ЛокальноеИмя = ИмяЭлемента Тогда
					Записи.Добавить(ЗаписьXMLИзАтрибутов(Чтение, ИмяЭлемента, Записи.Количество() + 1));
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Глубина = Глубина - 1;
			КонецЕсли;
		КонецЦикла;
		Если Не БылКорень Тогда
			ВызватьИсключение "в данных нет ни одного элемента";
		КонецЕсли;
		Если Глубина <> 0 Тогда
			ВызватьИсключение "файл оборван: не закрыто элементов - " + Глубина;
		КонецЕсли;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		// Исходная ошибка важнее ошибки закрытия.
		ЗакрытьЧтениеXMLИПоток(Чтение, Поток);
		ВызватьИсключение "Файл не удалось прочитать как XML: " + ТекстОшибки;
	КонецПопытки;

	ОшибкаЗакрытия = ЗакрытьЧтениеXMLИПоток(Чтение, Поток);
	Если ОшибкаЗакрытия <> "" Тогда
		ВызватьИсключение "Не удалось закрыть источник XML: " + ОшибкаЗакрытия;
	КонецЕсли;
	Возврат Записи;

КонецФункции

// Разбирает число из текста: только разбор числа, масштаб (гривны или копейки) задает модуль
// формата.
//
// Допускается: знак + или -, одна десятковая точка или запятая, пробел и неразрывный пробел
// в любом месте (разделитель групп разрядов и поля по краям). Не допускается: обе десятковые
// точка и запятая вместе, второй разделитель, буквы, знак после числа, число без цифр до или
// после разделителя дробной части.
//
// Параметры:
//  Текст - Строка - исходное значение.
//
// Возвращаемое значение:
//  Число, Неопределено - Неопределено, если разобрать нельзя («-», пустая строка, мусор).
Функция РазобратьСумму(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = ТекстБезПробелов(Текст);
	Если Значение = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Знак = 1;
	ПервыйСимвол = Лев(Значение, 1);
	Если ПервыйСимвол = "-" Или ПервыйСимвол = "+" Тогда
		Если ПервыйСимвол = "-" Тогда
			Знак = -1;
		КонецЕсли;
		Значение = Сред(Значение, 2);
	КонецЕсли;

	Значение = СтрЗаменить(Значение, ",", ".");
	Части = СтрРазделить(Значение, ".", Истина);
	Если Части.Количество() > 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Целая = Части[0];
	Дробная = "";
	Если Части.Количество() = 2 Тогда
		Дробная = Части[1];
		Если Дробная = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если Целая = "" Или Не ТолькоЦифры(Целая) Или Не ТолькоЦифры(Дробная) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Предел разрядности числа платформы; дальше - не число выписки, а мусор.
	Если СтрДлина(Целая) + СтрДлина(Дробная) > 30 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Число(Целая);
	Если Дробная <> "" Тогда
		Результат = Результат + Число(Дробная) / Pow(10, СтрДлина(Дробная));
	КонецЕсли;

	Возврат Знак * Результат;

КонецФункции

// Разбирает дату по шаблону. Шаблоны (имя - строка шаблона, регистр важен), именно те, что
// встречаются в старых обработках:
//  "дд.мм.рррр"          - 15.03.2024
//  "дд.мм.рррр чч:мм"    - 15.03.2024 09:07 (час может быть из одной цифры: 9:07)
//  "дд.мм.рррр чч:мм:сс" - 15.03.2024 09:07:45
//  "рррр.мм.дд"          - 2024.03.15
//  "ррррммдд"            - 20240315
//  "ррммдд"              - 240315; год из двух цифр, век всегда 20 (2000-2099)
// Пробелы по краям текста игнорируются. Время без даты и дата без времени там, где шаблон
// требует другого, не разбираются.
//
// Параметры:
//  Текст - Строка - исходное значение.
//  Шаблон - Строка - имя шаблона из перечня выше. Неизвестный шаблон - исключение
//           (ошибка программиста, не «не разобрано»).
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено для пустого значения, мусора, несуществующей даты
//   (31.02, месяц 13, час 24) и пустой даты платформы (01.01.0001 00:00:00): пустая дата
//   никогда не возвращается.
Функция РазобратьДату(Текст, Шаблон) Экспорт

	Если ТипЗнч(Шаблон) <> Тип("Строка") Или СтрНайти(ШаблоныДат(), Символы.ПС + Шаблон + Символы.ПС) = 0 Тогда
		ВызватьИсключение "Неизвестный шаблон даты: """ + Шаблон + """. Допустимые: "
			+ СтрЗаменить(СокрЛП(ШаблоныДат()), Символы.ПС, "; ");
	КонецЕсли;

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(СтрЗаменить(Текст, Символ(160), " "));
	ДлинаТекста = СтрДлина(Значение);
	ДлинаШаблона = СтрДлина(Шаблон);

	Год = -1;
	Месяц = -1;
	День = -1;
	Час = 0;
	Минута = 0;
	Секунда = 0;
	ЕстьЧас = Ложь;
	ВекДвадцатый = Ложь;

	ПозШаблона = 1;
	ПозТекста = 1;
	Пока ПозШаблона <= ДлинаШаблона Цикл

		Токен = ТокенШаблона(Шаблон, ПозШаблона);
		ПозШаблона = ПозШаблона + СтрДлина(Токен);

		Если Токен = "дд" Или Токен = "мм" Или Токен = "рррр" Или Токен = "рр"
			Или Токен = "чч" Или Токен = "сс" Тогда

			Цифр = СтрДлина(Токен);
			Если Токен = "чч" Тогда
				// Час бывает из одной цифры: берем вторую, только если она цифра.
				Цифр = 1;
				Если ПозТекста + 1 <= ДлинаТекста И ЭтоЦифра(КодСимвола(Значение, ПозТекста + 1)) Тогда
					Цифр = 2;
				КонецЕсли;
			КонецЕсли;

			Если ПозТекста + Цифр - 1 > ДлинаТекста Тогда
				Возврат Неопределено;
			КонецЕсли;
			ЦифрыЧасти = Сред(Значение, ПозТекста, Цифр);
			Если Не ТолькоЦифры(ЦифрыЧасти) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Величина = Число(ЦифрыЧасти);
			ПозТекста = ПозТекста + Цифр;

			Если Токен = "дд" Тогда
				День = Величина;
			ИначеЕсли Токен = "рррр" Тогда
				Год = Величина;
			ИначеЕсли Токен = "рр" Тогда
				Год = 2000 + Величина;
			ИначеЕсли Токен = "чч" Тогда
				Час = Величина;
				ЕстьЧас = Истина;
			ИначеЕсли Токен = "сс" Тогда
				Секунда = Величина;
			ИначеЕсли ЕстьЧас Тогда
				// «мм» после часа - минуты.
				Минута = Величина;
			Иначе
				Месяц = Величина;
			КонецЕсли;
		Иначе
			// Литерал шаблона должен совпасть с текстом.
			Если ПозТекста > ДлинаТекста Или Сред(Значение, ПозТекста, 1) <> Токен Тогда
				Возврат Неопределено;
			КонецЕсли;
			ПозТекста = ПозТекста + 1;
		КонецЕсли;

	КонецЦикла;

	Если ПозТекста <= ДлинаТекста Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Год < 1 Или Месяц < 1 Или Месяц > 12 Или День < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если День > ДнейВМесяце(Год, Месяц) Или Час > 23 Или Минута > 59 Или Секунда > 59 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Дата(Год, Месяц, День, Час, Минута, Секунда);
	// 01.01.0001 00:00:00 - пустая дата платформы; банки пишут ее как null. Это не дата выписки.
	Если Результат = Дата(1, 1, 1, 0, 0, 0) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Приводит код валюты к трем цифрам (числовой код валюты).
//
// Таблица статическая: UAH, USD, EUR, GBP, PLN, CHF. Регистр букв и пробелы по краям не
// важны. Трехзначный числовой код возвращается как есть, если он есть в таблице.
//
// Параметры:
//  Текст - Строка - буквенный или цифровой код.
//
// Возвращаемое значение:
//  Строка, Неопределено - три цифры; пустая строка для пустого входа (валюта счета);
//   Неопределено для неизвестного кода.
Функция ЧисловойКодВалюты(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Код = ВРег(ТекстБезПробелов(Текст));
	Если Код = "" Тогда
		Возврат "";
	КонецЕсли;

	Таблица = ТаблицаКодовВалют();
	Если СтрДлина(Код) = 3 И ТолькоЦифры(Код) Тогда
		Для Каждого Элемент Из Таблица Цикл
			Если Элемент.Значение = Код Тогда
				Возврат Код;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;

	Возврат Таблица[Код];

КонецФункции

// Пишет DBF (dBase III, поля типа C) в память: зеркало ЗаписиDBF, структура файла берется из СтруктураDBF - тех же
// определений, что у чтения. Без временного файла и без платформенного объекта записи DBF: двоичный буфер собирается по описанию полей.
//
// Что пишется: заголовок (версия 3, дата обновления, число записей и длины - младшим байтом вперед, байт языка по
// кодировке), описание полей по 32 байта (имя нулями до 11 байт, тип, длина), терминатор 13; затем записи - признак
// пробел и значения полей, добитые пробелами справа до ширины; после записей маркер конца 26. Дата обновления
// приходит параметром: модуль текущее время не читает.
//
// Значения не обрезаются: значение длиннее ширины поля - исключение с именем поля (обрезание с предупреждением -
// дело модуля формата, который знает смысл полей). Значение, которого нет в записи, пишется пустым.
//
// Параметры:
//  Поля - Массив из Структура - описание полей по порядку:
//   * Имя - Строка - не длиннее 10 символов, не пустое, без повторов (регистр не различается);
//   * Тип - Строка - только "C";
//   * Длина - Число - ширина в байтах, от 1 до 65535.
//  Записи - Массив из Соответствие - значения по именам полей (Строка).
//  Кодировка - Строка - "windows-1251" (байт языка 0xC9) или "cp866" (0x26); другая - исключение.
//  ДатаОбновления - Дата - дата последнего обновления в заголовке (год от 1900 до 2155).
//
// Возвращаемое значение:
//  ДвоичныеДанные - файл DBF.
Функция ДвоичныеДанныеDBF(Поля, Записи, Кодировка, ДатаОбновления) Экспорт

	Структура = СтруктураDBF();

	Если ТипЗнч(Поля) <> Тип("Массив") Или Поля.Количество() = 0 Тогда
		ВызватьИсключение "Поля: ожидается непустой Массив описаний полей (Имя, Тип, Длина).";
	КонецЕсли;
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение "Записи: ожидается Массив соответствий.";
	КонецЕсли;
	Если ТипЗнч(ДатаОбновления) <> Тип("Дата") Или Год(ДатаОбновления) < 1900 Или Год(ДатаОбновления) > 2155 Тогда
		ВызватьИсключение "ДатаОбновления: ожидается Дата с годом от 1900 до 2155.";
	КонецЕсли;
	ЯзыковойДрайвер = ЯзыковойДрайверDBF(Кодировка);

	ДлинаЗаписи = 1;
	ИзвестныеИмена = Новый Соответствие;
	Для Каждого Поле Из Поля Цикл
		ПроверитьОписаниеПоляDBF(Поле, ИзвестныеИмена);
		ДлинаЗаписи = ДлинаЗаписи + Поле.Длина;
	КонецЦикла;
	Если ДлинаЗаписи > 65535 Тогда
		ВызватьИсключение "Длина записи " + ДлинаЗаписи + " больше 65535.";
	КонецЕсли;

	ДлинаЗаголовка = Структура.РазмерБлока + Поля.Количество() * Структура.РазмерБлока + 1;
	Размер = ДлинаЗаголовка + Записи.Количество() * ДлинаЗаписи + 1;
	Буфер = Новый БуферДвоичныхДанных(Размер);

	Буфер[0] = Структура.Версия;
	Буфер[Структура.СмещениеДаты] = Год(ДатаОбновления) - 1900;
	Буфер[Структура.СмещениеДаты + 1] = Месяц(ДатаОбновления);
	Буфер[Структура.СмещениеДаты + 2] = День(ДатаОбновления);
	Буфер.ЗаписатьЦелое32(Структура.СмещениеЧислаЗаписей, Записи.Количество(), ПорядокБайтов.LittleEndian);
	Буфер.ЗаписатьЦелое16(Структура.СмещениеДлиныЗаголовка, ДлинаЗаголовка, ПорядокБайтов.LittleEndian);
	Буфер.ЗаписатьЦелое16(Структура.СмещениеДлиныЗаписи, ДлинаЗаписи, ПорядокБайтов.LittleEndian);
	Буфер[Структура.СмещениеЯзыковогоДрайвера] = ЯзыковойДрайвер;

	Позиция = Структура.РазмерБлока;
	Для Каждого Поле Из Поля Цикл
		БайтыИмени = ПолучитьБуферДвоичныхДанныхИзСтроки(Поле.Имя, Кодировка, Ложь);
		Для Индекс = 0 По БайтыИмени.Размер - 1 Цикл
			Буфер[Позиция + Индекс] = БайтыИмени[Индекс];
		КонецЦикла;
		Буфер[Позиция + Структура.СмещениеТипаПоля] = КодСимвола(Поле.Тип);
		Буфер[Позиция + Структура.СмещениеДлиныПоля] = Поле.Длина % 256;
		Буфер[Позиция + Структура.СмещениеДробнойЧасти] = Цел(Поле.Длина / 256);
		Позиция = Позиция + Структура.РазмерБлока;
	КонецЦикла;
	Буфер[ДлинаЗаголовка - 1] = Структура.ТерминаторОписания;

	НомерЗаписи = 0;
	Для Каждого Запись Из Записи Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			ВызватьИсключение "Записи[" + Формат(НомерЗаписи, "ЧГ=0") + "]: ожидается Соответствие.";
		КонецЕсли;
		Позиция = ДлинаЗаголовка + НомерЗаписи * ДлинаЗаписи;
		Буфер[Позиция] = Структура.ПризнакЗаписи;
		Позиция = Позиция + 1;
		Для Каждого Поле Из Поля Цикл
			Значение = Запись.Получить(Поле.Имя);
			Если Значение = Неопределено Тогда
				Значение = "";
			КонецЕсли;
			Если ТипЗнч(Значение) <> Тип("Строка") Тогда
				ВызватьИсключение "Записи[" + Формат(НомерЗаписи, "ЧГ=0") + "], поле " + Поле.Имя + ": ожидается Строка.";
			КонецЕсли;
			БайтыЗначения = ПолучитьБуферДвоичныхДанныхИзСтроки(Значение, Кодировка, Ложь);
			Если БайтыЗначения.Размер > Поле.Длина Тогда
				ВызватьИсключение "Записи[" + Формат(НомерЗаписи, "ЧГ=0") + "], поле " + Поле.Имя + ": значение занимает "
					+ Формат(БайтыЗначения.Размер, "ЧГ=0") + " байт при ширине поля " + Формат(Поле.Длина, "ЧГ=0") + ".";
			КонецЕсли;
			Для Индекс = 0 По Поле.Длина - 1 Цикл
				Буфер[Позиция + Индекс] = ?(Индекс < БайтыЗначения.Размер, БайтыЗначения[Индекс], 32);
			КонецЦикла;
			Позиция = Позиция + Поле.Длина;
		КонецЦикла;
		НомерЗаписи = НомерЗаписи + 1;
	КонецЦикла;

	Буфер[Размер - 1] = Структура.МаркерКонца;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);

КонецФункции

// Очищает назначение платежа от недопустимых символов для форматов вывода (общее правило модулей форматов вывода;
// эталон - УдалитьНедопустимыеСимволы копий обработок банков). Допустимы: пробел, кириллица (с ёЁ), украинские
// ІіЇїЄє, латиница, цифры и знаки . , ; - все остальное (в том числе ґ Ґ ' " = - / : № скобки % < > _, переводы
// строк, табуляция и неразрывный пробел) удаляется. Обрезание до предела поля - дело модуля формата, ПОСЛЕ очистки.
//
// Параметры:
//  Текст - Строка - назначение платежа.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - очищенное назначение.
//   * Убрано - Строка - набор убранных символов (без повторов, в порядке появления); пусто, если убирать было нечего.
Функция ОчиститьНазначениеПлатежа(Знач Текст) Экспорт

	Убрано = "";
	Результат = Новый Массив;
	Допустимые = ДопустимыеСимволыНазначения();
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти(Допустимые, Знак) > 0 Тогда
			Результат.Добавить(Знак);
		ИначеЕсли СтрНайти(Убрано, Знак) = 0 Тогда
			Убрано = Убрано + Знак;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Текст,Убрано", СтрСоединить(Результат), Убрано);

КонецФункции

// Предупреждение вывода: поле поручения очищено от недопустимых символов (набор называется, не число).
//
// Параметры:
//  Индекс - Число - индекс поручения в массиве (с нуля).
//  Поле - Строка - имя поля файла.
//  Убрано - Строка - набор убранных символов (результат ОчиститьНазначениеПлатежа).
//
// Возвращаемое значение:
//  Структура - ИндексПоручения, Поле, Действие = "Очищено", Предел = 0, Символы, Текст.
Функция ПредупреждениеОчистки(Индекс, Поле, Убрано) Экспорт

	Текст = СтрШаблон(НСтр("ru = 'Поле %1: очищены символы: %2.'; uk = 'Поле %1: очищено символи: %2.'"),
		Поле, ПредставлениеНабора(Убрано));
	Возврат НовоеПредупреждениеВывода(Индекс, Поле, "Очищено", 0, Убрано, Текст);

КонецФункции

// Предупреждение вывода: поле поручения обрезано до предела.
//
// Параметры:
//  Индекс - Число - индекс поручения в массиве (с нуля).
//  Поле - Строка - имя поля файла.
//  Предел - Число - число символов, до которого обрезано.
//
// Возвращаемое значение:
//  Структура - ИндексПоручения, Поле, Действие = "Обрезано", Предел, Символы = "", Текст.
Функция ПредупреждениеОбрезания(Индекс, Поле, Предел) Экспорт

	Текст = СтрШаблон(НСтр("ru = 'Поле %1: обрезано до %2 символов.'; uk = 'Поле %1: обрізано до %2 символів.'"),
		Поле, Формат(Предел, "ЧГ=0"));
	Возврат НовоеПредупреждениеВывода(Индекс, Поле, "Обрезано", Предел, "", Текст);

КонецФункции

// Символы текста, которые не переживают кодирование в кодировку и обратное расшифрование: платформа кодирует каждый
// символ и расшифровывает байты назад, что изменилось - вне кодировки. Списка букв нет: кодировку определяет платформа.
//
// Параметры:
//  Текст - Строка - значение, которое попадет в файл.
//  Кодировка - Строка - кодировка в виде, который принимает платформа (например, "windows-1251").
//
// Возвращаемое значение:
//  Строка - набор символов вне кодировки (без повторов, в порядке появления); пусто, если все символы переживают круг.
Функция СимволыВнеКодировки(Текст, Кодировка) Экспорт

	Набор = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти(Набор, Знак) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Круг = ПолучитьСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзСтроки(Знак, Кодировка, Ложь), Кодировка);
		Если Круг <> Знак Тогда
			Набор = Набор + Знак;
		КонецЕсли;
	КонецЦикла;
	Возврат Набор;

КонецФункции

// Символы текста, разрывающие строку формата "ключ=значение" (перевод строки, возврат каретки, перевод страницы,
// вертикальная и горизонтальная табуляция). Для форматов, где значение стоит в строке текста.
//
// Параметры:
//  Текст - Строка - значение, которое попадет в файл.
//
// Возвращаемое значение:
//  Строка - набор символов (без повторов, в порядке появления); пусто, если таких нет.
Функция СимволыРазрываСтроки(Текст) Экспорт

	Разрывающие = Символы.ПС + Символы.ВК + Символы.ПФ + Символы.ВТаб + Символы.Таб;
	Набор = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти(Разрывающие, Знак) > 0 И СтрНайти(Набор, Знак) = 0 Тогда
			Набор = Набор + Знак;
		КонецЕсли;
	КонецЦикла;
	Возврат Набор;

КонецФункции

// Добавляет предупреждения о текстовом поле, которое формат пишет в файл БЕЗ очистки: символы вне кодировки и (если
// значение стоит в строке текста) символы, разрывающие строку. Значение не меняется, байты файла остаются прежними;
// предупреждение лишь называет поле и символы. Проверяйте то значение, которое реально идет в файл (после обрезания).
// Назначение платежа имеет собственное предупреждение очистки и сюда не передается.
//
// Параметры:
//  Предупреждения - Массив из Структура - предупреждения вывода (дополняется).
//  Значение - Строка - значение поля, как оно попадет в файл.
//  Индекс - Число - индекс поручения в массиве (с нуля).
//  Поле - Строка - имя поля файла.
//  Кодировка - Строка - кодировка, в которой значение кодируется в файле.
//  ПроверятьРазрывСтроки - Булево - Истина для форматов, где значение стоит в строке текста.
Процедура ДобавитьПредупрежденияТекстаПоля(Предупреждения, Значение, Индекс, Поле, Кодировка, ПроверятьРазрывСтроки) Экспорт

	Если ПроверятьРазрывСтроки Тогда
		Разрыв = СимволыРазрываСтроки(Значение);
		Если Разрыв <> "" Тогда
			Текст = СтрШаблон(НСтр("ru = 'Поле %1: перевод строки или табуляция разорвут строку файла: %2.';
				|uk = 'Поле %1: перевід рядка або табуляція розірвуть рядок файлу: %2.'"), Поле, ПредставлениеНабора(Разрыв));
			Предупреждения.Добавить(НовоеПредупреждениеВывода(Индекс, Поле, "РазрываетСтроку", 0, Разрыв, Текст));
		КонецЕсли;
	КонецЕсли;

	ВнеКодировки = СимволыВнеКодировки(Значение, Кодировка);
	Если ВнеКодировки <> "" Тогда
		Текст = СтрШаблон(НСтр("ru = 'Поле %1: символы вне кодировки %2, в файле будут искажены: %3.';
			|uk = 'Поле %1: символи поза кодуванням %2, у файлі будуть спотворені: %3.'"), Поле, Кодировка, ПредставлениеНабора(ВнеКодировки));
		Предупреждения.Добавить(НовоеПредупреждениеВывода(Индекс, Поле, "ВнеКодировки", 0, ВнеКодировки, Текст));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Символ поля: NUL заменяется апострофом (NUL стоит на месте апострофа), остальное как есть.
Функция СимволПоля(Текст, Позиция, Код)

	Если Код = 0 Тогда
		Возврат "'";
	КонецЕсли;
	Возврат Сред(Текст, Позиция, 1);

КонецФункции

Функция ЭтоЦифра(Код)

	Возврат Код >= 48 И Код <= 57;

КонецФункции

// Пустая строка - не «только цифры».
Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если Не ЭтоЦифра(КодСимвола(Текст, Позиция)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Убирает все обычные и неразрывные пробелы (в том числе узкий неразрывный).
Функция ТекстБезПробелов(Текст)

	Результат = Текст;
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Результат = СтрЗаменить(Результат, Символ(8239), "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");
	Возврат Результат;

КонецФункции

// Перечень шаблонов дат, по одному в строке, с ограничивающими переводами строк.
Функция ШаблоныДат()

	Возврат Символы.ПС
		+ "дд.мм.рррр" + Символы.ПС
		+ "дд.мм.рррр чч:мм" + Символы.ПС
		+ "дд.мм.рррр чч:мм:сс" + Символы.ПС
		+ "рррр.мм.дд" + Символы.ПС
		+ "ррррммдд" + Символы.ПС
		+ "ррммдд" + Символы.ПС;

КонецФункции

// Очередной токен шаблона на позиции: рррр, рр, дд, мм, чч, сс или один символ-литерал.
Функция ТокенШаблона(Шаблон, Позиция)

	Для Каждого Токен Из СтрРазделить("рррр,рр,дд,мм,чч,сс", ",") Цикл
		Если Сред(Шаблон, Позиция, СтрДлина(Токен)) = Токен Тогда
			Возврат Токен;
		КонецЕсли;
	КонецЦикла;
	Возврат Сред(Шаблон, Позиция, 1);

КонецФункции

Функция ДнейВМесяце(Год, Месяц)

	Если Месяц = 2 Тогда
		Високосный = (Год % 4 = 0 И Год % 100 <> 0) Или Год % 400 = 0;
		Возврат ?(Високосный, 29, 28);
	КонецЕсли;
	Если Месяц = 4 Или Месяц = 6 Или Месяц = 9 Или Месяц = 11 Тогда
		Возврат 30;
	КонецЕсли;
	Возврат 31;

КонецФункции

// Буквенный код ISO 4217 -> числовой.
Функция ТаблицаКодовВалют()

	Таблица = Новый Соответствие;
	Таблица.Вставить("UAH", "980");
	Таблица.Вставить("USD", "840");
	Таблица.Вставить("EUR", "978");
	Таблица.Вставить("GBP", "826");
	Таблица.Вставить("PLN", "985");
	Таблица.Вставить("CHF", "756");
	Возврат Таблица;

КонецФункции

// Определения структуры файла dBase III: ОДНО место, из которого берут размеры и смещения и чтение, и запись DBF
// (зеркало: вторая независимая версия формата не допускается).
Функция СтруктураDBF()

	Результат = Новый Структура;
	Результат.Вставить("Версия", 3);                    // байт 0: dBase III без memo
	Результат.Вставить("РазмерБлока", 32);              // заголовок файла и описание одного поля
	Результат.Вставить("СмещениеДаты", 1);              // байты 1-3: год-1900, месяц, день последнего обновления
	Результат.Вставить("СмещениеЧислаЗаписей", 4);      // Целое32 LE
	Результат.Вставить("СмещениеДлиныЗаголовка", 8);    // Целое16 LE
	Результат.Вставить("СмещениеДлиныЗаписи", 10);      // Целое16 LE
	Результат.Вставить("СмещениеЯзыковогоДрайвера", 29);
	Результат.Вставить("ДлинаИмениПоля", 11);           // имя в описании поля, добивается нулями
	Результат.Вставить("СмещениеТипаПоля", 11);
	Результат.Вставить("СмещениеДлиныПоля", 16);
	Результат.Вставить("СмещениеДробнойЧасти", 17);     // у типа C - старший байт длины
	Результат.Вставить("ТерминаторОписания", 13);       // последний байт заголовка
	Результат.Вставить("МаркерКонца", 26);              // после последней записи
	Результат.Вставить("ПризнакЗаписи", 32);            // пробел: запись не удалена
	Результат.Вставить("ПризнакУдаленной", 42);         // звездочка
	Возврат Результат;

КонецФункции

Функция ДопустимыеСимволыНазначения()

	Возврат " абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,ІіЇїЄє;";

КонецФункции

Функция НовоеПредупреждениеВывода(Индекс, Поле, Действие, Предел, Символы, Текст)

	Предупреждение = Новый Структура;
	Предупреждение.Вставить("ИндексПоручения", Индекс);
	Предупреждение.Вставить("Поле", Поле);
	Предупреждение.Вставить("Действие", Действие);
	Предупреждение.Вставить("Предел", Предел);
	Предупреждение.Вставить("Символы", Символы);
	Предупреждение.Вставить("Текст", Текст);
	Возврат Предупреждение;

КонецФункции

// Набор символов для человека: видимые - сами, невидимые и управляющие (в том числе неразрывный пробел) - кодом U+XXXX.
Функция ПредставлениеНабора(Набор)

	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Набор) Цикл
		Знак = Сред(Набор, Позиция, 1);
		Код = КодСимвола(Знак);
		Если Код <= 32 Или Код = 127 Или Код = 160 Тогда
			Части.Добавить("U+" + ШестнадцатеричныйКод(Код));
		Иначе
			Части.Добавить(Знак);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ШестнадцатеричныйКод(Код)

	Цифры = "0123456789ABCDEF";
	Результат = "";
	Остаток = Код;
	Для Номер = 1 По 4 Цикл
		Результат = Сред(Цифры, Остаток % 16 + 1, 1) + Результат;
		Остаток = Цел(Остаток / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Байт языка в заголовке по кодировке; кодировка, которой запись не знает, - исключение (молча писать 0 нельзя: чтение
// в другой программе пошло бы в другой кодовой странице).
Функция ЯзыковойДрайверDBF(Кодировка)

	Если ТипЗнч(Кодировка) = Тип("Строка") Тогда
		Если НРег(Кодировка) = "windows-1251" Тогда
			Возврат 201;
		ИначеЕсли НРег(Кодировка) = "cp866" Тогда
			Возврат 38;
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение "Кодировка DBF не поддерживается записью: """ + Кодировка + """ (допустимы windows-1251 и cp866).";

КонецФункции

Процедура ПроверитьОписаниеПоляDBF(Поле, ИзвестныеИмена)

	Если ТипЗнч(Поле) <> Тип("Структура") Или Не Поле.Свойство("Имя") Или Не Поле.Свойство("Тип") Или Не Поле.Свойство("Длина") Тогда
		ВызватьИсключение "Поля: ожидается Структура с полями Имя, Тип, Длина.";
	КонецЕсли;
	Если ТипЗнч(Поле.Имя) <> Тип("Строка") Или ПустаяСтрока(Поле.Имя) Тогда
		ВызватьИсключение "Поля: пустое имя поля.";
	КонецЕсли;
	Если СтрДлина(Поле.Имя) > 10 Тогда
		ВызватьИсключение "Поле " + Поле.Имя + ": имя длиннее 10 символов.";
	КонецЕсли;
	Если Поле.Тип <> "C" Тогда
		ВызватьИсключение "Поле " + Поле.Имя + ": тип """ + Поле.Тип + """ запись не поддерживает (только C).";
	КонецЕсли;
	Если ТипЗнч(Поле.Длина) <> Тип("Число") Или Поле.Длина < 1 Или Поле.Длина > 65535 Или Поле.Длина <> Цел(Поле.Длина) Тогда
		ВызватьИсключение "Поле " + Поле.Имя + ": ширина должна быть целым от 1 до 65535.";
	КонецЕсли;
	Если ИзвестныеИмена.Получить(ВРег(Поле.Имя)) <> Неопределено Тогда
		ВызватьИсключение "Поле " + Поле.Имя + ": имя повторяется.";
	КонецЕсли;
	ИзвестныеИмена.Вставить(ВРег(Поле.Имя), Истина);

КонецПроцедуры

// Читает DBF целиком; исключения несут причину без префикса (его добавляет ЗаписиDBF).
Функция ПрочитатьЗаписиDBF(Данные, Кодировка)

	Структура = СтруктураDBF();
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Размер = Буфер.Размер;
	Если Размер < Структура.РазмерБлока + 1 Тогда
		ВызватьИсключение "файл короче заголовка (" + Размер + " байт)";
	КонецЕсли;
	Если Буфер[0] <> Структура.Версия Тогда
		ВызватьИсключение "версия файла " + Буфер[0] + " не поддерживается (нужна dBase III, байт 3)";
	КонецЕсли;

	ЧислоЗаписей = Буфер.ПрочитатьЦелое32(Структура.СмещениеЧислаЗаписей, ПорядокБайтов.LittleEndian);
	ДлинаЗаголовка = Буфер.ПрочитатьЦелое16(Структура.СмещениеДлиныЗаголовка, ПорядокБайтов.LittleEndian);
	ДлинаЗаписи = Буфер.ПрочитатьЦелое16(Структура.СмещениеДлиныЗаписи, ПорядокБайтов.LittleEndian);

	Поля = ОписаниеПолейDBF(Буфер, Кодировка, ДлинаЗаголовка);

	Сумма = 1;
	Для Каждого Поле Из Поля Цикл
		Сумма = Сумма + Поле.Длина;
	КонецЦикла;
	Если Сумма <> ДлинаЗаписи Тогда
		ВызватьИсключение "сумма длин полей + 1 (" + Сумма + ") не равна длине записи в заголовке (" + ДлинаЗаписи + ")";
	КонецЕсли;

	Ожидаемый = ДлинаЗаголовка + ЧислоЗаписей * ДлинаЗаписи;
	Если Не (Размер = Ожидаемый Или (Размер = Ожидаемый + 1 И Буфер[Размер - 1] = Структура.МаркерКонца)) Тогда
		ВызватьИсключение "размер данных не соответствует заголовку: записей " + Формат(ЧислоЗаписей, "ЧН=0; ЧГ=")
			+ " по " + ДлинаЗаписи + " байт после заголовка в " + ДлинаЗаголовка + " байт требуют " + Формат(Ожидаемый, "ЧН=0; ЧГ=")
			+ " байт (допустим один завершающий байт 26), в файле " + Формат(Размер, "ЧН=0; ЧГ=");
	КонецЕсли;

	Записи = Новый Массив;
	Для Номер = 1 По ЧислоЗаписей Цикл

		Начало = ДлинаЗаголовка + (Номер - 1) * ДлинаЗаписи;
		Признак = Буфер[Начало];
		Если Признак = Структура.ПризнакУдаленной Тогда
			Продолжить;
		ИначеЕсли Признак <> Структура.ПризнакЗаписи Тогда
			ВызватьИсключение "неверный признак записи " + Номер + ": байт " + Признак + " (ожидается пробел или звездочка)";
		КонецЕсли;

		Значения = Новый Соответствие;
		Позиция = Начало + 1;
		Для Каждого Поле Из Поля Цикл
			Значение = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(Позиция, Поле.Длина), Кодировка);
			// NUL стоит на месте апострофа (отступ 2, как в полях CSV): в значение идет апостроф, длина
			// не меняется. Сырые ниже NUL сохраняют.
			Значения.Вставить(Поле.Имя, БезПробеловСправа(СтрЗаменить(Значение, Символ(0), "'")));
			Позиция = Позиция + Поле.Длина;
		КонецЦикла;

		Запись = Новый Структура;
		Запись.Вставить("НомерВИсточнике", Номер);
		Запись.Вставить("Поля", Значения);
		Запись.Вставить("Сырые", ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(Начало + 1, ДлинаЗаписи - 1), Кодировка));
		Записи.Добавить(Запись);

	КонецЦикла;

	Возврат Записи;

КонецФункции

// Описания полей из заголовка: Массив из Структура (Имя, Тип, Длина). Проверяет терминатор и типы.
Функция ОписаниеПолейDBF(Буфер, Кодировка, ДлинаЗаголовка)

	Структура = СтруктураDBF();
	Размер = Буфер.Размер;
	Если ДлинаЗаголовка < Структура.РазмерБлока + 1 Или ДлинаЗаголовка > Размер Тогда
		ВызватьИсключение "длина заголовка " + ДлинаЗаголовка + " вне файла размером " + Размер;
	КонецЕсли;

	Поля = Новый Массив;
	ИзвестныеИмена = Новый Соответствие;
	Позиция = Структура.РазмерБлока;
	Пока Позиция < Размер И Буфер[Позиция] <> Структура.ТерминаторОписания Цикл

		Если Позиция + Структура.РазмерБлока > Размер Тогда
			ВызватьИсключение "не найден терминатор описания полей (код 13): файл оборван в описании полей";
		КонецЕсли;

		ДлинаИмени = 0;
		Пока ДлинаИмени < Структура.ДлинаИмениПоля И Буфер[Позиция + ДлинаИмени] <> 0 Цикл
			ДлинаИмени = ДлинаИмени + 1;
		КонецЦикла;
		// Прочитать с нулевой длиной нельзя считать пустым именем: берем пустую строку явно.
		Имя = "";
		Если ДлинаИмени > 0 Тогда
			Имя = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(Позиция, ДлинаИмени), Кодировка);
		КонецЕсли;
		Если Имя = "" Тогда
			ВызватьИсключение "пустое имя поля (поле номер " + (Поля.Количество() + 1) + ")";
		КонецЕсли;
		// Имена сравниваются без учета регистра: модули форматов ищут поля в разном регистре, и два поля,
		// отличающиеся только регистром, сделали бы поиск неоднозначным (Соответствие регистр различает).
		Ранее = ИзвестныеИмена.Получить(ВРег(Имя));
		Если Ранее <> Неопределено Тогда
			ВызватьИсключение "повторяющееся имя поля """ + Имя + """ (совпадает с """ + Ранее + """)";
		КонецЕсли;
		ИзвестныеИмена.Вставить(ВРег(Имя), Имя);
		Тип = Символ(Буфер[Позиция + Структура.СмещениеТипаПоля]);
		Длина = Буфер[Позиция + Структура.СмещениеДлиныПоля];

		Если Тип <> "C" И Тип <> "N" И Тип <> "D" И Тип <> "L" И Тип <> "F" Тогда
			ВызватьИсключение "неподдерживаемый тип поля """ + Тип + """ (поле " + Имя + "); допустимы C, N, D, L, F";
		КонецЕсли;
		Если Тип = "C" Тогда
			Длина = Длина + Буфер[Позиция + Структура.СмещениеДробнойЧасти] * 256;
		КонецЕсли;
		Если Длина = 0 Тогда
			ВызватьИсключение "нулевая длина поля " + Имя;
		КонецЕсли;

		Описание = Новый Структура("Имя, Тип, Длина", Имя, Тип, Длина);
		Поля.Добавить(Описание);
		Позиция = Позиция + Структура.РазмерБлока;

	КонецЦикла;

	Если Позиция >= Размер Или Позиция <> ДлинаЗаголовка - 1 Тогда
		ВызватьИсключение "терминатор описания полей (код 13) должен стоять на последнем байте заголовка (позиция "
			+ (ДлинаЗаголовка - 1) + "), найден " + ?(Позиция >= Размер, "не найден", "в позиции " + Позиция);
	КонецЕсли;

	// Запись без полей состоит из одного байта признака: Буфер.Прочитать с нулевой длиной вернул бы
	// остаток буфера, а не пустое значение (измерено), поэтому файл без полей не читается.
	Если Поля.Количество() = 0 Тогда
		ВызватьИсключение "в описании нет ни одного поля";
	КонецЕсли;

	Возврат Поля;

КонецФункции

// Убирает справа только пробелы (код 32): это добивка поля формата, остальное - данные.
Функция БезПробеловСправа(Строка)

	Конец = СтрДлина(Строка);
	Пока Конец > 0 И КодСимвола(Строка, Конец) = 32 Цикл
		Конец = Конец - 1;
	КонецЦикла;
	Возврат Лев(Строка, Конец);

КонецФункции

// Закрывает читатель и поток по отдельности: сбой первого не оставляет открытым второй.
// Возвращает текст первой ошибки закрытия или пустую строку.
Функция ЗакрытьЧтениеXMLИПоток(Чтение, Поток)

	ТекстОшибки = "";
	Попытка
		Чтение.Закрыть();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Попытка
		Поток.Закрыть();
	Исключение
		Если ТекстОшибки = "" Тогда
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	Возврат ТекстОшибки;

КонецФункции

Функция ЗаписьXMLИзАтрибутов(Чтение, ИмяЭлемента, Номер)

	Поля = Новый Соответствие;
	Части = Новый Массив;
	Части.Добавить("<" + ИмяЭлемента);
	Для Индекс = 0 По Чтение.КоличествоАтрибутов() - 1 Цикл
		Имя = Чтение.ИмяАтрибута(Индекс);
		Значение = Чтение.ЗначениеАтрибута(Индекс);
		Поля.Вставить(Имя, Значение);
		Части.Добавить(" " + Имя + "=""" + ЭкранироватьАтрибут(Значение) + """");
	КонецЦикла;
	Части.Добавить("/>");

	Запись = Новый Структура;
	Запись.Вставить("НомерВИсточнике", Номер);
	Запись.Вставить("Поля", Поля);
	Запись.Вставить("Сырые", СтрСоединить(Части, ""));
	Возврат Запись;

КонецФункции

Функция ЭкранироватьАтрибут(Значение)

	Результат = СтрЗаменить(Значение, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;

КонецФункции


#КонецОбласти
