// Читатель выписок: Ощадбанк, файл DBF (план 03, задача 9).
// Один банк, один формат: dBase III, 16 полей (ndoc ... val) или 17 с uetr (более широкие текстовые поля). Каждая
// запись - одна операция. Файл читается из памяти контейнером СМП_ЧтениеВыписокОбщее.ЗаписиDBF: ни временного файла,
// ни перемещения файла пользователя (отступ 5; старая обработка клала файл в фиксированный import.dbf).
//
// Поля файла (как в старой обработке; имена регистра не различают):
//   ndoc - номер документа        dt - дата (тип D, ррррммдд)    summa - сумма в гривнах (N(20,2))
//   dk - направление («0» - списано, «1» - поступило)           val - числовой код валюты (N(4))
//   nazn - назначение платежа
//   acccli - НАШ счет (в обоих поколениях файла; направление его не меняет); mfocli, okpocli, namecli, bankcli - наши
//   реквизиты, старая обработка их в операцию не переносила
//   контрагент: acccor (счет), okpocor (код), mfocor (МФО), namecor (наименование); bankcor не читается
//
// Известные особенности и отступы, воспроизведенные или сделанные намеренно:
//  - тип полей: ndoc, acccli, acccor, okpocor, mfocor, namecor, nazn - строки (измерено в 1С: XBase отдает их с
//    добивкой пробелами справа, Формат(Строка, "ЧГ=0") строку не меняет), поэтому «СокрЛП(Формат(...))» старой обработки
//    равно СокрЛП значения; поля ключа (D17): НомерДокумента = СокрЛП(ndoc), КонтрагентНомерСчета = СокрЛП(acccor),
//    Сумма = summa. Числа XBase - только dk, summa, val;
//  - ДатаДокумента не заполняется: старая обработка кладет в ДатаДок поле dt, то есть день операции, а при пустой
//    ДатаДокумента составной ключ берет дату операции (спека D17);
//  - НомерСчета - поле acccli, а не Параметры.НомерСчета: фильтр чужих счетов платформы видит настоящий счет строки;
//  - направление строго: «0» - списано, «1» - поступило, иное (в том числе пустое) - «Ошибка» с сырым значением
//    (старая обработка: Число(dk) = 0 - списание, все остальное - поступление);
//  - нераспознанные сумма, дата, код валюты - «Ошибка» с сырым значением, а не 0 и не пустая дата, как у XBase;
//  - назначение: ПС -> пробел, как у старой обработки; пробелы по краям снимаются (старая обработка не обрезала поле,
//    добивка справа оставалась; в ключ поле не входит);
//  - ПорядковыйНомер - физический номер записи DBF (вычеркнутые записи номер занимают);
//  - uetr (образец 17 полей) не читается: ИдентификаторОперации пуст, ДаетИдентификаторыОпераций = Ложь; время в
//    файле нет (00:00:00); остатков нет.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет «Ошибка» с
// сырым значением, ЧтениеПолное остается Ложь.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер DBF и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("dbf");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиОщадБанк_DBF");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'Ощадбанк, файл DBF';
		|uk = 'Ощадбанк, файл DBF'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (Кодировка - из описания читателя).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	КодировкаФайла = Параметры.Кодировка;
	Если ПустаяСтрока(КодировкаФайла) Тогда
		КодировкаФайла = Кодировка();
	КонецЕсли;

	// Исключение контейнера (оборванный или поврежденный файл) наружу не идет: его ловит диспетчер реестра и пишет
	// «Ошибка» с полным текстом, конверт не принят, чтение не полное.
	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиDBF(Данные, КодировкаФайла);

	Если Записи.Количество() = 0 Тогда
		ДобавитьСообщение(Выписка, "Ошибка", 0, НСтр("ru = 'Файл не содержит ни одной записи.';
			|uk = 'Файл не містить жодного запису.'"));
		Возврат;
	КонецЕсли;

	// Поля нужны все: без любого из них операцию не собрать. Один раз на файл, а не на каждую запись.
	Отсутствуют = ОтсутствующиеПоля(Записи[0].Поля);
	Если Отсутствуют.Количество() > 0 Тогда
		ДобавитьСообщение(Выписка, "Ошибка", 0, СтрШаблон(
			НСтр("ru = 'В файле нет обязательных полей: %1.';
				|uk = 'У файлі немає обов''язкових полів: %1.'"),
			СтрСоединить(Отсутствуют, ", ")));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	Для Каждого Запись Из Записи Цикл
		Операция = РазобратьЗапись(Запись, Выписка);
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка заголовка: «файл похож на этот формат». Читает из потока только заголовок (32 байта и описание
// полей), записи не трогает: версия dBase III (байт 3) и набор имен полей - 16 полей Ощадбанка или те же с uetr
// (регистр и порядок имен не важны).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	Имена = ИменаПолейИзЗаголовка(Данные);
	Если Имена = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Обязательные = ИменаПолейФормата(Ложь);
	Если Имена.Количество() <> Обязательные.Количество() И Имена.Количество() <> Обязательные.Количество() + 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Допустимые = ИменаПолейФормата(Истина);
	Для Каждого Имя Из Имена Цикл
		Если Допустимые[Имя.Ключ] = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Обязательные Цикл
		Если Имена[Элемент.Ключ] = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образцов (20-samples.md): windows-1251.
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

// Имена полей формата (верхний регистр) как Соответствие имя -> Истина. С uetr - 17 полей, без - 16.
Функция ИменаПолейФормата(СUetr)

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("NDOC,DT,MFOCLI,OKPOCLI,ACCCLI,NAMECLI,BANKCLI,MFOCOR,ACCCOR,OKPOCOR,NAMECOR,BANKCOR,DK,SUMMA,NAZN,VAL", ",") Цикл
		Имена.Вставить(Имя, Истина);
	КонецЦикла;
	Если СUetr Тогда
		Имена.Вставить("UETR", Истина);
	КонецЕсли;
	Возврат Имена;

КонецФункции

// Читаемые читателем поля (нижний регистр): без любого из них операцию не собрать.
Функция ЧитаемыеПоля()

	Возврат СтрРазделить("ndoc,dt,acccli,acccor,okpocor,mfocor,namecor,dk,summa,nazn,val", ",");

КонецФункции

Функция ОтсутствующиеПоля(Поля)

	Нижние = НижнийРегистрИмен(Поля);
	Отсутствуют = Новый Массив;
	Для Каждого Имя Из ЧитаемыеПоля() Цикл
		Если Нижние[Имя] = Неопределено Тогда
			Отсутствуют.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Отсутствуют;

КонецФункции

// Копия Соответствия значений полей с именами в нижнем регистре (Соответствие различает регистр, а старая обработка -
// нет).
Функция НижнийРегистрИмен(Поля)

	Нижние = Новый Соответствие;
	Для Каждого Элемент Из Поля Цикл
		Нижние.Вставить(НРег(Элемент.Ключ), Элемент.Значение);
	КонецЦикла;
	Возврат Нижние;

КонецФункции

// Имена полей из заголовка DBF (верхний регистр, Соответствие имя -> Истина) или Неопределено, если заголовок не
// dBase III или не читается. Из потока читаются 32 байта и описание полей; файл целиком в буфер не копируется.
Функция ИменаПолейИзЗаголовка(Данные)

	Поток = Неопределено;
	Попытка
		Размер = Данные.Размер();
		Если Размер < 33 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поток = Данные.ОткрытьПотокДляЧтения();
		Начало = Новый БуферДвоичныхДанных(32);
		Если Поток.Прочитать(Начало, 0, 32) < 32 Или Начало[0] <> 3 Тогда
			Поток.Закрыть();
			Возврат Неопределено;
		КонецЕсли;
		ДлинаЗаголовка = Начало.ПрочитатьЦелое16(8, ПорядокБайтов.LittleEndian);
		// 255 полей по 32 байта - предел dBase III; больше - не наш файл.
		Если ДлинаЗаголовка < 33 Или ДлинаЗаголовка > 8300 Или ДлинаЗаголовка > Размер Тогда
			Поток.Закрыть();
			Возврат Неопределено;
		КонецЕсли;
		Описание = Новый БуферДвоичныхДанных(ДлинаЗаголовка - 32);
		Прочитано = 0;
		Пока Прочитано < Описание.Размер Цикл
			Порция = Поток.Прочитать(Описание, Прочитано, Описание.Размер - Прочитано);
			Если Порция = 0 Тогда
				Прервать;
			КонецЕсли;
			Прочитано = Прочитано + Порция;
		КонецЦикла;
		Поток.Закрыть();
		Поток = Неопределено;
		Если Прочитано < Описание.Размер Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ИменаПолейИзОписания(Описание);
	Исключение
		Если Поток <> Неопределено Тогда
			Попытка
				Поток.Закрыть();
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Описание полей (после 32 байт заголовка): по 32 байта на поле, последний байт - терминатор 13.
Функция ИменаПолейИзОписания(Описание)

	Если Описание[Описание.Размер - 1] <> 13 Или (Описание.Размер - 1) % 32 <> 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имена = Новый Соответствие;
	Для Позиция = 0 По (Описание.Размер - 1) / 32 - 1 Цикл
		Смещение = Позиция * 32;
		Длина = 0;
		Пока Длина < 11 И Описание[Смещение + Длина] <> 0 Цикл
			Длина = Длина + 1;
		КонецЦикла;
		Если Длина = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имя = ВРег(ПолучитьСтрокуИзБуфераДвоичныхДанных(Описание.ПолучитьСрез(Смещение, Длина), Кодировка()));
		Если Имена[Имя] <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имена.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Значение поля записи, пробелы по краям сняты.
Функция Поле(Поля, Имя)

	Значение = Поля[Имя];
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);

КонецФункции

// Разбирает запись в структуру операции или возвращает Неопределено, дописав в диагностику «Ошибка» по каждому
// нераспознанному значению (запись в Операции не попадает).
Функция РазобратьЗапись(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = НижнийРегистрИмен(Запись.Поля);
	Ошибок = 0;

	// Дата: поле типа D, ррррммдд; времени в файле нет.
	СырьеДаты = Поле(Поля, "dt");
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "ррррммдд");
	Если ДатаОперации = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Запись не прочитана: не удалось разобрать дату операции: «%1».';
				|uk = 'Запис не прочитано: не вдалося розібрати дату операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Направление - строго по dk.
	СырьеНаправления = Поле(Поля, "dk");
	Поступило = Ложь;
	Если СырьеНаправления = "1" Тогда
		Поступило = Истина;
	ИначеЕсли СырьеНаправления <> "0" Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Запись не прочитана: неизвестный признак направления dk: «%1», ожидалось 0 или 1.';
				|uk = 'Запис не прочитано: невідома ознака напряму dk: «%1», очікувалось 0 або 1.'"),
			СырьеНаправления));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Сумма - гривны с точкой.
	СырьеСуммы = Поле(Поля, "summa");
	Сумма = СМП_ЧтениеВыписокОбщее.РазобратьСумму(СырьеСуммы);
	Если Сумма = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Запись не прочитана: не удалось разобрать сумму: «%1».';
				|uk = 'Запис не прочитано: не вдалося розібрати суму: «%1».'"),
			СырьеСуммы));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Валюта - числовой код; пустой - валюта счета.
	СырьеВалюты = Поле(Поля, "val");
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Запись не прочитана: не удалось разобрать код валюты: «%1».';
				|uk = 'Запис не прочитано: не вдалося розібрати код валюти: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", Поле(Поля, "acccli"));
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", Поле(Поля, "ndoc"));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", ?(Поступило, "Поступило", "Списано"));
	Операция.Вставить("КонтрагентНаименование", Поле(Поля, "namecor"));
	Операция.Вставить("КонтрагентНомерСчета", Поле(Поля, "acccor"));
	Операция.Вставить("КонтрагентКод", Поле(Поля, "okpocor"));
	Операция.Вставить("КонтрагентМФО", Поле(Поля, "mfocor"));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(СтрЗаменить(?(Поля["nazn"] = Неопределено, "", Поля["nazn"]), Символы.ПС, " ")));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

Процедура ДобавитьСообщение(Выписка, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

#КонецОбласти
