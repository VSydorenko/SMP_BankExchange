// Контракт читателя выписок (спека D27, D28): конверт выписки, параметры чтения и проверка
// описания читателя.
//
// Модуль намеренно не ссылается на объекты конфигурации (справочники, документы,
// перечисления, ссылки): только типы платформы. Благодаря этому тот же контракт переносится
// копией в другие конфигурации (D29), а внешняя обработка-читатель работает в любой из них.
//
// Схему конверта определяет ЕДИНСТВЕННЫЙ конструктор НоваяВыписка (D28). Проверка конверта
// на границе платформы сравнивает его со свежим НоваяВыписка(), а не с отдельным перечнем.
//
// Читатель не знает модулей расширения (D28), поэтому литералы контракта ("Поступило",
// "Списано", "Ошибка", "Предупреждение") в его документации приводятся буквально; функции
// модуля с теми же значениями нужны только коду платформы.

#Область ПрограммныйИнтерфейс

// Версия контракта читателя, которую знает платформа.
//
// Возвращаемое значение:
//  Число - целое; текущая версия - 1.
Функция ВерсияКонтракта() Экспорт

	Возврат 1;

КонецФункции

// Версии контракта, которые платформа умеет принимать от читателей.
// Совместимость версий - только добавлением колонок; изменение или удаление - новая версия.
//
// Возвращаемое значение:
//  Массив из Число - целые версии.
Функция ПоддерживаемыеВерсииКонтракта() Экспорт

	Версии = Новый Массив;
	Версии.Добавить(1);
	Возврат Версии;

КонецФункции

// Значение колонки Операции.Направление для поступления средств (ISO CRDT).
//
// Возвращаемое значение:
//  Строка - "Поступило".
Функция НаправлениеПоступило() Экспорт

	Возврат "Поступило";

КонецФункции

// Значение колонки Операции.Направление для списания средств (ISO DBIT).
//
// Возвращаемое значение:
//  Строка - "Списано".
Функция НаправлениеСписано() Экспорт

	Возврат "Списано";

КонецФункции

// Значение колонки Диагностика.Уровень для ошибки.
//
// Возвращаемое значение:
//  Строка - "Ошибка".
Функция УровеньОшибка() Экспорт

	Возврат "Ошибка";

КонецФункции

// Значение колонки Диагностика.Уровень для предупреждения.
//
// Возвращаемое значение:
//  Строка - "Предупреждение".
Функция УровеньПредупреждение() Экспорт

	Возврат "Предупреждение";

КонецФункции

// Новый пустой конверт выписки. Создает платформа; читатель только заполняет.
// Каждый вызов возвращает независимый объект (таблицы создаются заново).
//
// Возвращаемое значение:
//  Структура - конверт:
//   * ВерсияКонтракта - Число - версия контракта; ставит платформа.
//   * НачалоПериода - Дата - начало периода выписки; заполняет читатель.
//   * КонецПериода - Дата - конец периода выписки; заполняет читатель.
//   * НачальныйОстаток - Число, Неопределено - остаток на начало; читатель, если ДаетОстатки.
//   * КонечныйОстаток - Число, Неопределено - остаток на конец; читатель, если ДаетОстатки.
//   * ЧтениеПолное - Булево - Истина, только когда читатель прочитал источник целиком.
//     По умолчанию Ложь: читатель, упавший посередине, не должен выглядеть полным.
//   * ГраницаДоверия - Дата - момент, до которого данные окончательны (D18); пустая для файлов.
//   * Диагностика - ТаблицаЗначений - сообщения читателя и платформы:
//    ** Уровень - Строка - "Ошибка" или "Предупреждение".
//    ** ПорядковыйНомер - Число - позиция в источнике, к которой относится сообщение (0 - ко всей выписке).
//    ** Текст - Строка - текст сообщения.
//   * Операции - ТаблицаЗначений - операции выписки (колонки описаны в теле конструктора).
Функция НоваяВыписка() Экспорт

	Выписка = Новый Структура;

	// Версию ставит платформа, читатель ее не меняет.
	Выписка.Вставить("ВерсияКонтракта", ВерсияКонтракта());

	Выписка.Вставить("НачалоПериода", Дата(1, 1, 1));
	Выписка.Вставить("КонецПериода", Дата(1, 1, 1));

	// Остатки необязательны (читатель с ДаетОстатки = Ложь их не заполняет).
	// Знак не ограничен: овердрафт дает отрицательный остаток, поэтому это Число или Неопределено.
	Выписка.Вставить("НачальныйОстаток", Неопределено);
	Выписка.Вставить("КонечныйОстаток", Неопределено);

	// Истина - только когда прочитан весь источник. Курсор этапа 5 не должен перешагнуть
	// потерянные операции, поэтому значение по умолчанию - Ложь.
	Выписка.Вставить("ЧтениеПолное", Ложь);

	// Для API - до какого момента данные окончательны (D18); для файлов остается пустой.
	Выписка.Вставить("ГраницаДоверия", Дата(1, 1, 1));

	Выписка.Вставить("Диагностика", НоваяТаблицаДиагностики());
	Выписка.Вставить("Операции", НоваяТаблицаОпераций());

	Возврат Выписка;

КонецФункции

// Новая структура параметров чтения.
//
// Возвращаемое значение:
//  Структура - параметры чтения:
//   * НомерСчета - Строка - наш счет (IBAN или старый номер), для которого читается выписка.
//   * Кодировка - Строка - кодировка файла; пустая - читатель определяет сам.
//   * НачалоПериода - Дата - начало запрашиваемого периода (для API).
//   * КонецПериода - Дата - конец запрашиваемого периода (для API).
//   * УчетныеДанные - Неопределено - состав определяет этап 5 для коннекторов.
Функция НовыеПараметрыЧтения() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("НомерСчета", "");
	Параметры.Вставить("Кодировка", "");
	Параметры.Вставить("НачалоПериода", Дата(1, 1, 1));
	Параметры.Вставить("КонецПериода", Дата(1, 1, 1));
	Параметры.Вставить("УчетныеДанные", Неопределено);
	Возврат Параметры;

КонецФункции

// Проверка описания читателя. Нарушения не бросают исключение: каждое - текст в массиве,
// понятный администратору (D2, D31).
//
// Параметры:
//  Описание - Структура - описание читателя:
//   * Идентификатор - Строка - непустой.
//   * ВерсияКонтракта - Число - целое из ПоддерживаемыеВерсииКонтракта().
//   * Наименование - Строка - наименование читателя.
//   * РасширенияФайлов - Массив из Строка - без точки, в нижнем регистре; пустой - для API.
//   * ДаетИдентификаторыОпераций - Булево.
//   * ДаетОстатки - Булево.
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок; пустой массив - описание корректно.
Функция ПроверитьОписаниеЧитателя(Описание) Экспорт

	Ошибки = Новый Массив;

	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		Ошибки.Добавить(НСтр("ru = 'Описание читателя должно быть структурой.';
			|uk = 'Опис читача має бути структурою.'"));
		Возврат Ошибки;
	КонецЕсли;

	Для Каждого ИмяПоля Из ОбязательныеПоляОписания() Цикл
		Если Не Описание.Свойство(ИмяПоля) Тогда
			Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'В описании читателя нет обязательного поля %1.';
					|uk = 'В описі читача немає обов''язкового поля %1.'"),
				ИмяПоля));
		КонецЕсли;
	КонецЦикла;

	Если Описание.Свойство("Идентификатор") Тогда
		Если ТипЗнч(Описание.Идентификатор) <> Тип("Строка") Или ПустаяСтрока(Описание.Идентификатор) Тогда
			Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'Поле %1 описания читателя должно быть непустой строкой.';
					|uk = 'Поле %1 опису читача має бути непорожнім рядком.'"),
				"Идентификатор"));
		КонецЕсли;
	КонецЕсли;

	Если Описание.Свойство("ВерсияКонтракта") Тогда
		ПроверитьВерсиюВОписании(Описание.ВерсияКонтракта, Ошибки);
	КонецЕсли;

	Если Описание.Свойство("Наименование") Тогда
		Если ТипЗнч(Описание.Наименование) <> Тип("Строка") Тогда
			Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'Поле %1 описания читателя должно быть строкой.';
					|uk = 'Поле %1 опису читача має бути рядком.'"),
				"Наименование"));
		КонецЕсли;
	КонецЕсли;

	Если Описание.Свойство("РасширенияФайлов") Тогда
		ПроверитьРасширенияВОписании(Описание.РасширенияФайлов, Ошибки);
	КонецЕсли;

	Для Каждого ИмяПоля Из СтрРазделить("ДаетИдентификаторыОпераций,ДаетОстатки", ",") Цикл
		Если Описание.Свойство(ИмяПоля) И ТипЗнч(Описание[ИмяПоля]) <> Тип("Булево") Тогда
			Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'Поле %1 описания читателя должно быть Булево.';
					|uk = 'Поле %1 опису читача має бути Булево.'"),
				ИмяПоля));
		КонецЕсли;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// Предельная длина колонки Операции.ИдентификаторОперации: столько символов вмещает
// идентификатор транзакции банка в хранилище платформы (D28). Более длинный идентификатор -
// невалидная строка, а не тихое обрезание.
//
// Возвращаемое значение:
//  Число - целое; 50.
Функция МаксимальнаяДлинаИдентификатораОперации() Экспорт

	Возврат 50;

КонецФункции

// Проверка конверта на границе платформы (D3, D28). Чистая функция: ничего не пишет в базу,
// не обращается к объектам конфигурации и не изменяет конверт читателя.
//
// Конверт отклоняется целиком, если читатель подменил объект, изменил версию контракта или
// схему таблиц Операции / Диагностика. Иначе каждая невалидная строка операции отбрасывается
// с записью в диагностику, а остальные попадают в результат. Платформа ничего не исправляет:
// не обрезает идентификатор, не берет модуль суммы, не подставляет дату.
// Нулевой ПорядковыйНомер - не ошибка: в результате ему присваивается номер строки таблицы
// (с единицы), чтобы у диагностики был адрес.
// Сообщение читателя с уровнем не из контракта ("ошибка", "Error", пустой) не толкуется молча:
// платформа добавляет свое сообщение "Ошибка", а ЕстьНевалидныеСтроки становится Истина.
//
// Параметры:
//  Выписка - Структура - конверт после чтения (см. НоваяВыписка).
//  СозданнаяПлатформой - Структура - конверт, который платформа создала и передала читателю.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Принята - Булево - Ложь, если конверт отклонен целиком.
//   * Операции - ТаблицаЗначений - новая таблица схемы НоваяВыписка().Операции только с валидными строками.
//   * Диагностика - ТаблицаЗначений - диагностика читателя и найденное платформой (схема Диагностика).
//   * ЕстьНевалидныеСтроки - Булево - Истина, если отброшена хоть одна строка или читатель записал "Ошибка".
//   * СозданнаяПлатформой - Структура - конверт, который платформа держала до вызова читателя.
Функция ПроверитьВыписку(Выписка, СозданнаяПлатформой) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("Операции", НоваяТаблицаОпераций());
	Результат.Вставить("Диагностика", НоваяТаблицаДиагностики());
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);
	Результат.Вставить("СозданнаяПлатформой", СозданнаяПлатформой);

	Причины = ПричиныОтказаКонверта(Выписка, СозданнаяПлатформой);

	// Диагностика читателя сохраняется, если ее таблица не нарушает схему.
	// У подмененного объекта она чужая, ее платформа не знает.
	Если Выписка = СозданнаяПлатформой Тогда
		ДиагностикаЧитателя = ДиагностикаЧитателяСоСхемойКонтракта(Выписка);
		Если ДиагностикаЧитателя <> Неопределено Тогда
			Для Каждого Сообщение Из ДиагностикаЧитателя Цикл
				ДобавитьСообщениеДиагностики(Результат.Диагностика, Сообщение.Уровень, Сообщение.ПорядковыйНомер, Сообщение.Текст);
				Если Сообщение.Уровень = УровеньОшибка() Тогда
					Результат.ЕстьНевалидныеСтроки = Истина;
				ИначеЕсли Сообщение.Уровень <> УровеньПредупреждение() Тогда
					// Уровень не из контракта (в том числе в другом регистре или пустой) не
					// перетолковывается молча: ошибка читателя должна быть видимой.
					Результат.ЕстьНевалидныеСтроки = Истина;
					ДобавитьСообщениеДиагностики(Результат.Диагностика, УровеньОшибка(), Сообщение.ПорядковыйНомер,
						СтрШаблон(НСтр("ru = 'Уровень не из контракта: ""%1"", строка %2. Допустимы ""Ошибка"" и ""Предупреждение"".';
							|uk = 'Рівень не з контракту: ""%1"", рядок %2. Допустимі ""Ошибка"" і ""Предупреждение"".'"),
							Сообщение.Уровень, Формат(Сообщение.ПорядковыйНомер, "ЧН=0; ЧГ=")));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если Причины.Количество() > 0 Тогда
		// Отклоненное чтение не может считаться полным для курсора (D28).
		Результат.ЕстьНевалидныеСтроки = Истина;
		Для Каждого Причина Из Причины Цикл
			ДобавитьСообщениеДиагностики(Результат.Диагностика, УровеньОшибка(), 0, Причина);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Результат.Принята = Истина;

	Для Индекс = 0 По Выписка.Операции.Количество() - 1 Цикл
		Операция = Выписка.Операции[Индекс];
		Номер = ?(Операция.ПорядковыйНомер = 0, Индекс + 1, Операция.ПорядковыйНомер);

		Нарушения = НарушенияСтрокиОперации(Операция, Номер);
		Если Нарушения.Количество() = 0 Тогда
			НоваяСтрока = Результат.Операции.Добавить();
			Для Каждого Колонка Из Результат.Операции.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = Операция[Колонка.Имя];
			КонецЦикла;
			НоваяСтрока.ПорядковыйНомер = Номер;
		Иначе
			Результат.ЕстьНевалидныеСтроки = Истина;
			Для Каждого Нарушение Из Нарушения Цикл
				ДобавитьСообщениеДиагностики(Результат.Диагностика, УровеньОшибка(), Номер, Нарушение);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена обязательных полей описания читателя.
//
// Возвращаемое значение:
//  Массив из Строка - имена полей.
Функция ОбязательныеПоляОписания()

	Возврат СтрРазделить(
		"Идентификатор,ВерсияКонтракта,Наименование,РасширенияФайлов,ДаетИдентификаторыОпераций,ДаетОстатки",
		",");

КонецФункции

// Проверяет поле ВерсияКонтракта описания читателя: целое число из поддерживаемых версий.
// Нарушение дописывается в Ошибки текстом, называющим поле, пришедшую и поддерживаемые версии.
//
// Параметры:
//  Версия - Произвольный - значение поля ВерсияКонтракта описания.
//  Ошибки - Массив из Строка - накопитель текстов ошибок.
Процедура ПроверитьВерсиюВОписании(Версия, Ошибки)

	Если ТипЗнч(Версия) <> Тип("Число") Или Версия <> Цел(Версия) Тогда
		Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Поле %1 описания читателя должно быть целым числом.';
				|uk = 'Поле %1 опису читача має бути цілим числом.'"),
			"ВерсияКонтракта"));
		Возврат;
	КонецЕсли;

	Поддерживаемые = ПоддерживаемыеВерсииКонтракта();
	Если Поддерживаемые.Найти(Версия) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Список = Новый Массив;
	Для Каждого Поддерживаемая Из Поддерживаемые Цикл
		Список.Добавить(Формат(Поддерживаемая, "ЧН=0; ЧГ="));
	КонецЦикла;

	Ошибки.Добавить(СтрШаблон(
		НСтр("ru = 'Поле %1: читатель использует версию контракта %2, платформа поддерживает версии: %3.';
			|uk = 'Поле %1: читач використовує версію контракту %2, платформа підтримує версії: %3.'"),
		"ВерсияКонтракта", Формат(Версия, "ЧН=0; ЧГ="), СтрСоединить(Список, ", ")));

КонецПроцедуры

// Проверяет поле РасширенияФайлов описания читателя: массив непустых строк без точки и
// пробелов в нижнем регистре; пустой массив допустим (читатель API).
// Каждое недопустимое расширение дописывается в Ошибки отдельным текстом.
//
// Параметры:
//  Расширения - Произвольный - значение поля РасширенияФайлов описания.
//  Ошибки - Массив из Строка - накопитель текстов ошибок.
Процедура ПроверитьРасширенияВОписании(Расширения, Ошибки)

	Если ТипЗнч(Расширения) <> Тип("Массив") Тогда
		Ошибки.Добавить(СтрШаблон(
			НСтр("ru = 'Поле %1 описания читателя должно быть массивом строк.';
				|uk = 'Поле %1 опису читача має бути масивом рядків.'"),
			"РасширенияФайлов"));
		Возврат;
	КонецЕсли;

	Для Каждого Расширение Из Расширения Цикл
		Если ТипЗнч(Расширение) <> Тип("Строка") Или ПустаяСтрока(Расширение)
			Или СтрНайти(Расширение, ".") > 0
			Или СтрНайти(Расширение, " ") > 0
			Или Расширение <> НРег(Расширение) Тогда
			Ошибки.Добавить(СтрШаблон(
				НСтр("ru = 'Поле %1: расширение ""%2"" недопустимо; нужна непустая строка без точки и пробелов в нижнем регистре.';
					|uk = 'Поле %1: розширення ""%2"" неприпустиме; потрібен непорожній рядок без крапки й пробілів у нижньому регістрі.'"),
				"РасширенияФайлов", Строка(Расширение)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Причины, по которым конверт отклоняется целиком: подмена объекта, изменение версии
// контракта, нарушение схемы таблиц Операции / Диагностика. Схема сравнивается со свежим
// НоваяВыписка() - единственным источником правды. Конверт читателя не изменяется.
//
// Параметры:
//  Выписка - Произвольный - то, что вернул читатель.
//  СозданнаяПлатформой - Структура - конверт, созданный платформой.
//
// Возвращаемое значение:
//  Массив из Строка - тексты причин; пустой массив - конверт можно проверять построчно.
Функция ПричиныОтказаКонверта(Выписка, СозданнаяПлатформой)

	Причины = Новый Массив;

	// Для объектов платформы равенство - тождество: чужой конверт, построенный тем же
	// конструктором, не равен конверту платформы.
	Если Выписка <> СозданнаяПлатформой Тогда
		Причины.Добавить(НСтр("ru = 'Читатель вернул не тот конверт выписки, который создала платформа (подмена объекта). Конверт отклонен.';
			|uk = 'Читач повернув не той конверт виписки, який створила платформа (підміна об''єкта). Конверт відхилено.'"));
		Возврат Причины;
	КонецЕсли;

	Если ТипЗнч(Выписка) <> Тип("Структура") Тогда
		Причины.Добавить(СтрШаблон(
			НСтр("ru = 'Конверт выписки должен быть структурой, получено: %1. Конверт отклонен.';
				|uk = 'Конверт виписки має бути структурою, отримано: %1. Конверт відхилено.'"),
			Строка(ТипЗнч(Выписка))));
		Возврат Причины;
	КонецЕсли;

	Если Не Выписка.Свойство("ВерсияКонтракта") Тогда
		Причины.Добавить(СтрШаблон(
			НСтр("ru = 'В конверте нет поля %1. Конверт отклонен.';
				|uk = 'В конверті немає поля %1. Конверт відхилено.'"),
			"ВерсияКонтракта"));
	ИначеЕсли ТипЗнч(Выписка.ВерсияКонтракта) <> Тип("Число") Или Выписка.ВерсияКонтракта <> ВерсияКонтракта() Тогда
		Причины.Добавить(СтрШаблон(
			НСтр("ru = 'Поле %1: читатель изменил версию контракта на ""%2"", платформа ожидает %3. Конверт отклонен.';
				|uk = 'Поле %1: читач змінив версію контракту на ""%2"", платформа очікує %3. Конверт відхилено.'"),
			"ВерсияКонтракта", Строка(Выписка.ВерсияКонтракта), Формат(ВерсияКонтракта(), "ЧН=0; ЧГ=")));
	КонецЕсли;

	Эталон = НоваяВыписка();
	Для Каждого ИмяТаблицы Из СтрРазделить("Операции,Диагностика", ",") Цикл
		Если Не Выписка.Свойство(ИмяТаблицы) Или ТипЗнч(Выписка[ИмяТаблицы]) <> Тип("ТаблицаЗначений") Тогда
			Причины.Добавить(СтрШаблон(
				НСтр("ru = 'Поле %1 конверта должно быть таблицей значений, получено: %2. Конверт отклонен.';
					|uk = 'Поле %1 конверта має бути таблицею значень, отримано: %2. Конверт відхилено.'"),
				ИмяТаблицы, ?(Выписка.Свойство(ИмяТаблицы), Строка(ТипЗнч(Выписка[ИмяТаблицы])), "поле отсутствует")));
			Продолжить;
		КонецЕсли;
		Для Каждого Различие Из РазличияСхемыТаблицы(Эталон[ИмяТаблицы], Выписка[ИмяТаблицы], ИмяТаблицы) Цикл
			Причины.Добавить(Различие);
		КонецЦикла;
	КонецЦикла;

	Возврат Причины;

КонецФункции

// Различия колонок таблицы с эталоном: набор имен и тип каждой колонки с квалификаторами.
// Порядок колонок не сравнивается: читатель обращается к колонкам по имени.
//
// Параметры:
//  Эталон - ТаблицаЗначений - таблица свежего конверта.
//  Таблица - ТаблицаЗначений - проверяемая таблица.
//  ИмяТаблицы - Строка - имя таблицы для текста сообщения.
//
// Возвращаемое значение:
//  Массив из Строка - тексты различий, каждый заканчивается решением об отклонении конверта.
Функция РазличияСхемыТаблицы(Эталон, Таблица, ИмяТаблицы)

	Различия = Новый Массив;

	Для Каждого КолонкаЭталона Из Эталон.Колонки Цикл
		Колонка = Таблица.Колонки.Найти(КолонкаЭталона.Имя);
		Если Колонка = Неопределено Тогда
			Различия.Добавить(СтрШаблон(
				НСтр("ru = 'Таблица %1: нет колонки %2. Конверт отклонен.';
					|uk = 'Таблиця %1: немає колонки %2. Конверт відхилено.'"),
				ИмяТаблицы, КолонкаЭталона.Имя));
			Продолжить;
		КонецЕсли;

		ОжидаемыйТип = ОписаниеТипаСтрокой(КолонкаЭталона.ТипЗначения);
		ПришедшийТип = ОписаниеТипаСтрокой(Колонка.ТипЗначения);
		Если ОжидаемыйТип <> ПришедшийТип Тогда
			Различия.Добавить(СтрШаблон(
				НСтр("ru = 'Таблица %1: колонка %2 имеет тип %3, ожидался %4. Конверт отклонен.';
					|uk = 'Таблиця %1: колонка %2 має тип %3, очікувався %4. Конверт відхилено.'"),
				ИмяТаблицы, КолонкаЭталона.Имя, ПришедшийТип, ОжидаемыйТип));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Эталон.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Различия.Добавить(СтрШаблон(
				НСтр("ru = 'Таблица %1: лишняя колонка %2, которой нет в контракте. Конверт отклонен.';
					|uk = 'Таблиця %1: зайва колонка %2, якої немає в контракті. Конверт відхилено.'"),
				ИмяТаблицы, Колонка.Имя));
		КонецЕсли;
	КонецЦикла;

	Возврат Различия;

КонецФункции

// Текстовое описание типа колонки вместе с квалификаторами - для сравнения и сообщений.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов - тип колонки.
//
// Возвращаемое значение:
//  Строка - например "Число(15,2,Любой)".
Функция ОписаниеТипаСтрокой(ОписаниеТипов)

	Части = Новый Массив;
	Для Каждого ТипКолонки Из ОписаниеТипов.Типы() Цикл
		Если ТипКолонки = Тип("Строка") Тогда
			Квалификаторы = ОписаниеТипов.КвалификаторыСтроки;
			Части.Добавить("Строка(" + Формат(Квалификаторы.Длина, "ЧН=0; ЧГ=") + ","
				+ Строка(Квалификаторы.ДопустимаяДлина) + ")");
		ИначеЕсли ТипКолонки = Тип("Число") Тогда
			Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
			Части.Добавить("Число(" + Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=") + ","
				+ Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=") + ","
				+ Строка(Квалификаторы.ДопустимыйЗнак) + ")");
		ИначеЕсли ТипКолонки = Тип("Дата") Тогда
			Части.Добавить("Дата(" + Строка(ОписаниеТипов.КвалификаторыДаты.ЧастиДаты) + ")");
		Иначе
			Части.Добавить(Строка(ТипКолонки));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, " или ");

КонецФункции

// Таблица диагностики читателя, если ее схема совпадает с контрактом; иначе Неопределено
// (в такую таблицу платформа не заглядывает).
//
// Параметры:
//  Выписка - Произвольный - конверт читателя.
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - диагностика читателя.
Функция ДиагностикаЧитателяСоСхемойКонтракта(Выписка)

	Если ТипЗнч(Выписка) <> Тип("Структура") Или Не Выписка.Свойство("Диагностика")
		Или ТипЗнч(Выписка.Диагностика) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если РазличияСхемыТаблицы(НоваяТаблицаДиагностики(), Выписка.Диагностика, "Диагностика").Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выписка.Диагностика;

КонецФункции

// Дописывает сообщение в таблицу диагностики.
//
// Параметры:
//  Диагностика - ТаблицаЗначений - таблица схемы Диагностика.
//  Уровень - Строка - "Ошибка" или "Предупреждение".
//  ПорядковыйНомер - Число - позиция операции в источнике; 0 - вся выписка.
//  Текст - Строка - текст сообщения.
Процедура ДобавитьСообщениеДиагностики(Диагностика, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

// Нарушения одной строки операции. Строка с нарушением отбрасывается целиком; платформа
// ничего не исправляет и не угадывает. Пустые контрагент, код, МФО, назначение, номер и дата
// документа допустимы: комиссия банка не имеет контрагента, но остается документом (D3).
//
// Параметры:
//  Операция - СтрокаТаблицыЗначений - строка таблицы Операции.
//  Номер - Число - адрес строки для текста сообщения.
//
// Возвращаемое значение:
//  Массив из Строка - тексты нарушений; пустой массив - строка валидна.
Функция НарушенияСтрокиОперации(Операция, Номер)

	Нарушения = Новый Массив;
	Адрес = Формат(Номер, "ЧН=0; ЧГ=");

	Если Операция.ДатаОперации = Дата(1, 1, 1) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 не заполнено (пустая дата), ожидалась дата операции.';
				|uk = 'Операція %1: поле %2 не заповнено (порожня дата), очікувалась дата операції.'"),
			Адрес, "ДатаОперации"));
	КонецЕсли;

	Если Операция.Сумма <= 0 Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 равно %3, ожидалась сумма больше нуля.';
				|uk = 'Операція %1: поле %2 дорівнює %3, очікувалась сума більша за нуль.'"),
			Адрес, "Сумма", Формат(Операция.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=; ЧН=0")));

		// Типизированная колонка молча превращает нераспознанное значение в 0: нулевая сумма
		// чаще всего след дефекта читателя, а не реальной операции. Подсказка - в том же сообщении.
		Если Операция.Сумма = 0 Тогда
			Нарушения[Нарушения.ВГраница()] = Нарушения[Нарушения.ВГраница()] + " "
				+ НСтр("ru = 'Значение 0 может означать, что читатель не разобрал сумму в источнике.';
					|uk = 'Значення 0 може означати, що читач не розібрав суму в джерелі.'");
		КонецЕсли;
	КонецЕсли;

	Если Операция.Направление <> НаправлениеПоступило() И Операция.Направление <> НаправлениеСписано() Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 равно ""%3"", ожидалось ""%4"" или ""%5"".';
				|uk = 'Операція %1: поле %2 дорівнює ""%3"", очікувалось ""%4"" або ""%5"".'"),
			Адрес, "Направление", Операция.Направление, НаправлениеПоступило(), НаправлениеСписано()));
	КонецЕсли;

	Если Не ПустаяСтрока(Операция.Валюта) И Не ЭтоЧисловойКодВалюты(Операция.Валюта) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 равно ""%3"", ожидался числовой код ISO 4217 из трех цифр (например, ""980"") или пустое значение.';
				|uk = 'Операція %1: поле %2 дорівнює ""%3"", очікувався числовий код ISO 4217 із трьох цифр (наприклад, ""980"") або порожнє значення.'"),
			Адрес, "Валюта", Операция.Валюта));
	КонецЕсли;

	Если ПустаяСтрока(Операция.НомерСчета) Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 не заполнено, ожидался номер счета (IBAN или старый номер).';
				|uk = 'Операція %1: поле %2 не заповнено, очікувався номер рахунку (IBAN або старий номер).'"),
			Адрес, "НомерСчета"));
	КонецЕсли;

	Если СтрДлина(Операция.ИдентификаторОперации) > МаксимальнаяДлинаИдентификатораОперации() Тогда
		Нарушения.Добавить(СтрШаблон(
			НСтр("ru = 'Операция %1: поле %2 имеет длину %3 символов, допустимо не более %4. Значение: ""%5"".';
				|uk = 'Операція %1: поле %2 має довжину %3 символів, допустимо не більше %4. Значення: ""%5"".'"),
			Адрес, "ИдентификаторОперации", Формат(СтрДлина(Операция.ИдентификаторОперации), "ЧН=0; ЧГ="),
			Формат(МаксимальнаяДлинаИдентификатораОперации(), "ЧН=0; ЧГ="), Операция.ИдентификаторОперации));
	КонецЕсли;

	Возврат Нарушения;

КонецФункции

// Признак числового кода валюты ISO 4217: ровно три десятичные цифры.
//
// Параметры:
//  Значение - Строка - значение колонки Валюта.
//
// Возвращаемое значение:
//  Булево - Истина, если значение состоит ровно из трех цифр.
Функция ЭтоЧисловойКодВалюты(Значение)

	Если СтрДлина(Значение) <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По 3 Цикл
		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Таблица диагностики конверта.
//
// Возвращаемое значение:
//  ТаблицаЗначений - пустая таблица с колонками Уровень, ПорядковыйНомер, Текст.
Функция НоваяТаблицаДиагностики()

	Таблица = Новый ТаблицаЗначений;

	// "Ошибка" или "Предупреждение" (УровеньОшибка(), УровеньПредупреждение()).
	Таблица.Колонки.Добавить("Уровень", ОписаниеСтрокиБезОграничения());

	// Позиция в источнике, к которой относится сообщение; 0 - ко всей выписке.
	Таблица.Колонки.Добавить("ПорядковыйНомер", ОписаниеЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));

	// Текст сообщения для администратора.
	Таблица.Колонки.Добавить("Текст", ОписаниеСтрокиБезОграничения());

	Возврат Таблица;

КонецФункции

// Таблица операций конверта. Порядок и состав колонок - контракт D28.
// Все строковые колонки без ограничения длины: Строка(N) молча обрезала бы значение,
// а длину проверяет платформа с записью в диагностику.
//
// Возвращаемое значение:
//  ТаблицаЗначений - пустая таблица операций с колонками контракта.
Функция НоваяТаблицаОпераций()

	Таблица = Новый ТаблицаЗначений;
	Колонки = Таблица.Колонки;

	// Позиция операции в источнике (для диагностики и протокола).
	Колонки.Добавить("ПорядковыйНомер", ОписаниеЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));

	// Наш счет, по которому прочитана операция: IBAN или старый номер.
	Колонки.Добавить("НомерСчета", ОписаниеСтрокиБезОграничения());

	// Числовой код ISO 4217 тремя цифрами ("980") либо пусто - валюта счета.
	// Буквенный код читатель переводит сам.
	Колонки.Добавить("Валюта", ОписаниеСтрокиБезОграничения());

	// Дата и время операции; пустая дата - строка невалидна (диагностика).
	Колонки.Добавить("ДатаОперации", ОписаниеДаты(ЧастиДаты.ДатаВремя));

	// Номер платежного документа в выписке.
	Колонки.Добавить("НомерДокумента", ОписаниеСтрокиБезОграничения());

	// Дата платежного документа: только день, без времени (часть ключа дедупликации, D17).
	Колонки.Добавить("ДатаДокумента", ОписаниеДаты(ЧастиДаты.Дата));

	// Сумма операции, строго больше нуля. Знак Любой: отрицательную или нулевую сумму
	// платформа отвергает с записью в диагностику, а не молча превращает в ноль.
	Колонки.Добавить("Сумма", ОписаниеЧисла(15, 2, ДопустимыйЗнак.Любой));

	// "Поступило" (CRDT) или "Списано" (DBIT); иное значение - диагностика.
	Колонки.Добавить("Направление", ОписаниеСтрокиБезОграничения());

	// Идентификатор операции в банке, если банк его дает (иначе пусто).
	Колонки.Добавить("ИдентификаторОперации", ОписаниеСтрокиБезОграничения());

	// Наименование контрагента.
	Колонки.Добавить("КонтрагентНаименование", ОписаниеСтрокиБезОграничения());

	// Счет контрагента (IBAN или старый номер).
	Колонки.Добавить("КонтрагентНомерСчета", ОписаниеСтрокиБезОграничения());

	// Код контрагента: ЕДРПОУ или ИНН.
	Колонки.Добавить("КонтрагентКод", ОписаниеСтрокиБезОграничения());

	// МФО банка контрагента.
	Колонки.Добавить("КонтрагентМФО", ОписаниеСтрокиБезОграничения());

	// Назначение платежа как в выписке.
	Колонки.Добавить("НазначениеПлатежа", ОписаниеСтрокиБезОграничения());

	// Исходные данные операции как в источнике (для разбора спорных случаев).
	Колонки.Добавить("СырыеДанные", ОписаниеСтрокиБезОграничения());

	Возврат Таблица;

КонецФункции

// Описание типа Строка без ограничения длины (значение не обрезается).
//
// Возвращаемое значение:
//  ОписаниеТипов - Строка неограниченной длины.
Функция ОписаниеСтрокиБезОграничения()

	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));

КонецФункции

// Описание типа Число с заданными квалификаторами.
//
// Параметры:
//  Разрядность - Число - общее число цифр.
//  РазрядностьДробнойЧасти - Число - число цифр дробной части.
//  Знак - ДопустимыйЗнак - допустимый знак.
//
// Возвращаемое значение:
//  ОписаниеТипов - Число с квалификаторами.
Функция ОписаниеЧисла(Разрядность, РазрядностьДробнойЧасти, Знак)

	Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Разрядность, РазрядностьДробнойЧасти, Знак));

КонецФункции

// Описание типа Дата с заданным составом частей.
//
// Параметры:
//  Части - ЧастиДаты - Дата, Время или ДатаВремя.
//
// Возвращаемое значение:
//  ОписаниеТипов - Дата с квалификатором.
Функция ОписаниеДаты(Части)

	Возврат Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(Части));

КонецФункции

#КонецОбласти
