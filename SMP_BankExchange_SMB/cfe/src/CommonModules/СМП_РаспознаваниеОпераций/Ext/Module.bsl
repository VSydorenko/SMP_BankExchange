// Новый пустой план загрузки.
//
// Возвращаемое значение:
//  Структура - план загрузки:
//   * Операции - ТаблицаЗначений - строка на операцию: все колонки НоваяВыписка().Операции
//     (факты банка) и колонки решений распознавания.
//   * Замечания - ТаблицаЗначений - замечания к строкам:
//    ** ПорядковыйНомер - Число - номер операции в выписке.
//    ** Поле - Строка - имя колонки плана или пустая строка.
//    ** Уровень - Строка - "Ошибка" или "Предупреждение" (СМП_ВыпискаБанка.УровеньОшибка / УровеньПредупреждение).
//    ** Текст - Строка - текст замечания.
Функция НовыйПланЗагрузки() Экспорт

	План = Новый Структура;
	План.Вставить("Операции", НоваяТаблицаОперацийПлана());
	План.Вставить("Замечания", НоваяТаблицаЗамечаний());
	Возврат План;

КонецФункции

// Новый контекст распознавания.
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Организация - СправочникСсылка.Организации - организация, для которой загружается выписка.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - наш банковский счет выписки.
Функция НовыйКонтекстРаспознавания() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Контекст.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Возврат Контекст;

КонецФункции

// Распознает операции выписки. Вход не изменяется, в базу ничего не пишется.
//
// Шаги идут в порядке D25; первый шаг, давший вид операции, ставит ИсточникВидаОперации, следующие шаги
// строку с заполненным источником не трогают. Каждый шаг работает над всем пакетом: ключи всех строк
// собираются заранее, запрос к базе один на шаг, результат раскладывается по строкам. Запрос на строку
// выписки недопустим.
//
// Параметры:
//  Операции - ТаблицаЗначений - операции схемы конверта (валидные строки ПроверитьВыписку).
//  Контекст - Структура - см. НовыйКонтекстРаспознавания.
//
// Возвращаемое значение:
//  Структура - план загрузки, см. НовыйПланЗагрузки.
Функция Распознать(Операции, Контекст) Экспорт

	План = НовыйПланЗагрузки();
	ЗаполнитьФактыБанка(План, Операции, Контекст);

	// Шаги 0-5 (D25) добавляют задачи 3-8 плана 02 строго в этом порядке перед шагом 6:
	//  0 загруженный документ; 1-2 свой счет, сотрудник; 3 платежное поручение;
	//  4 правила назначения; 5 заказ или счет по номеру в назначении.
	ШагЗагруженныйДокумент(План, Контекст);
	ШагЗначениеПоУмолчанию(План);

	Возврат План;

КонецФункции

// Банковский счет организации по номеру: ищет по НомерСчета и НомерСчетаУстаревший среди счетов
// организаций, не помеченных на удаление. Счет контрагента с тем же номером не возвращается.
// Совпадение по текущему номеру предпочитается совпадению по устаревшему.
//
// Параметры:
//  НомерСчета - Строка - номер счета (IBAN или старый).
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - найденный счет; пустая ссылка, если счета нет.
Функция БанковскийСчетОрганизацииПоНомеру(НомерСчета) Экспорт

	Номер = СокрЛП(НомерСчета);
	Если ПустаяСтрока(Номер) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Счета.НомерСчета = &Номер
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И Счета.Владелец ССЫЛКА Справочник.Организации
		|	И (Счета.НомерСчета = &Номер
		|		ИЛИ Счета.НомерСчетаУстаревший = &Номер)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номер", Номер);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СхемаПлана

Функция НоваяТаблицаОперацийПлана()

	Таблица = Новый ТаблицаЗначений;

	// Факты банка - из конструктора контракта, а не переписанным перечнем: новая колонка контракта
	// появляется в плане сама.
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;

	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("БанковскийСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Таблица.Колонки.Добавить("ВидДокумента", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов(
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
	Таблица.Колонки.Добавить("ИсточникВидаОперации", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ЗагруженныйДокумент", Новый ОписаниеТипов(
		"ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета"));
	Таблица.Колонки.Добавить("Контрагент", Новый ОписаниеТипов(
		"СправочникСсылка.Контрагенты, СправочникСсылка.Организации, СправочникСсылка.Сотрудники"));
	Таблица.Колонки.Добавить("СчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Таблица.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Таблица.Колонки.Добавить("ДействиеКонтрагент", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ДействиеСчет", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ДействиеДоговор", ОписаниеСтроки());
	Таблица.Колонки.Добавить("СтатьяДДС", Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Таблица.Колонки.Добавить("ИсточникСтатьи", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Корреспонденция", Новый ОписаниеТипов("ПланСчетовСсылка.Управленческий"));
	Таблица.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("СправочникСсылка.ВидыНалогов"));
	Таблица.Колонки.Добавить("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	Таблица.Колонки.Добавить("ПравилоНазначения", Новый ОписаниеТипов(
		"СправочникСсылка.СоответствияНазначенийПлатежаИРеквизитовПлатежа"));
	Таблица.Колонки.Добавить("ДокументПоНомеру", ТипДокументаПоНомеру());
	Таблица.Колонки.Добавить("ПлатежноеПоручение", Новый ОписаниеТипов("ДокументСсылка.ПлатежноеПоручение"));
	Таблица.Колонки.Добавить("БезНДС", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПроверьтеОперацию", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция НоваяТаблицаЗамечаний()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПорядковыйНомер",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Поле", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Уровень", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Текст", ОписаниеСтроки());
