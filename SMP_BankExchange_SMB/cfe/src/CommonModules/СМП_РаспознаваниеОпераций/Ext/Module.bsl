// Новый пустой план загрузки.
//
// Возвращаемое значение:
//  Структура - план загрузки:
//   * Операции - ТаблицаЗначений - строка на операцию: все колонки НоваяВыписка().Операции
//     (факты банка) и колонки решений распознавания.
//   * Замечания - ТаблицаЗначений - замечания к строкам:
//    ** ПорядковыйНомер - Число - номер операции в выписке.
//    ** Поле - Строка - имя колонки плана или пустая строка.
//    ** Уровень - Строка - "Ошибка" или "Предупреждение" (СМП_ВыпискаБанка.УровеньОшибка / УровеньПредупреждение).
//    ** Текст - Строка - текст замечания.
Функция НовыйПланЗагрузки() Экспорт

	План = Новый Структура;
	План.Вставить("Операции", НоваяТаблицаОперацийПлана());
	План.Вставить("Замечания", НоваяТаблицаЗамечаний());
	Возврат План;

КонецФункции

// Новый контекст распознавания.
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Организация - СправочникСсылка.Организации - организация, для которой загружается выписка.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - наш банковский счет выписки.
//   * КонтрагентБанка - СправочникСсылка.Контрагенты - необязательный (по умолчанию пустой) контрагент банка для комиссии
//     (D35.8): берется для вида "Комиссия банка", когда строка выписки контрагента не дала. Контекст старого вида без этого
//     поля работает как с пустым.
Функция НовыйКонтекстРаспознавания() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Контекст.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Контекст.Вставить("КонтрагентБанка", Справочники.Контрагенты.ПустаяСсылка());
	Возврат Контекст;

КонецФункции

// Распознает операции выписки. Вход не изменяется, в базу ничего не пишется.
//
// Шаги идут в порядке D25; первый шаг, давший вид операции, ставит ИсточникВидаОперации, следующие шаги
// строку с заполненным источником не трогают. Каждый шаг работает над всем пакетом: ключи всех строк
// собираются заранее, запрос к базе один на шаг, результат раскладывается по строкам. Запрос на строку
// выписки недопустим.
//
// Параметры:
//  Операции - ТаблицаЗначений - операции схемы конверта (валидные строки ПроверитьВыписку).
//  Контекст - Структура - см. НовыйКонтекстРаспознавания.
//
// Возвращаемое значение:
//  Структура - план загрузки, см. НовыйПланЗагрузки.
Функция Распознать(Операции, Контекст) Экспорт

	// Пустая организация или банковский счет - ошибка вызывающего кода, а не данных выписки: без них не определить
	// ни "тот же счет" для поиска загруженного документа, ни организацию остальных шагов. Ни одна строка не
	// разбирается.
	Для Каждого ИмяПоля Из СтрРазделить("Организация,БанковскийСчет", ",") Цикл
		Если Не ЗначениеЗаполнено(Контекст[ИмяПоля]) Тогда
			// Текст называет только пустое поле: второе поле контекста в нем не упоминается.
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Распознать: поле контекста ""%1"" не заполнено, оно обязательно.';
				|uk = 'Распознати: поле контексту ""%1"" не заповнено, воно потрібне.'"), ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	План = НовыйПланЗагрузки();
	ЗаполнитьФактыБанка(План, Операции, Контекст);

	// Порядок (решение планировщика к задаче 4): шаг 0 -> поиск счета и контрагента -> шаги 1-2 (свой счет, сотрудник) ->
	// [3] -> [4] -> [5] -> шаг 6 -> завершение. Шаги 1-2 переопределяют найденного контрагента (свой счет побеждает);
	// договор зависит от вида операции, поэтому выбирается в завершении.
	ШагЗагруженныйДокумент(План, Контекст);
	ШагКонтрагентСчет(План, Контекст);
	ШагСвойСчетИСотрудник(План, Контекст);
	ШагПлатежноеПоручение(План, Контекст);
	ШагПравилаНазначения(План);
	ШагДокументПоНомеру(План, Контекст);
	ШагЗначениеПоУмолчанию(План);
	ШагЗавершение(План, Контекст);

	Возврат План;

КонецФункции

// Банковский счет организации по номеру: ищет по НомерСчета и НомерСчетаУстаревший среди счетов
// организаций, не помеченных на удаление. Счет контрагента с тем же номером не возвращается.
// Совпадение по текущему номеру предпочитается совпадению по устаревшему.
//
// Параметры:
//  НомерСчета - Строка - номер счета (IBAN или старый).
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - найденный счет; пустая ссылка, если счета нет.
Функция БанковскийСчетОрганизацииПоНомеру(НомерСчета) Экспорт

	Номер = СокрЛП(НомерСчета);
	Если ПустаяСтрока(Номер) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Счета.НомерСчета = &Номер
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И Счета.Владелец ССЫЛКА Справочник.Организации
		|	И (Счета.НомерСчета = &Номер
		|		ИЛИ Счета.НомерСчетаУстаревший = &Номер)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номер", Номер);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции

// Добавляет в справочник правил по назначению платежа стартовые строки: комиссия банка и возвраты. ЗАПИСЬ В БАЗУ -
// отдельная функция, не часть Распознать (команда "Заполнить типовыми правилами").
//
// Стартовые строки: комиссия банка (фразы расчетного обслуживания из нынешнего кода СМП_КлиентБанк, русские и украинские;
// вид списания "Прочее", вида для поступления нет - на поступлении комиссия не действует) и возвраты (одна строка на
// фразу: поступление - ОтПоставщика, списание - Покупателю). Короткие "Р/О", "Р\О", "Р\Р", "Р\У" не входят: подстрока без
// границ слова дает ложные совпадения ("договір/оплата"). Фразы комиссии не проверены на реальных знеособленных
// назначениях банков (журнал плана 02, "Перенесено в следующие этапы").
//
// Идемпотентна по фразе: строка с такой же фразой (без учета регистра, пробелы значимы), в том числе помеченная на
// удаление, считается существующей и не дублируется и не меняется - пометка есть решение человека, команда его не
// воскрешает. Вся вставка в одной транзакции.
//
// Возвращаемое значение:
//  Число - сколько строк добавлено.
Функция ЗаполнитьТиповыеПравила() Экспорт

	Существующие = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Правила.ФразаДляПоискаВНазначенииПлатежа КАК Фраза
		|ИЗ
		|	Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа КАК Правила");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Существующие.Вставить(ВРег(Выборка.Фраза), Истина);
	КонецЦикла;

	Добавлено = 0;
	НачатьТранзакцию();
	Попытка
		Для Каждого Типовое Из ТиповыеПравилаНазначения() Цикл
			Если Существующие.Получить(ВРег(Типовое.Фраза)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Правило = Справочники.СоответствияНазначенийПлатежаИРеквизитовПлатежа.СоздатьЭлемент();
			Правило.ФразаДляПоискаВНазначенииПлатежа = Типовое.Фраза;
			Правило.ВидОперацииПоступленияНаСчет = Типовое.ВидПоступления;
			Правило.ВидОперацииРасходаСоСчета = Типовое.ВидРасхода;
			Правило.Записать();
			Существующие.Вставить(ВРег(Типовое.Фраза), Истина);
			Добавлено = Добавлено + 1;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Добавлено;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Нормализация кода контрагента (ЕДРПОУ / РНОКПП) для поиска. Код банка - факт банка и в плане не меняется; нормализованный
// код нужен только поиску.
//
// Правила: пробелы (в том числе нерозривные и узкие), табуляция и разделители (дефис, точка, косая и т.п.) убираются.
// Остались цифры: 8 или 10 - код пригоден; 7 или 9 - вероятно потерян ведущий ноль (читатель присвоил число): код
// дополняется нулем ТОЛЬКО с предупреждением, где названы оба значения (как пришло и как стало); любая другая длина или
// знаки, не являющиеся цифрами, - код для поиска не используется, предупреждение. Пустой код (или одни разделители) -
// кода нет, это не подозрительный код: предупреждения нет.
//
// Параметры:
//  Код - Строка - код контрагента, как пришел от банка.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Исходный - Строка - код как пришел (без пробелов по краям).
//   * Нормализованный - Строка - только цифры (после возможного дополнения нулем); для непригодного кода - то, что осталось.
//   * Использовать - Булево - можно ли искать по коду.
//   * Предупреждение - Строка - текст предупреждения; пусто, если предупреждать не о чем.
//   * Цифры - Строка - цифры кода как пришли, без дополнения нулем (поиск ищет и их: в базе код мог быть записан так же).
Функция НормализоватьКодКонтрагента(Код) Экспорт

	Исходный = СокрЛП(Код);
	Цифры = "";
	ЕстьПосторонние = Ложь;
	Для Индекс = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, Индекс, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли Не ЭтоРазделительКода(Символ) Тогда
			ЕстьПосторонние = Истина;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура("Исходный, Нормализованный, Использовать, Предупреждение, Цифры", Исходный, Цифры, Ложь, "", Цифры);

	Если ЕстьПосторонние Тогда
		Результат.Предупреждение = СтрШаблон(НСтр("ru = 'Код контрагента ""%1"" содержит знаки, не являющиеся цифрами или разделителями: по коду контрагент не ищется.';
			|uk = 'Код контрагента ""%1"" містить знаки, що не є цифрами чи роздільниками: за кодом контрагента не шукають.'"), Исходный);
		Возврат Результат;
	КонецЕсли;

	Длина = СтрДлина(Цифры);
	Если Длина = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если Длина = 8 Или Длина = 10 Тогда
		Результат.Использовать = Истина;
	ИначеЕсли Длина = 7 Или Длина = 9 Тогда
		// Вероятно потерян ведущий ноль: дополняем, но НЕ молча - предупреждение называет оба значения.
		Результат.Нормализованный = "0" + Цифры;
		Результат.Использовать = Истина;
		Результат.Предупреждение = СтрШаблон(НСтр("ru = 'Код контрагента ""%1"" имеет %2 цифр: вероятно потерян ведущий ноль, для поиска код дополнен до ""%3"".';
			|uk = 'Код контрагента ""%1"" має %2 цифр: імовірно втрачено провідний нуль, для пошуку код доповнено до ""%3"".'"),
			Исходный, Формат(Длина, "ЧГ="), Результат.Нормализованный);
	Иначе
		Результат.Предупреждение = СтрШаблон(НСтр("ru = 'Код контрагента ""%1"" имеет %2 цифр (допустимы 8 и 10): по коду контрагент не ищется.';
			|uk = 'Код контрагента ""%1"" має %2 цифр (допустимі 8 і 10): за кодом контрагента не шукають.'"),
			Исходный, Формат(Длина, "ЧГ="));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ключи поиска контрагента по строке плана: номер счета, код и название операции в том виде, в каком их ищет ШагКонтрагентСчет.
// Одна функция для поиска и для записи (группировка новых контрагентов в пакете, ГруппыНовыхКонтрагентов).
//
// Параметры:
//  СтрокаПлана - СтрокаТаблицыЗначений - строка плана (колонки КонтрагентНомерСчета, КонтрагентКод, КонтрагентНаименование).
//
// Возвращаемое значение:
//  Структура - ключи:
//   * Номер - Строка - номер счета без пробелов, верхний регистр (НормализоватьНомерСчета); пусто, если номера нет.
//   * Код - Структура - см. НормализоватьКодКонтрагента (Использовать, Нормализованный, ...).
//   * Название - Строка - название операции без пробелов по краям (в базе сравнивается через ВРег).
Функция КлючиПоискаКонтрагента(СтрокаПлана) Экспорт

	Ключи = Новый Структура("Номер, Код, Название");
	Ключи.Номер = НормализоватьНомерСчета(СтрокаПлана.КонтрагентНомерСчета);
	Ключи.Код = НормализоватьКодКонтрагента(СтрокаПлана.КонтрагентКод);
	Ключи.Название = СокрЛП(СтрокаПлана.КонтрагентНаименование);

	Возврат Ключи;

КонецФункции

// Группы строк, относящихся к одному НОВОМУ контрагенту (запись пакета создает его один раз). Группируют так, как искал бы
// контрагента ШагКонтрагентСчет, если бы первый из группы уже был в базе, - тот же порядок ключей: номер счета; иначе код (если
// пригоден); иначе название (только когда пригодного кода нет, ВРег без учета пробелов по краям). Название сопоставляется с
// названием СОЗДАВАЕМОГО контрагента - первым непустым названием группы. Порядок групп и строк в группе - порядок входа.
//
// Параметры:
//  Строки - Массив - строки плана (СтрокаТаблицыЗначений), для которых контрагент создается.
//
// Возвращаемое значение:
//  Массив из Массив - группы строк.
Функция ГруппыНовыхКонтрагентов(Строки) Экспорт

	Группы = Новый Массив;
	ПоНомеру = Новый Соответствие;
	ПоКоду = Новый Соответствие;
	ПоНазванию = Новый Соответствие;
	ГруппыСНазванием = Новый Соответствие;

	Для Каждого СтрокаПлана Из Строки Цикл
		Ключи = КлючиПоискаКонтрагента(СтрокаПлана);
		КлючКода = ?(Ключи.Код.Использовать, Ключи.Код.Нормализованный, "");
		КлючНазвания = ВРег(Ключи.Название);

		Группа = Неопределено;
		Если Не ПустаяСтрока(Ключи.Номер) Тогда
			Группа = ПоНомеру.Получить(Ключи.Номер);
		КонецЕсли;
		Если Группа = Неопределено И Не ПустаяСтрока(КлючКода) Тогда
			Группа = ПоКоду.Получить(КлючКода);
		КонецЕсли;
		Если Группа = Неопределено И ПустаяСтрока(КлючКода) И Не ПустаяСтрока(КлючНазвания) Тогда
			Группа = ПоНазванию.Получить(КлючНазвания);
		КонецЕсли;

		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Добавить(Группа);
		КонецЕсли;
		Группа.Добавить(СтрокаПлана);

		Если Не ПустаяСтрока(Ключи.Номер) И ПоНомеру.Получить(Ключи.Номер) = Неопределено Тогда
			ПоНомеру.Вставить(Ключи.Номер, Группа);
		КонецЕсли;
		Если Не ПустаяСтрока(КлючКода) И ПоКоду.Получить(КлючКода) = Неопределено Тогда
			ПоКоду.Вставить(КлючКода, Группа);
		КонецЕсли;
		Если Не ПустаяСтрока(КлючНазвания) И ГруппыСНазванием.Получить(Группа) = Неопределено Тогда
			ГруппыСНазванием.Вставить(Группа, Истина);
			ПоНазванию.Вставить(КлючНазвания, Группа);
		КонецЕсли;
	КонецЦикла;

	Возврат Группы;

КонецФункции

// Нужен ли виду операции контрагент.
//
// Перечень выведен из вендорских документов: Документы.ПоступлениеНаСчет (ОбработкаПроверкиЗаполнения) и
// Документы.РасходСоСчета (ОбработкаПроверкиЗаполнения). Контрагент нужен виду, в чьей ветке по
// ВидОперации проверка реквизита "Контрагент" НЕ снимается (УдалитьПроверяемыйРеквизит(ПроверяемыеРеквизиты, "Контрагент")
// отсутствует); все прочие ветки и "Иначе" ее снимают. ПокупкаВалюты в перечень не входит: контрагент там снимается
// условно (УправлениеНебольшойФирмойПовтИсп.ТребуетсяКонтрольДоговоровКонтрагентов()), зависит от настроек базы.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета
//
// Возвращаемое значение:
//  Булево
Функция ВидОперацииТребуетКонтрагента(ВидОперации) Экспорт

	Возврат ВидыОперацийСКонтрагентом().Найти(ВидОперации) <> Неопределено;

КонецФункции

// Нужен ли виду операции договор.
//
// Перечень выведен из тех же мест вендорских документов, что и для контрагента (ВидОперацииТребуетКонтрагента): договор
// нужен виду, в чьей ветке не снимается проверка "РасшифровкаПлатежа.Договор". В первой ветке (ОтПокупателя, ОтПоставщика,
// ОтНашейОрганизации / Поставщику, Покупателю, НашейОрганизации) проверку договора снимает лишь условие "расчеты по
// договорам не ведутся" - вид в перечне. Контрагент без договора: КомиссияБанка, РасчетыПоКредитам.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета
//
// Возвращаемое значение:
//  Булево
Функция ВидОперацииТребуетДоговор(ВидОперации) Экспорт

	Возврат ВидыОперацийСДоговором().Найти(ВидОперации) <> Неопределено;

КонецФункции

// Виды договора контрагента, подходящие виду операции (решение планировщика): ОтПокупателя, Покупателю - договор с
// покупателем; Поставщику, ОтПоставщика - с поставщиком. Для остальных видов (карты, кредиты, НашейОрганизации) соответствия
// нет - пустой массив, вид договора не отбирается.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ВидыДоговоров
Функция ВидыДоговораДляВидаОперации(ВидОперации) Экспорт

	Виды = Новый Массив;
	Если ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя
		Или ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Покупателю Тогда
		Виды.Добавить(Перечисления.ВидыДоговоров.СПокупателем);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Поставщику
		Или ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПоставщика Тогда
		Виды.Добавить(Перечисления.ВидыДоговоров.СПоставщиком);
	КонецЕсли;

	Возврат Виды;

КонецФункции

// Часть 1 задачи 4: поиск счета контрагента и контрагента. Идет сразу после шага 0 (до шагов 1-2, которым нужен найденный
// владелец счета), поэтому вид операции еще неизвестен: здесь только то, что можно найти. Решения "создать / невозможно"
// и договор - в ШагЗавершение. Строки с уже определенным контрагентом (найденный документ, шаги задачи 5) не затрагиваются.
//
// Порядок: счет по номеру (текущему или устаревшему; не помечен на удаление, не недействителен; владелец - контрагент, не
// помеченный на удаление) -> контрагент = владелец; иначе по коду ЕДРПОУ; название - запасной ключ, лишь когда пригодного
// кода нет. Расхождение названия при совпавшем коде - не замечание. Запросов на конверт: счета, коды, названия (названия
// - только если есть строки без счета и кода). Экспортный: тесты вызывают шаг на плане с заданным видом операции.
//
// Параметры:
//  План - Структура - см. НовыйПланЗагрузки.
//  Контекст - Структура - см. НовыйКонтекстРаспознавания.
//
// Возвращаемое значение:
//  Структура - тот же План (изменяется на месте).
Функция ШагКонтрагентСчет(План, Контекст) Экспорт

	Элементы = Новый Массив;
	Номера = Новый Массив;
	Коды = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если ПустаяСтрока(СтрокаПлана.ВидДокумента) Или СтрокаПлана.ИсточникВидаОперации = ИсточникЗагруженныйДокумент()
			Или ЗначениеЗаполнено(СтрокаПлана.Контрагент) Или Не ПустаяСтрока(СтрокаПлана.ДействиеКонтрагент) Тогда
			Продолжить;
		КонецЕсли;
		Ключи = КлючиПоискаКонтрагента(СтрокаПлана);
		Элемент = Новый Структура("Строка, Номер, Код, Название, Помеченные");
		Элемент.Строка = СтрокаПлана;
		Элемент.Номер = Ключи.Номер;
		Элемент.Код = Ключи.Код;
		Элемент.Название = Ключи.Название;
		Элемент.Помеченные = Новый Массив;
		Элементы.Добавить(Элемент);
		// Запрос ищет значение в базе как есть, поэтому в множество кладутся оба вида: нормализованное и как пришло
		// (номер - СокрЛП и верхний регистр; код - цифры без дополнения нулем). Известное ограничение: пробелы ВНУТРИ
		// номера, сохраненного в самой базе, запрос не видит (номер из операции без пробелов такой счет не найдет); не
		// лечится здесь.
		Варианты = Новый Массив;
		Варианты.Добавить(Элемент.Номер);
		Варианты.Добавить(ВРег(СокрЛП(СтрокаПлана.КонтрагентНомерСчета)));
		Для Каждого Вариант Из Варианты Цикл
			Если Не ПустаяСтрока(Вариант) И Повторы.Получить("н|" + Вариант) = Неопределено Тогда
				Повторы.Вставить("н|" + Вариант, Истина);
				Номера.Добавить(Вариант);
			КонецЕсли;
		КонецЦикла;
		Если Элемент.Код.Использовать Тогда
			Варианты = Новый Массив;
			Варианты.Добавить(Элемент.Код.Нормализованный);
			Варианты.Добавить(Элемент.Код.Цифры);
			Для Каждого Вариант Из Варианты Цикл
				Если Повторы.Получить("к|" + Вариант) = Неопределено Тогда
					Повторы.Вставить("к|" + Вариант, Истина);
					Коды.Добавить(Вариант);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Элементы.Количество() = 0 Тогда
		Возврат План;
	КонецЕсли;

	Счета = ПрочитатьСчетаКонтрагентов(Номера);
	КонтрагентыПоКоду = ПрочитатьКонтрагентовПоКодам(Коды);

	// Названия нужны только строкам, которым не помог ни счет, ни пригодный код.
	Названия = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		НайтиСчетСтроки(План, Элемент, Счета);
		Если Элемент.Строка.ДействиеКонтрагент = ДействиеНайден() Тогда
			Продолжить;
		КонецЕсли;
		Если Не Элемент.Код.Использовать И Не ПустаяСтрока(Элемент.Название)
			И Повторы.Получить(ВРег(Элемент.Название)) = Неопределено Тогда
			Повторы.Вставить(ВРег(Элемент.Название), Истина);
			Названия.Добавить(Элемент.Название);
		КонецЕсли;
	КонецЦикла;
	КонтрагентыПоНазванию = ПрочитатьКонтрагентовПоНазваниям(Названия);

	Для Каждого Элемент Из Элементы Цикл
		СтрокаПлана = Элемент.Строка;
		Если СтрокаПлана.ДействиеКонтрагент <> ДействиеНайден() Тогда
			Если Элемент.Код.Использовать Тогда
				НайтиКонтрагентаСтроки(План, Элемент, КонтрагентыПоКоду, Истина);
			ИначеЕсли Не ПустаяСтрока(Элемент.Название) Тогда
				НайтиКонтрагентаСтроки(План, Элемент, КонтрагентыПоНазванию, Ложь);
			КонецЕсли;
		КонецЕсли;
		ПроверитьКодВладельцаСчета(План, Элемент);
		ДобавитьЗамечанияОПомеченных(План, Элемент);
		Если Не ПустаяСтрока(Элемент.Код.Предупреждение) Тогда
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентКод", СМП_ВыпискаБанка.УровеньПредупреждение(),
				Элемент.Код.Предупреждение);
		КонецЕсли;
	КонецЦикла;

	Возврат План;

КонецФункции

// Шаги 1-2 (D25, D35.2): счет контрагента операции - наш собственный счет (шаг 1) или счет действующего сотрудника
// (шаг 2). Идет после ШагКонтрагентСчет, который счетов организаций не ищет, но мог найти контрагента по коду или
// названию: СВОЙ СЧЕТ ПОБЕЖДАЕТ - у сработавшей строки найденный контрагент, счет и их замечания сбрасываются.
//
// Правила (владельца счета проверяет запрос; признак "свой" по префиксу номера не используется):
//  - владелец - ТА ЖЕ организация (счет не равен счету самой выписки): ПереводСДругогоСчета / ПереводНаДругойСчет,
//    ИсточникВидаОперации "СвойСчет"; контрагент пуст ("НеТребуется"), СчетКонтрагента - наш другой счет ("Найден"),
//    договор "НеТребуется" (вендор для переводов контрагента и договор не требует);
//  - владелец - ДРУГАЯ организация: ОтНашейОрганизации / НашейОрганизации, "НашаОрганизация"; контрагент - ее
//    КонтрагентИнтеркампани ("Найден"); не заполнен - "Невозможно" и "Ошибка" с названием организации (платформа
//    интеркампани не создает - это настройка человека). СчетКонтрагента - найденный счет организации ("Найден");
//    договор выбирает ШагЗавершение по правилам вида операции;
//  - владелец - физлицо, действующий сотрудник организации распознавания (запись ТекущиеКадровыеДанныеСотрудников с
//    датой приема и без даты увольнения; сотрудник не помечен и не недействителен; организация кадровых данных сравнивается
//    с Константы.УчетПоКомпании.Компания(организация контекста), потому что вендор пишет их на компанию), ТОЛЬКО списание:
//    ЗарплатаСотруднику, "Сотрудник"; контрагент - сотрудник ("Найден"), договор "НеТребуется". Физлицо без
//    действующего сотрудника: шаг не срабатывает, "Предупреждение". Поступление на счет физлица зарплатой не является,
//    шаг не срабатывает.
//
// Запросов на конверт: счета организаций и физлиц - один; сотрудники - один (и только если есть списания на счета физлиц).
//
// Параметры:
//  План - Структура - см. НовыйПланЗагрузки.
//  Контекст - Структура - см. НовыйКонтекстРаспознавания.
//
// Возвращаемое значение:
//  Структура - тот же План (изменяется на месте).
Функция ШагСвойСчетИСотрудник(План, Контекст) Экспорт

	Элементы = Новый Массив;
	Номера = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из СтрокиДляРаспознавания(План) Цикл
		Номер = НормализоватьНомерСчета(СтрокаПлана.КонтрагентНомерСчета);
		Если ПустаяСтрока(Номер) Тогда
			Продолжить;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("Строка, Номер", СтрокаПлана, Номер));
		Для Каждого Вариант Из СтрРазделить(Номер + Символы.ПС + ВРег(СокрЛП(СтрокаПлана.КонтрагентНомерСчета)), Символы.ПС) Цикл
			Если Не ПустаяСтрока(Вариант) И Повторы.Получить(Вариант) = Неопределено Тогда
				Повторы.Вставить(Вариант, Истина);
				Номера.Добавить(Вариант);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Элементы.Количество() = 0 Тогда
		Возврат План;
	КонецЕсли;

	Счета = ПрочитатьСчетаОрганизацийИФизлиц(Номера);
	Если Счета.Количество() = 0 Тогда
		Возврат План;
	КонецЕсли;

	// Найденные счета по строкам; физлица - только для списаний (поступление на счет физлица не зарплата).
	Найденные = Новый Массив;
	Физлица = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Счет = НайтиСвойСчетСтроки(Элемент.Номер, Счета);
		Если Счет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элемент.Вставить("Счет", Счет);
		Найденные.Добавить(Элемент);
		Если ТипЗнч(Счет.Владелец) = Тип("СправочникСсылка.ФизическиеЛица")
			И Элемент.Строка.ВидДокумента = ВидДокументаРасходСоСчета() И Физлица.Найти(Счет.Владелец) = Неопределено Тогда
			Физлица.Добавить(Счет.Владелец);
		КонецЕсли;
	КонецЦикла;

	СотрудникиФизлиц = ПрочитатьСотрудниковФизлиц(Физлица);
	// Кадровые данные вендор пишет на "компанию", а не на организацию документа: Константы.УчетПоКомпании.Компания(Организация)
	// (ПриемНаРаботу -> ПроведениеДокументовУНФ.ИнициализироватьДополнительныеСвойстваДляПроведения). С ней сравниваются обе
	// ветки шага 2. Функция вендора, одно обращение на конверт, и только если есть списания на счета физлиц.
	Компания = Неопределено;
	Если Физлица.Количество() > 0 Тогда
		Компания = Константы.УчетПоКомпании.Компания(Контекст.Организация);
	КонецЕсли;

	// Счета контрагентов интеркампани других организаций - одним запросом по всем найденным строкам "другая организация".
	Интеркампани = Новый Массив;
	Для Каждого Элемент Из Найденные Цикл
		Если ТипЗнч(Элемент.Счет.Владелец) = Тип("СправочникСсылка.Организации") И Элемент.Счет.Владелец <> Контекст.Организация
			И ЗначениеЗаполнено(Элемент.Счет.КонтрагентИнтеркампани) И Интеркампани.Найти(Элемент.Счет.КонтрагентИнтеркампани) = Неопределено Тогда
			Интеркампани.Добавить(Элемент.Счет.КонтрагентИнтеркампани);
		КонецЕсли;
	КонецЦикла;
	СчетаИнтеркампани = ПрочитатьСчетаКонтрагентовИнтеркампани(Интеркампани, Номера);

	Для Каждого Элемент Из Найденные Цикл
		Счет = Элемент.Счет;
		СтрокаПлана = Элемент.Строка;
		Если ТипЗнч(Счет.Владелец) = Тип("СправочникСсылка.Организации") Тогда
			Если Счет.Владелец = Контекст.Организация Тогда
				ПрименитьПереводМеждуСвоимиСчетами(План, СтрокаПлана, Счет, Контекст);
			Иначе
				ПрименитьДругуюОрганизацию(План, СтрокаПлана, Счет, Элемент.Номер, СчетаИнтеркампани);
			КонецЕсли;
		ИначеЕсли СтрокаПлана.ВидДокумента = ВидДокументаРасходСоСчета() Тогда
			ПрименитьСотрудника(План, СтрокаПлана, Счет, СотрудникиФизлиц, Компания);
		КонецЕсли;
	КонецЦикла;

	Возврат План;

КонецФункции

// Часть 2 задачи 4 и задача 9: завершение после шага 6 - решения над контрагентом и счетом, которых не нашел поиск, контрагент
// банка для комиссии, выбор договора, статья ДДС (цепочка D14), кореспонденция, "без ПДВ". Строки с загруженным документом не
// затрагиваются.
// Контрагент нужен не всякому виду операции (ВидОперацииТребуетКонтрагента): нет данных ни о названии, ни о коде, ни о
// счете, а контрагент нужен - "Невозможно" и ошибка (создать нечего). Договор - лишь там, где его еще нет (шаги 0 и 3 его
// дали) и вид его требует; строке с документом по номеру (шаг 5) договор дает сам документ (непустой договор документа берется как
// есть, без отбора по виду; пустой - обычный выбор). Экспортный: тесты вызывают шаг на плане с заданным видом операции.
//
// Параметры:
//  План - Структура - см. НовыйПланЗагрузки.
//  Контекст - Структура - см. НовыйКонтекстРаспознавания.
//
// Возвращаемое значение:
//  Структура - тот же План (изменяется на месте).
Функция ШагЗавершение(План, Контекст) Экспорт

	Строки = Новый Массив;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если ПустаяСтрока(СтрокаПлана.ВидДокумента) Или Не ЗначениеЗаполнено(СтрокаПлана.ВидОперации)
			Или СтрокаПлана.ИсточникВидаОперации = ИсточникЗагруженныйДокумент() Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(СтрокаПлана);
	КонецЦикла;

	Для Каждого СтрокаПлана Из Строки Цикл
		РешитьКонтрагентаИСчет(План, СтрокаПлана);
	КонецЦикла;
	// Контрагент банка подставляется ДО выбора договоров и статьи: оба шага читают контрагента строки. Пока вид "Комиссия банка" не
	// входит в ВидыОперацийСДоговором, порядок относительно ВыбратьДоговоры на результат не влияет; но если комиссия станет
	// договорной, подстановка обязана предшествовать выбору договора. Перед ЗаполнитьСтатьиДДС порядок обязателен уже сейчас:
	// статья контрагента банка участвует в цепочке D14.
	ПрименитьКонтрагентаБанка(План, Строки, Контекст);
	ПрименитьДоговорыНайденныхДокументов(Строки);
	ВыбратьДоговоры(План, Строки, Контекст);
	// Статья - после договора и контрагента (цепочка D14 читает их); кореспонденция и "без ПДВ" от них не зависят.
	ЗаполнитьСтатьиДДС(Строки);
	ЗаполнитьКорреспонденцию(Строки);
	ЗаполнитьБезНДС(Строки);

	Возврат План;

КонецФункции

// Повторная проверка перед записью (D35.5): какие из строк, которые запись собирается создать, уже загружены. Тот же поиск,
// что шаг 0 (СопоставитьЗагруженные: идентификатор, затем составной ключ с количественным зачетом), а не его копия.
//
// Проверяются строки с пустым ЗагруженныйДокумент и заполненными видом документа, организацией и банковским счетом; все
// такие строки пакета - ОДНИМ проходом (по группе организация + банковский счет), до создания первого документа: проверка
// перед каждой строкой посчитала бы документ, только что созданный записью, наявным для следующей такой же операции.
// Документы, уже отданные строкам с заполненным ЗагруженныйДокумент, другим строкам не достаются (иначе вторая из двух
// одинаковых операций сливалась бы с документом первой). План не меняется, в базу ничего не пишется.
//
// Параметры:
//  План - Структура - см. НовыйПланЗагрузки.
//
// Возвращаемое значение:
//  Соответствие - ключ: строка плана (СтрокаТаблицыЗначений из План.Операции), значение: найденный документ.
Функция ЗагруженныеДокументыСтрокПлана(План) Экспорт

	Результат = Новый Соответствие;
	Использованные = Новый Соответствие;
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;

	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			Использованные.Вставить(СтрокаПлана.ЗагруженныйДокумент, Истина);
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаПлана.ВидДокумента) Или Не ЗначениеЗаполнено(СтрокаПлана.Организация)
			Или Не ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Строка(СтрокаПлана.Организация.УникальныйИдентификатор()) + "|"
			+ Строка(СтрокаПлана.БанковскийСчет.УникальныйИдентификатор());
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Ключ, Группа);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		Группа.Добавить(СтрокаПлана);
	КонецЦикла;

	Для Каждого Ключ Из ПорядокГрупп Цикл
		Группа = Группы.Получить(Ключ);

		// Рабочая копия строк группы: источник вида очищен (шаг 0 считает "еще не сопоставленной" строку с пустым источником),
		// найденный документ пуст. Оригинал не трогается.
		Копия = НовыйПланЗагрузки();
		Пары = Новый Массив;
		Для Каждого СтрокаПлана Из Группа Цикл
			СтрокаКопии = Копия.Операции.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКопии, СтрокаПлана);
			СтрокаКопии.ИсточникВидаОперации = "";
			СтрокаКопии.ЗагруженныйДокумент = Неопределено;
			Пары.Добавить(Новый Структура("Оригинал, Копия", СтрокаПлана, СтрокаКопии));
		КонецЦикла;

		Контекст = НовыйКонтекстРаспознавания();
		Контекст.Организация = Группа[0].Организация;
		Контекст.БанковскийСчет = Группа[0].БанковскийСчет;

		Строки = СтрокиПоПорядковомуНомеру(СтрокиДляРаспознавания(Копия));
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СопоставитьЗагруженные(Копия, Строки, Контекст, Использованные);

		Для Каждого Пара Из Пары Цикл
			Если ЗначениеЗаполнено(Пара.Копия.ЗагруженныйДокумент) Тогда
				Результат.Вставить(Пара.Оригинал, Пара.Копия.ЗагруженныйДокумент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СхемаПлана

Функция НоваяТаблицаОперацийПлана()

	Таблица = Новый ТаблицаЗначений;

	// Факты банка - из конструктора контракта, а не переписанным перечнем: новая колонка контракта
	// появляется в плане сама.
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;

	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("БанковскийСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Таблица.Колонки.Добавить("ВидДокумента", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов(
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
	Таблица.Колонки.Добавить("ИсточникВидаОперации", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ЗагруженныйДокумент", Новый ОписаниеТипов(
		"ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета"));
	// Реквизит Контрагент банковских документов имеет единственный тип Контрагенты: другая наша организация
	// представлена КонтрагентомИнтеркампани (тип Организации в колонке убран решением планировщика, задача 5);
	// Сотрудники - для выплаты зарплаты (реквизит документа выберет этап 4).
	Таблица.Колонки.Добавить("Контрагент", Новый ОписаниеТипов(
		"СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники"));
	Таблица.Колонки.Добавить("СчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Таблица.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Таблица.Колонки.Добавить("ДействиеКонтрагент", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ДействиеСчет", ОписаниеСтроки());
	Таблица.Колонки.Добавить("ДействиеДоговор", ОписаниеСтроки());
	Таблица.Колонки.Добавить("СтатьяДДС", Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Таблица.Колонки.Добавить("ИсточникСтатьи", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Корреспонденция", Новый ОписаниеТипов("ПланСчетовСсылка.Управленческий"));
	Таблица.Колонки.Добавить("ВидНалога", Новый ОписаниеТипов("СправочникСсылка.ВидыНалогов"));
	Таблица.Колонки.Добавить("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктурныеЕдиницы"));
	Таблица.Колонки.Добавить("ПравилоНазначения", Новый ОписаниеТипов(
		"СправочникСсылка.СоответствияНазначенийПлатежаИРеквизитовПлатежа"));
	Таблица.Колонки.Добавить("ДокументПоНомеру", ТипДокументаПоНомеру());
	Таблица.Колонки.Добавить("ПлатежноеПоручение", Новый ОписаниеТипов("ДокументСсылка.ПлатежноеПоручение"));
	Таблица.Колонки.Добавить("БезНДС", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПроверьтеОперацию", Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

Функция НоваяТаблицаЗамечаний()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ПорядковыйНомер",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Поле", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Уровень", ОписаниеСтроки());
	Таблица.Колонки.Добавить("Текст", ОписаниеСтроки());
	Возврат Таблица;

КонецФункции

Функция ОписаниеСтроки()

	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));

КонецФункции

// Тип документа, найденного по номеру в назначении платежа: документы-основы заказов и счетов плюс
// все типы измерения Документ регистров взаиморасчетов (D35.3). Типы регистров берутся из метаданных, а не
// перечнем в коде: колонка не отстает от конфигурации.
Функция ТипДокументаПоНомеру()

	Типы = Новый Массив;
	Добавленные = Новый Соответствие;

	Источники = Новый Массив;
	Источники.Добавить(Метаданные.РегистрыНакопления.РасчетыСПокупателями.Измерения.Документ.Тип.Типы());
	Источники.Добавить(Метаданные.РегистрыНакопления.РасчетыСПоставщиками.Измерения.Документ.Тип.Типы());
	ДокументыОснования = Новый ОписаниеТипов(
		"ДокументСсылка.ЗаказПокупателя, ДокументСсылка.СчетНаОплату, ДокументСсылка.ЗаказПоставщику, ДокументСсылка.СчетНаОплатуПоставщика");
	Источники.Добавить(ДокументыОснования.Типы());

	Для Каждого ТипыИсточника Из Источники Цикл
		Для Каждого ОдинТип Из ТипыИсточника Цикл
			Если Добавленные.Получить(ОдинТип) = Неопределено Тогда
				Добавленные.Вставить(ОдинТип, Истина);
				Типы.Добавить(ОдинТип);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый ОписаниеТипов(Типы);

КонецФункции

#КонецОбласти

#Область ФактыБанка

// Переносит факты банка из входной таблицы в строки плана (вход не меняется), подставляет организацию и счет
// из контекста и вид документа по направлению.
Процедура ЗаполнитьФактыБанка(План, Операции, Контекст)

	Для Каждого Операция Из Операции Цикл
		СтрокаПлана = План.Операции.Добавить();
		Для Каждого Колонка Из Операции.Колонки Цикл
			Если План.Операции.Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
				СтрокаПлана[Колонка.Имя] = Операция[Колонка.Имя];
			КонецЕсли;
		КонецЦикла;

		СтрокаПлана.Организация = Контекст.Организация;
		СтрокаПлана.БанковскийСчет = Контекст.БанковскийСчет;

		// Направление не из контракта на валидных строках ПроверитьВыписку не бывает: это защита от вызова
		// с невалидной таблицей. Вид документа и вид операции остаются пустыми, строка дальше шагами
		// не обрабатывается (см. СтрокиДляРаспознавания), замечание "Ошибка" называет пришедшее значение.
		Если СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеПоступило() Тогда
			СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет();
		ИначеЕсли СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеСписано() Тогда
			СтрокаПлана.ВидДокумента = ВидДокументаРасходСоСчета();
		Иначе
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Направление", СМП_ВыпискаБанка.УровеньОшибка(),
				СтрШаблон(НСтр("ru = 'Направление операции ""%1"" не из контракта: допустимы ""%2"" и ""%3""; вид операции не определен.';
					|uk = 'Напрямок операції ""%1"" не з контракту: допустимі ""%2"" і ""%3""; вид операції не визначено.'"),
					СтрокаПлана.Направление, СМП_ВыпискаБанка.НаправлениеПоступило(), СМП_ВыпискаБанка.НаправлениеСписано()));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗамечание(План, ПорядковыйНомер, Поле, Уровень, Текст)

	Замечание = План.Замечания.Добавить();
	Замечание.ПорядковыйНомер = ПорядковыйНомер;
	Замечание.Поле = Поле;
	Замечание.Уровень = Уровень;
	Замечание.Текст = Текст;

КонецПроцедуры

// Строки, которым шаги еще могут определить вид операции: направление известно, источник вида пока пуст.
// Порожність - через ПустаяСтрока: строка из пробелов считается пустой.
Функция СтрокиДляРаспознавания(План)

	Строки = Новый Массив;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если Не ПустаяСтрока(СтрокаПлана.ВидДокумента) И ПустаяСтрока(СтрокаПлана.ИсточникВидаОперации) Тогда
			Строки.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;

	Возврат Строки;

КонецФункции

#КонецОбласти

#Область Шаги

#Область ШагЗагруженныйДокумент

// Шаг 0 (D25, D5, D17, D35.4, D35.5): операция уже загружена - найден банковский документ того же вида и того же
// банковского счета организации. Документ, помеченный на удаление, тоже находится (D5). Только читает.
//
// Сначала по идентификатору операции (СМП_ИДТранзакцииБанка): номер, счет и сумма тогда не сверяются.
// Не найденные - составным ключом (день входящей даты, номер, счет контрагента, сумма), и составной ключ
// считается КОЛИЧЕСТВЕННО: из k операций с одним ключом и m документов с этим ключом первые min(k, m)
// операций (по ПорядковыйНомер) получают по РАЗНОМУ документу (по дате и номеру документа), остальные новые.
// Документ не достается двум операциям: иначе две одинаковые операции слились бы в одну, и вторая молча пропала.
// В сомнении видимый дубль лучше невидимой потери (D3).
//
// Запросов два на весь пакет: один по идентификаторам, один по составным ключам; группировка - в памяти.
Процедура ШагЗагруженныйДокумент(План, Контекст)

	// Контекст заполнен: пустые организация и банковский счет Распознать отвергает до шагов.
	Строки = СтрокиПоПорядковомуНомеру(СтрокиДляРаспознавания(План));
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СопоставитьЗагруженные(План, Строки, Контекст, Новый Соответствие);

КонецПроцедуры

// Одна реализация поиска загруженных документов: ее вызывают и шаг 0 распознавания, и повторная проверка перед записью
// (ЗагруженныеДокументыСтрокПлана). Использованные - документы, уже отданные другим операциям (ключ - ссылка).
Процедура СопоставитьЗагруженные(План, Строки, Контекст, Использованные)

	СопоставитьЗагруженныеПоИдентификатору(Строки, Контекст, Использованные);
	СопоставитьЗагруженныеСоставнымКлючом(План, Строки, Контекст, Использованные);

КонецПроцедуры

Процедура СопоставитьЗагруженныеПоИдентификатору(Строки, Контекст, Использованные)

	Идентификаторы = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из Строки Цикл
		Идентификатор = ИдентификаторОперацииСтроки(СтрокаПлана);
		Если Не ПустаяСтрока(Идентификатор) И Повторы.Получить(Идентификатор) = Неопределено Тогда
			Повторы.Вставить(Идентификатор, Истина);
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапросаБанковскихДокументов("И Т.СМП_ИДТранзакцииБанка В (&Идентификаторы)", Контекст));
	Запрос.УстановитьПараметр("БанковскийСчет", Контекст.БанковскийСчет);
	Запрос.УстановитьПараметр("Организация", Контекст.Организация);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	// Документы идут в порядке (дата, номер): первый подходящий берет первая операция.
	ПоКлючу = Новый Соответствие;
	Для Каждого Документ Из ПрочитатьБанковскиеДокументы(Запрос) Цикл
		Идентификатор = СокрЛП(Документ.Идентификатор);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		// Регистр букв идентификатора не различается: база сравнивает без учета регистра (измерено в тесте записи), а
		// Соответствие - с учетом; без ВРег идентификатор, отличающийся лишь регистром, давал дубль (T3-M3).
		Ключ = Документ.ВидДокумента + "|" + ВРег(Идентификатор);
		Список = ПоКлючу.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоКлючу.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(Документ);
	КонецЦикла;

	Для Каждого СтрокаПлана Из Строки Цикл
		Идентификатор = ИдентификаторОперацииСтроки(СтрокаПлана);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоКлючу.Получить(СтрокаПлана.ВидДокумента + "|" + ВРег(Идентификатор));
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Документ Из Список Цикл
			Если Использованные.Получить(Документ.Ссылка) = Неопределено Тогда
				Использованные.Вставить(Документ.Ссылка, Истина);
				ПрименитьЗагруженныйДокумент(СтрокаПлана, Документ);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура СопоставитьЗагруженныеСоставнымКлючом(План, Строки, Контекст, Использованные)

	// Строки, которым документ еще не найден: источник вида пуст.
	Остальные = Новый Массив;
	Дни = Новый Массив;
	Суммы = Новый Массив;
	ДниПовторы = Новый Соответствие;
	СуммыПовторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если Не ПустаяСтрока(СтрокаПлана.ИсточникВидаОперации) Тогда
			Продолжить;
		КонецЕсли;
		День = ДеньДокументаОперации(СтрокаПлана);
		Если Не ЗначениеЗаполнено(День) Тогда
			// Ни даты документа, ни даты операции: ключа нет, пустая дата нашла бы документы без входящей даты.
			Продолжить;
		КонецЕсли;
		Остальные.Добавить(СтрокаПлана);
		Если ДниПовторы.Получить(День) = Неопределено Тогда
			ДниПовторы.Вставить(День, Истина);
			Дни.Добавить(День);
		КонецЕсли;
		Если СуммыПовторы.Получить(СтрокаПлана.Сумма) = Неопределено Тогда
			СуммыПовторы.Вставить(СтрокаПлана.Сумма, Истина);
			Суммы.Добавить(СтрокаПлана.Сумма);
		КонецЕсли;
	КонецЦикла;
	Если Остальные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// ДатаВходящегоДокумента в обоих документах - реквизит ДатаЧасти "Дата" (измерено по cf/src: DateFractions = Date):
	// времени в нем быть не может, поэтому точное сравнение с началом дня в запросе равносильно сравнению по дню.
	// В памяти (ДокументПодходитСтроке) день все равно приводится НачалоДня с обеих сторон.
	Запрос = Новый Запрос(ТекстЗапросаБанковскихДокументов(
		"И Т.ДатаВходящегоДокумента В (&Дни) И Т.СуммаДокумента В (&Суммы)", Контекст));
	Запрос.УстановитьПараметр("БанковскийСчет", Контекст.БанковскийСчет);
	Запрос.УстановитьПараметр("Организация", Контекст.Организация);
	Запрос.УстановитьПараметр("Дни", Дни);
	Запрос.УстановитьПараметр("Суммы", Суммы);
	НайденныеДокументы = ПрочитатьБанковскиеДокументы(Запрос);

	// Группы операций с одним ключом; порядок групп - по первой операции, порядок операций - по ПорядковыйНомер.
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;
	Для Каждого СтрокаПлана Из Остальные Цикл
		Ключ = КлючСоставной(СтрокаПлана);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Ключ, Группа);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		Группа.Добавить(СтрокаПлана);
	КонецЦикла;

	Для Каждого Ключ Из ПорядокГрупп Цикл
		Группа = Группы.Получить(Ключ);

		// Сколько еще не использованных документов подходит ключу группы (хотя бы одной ее операции).
		Наличие = 0;
		Для Каждого Документ Из НайденныеДокументы Цикл
			Если Использованные.Получить(Документ.Ссылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаПлана Из Группа Цикл
				Если ДокументПодходитСтроке(Документ, СтрокаПлана) Тогда
					Наличие = Наличие + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Для Каждого СтрокаПлана Из Группа Цикл
			Для Каждого Документ Из НайденныеДокументы Цикл
				Если Использованные.Получить(Документ.Ссылка) = Неопределено
					И ДокументПодходитСтроке(Документ, СтрокаПлана) Тогда
					Использованные.Вставить(Документ.Ссылка, Истина);
					ПрименитьЗагруженныйДокумент(СтрокаПлана, Документ);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Если Наличие > Группа.Количество() Тогда
			Для Каждого СтрокаПлана Из Группа Цикл
				ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ЗагруженныйДокумент",
					СМП_ВыпискаБанка.УровеньПредупреждение(),
					СтрШаблон(НСтр("ru = 'Документов с таким ключом (день, номер, счет контрагента, сумма) в базе %1, операций выписки с этим ключом %2: лишние документы не сопоставлены.';
						|uk = 'Документів з таким ключем (день, номер, рахунок контрагента, сума) у базі %1, операцій виписки з цим ключем %2: зайві документи не зіставлено.'"),
						Формат(Наличие, "ЧН=0; ЧГ="), Формат(Группа.Количество(), "ЧН=0; ЧГ=")));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подходит ли документ операции составным ключом (D17, D35.4): тот же вид, день входящей даты, номер (пустой
// равен пустому), сумма и счет контрагента (пустой в документе или равный). Документ с ДРУГИМ заполненным
// идентификатором операции не подходит (D35.4а): у операции без идентификатора другого идентификатора нет,
// и документ, загруженный по API, узнается при загрузке той же операции из файла.
Функция ДокументПодходитСтроке(Документ, СтрокаПлана)

	Если Документ.ВидДокумента <> СтрокаПлана.ВидДокумента Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Документ.Сумма <> СтрокаПлана.Сумма Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НачалоДня(Документ.ДатаВходящегоДокумента) <> ДеньДокументаОперации(СтрокаПлана) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ВРег(СокрЛП(Документ.НомерВходящегоДокумента)) <> ВРег(НомерВходящегоДокументаОперации(СтрокаПлана)) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИдентификаторДокумента = СокрЛП(Документ.Идентификатор);
	ИдентификаторОперации = ИдентификаторОперацииСтроки(СтрокаПлана);
	Если Не ПустаяСтрока(ИдентификаторДокумента) И Не ПустаяСтрока(ИдентификаторОперации)
		И ВРег(ИдентификаторДокумента) <> ВРег(ИдентификаторОперации) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Документ.НомераСчетаКонтрагента.Количество() > 0 Тогда
		// Нормализованный номер с обеих сторон (без пробельных символов, в верхнем регистре): IBAN с пробелами в выписке или в
		// базе - тот же счет. Номера документа нормализуются в ПрочитатьБанковскиеДокументы.
		СчетОперации = НормализоватьНомерСчета(СтрокаПлана.КонтрагентНомерСчета);
		Если Документ.НомераСчетаКонтрагента.Найти(СчетОперации) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Ключ группы операций: вид документа, день, номер, счет контрагента, сумма. Идентификатор в ключ не входит:
// он отбирает документы по каждой операции отдельно (ДокументПодходитСтроке).
Функция КлючСоставной(СтрокаПлана)

	Возврат СтрШаблон("%1|%2|%3|%4|%5", СтрокаПлана.ВидДокумента,
		Формат(ДеньДокументаОперации(СтрокаПлана), "ДФ=yyyyMMdd"),
		ВРег(НомерВходящегоДокументаОперации(СтрокаПлана)), НормализоватьНомерСчета(СтрокаПлана.КонтрагентНомерСчета),
		XMLСтрока(СтрокаПлана.Сумма));

КонецФункции

// Номер, который операция несет в составном ключе и который запись кладет во входящий номер документа: без пробелов по краям
// и не длиннее реквизита НомерВходящегоДокумента (платформа молча обрезает более длинный номер при записи, и документ с
// необрезанным номером в ключе не узнавал бы сам себя - дубль при повторной загрузке). Одна функция для ключа шага 0 и записи.
Функция НомерВходящегоДокументаОперации(СтрокаПлана) Экспорт

	Возврат СокрП(Лев(СокрЛП(СтрокаПлана.НомерДокумента), ДлинаВходящегоНомера()));

КонецФункции

// Идентификатор операции, каким он идет в ключ шага 0 и в документ при записи: без пробелов по краям и НЕ обрезанный. Одна
// функция для ключа и записи. Идентификатор длиннее ДлинаИдентификатораОперации() запись не принимает (платформа молча
// обрезала бы его, и документ не узнал бы сам себя при повторной загрузке), поэтому ключ тоже необрезанный: обрезанный
// ключ принял бы за документ операции чужой документ с таким же началом.
Функция ИдентификаторОперацииСтроки(СтрокаПлана) Экспорт

	Возврат СокрЛП(СтрокаПлана.ИдентификаторОперации);

КонецФункции

// Длина реквизита СМП_ИДТранзакцииБанка банковских документов (из метаданных; у обоих документов одинакова - меньшая из двух
// гарантирует, что идентификатор помещается в любой).
Функция ДлинаИдентификатораОперации() Экспорт

	Возврат Мин(Метаданные.Документы.ПоступлениеНаСчет.Реквизиты.СМП_ИДТранзакцииБанка.Тип.КвалификаторыСтроки.Длина,
		Метаданные.Документы.РасходСоСчета.Реквизиты.СМП_ИДТранзакцииБанка.Тип.КвалификаторыСтроки.Длина);

КонецФункции

// Длина реквизита НомерВходящегоДокумента банковских документов (из метаданных; у обоих документов одинакова - меньшая из двух
// гарантирует, что номер помещается в любой).
Функция ДлинаВходящегоНомера()

	Возврат Мин(Метаданные.Документы.ПоступлениеНаСчет.Реквизиты.НомерВходящегоДокумента.Тип.КвалификаторыСтроки.Длина,
		Метаданные.Документы.РасходСоСчета.Реквизиты.НомерВходящегоДокумента.Тип.КвалификаторыСтроки.Длина);

КонецФункции

// День документа операции: ДатаДокумента, а пустая - ДатаОперации. Сравнивается как начало дня. Это же значение пишется во
// входящую дату документа при записи (D17): документ узнает сам себя тем же ключом.
Функция ДеньДокументаОперации(СтрокаПлана) Экспорт

	Если ЗначениеЗаполнено(СтрокаПлана.ДатаДокумента) Тогда
		Возврат НачалоДня(СтрокаПлана.ДатаДокумента);
	КонецЕсли;

	Возврат НачалоДня(СтрокаПлана.ДатаОперации);

КонецФункции

// Заполняет строку плана из найденного документа: тут только чтение, документ не меняется (D5).
Процедура ПрименитьЗагруженныйДокумент(СтрокаПлана, Документ)

	СтрокаПлана.ЗагруженныйДокумент = Документ.Ссылка;
	СтрокаПлана.ВидОперации = Документ.ВидОперации;
	СтрокаПлана.Контрагент = Документ.Контрагент;
	СтрокаПлана.Договор = Документ.Договор;
	СтрокаПлана.ИсточникВидаОперации = ИсточникЗагруженныйДокумент();

КонецПроцедуры

// Строки в порядке ПорядковыйНомер; при равных номерах - в порядке следования в таблице.
Функция СтрокиПоПорядковомуНомеру(Строки)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Строка");
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Позиция", Новый ОписаниеТипов("Число"));
	Позиция = 0;
	Для Каждого СтрокаПлана Из Строки Цикл
		Позиция = Позиция + 1;
		Запись = Таблица.Добавить();
		Запись.Строка = СтрокаПлана;
		Запись.Номер = СтрокаПлана.ПорядковыйНомер;
		Запись.Позиция = Позиция;
	КонецЦикла;
	Таблица.Сортировать("Номер, Позиция");

	Возврат Таблица.ВыгрузитьКолонку("Строка");

КонецФункции

// Текст одного запроса по банковским документам обоих видов: поступление и расход вместе, отбор по счету
// организации (и организации, если задана) плюс переданное условие. Помеченные на удаление не отсеиваются (D5).
// Порядок результата: дата, номер документа. Договор - из первой строки расшифровки платежа.
Функция ТекстЗапросаБанковскихДокументов(УсловиеОтбора, Контекст)

	// Договор в шапке документа не хранится: он лежит в табличной части РасшифровкаПлатежа. Берется договор ПЕРВОЙ
	// строки (соединение по Расшифровка.НомерСтроки = 1), если строк несколько - договоры остальных не учитываются.
	Шаблон =
		"ВЫБРАТЬ
		|	""%1"" КАК ВидДокумента,
		|	Т.Ссылка КАК Ссылка,
		|	Т.Дата КАК ДатаДокумента,
		|	Т.Номер КАК НомерДокумента,
		|	Т.СМП_ИДТранзакцииБанка КАК Идентификатор,
		|	Т.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	Т.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	Т.СуммаДокумента КАК Сумма,
		|	ЕСТЬNULL(Счет.НомерСчета, """") КАК НомерСчетаКонтрагента,
		|	ЕСТЬNULL(Счет.НомерСчетаУстаревший, """") КАК НомерСчетаКонтрагентаУстаревший,
		|	Т.ВидОперации КАК ВидОперации,
		|	Т.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(Расшифровка.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор
		|ИЗ
		|	Документ.%1 КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК Счет
		|		ПО Счет.Ссылка = Т.СчетКонтрагента
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.%1.РасшифровкаПлатежа КАК Расшифровка
		|		ПО Расшифровка.Ссылка = Т.Ссылка
		|			И Расшифровка.НомерСтроки = 1
		|ГДЕ
		|	Т.БанковскийСчет = &БанковскийСчет
		|	%2
		|	%3";

	ОтборОрганизации = ?(ЗначениеЗаполнено(Контекст.Организация), "И Т.Организация = &Организация", "");

	Части = Новый Массив;
	Части.Добавить(СтрШаблон(Шаблон, "ПоступлениеНаСчет", УсловиеОтбора, ОтборОрганизации));
	Части.Добавить(СтрШаблон(Шаблон, "РасходСоСчета", УсловиеОтбора, ОтборОрганизации));

	Возврат СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО ДатаДокумента, НомерДокумента, Ссылка";

КонецФункции

// Результат запроса банковских документов - массив структур в порядке запроса. НомераСчетаКонтрагента - непустые
// текущий и устаревший номера счета контрагента документа, нормализованные (без пробельных символов, в верхнем регистре;
// пусто - счета в документе нет).
Функция ПрочитатьБанковскиеДокументы(Запрос)

	Найденные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документ = Новый Структура(
			"Ссылка, ВидДокумента, Идентификатор, НомерВходящегоДокумента, ДатаВходящегоДокумента, Сумма, ВидОперации, Контрагент, Договор, НомераСчетаКонтрагента");
		ЗаполнитьЗначенияСвойств(Документ, Выборка);
		Документ.НомераСчетаКонтрагента = Новый Массив;
		Для Каждого Номер Из СтрРазделить(
			Выборка.НомерСчетаКонтрагента + Символы.ПС + Выборка.НомерСчетаКонтрагентаУстаревший, Символы.ПС) Цикл
			Если Не ПустаяСтрока(Номер) Тогда
				Документ.НомераСчетаКонтрагента.Добавить(НормализоватьНомерСчета(Номер));
			КонецЕсли;
		КонецЦикла;
		Найденные.Добавить(Документ);
	КонецЦикла;

	Возврат Найденные;

КонецФункции

#КонецОбласти

// Шаг 3 (D25), только списание: операция, на которую заранее введено платежное поручение, берет из него вид, статью,
// корреспонденцию и договор. Идет после шагов 1-2 и только для строк, где контрагент НАЙДЕН в базе (новому контрагенту
// поручения нет). Только читает: одним запросом по всему конверту.
//
// Поручение подходит строке, если: организация та же; контрагент тот же; сумма равна; дата не позже конца дня операции
// (ДатаОперации); не помечено на удаление; не оплачено (реквизит Оплачено - вендор ставит его в ОбработкаПроведения
// РасходСоСчета на основании поручения; при распроведении не снимается, поэтому оплаченное документом, который затем
// распровели или удалили, не находится - известное ограничение, шаг ничего не пишет); номер равен номеру документа
// операции без ведущих нулей: у поручения отбрасывается префикс (хвостовая серия цифр) и нули, у операции - нули;
// сравнение РАВЕНСТВОМ, не подстрокой (ПОДОБНО "%" + номер нашло бы "12" в "112").
// Банковский счет поручения не фильтрует, но чужой счет дает предупреждение.
//
// Несколько кандидатов: берется тот, у которого год даты совпал с годом операции; если год не решает (совпал у нескольких
// или ни у одного) - ни один и одно предупреждение с перечнем номеров и дат. Один кандидат берется независимо от года.
// Одно поручение - одна операция (как шаг 0): первая по ПорядковыйНомер; остальные идут дальше по шагам с предупреждением.
Процедура ШагПлатежноеПоручение(План, Контекст)

	Операции = Новый Массив;
	Контрагенты = Новый Массив;
	Суммы = Новый Массив;
	ПоследнийДень = '00010101';
	Для Каждого СтрокаПлана Из СтрокиДляРаспознавания(План) Цикл
		Если СтрокаПлана.ВидДокумента <> ВидДокументаРасходСоСчета() Или СтрокаПлана.ДействиеКонтрагент <> ДействиеНайден()
			Или ТипЗнч(СтрокаПлана.Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
			Продолжить;
		КонецЕсли;
		Номер = НомерБезВедущихНулей(СтрокаПлана.НомерДокумента);
		Момент = ?(ЗначениеЗаполнено(СтрокаПлана.ДатаОперации), СтрокаПлана.ДатаОперации, СтрокаПлана.ДатаДокумента);
		Если ПустаяСтрока(Номер) Или Не ЗначениеЗаполнено(Момент) Тогда
			Продолжить;
		КонецЕсли;
		Операции.Добавить(СтрокаПлана);
		Если Контрагенты.Найти(СтрокаПлана.Контрагент) = Неопределено Тогда
			Контрагенты.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
		Если Суммы.Найти(СтрокаПлана.Сумма) = Неопределено Тогда
			Суммы.Добавить(СтрокаПлана.Сумма);
		КонецЕсли;
		ПоследнийДень = Макс(ПоследнийДень, КонецДня(Момент));
	КонецЦикла;
	Если Операции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Поручения = ПрочитатьПоручения(Контекст.Организация, Контрагенты, Суммы, ПоследнийДень);
	Если Поручения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Занятые поручения: поручение -> порядковый номер операции, которая его взяла.
	Занятые = Новый Соответствие;
	Для Каждого СтрокаПлана Из СтрокиПоПорядковомуНомеру(Операции) Цикл
		Номер = НомерБезВедущихНулей(СтрокаПлана.НомерДокумента);
		Момент = ?(ЗначениеЗаполнено(СтрокаПлана.ДатаОперации), СтрокаПлана.ДатаОперации, СтрокаПлана.ДатаДокумента);
		Подходящие = Новый Массив;
		УжеЗанятые = Новый Массив;
		Для Каждого Поручение Из Поручения Цикл
			Если Поручение.Контрагент <> СтрокаПлана.Контрагент Или Поручение.Сумма <> СтрокаПлана.Сумма
				Или Поручение.Дата > КонецДня(Момент) Или Поручение.НомерБезНулей <> Номер Тогда
				Продолжить;
			КонецЕсли;
			Если Занятые.Получить(Поручение.Ссылка) <> Неопределено Тогда
				УжеЗанятые.Добавить(Поручение);
			Иначе
				Подходящие.Добавить(Поручение);
			КонецЕсли;
		КонецЦикла;

		Если Подходящие.Количество() = 0 Тогда
			Если УжеЗанятые.Количество() > 0 Тогда
				ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ПлатежноеПоручение", СМП_ВыпискаБанка.УровеньПредупреждение(),
					СтрШаблон(НСтр("ru = 'Платежное поручение %1 уже сопоставлено с операцией %2.';uk = 'Платіжне доручення %1 уже зіставлено з операцією %2.'"),
						УжеЗанятые[0].Номер, Формат(Занятые.Получить(УжеЗанятые[0].Ссылка), "ЧГ=0")));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Выбранное = Неопределено;
		Если Подходящие.Количество() = 1 Тогда
			Выбранное = Подходящие[0];
		Иначе
			ТогоЖеГода = Новый Массив;
			Для Каждого Поручение Из Подходящие Цикл
				Если Год(Поручение.Дата) = Год(Момент) Тогда
					ТогоЖеГода.Добавить(Поручение);
				КонецЕсли;
			КонецЦикла;
			Если ТогоЖеГода.Количество() = 1 Тогда
				Выбранное = ТогоЖеГода[0];
			Иначе
				Перечень = Новый Массив;
				Для Каждого Поручение Из Подходящие Цикл
					Перечень.Добавить(СтрШаблон("%1 (%2)", Поручение.Номер, Формат(Поручение.Дата, "ДФ=dd.MM.yyyy")));
				КонецЦикла;
				ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ПлатежноеПоручение", СМП_ВыпискаБанка.УровеньПредупреждение(),
					СтрШаблон(НСтр("ru = 'Несколько платежных поручений подходят операции, и год не позволяет выбрать: %1. Поручение не взято.';uk = 'Кілька платіжних доручень підходять операції, і рік не дозволяє вибрати: %1. Доручення не взято.'"),
						СтрСоединить(Перечень, "; ")));
			КонецЕсли;
		КонецЕсли;

		Если Выбранное <> Неопределено Тогда
			Занятые.Вставить(Выбранное.Ссылка, СтрокаПлана.ПорядковыйНомер);
			ПрименитьПоручение(План, СтрокаПлана, Выбранное, Контекст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьПоручение(План, СтрокаПлана, Поручение, Контекст)

	ВидСписания = ВидСписанияПоВидуПоручения(Поручение.ВидОперации);
	Если ВидСписания = Неопределено Тогда
		// Как вендорский запрос (ИНАЧЕ): вид, которого нет в таблице, - оплата поставщику; человеку об этом сообщается.
		ВидСписания = Перечисления.ВидыОперацийРасходСоСчета.Поставщику;
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ПлатежноеПоручение", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Вид платежного поручения %1 (%2) не имеет соответствия виду списания: принят вид ""Поставщику"".';uk = 'Вид платіжного доручення %1 (%2) не має відповідності виду списання: прийнято вид ""Постачальнику"".'"),
				Поручение.Номер, ?(ЗначениеЗаполнено(Поручение.ВидОперации), Строка(Поручение.ВидОперации), НСтр("ru = 'не указан';uk = 'не вказано'"))));
	КонецЕсли;

	СтрокаПлана.ВидОперации = ВидСписания;
	СтрокаПлана.ИсточникВидаОперации = ИсточникПлатежноеПоручение();
	СтрокаПлана.ПлатежноеПоручение = Поручение.Ссылка;
	Если ЗначениеЗаполнено(Поручение.Статья) Тогда
		СтрокаПлана.СтатьяДДС = Поручение.Статья;
		СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиПлатежноеПоручение();
	КонецЕсли;
	Если ЗначениеЗаполнено(Поручение.Корреспонденция) Тогда
		СтрокаПлана.Корреспонденция = Поручение.Корреспонденция;
	КонецЕсли;
	// Договор из поручения завершение не перевыбирает (ВыбратьДоговоры пропускает строки с договором).
	Если ЗначениеЗаполнено(Поручение.Договор) Тогда
		СтрокаПлана.Договор = Поручение.Договор;
		СтрокаПлана.ДействиеДоговор = ДействиеНайден();
	КонецЕсли;

	Если ЗначениеЗаполнено(Поручение.БанковскийСчет) И Поручение.БанковскийСчет <> Контекст.БанковскийСчет Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ПлатежноеПоручение", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Поручение выписано с другого счета: платежное поручение %1, счет %2.';uk = 'Доручення виписане з іншого рахунку: платіжне доручення %1, рахунок %2.'"),
				Поручение.Номер, Поручение.НомерСчета));
	КонецЕсли;

КонецПроцедуры

// Платежные поручения организации по контрагентам и суммам конверта: не помеченные на удаление, не оплаченные (Оплачено),
// с датой не позже последнего дня конверта. Один запрос на конверт; порядок - дата, номер.
Функция ПрочитатьПоручения(Организация, Контрагенты, Суммы, ПоследнийДень)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Поручения.Ссылка КАК Ссылка,
		|	Поручения.Номер КАК Номер,
		|	Поручения.Дата КАК Дата,
		|	Поручения.Контрагент КАК Контрагент,
		|	Поручения.СуммаДокумента КАК Сумма,
		|	Поручения.ВидОперации КАК ВидОперации,
		|	Поручения.Статья КАК Статья,
		|	Поручения.Корреспонденция КАК Корреспонденция,
		|	Поручения.Договор КАК Договор,
		|	Поручения.БанковскийСчет КАК БанковскийСчет,
		|	ЕСТЬNULL(Поручения.БанковскийСчет.НомерСчета, """") КАК НомерСчета
		|ИЗ
		|	Документ.ПлатежноеПоручение КАК Поручения
		|ГДЕ
		|	Поручения.Организация = &Организация
		|	И Поручения.Контрагент В (&Контрагенты)
		|	И Поручения.СуммаДокумента В (&Суммы)
		|	И Поручения.Дата <= &ПоследнийДень
		|	И НЕ Поручения.ПометкаУдаления
		|	И НЕ Поручения.Оплачено
		|
		|УПОРЯДОЧИТЬ ПО
		|	Поручения.Дата,
		|	Поручения.Номер,
		|	Поручения.Ссылка");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Суммы", Суммы);
	Запрос.УстановитьПараметр("ПоследнийДень", ПоследнийДень);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Поручение = Новый Структура("Ссылка, Номер, Дата, Контрагент, Сумма, ВидОперации, Статья, Корреспонденция, Договор, БанковскийСчет, НомерСчета, НомерБезНулей");
		ЗаполнитьЗначенияСвойств(Поручение, Выборка);
		Поручение.НомерБезНулей = НомерБезВедущихНулей(ЦифровойХвост(Выборка.Номер));
		Результат.Добавить(Поручение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вид списания по виду платежного поручения. Источник - вендорский РасходСоСчета.ЗаполнитьПоПлатежноеПоручение (запрос
// ВЫБОР КОГДА ТаблицаДокумента.ВидОперации = ... ТОГДА ..., ИНАЧЕ Поставщику); вызываемой функции или таблицы у вендора нет,
// поэтому соответствие продублировано здесь, а тест сверяет его с вендорским перечнем пар. Неопределено - вида нет в таблице.
Функция ВидСписанияПоВидуПоручения(ВидПоручения)

	Соответствие = Новый Соответствие;
	Поручения = Перечисления.ВидыОперацийПлатежноеПоручение;
	Списания = Перечисления.ВидыОперацийРасходСоСчета;
	Соответствие.Вставить(Поручения.Оплата, Списания.Поставщику);
	Соответствие.Вставить(Поручения.ПеречислениеНалога, Списания.Налоги);
	Соответствие.Вставить(Поручения.Зарплата, Списания.Зарплата);
	Соответствие.Вставить(Поручения.ЛичныеСредстваПредпринимателя, Списания.ЛичныеСредстваПредпринимателя);
	Соответствие.Вставить(Поручения.НаРасходы, Списания.НаРасходы);
	Соответствие.Вставить(Поручения.ПереводНаДругойСчет, Списания.ПереводНаДругойСчет);
	Соответствие.Вставить(Поручения.Покупателю, Списания.Покупателю);
	Соответствие.Вставить(Поручения.Прочее, Списания.Прочее);
	Соответствие.Вставить(Поручения.ПрочиеРасчеты, Списания.ПрочиеРасчеты);
	Соответствие.Вставить(Поручения.Подотчетнику, Списания.Подотчетнику);
	Соответствие.Вставить(Поручения.ЗарплатаСотруднику, Списания.ЗарплатаСотруднику);
	Соответствие.Вставить(Поручения.РасчетыПоКредитам, Списания.РасчетыПоКредитам);

	Возврат Соответствие.Получить(ВидПоручения);

КонецФункции

// Хвостовая серия цифр номера: "ОР00-000123" -> "000123". Префикс - все, что до нее. Нет цифр - пустая строка.
Функция ЦифровойХвост(Номер)

	Текст = СокрЛП(Номер);
	Позиция = СтрДлина(Текст);
	Пока Позиция > 0 И СтрНайти("0123456789", Сред(Текст, Позиция, 1)) > 0 Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Сред(Текст, Позиция + 1);

КонецФункции

// Номер без ведущих нулей, в верхнем регистре; "000" -> пустая строка.
Функция НомерБезВедущихНулей(Номер)

	Текст = ВРег(СокрЛП(Номер));
	Пока СтрДлина(Текст) > 0 И Лев(Текст, 1) = "0" Цикл
		Текст = Сред(Текст, 2);
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Типовые правила: Фраза, ВидПоступления, ВидРасхода (пустая ссылка - для направления вида нет). Комиссия добавляется раньше
// возвратов. Порядок ПРИМЕНЕНИЯ правил определяет код справочника, а платформа не гарантирует, что коды растут в порядке
// создания, поэтому для текста с фразами обеих групп ("Возврат комиссии за расчетное обслуживание") победитель зависит от
// выданных кодов; порядок добавления на это не опирается.
Функция ТиповыеПравилаНазначения()

	Прочее = Перечисления.ВидыОперацийРасходСоСчета.Прочее;
	ПустойВидПоступления = Перечисления.ВидыОперацийПоступлениеНаСчет.ПустаяСсылка();

	Фразы = Новый Массив;
	Фразы.Добавить("Розрахункове обслуговування");
	Фразы.Добавить("Расчетное обслуживание");
	Фразы.Добавить("Расчётное обслуживание");
	Фразы.Добавить("Розрахункові послуги");
	Фразы.Добавить("Расчетные услуги");
	Фразы.Добавить("Расчётные услуги");
	Фразы.Добавить("Розрахунково-касове обслуговування");
	// Латинские "i" - как в банковском тексте (нынешний код СМП_КлиентБанк); рядом - кириллический вариант.
	Фразы.Добавить("Комiсiя за виконання платежiв");
	Фразы.Добавить("Комісія за виконання платежів");

	Результат = Новый Массив;
	Для Каждого Фраза Из Фразы Цикл
		Результат.Добавить(Новый Структура("Фраза, ВидПоступления, ВидРасхода", Фраза, ПустойВидПоступления, Прочее));
	КонецЦикла;

	Для Каждого Фраза Из СтрРазделить("Повернення,Возврат", ",") Цикл
		Результат.Добавить(Новый Структура("Фраза, ВидПоступления, ВидРасхода", Фраза,
			Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПоставщика, Перечисления.ВидыОперацийРасходСоСчета.Покупателю));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Шаг 4 (D24, D25, D35.1, D12, D35.7): правила справочника СоответствияНазначенийПлатежаИРеквизитовПлатежа по тексту
// назначения платежа. Единственный источник правил по тексту (вшитых ключевых слов нет). Только читает: справочник
// читается ОДНИМ запросом на конверт, сопоставление - в памяти.
//
// Совпадение: фраза содержится в назначении без учета регистра (подстрока: без границ слова, без регулярных выражений -
// на этой семантике стоят правила пользователей); ни фраза, ни назначение не обрезаются. Пустая фраза (в том числе из
// пробелов) не совпадает никогда. Порядок - по коду справочника, первое подходящее правило выигрывает. Правило
// подходит строке, если для ее направления заполнен вид операции (ВидОперацииПоступленияНаСчет для поступления,
// ВидОперацииРасходаСоСчета для списания); правило без вида для этого направления пропускается и проверка идет дальше.
// Помеченные на удаление правила не читаются. Идет для строк, которым вид не дали шаги 0-3.
Процедура ШагПравилаНазначения(План)

	Строки = СтрокиДляРаспознавания(План);
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Правила = ПрочитатьПравилаНазначения();
	Если Правила.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПлана Из Строки Цикл
		ЭтоПоступление = (СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет());
		Назначение = ВРег(СтрокаПлана.НазначениеПлатежа);
		Для Каждого Правило Из Правила Цикл
			Вид = ?(ЭтоПоступление, Правило.ВидПоступления, Правило.ВидРасхода);
			Если Не ЗначениеЗаполнено(Вид) Или ПустаяСтрока(Правило.Фраза) Или СтрНайти(Назначение, Правило.ФразаВРег) = 0 Тогда
				Продолжить;
			КонецЕсли;
			ПрименитьПравилоНазначения(План, СтрокаПлана, Правило, Вид);
			Прервать;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Правила, не помеченные на удаление, в порядке кода. Один запрос; фраза не обрезается (ФразаВРег - для сопоставления).
Функция ПрочитатьПравилаНазначения()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Правила.Ссылка КАК Ссылка,
		|	Правила.ФразаДляПоискаВНазначенииПлатежа КАК Фраза,
		|	Правила.ВидОперацииПоступленияНаСчет КАК ВидПоступления,
		|	Правила.ВидОперацииРасходаСоСчета КАК ВидРасхода,
		|	Правила.СтатьяДДС КАК СтатьяДДС,
		|	Правила.Корреспонденция КАК Корреспонденция,
		|	Правила.СМП_ВидНалога КАК ВидНалога,
		|	Правила.Проект КАК Проект,
		|	Правила.Подразделение КАК Подразделение
		|ИЗ
		|	Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа КАК Правила
		|ГДЕ
		|	НЕ Правила.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Правила.Код,
		|	Правила.Ссылка");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правило = Новый Структура("Ссылка, Фраза, ФразаВРег, ВидПоступления, ВидРасхода, СтатьяДДС, Корреспонденция, ВидНалога, Проект, Подразделение");
		ЗаполнитьЗначенияСвойств(Правило, Выборка);
		Правило.ФразаВРег = ВРег(Выборка.Фраза);
		Результат.Добавить(Правило);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переносит из правила вид операции (для направления строки) и те из статьи, корреспонденции, вида налога, проекта и
// подразделения, что заполнены. Вид "Налоги" без вида налога - "Ошибка" на поле ВидНалога (D12: документ с таким видом без
// вида налога не проведется); правило при этом применяется. Проект правила приоритетнее проекта договора (D35.1): проект
// договора подставит этап 4, только если колонка Проект осталась пустой.
Процедура ПрименитьПравилоНазначения(План, СтрокаПлана, Правило, Вид)

	СтрокаПлана.ВидОперации = Вид;
	СтрокаПлана.ИсточникВидаОперации = ИсточникПравилоНазначения();
	СтрокаПлана.ПравилоНазначения = Правило.Ссылка;
	Если ЗначениеЗаполнено(Правило.СтатьяДДС) Тогда
		СтрокаПлана.СтатьяДДС = Правило.СтатьяДДС;
		СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиПравилоНазначения();
	КонецЕсли;
	Если ЗначениеЗаполнено(Правило.Корреспонденция) Тогда
		СтрокаПлана.Корреспонденция = Правило.Корреспонденция;
	КонецЕсли;
	Если ЗначениеЗаполнено(Правило.ВидНалога) Тогда
		СтрокаПлана.ВидНалога = Правило.ВидНалога;
	КонецЕсли;
	Если ЗначениеЗаполнено(Правило.Проект) Тогда
		СтрокаПлана.Проект = Правило.Проект;
	КонецЕсли;
	Если ЗначениеЗаполнено(Правило.Подразделение) Тогда
		СтрокаПлана.Подразделение = Правило.Подразделение;
	КонецЕсли;

	ЭтоНалоги = (Вид = Перечисления.ВидыОперацийПоступлениеНаСчет.Налоги Или Вид = Перечисления.ВидыОперацийРасходСоСчета.Налоги);
	Если ЭтоНалоги И Не ЗначениеЗаполнено(Правило.ВидНалога) Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ВидНалога", СМП_ВыпискаБанка.УровеньОшибка(),
			НСтр("ru = 'В правиле назначения платежа для вида операции ""Налоги"" не указан вид налога: документ будет непроведенным.';
				|uk = 'У правилі призначення платежу для виду операції ""Податки"" не вказано вид податку: документ буде непроведеним.'"));
	КонецЕсли;

КонецПроцедуры

// Шаг 5 (D21, D35.3): заказ, счет или документ расчетов, найденный по номеру в назначении платежа. Для контрагента, НАЙДЕННОГО в
// базе (новому документ искать негде), и строки, которой не дали вид шаги 0-4. Пишет в строку ДокументПоНомеру, вид операции
// (поступление - от покупателя, списание - поставщику) и источник; договор выбирает завершение (по договору найденного документа).
//
// Кандидаты: проведенные, не помеченные на удаление, той же организации и того же контрагента: заказ и счет покупателя (поступление)
// или заказ и счет поставщика (списание) - ОДНИМ запросом на конверт, номера сопоставляются в памяти. У документа поставщика ищется
// входящий номер, если он заполнен, иначе собственный. Документы расчетов - только если заказа или счета по номеру нет совсем и
// только для контрагента с ВестиРасчетыПоДокументам: остаток регистра взаиморасчетов по тому же условию, что у вендора при заполнении
// расшифровки платежа (ПоступлениеНаСчет / РасходСоСчета, ЗаполнитьРасшифровкуПлатежа): организация - Константы.УчетПоКомпании.
// Компания(Организация) (регистры пишутся на компанию), тип расчетов "Долг", СуммаВалОстаток > 0 по документу; отбор по виду договора -
// как у вендора, когда ТребуетсяКонтрольДоговоровКонтрагентов() и контрагент ведет расчеты по договорам (список видов -
// Справочники.ДоговорыКонтрагентов.ПолучитьСписокВидовДоговораДляДокумента с пустой ссылкой на тип банковского документа).
// Аванс не кандидат: тип расчетов не "Долг".
//
// Номер (полный, хвост из цифр без ведущих нулей, "для печати" вендора) должен стоять в назначении ОТДЕЛЬНЫМ числом (см.
// СодержитОтдельноеЧисло). Несколько кандидатов: остается тот, чей год встречается в назначении отдельным числом; не один - ни один
// и "Предупреждение" с перечнем. Совпавшие, но неразрешенные заказы и счета блокируют поиск документов расчетов.
Процедура ШагДокументПоНомеру(План, Контекст)

	Строки = Новый Массив;
	Контрагенты = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из СтрокиДляРаспознавания(План) Цикл
		Если СтрокаПлана.ДействиеКонтрагент <> ДействиеНайден() Или ТипЗнч(СтрокаПлана.Контрагент) <> Тип("СправочникСсылка.Контрагенты")
			Или ПустаяСтрока(СтрокаПлана.НазначениеПлатежа) Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(СтрокаПлана);
		Если Повторы.Получить(СтрокаПлана.Контрагент) = Неопределено Тогда
			Повторы.Вставить(СтрокаПлана.Контрагент, Истина);
			Контрагенты.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Основания = ПрочитатьДокументыОснования(Контекст.Организация, Контрагенты);
	ДляРасчетов = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Итог = НайтиДокументПоНомеру(План, СтрокаПлана, Основания.Получить(СтрокаПлана.Контрагент));
		Если Итог.Документ <> Неопределено Тогда
			ПрименитьДокументПоНомеру(СтрокаПлана, Итог.Документ);
		ИначеЕсли Итог.Совпало = 0 Тогда
			ДляРасчетов.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;

	Если ДляРасчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Расчеты = ПрочитатьДокументыРасчетов(Контекст.Организация, ДляРасчетов);
	Для Каждого СтрокаПлана Из ДляРасчетов Цикл
		Итог = НайтиДокументПоНомеру(План, СтрокаПлана, Расчеты.Получить(СтрокаПлана.Контрагент));
		Если Итог.Документ <> Неопределено Тогда
			ПрименитьДокументПоНомеру(СтрокаПлана, Итог.Документ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Группа документов строки: 1 - покупатель (поступление), 2 - поставщик (списание).
Функция ГруппаДокументовСтроки(СтрокаПлана)

	Возврат ?(СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет(), 1, 2);

КонецФункции

// Ищет среди кандидатов своей группы тех, чей номер стоит в назначении; решает неоднозначность годом. Возвращает структуру:
// Документ (Неопределено, если не выбран) и Совпало (сколько кандидатов подошло по номеру).
Функция НайтиДокументПоНомеру(План, СтрокаПлана, Кандидаты)

	Результат = Новый Структура("Документ, Совпало", Неопределено, 0);
	Если Кандидаты = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Назначение = ВРег(СтрокаПлана.НазначениеПлатежа);
	Группа = ГруппаДокументовСтроки(СтрокаПлана);
	Совпавшие = Новый Массив;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Группа <> Группа Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вариант Из Кандидат.Номера Цикл
			Если СодержитОтдельноеЧисло(Назначение, Вариант, Истина) Тогда
				Совпавшие.Добавить(Кандидат);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Результат.Совпало = Совпавшие.Количество();
	Если Совпавшие.Количество() = 1 Тогда
		Результат.Документ = Совпавшие[0].Ссылка;
		Возврат Результат;
	ИначеЕсли Совпавшие.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ТогоГода = Новый Массив;
	Для Каждого Кандидат Из Совпавшие Цикл
		Если СодержитОтдельноеЧисло(Назначение, Формат(Год(Кандидат.Дата), "ЧГ=0"), Ложь) Тогда
			ТогоГода.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;
	Если ТогоГода.Количество() = 1 Тогда
		Результат.Документ = ТогоГода[0].Ссылка;
		Возврат Результат;
	КонецЕсли;

	Перечень = Новый Массив;
	Для Каждого Кандидат Из Совпавшие Цикл
		Перечень.Добавить(СтрШаблон("%1 (%2)", Кандидат.ПредставлениеНомера, Формат(Кандидат.Дата, "ДФ=dd.MM.yyyy")));
	КонецЦикла;
	ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "ДокументПоНомеру", СМП_ВыпискаБанка.УровеньПредупреждение(),
		СтрШаблон(НСтр("ru = 'Несколько документов подходят по номеру в назначении, и год не позволяет выбрать: %1. Документ не взят.';uk = 'Кілька документів підходять за номером у призначенні, і рік не дозволяє вибрати: %1. Документ не взято.'"),
			СтрСоединить(Перечень, "; ")));

	Возврат Результат;

КонецФункции

Процедура ПрименитьДокументПоНомеру(СтрокаПлана, Документ)

	СтрокаПлана.ДокументПоНомеру = Документ;
	Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя;
	Иначе
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Поставщику;
	КонецЕсли;
	СтрокаПлана.ИсточникВидаОперации = ИсточникДокументПоНомеру();

КонецПроцедуры

// Заказы и счета (покупателя и поставщика) контрагентов: проведенные, не помеченные, организации распознавания. Один запрос на
// конверт. Результат - соответствие "контрагент -> массив кандидатов" (КандидатДокумент).
Функция ПрочитатьДокументыОснования(Организация, Контрагенты)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Ссылка,
		|	Д.Контрагент КАК Контрагент,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата,
		|	"""" КАК НомерВходящий,
		|	1 КАК Группа
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И НЕ Д.ПометкаУдаления
		|	И Д.Организация = &Организация
		|	И Д.Контрагент В (&Контрагенты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Д.Ссылка,
		|	Д.Контрагент,
		|	Д.Номер,
		|	Д.Дата,
		|	"""",
		|	1
		|ИЗ
		|	Документ.СчетНаОплату КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И НЕ Д.ПометкаУдаления
		|	И Д.Организация = &Организация
		|	И Д.Контрагент В (&Контрагенты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Д.Ссылка,
		|	Д.Контрагент,
		|	Д.Номер,
		|	Д.Дата,
		|	Д.НомерВходящегоДокумента,
		|	2
		|ИЗ
		|	Документ.ЗаказПоставщику КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И НЕ Д.ПометкаУдаления
		|	И Д.Организация = &Организация
		|	И Д.Контрагент В (&Контрагенты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Д.Ссылка,
		|	Д.Контрагент,
		|	Д.Номер,
		|	Д.Дата,
		|	Д.НомерВходящегоДокумента,
		|	2
		|ИЗ
		|	Документ.СчетНаОплатуПоставщика КАК Д
		|ГДЕ
		|	Д.Проведен
		|	И НЕ Д.ПометкаУдаления
		|	И Д.Организация = &Организация
		|	И Д.Контрагент В (&Контрагенты)");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Результат, Выборка.Контрагент, Выборка.Ссылка, Выборка.Номер, Выборка.НомерВходящий, Выборка.Дата, Выборка.Группа);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Документы расчетов с остатком "Долг" > 0 для контрагентов строк (с ВестиРасчетыПоДокументам): покупатели -
// РасчетыСПокупателями (строки-поступления), поставщики - РасчетыСПоставщиками (списания). Один пакетный запрос на конверт; для
// поставщиков входящий номер документа дочитывается по типам документов (реквизит есть не у всех). Результат - как у
// ПрочитатьДокументыОснования.
Функция ПрочитатьДокументыРасчетов(Организация, Строки)

	КонтрагентыПокупатели = Новый Массив;
	КонтрагентыПоставщики = Новый Массив;
	Все = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Список = ?(ГруппаДокументовСтроки(СтрокаПлана) = 1, КонтрагентыПокупатели, КонтрагентыПоставщики);
		Если Список.Найти(СтрокаПлана.Контрагент) = Неопределено Тогда
			Список.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
		Если Все.Найти(СтрокаПлана.Контрагент) = Неопределено Тогда
			Все.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
	КонецЦикла;

	// Условие вендора (ПоступлениеНаСчет / РасходСоСчета, ЗаполнитьРасшифровкуПлатежа): отбор по виду договора только при
	// контроле договоров и учете расчетов по договорам. Виды - для пустой ссылки на тип банковского документа и вида операции.
	Контроль = УправлениеНебольшойФирмойПовтИсп.ТребуетсяКонтрольДоговоровКонтрагентов();
	ВидыПокупатели = Новый Массив;
	ВидыПоставщики = Новый Массив;
	Если Контроль Тогда
		ВидыПокупатели = Справочники.ДоговорыКонтрагентов.ПолучитьСписокВидовДоговораДляДокумента(
			Документы.ПоступлениеНаСчет.ПустаяСсылка(), Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя).ВыгрузитьЗначения();
		ВидыПоставщики = Справочники.ДоговорыКонтрагентов.ПолучитьСписокВидовДоговораДляДокумента(
			Документы.РасходСоСчета.ПустаяСсылка(), Перечисления.ВидыОперацийРасходСоСчета.Поставщику).ВыгрузитьЗначения();
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ КонтрагентыСДокументами
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Контрагенты)
		|	И Контрагенты.ВестиРасчетыПоДокументам
		|;
		|
		|ВЫБРАТЬ
		|	Остатки.Контрагент КАК Контрагент,
		|	Остатки.Документ КАК Ссылка,
		|	Остатки.Документ.Номер КАК Номер,
		|	Остатки.Документ.Дата КАК Дата
		|ИЗ
		|	РегистрНакопления.РасчетыСПокупателями.Остатки(
		|			,
		|			Организация = &Компания
		|				И Контрагент В (&КонтрагентыПокупатели)
		|				И ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
		|				И (НЕ &НуженОтборПоВидуДоговора
		|					ИЛИ НЕ Контрагент.ВестиРасчетыПоДоговорам
		|					ИЛИ Договор.ВидДоговора В (&ВидыПокупатели))) КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтрагентыСДокументами КАК КонтрагентыСДокументами
		|		ПО Остатки.Контрагент = КонтрагентыСДокументами.Ссылка
		|ГДЕ
		|	Остатки.Документ.Проведен
		|	И НЕ Остатки.Документ.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Контрагент,
		|	Остатки.Документ,
		|	Остатки.Документ.Номер,
		|	Остатки.Документ.Дата
		|
		|ИМЕЮЩИЕ
		|	СУММА(Остатки.СуммаВалОстаток) > 0
		|;
		|
		|ВЫБРАТЬ
		|	Остатки.Контрагент КАК Контрагент,
		|	Остатки.Документ КАК Ссылка,
		|	Остатки.Документ.Номер КАК Номер,
		|	Остатки.Документ.Дата КАК Дата
		|ИЗ
		|	РегистрНакопления.РасчетыСПоставщиками.Остатки(
		|			,
		|			Организация = &Компания
		|				И Контрагент В (&КонтрагентыПоставщики)
		|				И ТипРасчетов = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
		|				И (НЕ &НуженОтборПоВидуДоговора
		|					ИЛИ НЕ Контрагент.ВестиРасчетыПоДоговорам
		|					ИЛИ Договор.ВидДоговора В (&ВидыПоставщики))) КАК Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтрагентыСДокументами КАК КонтрагентыСДокументами
		|		ПО Остатки.Контрагент = КонтрагентыСДокументами.Ссылка
		|ГДЕ
		|	Остатки.Документ.Проведен
		|	И НЕ Остатки.Документ.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Контрагент,
		|	Остатки.Документ,
		|	Остатки.Документ.Номер,
		|	Остатки.Документ.Дата
		|
		|ИМЕЮЩИЕ
		|	СУММА(Остатки.СуммаВалОстаток) > 0");
	Запрос.УстановитьПараметр("Контрагенты", Все);
	Запрос.УстановитьПараметр("Компания", Константы.УчетПоКомпании.Компания(Организация));
	Запрос.УстановитьПараметр("КонтрагентыПокупатели", КонтрагентыПокупатели);
	Запрос.УстановитьПараметр("КонтрагентыПоставщики", КонтрагентыПоставщики);
	Запрос.УстановитьПараметр("НуженОтборПоВидуДоговора", Контроль);
	Запрос.УстановитьПараметр("ВидыПокупатели", ВидыПокупатели);
	Запрос.УстановитьПараметр("ВидыПоставщики", ВидыПоставщики);
	Пакет = Запрос.ВыполнитьПакет();

	Результат = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьКандидата(Результат, Выборка.Контрагент, Выборка.Ссылка, Выборка.Номер, "", Выборка.Дата, 1);
	КонецЦикла;

	Поставщики = Новый Массив;
	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Поставщики.Добавить(Новый Структура("Контрагент, Ссылка, Номер, Дата", Выборка.Контрагент, Выборка.Ссылка, Выборка.Номер, Выборка.Дата));
	КонецЦикла;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Поставщики Цикл
		Ссылки.Добавить(Элемент.Ссылка);
	КонецЦикла;
	Входящие = ПрочитатьРеквизитДокументов(Ссылки, "НомерВходящегоДокумента");
	Для Каждого Элемент Из Поставщики Цикл
		Входящий = Входящие.Получить(Элемент.Ссылка);
		ДобавитьКандидата(Результат, Элемент.Контрагент, Элемент.Ссылка, Элемент.Номер, ?(Входящий = Неопределено, "", Входящий), Элемент.Дата, 2);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кандидат: ссылка, группа (1 - покупатель, 2 - поставщик), дата, ищущиеся номера и номер для перечня. У документа поставщика, если
// входящий номер заполнен, ищется он, иначе собственный.
Процедура ДобавитьКандидата(Результат, Контрагент, Ссылка, Номер, НомерВходящий, Дата, Группа)

	Использованный = ?(Группа = 2 И Не ПустаяСтрока(НомерВходящий), НомерВходящий, Номер);
	Номера = ВариантыНомераДокумента(Использованный);
	Если Номера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Кандидат = Новый Структура("Ссылка, Группа, Дата, Номера, ПредставлениеНомера", Ссылка, Группа, Дата, Номера, СокрЛП(Использованный));
	Список = Результат.Получить(Контрагент);
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Результат.Вставить(Контрагент, Список);
	КонецЕсли;
	Список.Добавить(Кандидат);

КонецПроцедуры

// Варианты номера, которые ищутся в назначении (в верхнем регистре): полный; хвостовая серия цифр без ведущих нулей; номер "для
// печати" вендора (ПрефиксацияОбъектовКлиентСервер.НомерНаПечать: без префиксов организации и базы). Номер, чей цифровой хвост из
// одних нулей, и пустой номер не ищутся (пустой массив).
Функция ВариантыНомераДокумента(Номер)

	Результат = Новый Массив;
	Полный = ВРег(СокрЛП(Номер));
	Если ПустаяСтрока(Полный) Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = ЦифровойХвост(Полный);
	БезНулей = НомерБезВедущихНулей(Хвост);
	Если Не ПустаяСтрока(Хвост) И ПустаяСтрока(БезНулей) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Полный);
	Если Не ПустаяСтрока(БезНулей) И Результат.Найти(БезНулей) = Неопределено Тогда
		Результат.Добавить(БезНулей);
	КонецЕсли;
	Печатный = ВРег(СокрЛП(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Полный, Истина, Истина)));
	Если Не ПустаяСтрока(Печатный) И Результат.Найти(Печатный) = Неопределено
		И Не ПустаяСтрока(НомерБезВедущихНулей(ЦифровойХвост(Печатный))) Тогда
		Результат.Добавить(Печатный);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Стоит ли Число в Тексте (оба в верхнем регистре) ОТДЕЛЬНЫМ числом: перед и после - не цифра. Для номера документа
// (КакНомер = Истина) "цифра[,.]цифра" - часть одного числа: "123,45" и "123.10.2026" не дают 123, а точка или запятая в конце фразы
// ("№123.") число не продолжают. Для года (КакНомер = Ложь) граница - только "не цифра", год находится и внутри даты дд.мм.рррр.
Функция СодержитОтдельноеЧисло(Текст, Число, КакНомер)

	Длина = СтрДлина(Число);
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	НомерВхождения = 1;
	Пока Истина Цикл
		Позиция = СтрНайти(Текст, Число, НаправлениеПоиска.СНачала, 1, НомерВхождения);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Не ПродолжаетсяЧислом(Текст, Позиция - 1, -1, КакНомер) И Не ПродолжаетсяЧислом(Текст, Позиция + Длина, 1, КакНомер) Тогда
			Возврат Истина;
		КонецЕсли;
		НомерВхождения = НомерВхождения + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Продолжается ли число соседним символом на позиции Позиция (шаг -1 - слева от числа, 1 - справа): соседняя цифра; для номера
// еще разделитель (запятая или точка), за которым (в ту же сторону) тоже цифра.
Функция ПродолжаетсяЧислом(Текст, Позиция, Шаг, КакНомер)

	Символ = СимволВПозиции(Текст, Позиция);
	Если ЭтоЦифра(Символ) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не КакНомер Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (Символ = "," Или Символ = ".") И ЭтоЦифра(СимволВПозиции(Текст, Позиция + Шаг));

КонецФункции

// Символ на позиции; за пределами строки (в том числе позиция меньше 1) - пустая строка.
Функция СимволВПозиции(Текст, Позиция)

	Если Позиция < 1 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Текст, Позиция, 1);

КонецФункции

// Цифра ("" - не цифра).
Функция ЭтоЦифра(Символ)

	Возврат Символ <> "" И СтрНайти("0123456789", Символ) > 0;

КонецФункции

// Значения реквизита для документов (разных типов): по одному запросу-выбору на тип в одном пакете; типы без такого шапочного
// реквизита пропускаются. Результат - соответствие "документ -> значение".
Функция ПрочитатьРеквизитДокументов(СписокДокументов, ИмяРеквизита)

	Результат = Новый Соответствие;
	ПоТипам = Новый Соответствие;
	Для Каждого Документ Из СписокДокументов Цикл
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Документ.Метаданные();
		Если Описание.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоТипам.Получить(Описание.ПолноеИмя());
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоТипам.Вставить(Описание.ПолноеИмя(), Список);
		КонецЕсли;
		Список.Добавить(Документ);
	КонецЦикла;
	Если ПоТипам.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Тексты = Новый Массив;
	Индекс = 0;
	Для Каждого Элемент Из ПоТипам Цикл
		Индекс = Индекс + 1;
		Тексты.Добавить("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т." + ИмяРеквизита + " КАК Значение ИЗ " + Элемент.Ключ
			+ " КАК Т ГДЕ Т.Ссылка В (&Список" + Индекс + ")");
		Запрос.УстановитьПараметр("Список" + Индекс, Элемент.Значение);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(Тексты, ";" + Символы.ПС);
	Для Каждого РезультатЗапроса Из Запрос.ВыполнитьПакет() Цикл
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Договор найденных шагом 5 документов: непустой договор документа берется как есть ("Найден"), без отбора по виду договора и
// проверки владельца (кандидаты уже отобраны по организации и контрагенту; договор основания поставит вендор при заполнении
// документа). Пустой договор или документ без шапочного договора - обычный выбор в ВыбратьДоговоры. Один пакетный запрос.
Процедура ПрименитьДоговорыНайденныхДокументов(Строки)

	Найденные = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ДокументПоНомеру) И Не ЗначениеЗаполнено(СтрокаПлана.Договор)
			И ПустаяСтрока(СтрокаПлана.ДействиеДоговор) Тогда
			Найденные.Добавить(СтрокаПлана.ДокументПоНомеру);
		КонецЕсли;
	КонецЦикла;
	Если Найденные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Договоры = ПрочитатьРеквизитДокументов(Найденные, "Договор");
	Для Каждого СтрокаПлана Из Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаПлана.ДокументПоНомеру) Или ЗначениеЗаполнено(СтрокаПлана.Договор)
			Или Не ПустаяСтрока(СтрокаПлана.ДействиеДоговор) Тогда
			Продолжить;
		КонецЕсли;
		Договор = Договоры.Получить(СтрокаПлана.ДокументПоНомеру);
		Если ЗначениеЗаполнено(Договор) Тогда
			СтрокаПлана.Договор = Договор;
			СтрокаПлана.ДействиеДоговор = ДействиеНайден();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Шаг 6 (D24, D25): ни один источник вида не сработал. Поступление - от покупателя, списание -
// поставщику, и операция помечается "Проверьте операцию" - человек должен ее увидеть. Вшитых ключевых слов
// нет: единственный источник правил по тексту - справочник соответствий (шаг 4).
Процедура ШагЗначениеПоУмолчанию(План)

	Для Каждого СтрокаПлана Из СтрокиДляРаспознавания(План) Цикл
		Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
			СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя;
		Иначе
			СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Поставщику;
		КонецЕсли;
		СтрокаПлана.ИсточникВидаОперации = ИсточникПоУмолчанию();
		СтрокаПлана.ПроверьтеОперацию = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ШагиКонтрагентСчетДоговор

// Виды операций, которым нужен контрагент (см. ВидОперацииТребуетКонтрагента: цитата вендорских мест).
Функция ВидыОперацийСКонтрагентом()

	Виды = Новый Массив;
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПоставщика);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтНашейОрганизации);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКартам);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКредитам);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.РасчетыПоКредитам);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.Поставщику);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.Покупателю);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.НашейОрганизации);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.КомиссияБанка);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.ВозвратОплатыНаПлатежныеКарты);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.ВозвратПродажиВКредит);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.РасчетыПоКредитам);

	Возврат Виды;

КонецФункции

// Виды операций, которым нужен договор (см. ВидОперацииТребуетДоговор: цитата вендорских мест).
Функция ВидыОперацийСДоговором()

	Виды = Новый Массив;
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПокупателя);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтПоставщика);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ОтНашейОрганизации);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКартам);
	Виды.Добавить(Перечисления.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКредитам);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.Поставщику);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.Покупателю);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.НашейОрганизации);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.ВозвратОплатыНаПлатежныеКарты);
	Виды.Добавить(Перечисления.ВидыОперацийРасходСоСчета.ВозвратПродажиВКредит);

	Возврат Виды;

КонецФункции

// Пробельный символ любого вида (в том числе нерозривный и узкий): по коду символа, а не по ПустаяСтрока, которая
// нерозривные пробелы может не считать пустыми.
Функция ЭтоПробельныйСимвол(Символ)

	Код = КодСимвола(Символ);

	Возврат (Код >= 9 И Код <= 13) Или Код = 32 Или Код = 160 Или (Код >= 8192 И Код <= 8203) Или Код = 8239
		Или Код = 8287 Или Код = 12288 Или Код = 65279;

КонецФункции

// Разделитель в коде контрагента: пробельный символ или знак, которым читатели разбивают код на группы.
Функция ЭтоРазделительКода(Символ)

	Возврат ЭтоПробельныйСимвол(Символ) Или Найти("-.,/\_'""", Символ) > 0 Или КодСимвола(Символ) = 8211 Или КодСимвола(Символ) = 8212;

КонецФункции

// Номер счета для сравнения: без пробельных символов, в верхнем регистре.
Функция НормализоватьНомерСчета(Номер) Экспорт

	Результат = "";
	Текст = ВРег(СокрЛП(Номер));
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Не ЭтоПробельныйСимвол(Символ) Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счета контрагентов с любым из номеров (текущим или устаревшим): не помеченные на удаление, не недействительные, владелец
// - контрагент (счета организаций - задача 5). Владелец приходит с признаком пометки: помеченный на удаление владелец не
// используется, но о нем предупреждают. Порядок - по коду справочника.
Функция ПрочитатьСчетаКонтрагентов(Номера)

	Результат = Новый Массив;
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший,
		|	Контрагенты.Ссылка КАК Владелец,
		|	Контрагенты.ПометкаУдаления КАК ВладелецПомечен,
		|	Контрагенты.Наименование КАК ВладелецНаименование,
		|	Контрагенты.КодПоЕДРПОУ КАК ВладелецКод,
		|	Контрагенты.ИНН КАК ВладелецИНН
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Счета.Владелец = Контрагенты.Ссылка
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Номер, Устаревший, Владелец, ВладелецПомечен, ВладелецНаименование, ВладелецКод, ВладелецИНН");
		ЗаполнитьЗначенияСвойств(Счет, Выборка);
		Счет.Номер = НормализоватьНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = НормализоватьНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ставит строке плана счет и его владельца. Совпадение по текущему номеру предпочитается совпадению по устаревшему (даже
// если счет с устаревшим номером раньше по коду справочника). Владелец, помеченный на удаление, не берется - запоминается
// для предупреждения (ДобавитьЗамечанияОПомеченных).
//
// Один номер у счетов РАЗНЫХ контрагентов (того же уровня совпадения: текущий или устаревший): выбор прежний - первый по коду
// справочника, - но неоднозначность не молчит: предупреждение на поле СчетКонтрагента перечисляет владельцев (как для кодов,
// договоров и сотрудников). Счета одного владельца неоднозначностью не считаются; владельцы, помеченные на удаление, - тоже.
Процедура НайтиСчетСтроки(План, Элемент, Счета)

	Элемент.Вставить("ВладелецКод", "");
	Элемент.Вставить("ВладелецИНН", "");
	Если ПустаяСтрока(Элемент.Номер) Тогда
		Возврат;
	КонецЕсли;

	Подходящие = Новый Массив;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер = Элемент.Номер Тогда
			Подходящие.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер <> Элемент.Номер И Счет.Устаревший = Элемент.Номер Тогда
			Подходящие.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;

	Выбранный = Неопределено;
	Для Каждого Счет Из Подходящие Цикл
		Если Счет.ВладелецПомечен Тогда
			Элемент.Помеченные.Добавить(Новый Структура("Ссылка, Название, Код", Счет.Владелец, Счет.ВладелецНаименование, Счет.ВладелецКод));
			Продолжить;
		КонецЕсли;
		Выбранный = Счет;
		Прервать;
	КонецЦикла;
	Если Выбранный = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаПлана = Элемент.Строка;
	СтрокаПлана.СчетКонтрагента = Выбранный.Ссылка;
	СтрокаПлана.Контрагент = Выбранный.Владелец;
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	Элемент.ВладелецКод = Выбранный.ВладелецКод;
	Элемент.ВладелецИНН = Выбранный.ВладелецИНН;

	// Неоднозначность: владельцы живых счетов того же уровня совпадения (текущий номер против устаревшего решается
	// предпочтением, а не предупреждением).
	ТекущийУровень = (Выбранный.Номер = Элемент.Номер);
	Владельцы = Новый Массив;
	Названия = Новый Массив;
	Для Каждого Счет Из Подходящие Цикл
		Если Счет.ВладелецПомечен Или (Счет.Номер = Элемент.Номер) <> ТекущийУровень
			Или Владельцы.Найти(Счет.Владелец) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Владельцы.Добавить(Счет.Владелец);
		Названия.Добавить(Счет.ВладелецНаименование + ?(ПустаяСтрока(Счет.ВладелецКод), "", " (" + СокрЛП(Счет.ВладелецКод) + ")"));
	КонецЦикла;
	Если Владельцы.Количество() > 1 Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "СчетКонтрагента", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет ""%1"" числится у нескольких контрагентов (%2): взят первый по коду справочника - %3.';
				|uk = 'Рахунок ""%1"" значиться у кількох контрагентів (%2): взято першого за кодом довідника - %3.'"),
				СтрокаПлана.КонтрагентНомерСчета, СтрСоединить(Названия, "; "), Выбранный.ВладелецНаименование));
	КонецЕсли;

КонецПроцедуры

// Контрагенты (в том числе помеченные на удаление), у которых КодПоЕДРПОУ или ИНН равен коду из списка; порядок - по коду справочника.
// Какое из полей считается совпадением, решает НайтиКонтрагентаСтроки: восьмизначный код (ЕДРПОУ) - только КодПоЕДРПОУ, десятизначный
// (РНОКПП) - и ИНН (так его пишет запись пакета, этап 4), и КодПоЕДРПОУ (так он лежит в старых данных).
Функция ПрочитатьКонтрагентовПоКодам(Коды)

	Если Коды.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.КодПоЕДРПОУ КАК Код,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.Наименование КАК Название,
		|	Контрагенты.ПометкаУдаления КАК Помечен
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.КодПоЕДРПОУ В (&Значения)
		|	ИЛИ Контрагенты.ИНН В (&Значения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Код");
	Запрос.УстановитьПараметр("Значения", Коды);

	Возврат ПрочитатьКонтрагентов(Запрос);

КонецФункции

// Контрагенты (в том числе помеченные на удаление) с одним из названий; порядок - по коду справочника.
Функция ПрочитатьКонтрагентовПоНазваниям(Названия)

	Если Названия.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.КодПоЕДРПОУ КАК Код,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.Наименование КАК Название,
		|	Контрагенты.ПометкаУдаления КАК Помечен
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование В (&Значения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Код");
	Запрос.УстановитьПараметр("Значения", Названия);

	Возврат ПрочитатьКонтрагентов(Запрос);

КонецФункции

Функция ПрочитатьКонтрагентов(Запрос)

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Контрагент = Новый Структура("Ссылка, Код, Название, Помечен, КодЦифры, ИННЦифры");
		ЗаполнитьЗначенияСвойств(Контрагент, Выборка);
		// Код в базе сравнивается в том же виде, что и код операции (цифры; 7/9 цифр - дополненные нулем).
		Контрагент.КодЦифры = НормализоватьКодКонтрагента(Выборка.Код).Нормализованный;
		Контрагент.ИННЦифры = НормализоватьКодКонтрагента(Выборка.ИНН).Нормализованный;
		Результат.Добавить(Контрагент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Контрагент строки по коду (ПоКоду) или по названию: первый не помеченный на удаление; несколько - предупреждение и первый
// по коду справочника. Помеченные на удаление не берутся, но по коду о них предупреждают (Элемент.Помеченные).
Процедура НайтиКонтрагентаСтроки(План, Элемент, Контрагенты, ПоКоду)

	СтрокаПлана = Элемент.Строка;
	Ключ = ?(ПоКоду, Элемент.Код.Нормализованный, ВРег(Элемент.Название));

	Подходящие = Новый Массив;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если ПоКоду Тогда
			// Десятизначный код (РНОКПП) ищется и в ИНН; восьмизначный (ЕДРПОУ) - только в КодПоЕДРПОУ.
			Совпало = КодСовпадаетСКонтрагентом(Ключ, Контрагент.КодЦифры, Контрагент.ИННЦифры);
		Иначе
			Совпало = (ВРег(СокрЛП(Контрагент.Название)) = Ключ);
		КонецЕсли;
		Если Не Совпало Тогда
			Продолжить;
		КонецЕсли;
		Если Не Контрагент.Помечен Тогда
			Подходящие.Добавить(Контрагент);
		ИначеЕсли ПоКоду Тогда
			Элемент.Помеченные.Добавить(Новый Структура("Ссылка, Название, Код", Контрагент.Ссылка, Контрагент.Название, Контрагент.Код));
		КонецЕсли;
	КонецЦикла;

	Если Подходящие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаПлана.Контрагент = Подходящие[0].Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	Если Подходящие.Количество() > 1 Тогда
		Поле = ?(ПоКоду, "КонтрагентКод", "КонтрагентНаименование");
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, Поле, СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Контрагентов с %1 ""%2"" в базе %3: взят первый по коду справочника - %4.';
				|uk = 'Контрагентів з %1 ""%2"" у базі %3: взято першого за кодом довідника - %4.'"),
				?(ПоКоду, НСтр("ru = 'кодом';uk = 'кодом'"), НСтр("ru = 'названием';uk = 'назвою'")),
				?(ПоКоду, Элемент.Код.Нормализованный, Элемент.Название), Формат(Подходящие.Количество(), "ЧГ="),
				Подходящие[0].Название));
	КонецЕсли;

КонецПроцедуры

// Код в выписке не совпал с кодом владельца найденного по счету контрагента: предупреждение, владелец остается (номер
// счета уникален). Пустой код владельца расхождением не считается.
Процедура ПроверитьКодВладельцаСчета(План, Элемент)

	СтрокаПлана = Элемент.Строка;
	Если Не ЗначениеЗаполнено(СтрокаПлана.СчетКонтрагента) Или Не Элемент.Код.Использовать
		Или (ПустаяСтрока(Элемент.ВладелецКод) И ПустаяСтрока(Элемент.ВладелецИНН)) Тогда
		Возврат;
	КонецЕсли;

	// Тем же правилом, что поиск контрагента по коду: десятизначный код - КодПоЕДРПОУ или ИНН владельца, восьмизначный - КодПоЕДРПОУ.
	Если КодСовпадаетСКонтрагентом(Элемент.Код.Нормализованный, НормализоватьКодКонтрагента(Элемент.ВладелецКод).Нормализованный,
		НормализоватьКодКонтрагента(Элемент.ВладелецИНН).Нормализованный) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентКод", СМП_ВыпискаБанка.УровеньПредупреждение(),
		СтрШаблон(НСтр("ru = 'Код контрагента в выписке ""%1"" не совпал с кодом владельца счета ""%2"": взят владелец счета.';
			|uk = 'Код контрагента у виписці ""%1"" не збігся з кодом власника рахунку ""%2"": взято власника рахунку.'"),
			Элемент.Код.Исходный, ?(ПустаяСтрока(Элемент.ВладелецКод), Элемент.ВладелецИНН, Элемент.ВладелецКод)));

КонецПроцедуры

// Совпадает ли код операции (Ключ - нормализованный код, 8 или 10 цифр) с кодами контрагента: десятизначный (РНОКПП) - с КодПоЕДРПОУ или
// ИНН (так код ФОП пишет запись пакета и так он лежит в старых данных); восьмизначный (ЕДРПОУ) - только с КодПоЕДРПОУ. Одно правило для
// поиска контрагента по коду и для проверки кода владельца найденного по счету контрагента.
//
// Параметры:
//  Ключ - Строка - нормализованный код операции.
//  КодПоЕДРПОУЦифры - Строка - нормализованный КодПоЕДРПОУ контрагента.
//  ИННЦифры - Строка - нормализованный ИНН контрагента.
//
// Возвращаемое значение:
//  Булево
Функция КодСовпадаетСКонтрагентом(Ключ, КодПоЕДРПОУЦифры, ИННЦифры) Экспорт

	Возврат (КодПоЕДРПОУЦифры = Ключ) Или (СтрДлина(Ключ) = 10 И ИННЦифры = Ключ);

КонецФункции

// Контрагент, помеченный на удаление, не берется, но и не молчим: предупреждение с названием и кодом (по одному на
// контрагента). Только если строке контрагента так и не нашли.
Процедура ДобавитьЗамечанияОПомеченных(План, Элемент)

	СтрокаПлана = Элемент.Строка;
	Если ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Учтенные = Новый Соответствие;
	Для Каждого Помеченный Из Элемент.Помеченные Цикл
		Если Учтенные.Получить(Помеченный.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Помеченный.Ссылка, Истина);
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Найден контрагент, помеченный на удаление: %1, код %2. Он не используется.';
				|uk = 'Знайдено контрагента, позначеного на видалення: %1, код %2. Його не використано.'"),
				Помеченный.Название, Помеченный.Код));
	КонецЦикла;

КонецПроцедуры

// Счета организаций и физлиц с любым из номеров (текущим или устаревшим): не помеченные на удаление (недействительный
// счет находится: выписка может ссылаться на закрытый свой счет, как БанковскийСчетОрганизацииПоНомеру). Для организации
// приходят название и КонтрагентИнтеркампани, для физлица - название. Порядок - по коду справочника.
Функция ПрочитатьСчетаОрганизацийИФизлиц(Номера)

	Результат = Новый Массив;
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший,
		|	Счета.Владелец КАК Владелец,
		|	ЕСТЬNULL(Организации.Наименование, ЕСТЬNULL(ФизЛица.Наименование, """")) КАК ВладелецНаименование,
		|	ЕСТЬNULL(Организации.КонтрагентИнтеркампани, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК КонтрагентИнтеркампани
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО Счета.Владелец = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
		|		ПО Счета.Владелец = ФизЛица.Ссылка
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И (Счета.Владелец ССЫЛКА Справочник.Организации
		|		ИЛИ Счета.Владелец ССЫЛКА Справочник.ФизическиеЛица)
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Номер, Устаревший, Владелец, ВладелецНаименование, КонтрагентИнтеркампани");
		ЗаполнитьЗначенияСвойств(Счет, Выборка);
		Счет.Номер = НормализоватьНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = НормализоватьНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счет с номером операции: совпадение по текущему номеру предпочитается совпадению по устаревшему; внутри - по коду.
Функция НайтиСвойСчетСтроки(Номер, Счета)

	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Устаревший = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сотрудники физлиц (не помеченные на удаление, не недействительные) с текущими кадровыми данными; порядок - по коду.
Функция ПрочитатьСотрудниковФизлиц(Физлица)

	Результат = Новый Массив;
	Если Физлица.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.Физлицо КАК Физлицо,
		|	ЕСТЬNULL(Кадровые.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
		|	ЕСТЬNULL(Организации.Наименование, """") КАК ОрганизацияНаименование,
		|	ЕСТЬNULL(Кадровые.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПриема,
		|	ЕСТЬNULL(Кадровые.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУвольнения
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК Кадровые
		|		ПО Кадровые.Сотрудник = Сотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО Кадровые.Организация = Организации.Ссылка
		|ГДЕ
		|	Сотрудники.Физлицо В (&Физлица)
		|	И НЕ Сотрудники.ПометкаУдаления
		|	И НЕ Сотрудники.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудники.Код");
	Запрос.УстановитьПараметр("Физлица", Физлица);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сотрудник = Новый Структура("Ссылка, Физлицо, Организация, ОрганизацияНаименование, ДатаПриема, ДатаУвольнения");
		ЗаполнитьЗначенияСвойств(Сотрудник, Выборка);
		Результат.Добавить(Сотрудник);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка сработавшего шага 1-2: найденный ранее контрагент, счет, действия и замечания о них сбрасываются.
Процедура СброситьКонтрагентаСтроки(План, СтрокаПлана)

	СтрокаПлана.Контрагент = Неопределено;
	СтрокаПлана.СчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка();
	СтрокаПлана.ДействиеКонтрагент = "";
	СтрокаПлана.ДействиеСчет = "";

	// Сбрасываются ТОЛЬКО замечания шага поиска контрагента и счета (ШагКонтрагентСчет): поля Контрагент, КонтрагентКод
	// (в том числе предупреждение о коде из 7 / 9 цифр), КонтрагентНаименование, СчетКонтрагента, Договор. От найденного там
	// контрагента строка отказалась, и замечания о нем были бы ложными. Замечания других шагов и других полей (например,
	// ЗагруженныйДокумент) не затрагиваются.
	Для Индекс = 1 По План.Замечания.Количество() Цикл
		Замечание = План.Замечания[План.Замечания.Количество() - Индекс];
		Если Замечание.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер
			И (Замечание.Поле = "Контрагент" Или Замечание.Поле = "КонтрагентКод" Или Замечание.Поле = "КонтрагентНаименование"
				Или Замечание.Поле = "СчетКонтрагента" Или Замечание.Поле = "Договор") Тогда
			План.Замечания.Удалить(Замечание);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьПереводМеждуСвоимиСчетами(План, СтрокаПлана, Счет, Контекст)

	Если Счет.Ссылка = Контекст.БанковскийСчет Тогда
		// Счет контрагента операции - сам счет выписки: переводом "на другой счет" это быть не может.
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента ""%1"" - это банковский счет самой выписки: перевод между своими счетами не определен.';
				|uk = 'Рахунок контрагента ""%1"" - це банківський рахунок самої виписки: переказ між своїми рахунками не визначено.'"),
				СтрокаПлана.КонтрагентНомерСчета));
		Возврат;
	КонецЕсли;

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ПереводСДругогоСчета;
	Иначе
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ПереводНаДругойСчет;
	КонецЕсли;
	СтрокаПлана.ИсточникВидаОперации = ИсточникСвойСчет();
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНеТребуется();
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();

КонецПроцедуры

// СчетаИнтеркампани - счета контрагентов интеркампани (ПрочитатьСчетаКонтрагентовИнтеркампани), Номер - нормализованный
// номер счета операции. Счет контрагента интеркампани с тем же номером (текущим предпочтительнее устаревшего) - это и
// есть СчетКонтрагента; нет такого - счет самой организации с предупреждением (решение консультанта).
Процедура ПрименитьДругуюОрганизацию(План, СтрокаПлана, Счет, Номер, СчетаИнтеркампани)

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтНашейОрганизации;
	Иначе
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.НашейОрганизации;
	КонецЕсли;
	СтрокаПлана.ИсточникВидаОперации = ИсточникНашаОрганизация();
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеСчет = ДействиеНайден();

	// Реквизит Контрагент банковских документов - только Контрагенты: другая организация представлена контрагентом
	// интеркампани. Платформа его не создает (настройка человека): не заполнен - документ этап 4 запишет непроведенным.
	Если ЗначениеЗаполнено(Счет.КонтрагентИнтеркампани) Тогда
		СтрокаПлана.Контрагент = Счет.КонтрагентИнтеркампани;
		СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
		СчетИнтеркампани = НайтиСчетКонтрагентаИнтеркампани(Номер, Счет.КонтрагентИнтеркампани, СчетаИнтеркампани);
		Если СчетИнтеркампани <> Неопределено Тогда
			СтрокаПлана.СчетКонтрагента = СчетИнтеркампани.Ссылка;
		Иначе
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
				СтрШаблон(НСтр("ru = 'Счет ""%1"" принадлежит организации ""%2"", а не ее контрагенту интеркампани: в документ подставлен счет организации.';
					|uk = 'Рахунок ""%1"" належить організації ""%2"", а не її контрагенту інтеркампані: у документ підставлено рахунок організації.'"),
					СтрокаПлана.КонтрагентНомерСчета, Счет.ВладелецНаименование));
		КонецЕсли;
	Иначе
		СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно();
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньОшибка(),
			СтрШаблон(НСтр("ru = 'У организации ""%1"" не заполнен контрагент интеркампани: документ по операции между организациями не может быть заполнен.';
				|uk = 'В організації ""%1"" не заповнено контрагента інтеркампані: документ за операцією між організаціями не може бути заповнений.'"),
				Счет.ВладелецНаименование));
	КонецЕсли;

КонецПроцедуры

// Компания - Константы.УчетПоКомпании.Компания(организация контекста): организация, на которую вендор пишет кадровые данные.
// Сотрудник "свой", если организация его кадровых данных - эта компания; иначе "работает в другой организации", и в
// предупреждении названа организация из регистра.
Процедура ПрименитьСотрудника(План, СтрокаПлана, Счет, СотрудникиФизлиц, Компания)

	Действующие = Новый Массив;
	Уволенные = Новый Массив;
	ВДругихОрганизациях = Новый Массив;
	Для Каждого Сотрудник Из СотрудникиФизлиц Цикл
		Если Сотрудник.Физлицо <> Счет.Владелец Или Не ЗначениеЗаполнено(Сотрудник.ДатаПриема) Тогда
			Продолжить;
		КонецЕсли;
		Если Сотрудник.Организация <> Компания Тогда
			Если Не ЗначениеЗаполнено(Сотрудник.ДатаУвольнения) И ЗначениеЗаполнено(Сотрудник.Организация) Тогда
				ВДругихОрганизациях.Добавить(Сотрудник);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Сотрудник.ДатаУвольнения) Тогда
			Уволенные.Добавить(Сотрудник);
		Иначе
			Действующие.Добавить(Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Если Действующие.Количество() = 0 Тогда
		Причина = НСтр("ru = 'не является сотрудником организации';uk = 'не є працівником організації'");
		Если Уволенные.Количество() > 0 Тогда
			Причина = СтрШаблон(НСтр("ru = 'уволен %1';uk = 'звільнений %1'"), Формат(Уволенные[0].ДатаУвольнения, "ДЛФ=D"));
		ИначеЕсли ВДругихОрганизациях.Количество() > 0 Тогда
			// Сотрудник другой нашей организации: выплата от этой организации зарплатой не считается; название нужно человеку.
			Причина = СтрШаблон(НСтр("ru = 'работает в другой организации (%1)';uk = 'працює в іншій організації (%1)'"),
				ВДругихОрганизациях[0].ОрганизацияНаименование);
		КонецЕсли;
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента принадлежит физлицу ""%1"", которое %2: выплатой зарплаты операция не считается.';
				|uk = 'Рахунок контрагента належить фізособі ""%1"", яка %2: виплатою зарплати операцію не вважають.'"),
				Счет.ВладелецНаименование, Причина));
		Возврат;
	КонецЕсли;

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ЗарплатаСотруднику;
	СтрокаПлана.ИсточникВидаОперации = ИсточникСотрудник();
	СтрокаПлана.Контрагент = Действующие[0].Ссылка;
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();

	Если Действующие.Количество() > 1 Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'У физлица ""%1"" действующих сотрудников в организации: %2, взят первый по коду справочника.';
				|uk = 'У фізособи ""%1"" чинних працівників в організації: %2, взято першого за кодом довідника.'"),
				Счет.ВладелецНаименование, Формат(Действующие.Количество(), "ЧГ=")));
	КонецЕсли;

КонецПроцедуры

// Счета контрагентов интеркампани (не помеченные на удаление, не недействительные) с любым из номеров (текущим или
// устаревшим). Один запрос на конверт; порядок - по коду справочника.
Функция ПрочитатьСчетаКонтрагентовИнтеркампани(Контрагенты, Номера)

	Результат = Новый Массив;
	Если Контрагенты.Количество() = 0 Или Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.Владелец КАК Владелец,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец В (&Контрагенты)
		|	И НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Владелец, Номер, Устаревший");
		Счет.Ссылка = Выборка.Ссылка;
		Счет.Владелец = Выборка.Владелец;
		Счет.Номер = НормализоватьНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = НормализоватьНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счет контрагента интеркампани с номером операции: по текущему номеру, иначе по устаревшему; Неопределено, если нет.
Функция НайтиСчетКонтрагентаИнтеркампани(Номер, Контрагент, Счета)

	Для Каждого Счет Из Счета Цикл
		Если Счет.Владелец = Контрагент И Счет.Номер = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Владелец = Контрагент И Счет.Устаревший = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Решения над контрагентом и счетом, которых не нашел поиск. Строка с контрагентом, определенным раньше (шаги задачи 5),
// не пересматривается.
Процедура РешитьКонтрагентаИСчет(План, СтрокаПлана)

	Нужен = ВидОперацииТребуетКонтрагента(СтрокаПлана.ВидОперации);
	ЕстьНомер = Не ПустаяСтрока(НормализоватьНомерСчета(СтрокаПлана.КонтрагентНомерСчета));

	Если ПустаяСтрока(СтрокаПлана.ДействиеКонтрагент) И Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		ЕстьДанные = Не ПустаяСтрока(СтрокаПлана.КонтрагентНаименование) Или ЕстьНомер
			Или НормализоватьКодКонтрагента(СтрокаПлана.КонтрагентКод).Использовать;
		Если Не Нужен Тогда
			СтрокаПлана.ДействиеКонтрагент = ДействиеНеТребуется();
		ИначеЕсли ЕстьДанные Тогда
			СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать();
		Иначе
			// Создать нечего: ни названия, ни пригодного кода, ни счета. Документ этап 4 запишет непроведенным.
			СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно();
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньОшибка(),
				ТекстЗамечанияКонтрагентНевозможен());
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(СтрокаПлана.ДействиеСчет)
		И (Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Или ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты")) Тогда
		Если ЕстьНомер И (СтрокаПлана.ДействиеКонтрагент = ДействиеНайден() Или СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать()) Тогда
			СтрокаПлана.ДействиеСчет = ДействиеСоздать();
		Иначе
			СтрокаПлана.ДействиеСчет = ДействиеНеТребуется();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ТекстЗамечанияКонтрагентНевозможен()

	Возврат НСтр("ru = 'Контрагента определить и создать нельзя: в операции нет ни названия, ни пригодного кода, ни номера счета.';
		|uk = 'Контрагента визначити і створити неможливо: в операції немає ні назви, ні придатного коду, ні номера рахунку.'");

КонецФункции

// Контрагент банка для комиссии (D35.8). Вид "Комиссия банка", строка контрагента не дала (действие "Невозможно"),
// КонтрагентБанка в контексте заполнен: контрагент - он, действие "Найден", замечание "Невозможно" с поля контрагента снимается
// (то самое, что поставил РешитьКонтрагентаИСчет, - по тексту). Строка, давшая своего контрагента (найден или будет создан), не
// пересматривается. Поле контекста необязательно: контекст старого вида (без поля) работает как с пустым.
Процедура ПрименитьКонтрагентаБанка(План, Строки, Контекст)

	КонтрагентБанка = Неопределено;
	Если Не Контекст.Свойство("КонтрагентБанка", КонтрагентБанка) Или Не ЗначениеЗаполнено(КонтрагентБанка) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПлана Из Строки Цикл
		Если СтрокаПлана.ВидОперации <> Перечисления.ВидыОперацийРасходСоСчета.КомиссияБанка
			Или СтрокаПлана.ДействиеКонтрагент <> ДействиеНевозможно() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПлана.Контрагент = КонтрагентБанка;
		СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();

		Текст = ТекстЗамечанияКонтрагентНевозможен();
		Для Индекс = 1 По План.Замечания.Количество() Цикл
			Замечание = План.Замечания[План.Замечания.Количество() - Индекс];
			Если Замечание.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер И Замечание.Поле = "Контрагент"
				И Замечание.Текст = Текст Тогда
				План.Замечания.Удалить(Замечание);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Статья ДДС, цепочка D14. Стаття, яку дали кроки 3-4 (платежное поручение, правило), не перевычисляется. Иначе, от
// детального к общему: статья договора (если контрагент ведет расчеты по договорам и договор строки известен) -> статья
// контрагента (D13) -> предопределенная статья по виду операции (СтатьяДДСПоВидуОперации). Вендорской функции-цепочки нет;
// порядок уровней - наш. Контрагент-сотрудник и контрагент, которого еще нет в базе, уровней договора и контрагента не имеют.
// Запросов: контрагенты и договоры - по одному на конверт.
Процедура ЗаполнитьСтатьиДДС(Строки)

	Нужные = Новый Массив;
	Контрагенты = Новый Массив;
	Договоры = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.СтатьяДДС) Тогда
			Продолжить;
		КонецЕсли;
		Нужные.Добавить(СтрокаПлана);
		Если ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(СтрокаПлана.Контрагент)
			И Контрагенты.Найти(СтрокаПлана.Контрагент) = Неопределено Тогда
			Контрагенты.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПлана.Договор) И Договоры.Найти(СтрокаПлана.Договор) = Неопределено Тогда
			Договоры.Добавить(СтрокаПлана.Договор);
		КонецЕсли;
	КонецЦикла;
	Если Нужные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Контрагент -> структура(ВестиРасчетыПоДоговорам, Статья); договор -> статья.
	ДанныеКонтрагентов = Новый Соответствие;
	Если Контрагенты.Количество() > 0 Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка,
			|	Контрагенты.ВестиРасчетыПоДоговорам КАК ВестиРасчетыПоДоговорам,
			|	Контрагенты.СтатьяДДСПоУмолчанию КАК Статья
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка В (&Контрагенты)");
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДанныеКонтрагентов.Вставить(Выборка.Ссылка, Новый Структура("ВестиРасчетыПоДоговорам, Статья",
				Выборка.ВестиРасчетыПоДоговорам, Выборка.Статья));
		КонецЦикла;
	КонецЕсли;
	СтатьиДоговоров = Новый Соответствие;
	Если Договоры.Количество() > 0 Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Договоры.Ссылка КАК Ссылка,
			|	Договоры.СтатьяДДСПоУмолчанию КАК Статья
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договоры
			|ГДЕ
			|	Договоры.Ссылка В (&Договоры)");
		Запрос.УстановитьПараметр("Договоры", Договоры);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтатьиДоговоров.Вставить(Выборка.Ссылка, Выборка.Статья);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаПлана Из Нужные Цикл
		Данные = ДанныеКонтрагентов.Получить(СтрокаПлана.Контрагент);
		СтатьяДоговора = ?(ЗначениеЗаполнено(СтрокаПлана.Договор), СтатьиДоговоров.Получить(СтрокаПлана.Договор), Неопределено);
		Если Данные <> Неопределено И Данные.ВестиРасчетыПоДоговорам = Истина И ЗначениеЗаполнено(СтатьяДоговора) Тогда
			СтрокаПлана.СтатьяДДС = СтатьяДоговора;
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиДоговор();
		ИначеЕсли Данные <> Неопределено И ЗначениеЗаполнено(Данные.Статья) Тогда
			СтрокаПлана.СтатьяДДС = Данные.Статья;
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиКонтрагент();
		Иначе
			СтрокаПлана.СтатьяДДС = СтатьяДДСПоВидуОперации(СтрокаПлана.ВидОперации);
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиПоВидуОперации();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Предопределенная статья по виду операции - последний уровень цепочки D14. Из вендорской формы
// ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС (cf/src) взята ТОЛЬКО эта отвечающая таблица "вид -> статья"
// для банковских видов (ВидыОперацийПоступлениеНаСчет, ВидыОперацийРасходСоСчета); вызов функции формы и ее порядок уровней
// (контрагент -> вид, без договора) не используются. Кассовые виды и виды платежного поручения не переносятся. Вид вне таблицы -
// "Прочее", как ветка "Иначе" вендора. Возвраты (ОтПоставщика, Покупателю) в таблице: в вендоре они в тех же ветках.
Функция СтатьяДДСПоВидуОперации(ВидОперации)

	Статьи = Справочники.СтатьиДвиженияДенежныхСредств;
	Поступления = Перечисления.ВидыОперацийПоступлениеНаСчет;
	Списания = Перечисления.ВидыОперацийРасходСоСчета;

	Таблица = Новый Соответствие;
	Таблица.Вставить(Поступления.ОтПокупателя, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтКурьерскойКомпанииПочты, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтНашейОрганизации, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Списания.Покупателю, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтПоставщика, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Списания.Поставщику, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Списания.НашейОрганизации, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Поступления.ЛичныеСредстваПредпринимателя, Статьи.ЛичныеСредстваПредпринимателя);
	Таблица.Вставить(Списания.ЛичныеСредстваПредпринимателя, Статьи.ЛичныеСредстваПредпринимателя);

	Результат = Таблица.Получить(ВидОперации);
	Возврат ?(Результат = Неопределено, Статьи.Прочее, Результат);

КонецФункции

// Корреспонденция (решение консультанта к задаче 9): вид "Личные средства предпринимателя" и пустая корреспонденция (ее не дали
// ни платежное поручение, ни правило) -> НераспределеннаяПрибыль, для любого источника вида. Источники у вендора:
// РасходСоСчета.ЗаполнитьПоПлатежноеПоручение (ObjectModule, запрос: ВЫБОР ... ЛичныеСредстваПредпринимателя ТОГДА
// НераспределеннаяПрибыль) и процедура ФормыДокументовДеньги.ЗаполнитьКорреспонденцию (через
// ВидОперацииЛичныеСредстваПредпринимателя), формы документов ПоступлениеНаСчет и РасходСоСчета. Вендор в запросе поручения берет
// НераспределеннаяПрибыль и при заполненной корреспонденции поручения; здесь заполненное берется как есть (D15).
Процедура ЗаполнитьКорреспонденцию(Строки)

	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Корреспонденция) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ЛичныеСредстваПредпринимателя
			Или СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ЛичныеСредстваПредпринимателя Тогда
			СтрокаПлана.Корреспонденция = ПланыСчетов.Управленческий.НераспределеннаяПрибыль;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// "Без ПДВ" в назначении (D35.6). Набор фраз фиксирован, на обоих языках, без учета регистра и НЕ через НСтр: НСтр отдал бы
// одну фразу по языку сеанса, а признак не должен зависеть от него. Набор - из прежнего механизма (СМП_КлиентБанк, поиск вида
// налогообложения в назначении платежа). Модуль только ставит признак; применяет его запись (этап 4).
Функция ФразыБезНДС()

	Фразы = Новый Массив;
	Фразы.Добавить("НДС не облагается");
	Фразы.Добавить("Без НДС");
	Фразы.Добавить("Без налога (НДС)");
	Фразы.Добавить("НДС не предусмотрен");
	Фразы.Добавить("ПДВ не обкладається");
	Фразы.Добавить("Без ПДВ");
	Фразы.Добавить("Без податку (ПДВ)");
	Фразы.Добавить("ПДВ не передбачений");

	Возврат Фразы;

КонецФункции

Процедура ЗаполнитьБезНДС(Строки)

	Фразы = ФразыБезНДС();
	Для Индекс = 0 По Фразы.ВГраница() Цикл
		Фразы[Индекс] = ВРег(Фразы[Индекс]);
	КонецЦикла;

	Для Каждого СтрокаПлана Из Строки Цикл
		Назначение = ВРег(СтрокаПлана.НазначениеПлатежа);
		// Явный сброс нужен для повторного вызова на том же плане (ШагЗавершение экспортный): признак, выставленный прежним
		// вызовом по прежнему тексту, не должен пережить смену назначения. На новом плане колонка и так пуста (Ложь).
		СтрокаПлана.БезНДС = Ложь;
		Для Каждого Фраза Из Фразы Цикл
			Если СтрНайти(Назначение, Фраза) > 0 Тогда
				СтрокаПлана.БезНДС = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Договор для каждой строки, у которой его еще нет и вид операции его требует. Контрагент создается - договор создается;
// контрагента создать нельзя - договор тоже. Найденному контрагенту:
//  - расчеты по договорам не ведутся -> договор по умолчанию контрагента (вендорская Справочники.ДоговорыКонтрагентов.
//    ДоговорПоУмолчанию - ее же зовет ПередЗаписью вендорских ПоступлениеНаСчет / РасходСоСчета; организация не фильтрует);
//  - иначе договоры контрагента организации распознавания (не помечены на удаление, не недействительны) ВИДА, подходящего
//    виду операции: основной; иначе единственный; несколько без основного - предупреждение и первый по коду; нужного вида
//    нет, а другой есть - "Создать" и предупреждение с перечнем договоров другого вида.
// Запросов: признаки контрагентов и договоры - по одному на конверт.
Процедура ВыбратьДоговоры(План, Строки, Контекст)

	Искать = Новый Массив;
	Контрагенты = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Договор) Или Не ПустаяСтрока(СтрокаПлана.ДействиеДоговор) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ВидОперацииТребуетДоговор(СтрокаПлана.ВидОперации) Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать() Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно() Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеНевозможно();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеНайден()
			И ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Искать.Добавить(СтрокаПлана);
			Если Повторы.Получить(СтрокаПлана.Контрагент) = Неопределено Тогда
				Повторы.Вставить(СтрокаПлана.Контрагент, Истина);
				Контрагенты.Добавить(СтрокаПлана.Контрагент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Искать.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УчетПоДоговорам = ПрочитатьУчетПоДоговорам(Контрагенты);
	КонтрагентыСУчетом = Новый Массив;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если УчетПоДоговорам.Получить(Контрагент) = Истина Тогда
			КонтрагентыСУчетом.Добавить(Контрагент);
		КонецЕсли;
	КонецЦикла;
	Договоры = ПрочитатьДоговорыКонтрагентов(КонтрагентыСУчетом, Контекст.Организация);

	Для Каждого СтрокаПлана Из Искать Цикл
		Если УчетПоДоговорам.Получить(СтрокаПлана.Контрагент) = Истина Тогда
			ВыбратьДоговорСтроки(План, СтрокаПлана, Договоры);
		Иначе
			Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(СтрокаПлана.Контрагент);
			Если ЗначениеЗаполнено(Договор) Тогда
				СтрокаПлана.Договор = Договор;
				СтрокаПлана.ДействиеДоговор = ДействиеНайден();
			Иначе
				СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Соответствие "контрагент -> ведутся ли расчеты по договорам".
Функция ПрочитатьУчетПоДоговорам(Контрагенты)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.ВестиРасчетыПоДоговорам КАК ВестиРасчетыПоДоговорам
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Контрагенты)");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ВестиРасчетыПоДоговорам);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Договоры контрагентов организации: не помечены на удаление, не недействительны; с признаком "основной" (запись регистра
// основных договоров). Порядок - по коду справочника.
Функция ПрочитатьДоговорыКонтрагентов(Контрагенты, Организация)

	Результат = Новый Массив;
	Если Контрагенты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка,
		|	Договоры.Владелец КАК Контрагент,
		|	Договоры.ВидДоговора КАК ВидДоговора,
		|	Договоры.Наименование КАК Название,
		|	ВЫБОР
		|		КОГДА Основные.Договор ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Основной
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Основные
		|		ПО Основные.Договор = Договоры.Ссылка
		|ГДЕ
		|	Договоры.Владелец В (&Контрагенты)
		|	И Договоры.Организация = &Организация
		|	И НЕ Договоры.ПометкаУдаления
		|	И НЕ Договоры.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Договоры.Код");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Договор = Новый Структура("Ссылка, Контрагент, ВидДоговора, Название, Основной");
		ЗаполнитьЗначенияСвойств(Договор, Выборка);
		Результат.Добавить(Договор);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВыбратьДоговорСтроки(План, СтрокаПлана, Договоры)

	Виды = ВидыДоговораДляВидаОперации(СтрокаПлана.ВидОперации);
	Подходящие = Новый Массив;
	ДругогоВида = Новый Массив;
	Для Каждого Договор Из Договоры Цикл
		Если Договор.Контрагент <> СтрокаПлана.Контрагент Тогда
			Продолжить;
		КонецЕсли;
		Если Виды.Количество() = 0 Или Виды.Найти(Договор.ВидДоговора) <> Неопределено Тогда
			Подходящие.Добавить(Договор);
		Иначе
			ДругогоВида.Добавить(Договор);
		КонецЕсли;
	КонецЦикла;

	Основные = Новый Массив;
	Для Каждого Договор Из Подходящие Цикл
		Если Договор.Основной Тогда
			Основные.Добавить(Договор);
		КонецЕсли;
	КонецЦикла;

	Если Основные.Количество() > 0 Тогда
		Выбранный = Основные[0];
		Если Основные.Количество() > 1 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Основные, НСтр("ru = 'несколько основных договоров';uk = 'кілька основних договорів'"));
		КонецЕсли;
	ИначеЕсли Подходящие.Количество() > 0 Тогда
		Выбранный = Подходящие[0];
		Если Подходящие.Количество() > 1 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Подходящие, НСтр("ru = 'несколько договоров без основного';uk = 'кілька договорів без основного'"));
		КонецЕсли;
	Иначе
		СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
		Если ДругогоВида.Количество() > 0 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, ДругогоВида,
				НСтр("ru = 'нужного вида договора нет, есть договоры другого вида (будет создан новый)';uk = 'потрібного виду договору немає, є договори іншого виду (буде створено новий)'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	СтрокаПлана.Договор = Выбранный.Ссылка;
	СтрокаПлана.ДействиеДоговор = ДействиеНайден();

КонецПроцедуры

Процедура ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Договоры, Причина)

	Названия = Новый Массив;
	Для Каждого Договор Из Договоры Цикл
		Названия.Добавить(Договор.Название);
	КонецЦикла;

	ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Договор", СМП_ВыпискаБанка.УровеньПредупреждение(),
		СтрШаблон(НСтр("ru = 'Договор контрагента: %1. Договоры: %2.';uk = 'Договір контрагента: %1. Договори: %2.'"),
		Причина, СтрСоединить(Названия, "; ")));

КонецПроцедуры

#КонецОбласти

#КонецОбласти
