// Разделитель в коде контрагента: пробельный символ или знак, которым читатели разбивают код на группы.
Функция ЭтоРазделительКода(Символ)

	Возврат СМП_ВыпискаБанка.ЭтоПробельныйСимвол(Символ) Или Найти("-.,/\_'""", Символ) > 0 Или КодСимвола(Символ) = 8211 Или КодСимвола(Символ) = 8212;

КонецФункции

// Счета контрагентов с любым из номеров (текущим или устаревшим): не помеченные на удаление, не недействительные, владелец
// - контрагент (счета организаций - задача 5). Владелец приходит с признаком пометки: помеченный на удаление владелец не
// используется, но о нем предупреждают. Порядок - по коду справочника. БанкКод и ВладелецНаименованиеПолное - для порядка кандидатов
// (КлючПорядкаСчета).
Функция ПрочитатьСчетаКонтрагентов(Номера)

	Результат = Новый Массив;
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший,
		|	Контрагенты.Ссылка КАК Владелец,
		|	Контрагенты.ПометкаУдаления КАК ВладелецПомечен,
		|	Контрагенты.Наименование КАК ВладелецНаименование,
		|	Контрагенты.КодПоЕДРПОУ КАК ВладелецКод,
		|	Контрагенты.ИНН КАК ВладелецИНН,
		|	ВЫРАЗИТЬ(Контрагенты.НаименованиеПолное КАК СТРОКА(1024)) КАК ВладелецНаименованиеПолное,
		|	Счета.Банк.Код КАК БанкКод
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО Счета.Владелец = Контрагенты.Ссылка
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Номер, Устаревший, Владелец, ВладелецПомечен, ВладелецНаименование, ВладелецКод, ВладелецИНН, ВладелецНаименованиеПолное, БанкКод");
		ЗаполнитьЗначенияСвойств(Счет, Выборка);
		Счет.Номер = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ставит строке плана счет и его владельца. Совпадение по текущему номеру предпочитается совпадению по устаревшему (даже
// если счет с устаревшим номером раньше по коду справочника). Владелец, помеченный на удаление, не берется - запоминается
// для предупреждения (ДобавитьЗамечанияОПомеченных).
//
// Один номер у счетов РАЗНЫХ контрагентов (того же уровня совпадения: текущий или устаревший): выбор прежний - первый по коду
// справочника, - но неоднозначность не молчит: предупреждение на поле СчетКонтрагента перечисляет владельцев (как для кодов,
// договоров и сотрудников). Счета одного владельца неоднозначностью не считаются; владельцы, помеченные на удаление, - тоже.
//
// Задача 8 (спека §1): внутри одного уровня совпадения кандидаты упорядочены, как у нынешнего поиска счета (УПОРЯДОЧИТЬ ПО ПриоритетИНН,
// ПриоритетБИК, ПриоритетНаименования в СМП_РаботаСБанкамиПриватБанкAPIСервер, запрос ~884-925, и СМП_РаботаСБанкамиNovaPayAPIСервер,
// ~1105-1145): код контрагента (ЕДРПОУ), затем МФО банка счета, затем название; не различило - первый по коду справочника. МФО НЕ
// фильтрует: кандидат с другим МФО остается кандидатом. Предупреждение остается, только когда порядок не различил (у другого владельца
// того же уровня ключ равен ключу выбранного). ПриоритетИНН старого кода сверял лишь ИНН - здесь код сверяется правилом поиска контрагента
// (КодСовпадаетСКонтрагентом, решение задачи 4: ФОП лежит в ИНН); ПриоритетКПП старого кода для Украины не применим. Коды банков не
// уникальны (305299 - два ПриватБанка), сравнение по коду их не различает - это порядок, а не фильтр.
Процедура НайтиСчетСтроки(План, Элемент, Счета)

	Элемент.Вставить("ВладелецКод", "");
	Элемент.Вставить("ВладелецИНН", "");
	Если ПустаяСтрока(Элемент.Номер) Тогда
		Возврат;
	КонецЕсли;

	Подходящие = Новый Массив;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер = Элемент.Номер Тогда
			Подходящие.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер <> Элемент.Номер И Счет.Устаревший = Элемент.Номер Тогда
			Подходящие.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;

	ПервыйЖивой = Неопределено;
	Для Каждого Счет Из Подходящие Цикл
		Если Счет.ВладелецПомечен Тогда
			Элемент.Помеченные.Добавить(Новый Структура("Ссылка, Название, Код", Счет.Владелец, Счет.ВладелецНаименование, Счет.ВладелецКод));
			Продолжить;
		КонецЕсли;
		ПервыйЖивой = Счет;
		Прервать;
	КонецЦикла;
	Если ПервыйЖивой = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Уровень совпадения (текущий номер сильнее устаревшего) решает до порядка кандидатов; внутри уровня - ключ порядка, при равных ключах
	// остается первый по коду справочника (Подходящие уже в этом порядке).
	ТекущийУровень = (ПервыйЖивой.Номер = Элемент.Номер);
	Выбранный = Неопределено;
	ЛучшийКлюч = 0;
	Для Каждого Счет Из Подходящие Цикл
		Если Счет.ВладелецПомечен Или (Счет.Номер = Элемент.Номер) <> ТекущийУровень Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючПорядкаСчета(Элемент, Счет);
		Если Выбранный = Неопределено Или Ключ < ЛучшийКлюч Тогда
			Выбранный = Счет;
			ЛучшийКлюч = Ключ;
		КонецЕсли;
	КонецЦикла;

	СтрокаПлана = Элемент.Строка;
	СтрокаПлана.СчетКонтрагента = Выбранный.Ссылка;
	СтрокаПлана.Контрагент = Выбранный.Владелец;
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	Элемент.ВладелецКод = Выбранный.ВладелецКод;
	Элемент.ВладелецИНН = Выбранный.ВладелецИНН;

	// Неоднозначность: владельцы живых счетов того же уровня совпадения (текущий номер против устаревшего решается
	// предпочтением, а не предупреждением). Предупреждение - только если порядок не различил: у другого владельца ключ равен ключу
	// выбранного.
	Владельцы = Новый Массив;
	Названия = Новый Массив;
	НеРазличил = Ложь;
	Для Каждого Счет Из Подходящие Цикл
		Если Счет.ВладелецПомечен Или (Счет.Номер = Элемент.Номер) <> ТекущийУровень Тогда
			Продолжить;
		КонецЕсли;
		Если Счет.Владелец <> Выбранный.Владелец И КлючПорядкаСчета(Элемент, Счет) = ЛучшийКлюч Тогда
			НеРазличил = Истина;
		КонецЕсли;
		Если Владельцы.Найти(Счет.Владелец) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Владельцы.Добавить(Счет.Владелец);
		Названия.Добавить(Счет.ВладелецНаименование + ?(ПустаяСтрока(Счет.ВладелецКод), "", " (" + СокрЛП(Счет.ВладелецКод) + ")"));
	КонецЦикла;
	Если Владельцы.Количество() > 1 И НеРазличил Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "СчетКонтрагента", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет ""%1"" числится у нескольких контрагентов (%2): код, МФО банка и название не позволили выбрать, взят первый по коду справочника - %3.';
				|uk = 'Рахунок ""%1"" значиться у кількох контрагентів (%2): код, МФО банку і назва не дозволили вибрати, взято першого за кодом довідника - %3.'"),
				СтрокаПлана.КонтрагентНомерСчета, СтрСоединить(Названия, "; "), Выбранный.ВладелецНаименование));
	КонецЕсли;

КонецПроцедуры

// Ключ порядка кандидата на счет (меньше - лучше): код контрагента (ЕДРПОУ) весит больше МФО банка счета, МФО - больше названия. Совпадение
// каждого признака - 0, несовпадение (в том числе пустой признак операции) - вес разряда: 4, 2, 1. Сравнение - как у нынешнего поиска счета:
// код - правилом поиска контрагента (КодСовпадаетСКонтрагентом); МФО - СокрЛП(Банк.Код) = СокрЛП(КонтрагентМФО); название - без учета
// регистра и пробелов по краям, с Ё = Е, с наименованием и полным наименованием владельца.
Функция КлючПорядкаСчета(Элемент, Счет)

	Ключ = 0;

	Если Не Элемент.Код.Использовать
		Или Не КодСовпадаетСКонтрагентом(Элемент.Код.Нормализованный, НормализоватьКодКонтрагента(Счет.ВладелецКод).Нормализованный,
			НормализоватьКодКонтрагента(Счет.ВладелецИНН).Нормализованный) Тогда
		Ключ = Ключ + 4;
	КонецЕсли;

	МФО = ?(ТипЗнч(Элемент.Строка.КонтрагентМФО) = Тип("Строка"), СокрЛП(Элемент.Строка.КонтрагентМФО), "");
	Если ПустаяСтрока(МФО) Или СокрЛП(Счет.БанкКод) <> МФО Тогда
		Ключ = Ключ + 2;
	КонецЕсли;

	Название = НазваниеДляСравнения(Элемент.Название);
	Если ПустаяСтрока(Название) Или (НазваниеДляСравнения(Счет.ВладелецНаименование) <> Название
		И НазваниеДляСравнения(Счет.ВладелецНаименованиеПолное) <> Название) Тогда
		Ключ = Ключ + 1;
	КонецЕсли;

	Возврат Ключ;

КонецФункции

// Название для сравнения кандидатов на счет: без пробелов по краям, верхний регистр, Ё как Е (нынешний поиск подменял "ё" на "е" в названии
// операции; названия контрагентов вендорской базы бывают русскими, и подмена здесь симметрична).
Функция НазваниеДляСравнения(Название)

	Возврат СтрЗаменить(ВРег(СокрЛП(Название)), "Ё", "Е");

КонецФункции

// Контрагенты (в том числе помеченные на удаление), у которых КодПоЕДРПОУ или ИНН равен коду из списка; порядок - по коду справочника.
// Какое из полей считается совпадением, решает НайтиКонтрагентаСтроки: восьмизначный код (ЕДРПОУ) - только КодПоЕДРПОУ, десятизначный
// (РНОКПП) - и ИНН (так его пишет запись пакета, этап 4), и КодПоЕДРПОУ (так он лежит в старых данных).
Функция ПрочитатьКонтрагентовПоКодам(Коды)

	Если Коды.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.КодПоЕДРПОУ КАК Код,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.Наименование КАК Название,
		|	Контрагенты.ПометкаУдаления КАК Помечен
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.КодПоЕДРПОУ В (&Значения)
		|	ИЛИ Контрагенты.ИНН В (&Значения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Код");
	Запрос.УстановитьПараметр("Значения", Коды);

	Возврат ПрочитатьКонтрагентов(Запрос);

КонецФункции

// Контрагенты (в том числе помеченные на удаление) с одним из названий; порядок - по коду справочника.
Функция ПрочитатьКонтрагентовПоНазваниям(Названия)

	Если Названия.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.КодПоЕДРПОУ КАК Код,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.Наименование КАК Название,
		|	Контрагенты.ПометкаУдаления КАК Помечен
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование В (&Значения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Код");
	Запрос.УстановитьПараметр("Значения", Названия);

	Возврат ПрочитатьКонтрагентов(Запрос);

КонецФункции

Функция ПрочитатьКонтрагентов(Запрос)

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Контрагент = Новый Структура("Ссылка, Код, Название, Помечен, КодЦифры, ИННЦифры");
		ЗаполнитьЗначенияСвойств(Контрагент, Выборка);
		// Код в базе сравнивается в том же виде, что и код операции (цифры; 7/9 цифр - дополненные нулем).
		Контрагент.КодЦифры = НормализоватьКодКонтрагента(Выборка.Код).Нормализованный;
		Контрагент.ИННЦифры = НормализоватьКодКонтрагента(Выборка.ИНН).Нормализованный;
		Результат.Добавить(Контрагент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Контрагент строки по коду (ПоКоду) или по названию: первый не помеченный на удаление; несколько - предупреждение и первый
// по коду справочника. Помеченные на удаление не берутся, но по коду о них предупреждают (Элемент.Помеченные).
Процедура НайтиКонтрагентаСтроки(План, Элемент, Контрагенты, ПоКоду)

	СтрокаПлана = Элемент.Строка;
	Ключ = ?(ПоКоду, Элемент.Код.Нормализованный, ВРег(Элемент.Название));

	Подходящие = Новый Массив;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если ПоКоду Тогда
			// Десятизначный код (РНОКПП) ищется и в ИНН; восьмизначный (ЕДРПОУ) - только в КодПоЕДРПОУ.
			Совпало = КодСовпадаетСКонтрагентом(Ключ, Контрагент.КодЦифры, Контрагент.ИННЦифры);
		Иначе
			Совпало = (ВРег(СокрЛП(Контрагент.Название)) = Ключ);
		КонецЕсли;
		Если Не Совпало Тогда
			Продолжить;
		КонецЕсли;
		Если Не Контрагент.Помечен Тогда
			Подходящие.Добавить(Контрагент);
		ИначеЕсли ПоКоду Тогда
			Элемент.Помеченные.Добавить(Новый Структура("Ссылка, Название, Код", Контрагент.Ссылка, Контрагент.Название, Контрагент.Код));
		КонецЕсли;
	КонецЦикла;

	Если Подходящие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаПлана.Контрагент = Подходящие[0].Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	Если Подходящие.Количество() > 1 Тогда
		Поле = ?(ПоКоду, "КонтрагентКод", "КонтрагентНаименование");
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, Поле, СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Контрагентов с %1 ""%2"" в базе %3: взят первый по коду справочника - %4.';
				|uk = 'Контрагентів з %1 ""%2"" у базі %3: взято першого за кодом довідника - %4.'"),
				?(ПоКоду, НСтр("ru = 'кодом';uk = 'кодом'"), НСтр("ru = 'названием';uk = 'назвою'")),
				?(ПоКоду, Элемент.Код.Нормализованный, Элемент.Название), Формат(Подходящие.Количество(), "ЧГ="),
				Подходящие[0].Название));
	КонецЕсли;

КонецПроцедуры

// Код в выписке не совпал с кодом владельца найденного по счету контрагента: предупреждение, владелец остается (номер
// счета уникален). Пустой код владельца расхождением не считается.
Процедура ПроверитьКодВладельцаСчета(План, Элемент)

	СтрокаПлана = Элемент.Строка;
	Если Не ЗначениеЗаполнено(СтрокаПлана.СчетКонтрагента) Или Не Элемент.Код.Использовать
		Или (ПустаяСтрока(Элемент.ВладелецКод) И ПустаяСтрока(Элемент.ВладелецИНН)) Тогда
		Возврат;
	КонецЕсли;

	// Тем же правилом, что поиск контрагента по коду: десятизначный код - КодПоЕДРПОУ или ИНН владельца, восьмизначный - КодПоЕДРПОУ.
	Если КодСовпадаетСКонтрагентом(Элемент.Код.Нормализованный, НормализоватьКодКонтрагента(Элемент.ВладелецКод).Нормализованный,
		НормализоватьКодКонтрагента(Элемент.ВладелецИНН).Нормализованный) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентКод", СМП_ВыпискаБанка.УровеньПредупреждение(),
		СтрШаблон(НСтр("ru = 'Код контрагента в выписке ""%1"" не совпал с кодом владельца счета ""%2"": взят владелец счета.';
			|uk = 'Код контрагента у виписці ""%1"" не збігся з кодом власника рахунку ""%2"": взято власника рахунку.'"),
			Элемент.Код.Исходный, ?(ПустаяСтрока(Элемент.ВладелецКод), Элемент.ВладелецИНН, Элемент.ВладелецКод)));

КонецПроцедуры

// Совпадает ли код операции (Ключ - нормализованный код, 8 или 10 цифр) с кодами контрагента: десятизначный (РНОКПП) - с КодПоЕДРПОУ или
// ИНН (так код ФОП пишет запись пакета и так он лежит в старых данных); восьмизначный (ЕДРПОУ) - только с КодПоЕДРПОУ. Одно правило для
// поиска контрагента по коду и для проверки кода владельца найденного по счету контрагента.
//
// Параметры:
//  Ключ - Строка - нормализованный код операции.
//  КодПоЕДРПОУЦифры - Строка - нормализованный КодПоЕДРПОУ контрагента.
//  ИННЦифры - Строка - нормализованный ИНН контрагента.
//
// Возвращаемое значение:
//  Булево
Функция КодСовпадаетСКонтрагентом(Ключ, КодПоЕДРПОУЦифры, ИННЦифры) Экспорт

	Возврат (КодПоЕДРПОУЦифры = Ключ) Или (СтрДлина(Ключ) = 10 И ИННЦифры = Ключ);

КонецФункции

// Контрагент, помеченный на удаление, не берется, но и не молчим: предупреждение с названием и кодом (по одному на
// контрагента). Только если строке контрагента так и не нашли.
Процедура ДобавитьЗамечанияОПомеченных(План, Элемент)

	СтрокаПлана = Элемент.Строка;
	Если ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Учтенные = Новый Соответствие;
	Для Каждого Помеченный Из Элемент.Помеченные Цикл
		Если Учтенные.Получить(Помеченный.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Помеченный.Ссылка, Истина);
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Найден контрагент, помеченный на удаление: %1, код %2. Он не используется.';
				|uk = 'Знайдено контрагента, позначеного на видалення: %1, код %2. Його не використано.'"),
				Помеченный.Название, Помеченный.Код));
	КонецЦикла;

КонецПроцедуры

// Счета организаций и физлиц с любым из номеров (текущим или устаревшим): не помеченные на удаление (недействительный
// счет находится: выписка может ссылаться на закрытый свой счет). Для организации
// приходят название и КонтрагентИнтеркампани, для физлица - название. Порядок - по коду справочника.
Функция ПрочитатьСчетаОрганизацийИФизлиц(Номера)

	Результат = Новый Массив;
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший,
		|	Счета.Владелец КАК Владелец,
		|	ЕСТЬNULL(Организации.Наименование, ЕСТЬNULL(ФизЛица.Наименование, """")) КАК ВладелецНаименование,
		|	ЕСТЬNULL(Организации.КонтрагентИнтеркампани, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК КонтрагентИнтеркампани
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО Счета.Владелец = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
		|		ПО Счета.Владелец = ФизЛица.Ссылка
		|ГДЕ
		|	НЕ Счета.ПометкаУдаления
		|	И (Счета.Владелец ССЫЛКА Справочник.Организации
		|		ИЛИ Счета.Владелец ССЫЛКА Справочник.ФизическиеЛица)
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Номер, Устаревший, Владелец, ВладелецНаименование, КонтрагентИнтеркампани");
		ЗаполнитьЗначенияСвойств(Счет, Выборка);
		Счет.Номер = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счет с номером операции: совпадение по текущему номеру предпочитается совпадению по устаревшему; внутри - по коду.
Функция НайтиСвойСчетСтроки(Номер, Счета)

	Для Каждого Счет Из Счета Цикл
		Если Счет.Номер = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Устаревший = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сотрудники физлиц (не помеченные на удаление, не недействительные) с текущими кадровыми данными; порядок - по коду.
Функция ПрочитатьСотрудниковФизлиц(Физлица)

	Результат = Новый Массив;
	Если Физлица.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.Физлицо КАК Физлицо,
		|	ЕСТЬNULL(Кадровые.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
		|	ЕСТЬNULL(Организации.Наименование, """") КАК ОрганизацияНаименование,
		|	ЕСТЬNULL(Кадровые.ДатаПриема, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПриема,
		|	ЕСТЬNULL(Кадровые.ДатаУвольнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУвольнения
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК Кадровые
		|		ПО Кадровые.Сотрудник = Сотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО Кадровые.Организация = Организации.Ссылка
		|ГДЕ
		|	Сотрудники.Физлицо В (&Физлица)
		|	И НЕ Сотрудники.ПометкаУдаления
		|	И НЕ Сотрудники.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудники.Код");
	Запрос.УстановитьПараметр("Физлица", Физлица);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сотрудник = Новый Структура("Ссылка, Физлицо, Организация, ОрганизацияНаименование, ДатаПриема, ДатаУвольнения");
		ЗаполнитьЗначенияСвойств(Сотрудник, Выборка);
		Результат.Добавить(Сотрудник);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строка сработавшего шага 1-2: найденный ранее контрагент, счет, действия и замечания о них сбрасываются.
Процедура СброситьКонтрагентаСтроки(План, СтрокаПлана)

	СтрокаПлана.Контрагент = Неопределено;
	СтрокаПлана.СчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка();
	СтрокаПлана.ДействиеКонтрагент = "";
	СтрокаПлана.ДействиеСчет = "";

	// Сбрасываются ТОЛЬКО замечания шага поиска контрагента и счета (ШагКонтрагентСчет): поля Контрагент, КонтрагентКод
	// (в том числе предупреждение о коде из 7 / 9 цифр), КонтрагентНаименование, СчетКонтрагента, Договор. От найденного там
	// контрагента строка отказалась, и замечания о нем были бы ложными. Замечания других шагов и других полей (например,
	// ЗагруженныйДокумент) не затрагиваются.
	УдалитьЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер,
		СтрРазделить("Контрагент,КонтрагентКод,КонтрагентНаименование,СчетКонтрагента,Договор", ","));

КонецПроцедуры

// Удаляет из плана замечания строки по условию: номер строки, поле из списка и, если задано, точный текст или признак
// "предупреждение шага 2 о нескольких сотрудниках". ОДНА функция для всех мест снятия замечаний (СброситьКонтрагентаСтроки,
// ПрименитьКонтрагентаБанка, ПрименитьПоручение): проход зворотний, по явному индексу. Прежний цикл
// "Для Индекс = 1 По Количество() ... Замечания[Количество() - Индекс] ... Удалить" считал границу один раз, а индекс - от текущего
// количества: после каждого удаления пропускал запись, а в конце выходил за границы массива (если снимаемое замечание не первое в таблице).
//
// Параметры:
//  План - Структура - см. НовыйПланЗагрузки.
//  ПорядковыйНомер - Число - номер строки плана.
//  Поля - Массив из Строка - имена полей снимаемых замечаний.
//  ТочныйТекст - Строка - если не пустая, снимаются только замечания с этим текстом.
//  НесколькоСотрудников - Булево - если Истина, снимаются только предупреждения шага 2 "взят первый по коду".
Процедура УдалитьЗамечанияСтроки(План, ПорядковыйНомер, Поля, ТочныйТекст = "", НесколькоСотрудников = Ложь)

	Индекс = План.Замечания.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Замечание = План.Замечания[Индекс];
		Если Замечание.ПорядковыйНомер = ПорядковыйНомер И Поля.Найти(Замечание.Поле) <> Неопределено
			И (ПустаяСтрока(ТочныйТекст) Или Замечание.Текст = ТочныйТекст)
			И (Не НесколькоСотрудников Или ЭтоПредупреждениеНесколькоСотрудников(Замечание.Текст)) Тогда
			План.Замечания.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьПереводМеждуСвоимиСчетами(План, СтрокаПлана, Счет, Контекст)

	Если Счет.Ссылка = Контекст.БанковскийСчет Тогда
		// Счет контрагента операции - сам счет выписки: переводом "на другой счет" это быть не может.
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента ""%1"" - это банковский счет самой выписки: перевод между своими счетами не определен.';
				|uk = 'Рахунок контрагента ""%1"" - це банківський рахунок самої виписки: переказ між своїми рахунками не визначено.'"),
				СтрокаПлана.КонтрагентНомерСчета));
		Возврат;
	КонецЕсли;

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ПереводСДругогоСчета;
	Иначе
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ПереводНаДругойСчет;
	КонецЕсли;
	СтрокаПлана.ИсточникВидаОперации = ИсточникСвойСчет();
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНеТребуется();
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();

КонецПроцедуры

// СчетаИнтеркампани - счета контрагентов интеркампани (ПрочитатьСчетаКонтрагентовИнтеркампани), Номер - нормализованный
// номер счета операции. Счет контрагента интеркампани с тем же номером (текущим предпочтительнее устаревшего) - это и
// есть СчетКонтрагента; нет такого - счет самой организации с предупреждением (решение консультанта).
Процедура ПрименитьДругуюОрганизацию(План, СтрокаПлана, Счет, Номер, СчетаИнтеркампани)

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	Если СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет() Тогда
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ОтНашейОрганизации;
	Иначе
		СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.НашейОрганизации;
	КонецЕсли;
	СтрокаПлана.ИсточникВидаОперации = ИсточникНашаОрганизация();
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеСчет = ДействиеНайден();

	// Реквизит Контрагент банковских документов - только Контрагенты: другая организация представлена контрагентом
	// интеркампани. Платформа его не создает (настройка человека): не заполнен - документ этап 4 запишет непроведенным.
	Если ЗначениеЗаполнено(Счет.КонтрагентИнтеркампани) Тогда
		СтрокаПлана.Контрагент = Счет.КонтрагентИнтеркампани;
		СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
		СчетИнтеркампани = НайтиСчетКонтрагентаИнтеркампани(Номер, Счет.КонтрагентИнтеркампани, СчетаИнтеркампани);
		Если СчетИнтеркампани <> Неопределено Тогда
			СтрокаПлана.СчетКонтрагента = СчетИнтеркампани.Ссылка;
		Иначе
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
				СтрШаблон(НСтр("ru = 'Счет ""%1"" принадлежит организации ""%2"", а не ее контрагенту интеркампани: в документ подставлен счет организации.';
					|uk = 'Рахунок ""%1"" належить організації ""%2"", а не її контрагенту інтеркампані: у документ підставлено рахунок організації.'"),
					СтрокаПлана.КонтрагентНомерСчета, Счет.ВладелецНаименование));
		КонецЕсли;
	Иначе
		СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно();
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньОшибка(),
			СтрШаблон(НСтр("ru = 'У организации ""%1"" не заполнен контрагент интеркампани: документ по операции между организациями не может быть заполнен.';
				|uk = 'В організації ""%1"" не заповнено контрагента інтеркампані: документ за операцією між організаціями не може бути заповнений.'"),
				Счет.ВладелецНаименование));
	КонецЕсли;

КонецПроцедуры

// Сотрудники физособы по кадровым данным (порядок - как у СотрудникиФизлиц, по коду): действующие (прием есть, увольнения нет, организация
// кадровых данных - компания), уволенные (в компании) и работающие в других организациях. Одно правило для шага 2 и для шага 3 (D35.12):
// шаг 3 ищет поручения на тех же чинных сотрудников, которых нашел шаг 2.
//
// Возвращаемое значение:
//  Структура - Действующие, Уволенные, ВДругихОрганизациях (массивы структур ПрочитатьСотрудниковФизлиц)
Функция РазобратьСотрудниковФизлица(СотрудникиФизлиц, Физлицо, Компания)

	Действующие = Новый Массив;
	Уволенные = Новый Массив;
	ВДругихОрганизациях = Новый Массив;
	Для Каждого Сотрудник Из СотрудникиФизлиц Цикл
		Если Сотрудник.Физлицо <> Физлицо Или Не ЗначениеЗаполнено(Сотрудник.ДатаПриема) Тогда
			Продолжить;
		КонецЕсли;
		Если Сотрудник.Организация <> Компания Тогда
			Если Не ЗначениеЗаполнено(Сотрудник.ДатаУвольнения) И ЗначениеЗаполнено(Сотрудник.Организация) Тогда
				ВДругихОрганизациях.Добавить(Сотрудник);
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(Сотрудник.ДатаУвольнения) Тогда
			Уволенные.Добавить(Сотрудник);
		Иначе
			Действующие.Добавить(Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Действующие, Уволенные, ВДругихОрганизациях", Действующие, Уволенные, ВДругихОрганизациях);

КонецФункции

// Компания - Константы.УчетПоКомпании.Компания(организация контекста): организация, на которую вендор пишет кадровые данные.
// Сотрудник "свой", если организация его кадровых данных - эта компания; иначе "работает в другой организации", и в
// предупреждении названа организация из регистра.
Процедура ПрименитьСотрудника(План, СтрокаПлана, Счет, СотрудникиФизлиц, Компания)

	Разбор = РазобратьСотрудниковФизлица(СотрудникиФизлиц, Счет.Владелец, Компания);
	Действующие = Разбор.Действующие;
	Уволенные = Разбор.Уволенные;
	ВДругихОрганизациях = Разбор.ВДругихОрганизациях;

	Если Действующие.Количество() = 0 Тогда
		Причина = НСтр("ru = 'не является сотрудником организации';uk = 'не є працівником організації'");
		Если Уволенные.Количество() > 0 Тогда
			Причина = СтрШаблон(НСтр("ru = 'уволен %1';uk = 'звільнений %1'"), Формат(Уволенные[0].ДатаУвольнения, "ДЛФ=D"));
		ИначеЕсли ВДругихОрганизациях.Количество() > 0 Тогда
			// Сотрудник другой нашей организации: выплата от этой организации зарплатой не считается; название нужно человеку.
			Причина = СтрШаблон(НСтр("ru = 'работает в другой организации (%1)';uk = 'працює в іншій організації (%1)'"),
				ВДругихОрганизациях[0].ОрганизацияНаименование);
		КонецЕсли;
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "КонтрагентНомерСчета", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента принадлежит физлицу ""%1"", которое %2: выплатой зарплаты операция не считается.';
				|uk = 'Рахунок контрагента належить фізособі ""%1"", яка %2: виплатою зарплати операцію не вважають.'"),
				Счет.ВладелецНаименование, Причина));
		Возврат;
	КонецЕсли;

	СброситьКонтрагентаСтроки(План, СтрокаПлана);
	СтрокаПлана.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ЗарплатаСотруднику;
	СтрокаПлана.ИсточникВидаОперации = ИсточникСотрудник();
	СтрокаПлана.Контрагент = Действующие[0].Ссылка;
	СтрокаПлана.СчетКонтрагента = Счет.Ссылка;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	СтрокаПлана.ДействиеСчет = ДействиеНайден();
	СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();

	Если Действующие.Количество() > 1 Тогда
		ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
			ТекстПредупрежденияНесколькоСотрудников(Счет.ВладелецНаименование, Действующие.Количество()));
	КонецЕсли;

КонецПроцедуры

// Предупреждение шага 2: у физособы несколько чинных сотрудников, взят первый по коду. Шаг 3 (D35.12) снимает именно его, когда
// сотрудник берется из поручения (ЭтоПредупреждениеНесколькоСотрудников): шаблон и признак держатся вместе.
Функция ТекстПредупрежденияНесколькоСотрудников(ИмяФизлица, Количество)

	Возврат СтрШаблон(НСтр("ru = 'У физлица ""%1"" действующих сотрудников в организации: %2, взят первый по коду справочника.';
		|uk = 'У фізособи ""%1"" чинних працівників в організації: %2, взято першого за кодом довідника.'"),
		ИмяФизлица, Формат(Количество, "ЧГ="));

КонецФункции

// Текст - текст замечания плана. Признак - постоянные фрагменты шаблона ТекстПредупрежденияНесколькоСотрудников (обе языковые версии);
// имя физособы и число в них разные, поэтому точное сравнение невозможно. Менять шаблон и фрагменты вместе.
Функция ЭтоПредупреждениеНесколькоСотрудников(Текст)

	Возврат СтрНайти(Текст, "действующих сотрудников в организации") > 0 И СтрНайти(Текст, "взят первый по коду справочника") > 0
		Или СтрНайти(Текст, "чинних працівників в організації") > 0 И СтрНайти(Текст, "взято першого за кодом довідника") > 0;

КонецФункции

// Счета контрагентов интеркампани (не помеченные на удаление, не недействительные) с любым из номеров (текущим или
// устаревшим). Один запрос на конверт; порядок - по коду справочника.
Функция ПрочитатьСчетаКонтрагентовИнтеркампани(Контрагенты, Номера)

	Результат = Новый Массив;
	Если Контрагенты.Количество() = 0 Или Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.Владелец КАК Владелец,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец В (&Контрагенты)
		|	И НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|	И (Счета.НомерСчета В (&Номера)
		|		ИЛИ Счета.НомерСчетаУстаревший В (&Номера))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счет = Новый Структура("Ссылка, Владелец, Номер, Устаревший");
		Счет.Ссылка = Выборка.Ссылка;
		Счет.Владелец = Выборка.Владелец;
		Счет.Номер = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчета);
		Счет.Устаревший = СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчетаУстаревший);
		Результат.Добавить(Счет);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Счет контрагента интеркампани с номером операции: по текущему номеру, иначе по устаревшему; Неопределено, если нет.
Функция НайтиСчетКонтрагентаИнтеркампани(Номер, Контрагент, Счета)

	Для Каждого Счет Из Счета Цикл
		Если Счет.Владелец = Контрагент И Счет.Номер = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Счет Из Счета Цикл
		Если Счет.Владелец = Контрагент И Счет.Устаревший = Номер Тогда
			Возврат Счет;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Решения над контрагентом и счетом, которых не нашел поиск. Строка с контрагентом, определенным раньше (шаги задачи 5),
// не пересматривается.
Процедура РешитьКонтрагентаИСчет(План, СтрокаПлана)

	Нужен = ВидОперацииТребуетКонтрагента(СтрокаПлана.ВидОперации);
	ЕстьНомер = Не ПустаяСтрока(СМП_ВыпискаБанка.НормализованныйНомерСчета(СтрокаПлана.КонтрагентНомерСчета));

	Если ПустаяСтрока(СтрокаПлана.ДействиеКонтрагент) И Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		ЕстьДанные = Не ПустаяСтрока(СтрокаПлана.КонтрагентНаименование) Или ЕстьНомер
			Или НормализоватьКодКонтрагента(СтрокаПлана.КонтрагентКод).Использовать;
		Если Не Нужен Тогда
			СтрокаПлана.ДействиеКонтрагент = ДействиеНеТребуется();
		ИначеЕсли ЕстьДанные Тогда
			СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать();
		Иначе
			// Создать нечего: ни названия, ни пригодного кода, ни счета. Документ этап 4 запишет непроведенным.
			СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно();
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньОшибка(),
				ТекстЗамечанияКонтрагентНевозможен());
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(СтрокаПлана.ДействиеСчет)
		И (Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Или ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты")) Тогда
		Если ЕстьНомер И (СтрокаПлана.ДействиеКонтрагент = ДействиеНайден() Или СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать()) Тогда
			СтрокаПлана.ДействиеСчет = ДействиеСоздать();
		Иначе
			СтрокаПлана.ДействиеСчет = ДействиеНеТребуется();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ТекстЗамечанияКонтрагентНевозможен()

	Возврат НСтр("ru = 'Контрагента определить и создать нельзя: в операции нет ни названия, ни пригодного кода, ни номера счета.';
		|uk = 'Контрагента визначити і створити неможливо: в операції немає ні назви, ні придатного коду, ні номера рахунку.'");

КонецФункции

// Контрагент банка для комиссии (D35.8). Вид "Комиссия банка", строка контрагента не дала (действие "Невозможно"),
// КонтрагентБанка в контексте заполнен: контрагент - он, действие "Найден", замечание "Невозможно" с поля контрагента снимается
// (то самое, что поставил РешитьКонтрагентаИСчет, - по тексту). Строка, давшая своего контрагента (найден или будет создан), не
// пересматривается.
Процедура ПрименитьКонтрагентаБанка(План, Строки, Контекст)

	КонтрагентБанка = Контекст.КонтрагентБанка;
	Если Не ЗначениеЗаполнено(КонтрагентБанка) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПлана Из Строки Цикл
		Если СтрокаПлана.ВидОперации <> Перечисления.ВидыОперацийРасходСоСчета.КомиссияБанка
			Или СтрокаПлана.ДействиеКонтрагент <> ДействиеНевозможно() Тогда
			Продолжить;
		КонецЕсли;

		СтрокаПлана.Контрагент = КонтрагентБанка;
		СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();

		УдалитьЗамечанияСтроки(План, СтрокаПлана.ПорядковыйНомер, СтрРазделить("Контрагент", ","), ТекстЗамечанияКонтрагентНевозможен());
	КонецЦикла;

КонецПроцедуры

// Статья ДДС, цепочка D14. Стаття, яку дали кроки 3-4 (платежное поручение, правило), не перевычисляется. Иначе, от
// детального к общему: статья договора (если контрагент ведет расчеты по договорам и договор строки известен) -> статья
// контрагента (D13) -> предопределенная статья по виду операции (СтатьяДДСПоВидуОперации). Вендорской функции-цепочки нет;
// порядок уровней - наш. Контрагент-сотрудник и контрагент, которого еще нет в базе, уровней договора и контрагента не имеют.
// Запросов: контрагенты (признак учета и статья - один запрос в ПрочитатьДанныеУчетаКонтрагентов) и договоры - по одному на конверт.
Процедура ЗаполнитьСтатьиДДС(Строки)

	Нужные = Новый Массив;
	Контрагенты = Новый Массив;
	Договоры = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.СтатьяДДС) Тогда
			Продолжить;
		КонецЕсли;
		Нужные.Добавить(СтрокаПлана);
		Если ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
			ДобавитьУникальное(Контрагенты, СтрокаПлана.Контрагент);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПлана.Договор) Тогда
			ДобавитьУникальное(Договоры, СтрокаПлана.Договор);
		КонецЕсли;
	КонецЦикла;
	Если Нужные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Контрагент -> структура(ВестиРасчетыПоДоговорам, Статья); договор -> статья.
	ДанныеКонтрагентов = Новый Соответствие;
	Если Контрагенты.Количество() > 0 Тогда
		ДанныеКонтрагентов = ПрочитатьДанныеУчетаКонтрагентов(Контрагенты);
	КонецЕсли;
	СтатьиДоговоров = Новый Соответствие;
	Если Договоры.Количество() > 0 Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Договоры.Ссылка КАК Ссылка,
			|	Договоры.СтатьяДДСПоУмолчанию КАК Статья
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договоры
			|ГДЕ
			|	Договоры.Ссылка В (&Договоры)");
		Запрос.УстановитьПараметр("Договоры", Договоры);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтатьиДоговоров.Вставить(Выборка.Ссылка, Выборка.Статья);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаПлана Из Нужные Цикл
		Данные = ДанныеКонтрагентов.Получить(СтрокаПлана.Контрагент);
		СтатьяДоговора = ?(ЗначениеЗаполнено(СтрокаПлана.Договор), СтатьиДоговоров.Получить(СтрокаПлана.Договор), Неопределено);
		Если Данные <> Неопределено И Данные.ВестиРасчетыПоДоговорам = Истина И ЗначениеЗаполнено(СтатьяДоговора) Тогда
			СтрокаПлана.СтатьяДДС = СтатьяДоговора;
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиДоговор();
		ИначеЕсли Данные <> Неопределено И ЗначениеЗаполнено(Данные.Статья) Тогда
			СтрокаПлана.СтатьяДДС = Данные.Статья;
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиКонтрагент();
		Иначе
			СтрокаПлана.СтатьяДДС = СтатьяДДСПоВидуОперации(СтрокаПлана.ВидОперации);
			СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиПоВидуОперации();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Предопределенная статья по виду операции - последний уровень цепочки D14. Из вендорской формы
// ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС (cf/src) взята ТОЛЬКО эта отвечающая таблица "вид -> статья"
// для банковских видов (ВидыОперацийПоступлениеНаСчет, ВидыОперацийРасходСоСчета); вызов функции формы и ее порядок уровней
// (контрагент -> вид, без договора) не используются. Кассовые виды и виды платежного поручения не переносятся. Вид вне таблицы -
// "Прочее", как ветка "Иначе" вендора. Возвраты (ОтПоставщика, Покупателю) в таблице: в вендоре они в тех же ветках.
Функция СтатьяДДСПоВидуОперации(ВидОперации)

	Статьи = Справочники.СтатьиДвиженияДенежныхСредств;
	Поступления = Перечисления.ВидыОперацийПоступлениеНаСчет;
	Списания = Перечисления.ВидыОперацийРасходСоСчета;

	Таблица = Новый Соответствие;
	Таблица.Вставить(Поступления.ОтПокупателя, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтКурьерскойКомпанииПочты, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтНашейОрганизации, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Списания.Покупателю, Статьи.ОплатаОтПокупателей);
	Таблица.Вставить(Поступления.ОтПоставщика, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Списания.Поставщику, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Списания.НашейОрганизации, Статьи.ОплатаПоставщикам);
	Таблица.Вставить(Поступления.ЛичныеСредстваПредпринимателя, Статьи.ЛичныеСредстваПредпринимателя);
	Таблица.Вставить(Списания.ЛичныеСредстваПредпринимателя, Статьи.ЛичныеСредстваПредпринимателя);

	Результат = Таблица.Получить(ВидОперации);
	Возврат ?(Результат = Неопределено, Статьи.Прочее, Результат);

КонецФункции

// Корреспонденция (решение консультанта к задаче 9): вид "Личные средства предпринимателя" и пустая корреспонденция (ее не дали
// ни платежное поручение, ни правило) -> НераспределеннаяПрибыль, для любого источника вида. Источники у вендора:
// РасходСоСчета.ЗаполнитьПоПлатежноеПоручение (ObjectModule, запрос: ВЫБОР ... ЛичныеСредстваПредпринимателя ТОГДА
// НераспределеннаяПрибыль) и процедура ФормыДокументовДеньги.ЗаполнитьКорреспонденцию (через
// ВидОперацииЛичныеСредстваПредпринимателя), формы документов ПоступлениеНаСчет и РасходСоСчета. Вендор в запросе поручения берет
// НераспределеннаяПрибыль и при заполненной корреспонденции поручения; здесь заполненное берется как есть (D15). Правило вида - в
// КорреспонденцияЛичныхСредств (одно для плана и для записи без плана).
Процедура ЗаполнитьКорреспонденцию(Строки)

	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Корреспонденция) Тогда
			Продолжить;
		КонецЕсли;
		Корреспонденция = КорреспонденцияЛичныхСредств(СтрокаПлана.ВидОперации);
		Если ЗначениеЗаполнено(Корреспонденция) Тогда
			СтрокаПлана.Корреспонденция = Корреспонденция;
			СтрокаПлана.ИсточникКорреспонденции = ИсточникКорреспонденцииПоВидуОперации();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Договор для каждой строки, у которой его еще нет и вид операции его требует. Контрагент создается - договор создается;
// контрагента создать нельзя - договор тоже. Найденному контрагенту:
//  - расчеты по договорам не ведутся -> договор по умолчанию контрагента (вендорская Справочники.ДоговорыКонтрагентов.
//    ДоговорПоУмолчанию - ее же зовет ПередЗаписью вендорских ПоступлениеНаСчет / РасходСоСчета; организация не фильтрует);
//  - иначе договоры контрагента организации распознавания (не помечены на удаление, не недействительны) ВИДА, подходящего
//    виду операции: основной; иначе единственный; несколько без основного - предупреждение и первый по коду; нужного вида
//    нет, а другой есть - "Создать" и предупреждение с перечнем договоров другого вида.
// Запросов: признаки контрагентов и договоры - по одному на конверт.
Процедура ВыбратьДоговоры(План, Строки, Контекст)

	Искать = Новый Массив;
	Контрагенты = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.Договор) Или Не ПустаяСтрока(СтрокаПлана.ДействиеДоговор) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ВидОперацииТребуетДоговор(СтрокаПлана.ВидОперации) Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеНеТребуется();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеСоздать() Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеНевозможно() Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеНевозможно();
		ИначеЕсли СтрокаПлана.ДействиеКонтрагент = ДействиеНайден()
			И ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Искать.Добавить(СтрокаПлана);
			Если Повторы.Получить(СтрокаПлана.Контрагент) = Неопределено Тогда
				Повторы.Вставить(СтрокаПлана.Контрагент, Истина);
				Контрагенты.Добавить(СтрокаПлана.Контрагент);
			КонецЕсли;
		Иначе
			// ИНВАРИАНТ: после ВыбратьДоговоры у строки вида, которому нужен договор, ДействиеДоговор НЕ пусто (молчаливого третьего состояния нет, а "НеТребуется"
			// было бы неправдой: договор виду нужен). Сюда попадает строка, чей контрагент не является справочником Контрагенты (найденный сотрудник) или
			// чье действие над контрагентом не позволяет искать договор: договор определить нельзя - "Невозможно" с причиной (как "Невозможно" у контрагента).
			СтрокаПлана.ДействиеДоговор = ДействиеНевозможно();
			ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Договор", СМП_ВыпискаБанка.УровеньОшибка(),
				СтрШаблон(НСтр("ru = 'Договор определить нельзя: контрагент строки не является контрагентом (действие над контрагентом: ""%1"", значение: ""%2""), а вид операции требует договора.';
					|uk = 'Договір визначити неможливо: контрагент рядка не є контрагентом (дія над контрагентом: ""%1"", значення: ""%2""), а вид операції потребує договору.'"),
					СтрокаПлана.ДействиеКонтрагент, Строка(СтрокаПлана.Контрагент)));
		КонецЕсли;
	КонецЦикла;
	Если Искать.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	УчетПоДоговорам = ПрочитатьУчетПоДоговорам(Контрагенты);
	КонтрагентыСУчетом = Новый Массив;
	Для Каждого Контрагент Из Контрагенты Цикл
		Если УчетПоДоговорам.Получить(Контрагент) = Истина Тогда
			КонтрагентыСУчетом.Добавить(Контрагент);
		КонецЕсли;
	КонецЦикла;
	Договоры = ПрочитатьДоговорыКонтрагентов(КонтрагентыСУчетом, Контекст.Организация);

	Для Каждого СтрокаПлана Из Искать Цикл
		Если УчетПоДоговорам.Получить(СтрокаПлана.Контрагент) = Истина Тогда
			ВыбратьДоговорСтроки(План, СтрокаПлана, Договоры);
		Иначе
			Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(СтрокаПлана.Контрагент);
			Если ЗначениеЗаполнено(Договор) Тогда
				СтрокаПлана.Договор = Договор;
				СтрокаПлана.ДействиеДоговор = ДействиеНайден();
			Иначе
				СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Соответствие "контрагент -> ведутся ли расчеты по договорам": признак ВестиРасчетыПоДоговорам контрагентов из списка. Один запрос на
// весь список. Экспортная: тот же признак читает выбор договора (ВыбратьДоговоры) и запоминание статьи ДДС (куда писать статью: договор или
// контрагент, D13), чтобы правило не расходилось.
//
// Параметры:
//  Контрагенты - Массив из СправочникСсылка.Контрагенты - контрагенты, для которых читается признак.
//
// Возвращаемое значение:
//  Соответствие - ключ: контрагент (СправочникСсылка.Контрагенты), значение: Булево (ВестиРасчетыПоДоговорам); контрагента нет в базе - ключа нет.
Функция ПрочитатьУчетПоДоговорам(Контрагенты) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Элемент Из ПрочитатьДанныеУчетаКонтрагентов(Контрагенты) Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение.ВестиРасчетыПоДоговорам);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признак ВестиРасчетыПоДоговорам и статья ДДС по умолчанию контрагентов из списка. Один запрос на весь список; общий
// для ПрочитатьУчетПоДоговорам и ЗаполнитьСтатьиДДС: признак читается в одном месте.
//
// Возвращаемое значение:
//  Соответствие - ключ: контрагент, значение: Структура (ВестиРасчетыПоДоговорам, Статья); контрагента нет в базе - ключа нет.
Функция ПрочитатьДанныеУчетаКонтрагентов(Контрагенты)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.ВестиРасчетыПоДоговорам КАК ВестиРасчетыПоДоговорам,
		|	Контрагенты.СтатьяДДСПоУмолчанию КАК Статья
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В (&Контрагенты)");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Новый Структура("ВестиРасчетыПоДоговорам, Статья",
			Выборка.ВестиРасчетыПоДоговорам, Выборка.Статья));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Договоры контрагентов организации: не помечены на удаление, не недействительны; с признаком "основной" (запись регистра
// основных договоров). Порядок - по коду справочника.
Функция ПрочитатьДоговорыКонтрагентов(Контрагенты, Организация)

	Результат = Новый Массив;
	Если Контрагенты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка,
		|	Договоры.Владелец КАК Контрагент,
		|	Договоры.ВидДоговора КАК ВидДоговора,
		|	Договоры.Наименование КАК Название,
		|	ВЫБОР
		|		КОГДА Основные.Договор ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Основной
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК Основные
		|		ПО Основные.Договор = Договоры.Ссылка
		|ГДЕ
		|	Договоры.Владелец В (&Контрагенты)
		|	И Договоры.Организация = &Организация
		|	И НЕ Договоры.ПометкаУдаления
		|	И НЕ Договоры.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Договоры.Код");
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Договор = Новый Структура("Ссылка, Контрагент, ВидДоговора, Название, Основной");
		ЗаполнитьЗначенияСвойств(Договор, Выборка);
		Результат.Добавить(Договор);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ВыбратьДоговорСтроки(План, СтрокаПлана, Договоры)

	Виды = ВидыДоговораДляВидаОперации(СтрокаПлана.ВидОперации);
	Подходящие = Новый Массив;
	ДругогоВида = Новый Массив;
	Для Каждого Договор Из Договоры Цикл
		Если Договор.Контрагент <> СтрокаПлана.Контрагент Тогда
			Продолжить;
		КонецЕсли;
		Если Виды.Количество() = 0 Или Виды.Найти(Договор.ВидДоговора) <> Неопределено Тогда
			Подходящие.Добавить(Договор);
		Иначе
			ДругогоВида.Добавить(Договор);
		КонецЕсли;
	КонецЦикла;

	Основные = Новый Массив;
	Для Каждого Договор Из Подходящие Цикл
		Если Договор.Основной Тогда
			Основные.Добавить(Договор);
		КонецЕсли;
	КонецЦикла;

	Если Основные.Количество() > 0 Тогда
		Выбранный = Основные[0];
		Если Основные.Количество() > 1 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Основные, НСтр("ru = 'несколько основных договоров';uk = 'кілька основних договорів'"));
		КонецЕсли;
	ИначеЕсли Подходящие.Количество() > 0 Тогда
		Выбранный = Подходящие[0];
		Если Подходящие.Количество() > 1 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Подходящие, НСтр("ru = 'несколько договоров без основного';uk = 'кілька договорів без основного'"));
		КонецЕсли;
	Иначе
		СтрокаПлана.ДействиеДоговор = ДействиеСоздать();
		Если ДругогоВида.Количество() > 0 Тогда
			ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, ДругогоВида,
				НСтр("ru = 'нужного вида договора нет, есть договоры другого вида (будет создан новый)';uk = 'потрібного виду договору немає, є договори іншого виду (буде створено новий)'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	СтрокаПлана.Договор = Выбранный.Ссылка;
	СтрокаПлана.ДействиеДоговор = ДействиеНайден();

КонецПроцедуры

Процедура ДобавитьЗамечаниеОДоговорах(План, СтрокаПлана, Договоры, Причина)

	Названия = Новый Массив;
	Для Каждого Договор Из Договоры Цикл
		Названия.Добавить(Договор.Название);
	КонецЦикла;

	ДобавитьЗамечание(План, СтрокаПлана.ПорядковыйНомер, "Договор", СМП_ВыпискаБанка.УровеньПредупреждение(),
		СтрШаблон(НСтр("ru = 'Договор контрагента: %1. Договоры: %2.';uk = 'Договір контрагента: %1. Договори: %2.'"),
		Причина, СтрСоединить(Названия, "; ")));

КонецПроцедуры

#КонецОбласти

#Область РешенияЧеловека

// Решения человека и типы их значений: единственное место перечня. Новое решение (задача 6: перезапись) добавляется сюда строкой и
// веткой в ПрименитьРешенияКСтроке.
Функция ТипыРешенийЧеловека()

	Типы = Новый Структура;
	Типы.Вставить("ВидОперации", Новый ОписаниеТипов(
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
	Типы.Вставить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Типы.Вставить("СчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Типы.Вставить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Типы.Вставить("СтатьяДДС", Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Типы.Вставить("Корреспонденция", Новый ОписаниеТипов("ПланСчетовСсылка.Управленческий"));
	Типы.Вставить("ВидНалога", Новый ОписаниеТипов("СправочникСсылка.ВидыНалогов"));
	// Истина - не создавать контрагента (и его счёт и договор); Ложь - человек передумал, снять решение. Единственное булево решение.
	Типы.Вставить("НеСоздаватьКонтрагента", Новый ОписаниеТипов("Булево"));
	// Способ зачета строки расшифровки (Авто / Вручную); пустое значение снимает решение: способ снова считает запись по правилу D34.
	Типы.Вставить("СпособЗачета", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей"));
	// Банк нового счета контрагента (D6): запись создает счет в этом банке вместо определенного по МФО; пустое значение снимает решение.
	Типы.Вставить("БанкНовогоСчета", Новый ОписаниеТипов("СправочникСсылка.Банки"));
	// Свідомий перезапис знайденого документа (D5, задача 6): Истина - перезаписать (строка распознается как новая), Ложь - вернуть в состояние шага 0.
	// Единственное решение вызова (ПрименитьРешениеПерезаписать): пересчитывает строку всеми шагами.
	Типы.Вставить("Перезаписать", Новый ОписаниеТипов("Булево"));
	Возврат Типы;

КонецФункции

// Решения, значение которых не может быть пустым (пустая ссылка не выбор, а ошибка вызывающего кода). Для остальных пустое значение -
// "снять решение, считать по правилам".
Функция РешенияБезПустогоЗначения()

	Возврат СтрРазделить("ВидОперации,Контрагент,СчетКонтрагента,Договор", ",");

КонецФункции

// Имена и типы решений проверяются до любой работы: факт банка, неизвестное имя или значение не того типа - ошибка вызывающего кода.
Процедура ПроверитьРешенияЧеловека(Решения)

	Факты = Новый Массив;
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		Факты.Добавить(Колонка.Имя);
	КонецЦикла;
	Допустимые = ТипыРешенийЧеловека();
	БезПустого = РешенияБезПустогоЗначения();

	Для Каждого Решение Из Решения Цикл
		Если Факты.Найти(Решение.Ключ) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ПрименитьРешенияЧеловека: ""%1"" - факт банка, человек его не правит.';
				|uk = 'ЗастосуватиРішенняЛюдини: ""%1"" - факт банку, людина його не редагує.'"), Решение.Ключ);
		ИначеЕсли Не Допустимые.Свойство(Решение.Ключ) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ПрименитьРешенияЧеловека: неизвестное решение ""%1"".';
				|uk = 'ЗастосуватиРішенняЛюдини: невідоме рішення ""%1"".'"), Решение.Ключ);
		ИначеЕсли Не Допустимые[Решение.Ключ].СодержитТип(ТипЗнч(Решение.Значение)) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ПрименитьРешенияЧеловека: значение решения ""%1"" имеет тип ""%2"", ожидался другой.';
				|uk = 'ЗастосуватиРішенняЛюдини: значення рішення ""%1"" має тип ""%2"", очікувався інший.'"), Решение.Ключ, ТипЗнч(Решение.Значение));
		ИначеЕсли БезПустого.Найти(Решение.Ключ) <> Неопределено И Не ЗначениеЗаполнено(Решение.Значение) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'ПрименитьРешенияЧеловека: значение решения ""%1"" не заполнено.';
				|uk = 'ЗастосуватиРішенняЛюдини: значення рішення ""%1"" не заповнено.'"), Решение.Ключ);
		КонецЕсли;
	КонецЦикла;

	// "Перезаписать" пересчитывает строку целиком и с другими решениями вызова не смешивается: ошибка вызывающего кода.
	Если Решения.Свойство("Перезаписать") И Решения.Количество() > 1 Тогда
		ВызватьИсключение НСтр("ru = 'ПрименитьРешенияЧеловека: решение ""Перезаписать"" передается отдельно от других решений.';
			|uk = 'ЗастосуватиРішенняЛюдини: рішення ""Перезаписати"" передається окремо від інших рішень.'");
	КонецЕсли;

	// "Не создавать контрагента" и выбор существующего контрагента, счёта или договора взаимоисключающи: ошибка вызывающего кода.
	Если Решения.Свойство("НеСоздаватьКонтрагента") Тогда
		Если Решения.НеСоздаватьКонтрагента И (Решения.Свойство("Контрагент") Или Решения.Свойство("СчетКонтрагента") Или Решения.Свойство("Договор")) Тогда
			ВызватьИсключение НСтр("ru = 'ПрименитьРешенияЧеловека: решение ""НеСоздаватьКонтрагента"" несовместимо с выбором контрагента, счёта или договора.';
				|uk = 'ЗастосуватиРішенняЛюдини: рішення ""НеСоздаватьКонтрагента"" несумісне з вибором контрагента, рахунку або договору.'");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Владельцы выбранных человеком счёта и договора: один раз на вызов, а не на строку.
Функция ВладельцыОбъектовРешений(Решения)

	Результат = Новый Структура("ВладелецСчета, ВладелецДоговора", Неопределено, Неопределено);
	Если Решения.Свойство("СчетКонтрагента") Тогда
		Результат.ВладелецСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Решения.СчетКонтрагента, "Владелец");
	КонецЕсли;
	Если Решения.Свойство("Договор") Тогда
		Результат.ВладелецДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Решения.Договор, "Владелец");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьОтказРешений(Результат, ПорядковыйНомер, Текст)

	Результат.Отказы.Добавить(Новый Структура("ПорядковыйНомер, Текст", ПорядковыйНомер, Текст));

КонецПроцедуры

// Решение "Перезаписать" (D5, задача 6): отметка строки со знайденным документом к перезаписи и ее снятие.
//
// Отметка: строка распознается КАК НОВАЯ тем же набором шагов, что и Распознать (ПрогнатьШагиРаспознавания; шаг 0 только держит документ -
// см. ШагЗагруженныйДокумент). Колонки решений перед этим сбрасываются до фактов банка и документа (ЗагруженныйДокумент, ВерсияДокумента),
// замечания - до замечаний шага 0 (поле ЗагруженныйДокумент). Документ не перечитывается ради значений: вид, контрагент и договор берет
// распознавание, а не документ ("заполняется заново", D5). Снятие: строка возвращается в состояние шага 0 - вид, контрагент и договор из
// документа ПО СОСТОЯНИЮ НА МОМЕНТ СНЯТИЯ, версия документа остается прежней (версия распознавания, ее сверяет запись).
// Работает над рабочей копией строк: исключение посередине план не портит.
Функция ПрименитьРешениеПерезаписать(План, Ключи, Перезаписать, Контекст)

	Результат = Новый Структура("Применено, Отказы", Новый Массив, Новый Массив);

	// Документы строк: один запрос на вызов.
	Ссылки = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Для Каждого СтрокаПлана Из План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", Ключ)) Цикл
			Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
				Ссылки.Добавить(СтрокаПлана.ЗагруженныйДокумент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ДанныеДокументов = ДанныеДокументовСтрок(Ссылки);
	Сохраняемые = ИменаКолонокДоРешений();

	Рабочий = НовыйПланЗагрузки();
	Пары = Новый Массив;
	Просмотренные = Новый Соответствие;
	Для Каждого Ключ Из Ключи Цикл
		Если Просмотренные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Просмотренные.Вставить(Ключ, Истина);

		НайденныеСтроки = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", Ключ));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ДобавитьОтказРешений(Результат, Ключ, СтрШаблон(НСтр("ru = 'Строка № %1 не найдена в плане загрузки.';
				|uk = 'Рядок № %1 не знайдено в плані завантаження.'"), Формат(Ключ, "ЧГ=0")));
			Продолжить;
		КонецЕсли;
		Исходная = НайденныеСтроки[0];

		Если ПустаяСтрока(Исходная.ВидДокумента) Тогда
			ДобавитьОтказРешений(Результат, Ключ, НСтр("ru = 'Строка не записывается (не определён вид документа): решения к ней не применяются.';
				|uk = 'Рядок не записується (не визначено вид документа): рішення до нього не застосовуються.'"));
			Продолжить;
		КонецЕсли;
		// Уже в нужном состоянии: повторный вызов не должен сбросить правки человека, сделанные после отметки.
		Если Исходная.Перезаписать = Перезаписать Тогда
			Результат.Применено.Добавить(Ключ);
			Продолжить;
		КонецЕсли;

		ДанныеДокумента = Неопределено;
		Если ЗначениеЗаполнено(Исходная.ЗагруженныйДокумент) Тогда
			ДанныеДокумента = ДанныеДокументов.Получить(Исходная.ЗагруженныйДокумент);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Исходная.ЗагруженныйДокумент) Тогда
			ДобавитьОтказРешений(Результат, Ключ, НСтр("ru = 'У строки нет найденного документа: перезаписывать нечего.';
				|uk = 'У рядка немає знайденого документа: перезаписувати нічого.'"));
			Продолжить;
		ИначеЕсли ДанныеДокумента = Неопределено Тогда
			ДобавитьОтказРешений(Результат, Ключ, НСтр("ru = 'Документ строки не найден в базе (удален?). Прочитайте файл заново.';
				|uk = 'Документ рядка не знайдено в базі (видалено?). Прочитайте файл знову.'"));
			Продолжить;
		ИначеЕсли Перезаписать И ДанныеДокумента.ПометкаУдаления Тогда
			// Помеченный на удаление не перезаписывается и пометка не снимается (D5): человек сам снимает ее в документе.
			ДобавитьОтказРешений(Результат, Ключ, НСтр("ru = 'Документ строки помечен на удаление: перезапись невозможна. Снимите пометку на удаление в самом документе.';
				|uk = 'Документ рядка позначений на видалення: перезапис неможливий. Зніміть позначку на видалення в самому документі.'"));
			Продолжить;
		КонецЕсли;

		Копия = Рабочий.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(Копия, Исходная);
		Для Каждого Колонка Из Рабочий.Операции.Колонки Цикл
			Если Сохраняемые.Получить(Колонка.Имя) = Неопределено Тогда
				Копия[Колонка.Имя] = Колонка.ТипЗначения.ПривестиЗначение(Неопределено);
			КонецЕсли;
		КонецЦикла;
		Копия.Перезаписать = Перезаписать;
		Для Каждого Замечание Из План.Замечания.НайтиСтроки(Новый Структура("ПорядковыйНомер, Поле", Ключ, "ЗагруженныйДокумент")) Цикл
			ЗаполнитьЗначенияСвойств(Рабочий.Замечания.Добавить(), Замечание);
		КонецЦикла;
		Пары.Добавить(Новый Структура("Исходная, Копия, Данные", Исходная, Копия, ДанныеДокумента));
	КонецЦикла;

	Если Пары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если Перезаписать Тогда
		ПрогнатьШагиРаспознавания(Рабочий, Контекст);
	Иначе
		Для Каждого Пара Из Пары Цикл
			ПрименитьЗагруженныйДокумент(Пара.Копия, Пара.Данные);
			Пара.Копия.ВерсияДокумента = Пара.Исходная.ВерсияДокумента;
		КонецЦикла;
	КонецЕсли;

	ПеренестиРабочийПланВПлан(План, Рабочий, Пары, Результат);

	Возврат Результат;

КонецФункции

// Колонки, которые отметка и снятие перезаписи НЕ сбрасывают: факты банка (колонки конверта), организация и счет, вид документа, документ строки и
// его версия, сама отметка. Остальное - решения распознавания.
//
// Возвращаемое значение:
//  Соответствие - имя колонки -> Истина.
Функция ИменаКолонокДоРешений()

	Имена = Новый Соответствие;
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		Имена.Вставить(Колонка.Имя, Истина);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Организация,БанковскийСчет,ВидДокумента,ЗагруженныйДокумент,ВерсияДокумента,Перезаписать", ",") Цикл
		Имена.Вставить(Имя, Истина);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Документы по ссылкам одним запросом: пометка на удаление и то, что берет шаг 0 (ПрименитьЗагруженныйДокумент). Не найденный в базе документ
// в результат не попадает.
//
// Возвращаемое значение:
//  Соответствие - ссылка -> Структура: Ссылка, ПометкаУдаления, ВидОперации, Контрагент, Договор, ВерсияДанных.
Функция ДанныеДокументовСтрок(Ссылки) Экспорт

	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Шаблон =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.ВидОперации КАК ВидОперации,
		|	Т.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(Расшифровка.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
		|	Т.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	Документ.%1 КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.%1.РасшифровкаПлатежа КАК Расшифровка
		|		ПО Расшифровка.Ссылка = Т.Ссылка
		|			И Расшифровка.НомерСтроки = 1
		|ГДЕ
		|	Т.Ссылка В (&Ссылки)";
	Запрос = Новый Запрос(СтрШаблон(Шаблон, "ПоступлениеНаСчет") + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + СтрШаблон(Шаблон, "РасходСоСчета"));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура("Ссылка, ПометкаУдаления, ВидОперации, Контрагент, Договор, ВерсияДанных");
		ЗаполнитьЗначенияСвойств(Данные, Выборка);
		Результат.Вставить(Выборка.Ссылка, Данные);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст отказа применить решения к строке или пустая строка, если можно. Проверяется строка плана ДО копирования в рабочий план.
Функция ТекстОтказаРешенийДляСтроки(СтрокаПлана, Решения, ВладельцыОбъектов)

	Если ПустаяСтрока(СтрокаПлана.ВидДокумента) Тогда
		Возврат НСтр("ru = 'Строка не записывается (не определён вид документа): решения к ней не применяются.';
			|uk = 'Рядок не записується (не визначено вид документа): рішення до нього не застосовуються.'");
	КонецЕсли;
	// Строка с найденным документом: решения не применятся при записи (платформа его не меняет). Исключение - строка, отмеченная к
	// перезаписи (Перезаписать = Истина, D5): она распознана как новая, ее решения применяются как у любой новой строки.
	Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) И Не СтрокаПлана.Перезаписать Тогда
		Возврат НСтр("ru = 'По строке найден загруженный документ: решения человека к ней не применяются.';
			|uk = 'За рядком знайдено завантажений документ: рішення людини до нього не застосовуються.'");
	КонецЕсли;

	Вид = СтрокаПлана.ВидОперации;
	Если Решения.Свойство("ВидОперации") Тогда
		Вид = Решения.ВидОперации;
		ТипВида = ?(СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет(),
			Тип("ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет"), Тип("ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
		Если ТипЗнч(Вид) <> ТипВида Тогда
			Возврат СтрШаблон(НСтр("ru = 'Вид операции ""%1"" не подходит к направлению строки (вид документа ""%2"").';
				|uk = 'Вид операції ""%1"" не підходить до напрямку рядка (вид документа ""%2"").'"), Вид, СтрокаПлана.ВидДокумента);
		КонецЕсли;
	КонецЕсли;

	// Способ зачета "Авто" допустим только для видов взаиморасчетов: РасчетыПроведениеДокументов.ЭтоВидОперацииВзаиморасчетов (вендор, те же
	// четыре вида банка, что в правиле D34; в остальных видах форма вендора колонку способа прячет и ставит "Вручную"). Вид берется ПОСЛЕ
	// решений: вид поза четверкой и "Авто" в одном вызове - отказ строки, а не молчаливая победа одного из решений.
	Если Решения.Свойство("СпособЗачета") И Решения.СпособЗачета = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто Тогда
		// "Авто" со строкой платежного поручения допустимо: при записи вендор нормализует расшифровку (измерено зондом задачи 4г).
		Если Не РасчетыПроведениеДокументов.ЭтоВидОперацииВзаиморасчетов(Вид) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Для вида операции ""%1"" способ зачета ""Авто"" не применяется (автоматический зачет только в расчетах с покупателем, поставщиком и нашей организацией): способ зачета к строке не применяется.';
				|uk = 'Для виду операції ""%1"" спосіб заліку ""Авто"" не застосовується (автоматичний залік лише в розрахунках з покупцем, постачальником і нашою організацією): спосіб заліку до рядка не застосовується.'"), Вид);
		КонецЕсли;
	КонецЕсли;

	Если Решения.Свойство("НеСоздаватьКонтрагента") И Решения.НеСоздаватьКонтрагента Тогда
		Если Не ВидОперацииТребуетКонтрагента(Вид) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Виду операции ""%1"" контрагент не нужен: решение ""не создавать"" к строке не применяется.';
				|uk = 'Виду операції ""%1"" контрагент не потрібен: рішення ""не створювати"" до рядка не застосовується.'"), Вид);
		КонецЕсли;
		Если Не Решения.Свойство("ВидОперации") И СтрокаПлана.ДействиеКонтрагент = ДействиеНайден() Тогда
			Возврат НСтр("ru = 'Контрагент строки найден в базе: создавать нечего, решение ""не создавать"" к строке не применяется.';
				|uk = 'Контрагента рядка знайдено в базі: створювати нічого, рішення ""не створювати"" до рядка не застосовується.'");
		КонецЕсли;
	КонецЕсли;

	// Контрагент строки после решений: выбранный; владелец выбранного счёта, если у строки контрагента нет; иначе прежний.
	Контрагент = СтрокаПлана.Контрагент;
	Если Решения.Свойство("Контрагент") Тогда
		Контрагент = Решения.Контрагент;
		Если Не ВидОперацииТребуетКонтрагента(Вид) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Виду операции ""%1"" контрагент не нужен: выбор контрагента к строке не применяется.';
				|uk = 'Виду операції ""%1"" контрагент не потрібен: вибір контрагента до рядка не застосовується.'"), Вид);
		КонецЕсли;
	ИначеЕсли Решения.Свойство("СчетКонтрагента") И Не ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = ВладельцыОбъектов.ВладелецСчета;
	КонецЕсли;

	Если Решения.Свойство("СчетКонтрагента") Тогда
		ВладелецСчета = ВладельцыОбъектов.ВладелецСчета;
		Если ТипЗнч(ВладелецСчета) <> Тип("СправочникСсылка.Контрагенты")
			Или (ЗначениеЗаполнено(Контрагент) И Контрагент <> ВладелецСчета) Тогда
			Возврат НСтр("ru = 'Банковский счёт принадлежит не контрагенту строки: счёт к строке не применяется.';
				|uk = 'Банківський рахунок належить не контрагенту рядка: рахунок до рядка не застосовується.'");
		КонецЕсли;
	КонецЕсли;

	Если Решения.Свойство("Договор") Тогда
		Если Не ВидОперацииТребуетДоговор(Вид) Тогда
			Возврат СтрШаблон(НСтр("ru = 'Виду операции ""%1"" договор не нужен: выбор договора к строке не применяется.';
				|uk = 'Виду операції ""%1"" договір не потрібен: вибір договору до рядка не застосовується.'"), Вид);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Контрагент) Или Контрагент <> ВладельцыОбъектов.ВладелецДоговора Тогда
			Возврат НСтр("ru = 'Договор принадлежит не контрагенту строки: договор к строке не применяется.';
				|uk = 'Договір належить не контрагенту рядка: договір до рядка не застосовується.'");
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Решения к одной строке рабочего плана в порядке зависимостей: вид -> контрагент -> счёт -> договор -> статья -> корреспонденция -> налог -> способ зачета.
// Вид, контрагент и договор сначала очищают зависимое, статья и корреспонденция человека ставятся последними и потому побеждают.
// "Не создавать" только запоминается в Накопитель и ставится после пересчёта (ПрименитьНеСоздавать): до него действие над создаваемым
// контрагентом неизвестно.
//
// Параметры:
//  Накопитель - Структура - строки, которые обрабатывает вызывающий после шагов: СтрокиПоискаСчета (Массив), СтрокиНеСоздавать
//    (Массив из Структура Строка, Явное), СтрокиСменыВида (Массив), СтрокиОснования (Массив: основа очищена, ищется заново),
//    СтрокиВидаОтОсновы (Массив: вид от основы или по умолчанию снят и определяется заново шагами Распознать).
Процедура ПрименитьРешенияКСтроке(Рабочий, СтрокаПлана, Решения, ВладельцыОбъектов, Накопитель)

	// Прежнее "не создавать" живёт только в действиях строки. Его снимаем до пересчёта, чтобы шаги определили контрагента, счёт и договор
	// заново (найдут, если контрагент появился); если решение остаётся в силе, ПрименитьНеСоздавать поставит его снова.
	БылоНеСоздавать = СтрокаПлана.ДействиеКонтрагент = ДействиеНеСоздавать();
	Если БылоНеСоздавать Тогда
		СброситьКонтрагентаСтроки(Рабочий, СтрокаПлана);
		СброситьДоговорСтроки(Рабочий, СтрокаПлана);
	КонецЕсли;

	Если Решения.Свойство("ВидОперации") Тогда
		Если ПрименитьРешениеВидОперации(Рабочий, СтрокаПлана, Решения.ВидОперации) Тогда
			Накопитель.СтрокиСменыВида.Добавить(СтрокаПлана);
			Накопитель.СтрокиОснования.Добавить(СтрокаПлана);
		КонецЕсли;
		// Вид поза четверкой взаиморасчетов (ЭтоВидОперацииВзаиморасчетов): форма вендора колонку способа прячет и ставит "Вручную", выбор человека
		// теряет смысл и снимается - способ посчитает запись по правилу D34 (строка 1). Смена контрагента способ человека не снимает.
		Если Не РасчетыПроведениеДокументов.ЭтоВидОперацииВзаиморасчетов(Решения.ВидОперации) Тогда
			СтрокаПлана.СпособЗачета = Перечисления.СпособыЗачетаИРаспределенияПлатежей.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;

	ЕстьСчет = Решения.Свойство("СчетКонтрагента");
	Контрагент = Неопределено;
	Если Решения.Свойство("Контрагент") Тогда
		Контрагент = Решения.Контрагент;
	ИначеЕсли ЕстьСчет И Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Контрагент = ВладельцыОбъектов.ВладелецСчета;
	КонецЕсли;
	Если Контрагент <> Неопределено Тогда
		Если ПрименитьРешениеКонтрагент(Рабочий, СтрокаПлана, Контрагент) Тогда
			// Основа - находка для пары "контрагент + вид" (D4): с другим контрагентом прежняя основа неверна, ищется заново.
			СброситьОсновуСтроки(Рабочий, СтрокаПлана);
			Если Накопитель.СтрокиОснования.Найти(СтрокаПлана) = Неопределено Тогда
				Накопитель.СтрокиОснования.Добавить(СтрокаПлана);
			КонецЕсли;
			// Вид, который давала основа (пропала вместе с ней) или значение по умолчанию (основы не было, а с новым контрагентом она могла
			// найтись), определяется заново. Остальные источники от контрагента не зависят (правила назначения читают только текст и
			// направление) или принадлежат человеку и остаются.
			Если СтрокаПлана.ИсточникВидаОперации = ИсточникДокументПоНомеру() Или СтрокаПлана.ИсточникВидаОперации = ИсточникПоУмолчанию() Тогда
				СброситьВидСтрокиДляПересчета(СтрокаПлана, Накопитель);
			КонецЕсли;
			Если Не ЕстьСчет Тогда
				Накопитель.СтрокиПоискаСчета.Добавить(СтрокаПлана);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Явное "не создавать" (Истина) или прежнее, не отменённое выбором контрагента или счёта и не снятое явным Ложь.
	Если Решения.Свойство("НеСоздаватьКонтрагента") Тогда
		НеСоздавать = Решения.НеСоздаватьКонтрагента;
		Явное = НеСоздавать;
	Иначе
		НеСоздавать = БылоНеСоздавать И Контрагент = Неопределено И Не ЕстьСчет;
		Явное = Ложь;
	КонецЕсли;
	Если НеСоздавать Тогда
		Накопитель.СтрокиНеСоздавать.Добавить(Новый Структура("Строка, Явное", СтрокаПлана, Явное));
	КонецЕсли;

	Если ЕстьСчет Тогда
		СтрокаПлана.СчетКонтрагента = Решения.СчетКонтрагента;
		СтрокаПлана.ДействиеСчет = ДействиеНайден();
		УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("СчетКонтрагента", ","));
	КонецЕсли;

	Если Решения.Свойство("Договор") Тогда
		УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("Договор", ","));
		СтрокаПлана.Договор = Решения.Договор;
		СтрокаПлана.ДействиеДоговор = ДействиеНайден();
		СброситьСтатьюЦепочки(СтрокаПлана);
	КонецЕсли;

	Если Решения.Свойство("СтатьяДДС") Тогда
		СтрокаПлана.СтатьяДДС = Решения.СтатьяДДС;
		СтрокаПлана.ИсточникСтатьи = ?(ЗначениеЗаполнено(Решения.СтатьяДДС), ИсточникСтатьиЧеловек(), "");
	КонецЕсли;

	Если Решения.Свойство("Корреспонденция") Тогда
		СтрокаПлана.Корреспонденция = Решения.Корреспонденция;
		СтрокаПлана.ИсточникКорреспонденции = ?(ЗначениеЗаполнено(Решения.Корреспонденция), ИсточникКорреспонденцииЧеловек(), "");
		// Замечание о снятой при смене вида корреспонденции относилось к прежнему значению.
		УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("Корреспонденция", ","));
	КонецЕсли;

	Если Решения.Свойство("ВидНалога") Тогда
		СтрокаПлана.ВидНалога = Решения.ВидНалога;
		// Вид налога, выбранный человеком, снимает «Ошибку» правила без вида налога (ради этого поле и редактируется).
		Если ЗначениеЗаполнено(Решения.ВидНалога) Тогда
			УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("ВидНалога", ","));
		КонецЕсли;
	КонецЕсли;

	// Способ зачета - последним, после вида (вид поза четверкой выше снял бы его; "Авто" с таким видом отказом строки досюда не доходит).
	// Пустое значение возвращает "по правилу D34". Будущее решение "выбрать основу" (задача 4б / 4в) поставит здесь же "Вручную" по правилу
	// формы вендора: Documents/ПоступлениеНаСчет/Forms/ФормаДокумента/Ext/Form/Module.bsl :3188-3196 (документ заполнен - "Вручную").
	Если Решения.Свойство("СпособЗачета") Тогда
		СтрокаПлана.СпособЗачета = Решения.СпособЗачета;
		Если Решения.СпособЗачета = Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто Тогда
			// ВОСПРОИЗВЕДЕНИЕ, а не вызов: клиентская процедура вендора РасчетыРаботаСФормамиКлиент.РасшифровкаПлатежаСпособЗачетаПриИзменении
			// (CommonModules/РасчетыРаботаСФормамиКлиент/Ext/Module.bsl :575-591, тело :577-588) при "Авто" очищает Документ, Заказ и СчетНаОплату
			// строки расшифровки. Модуль клиентский (Server=false) - с сервера его не вызвать. В плане основа одна, ДокументПоНомеру: снимается
			// вместе с замечаниями этого поля. ПризнакАванса = Истина, который то же тело ставит, в плане не ведется (колонки нет): при записи его
			// нормализует вендор (РасчетыПроведениеДокументов.ОбработатьРасшифровкуПлатежаПередЗаписью, :341-372). Поиск основы после решений
			// такую строку пропускает (ПоискДокументовПоНомеру).
			СброситьОсновуСтроки(Рабочий, СтрокаПлана);
			// Вид, который давала снятая основа, - "знахидка, что исчезла": определяется заново теми же шагами (СтрокиВидаОтОсновы в
			// ПрименитьРешенияЧеловека), как при смене контрагента. Основа при этом не найдется: поиск пропускает строки с "Авто". Вид человека
			// (источник "Человек") не трогается. Если новый вид окажется вне четверки взаиморасчетов, "Авто" снимается с предупреждением.
			Если СтрокаПлана.ИсточникВидаОперации = ИсточникДокументПоНомеру() Тогда
				СброситьВидСтрокиДляПересчета(СтрокаПлана, Накопитель);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Банк нового счета: просто запоминается, от остальных решений не зависит (используется записью только при создании счета).
	Если Решения.Свойство("БанкНовогоСчета") Тогда
		СтрокаПлана.БанкНовогоСчета = Решения.БанкНовогоСчета;
	КонецЕсли;

КонецПроцедуры

// Вид строки снимается и ставится в очередь на определение заново шагами Распознать (правила назначения -> документ по номеру -> значение
// по умолчанию); "Проверьте операцию" ставит только значение по умолчанию и только тем, кому оно дало вид.
Процедура СброситьВидСтрокиДляПересчета(СтрокаПлана, Накопитель)

	СтрокаПлана.ВидОперации = ?(СтрокаПлана.ВидДокумента = ВидДокументаПоступлениеНаСчет(),
		Перечисления.ВидыОперацийПоступлениеНаСчет.ПустаяСсылка(), Перечисления.ВидыОперацийРасходСоСчета.ПустаяСсылка());
	СтрокаПлана.ИсточникВидаОперации = "";
	СтрокаПлана.ПроверьтеОперацию = Ложь;
	ДобавитьУникальное(Накопитель.СтрокиВидаОтОсновы, СтрокаПлана);

КонецПроцедуры

// Возвращает Истина, если вид изменился.
Функция ПрименитьРешениеВидОперации(Рабочий, СтрокаПлана, Вид)

	Изменён = Вид <> СтрокаПлана.ВидОперации;
	Если Изменён Тогда
		ИсточникВида = СтрокаПлана.ИсточникВидаОперации;
		ЭтоНалоги = ВидОперацииИмеетВидНалога(Вид);

		// Правило назначения дало прежний вид. Вид теперь выбрал человек, правило снимается вместе со всем, что оно дало (D25, шаг 4: вид,
		// статья, корреспонденция, вид налога, проект, подразделение): вердикт правила неделим, иначе у статьи остался бы источник
		// "правило" при пустой колонке правила. Вид налога вне правила остаётся, если вид снова "Налоги"; для другого вида он бессмыслен.
		ЕстьПравило = ЗначениеЗаполнено(СтрокаПлана.ПравилоНазначения);
		Если ЕстьПравило Тогда
			СброситьВыводПравилаНазначения(СтрокаПлана);
		ИначеЕсли Не ЭтоНалоги Тогда
			СтрокаПлана.ВидНалога = Справочники.ВидыНалогов.ПустаяСсылка();
		КонецЕсли;
		// Замечание о виде налога относится к правилу вида «Налоги»: при другом виде или снятом правиле оно ложное.
		Если ЕстьПравило Или Не ЭтоНалоги Тогда
			УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("ВидНалога", ","));
		КонецЕсли;

		ПересмотретьКорреспонденциюПриСменеВида(Рабочий, СтрокаПлана, Вид);

		// Контрагент, определённый прежним видом (свой счёт, другая организация, сотрудник), и действия над отсутствующим контрагентом
		// (создать, невозможно, не требуется) относились к прежнему виду: контрагент и счёт ищутся заново шагом поиска.
		Если ИсточникВида = ИсточникСвойСчет() Или ИсточникВида = ИсточникНашаОрганизация() Или ИсточникВида = ИсточникСотрудник()
			Или Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
			СброситьКонтрагентаСтроки(Рабочий, СтрокаПлана);
		КонецЕсли;
		СброситьДоговорСтроки(Рабочий, СтрокаПлана);
		СброситьСтатьюЦепочки(СтрокаПлана);

		// Основа по номеру относилась к прежнему виду: очищается, поиск для нового вида - в ПрименитьРешенияЧеловека (после шага контрагента).
		СброситьОсновуСтроки(Рабочий, СтрокаПлана);
	КонецЕсли;

	СтрокаПлана.ВидОперации = Вид;
	СтрокаПлана.ИсточникВидаОперации = ИсточникЧеловек();
	// Вид выбрал человек - значение "по умолчанию" ему больше не нужно проверять (D24).
	СтрокаПлана.ПроверьтеОперацию = Ложь;
	Возврат Изменён;

КонецФункции

// Основа (ДокументПоНомеру) и замечания этого поля очищаются; поиск заново - ПоискДокументовПоНомеру из ПрименитьРешенияЧеловека.
Процедура СброситьОсновуСтроки(Рабочий, СтрокаПлана)

	СтрокаПлана.ДокументПоНомеру = Неопределено;
	УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("ДокументПоНомеру", ","));

КонецПроцедуры

// Результат правила назначения снимается целиком (см. ПрименитьРешениеВидОперации). Статья и корреспонденция - только с источником
// "правило": статья и корреспонденция человека и поручения остаются.
Процедура СброситьВыводПравилаНазначения(СтрокаПлана)

	СтрокаПлана.ПравилоНазначения = Справочники.СоответствияНазначенийПлатежаИРеквизитовПлатежа.ПустаяСсылка();
	Если СтрокаПлана.ИсточникСтатьи = ИсточникСтатьиПравилоНазначения() Тогда
		СтрокаПлана.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
		СтрокаПлана.ИсточникСтатьи = "";
	КонецЕсли;
	Если СтрокаПлана.ИсточникКорреспонденции = ИсточникКорреспонденцииПравилоНазначения() Тогда
		СтрокаПлана.Корреспонденция = ПланыСчетов.Управленческий.ПустаяСсылка();
		СтрокаПлана.ИсточникКорреспонденции = "";
	КонецЕсли;
	СтрокаПлана.ВидНалога = Справочники.ВидыНалогов.ПустаяСсылка();
	СтрокаПлана.Проект = Справочники.Проекты.ПустаяСсылка();
	СтрокаПлана.Подразделение = Справочники.СтруктурныеЕдиницы.ПустаяСсылка();

КонецПроцедуры

// Корреспонденция при смене вида (источник - ИсточникКорреспонденции): выведенная из вида очищается и считается заново (ЗаполнитьКорреспонденцию);
// человеческая остаётся, если у нового вида корреспонденция есть, иначе снимается с "Предупреждением"; корреспонденция поручения остаётся
// (поручение остаётся); корреспонденция правила снята вместе с правилом (СброситьВыводПравилаНазначения). Корреспонденция без источника
// (в плане, собранном не распознаванием) не трогается.
Процедура ПересмотретьКорреспонденциюПриСменеВида(Рабочий, СтрокаПлана, Вид)

	УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("Корреспонденция", ","));
	Источник = СтрокаПлана.ИсточникКорреспонденции;
	Если Источник = ИсточникКорреспонденцииПоВидуОперации() Тогда
		СтрокаПлана.Корреспонденция = ПланыСчетов.Управленческий.ПустаяСсылка();
		СтрокаПлана.ИсточникКорреспонденции = "";
	ИначеЕсли Источник = ИсточникКорреспонденцииЧеловек() И Не ВидОперацииИмеетКорреспонденцию(Вид) Тогда
		Снятая = СтрокаПлана.Корреспонденция;
		СтрокаПлана.Корреспонденция = ПланыСчетов.Управленческий.ПустаяСсылка();
		СтрокаПлана.ИсточникКорреспонденции = "";
		ДобавитьЗамечание(Рабочий, СтрокаПлана.ПорядковыйНомер, "Корреспонденция", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Вид операции изменён: у вида ""%1"" корреспонденции нет, выбранная человеком корреспонденция ""%2"" снята.';
				|uk = 'Вид операції змінено: у виду ""%1"" кореспонденції немає, обрану людиною кореспонденцію ""%2"" знято.'"), Вид, Снятая));
	КонецЕсли;

КонецПроцедуры

// Строки, для которых после смены вида или контрагента ищется основа: вид допускает основу (ВидОперацииДопускаетОснову, тот же предикат, что у шага 5).
Функция СтрокиДляПоискаОснования(СтрокиОснования)

	Строки = Новый Массив;
	Для Каждого СтрокаПлана Из СтрокиОснования Цикл
		Если ВидОперацииДопускаетОснову(СтрокаПлана.ВидОперации) Тогда
			Строки.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;

КонецФункции

// "Не создавать" (см. ПрименитьРешенияЧеловека, НеСоздаватьКонтрагента): после пересчёта то, что запись создала бы ("Создать"), получает
// действие "НеСоздавать"; замечание одно, на поле "Контрагент". Уровень по последствию, а не по вине: нужен ли виду операции хоть один
// из отменённых объектов (контрагент, договор; счёт виду не нужен) - "Ошибка" (документ не будет проведён), иначе "Предупреждение".
Процедура ПрименитьНеСоздавать(Рабочий, Записи)

	Для Каждого Запись Из Записи Цикл
		СтрокаПлана = Запись.Строка;
		Если СтрокаПлана.ДействиеКонтрагент <> ДействиеСоздать() Тогда
			// Прежнее решение, которому больше нечего отменять (контрагент найден или вид его не требует), молча теряет силу; явное - нет.
			Если Запись.Явное Тогда
				ДобавитьЗамечание(Рабочий, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
					НСтр("ru = 'Решение ""не создавать"" не применено: контрагента строки не нужно создавать (он найден, не нужен виду операции или создать его нельзя).';
						|uk = 'Рішення ""не створювати"" не застосовано: контрагента рядка не потрібно створювати (його знайдено, не потрібен виду операції або створити його неможливо).'"));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Нужен = ВидОперацииТребуетКонтрагента(СтрокаПлана.ВидОперации);
		СтрокаПлана.ДействиеКонтрагент = ДействиеНеСоздавать();
		Если СтрокаПлана.ДействиеСчет = ДействиеСоздать() Тогда
			СтрокаПлана.ДействиеСчет = ДействиеНеСоздавать();
		КонецЕсли;
		Если СтрокаПлана.ДействиеДоговор = ДействиеСоздать() Тогда
			СтрокаПлана.ДействиеДоговор = ДействиеНеСоздавать();
			Нужен = Нужен Или ВидОперацииТребуетДоговор(СтрокаПлана.ВидОперации);
		КонецЕсли;

		Если Нужен Тогда
			ДобавитьЗамечание(Рабочий, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньОшибка(),
				НСтр("ru = 'Не создано по решению человека (контрагент, его счёт и договор); документ не будет проведён.';
					|uk = 'Не створено за рішенням людини (контрагент, його рахунок і договір); документ не буде проведено.'"));
		Иначе
			ДобавитьЗамечание(Рабочий, СтрокаПлана.ПорядковыйНомер, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Не создано по решению человека (контрагент, его счёт и договор).';
					|uk = 'Не створено за рішенням людини (контрагент, його рахунок і договір).'"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция НачалоЗамечанияВидаИПоручения()

	Возврат НСтр("ru = 'Вид операции выбран человеком';uk = 'Вид операції обрано людиною'");

КонецФункции

// Платёжное поручение остаётся при смене вида (факт сопоставления с документом базы). Если вид человека расходится с видом, который дало бы
// поручение (ВидСписанияПоВидуПоручения; вид вне таблицы - "Поставщику", как в ПрименитьПоручение), на строке "Предупреждение"; запись дальше
// обращается с основой по своим правилам. Предыдущее такое предупреждение заменяется (без дублей). Вид поручения читается одним запросом.
Процедура ПредупредитьОВидеИПоручении(Рабочий, СтрокиСменыВида)

	Поручения = Новый Массив;
	Начало = НачалоЗамечанияВидаИПоручения();
	Для Каждого СтрокаПлана Из СтрокиСменыВида Цикл
		Индекс = Рабочий.Замечания.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Замечание = Рабочий.Замечания[Индекс];
			Если Замечание.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер И Замечание.Поле = "ПлатежноеПоручение"
				И СтрНачинаетсяС(Замечание.Текст, Начало) Тогда
				Рабочий.Замечания.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Если ЗначениеЗаполнено(СтрокаПлана.ПлатежноеПоручение) Тогда
			ДобавитьУникальное(Поручения, СтрокаПлана.ПлатежноеПоручение);
		КонецЕсли;
	КонецЦикла;
	Если Поручения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВидыПоручений = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Поручения, "ВидОперации");
	Для Каждого СтрокаПлана Из СтрокиСменыВида Цикл
		Если Не ЗначениеЗаполнено(СтрокаПлана.ПлатежноеПоручение) Тогда
			Продолжить;
		КонецЕсли;
		Данные = ВидыПоручений.Получить(СтрокаПлана.ПлатежноеПоручение);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ожидаемый = ВидСписанияПоВидуПоручения(Данные.ВидОперации);
		Если Ожидаемый = Неопределено Тогда
			Ожидаемый = Перечисления.ВидыОперацийРасходСоСчета.Поставщику;
		КонецЕсли;
		Если Ожидаемый <> СтрокаПлана.ВидОперации Тогда
			ДобавитьЗамечание(Рабочий, СтрокаПлана.ПорядковыйНомер, "ПлатежноеПоручение", СМП_ВыпискаБанка.УровеньПредупреждение(),
				Начало + СтрШаблон(НСтр("ru = ' (""%1""), а по платёжному поручению %2 он был бы ""%3"". Поручение остаётся основой документа.';
					|uk = ' (""%1""), а за платіжним дорученням %2 він був би ""%3"". Доручення залишається основою документа.'"),
					СтрокаПлана.ВидОперации, СтрокаПлана.ПлатежноеПоручение, Ожидаемый));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает Истина, если контрагент строки изменился (нужно найти его счёт и пересчитать зависимое).
Функция ПрименитьРешениеКонтрагент(Рабочий, СтрокаПлана, Контрагент)

	Если СтрокаПлана.Контрагент = Контрагент И СтрокаПлана.ДействиеКонтрагент = ДействиеНайден() Тогда
		Возврат Ложь;
	КонецЕсли;

	СброситьКонтрагентаСтроки(Рабочий, СтрокаПлана);
	СтрокаПлана.Контрагент = Контрагент;
	СтрокаПлана.ДействиеКонтрагент = ДействиеНайден();
	СброситьДоговорСтроки(Рабочий, СтрокаПлана);
	СброситьСтатьюЦепочки(СтрокаПлана);
	Возврат Истина;

КонецФункции

// Договор и действие над ним очищаются вместе с замечаниями о договоре: ШагЗавершение выберет договор заново.
Процедура СброситьДоговорСтроки(Рабочий, СтрокаПлана)

	СтрокаПлана.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	СтрокаПлана.ДействиеДоговор = "";
	УдалитьЗамечанияСтроки(Рабочий, СтрокаПлана.ПорядковыйНомер, СтрРазделить("Договор", ","));

КонецПроцедуры

// Статья, выведенная цепочкой D14 (по виду, договору, контрагенту), очищается: ЗаполнитьСтатьиДДС посчитает её заново. Статья человека,
// поручения и правила остаётся.
Процедура СброситьСтатьюЦепочки(СтрокаПлана)

	Источник = СтрокаПлана.ИсточникСтатьи;
	Если ПустаяСтрока(Источник) Или Источник = ИсточникСтатьиПоВидуОперации() Или Источник = ИсточникСтатьиДоговор()
		Или Источник = ИсточникСтатьиКонтрагент() Тогда
		СтрокаПлана.СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
		СтрокаПлана.ИсточникСтатьи = "";
	КонецЕсли;

КонецПроцедуры

// Счёт выбранного человеком контрагента: среди счетов контрагента ищется счёт с номером из выписки (текущий предпочтительнее устаревшего);
// не найден - ДействиеСчет остаётся пустым, и ШагЗавершение решит "Создать" или "НеТребуется". Один запрос на все строки.
Процедура НайтиСчетаВыбранныхКонтрагентов(Строки)

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Номера = Новый Массив;
	Повторы = Новый Соответствие;
	Для Каждого СтрокаПлана Из Строки Цикл
		Варианты = Новый Массив;
		Варианты.Добавить(СМП_ВыпискаБанка.НормализованныйНомерСчета(СтрокаПлана.КонтрагентНомерСчета));
		Варианты.Добавить(ВРег(СокрЛП(СтрокаПлана.КонтрагентНомерСчета)));
		Для Каждого Вариант Из Варианты Цикл
			Если Не ПустаяСтрока(Вариант) И ОтметитьНовыйКлюч(Повторы, Вариант) Тогда
				Номера.Добавить(Вариант);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Счета = ПрочитатьСчетаКонтрагентов(Номера);

	Для Каждого СтрокаПлана Из Строки Цикл
		Номер = СМП_ВыпискаБанка.НормализованныйНомерСчета(СтрокаПлана.КонтрагентНомерСчета);
		Если ПустаяСтрока(Номер) Тогда
			Продолжить;
		КонецЕсли;
		Найденный = Неопределено;
		Для Каждого Счет Из Счета Цикл
			Если Счет.Владелец = СтрокаПлана.Контрагент И Счет.Номер = Номер Тогда
				Найденный = Счет;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найденный = Неопределено Тогда
			Для Каждого Счет Из Счета Цикл
				Если Счет.Владелец = СтрокаПлана.Контрагент И Счет.Устаревший = Номер Тогда
					Найденный = Счет;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Найденный <> Неопределено Тогда
			СтрокаПлана.СчетКонтрагента = Найденный.Ссылка;
			СтрокаПлана.ДействиеСчет = ДействиеНайден();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
