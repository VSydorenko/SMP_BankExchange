// Конектор API monobank для ФОП (api.monobank.ua, персональный токен): читатель по контракту D28 (план 05а, задача 5, D36).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только с типами платформы и с другими
// воротами (СМП_КоннекторыБанковОбщее, СМП_ЧтениеВыписокОбщее). Базу, метаданные, сеанс, локаль и серверные часы не читает; даты и числа
// форматирует явным форматом; сеть, паузу и момент чтения видит только через Параметры.Транспорт (ВыполнитьЗапрос, Пауза, ТекущийМомент).
// Исключений наружу не бросает: отказ банка классифицирует сам в Выписка.КлассОтказа (D36 п. 8), прочитанное до отказа остается в конверте.
//
// Что читает: идентификатор счета банка из client-info по IBAN (каждый раз, D36 п. 9; IBAN не найден - «ДействиеЧеловека»), затем выписку
// отрезками периода не длиннее 31 суток в секундах Unix, от нового к старым; каждый отрезок - страницами. Поведение предшественника
// (СМП_РаботаСБанкамиМонобанкAPIСервер) сохранено в полях ключа D17 и в наборе операций; отступы от него - только принятые планом 05а:
//  - hold не идет в Операции, а дает строку Предупреждение и сдвигает ГраницуДоверия (банковской границы остаточности у ФОП нет, D36 п. 10:
//    граница - КонецПериода, момент чтения или момент первой hold);
//  - назначение платежа не обрезается до 255 (длину проверяет платформа); состав (description, comment, комиссия, кешбэк) - как у
//    предшественника, отсутствующий comment не дает слова «Неопределено»;
//  - все даты - киевское время с явным поясом (D36 п. 7);
//  - границы запроса берутся с запасом в секунду (D36 п. 11, спеки 71b3771 и a90f7ea): запрос каждого отрезка идет от from отрезка минус секунда
//    до to плюс секунда, а для самого нового отрезка - до меньшего из КонецПериода плюс секунда и момента чтения; операции вне периода, но в
//    границах запроса, отбрасываются молча; граница доверия не позже момента чтения;
//  - технические: пауза между запросами выписки, повтор после 429 (только для выписки), предел паузы по заголовку банка (D36 п. 8) - количество
//    и состав операций они не меняют.
//
// Момент операции - time (completedTime у ФОП нет). День документа - день этого момента (как у предшественника, D17).
//
// Размер страницы в запросе выписки не задается: банк отдает не более 500 операций, считая от конца периода (документальная гипотеза, не
// измерено: журнал docs/superpowers/plans/2026-10-15-smb-import-platform-05a-runs.md, «Задача 5, до старту»); порядок «от новых к старым»
// измерен (run1, 31 из 31). Конец отрезка - страница КОРОЧЕ порога (D36 п. 11). Продолжение страницами - как у конектора юридических лиц (спека 4988aba): верхняя
// граница сдвигается на самую раннюю time страницы + 1 (банк не возвращает операцию с time = to, журнал 05а, 9e1eb08), повторы снимает
// дедупликация по id; страница полная и целиком в одной секунде - курсор застрял: «ДействиеЧеловека», чтение идет дальше. Правила
// продолжения - в одной функции, ВерхняяГраницаПродолжения. Включительность from и to у ФОП не измерена - поэтому соседние запросы
// отрезков перекрываются минимум на секунду.

// Исключение бросает единственное место модуля - шов ПрочитатьСРазмеромСтраницы при неверных параметрах шва (их задает только тест); Прочитать исключений не бросает.

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок, docs/architecture/reader-contract.md).
//
// Возвращаемое значение:
//  Структура - описание: читач API, идентификаторы операций есть (id банка), остатков нет.
Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_КоннекторБанкаМонобанк");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'monobank, ФОП (API)'; uk = 'monobank, ФОП (API)'"));
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "");
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает выписку в конверт платформы с рабочим порогом полной страницы.
//
// Параметры:
//  Данные - Неопределено - у конектора API данных-файла нет (D36 п. 2).
//  Параметры - Структура - параметры чтения (НомерСчета - IBAN, НачалоПериода, КонецПериода, УчетныеДанные.Токен, Транспорт).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РабочийПорогПолнойСтраницы());

КонецПроцедуры

// Читает выписку с заданным порогом полной страницы. Продукт всегда читает рабочим порогом (Прочитать); параметр нужен тесту:
// синтетика пагинации записана на модели банка с меньшей страницей. Шов для тестов: лишь меньше (или равно) рабочего порога,
// больший - исключение.
//
// Параметры:
//  Параметры - Структура - см. Прочитать.
//  Выписка - Структура - конверт платформы.
//  РазмерСтраницы - Число - порог полной страницы; от 1 до рабочего.
//  ПотолокСтраницШов - Число, Неопределено - предел страниц для теста (от 1 до рабочего предела); Неопределено - рабочий.
Процедура ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РазмерСтраницы, ПотолокСтраницШов = Неопределено) Экспорт

	Если ТипЗнч(РазмерСтраницы) <> Тип("Число") Или РазмерСтраницы < 1 Или РазмерСтраницы > РабочийПорогПолнойСтраницы() Тогда
		ВызватьИсключение НСтр("ru = 'Порог полной страницы должен быть от 1 до рабочего.'; uk = 'Поріг повної сторінки має бути від 1 до робочого.'");
	КонецЕсли;

	Если ПотолокСтраницШов <> Неопределено И (ТипЗнч(ПотолокСтраницШов) <> Тип("Число") Или ПотолокСтраницШов < 1 Или ПотолокСтраницШов > ПотолокСтраниц()) Тогда
		ВызватьИсключение НСтр("ru = 'Предел страниц должен быть от 1 до рабочего предела.'; uk = 'Межа сторінок має бути від 1 до робочої межі.'");
	КонецЕсли;

	Выписка.НачалоПериода = Параметры.НачалоПериода;
	Выписка.КонецПериода = Параметры.КонецПериода;

	Состояние = Новый Структура;
	Состояние.Вставить("Банк", НазваниеБанка());
	Состояние.Вставить("Страниц", 0);
	Состояние.Вставить("ПотолокСтраниц", ?(ПотолокСтраницШов = Неопределено, ПотолокСтраниц(), ПотолокСтраницШов));
	Состояние.Вставить("Транспорт", Параметры.Транспорт);
	Состояние.Вставить("УчетныеДанные", Параметры.УчетныеДанные);
	Состояние.Вставить("НомерСчета", Параметры.НомерСчета);
	Состояние.Вставить("ИдентификаторСчета", "");
	Состояние.Вставить("Записи", Новый Массив);
	Состояние.Вставить("Номер", 0);
	Состояние.Вставить("ПаузаПередЗапросом", 0);
	Состояние.Вставить("Остановка", Ложь);
	Состояние.Вставить("Отказ", Неопределено);
	Состояние.Вставить("МоментUnix", 0);
	Состояние.Вставить("Нижняя", 0);
	Состояние.Вставить("Верхняя", 0);
	Состояние.Вставить("ПериодС", 0);
	Состояние.Вставить("ПериодПо", 0);

	Если Состояние.Транспорт = Неопределено Или ТипЗнч(Состояние.УчетныеДанные) <> Тип("Структура")
		Или Не Состояние.УчетныеДанные.Свойство("Токен") Тогда
		СМП_КоннекторыБанковОбщее.Отказать(Состояние, "ДействиеЧеловека", НСтр("ru = 'Банк monobank ФОП: не переданы транспорт или токен.';
			|uk = 'Банк monobank ФОП: не передано транспорт або токен.'"), Истина);
	Иначе
		ПодготовитьОкно(Состояние, Параметры);
		Если Состояние.Отказ = Неопределено Тогда
			Если СМП_КоннекторыБанковОбщее.ЧтениеБудущегоПериода(Состояние, Параметры, Выписка) Тогда
				Возврат;
			КонецЕсли;
			ПрочитатьИдентификаторСчета(Состояние);
			Если Не Состояние.Остановка Тогда
				ПрочитатьОтрезки(Состояние, Параметры, РазмерСтраницы);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// Операции читаются и тогда, когда чтение оборвалось: прочитанное лежит в конверте.
	Неостаточные = Новый Массив;
	ОбработатьЗаписи(Состояние, Выписка, Неостаточные);

	// Банковской границы остаточности у ФОП нет: граница - КонецПериода, момент чтения или момент первой hold; не раньше НачалоПериода
	// (D36 п. 10, a90f7ea: не позже момента чтения).
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Параметры.КонецПериода);
	Кандидаты.Добавить(СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Состояние.МоментUnix));
	Для Каждого Момент Из Неостаточные Цикл
		Кандидаты.Добавить(Момент);
	КонецЦикла;
	СМП_КоннекторыБанковОбщее.ЗавершитьЧтение(Состояние, Параметры, Выписка, Кандидаты);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Окно первого запроса (D36 п. 11, спеки 71b3771 и a90f7ea): нижняя граница - НачалоПериода минус секунда (семантика from у банка
// не измерена); верхняя - меньшее из КонецПериода плюс секунда и момента чтения. Транспорт дает момент в UTC, а границы периода - киевское
// время: сравниваются в одной шкале, секундах Unix. Часы сервера не читаются. НачалоПериода и КонецПериода - включительные моменты.
Процедура ПодготовитьОкно(Состояние, Параметры)

	МоментЧтения = Состояние.Транспорт.ТекущийМомент();
	Если ТипЗнч(МоментЧтения) <> Тип("Дата") Или Не ЗначениеЗаполнено(МоментЧтения) Тогда
		СМП_КоннекторыБанковОбщее.Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
			НСтр("ru = 'Банк %1: транспорт не вернул момент чтения.'; uk = 'Банк %1: транспорт не повернув момент читання.'"), НазваниеБанка()), Истина);
		Возврат;
	КонецЕсли;

	Состояние.МоментUnix = МоментЧтения - Дата(1970, 1, 1, 0, 0, 0);
	Состояние.ПериодС = СМП_КоннекторыБанковОбщее.КиевскоеВремяВМоментUnix(Параметры.НачалоПериода);
	Состояние.ПериодПо = СМП_КоннекторыБанковОбщее.КиевскоеВремяВМоментUnix(Параметры.КонецПериода);
	Состояние.Нижняя = Состояние.ПериодС - 1;
	Состояние.Верхняя = Мин(Состояние.ПериодПо + 1, Состояние.МоментUnix);

КонецПроцедуры

// Записи выписки, принадлежащие периоду: операции вне НачалоПериода...КонецПериода, но в границах запроса, отбрасываются молча (D36 п. 11);
// номера отброшенных остаются занятыми. Запись без читаемого времени остается (ее разберет обработка записей).
Функция ЗаписиПериода(Состояние)

	Результат = Новый Массив;
	Для Каждого Запись Из Состояние.Записи Цикл
		Если ТипЗнч(Запись.Данные) = Тип("Соответствие") Тогда
			Время = СМП_КоннекторыБанковОбщее.ЦелоеИзJSON(Запись.Данные["time"]);
			Если Время <> Неопределено И (Время < Состояние.ПериодС Или Время > Состояние.ПериодПо) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Порог полной страницы: банк отдает не более 500 операций за запрос (ДОКУМЕНТАЛЬНАЯ гипотеза, не измерено: комментарий клиента
// go-mono v0.5.3 «если количество транзакций = 500, нужен еще один запрос», сообщественная документация monobank API
// «не более 500 транзакций от конца периода»; журнал плана 05а, «Задача 5, до старту»). В run1 самая большая страница - 31
// операция. Если реальный максимум меньше 500, полная страница выглядела бы как конец отрезка и остаток отрезка потерялся бы
// молча - открытый риск, закрывает его лишь измерение насыщенного периода.
// Предел страниц одного чтения - ПРЕДОХРАНИТЕЛЬ от бесконечного цикла, а не рабочий объем (константа конектора, решение консультанта и архитектора, D36 п. 11): банк, который без конца отдает полные страницы,
// держал бы чтение вечно, а каждый повтор снова съедал бы лимит частоты банка. Слишком малый предел дает видимое «ДействиеЧеловека» с предложением сузить период, а не потерю
// данных. Класс сверх предела - «ДействиеЧеловека»: законный объем повтор не уменьшит. Когда владелец назовет реальные объемы, предел заменяется правкой ЭТОЙ ОДНОЙ константы.
// Формула: суток x операций в сутки / размер страницы 500 (гипотеза документации) + запас. Суток = 366: самый длинный интерактивный период (спекой НЕ ограничен, D18 п. 7), он больше глубины регламента 31 сутки
// (D18 п. 4, предложение) + перекрытия 3 суток (ГИПОТЕЗА, значение задает этап 5б). Операций в сутки = 200 - ГИПОТЕЗА, не измерено (журнал 05а, run1/run3: несколько операций в сутки).
// 366 x 200 / 500 = 147 страниц + по одной короткой на каждый из 12 отрезков = 160 + запас -> 200 запросов выписки. Между запросами 60 с, поэтому чтение до предела занимает 200 минут (3 ч 20 мин).
Функция ПотолокСтраниц()

	Возврат 200;

КонецФункции

// Достигнут ли предел страниц перед следующим запросом (Верхняя - верхняя граница следующего запроса, секунды Unix): отказ «ДействиеЧеловека»
// с числом страниц, операций и границей, чтение останавливается. Чтение идет от конца периода (направление для прочитанного отрезка).
Функция ПотолокДостигнут(Состояние, Верхняя)

	Возврат СМП_КоннекторыБанковОбщее.ДостигнутПотолок(Состояние, СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Верхняя), Состояние.Номер, Истина, Истина);

КонецФункции

Функция РабочийПорогПолнойСтраницы()

	Возврат 500;

КонецФункции

// Длина отрезка периода в секундах: 31 × 86400 (документация: не более 31 суток + 1 час); окно запроса с запасом - на 2 секунды больше.
Функция ДлинаОтрезкаСекунд()

	Возврат 2678400;

КонецФункции

// Пауза между запросами выписки: банк разрешает выписку не чаще 1 раза в 60 секунд (документация monobank API).
Функция ПаузаМеждуЗапросамиВыписки()

	Возврат 60;

КонецФункции

Функция НазваниеБанка()

	Возврат "monobank ФОП";

КонецФункции

// Идентификатор счета банка - из client-info по IBAN, при каждом чтении (D36 п. 9). Паузы после client-info нет: банк после него
// выписку дает (run1/run2, 0 отказов из 2 пар). Не найден - «ДействиеЧеловека» с причиной, а не пустое полное чтение (D36 п. 8).
Процедура ПрочитатьИдентификаторСчета(Состояние)

	Клиент = ЗапроситьJSON(Состояние, "https://api.monobank.ua/personal/client-info", "Соответствие", Ложь);
	Если Клиент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Рахунок ищется по IBAN точным сравнением строк (регистр и пробелы значимы: IBAN приходит от банка в том виде, в каком платформа хранит
	// НомерСчета). Если у клиента несколько счетов с одним IBAN, берется первый - как у предшественника.
	Счета = Клиент["accounts"];
	Если ТипЗнч(Счета) = Тип("Массив") Тогда
		Для Каждого Счет Из Счета Цикл
			Если ТипЗнч(Счет) = Тип("Соответствие") И СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Счет["iban"]) = Состояние.НомерСчета
				И Не ПустаяСтрока(СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Счет["id"])) Тогда
				Состояние.ИдентификаторСчета = СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Счет["id"]);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СМП_КоннекторыБанковОбщее.Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
		НСтр("ru = 'Банк %1: счет с указанным IBAN не найден среди счетов клиента (client-info); проверьте номер счета и токен.';
			|uk = 'Банк %1: рахунок із зазначеним IBAN не знайдено серед рахунків клієнта (client-info); перевірте номер рахунку й токен.'"),
		НазваниеБанка()), Истина);

КонецПроцедуры

// Читает выписку отрезками периода от самого нового к старым (D36 п. 11, рекомендация консультанта к раунду from). Период
// [НачалоПериода, КонецПериода] делится на отрезки не длиннее 31 суток в секундах Unix (документация: не более 31 суток + 1 час). Запрос
// каждого отрезка берет запас в секунду с обеих сторон: от from отрезка минус секунда до to плюс секунда (самый новый - до Мин(КонецПериода + 1 с,
// момент чтения)). Перекрытие соседних запросов и есть этот запас: операция на границе отрезков попадает хотя бы в один из запросов при любой
// включительности from и to у банка, повтор снимает дедупликация по id. Окно запроса не длиннее 31 суток + 2 секунды. Остановка (отказ запроса,
// аномалия, страница без времени) прерывает чтение всех отрезков.
Процедура ПрочитатьОтрезки(Состояние, Параметры, РазмерСтраницы)

	// Отрезки считаются от первой верхней границы, а не от ПериодПо: если КонецПериода позже момента чтения больше чем на отрезок, окна
	// от ПериодПо легли бы в будущее и первый запрос был бы длиннее предела банка (D36 п. 11).
	Конец = Мин(Состояние.ПериодПо, Состояние.Верхняя - 1);
	ВерхнийЗапрос = Состояние.Верхняя;
	Пока Истина Цикл

		Начало = Макс(Состояние.ПериодС, Конец - ДлинаОтрезкаСекунд());
		ПрочитатьОтрезок(Состояние, РазмерСтраницы, Начало - 1, ВерхнийЗапрос);
		Если Состояние.Остановка Или Начало <= Состояние.ПериодС Тогда
			Возврат;
		КонецЕсли;
		Конец = Начало - 1;
		ВерхнийЗапрос = Конец + 1;
		Если ПотолокДостигнут(Состояние, ВерхнийЗапрос) Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Читает страницы одного отрезка сдвигом верхней границы; записи складывает в Состояние.Записи, отказ - в Состояние.Отказ.
Процедура ПрочитатьОтрезок(Состояние, РазмерСтраницы, Начало, Верхняя)

	Пока Истина Цикл

		Адрес = СтрШаблон("https://api.monobank.ua/personal/statement/%1/%2/%3",
			Состояние.ИдентификаторСчета, Формат(Начало, "ЧГ=0"), Формат(Верхняя, "ЧГ=0"));
		Страница = ЗапроситьJSON(Состояние, Адрес, "Массив", Истина);
		Если Страница = Неопределено Тогда
			Возврат;
		КонецЕсли;

		// Сначала границы ответа (до добавления записей): ответ вне границ запроса - аномалия, «Повторить», ЭТА страница в конверт
		// не берется, прочитанные раньше остаются (D36 п. 8). Границы - ФАКТИЧЕСКИЕ границы запроса (с запасом), не период. time = to аномалией
		// НЕ является (банк не возвращает операцию с time = to, журнал 05а, 9e1eb08, но исключительность границы и дробные секунды не
		// выяснены; повторы снимает id).
		Если СМП_КоннекторыБанковОбщее.ОтветВнеГраниц(Страница, Начало, Верхняя) Тогда
			СМП_КоннекторыБанковОбщее.Отказать(Состояние, "Повторить", СтрШаблон(
				НСтр("ru = 'Банк %1: в ответе есть операции вне границ запроса (time больше to или меньше from, статус 200); продолжить чтение нельзя, чтение неполное.';
					|uk = 'Банк %1: у відповіді є операції поза межами запиту (time більше за to або менше за from, статус 200); продовжити читання не можна, читання неповне.'"),
				НазваниеБанка()), Истина);
			Возврат;
		КонецЕсли;

		Наименьшая = Неопределено;
		Для Каждого Запись Из Страница Цикл
			Состояние.Номер = Состояние.Номер + 1;
			Состояние.Записи.Добавить(Новый Структура("Номер, Данные", Состояние.Номер, Запись));
			Если ТипЗнч(Запись) = Тип("Соответствие") Тогда
				Время = СМП_КоннекторыБанковОбщее.ЦелоеИзJSON(Запись["time"]);
				Если Время <> Неопределено И (Наименьшая = Неопределено Или Время < Наименьшая) Тогда
					Наименьшая = Время;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Состояние.Страниц = Состояние.Страниц + 1;

		// Конец отрезка: страница короче порога полной страницы (D36 п. 11); кратное порогу число операций дает короткую
		// последнюю страницу (повтор пограничной операции).
		Если Страница.Количество() < РазмерСтраницы Тогда
			Возврат;
		КонецЕсли;

		// Полная страница: признака конца нет, читать дальше можно только сдвинув верхнюю границу (D36 п. 11).
		Верхняя = СМП_КоннекторыБанковОбщее.ВерхняяГраницаПродолжения(Состояние, Страница.Количество(), Наименьшая, Начало, Верхняя, Истина);
		Если Верхняя = Неопределено Или ПотолокДостигнут(Состояние, Верхняя) Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// GET, ответ которого должен быть JSON заданного типа ("Массив" - выписка, "Соответствие" - client-info). Для выписки (Выписка =
// Истина): одна повторная попытка после 429 (пауза по заголовкам, иначе 60 с) и пауза перед следующим запросом выписки
// (ограничение банка - 1 запрос в 60 секунд). Для client-info повтора и паузы нет (D36 п. 9). Любой отказ - Отказать с остановкой
// и Неопределено.
Функция ЗапроситьJSON(Состояние, Адрес, ОжидаемыйТип, Выписка)

	Запрос = СМП_КоннекторыБанковОбщее.НовыйЗапросБанка();
	Запрос.Адрес = Адрес;
	Запрос.Заголовки.Вставить("X-Token", Состояние.УчетныеДанные.Токен);
	Запрос.Заголовки.Вставить("accept", "application/json");
	Запрос.ОжидаемыйТип = ОжидаемыйТип;
	Запрос.ПоляОписания = "errorDescription,message";
	Запрос.Повтор429 = Выписка;
	Запрос.ПаузаПослеУспеха = ?(Выписка, ПаузаМеждуЗапросамиВыписки(), 0);
	Запрос.Остановить = Истина;

	Результат = СМП_КоннекторыБанковОбщее.ВыполнитьЗапросБанка(Состояние, Запрос);
	Возврат ?(Результат.Успех, Результат.Значение, Неопределено);

КонецФункции

// Записи -> операции и диагностика. Неостаточные - моменты создания (time) hold для границы доверия.
Процедура ОбработатьЗаписи(Состояние, Выписка, Неостаточные)

	Записи = ЗаписиПериода(Состояние);
	Тексты = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Тексты[Запись.Номер] = СМП_КоннекторыБанковОбщее.ТекстJSON(Запись.Данные);
	КонецЦикла;

	Пропустить = СМП_КоннекторыБанковОбщее.ДедупликацияПоИдентификатору(Записи, Тексты, Выписка, ПравилаДедупликации(Записи));

	Для Каждого Запись Из Записи Цикл

		Номер = Запись.Номер;
		Если Пропустить[Номер] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не СМП_КоннекторыБанковОбщее.ЭтоСоответствие(Запись) Тогда
			СМП_КоннекторыБанковОбщее.ДобавитьДиагностику(Выписка, "Ошибка", Номер, НСтр("ru = 'monobank ФОП: запись выписки не объект JSON.';
				|uk = 'monobank ФОП: запис виписки не є об''єктом JSON.'"));
			Продолжить;
		КонецЕсли;

		Данные = Запись.Данные;
		Идентификатор = ИдентификаторЗаписи(Запись);
		ВремяСоздания = СМП_КоннекторыБанковОбщее.ЦелоеИзJSON(Данные["time"]);
		Если ВремяСоздания = Неопределено Тогда
			СМП_КоннекторыБанковОбщее.ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank ФОП: у операции %1 не читается время (time).';
					|uk = 'monobank ФОП: в операції %1 не читається час (time).'"), Идентификатор));
			Продолжить;
		КонецЕсли;
		Момент = СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(ВремяСоздания);

		Если Данные["hold"] = Истина Тогда
			СМП_КоннекторыБанковОбщее.ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'monobank ФОП: операция %1 в состоянии %2 еще не проведена и не загружена; граница доверия не позже ее времени.';
					|uk = 'monobank ФОП: операція %1 у стані %2 ще не проведена і не завантажена; межа довіри не пізніше її часу.'"),
				Идентификатор, "hold"));
			Неостаточные.Добавить(Момент);
			Продолжить;
		КонецЕсли;

		Сумма = Данные["amount"];
		Если ТипЗнч(Сумма) <> Тип("Число") Тогда
			СМП_КоннекторыБанковОбщее.ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank ФОП: у операции %1 сумма не число.'; uk = 'monobank ФОП: в операції %1 сума не є числом.'"),
				Идентификатор));
			Продолжить;
		КонецЕсли;

		Валюта = СМП_КоннекторыБанковОбщее.КодВалюты(Данные["currencyCode"]);
		Если Валюта = Неопределено Тогда
			СМП_КоннекторыБанковОбщее.ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank ФОП: у операции %1 неизвестный код валюты %2.';
					|uk = 'monobank ФОП: в операції %1 невідомий код валюти %2.'"),
				Идентификатор, СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["currencyCode"])));
			Продолжить;
		КонецЕсли;

		Операция = Выписка.Операции.Добавить();
		Операция.ПорядковыйНомер = Номер;
		Операция.НомерСчета = Состояние.НомерСчета;
		Операция.Валюта = Валюта;
		Операция.ДатаОперации = Момент;
		Операция.НомерДокумента = Идентификатор;
		Операция.ДатаДокумента = НачалоДня(Момент);
		Операция.Сумма = ?(Сумма < 0, -Сумма, Сумма) / 100;
		Операция.Направление = ?(Сумма < 0, "Списано", "Поступило");
		Операция.ИдентификаторОперации = Идентификатор;
		Операция.КонтрагентНаименование = СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["counterName"]);
		Операция.КонтрагентНомерСчета = СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["counterIban"]);
		Операция.КонтрагентКод = СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["counterEdrpou"]);
		Операция.КонтрагентМФО = "";
		Операция.НазначениеПлатежа = НазначениеПлатежа(Данные);
		Операция.СырыеДанные = Тексты[Номер];

	КонецЦикла;

КонецПроцедуры

// Правила дедупликации по id (границы страниц на секунде дают повторы): hold-запись не остаточная и в «виденных» не остается, поэтому
// проведенная с тем же id на другой странице не теряется. Исключенных пар у ФОП нет.
Функция ПравилаДедупликации(Записи)

	Правила = СМП_КоннекторыБанковОбщее.НовыеПравилаДедупликации(НазваниеБанка(), "id");
	Для Каждого Запись Из Записи Цикл
		Если СМП_КоннекторыБанковОбщее.ЭтоСоответствие(Запись) И Не Остаточная(Запись) Тогда
			Правила.Неостаточные[Запись.Номер] = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Правила;

КонецФункции

Функция Остаточная(Запись)

	Возврат Запись.Данные["hold"] <> Истина;

КонецФункции

Функция ИдентификаторЗаписи(Запись)

	Возврат СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Запись.Данные["id"]);

КонецФункции

// Назначение: description, затем comment с новой строки, затем «Сума комісії» и «Кешбек» (как у предшественника), без обрезания до 255
// (отступ 5). Отсутствующие comment и description - пусто, не слово «Неопределено».
Функция НазначениеПлатежа(Данные)

	Описание = СокрЛП(СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["description"]));
	Комментарий = СокрЛП(СМП_КоннекторыБанковОбщее.СтрокаИзJSON(Данные["comment"]));
	Если Комментарий = "" Тогда
		Результат = Описание;
	ИначеЕсли Описание = "" Тогда
		Результат = Комментарий;
	Иначе
		Результат = Описание + Символы.ПС + Комментарий;
	КонецЕсли;

	Комиссия = Данные["commissionRate"];
	Если ТипЗнч(Комиссия) = Тип("Число") И Комиссия > 0 Тогда
		Результат = Результат + " Сума комісії " + Формат(Комиссия / 100, "ЧРД=,; ЧГ=0");
	КонецЕсли;
	Кэшбэк = Данные["cashbackAmount"];
	Если ТипЗнч(Кэшбэк) = Тип("Число") И Кэшбэк > 0 Тогда
		Результат = Результат + " Кешбек " + Формат(Кэшбэк / 100, "ЧРД=,; ЧГ=0");
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
