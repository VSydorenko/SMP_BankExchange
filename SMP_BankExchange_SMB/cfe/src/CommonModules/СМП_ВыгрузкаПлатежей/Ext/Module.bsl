// Вывод платежных поручений УНФ: нормализованное поручение и преобразование документа (спека D8, план 07, задача 2).
//
// Нормализованное поручение - структура ТОЛЬКО из значений типов платформы (строки, числа, даты): ссылок на
// объекты базы в ней нет (D8, D27), поэтому модуль формата, получая поручение, базу не читает и работает одинаково
// в любой конфигурации. Схему поручения определяет ЕДИНСТВЕННЫЙ конструктор НовоеПоручение; проверка на границе
// сравнивает поручение со свежим НовоеПоручение(), а не с отдельным перечнем (дзеркало конверта читателя, D28).
//
// Модуль КОНФИГУРАЦИОННЫЙ (читает базу), не модуль-ворота переносимости: ворота - модули форматов.
//
// Каждое правило отбора и преобразования, которое может изменить решение, живет в своей процедуре с именем
// "Правило..." - менять его можно в одном месте.

#Область ПрограммныйИнтерфейс

// Новая сторона поручения (плательщик или получатель). Единственное место, где перечислены поля стороны;
// растет только добавлением полей.
//
// Возвращаемое значение:
//  Структура - сторона:
//   * Наименование - Строка - название стороны: текст стороны из документа, при пустом - полное наименование
//                    организации или контрагента.
//   * Код - Строка - код стороны: ЕДРПОУ юрлица или РНОКПП (ИНН) ФОП и физлица, как в справочнике (ведущие нули сохранены).
//   * ВидКода - Строка - "ЕДРПОУ" или "РНОКПП" (вид стороны определяет, какой реквизит справочника взят).
//   * НомерСчета - Строка - номер счета как в справочнике банковских счетов (IBAN или старый номер): то, что пишет эталон.
//   * IBAN - Строка - то же значение, если НомерСчета имеет вид IBAN (UA и 27 цифр), иначе пусто.
//   * Банк - Строка - наименование банка счета (при непрямых расчетах - банка расчетов).
//   * МФО - Строка - код банка (МФО) как в справочнике, ведущие нули сохранены.
//   * Город - Строка - город банка.
Функция НоваяСторонаПоручения() Экспорт

	Сторона = Новый Структура;
	Сторона.Вставить("Наименование", "");
	Сторона.Вставить("Код", "");
	Сторона.Вставить("ВидКода", "");
	Сторона.Вставить("НомерСчета", "");
	Сторона.Вставить("IBAN", "");
	Сторона.Вставить("Банк", "");
	Сторона.Вставить("МФО", "");
	Сторона.Вставить("Город", "");
	Возврат Сторона;

КонецФункции

// Новое пустое нормализованное поручение. Каждый вызов возвращает независимый объект.
//
// Возвращаемое значение:
//  Структура - поручение:
//   * Номер - Строка - номер документа без префиксов и ведущих нулей (вендорской функцией).
//   * Дата - Дата - дата документа (как в документе, с временем).
//   * Сумма - Число - сумма документа (15,2); корректной для вывода считается только сумма больше нуля.
//   * НазначениеПлатежа - Строка - назначение платежа без пробелов по краям; очистку недопустимых символов делает формат.
//   * Плательщик - Структура - наша организация (см. НоваяСторонаПоручения).
//   * Получатель - Структура - контрагент (см. НоваяСторонаПоручения).
Функция НовоеПоручение() Экспорт

	Поручение = Новый Структура;
	Поручение.Вставить("Номер", "");
	Поручение.Вставить("Дата", Дата(1, 1, 1));
	Поручение.Вставить("Сумма", 0);
	Поручение.Вставить("НазначениеПлатежа", "");
	Поручение.Вставить("Плательщик", НоваяСторонаПоручения());
	Поручение.Вставить("Получатель", НоваяСторонаПоручения());
	Возврат Поручение;

КонецФункции

// Проверка поручения на границе платформы: схема и типы (по свежему НовоеПоручение()), затем обязательные поля.
// Поручение не меняется.
//
// Параметры:
//  Поручение - Структура - нормализованное поручение (или то, что выдано за него).
//
// Возвращаемое значение:
//  Массив из Строка - тексты причин отказа; пустой массив - поручение принято.
Функция ПроверитьПоручение(Поручение) Экспорт

	Причины = Новый Массив;

	Если ТипЗнч(Поручение) <> Тип("Структура") Тогда
		Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: не структура, получено значение типа %1.';
			|uk = 'Доручення: не структура, отримано значення типу %1.'"), Строка(ТипЗнч(Поручение))));
		Возврат Причины;
	КонецЕсли;

	СверитьСхему(Поручение, НовоеПоручение(), "", Причины);
	Если Причины.Количество() > 0 Тогда
		Возврат Причины;
	КонецЕсли;

	ПравилоОбязательныхПолей(Поручение, Причины);
	Возврат Причины;

КонецФункции

// Преобразует документы ПлатежноеПоручение УНФ в нормализованные поручения.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ПлатежноеПоручение - документы к выгрузке.
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет нашей организации, по которому выгружают.
//  НачалоПериода - Дата - начало периода (целые дни); пустая дата - без нижней границы.
//  КонецПериода - Дата - конец периода (целые дни); пустая дата - без верхней границы.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Строки - ТаблицаЗначений - ровно одна строка на каждую ссылку списка, в порядке списка:
//    ** Ссылка - ДокументСсылка.ПлатежноеПоручение
//    ** Поручение - Структура, Неопределено - нормализованное поручение; Неопределено, если ссылка пропущена
//       (причина в Диагностике). Преобразование поручение НЕ проверяет (ПроверитьПоручение - отдельный шаг).
//   * Диагностика - ТаблицаЗначений - сообщения по ссылкам:
//    ** Ссылка - ДокументСсылка.ПлатежноеПоручение
//    ** Уровень - Строка - "Ошибка" (ссылка пропущена) или "Предупреждение" (поручение построено, но на что-то стоит обратить внимание)
//    ** Текст - Строка
Функция ПреобразоватьДокументыВПоручения(Ссылки, БанковскийСчет, НачалоПериода, КонецПериода) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Строки", НоваяТаблицаСтрок());
	Результат.Вставить("Диагностика", НоваяТаблицаДиагностики());

	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Данные = ДанныеДокументов(Ссылки);
	ВладелецСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанковскийСчет, "Владелец");
	НациональнаяВалюта = Константы.НациональнаяВалюта.Получить();
	Видели = Новый Соответствие;

	Для Каждого Ссылка Из Ссылки Цикл

		НоваяСтрока = Результат.Строки.Добавить();
		НоваяСтрока.Ссылка = Ссылка;

		Причины = Новый Массив;
		ДанныеДокумента = Данные.Получить(Ссылка);
		ПравилоПовторнойСсылки(Ссылка, Видели, Причины);
		Если ДанныеДокумента = Неопределено Тогда
			Причины.Добавить(НСтр("ru = 'документ не найден в базе'; uk = 'документ не знайдено в базі'"));
		ИначеЕсли Причины.Количество() = 0 Тогда
			ПравилоПометкиУдаления(ДанныеДокумента, Причины);
			ПравилоСчетаДокумента(ДанныеДокумента, БанковскийСчет, Причины);
			ПравилоОрганизацииДокумента(ДанныеДокумента, ВладелецСчета, Причины);
			ПравилоПериода(ДанныеДокумента, НачалоПериода, КонецПериода, Причины);
			ПравилоВалюты(ДанныеДокумента, НациональнаяВалюта, Причины);
		КонецЕсли;

		Если Причины.Количество() > 0 Тогда
			Для Каждого Причина Из Причины Цикл
				ДобавитьДиагностику(Результат.Диагностика, Ссылка, СМП_ВыпискаБанка.УровеньОшибка(), ТекстПропуска(Причина));
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		НоваяСтрока.Поручение = ПоручениеИзДанных(ДанныеДокумента);
		ПравилоПредупрежденийКодов(ДанныеДокумента, НоваяСтрока.Поручение, Результат.Диагностика);
		ПравилоПредупрежденияНалога(ДанныеДокумента, Результат.Диагностика);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Реестр вывода: по строке на банк и формат файла. Данных в базе нет (дзеркало реестра читателей, D30).
//
// Возвращаемое значение:
//  ТаблицаЗначений - реестр:
//   * Идентификатор - Строка - постоянный, никогда не переиспользуется: на него ссылается настройка учетной записи.
//   * Банк - Строка - для человека.
//   * ТипФайла - Строка - для человека.
//   * Представление - Строка - "<Банк> - <тип файла>".
//   * КодыБанка - Массив из Строка - МФО банка (для будущего автовыбора).
//   * Формат - Строка - имя модуля формата вывода.
//   * РасширениеФайла - Строка - из описания модуля формата (источник один).
//   * ИмяСтаройОбработки - Строка - подсказка этапа 8 (D23).
Функция РеестрВыгрузки() Экспорт

	Реестр = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Идентификатор,Банк,ТипФайла,Представление,КодыБанка,Формат,РасширениеФайла,ИмяСтаройОбработки", ",") Цикл
		Реестр.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	// Идентификатор строки постоянный: менять и переиспользовать нельзя. КодыБанка - МФО банка, те же, что в реестре
	// читателей (тест сверяет). Справочник НБУ не подключался: код из памяти не добавляется.
	// Пять банков iFOBS - один модуль формата; Сенс - DBF.
	Формат = "СМП_ФорматВыгрузкиiFOBS_TXT";
	ДобавитьСтрокуРеестра(Реестр, "Акорд_TXT", НСтр("ru = 'Акордбанк'; uk = 'Акордбанк'"), "380634", Формат,
		"СМП_ОбработкаВыпискиБанка_АкордБанк");
	ДобавитьСтрокуРеестра(Реестр, "Восток_TXT", НСтр("ru = 'Банк Восток'; uk = 'Банк Восток'"), "307123", Формат,
		"СМП_ОбработкаВыпискиБанка_БанкВосток");
	ДобавитьСтрокуРеестра(Реестр, "Райффайзен_TXT", НСтр("ru = 'Райффайзен Банк'; uk = 'Райффайзен Банк'"), "380805", Формат,
		"СМП_ОбработкаВыпискиБанка_РайффайзенБанк");
	ДобавитьСтрокуРеестра(Реестр, "УкрГазБанк_TXT", НСтр("ru = 'УкрГазБанк'; uk = 'Укргазбанк'"), "320478", Формат,
		"СМП_ОбработкаВыпискиБанка_УкрГазБанк");
	ДобавитьСтрокуРеестра(Реестр, "Универсал_TXT", НСтр("ru = 'Универсал Банк'; uk = 'Універсал Банк'"), "322001", Формат,
		"СМП_ОбработкаВыпискиБанка_УниверсалБанк");
	ДобавитьСтрокуРеестра(Реестр, "СенсБанк_DBF", НСтр("ru = 'Сенс Банк'; uk = 'Сенс Банк'"), "300346",
		"СМП_ФорматВыгрузкиСенсБанк_DBF", "СМП_ОбработкаВыпискиБанка_СенсБанк");

	Возврат Реестр;

КонецФункции

// Идентификаторы строк реестра вывода, которых в нем уже нет. Идентификатор не переиспользуется, поэтому выведенный
// не должен совпасть ни с одной строкой реестра; вывод по нему дает понятный отказ, а не "не найдено".
//
// Возвращаемое значение:
//  Массив из Строка - выведенные идентификаторы.
Функция ВыведенныеИдентификаторы() Экспорт

	Возврат Новый Массив;

КонецФункции

// Новые параметры вывода. Единственное место, где перечислены поля параметров.
//
// Возвращаемое значение:
//  Структура:
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет нашей организации, по которому выводят.
//   * НачалоПериода - Дата - начало периода (целые дни); пустая дата - без нижней границы.
//   * КонецПериода - Дата - конец периода (целые дни); пустая дата - без верхней границы.
//   * ИдентификаторСтроки - Строка - идентификатор строки реестра вывода (банк и формат).
//   * Момент - Дата - момент создания файла (задает вызывающий: ни точка, ни формат текущее время не читают).
Функция НовыеПараметрыВыгрузки() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Параметры.Вставить("НачалоПериода", Дата(1, 1, 1));
	Параметры.Вставить("КонецПериода", Дата(1, 1, 1));
	Параметры.Вставить("ИдентификаторСтроки", "");
	Параметры.Вставить("Момент", Дата(1, 1, 1));
	Возврат Параметры;

КонецФункции

// Новый пустой пакет вывода. Единственное место, где перечислены поля пакета.
//
// Возвращаемое значение:
//  Структура - пакет:
//   * ИдентификаторСтроки - Строка - строка реестра, по которой сформирован пакет.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета
//   * Организация - СправочникСсылка.Организации - владелец счета.
//   * Момент - Дата - момент создания (из параметров).
//   * ДвоичныеДанные - ДвоичныеДанные, Неопределено - файл; Неопределено, если выводить нечего (ни одного принятого
//                      поручения) или вывод отклонен.
//   * Кодировка - Строка - кодировка файла (из описания формата).
//   * КодировкаТекста - Строка - кодировка текста файла из описания формата; пусто для двоичного формата.
//   * ПредлагаемоеИмя - Строка - имя файла от модуля формата.
//   * Диагностика - ТаблицаЗначений - не менее одной строки на каждую ссылку списка (D3: молча не пропускается):
//    ** Позиция - Число - номер ссылки в списке (с единицы; повтор - своя позиция).
//    ** Ссылка - ДокументСсылка.ПлатежноеПоручение
//    ** Статус - Строка - "Выгружено", "ВыгруженоСПредупреждением" или "Пропущено".
//    ** Поле - Строка - поле формата, о котором предупреждение; пусто, если сообщение не про поле.
//    ** Действие - Строка - что сделано с полем: "Обрезано", "Очищено"; пусто, если сообщение не про поле.
//    ** Текст - Строка - текст для человека (причина пропуска, суть предупреждения).
//   * Всего - Число - M: ссылок в списке.
//   * Выгружено - Число - N: поручений в файле (в том числе с предупреждением).
//   * СПредупреждениями - Число - из выгруженных: с предупреждением.
//   * Пропущено - Число - M минус N.
//   * Сводка - Строка - "Выгружено N из M" для человека.
//   * Отказ - Булево - вывод отклонен целиком (неизвестная или выведенная строка реестра); файла нет.
//   * ТекстыОтказа - Массив из Строка - причины отказа.
Функция НовыйПакетВыгрузки() Экспорт

	Диагностика = Новый ТаблицаЗначений;
	Диагностика.Колонки.Добавить("Позиция", Новый ОписаниеТипов("Число"));
	Диагностика.Колонки.Добавить("Ссылка");
	Диагностика.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Диагностика.Колонки.Добавить("Поле", Новый ОписаниеТипов("Строка"));
	Диагностика.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
	Диагностика.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));

	Пакет = Новый Структура;
	Пакет.Вставить("ИдентификаторСтроки", "");
	Пакет.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Пакет.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Пакет.Вставить("Момент", Дата(1, 1, 1));
	Пакет.Вставить("ДвоичныеДанные", Неопределено);
	Пакет.Вставить("Кодировка", "");
	Пакет.Вставить("КодировкаТекста", "");
	Пакет.Вставить("ПредлагаемоеИмя", "");
	Пакет.Вставить("Диагностика", Диагностика);
	Пакет.Вставить("Всего", 0);
	Пакет.Вставить("Выгружено", 0);
	Пакет.Вставить("СПредупреждениями", 0);
	Пакет.Вставить("Пропущено", 0);
	Пакет.Вставить("Сводка", "");
	Пакет.Вставить("Отказ", Ложь);
	Пакет.Вставить("ТекстыОтказа", Новый Массив);
	Возврат Пакет;

КонецФункции

// Вывод платежных поручений в файл формата строки реестра: отбор и преобразование (ПреобразоватьДокументыВПоручения),
// проверка КАЖДОГО поручения (ПроверитьПоручение), файл модулем формата. Файл формирует модуль формата, не эта
// точка. Документы не меняются; история работы с клиент-банком здесь НЕ пишется (человек еще не получил файл):
// ее пишет ЗаписатьИсториюВыгрузки, когда форма отдала файл.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ПлатежноеПоручение - документы к выводу (порядок и повторы - как в преобразовании).
//  Параметры - Структура - см. НовыеПараметрыВыгрузки.
//
// Возвращаемое значение:
//  Структура - см. НовыйПакетВыгрузки.
Функция Выгрузить(Ссылки, Параметры) Экспорт

	ПроверитьПараметрыВывода(Ссылки, Параметры);

	Пакет = НовыйПакетВыгрузки();
	Пакет.ИдентификаторСтроки = Параметры.ИдентификаторСтроки;
	Пакет.БанковскийСчет = Параметры.БанковскийСчет;
	Пакет.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.БанковскийСчет, "Владелец");
	Пакет.Момент = Параметры.Момент;
	Пакет.Всего = Ссылки.Количество();

	// Строка реестра: неизвестная или выведенная - отказ целиком, но каждая ссылка названа (D3).
	ТекстОтказа = ТекстОтказаСтрокиРеестра(Параметры.ИдентификаторСтроки);
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Пакет.Отказ = Истина;
		Пакет.ТекстыОтказа.Добавить(ТекстОтказа);
		Для Позиция = 1 По Ссылки.Количество() Цикл
			ДобавитьСтрокуПакета(Пакет, Позиция, Ссылки[Позиция - 1], СтатусПропущено(), "", "",
				ТекстПропуска(НСтр("ru = 'вывод отклонен: '; uk = 'вивантаження відхилено: '") + ТекстОтказа));
		КонецЦикла;
		ЗавершитьСчетчикиПакета(Пакет);
		Возврат Пакет;
	КонецЕсли;

	Формат = НайтиСтрокуРеестра(Параметры.ИдентификаторСтроки).Формат;
	Описание = ОписаниеФорматаВывода(Формат);
	Пакет.Кодировка = Описание.Кодировка;
	Пакет.КодировкаТекста = Описание.КодировкаТекста;

	// Отбор и преобразование по уникальным ссылкам (диагностика преобразования ключуется ссылкой); повтор получает
	// собственную строку "пропущено" на своей позиции.
	ПозицияПервого = Новый Соответствие;
	Уникальные = Новый Массив;
	Для Позиция = 1 По Ссылки.Количество() Цикл
		Если ПозицияПервого.Получить(Ссылки[Позиция - 1]) = Неопределено Тогда
			ПозицияПервого.Вставить(Ссылки[Позиция - 1], Позиция);
			Уникальные.Добавить(Ссылки[Позиция - 1]);
		КонецЕсли;
	КонецЦикла;
	Преобразование = ПреобразоватьДокументыВПоручения(Уникальные, Параметры.БанковскийСчет, Параметры.НачалоПериода,
		Параметры.КонецПериода);
	СтрокиПреобразования = Новый Соответствие;
	Для Каждого Строка Из Преобразование.Строки Цикл
		СтрокиПреобразования.Вставить(Строка.Ссылка, Строка.Поручение);
	КонецЦикла;
	ДиагностикаПреобразования = Новый Соответствие;
	Для Каждого Строка Из Преобразование.Диагностика Цикл
		Сообщения = ДиагностикаПреобразования.Получить(Строка.Ссылка);
		Если Сообщения = Неопределено Тогда
			Сообщения = Новый Массив;
			ДиагностикаПреобразования.Вставить(Строка.Ссылка, Сообщения);
		КонецЕсли;
		Сообщения.Добавить(Строка);
	КонецЦикла;

	// Решение по каждой позиции: пропущено (с причинами) или принято. Проверка КАЖДОГО поручения - здесь.
	СообщенияПозиций = Новый Соответствие;
	Пропущенные = Новый Соответствие;
	Принятые = Новый Массив;
	ПозицииПринятых = Новый Массив;
	Для Позиция = 1 По Ссылки.Количество() Цикл
		Ссылка = Ссылки[Позиция - 1];
		Сообщения = Новый Массив;
		СообщенияПозиций.Вставить(Позиция, Сообщения);
		Если ПозицияПервого.Получить(Ссылка) <> Позиция Тогда
			Пропущенные.Вставить(Позиция, Истина);
			Сообщения.Добавить(Новый Структура("Поле,Действие,Текст", "", "", ТекстПропуска(ПричинаПовторнойСсылки())));
			Продолжить;
		КонецЕсли;
		Поручение = СтрокиПреобразования.Получить(Ссылка);
		Если Поручение = Неопределено Тогда
			Пропущенные.Вставить(Позиция, Истина);
			Для Каждого Строка Из ?(ДиагностикаПреобразования.Получить(Ссылка) = Неопределено, Новый Массив,
				ДиагностикаПреобразования.Получить(Ссылка)) Цикл
				Сообщения.Добавить(Новый Структура("Поле,Действие,Текст", "", "", Строка.Текст));
			КонецЦикла;
			Если Сообщения.Количество() = 0 Тогда
				Сообщения.Добавить(Новый Структура("Поле,Действие,Текст", "", "",
					ТекстПропуска(НСтр("ru = 'причина не указана'; uk = 'причину не вказано'"))));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Причины = ПроверитьПоручение(Поручение);
		Если Причины.Количество() > 0 Тогда
			Пропущенные.Вставить(Позиция, Истина);
			Для Каждого Причина Из Причины Цикл
				Сообщения.Добавить(Новый Структура("Поле,Действие,Текст", "", "",
					ТекстПропуска(НСтр("ru = 'поручение не принято: '; uk = 'доручення не прийнято: '") + Причина)));
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Принятые.Добавить(Поручение);
		ПозицииПринятых.Добавить(Позиция);
		Для Каждого Строка Из ?(ДиагностикаПреобразования.Получить(Ссылка) = Неопределено, Новый Массив,
			ДиагностикаПреобразования.Получить(Ссылка)) Цикл
			Сообщения.Добавить(Новый Структура("Поле,Действие,Текст", "", "", Строка.Текст));
		КонецЦикла;
	КонецЦикла;

	// Файл формирует модуль формата; точка байты не пишет. Нечего выводить - пакет без файла.
	Если Принятые.Количество() > 0 Тогда
		ПараметрыФормата = НовыеПараметрыФормата(Формат);
		ПараметрыФормата.Момент = Параметры.Момент;
		Файл = СформироватьМодулемФормата(Формат, Принятые, ПараметрыФормата);
		Пакет.ДвоичныеДанные = Файл.Данные;
		Пакет.ПредлагаемоеИмя = ИмяФайлаФормата(Формат, Параметры.Момент);
		Для Каждого Предупреждение Из Файл.Предупреждения Цикл
			СообщенияПозиций.Получить(ПозицииПринятых[Предупреждение.ИндексПоручения]).Добавить(
				Новый Структура("Поле,Действие,Текст", Предупреждение.Поле, Предупреждение.Действие, Предупреждение.Текст));
		КонецЦикла;
	КонецЕсли;

	Для Позиция = 1 По Ссылки.Количество() Цикл
		Сообщения = СообщенияПозиций.Получить(Позиция);
		Если Пропущенные.Получить(Позиция) <> Неопределено Тогда
			Для Каждого Сообщение Из Сообщения Цикл
				ДобавитьСтрокуПакета(Пакет, Позиция, Ссылки[Позиция - 1], СтатусПропущено(), Сообщение.Поле, Сообщение.Действие,
					Сообщение.Текст);
			КонецЦикла;
		ИначеЕсли Сообщения.Количество() = 0 Тогда
			ДобавитьСтрокуПакета(Пакет, Позиция, Ссылки[Позиция - 1], СтатусВыгружено(), "", "",
				НСтр("ru = 'вывод выполнен'; uk = 'вивантаження виконано'"));
		Иначе
			Для Каждого Сообщение Из Сообщения Цикл
				ДобавитьСтрокуПакета(Пакет, Позиция, Ссылки[Позиция - 1], СтатусВыгруженоСПредупреждением(), Сообщение.Поле,
					Сообщение.Действие, Сообщение.Текст);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	ЗавершитьСчетчикиПакета(Пакет);
	Возврат Пакет;

КонецФункции

// Кандидаты к выводу: платежные поручения счета за период с признаками для формы.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет нашей организации.
//  НачалоПериода - Дата - начало периода (целые дни); пустая дата - без нижней границы.
//  КонецПериода - Дата - конец периода (целые дни); пустая дата - без верхней границы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - в порядке даты и ссылки; помеченные на удаление не входят (как в вендорском КлиентБанк):
//   * Ссылка - ДокументСсылка.ПлатежноеПоручение
//   * Номер - Строка - номер документа.
//   * Дата - Дата
//   * Сумма - Число
//   * Оплачено - Булево - реквизит документа "Оплачено" (вендор ставит его при проведении РасходСоСчета).
//   * Ошибки - Массив из Строка - причины, по которым поручение не будет выведено (отбор и проверка).
//   * ЕстьОшибки - Булево - Ошибки не пуст.
Функция КандидатыВыгрузки(БанковскийСчет, НачалоПериода, КонецПериода) Экспорт

	Кандидаты = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Ссылка,Номер,Дата,Сумма,Оплачено,Ошибки,ЕстьОшибки", ",") Цикл
		Кандидаты.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БанковскийСчет, "Владелец"));
	Запрос.УстановитьПараметр("БезНачала", Не ЗначениеЗаполнено(НачалоПериода));
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("БезКонца", Не ЗначениеЗаполнено(КонецПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.СуммаДокумента КАК Сумма,
	|	Т.Оплачено КАК Оплачено
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК Т
	|ГДЕ
	|	Т.БанковскийСчет = &БанковскийСчет
	|	И Т.Организация = &Организация
	|	И НЕ Т.ПометкаУдаления
	|	И (&БезНачала ИЛИ Т.Дата >= &Начало)
	|	И (&БезКонца ИЛИ Т.Дата <= &Конец)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строка = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Ошибки = Новый Массив;
		Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Кандидаты;
	КонецЕсли;

	// Причины, по которым вывод пропустил бы поручение: отбор и преобразование, затем проверка.
	Преобразование = ПреобразоватьДокументыВПоручения(Ссылки, БанковскийСчет, НачалоПериода, КонецПериода);
	Для Каждого Строка Из Преобразование.Строки Цикл
		Кандидат = Кандидаты.Найти(Строка.Ссылка, "Ссылка");
		Если Строка.Поручение = Неопределено Тогда
			Для Каждого Сообщение Из Преобразование.Диагностика.НайтиСтроки(Новый Структура("Ссылка", Строка.Ссылка)) Цикл
				Кандидат.Ошибки.Добавить(Сообщение.Текст);
			КонецЦикла;
		Иначе
			Для Каждого Причина Из ПроверитьПоручение(Строка.Поручение) Цикл
				Кандидат.Ошибки.Добавить(Причина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Кандидаты Цикл
		Строка.ЕстьОшибки = Строка.Ошибки.Количество() > 0;
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Записывает в ИсторияРаботыСКлиентомБанка вывод, который человек получил (вызывает форма ПОСЛЕ получения файла).
// ИсходныйФайл - ДвоичныеДанные пакета как есть (для любого формата); ИмяФайла - предлагаемое имя пакета;
// КодировкаТекста - из пакета (пусто для двоичного формата); ПротоколЗагрузки - ТабличныйДокумент из диагностики пакета.
// Ресурс Кодировка новые записи не заполняют. Ключ записи: период (момент пакета), организация, счет.
//
// Параметры:
//  Пакет - Структура - пакет вывода с файлом (см. НовыйПакетВыгрузки); без файла - исключение.
Процедура ЗаписатьИсториюВыгрузки(Пакет) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("ДвоичныеДанные") Или ТипЗнч(Пакет.ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru = 'Запись истории вывода: у пакета нет файла (ДвоичныеДанные), записывать нечего.';
			|uk = 'Запис історії вивантаження: у пакета немає файлу (ДвоичныеДанные), записувати нічого.'");
	КонецЕсли;

	Запись = РегистрыСведений.ИсторияРаботыСКлиентомБанка.СоздатьМенеджерЗаписи();
	Запись.Период = Пакет.Момент;
	Запись.Организация = Пакет.Организация;
	Запись.БанковскийСчет = Пакет.БанковскийСчет;
	Запись.Загрузка = Ложь;
	Запись.КоличествоДокументовВВыписке = Пакет.Выгружено;
	Запись.ИсходныйФайл = ИсходныйФайлИстории(Пакет);
	Запись.ИмяФайла = Пакет.ПредлагаемоеИмя;
	Запись.КодировкаТекста = Пакет.КодировкаТекста;
	Запись.ПротоколЗагрузки = Новый ХранилищеЗначения(ПротоколПакета(Пакет), Новый СжатиеДанных(5));
	Запись.Записать();

КонецПроцедуры

// Статус "вывод выполнен".
Функция СтатусВыгружено() Экспорт

	Возврат "Выгружено";

КонецФункции

// Статус "вывод выполнен с предупреждением".
Функция СтатусВыгруженоСПредупреждением() Экспорт

	Возврат "ВыгруженоСПредупреждением";

КонецФункции

// Статус "пропущено" (причина в тексте диагностики).
Функция СтатусПропущено() Экспорт

	Возврат "Пропущено";

КонецФункции

#КонецОбласти

#Область Правила

// Повторная ссылка: второе вхождение пропускается.
Процедура ПравилоПовторнойСсылки(Ссылка, Видели, Причины)

	Если Видели.Получить(Ссылка) <> Неопределено Тогда
		Причины.Добавить(ПричинаПовторнойСсылки());
	КонецЕсли;
	Видели.Вставить(Ссылка, Истина);

КонецПроцедуры

Процедура ПравилоПометкиУдаления(Данные, Причины)

	Если Данные.ПометкаУдаления Тогда
		Причины.Добавить(НСтр("ru = 'документ помечен на удаление'; uk = 'документ позначено на видалення'"));
	КонецЕсли;

КонецПроцедуры

Процедура ПравилоСчетаДокумента(Данные, БанковскийСчет, Причины)

	Если Данные.БанковскийСчет <> БанковскийСчет Тогда
		Причины.Добавить(НСтр("ru = 'банковский счет документа отличается от выгружаемого';
			|uk = 'банківський рахунок документа відрізняється від того, що вивантажується'"));
	КонецЕсли;

КонецПроцедуры

Процедура ПравилоОрганизацииДокумента(Данные, ВладелецСчета, Причины)

	Если Данные.Организация <> ВладелецСчета Тогда
		Причины.Добавить(НСтр("ru = 'организация документа отличается от владельца выгружаемого счета';
			|uk = 'організація документа відрізняється від власника рахунку, що вивантажується'"));
	КонецЕсли;

КонецПроцедуры

// Период - целые дни; пустая граница не ограничивает.
Процедура ПравилоПериода(Данные, НачалоПериода, КонецПериода, Причины)

	Раньше = ЗначениеЗаполнено(НачалоПериода) И Данные.Дата < НачалоДня(НачалоПериода);
	Позже = ЗначениеЗаполнено(КонецПериода) И Данные.Дата > КонецДня(КонецПериода);
	Если Раньше Или Позже Тогда
		Причины.Добавить(НСтр("ru = 'дата документа вне периода выгрузки'; uk = 'дата документа поза періодом вивантаження'"));
	КонецЕсли;

КонецПроцедуры

// Форматы - гривневые: документ или счет в другой валюте пропускаются.
Процедура ПравилоВалюты(Данные, НациональнаяВалюта, Причины)

	Если Данные.ВалютаДокумента <> НациональнаяВалюта Тогда
		Причины.Добавить(НСтр("ru = 'вывод только в национальной валюте: документ в валюте, отличной от национальной';
			|uk = 'вивантаження лише в національній валюті: документ у валюті, відмінній від національної'"));
	КонецЕсли;
	Если Данные.ВалютаСчета <> НациональнаяВалюта Тогда
		Причины.Добавить(НСтр("ru = 'вывод только в национальной валюте: банковский счет в валюте, отличной от национальной';
			|uk = 'вивантаження лише в національній валюті: банківський рахунок у валюті, відмінній від національної'"));
	КонецЕсли;

КонецПроцедуры

// Непрямые расчеты: если у счета заполнен банк расчетов, банк, МФО и город берутся из него (как в вендорском экспорте).
Функция ПравилоБанкаСчета(Данные, Префикс)

	Если ЗначениеЗаполнено(Данные[Префикс + "БанкРасчетов"]) Тогда
		Возврат Новый Структура("Банк,МФО,Город", Данные[Префикс + "БанкРасчетовИмя"], Данные[Префикс + "БанкРасчетовКод"],
			Данные[Префикс + "БанкРасчетовГород"]);
	КонецЕсли;
	Возврат Новый Структура("Банк,МФО,Город", Данные[Префикс + "БанкИмя"], Данные[Префикс + "БанкКод"], Данные[Префикс + "БанкГород"]);

КонецФункции

// Текст стороны при непрямых расчетах (как в вендорском экспорте КлиентБанк): режется до первого "р/с" (поиск с учетом
// регистра) с очисткой пробелов; без "р/с" и при прямых расчетах - как есть.
Функция ПравилоТекстаСтороны(Текст, НепрямыеРасчеты)

	Если НепрямыеРасчеты Тогда
		ПозицияРС = Найти(Текст, "р/с");
		Если ПозицияРС > 0 Тогда
			Возврат СокрЛП(Лев(Текст, ПозицияРС - 1));
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Код стороны по ее виду: юрлицо (и неизвестный вид) - ЕДРПОУ, ФОП и физлицо - РНОКПП из ИНН. Запасного кода нет.
Функция ПравилоКодаСтороны(ЭтоФизическое, ЕДРПОУ, ИНН)

	Если ЭтоФизическое Тогда
		Возврат Новый Структура("Код,ВидКода", СокрЛП(ИНН), "РНОКПП");
	КонецЕсли;
	Возврат Новый Структура("Код,ВидКода", СокрЛП(ЕДРПОУ), "ЕДРПОУ");

КонецФункции

// Пустой код стороны - предупреждение, не отказ.
Процедура ПравилоПредупрежденийКодов(Данные, Поручение, Диагностика)

	Для Каждого ИмяСтороны Из СтрРазделить("Плательщик,Получатель", ",") Цикл
		Сторона = Поручение[ИмяСтороны];
		Если ПустаяСтрока(Сторона.Код) Тогда
			ДобавитьДиагностику(Диагностика, Данные.Ссылка, СМП_ВыпискаБанка.УровеньПредупреждение(),
				СтрШаблон(НСтр("ru = '%1: код (%2) не заполнен, в файл уйдет пустой.'; uk = '%1: код (%2) не заповнено, у файл піде порожній.'"),
				ИмяСтороны, Сторона.ВидКода));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Перечисление налога выгружается как обычный платеж: КБК и подобное форматы не передают.
Процедура ПравилоПредупрежденияНалога(Данные, Диагностика)

	Если Данные.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПеречислениеНалога") Тогда
		ДобавитьДиагностику(Диагностика, Данные.Ссылка, СМП_ВыпискаБанка.УровеньПредупреждение(),
			НСтр("ru = 'Вид операции ""Перечисление налога"": реквизиты налога формат не передает, платеж выгружен как обычный.';
				|uk = 'Вид операції ""Перерахування податку"": реквізити податку формат не передає, платіж вивантажено як звичайний.'"));
	КонецЕсли;

КонецПроцедуры

// Обязательные поля поручения (после схемы).
Процедура ПравилоОбязательныхПолей(Поручение, Причины)

	Если ПустаяСтрока(Поручение.Номер) Тогда
		ДобавитьНеЗаполнено(Причины, "Номер");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Поручение.Дата) Тогда
		ДобавитьНеЗаполнено(Причины, "Дата");
	КонецЕсли;
	Если Поручение.Сумма <= 0 Тогда
		Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: поле Сумма равно %1, ожидалась сумма больше нуля.';
			|uk = 'Доручення: поле Сумма дорівнює %1, очікувалась сума більша за нуль.'"),
			Формат(Поручение.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=; ЧН=0")));
	КонецЕсли;
	Если ПустаяСтрока(Поручение.НазначениеПлатежа) Тогда
		ДобавитьНеЗаполнено(Причины, "НазначениеПлатежа");
	КонецЕсли;
	Для Каждого ИмяСтороны Из СтрРазделить("Плательщик,Получатель", ",") Цикл
		Для Каждого ИмяПоля Из СтрРазделить("Наименование,НомерСчета,МФО", ",") Цикл
			Если ПустаяСтрока(Поручение[ИмяСтороны][ИмяПоля]) Тогда
				ДобавитьНеЗаполнено(Причины, ИмяСтороны + "." + ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст "документ пропущен" с причиной - один для преобразования и для пакета.
Функция ТекстПропуска(Причина)

	Возврат НСтр("ru = 'Документ пропущен: '; uk = 'Документ пропущено: '") + Причина + ".";

КонецФункции

Функция ПричинаПовторнойСсылки()

	Возврат НСтр("ru = 'документ указан повторно в списке'; uk = 'документ вказано повторно в списку'");

КонецФункции

#Область ВыводСлужебные

Процедура ДобавитьСтрокуРеестра(Реестр, Идентификатор, Банк, МФО, Формат, ИмяСтаройОбработки)

	Описание = ОписаниеФорматаВывода(Формат);
	Строка = Реестр.Добавить();
	Строка.Идентификатор = Идентификатор;
	Строка.Банк = Банк;
	Строка.ТипФайла = СтрШаблон(НСтр("ru = 'файл вывода (.%1)'; uk = 'файл вивантаження (.%1)'"), Описание.РасширениеФайла);
	Строка.Представление = СтрШаблон("%1 — %2", Банк, Строка.ТипФайла);
	Строка.КодыБанка = Новый Массив;
	Строка.КодыБанка.Добавить(МФО);
	Строка.Формат = Формат;
	Строка.РасширениеФайла = Описание.РасширениеФайла;
	Строка.ИмяСтаройОбработки = ИмяСтаройОбработки;

КонецПроцедуры

Функция НайтиСтрокуРеестра(Идентификатор)

	Для Каждого СтрокаРеестра Из РеестрВыгрузки() Цикл
		Если СтрокаРеестра.Идентификатор = Идентификатор Тогда
			Возврат СтрокаРеестра;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Пустая строка - строка реестра есть и действует; иначе текст отказа для человека.
Функция ТекстОтказаСтрокиРеестра(Идентификатор)

	Если ВыведенныеИдентификаторы().Найти(Идентификатор) <> Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Строка реестра вывода ""%1"" выведена из реестра и больше не поддерживается. Выберите другую строку.';
			|uk = 'Рядок реєстру вивантаження ""%1"" виведено з реєстру і більше не підтримується. Оберіть інший рядок.'"), Идентификатор);
	КонецЕсли;
	Если НайтиСтрокуРеестра(Идентификатор) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Строка реестра вывода ""%1"" не найдена.'; uk = 'Рядок реєстру вивантаження ""%1"" не знайдено.'"),
			Идентификатор);
	КонецЕсли;
	Возврат "";

КонецФункции

// Явная диспетчеризация формата вывода (дзеркало читателей, D30): модуль формата вызывается по имени в тексте, имя из
// строки не собирается. Новый формат - ветка в каждой из четырех функций.
Функция ОписаниеФорматаВывода(Формат)

	Если Формат = "СМП_ФорматВыгрузкиiFOBS_TXT" Тогда
		Возврат СМП_ФорматВыгрузкиiFOBS_TXT.ОписаниеФормата();
	ИначеЕсли Формат = "СМП_ФорматВыгрузкиСенсБанк_DBF" Тогда
		Возврат СМП_ФорматВыгрузкиСенсБанк_DBF.ОписаниеФормата();
	КонецЕсли;
	ВызватьИсключение ТекстНеизвестногоФормата(Формат);

КонецФункции

Функция НовыеПараметрыФормата(Формат)

	Если Формат = "СМП_ФорматВыгрузкиiFOBS_TXT" Тогда
		Возврат СМП_ФорматВыгрузкиiFOBS_TXT.НовыеПараметры();
	ИначеЕсли Формат = "СМП_ФорматВыгрузкиСенсБанк_DBF" Тогда
		Возврат СМП_ФорматВыгрузкиСенсБанк_DBF.НовыеПараметры();
	КонецЕсли;
	ВызватьИсключение ТекстНеизвестногоФормата(Формат);

КонецФункции

Функция ИмяФайлаФормата(Формат, Момент)

	Если Формат = "СМП_ФорматВыгрузкиiFOBS_TXT" Тогда
		Возврат СМП_ФорматВыгрузкиiFOBS_TXT.ПредлагаемоеИмяФайла(Момент);
	ИначеЕсли Формат = "СМП_ФорматВыгрузкиСенсБанк_DBF" Тогда
		Возврат СМП_ФорматВыгрузкиСенсБанк_DBF.ПредлагаемоеИмяФайла(Момент);
	КонецЕсли;
	ВызватьИсключение ТекстНеизвестногоФормата(Формат);

КонецФункции

Функция СформироватьМодулемФормата(Формат, Поручения, ПараметрыФормата)

	Если Формат = "СМП_ФорматВыгрузкиiFOBS_TXT" Тогда
		Возврат СМП_ФорматВыгрузкиiFOBS_TXT.Сформировать(Поручения, ПараметрыФормата);
	ИначеЕсли Формат = "СМП_ФорматВыгрузкиСенсБанк_DBF" Тогда
		Возврат СМП_ФорматВыгрузкиСенсБанк_DBF.Сформировать(Поручения, ПараметрыФормата);
	КонецЕсли;
	ВызватьИсключение ТекстНеизвестногоФормата(Формат);

КонецФункции

Функция ТекстНеизвестногоФормата(Формат)

	Возврат СтрШаблон(НСтр("ru = 'Формат вывода ""%1"" не поддерживается диспетчером.'; uk = 'Формат вивантаження ""%1"" не підтримується диспетчером.'"), Формат);

КонецФункции

// Параметры вывода: требования точки, а не модуля формата (формат Сенса на пустой дате падает текстом без слова "Момент").
Процедура ПроверитьПараметрыВывода(Ссылки, Параметры)

	Если ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'Ссылки: ожидается Массив ссылок на платежные поручения.'; uk = 'Ссылки: очікується Масив посилань на платіжні доручення.'");
	КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Параметры: ожидается Структура (см. НовыеПараметрыВыгрузки).'; uk = 'Параметри: очікується Структура (див. НовыеПараметрыВыгрузки).'");
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("БанковскийСчет,НачалоПериода,КонецПериода,ИдентификаторСтроки,Момент", ",") Цикл
		Если Не Параметры.Свойство(ИмяПоля) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Параметры: нет поля %1.'; uk = 'Параметри: немає поля %1.'"), ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Параметры.Момент) <> Тип("Дата") Или Не ЗначениеЗаполнено(Параметры.Момент) Тогда
		ВызватьИсключение НСтр("ru = 'Параметры.Момент: ожидается заполненная дата (момент создания файла задает вызывающий).';
			|uk = 'Параметри.Момент: очікується заповнена дата (момент створення файлу задає викликач).'");
	КонецЕсли;
	Если ТипЗнч(Параметры.БанковскийСчет) <> Тип("СправочникСсылка.БанковскиеСчета") Или Не ЗначениеЗаполнено(Параметры.БанковскийСчет) Тогда
		ВызватьИсключение НСтр("ru = 'Параметры.БанковскийСчет: ожидается заполненная ссылка на банковский счет организации.';
			|uk = 'Параметри.БанковскийСчет: очікується заповнене посилання на банківський рахунок організації.'");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСтрокуПакета(Пакет, Позиция, Ссылка, Статус, Поле, Действие, Текст)

	Строка = Пакет.Диагностика.Добавить();
	Строка.Позиция = Позиция;
	Строка.Ссылка = Ссылка;
	Строка.Статус = Статус;
	Строка.Поле = Поле;
	Строка.Действие = Действие;
	Строка.Текст = Текст;

КонецПроцедуры

// Счетчики "N из M" по позициям: статус позиции - по строкам диагностики (пропущено главнее, затем предупреждение).
Процедура ЗавершитьСчетчикиПакета(Пакет)

	Статусы = Новый Соответствие;
	Для Каждого Строка Из Пакет.Диагностика Цикл
		Текущий = Статусы.Получить(Строка.Позиция);
		Если Текущий = СтатусПропущено() Или Строка.Статус = СтатусПропущено() Тогда
			Статусы.Вставить(Строка.Позиция, СтатусПропущено());
		ИначеЕсли Текущий = СтатусВыгруженоСПредупреждением() Или Строка.Статус = СтатусВыгруженоСПредупреждением() Тогда
			Статусы.Вставить(Строка.Позиция, СтатусВыгруженоСПредупреждением());
		Иначе
			Статусы.Вставить(Строка.Позиция, Строка.Статус);
		КонецЕсли;
	КонецЦикла;
	Пакет.Выгружено = 0;
	Пакет.СПредупреждениями = 0;
	Для Каждого Элемент Из Статусы Цикл
		Если Элемент.Значение = СтатусВыгружено() Тогда
			Пакет.Выгружено = Пакет.Выгружено + 1;
		ИначеЕсли Элемент.Значение = СтатусВыгруженоСПредупреждением() Тогда
			Пакет.Выгружено = Пакет.Выгружено + 1;
			Пакет.СПредупреждениями = Пакет.СПредупреждениями + 1;
		КонецЕсли;
	КонецЦикла;
	Пакет.Пропущено = Пакет.Всего - Пакет.Выгружено;
	Пакет.Сводка = СтрШаблон(НСтр("ru = 'Выгружено %1 из %2'; uk = 'Вивантажено %1 з %2'"),
		Формат(Пакет.Выгружено, "ЧН=0; ЧГ="), Формат(Пакет.Всего, "ЧН=0; ЧГ="));

КонецПроцедуры

// Значение ИсходныйФайл записи истории: ДвоичныеДанные пакета как есть, для любого формата (решение 17). Тип значения
// меняется только здесь.
Функция ИсходныйФайлИстории(Пакет)

	Возврат Новый ХранилищеЗначения(Пакет.ДвоичныеДанные, Новый СжатиеДанных(5));

КонецФункции

// Протокол пакета для ПротоколЗагрузки: шапка, сводка, строка на сообщение диагностики (документ - с расшифровкой).
Функция ПротоколПакета(Пакет)

	Протокол = Новый ТабличныйДокумент;
	Протокол.Область(1, 1).Текст = НСтр("ru = 'Протокол вывода платежных поручений'; uk = 'Протокол вивантаження платіжних доручень'");
	Протокол.Область(2, 1).Текст = Пакет.Сводка;
	Протокол.Область(3, 1).Текст = Пакет.ПредлагаемоеИмя;
	Заголовки = СтрРазделить("№,Документ,Статус,Поле,Действие,Текст", ",");
	Для Колонка = 1 По Заголовки.Количество() Цикл
		Протокол.Область(5, Колонка).Текст = Заголовки[Колонка - 1];
	КонецЦикла;
	НомерСтроки = 6;
	Для Каждого СтрокаДиагностики Из Пакет.Диагностика Цикл
		Протокол.Область(НомерСтроки, 1).Текст = Формат(СтрокаДиагностики.Позиция, "ЧН=0; ЧГ=");
		Протокол.Область(НомерСтроки, 2).Текст = Строка(СтрокаДиагностики.Ссылка);
		Протокол.Область(НомерСтроки, 2).Расшифровка = СтрокаДиагностики.Ссылка;
		Протокол.Область(НомерСтроки, 3).Текст = СтрокаДиагностики.Статус;
		Протокол.Область(НомерСтроки, 4).Текст = СтрокаДиагностики.Поле;
		Протокол.Область(НомерСтроки, 5).Текст = СтрокаДиагностики.Действие;
		Протокол.Область(НомерСтроки, 6).Текст = СтрокаДиагностики.Текст;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Возврат Протокол;

КонецФункции

#КонецОбласти

Процедура ДобавитьНеЗаполнено(Причины, Путь)

	Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: поле %1 не заполнено.'; uk = 'Доручення: поле %1 не заповнено.'"), Путь));

КонецПроцедуры

// Сверка схемы значения с шаблоном: набор ключей и типы; сторона - рекурсивно.
Процедура СверитьСхему(Значение, Шаблон, Путь, Причины)

	Префикс = ?(Путь = "", "", Путь + ".");
	Для Каждого Элемент Из Шаблон Цикл
		Если Не Значение.Свойство(Элемент.Ключ) Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: нет поля %1.'; uk = 'Доручення: немає поля %1.'"), Префикс + Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Значение Цикл
		Если Не Шаблон.Свойство(Элемент.Ключ) Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: лишнее поле %1.'; uk = 'Доручення: зайве поле %1.'"), Префикс + Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Шаблон Цикл
		Если Не Значение.Свойство(Элемент.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Фактический = Значение[Элемент.Ключ];
		Если ТипЗнч(Фактический) <> ТипЗнч(Элемент.Значение) Тогда
			Причины.Добавить(СтрШаблон(НСтр("ru = 'Поручение: поле %1 имеет тип %2, ожидался %3.';
				|uk = 'Доручення: поле %1 має тип %2, очікувався %3.'"),
				Префикс + Элемент.Ключ, Строка(ТипЗнч(Фактический)), Строка(ТипЗнч(Элемент.Значение))));
		ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда
			СверитьСхему(Фактический, Элемент.Значение, Префикс + Элемент.Ключ, Причины);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПоручениеИзДанных(Данные)

	Поручение = НовоеПоручение();
	Поручение.Номер = УправлениеНебольшойФирмойКлиентСервер.НомерДокументаБезЛидирующихНулей(СокрЛП(Данные.Номер), Истина, Истина);
	Поручение.Дата = Данные.Дата;
	Поручение.Сумма = Данные.СуммаДокумента;
	Поручение.НазначениеПлатежа = СокрЛП(Данные.НазначениеПлатежа);

	ОрганизацияФизическая = (Данные.ОрганизацияВид = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо"));
	Плательщик = Поручение.Плательщик;
	ТекстПлательщика = ПравилоТекстаСтороны(Данные.ТекстПлательщика, ЗначениеЗаполнено(Данные.СчетБанкРасчетов));
	Плательщик.Наименование = ?(ПустаяСтрока(ТекстПлательщика), СокрЛП(Данные.ОрганизацияИмя), СокрЛП(ТекстПлательщика));
	ЗаполнитьСторону(Плательщик, ПравилоКодаСтороны(ОрганизацияФизическая, Данные.ОрганизацияЕДРПОУ, Данные.ОрганизацияИНН),
		СокрЛП(Данные.СчетНомер), ПравилоБанкаСчета(Данные, "Счет"));

	КонтрагентФизический = (Данные.КонтрагентВид = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ИндивидуальныйПредприниматель")
		Или Данные.КонтрагентВид = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентов.ФизическоеЛицо"));
	Получатель = Поручение.Получатель;
	ТекстПолучателя = ПравилоТекстаСтороны(Данные.ТекстПолучателя, ЗначениеЗаполнено(Данные.КонтрагентСчетБанкРасчетов));
	Получатель.Наименование = ?(ПустаяСтрока(ТекстПолучателя), СокрЛП(Данные.КонтрагентИмя), СокрЛП(ТекстПолучателя));
	ЗаполнитьСторону(Получатель, ПравилоКодаСтороны(КонтрагентФизический, Данные.КонтрагентЕДРПОУ, Данные.КонтрагентИНН),
		СокрЛП(Данные.КонтрагентСчетНомер), ПравилоБанкаСчета(Данные, "КонтрагентСчет"));

	Возврат Поручение;

КонецФункции

Процедура ЗаполнитьСторону(Сторона, Код, НомерСчета, Банк)

	Сторона.Код = Код.Код;
	Сторона.ВидКода = Код.ВидКода;
	Сторона.НомерСчета = НомерСчета;
	Сторона.IBAN = ?(ЭтоIBAN(НомерСчета), НомерСчета, "");
	Сторона.Банк = СокрЛП(Банк.Банк);
	Сторона.МФО = СокрЛП(Банк.МФО);
	Сторона.Город = СокрЛП(Банк.Город);

КонецПроцедуры

// IBAN Украины: "UA", две контрольные цифры и 25 цифр (всего 29 знаков).
Функция ЭтоIBAN(Номер)

	Если СтрДлина(Номер) <> 29 Или ВРег(Лев(Номер, 2)) <> "UA" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 3 По 29 Цикл
		Если СтрНайти("0123456789", Сред(Номер, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Данные документов одним запросом: Соответствие "ссылка -> строка выборки" (структура полей).
Функция ДанныеДокументов(Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.ПометкаУдаления КАК ПометкаУдаления,
	|	Т.Дата КАК Дата,
	|	Т.Номер КАК Номер,
	|	Т.СуммаДокумента КАК СуммаДокумента,
	|	Т.НазначениеПлатежа КАК НазначениеПлатежа,
	|	Т.ВидОперации КАК ВидОперации,
	|	Т.ВалютаДокумента КАК ВалютаДокумента,
	|	Т.ТекстПлательщика КАК ТекстПлательщика,
	|	Т.ТекстПолучателя КАК ТекстПолучателя,
	|	Т.Организация КАК Организация,
	|	Т.БанковскийСчет КАК БанковскийСчет,
	|	ЕСТЬNULL(Т.Организация.НаименованиеПолное, """") КАК ОрганизацияИмя,
	|	ЕСТЬNULL(Т.Организация.КодПоЕДРПОУ, """") КАК ОрганизацияЕДРПОУ,
	|	ЕСТЬNULL(Т.Организация.ИНН, """") КАК ОрганизацияИНН,
	|	Т.Организация.ЮридическоеФизическоеЛицо КАК ОрганизацияВид,
	|	ЕСТЬNULL(Т.БанковскийСчет.НомерСчета, """") КАК СчетНомер,
	|	Т.БанковскийСчет.ВалютаДенежныхСредств КАК ВалютаСчета,
	|	ЕСТЬNULL(Т.БанковскийСчет.Банк.Наименование, """") КАК СчетБанкИмя,
	|	ЕСТЬNULL(Т.БанковскийСчет.Банк.Код, """") КАК СчетБанкКод,
	|	ЕСТЬNULL(Т.БанковскийСчет.Банк.Город, """") КАК СчетБанкГород,
	|	Т.БанковскийСчет.БанкРасчетов КАК СчетБанкРасчетов,
	|	ЕСТЬNULL(Т.БанковскийСчет.БанкРасчетов.Наименование, """") КАК СчетБанкРасчетовИмя,
	|	ЕСТЬNULL(Т.БанковскийСчет.БанкРасчетов.Код, """") КАК СчетБанкРасчетовКод,
	|	ЕСТЬNULL(Т.БанковскийСчет.БанкРасчетов.Город, """") КАК СчетБанкРасчетовГород,
	|	ЕСТЬNULL(Т.Контрагент.НаименованиеПолное, """") КАК КонтрагентИмя,
	|	ЕСТЬNULL(Т.Контрагент.КодПоЕДРПОУ, """") КАК КонтрагентЕДРПОУ,
	|	ЕСТЬNULL(Т.Контрагент.ИНН, """") КАК КонтрагентИНН,
	|	Т.Контрагент.ВидКонтрагента КАК КонтрагентВид,
	|	ЕСТЬNULL(Т.СчетКонтрагента.НомерСчета, """") КАК КонтрагентСчетНомер,
	|	ЕСТЬNULL(Т.СчетКонтрагента.Банк.Наименование, """") КАК КонтрагентСчетБанкИмя,
	|	ЕСТЬNULL(Т.СчетКонтрагента.Банк.Код, """") КАК КонтрагентСчетБанкКод,
	|	ЕСТЬNULL(Т.СчетКонтрагента.Банк.Город, """") КАК КонтрагентСчетБанкГород,
	|	Т.СчетКонтрагента.БанкРасчетов КАК КонтрагентСчетБанкРасчетов,
	|	ЕСТЬNULL(Т.СчетКонтрагента.БанкРасчетов.Наименование, """") КАК КонтрагентСчетБанкРасчетовИмя,
	|	ЕСТЬNULL(Т.СчетКонтрагента.БанкРасчетов.Код, """") КАК КонтрагентСчетБанкРасчетовКод,
	|	ЕСТЬNULL(Т.СчетКонтрагента.БанкРасчетов.Город, """") КАК КонтрагентСчетБанкРасчетовГород
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК Т
	|ГДЕ
	|	Т.Ссылка В (&Ссылки)";

	Данные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные.Вставить(Выборка.Ссылка, СтрокаВыборки(Выборка));
	КонецЦикла;
	Возврат Данные;

КонецФункции

Функция СтрокаВыборки(Выборка)

	Поля = "Ссылка,ПометкаУдаления,Дата,Номер,СуммаДокумента,НазначениеПлатежа,ВидОперации,ВалютаДокумента,ТекстПлательщика,"
		+ "ТекстПолучателя,Организация,БанковскийСчет,ОрганизацияИмя,ОрганизацияЕДРПОУ,ОрганизацияИНН,ОрганизацияВид,СчетНомер,"
		+ "ВалютаСчета,СчетБанкИмя,СчетБанкКод,СчетБанкГород,СчетБанкРасчетов,СчетБанкРасчетовИмя,СчетБанкРасчетовКод,"
		+ "СчетБанкРасчетовГород,КонтрагентИмя,КонтрагентЕДРПОУ,КонтрагентИНН,КонтрагентВид,КонтрагентСчетНомер,"
		+ "КонтрагентСчетБанкИмя,КонтрагентСчетБанкКод,КонтрагентСчетБанкГород,КонтрагентСчетБанкРасчетов,"
		+ "КонтрагентСчетБанкРасчетовИмя,КонтрагентСчетБанкРасчетовКод,КонтрагентСчетБанкРасчетовГород";
	Данные = Новый Структура(Поля);
	ЗаполнитьЗначенияСвойств(Данные, Выборка);
	Возврат Данные;

КонецФункции

Функция НоваяТаблицаСтрок()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Поручение");
	Возврат Таблица;

КонецФункции

Функция НоваяТаблицаДиагностики()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка");
	Таблица.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;

КонецФункции

Процедура ДобавитьДиагностику(Диагностика, Ссылка, Уровень, Текст)

	НоваяСтрока = Диагностика.Добавить();
	НоваяСтрока.Ссылка = Ссылка;
	НоваяСтрока.Уровень = Уровень;
	НоваяСтрока.Текст = Текст;

КонецПроцедуры

