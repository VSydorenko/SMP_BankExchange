// Читатель выписок: CSV УкрГазБанка (31 колонка, в каждой записи повторяются остатки). Один банк, свой формат.
//
// Колонки берутся по номеру (0-based), как в старой обработке (она читала по номеру) (план 03, задача 7):
//   0 DATA_VYP дата операции (только дата)   5 ND номер документа   7 DK направление (1 - поступило, 2 - списано)
//   8 MFO_KOR МФО контрагента    9 AC_KOR не читается (в образце часть значений испорчена экспонентой)
//   10 OKPO_KOR код контрагента  11 NAME_KOR наименование контрагента   16 AccountCur код валюты
//   17 SUM_PD_NOM сумма   19 PURPOSE назначение   20 IN_RST_NO входящий остаток   22 OUT_RST_NO исходящий остаток
//   29 DB_IBAN наш счет   30 CR_IBAN IBAN контрагента (читается он, а не AC_KOR)
// Первая запись - заголовок.
//
// Наш счет строки (НомерСчета) - из колонки 29 файла, а не из Параметры.НомерСчета: так фильтр чужих счетов
// платформы видит настоящий счет строки.
// Время операции в файле отсутствует: как в старой обработке, зашито «00:09:00» (известная особенность; решение
// планувальника - воспроизвести как есть). ДатаДокумента не заполняется: старая обработка кладет в ДатаДок день
// операции, а составной ключ при пустой ДатаДокумента берет дату операции (спека, D17).
// Направление строго по DK: «1» поступило, «2» списано, иное значение - «Ошибка» (старая обработка считала
// поступлением все, кроме «2»).
// Остатки (ДаетОстатки): из первой записи данных; нераспознанный остаток - «Предупреждение», остаток не задан.
// Идентификатора операции банк не дает.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет «Ошибка» с
// сырым значением, ЧтениеПолное остается Ложь.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер CSV и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("csv");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиУкрГазБанк_CSV");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'CSV УкрГазБанка';
		|uk = 'CSV Укргазбанку'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Истина);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (Кодировка - из описания читателя).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	КодировкаФайла = Параметры.Кодировка;
	Если ПустаяСтрока(КодировкаФайла) Тогда
		КодировкаФайла = Кодировка();
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Данные, КодировкаФайла, ";");
	Если Записи.Количество() = 0 Тогда
		ДобавитьСообщение(Выписка, "Ошибка", 0, НСтр("ru = 'Файл пуст: нет даже строки заголовка.';
			|uk = 'Файл порожній: немає навіть рядка заголовка.'"));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	// Остатки повторяются в каждой записи: берутся из первой записи данных.
	Если Записи.Количество() > 1 Тогда
		ПрочитатьОстатки(Записи[1], Выписка);
	КонецЕсли;

	// Первая запись - заголовок.
	Для Индекс = 1 По Записи.ВГраница() Цикл
		Операция = РазобратьЗапись(Записи[Индекс], Выписка);
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка начала файла: «файл похож на этот формат». Читает только начало файла и сверяет заголовок по
// позициям колонок: число колонок (не меньше 31) и названия колонок 0, 5, 7, 17, 19, 29, 30 (регистр не важен).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Если Буфер.Размер = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Начало = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.ПолучитьСрез(0, Мин(Буфер.Размер, 4096)));
	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Начало, Кодировка(), ";");
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Поля = Записи[0].Поля;
	Если Поля.Количество() < КолонокВЗаписи() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяКолонки(Поля, 0) = "data_vyp"
		И ИмяКолонки(Поля, 5) = "nd"
		И ИмяКолонки(Поля, 7) = "dk"
		И ИмяКолонки(Поля, 17) = "sum_pd_nom"
		И ИмяКолонки(Поля, 19) = "purpose"
		И ИмяКолонки(Поля, 29) = "db_iban"
		И ИмяКолонки(Поля, 30) = "cr_iban";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образца (20-samples.md): windows-1251.
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

Функция КолонокВЗаписи()

	Возврат 31;

КонецФункции

// Время операции, зашитое в старой обработке: в файле только дата.
Функция СекундОтНачалаСутокВоВремениОперации()

	Возврат 9 * 60;

КонецФункции

Функция ИмяКолонки(Поля, Номер)

	Возврат НРег(СокрЛП(Поля[Номер]));

КонецФункции

// Остатки из записи: колонки 20 (входящий) и 22 (исходящий). Нераспознанный остаток - «Предупреждение».
Процедура ПрочитатьОстатки(Запись, Выписка)

	Если Запись.Поля.Количество() < КолонокВЗаписи() Тогда
		Возврат;
	КонецЕсли;

	Сырье = СокрЛП(Запись.Поля[20]);
	Остаток = СМП_ЧтениеВыписокОбщее.РазобратьСумму(Сырье);
	Если Остаток = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Предупреждение", Запись.НомерВИсточнике, СтрШаблон(
			НСтр("ru = 'Не удалось разобрать входящий остаток: «%1». Остаток не задан.';
				|uk = 'Не вдалося розібрати вхідний залишок: «%1». Залишок не задано.'"),
			Сырье));
	Иначе
		Выписка.НачальныйОстаток = Остаток;
	КонецЕсли;

	Сырье = СокрЛП(Запись.Поля[22]);
	Остаток = СМП_ЧтениеВыписокОбщее.РазобратьСумму(Сырье);
	Если Остаток = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Предупреждение", Запись.НомерВИсточнике, СтрШаблон(
			НСтр("ru = 'Не удалось разобрать исходящий остаток: «%1». Остаток не задан.';
				|uk = 'Не вдалося розібрати вихідний залишок: «%1». Залишок не задано.'"),
			Сырье));
	Иначе
		Выписка.КонечныйОстаток = Остаток;
	КонецЕсли;

КонецПроцедуры

// Разбирает запись в структуру операции или возвращает Неопределено, дописав в диагностику «Ошибка» по каждому
// нераспознанному значению (строка в Операции не попадает).
Функция РазобратьЗапись(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = Запись.Поля;

	Если Поля.Количество() < КолонокВЗаписи() Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'В строке %1 полей: %2, нужно не меньше %3. Строка не прочитана.';
				|uk = 'У рядку %1 полів: %2, потрібно не менше %3. Рядок не прочитано.'"),
			Формат(Номер, "ЧГ="), Формат(Поля.Количество(), "ЧГ="), Формат(КолонокВЗаписи(), "ЧГ=")));
		Возврат Неопределено;
	КонецЕсли;

	Ошибок = 0;

	// Дата: только день; время зашито в старой обработке.
	СырьеДаты = СокрЛП(Поля[0]);
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр");
	Если ДатаОперации = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату операции: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	Иначе
		ДатаОперации = ДатаОперации + СекундОтНачалаСутокВоВремениОперации();
	КонецЕсли;

	// Направление - строго по DK.
	СырьеDK = СокрЛП(Поля[7]);
	Направление = "";
	Если СырьеDK = "1" Тогда
		Направление = "Поступило";
	ИначеЕсли СырьеDK = "2" Тогда
		Направление = "Списано";
	Иначе
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестное направление (DK): «%1», ожидалось 1 или 2.';
				|uk = 'Рядок не прочитано: невідомий напрям (DK): «%1», очікувалось 1 або 2.'"),
			СырьеDK));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	СырьеСуммы = СокрЛП(Поля[17]);
	Сумма = СМП_ЧтениеВыписокОбщее.РазобратьСумму(СырьеСуммы);
	Если Сумма = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати суму: «%1».'"),
			СырьеСуммы));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Валюта: буквенный код становится числовым, пустая - валюта счета.
	СырьеВалюты = СокрЛП(Поля[16]);
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный код валюты: «%1».';
				|uk = 'Рядок не прочитано: невідомий код валюти: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", СокрЛП(Поля[29]));
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", СокрЛП(Поля[5]));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", Направление);
	Операция.Вставить("КонтрагентНаименование", СокрЛП(Поля[11]));
	Операция.Вставить("КонтрагентНомерСчета", СокрЛП(Поля[30]));
	Операция.Вставить("КонтрагентКод", СокрЛП(Поля[10]));
	Операция.Вставить("КонтрагентМФО", СокрЛП(Поля[8]));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(Поля[19]));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

Процедура ДобавитьСообщение(Выписка, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

#КонецОбласти
