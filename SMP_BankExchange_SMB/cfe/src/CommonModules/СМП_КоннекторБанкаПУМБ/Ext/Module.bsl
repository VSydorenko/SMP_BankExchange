// Конектор API ПУМБ (VegaNet REST, пароль-грант): читач за контрактом D28 (план 05б-2, задача 3, D36).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только с типами платформы и с другими
// воротами (СМП_КоннекторыБанковОбщее, СМП_ЧтениеВыписокОбщее). Базу, метаданные, сеанс, локаль и серверные часы не читает; даты и числа
// форматирует явным форматом; сеть, паузу и момент чтения видит только через Параметры.Транспорт. Исключений наружу не бросает: отказ банка
// классифицирует сам в Выписка.КлассОтказа (D36 п. 8), прочитанное до отказа остается в конверте.
//
// Что читает: токен (пароль-грант, один на чтение, нигде не хранится), список счетов (accountId по IBAN, валюта, номера счета) и документы
// searcher за период БЕЗ пагинации (Р4: явного признака конца, дисциплины размера страницы и курсора у банка не измерено). Ответ не меньше
// ПорогаОтвета() делит период пополам по суткам (до суток); сутки на пороге - «ДействиеЧеловека». Банк с валютными счетами под одним IBAN: счет
// выбирается по паре (IBAN, Параметры.ВалютаСчета), см. НайтиСчет. Поведение определяет режим «ожидаемое»
// оракула tools/statement-samples (expected._pumb), отступы от предшественника (СМП_РаботаСБанкамиПУМБAPIСервер) - pumb1..pumb9:
//  - документ наш, если запрошенный IBAN среди сторон или номер запрошенного счета (number/altNumber) среди номеров сторон; иначе он не операция,
//    а один рядок Предупреждение на чтение с количеством; направление - по стороне, расхождение с direction - Ошибка рядка;
//  - в Операции только PROCESSED, на каждый скасованный и неостаточный - Предупреждение (неостаточный держит ГраницуДоверия);
//  - тип документа (измерено run4, 60 дней): движение денег - только UAH и CUR_ADV; известные «не движение» - STM (ежедневная запись остатка), CUR, CUR_C, CUR_S
//    (заявки, у каждой есть пара на гривневом счете, движение валюты банк отдает авизо CUR_ADV) - не операция и без Предупреждение; любой другой тип
//    (в том числе пустой) - отказ ВСЕГО чтения «ДействиеЧеловека» без операций этого ответа: диагностика называет первый неизвестный тип, число его документов и первые сутки;
//  - идентификатор операции и номер документа - docId; ключ D17 без совместимости с предшественником (исключение ПУМБ, спека 2b8ff4b);
//  - границы запроса - целые календарные сутки, обе границы включительно (D36 п. 11, run2 70fb320): fromDate - сутки НачалоПериода 00:00:00,
//    toDate - сутки меньшего из КонецПериода и момента чтения 23:59:59, запаса в секунду нет; точный период дает фильтр коннектора по operationDate
//    (молча); аномалия - только документ, ДЕНЬ operationDate которого вне суток запроса («Повторить»); граница доверия не позже момента чтения.
// Пояс operationDate не измерен: гипотеза.

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок, docs/architecture/reader-contract.md).
//
// Возвращаемое значение:
//  Структура - описание: читач API; идентификатор операции - docId банка (стабильность - run2), остатков нет.
Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_КоннекторБанкаПУМБ");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'ПУМБ (API)'; uk = 'ПУМБ (API)'"));
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "");
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает выписку в конверт платформы.
//
// Параметры:
//  Данные - Неопределено - у конектора API данных-файла нет (D36 п. 2).
//  Параметры - Структура - параметры чтения (НомерСчета, НачалоПериода, КонецПериода, УчетныеДанные, Транспорт).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	Выписка.НачалоПериода = Параметры.НачалоПериода;
	Выписка.КонецПериода = Параметры.КонецПериода;

	Состояние = Новый Структура;
	Состояние.Вставить("Транспорт", Параметры.Транспорт);
	Состояние.Вставить("УчетныеДанные", Параметры.УчетныеДанные);
	Состояние.Вставить("НомерСчета", Параметры.НомерСчета);
	// Валюта банковского счета 1С (числовой код ISO 4217, D36 п. 2): точка чтения кладет поле для API всегда; читается только если под IBAN несколько счетов.
	ВалютаСчета = "";
	Если Не Параметры.Свойство("ВалютаСчета", ВалютаСчета) Или ТипЗнч(ВалютаСчета) <> Тип("Строка") Тогда
		ВалютаСчета = "";
	КонецЕсли;
	Состояние.Вставить("ВалютаСчета", ВалютаСчета);
	Состояние.Вставить("Отказ", Неопределено);
	Состояние.Вставить("МоментUnix", 0);
	Состояние.Вставить("МоментМестный", Дата(1, 1, 1));
	Состояние.Вставить("Токен", "");
	Состояние.Вставить("СессияФлоу", "");
	Состояние.Вставить("Номер", 0);
	Состояние.Вставить("Неостаточные", Новый Массив);
	Состояние.Вставить("ЧужихДокументов", 0);

	Если Состояние.Транспорт = Неопределено Или ТипЗнч(Состояние.УчетныеДанные) <> Тип("Структура") Или Не СоставУчетныхДанныхПолон(Состояние.УчетныеДанные) Тогда
		Отказать(Состояние, "ДействиеЧеловека", НСтр("ru = 'Банк ПУМБ: не переданы транспорт или облачные данные (идентификатор клиента, секрет, логин, пароль).';
			|uk = 'Банк ПУМБ: не передано транспорт або облікові дані (ідентифікатор клієнта, секрет, логін, пароль).'"));
	Иначе
		МоментЧтения = Состояние.Транспорт.ТекущийМомент();
		Если ТипЗнч(МоментЧтения) <> Тип("Дата") Или Не ЗначениеЗаполнено(МоментЧтения) Тогда
			Отказать(Состояние, "ДействиеЧеловека", НСтр("ru = 'Банк ПУМБ: транспорт не вернул момент чтения.'; uk = 'Банк ПУМБ: транспорт не повернув момент читання.'"));
		Иначе
			Состояние.МоментUnix = МоментЧтения - Дата(1970, 1, 1, 0, 0, 0);
			Состояние.МоментМестный = СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Состояние.МоментUnix);
			// НачалоПериода позже момента чтения (D36 п. 11): запросов нет, конверт пуст, чтение полное, граница доверия - НачалоПериода.
			Если Параметры.НачалоПериода > Состояние.МоментМестный Тогда
				Выписка.КлассОтказа = "";
				Выписка.ЧтениеПолное = Истина;
				Выписка.ГраницаДоверия = Параметры.НачалоПериода;
				Возврат;
			КонецЕсли;
			ПрочитатьПериод(Состояние, Параметры, Выписка);
		КонецЕсли;
	КонецЕсли;

	// Рядки на чтение (по одному на правило, с количеством) пишутся и тогда, когда чтение оборвалось: прочитанное лежит в конверте.
	Если Состояние.ЧужихДокументов > 0 Тогда
		ДобавитьДиагностику(Выписка, "Предупреждение", 0, СтрШаблон(
			НСтр("ru = 'Банк ПУМБ: %1 документов не загружено: рахунок сторон не совпал ни с IBAN, ни с номером запрошенного счета.';
				|uk = 'Банк ПУМБ: %1 документів не завантажено: рахунок сторін не збігся ні з IBAN, ні з номером запитаного рахунку.'"),
			Формат(Состояние.ЧужихДокументов, "ЧГ=0")));
	КонецЕсли;

	Если Состояние.Отказ <> Неопределено Тогда
		Выписка.КлассОтказа = Состояние.Отказ.Класс;
		Выписка.ЧтениеПолное = Ложь;
		Выписка.ГраницаДоверия = Параметры.НачалоПериода;
		Для Каждого Текст Из Состояние.Отказ.Тексты Цикл
			ДобавитьДиагностику(Выписка, "Предупреждение", 0, Текст);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	// Граница доверия (D36 п. 10): самая ранняя из КонецПериода, момента чтения и момента первой неостаточной операции; не раньше НачалоПериода.
	// Сигнала остаточности у банка нет (гипотеза): только конец, момент, неостаточные.
	Самая = Мин(Параметры.КонецПериода, Состояние.МоментМестный);
	Для Каждого Момент Из Состояние.Неостаточные Цикл
		Самая = Мин(Самая, Момент);
	КонецЦикла;
	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Макс(Параметры.НачалоПериода, Самая);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НазваниеБанка()

	Возврат "ПУМБ";

КонецФункции

// Порог ответа без пагинации: ответ из такого числа документов и больше делит период пополам. 1191 - наибольший наблюдавшийся размер ответа (run2 LongestPeriod, 70fb320);
// потолок банка C >= наблюдавшегося, обрезанный ответ имеет размер ровно C, поэтому порог <= наблюдавшегося гарантирует деление; порог выше наблюдавшегося - молчаливая потеря.
Функция ПорогОтвета()

	Возврат 1191;

КонецФункции

Функция АдресТокена()

	Возврат "https://auth.fuib.com/auth/realms/VegaNet/protocol/openid-connect/token";

КонецФункции

Функция АдресСервиса(Путь)

	Возврат "https://service.fuib.com:4103/war_veganet_api" + Путь;

КонецФункции

Функция СоставУчетныхДанныхПолон(УчетныеДанные)

	Для Каждого Имя Из СтрРазделить("ИдентификаторКлиента,СекретКлиента,Логин,Пароль", ",") Цикл
		Если Не УчетныеДанные.Свойство(Имя) Или ТипЗнч(УчетныеДанные[Имя]) <> Тип("Строка") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Токен, список счетов, документы. Любой отказ оставляет Состояние.Отказ и прекращает чтение.
Процедура ПрочитатьПериод(Состояние, Параметры, Выписка)

	Состояние.СессияФлоу = Строка(Новый УникальныйИдентификатор);

	ПолучитьТокен(Состояние);
	Если Состояние.Отказ <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Счет = НайтиСчет(Состояние);
	Если Счет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Валюта операций: для счета в гривне - 980; для другого без замера - тоже гривня и Предупреждение о неопределенной валюте (отступ 2).
	КодВалюты = "980";
	Если СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(Счет.Валюта) <> "980" Тогда
		ДобавитьДиагностику(Выписка, "Предупреждение", 0, СтрШаблон(
			НСтр("ru = 'Банк ПУМБ: валюта счета %1 не определена как гривна, операции читаются как гривна (код 980).';
				|uk = 'Банк ПУМБ: валюту рахунку %1 не визначено як гривню, операції читаються як гривня (код 980).'"), Счет.Валюта));
	КонецЕсли;

	ЧитатьДокументы(Состояние, Параметры, Выписка, Счет, КодВалюты);

КонецПроцедуры

// Токен: один на чтение, в Состояние (локально), нигде не хранится. Отказ аутентификации - 4xx - «ДействиеЧеловека», 5xx и сбой - «Повторить».
Процедура ПолучитьТокен(Состояние)

	Учетные = Состояние.УчетныеДанные;
	Тело = СтрШаблон("grant_type=password&client_id=%1&username=%2&password=%3&client_secret=%4",
		Кодировать(Учетные.ИдентификаторКлиента), Кодировать(Учетные.Логин), Кодировать(Учетные.Пароль), Кодировать(Учетные.СекретКлиента));
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

	Результат = ВыполнитьЗапрос(Состояние, "POST", АдресТокена(), Заголовки, Тело);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = Результат.Значение;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Или ТипЗнч(Данные["access_token"]) <> Тип("Строка") Или ПустаяСтрока(Данные["access_token"]) Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
			НСтр("ru = 'в ответе нет токена доступа'; uk = 'у відповіді немає токена доступу'"), Состояние.УчетныеДанные));
		Возврат;
	КонецЕсли;
	Состояние.Токен = Данные["access_token"];

КонецПроцедуры

// Счет запрошенного IBAN из списка счетов: accountId, валюта, номера счета (number, altNumber). Под одним IBAN банк может держать несколько счетов
// в разных валютах (измерено run2: 14 счетов, 11 IBAN): один счет - берется он (ВалютаСчета не читается); несколько - выбор по паре (IBAN, валюта):
// валюта счета банка (код /account, приведенный к числовому ISO) равна Параметры.ВалютаСчета. Поле пустое, пары нет или она неоднозначна - «ДействиеЧеловека»
// до запроса выписки (класс «счета нет в банке», D36 п. 8).
//
// Возвращаемое значение:
//  Структура, Неопределено - Идентификатор, Валюта, Номера (Массив из Строка); Неопределено - отказ в Состояние.Отказ.
Функция НайтиСчет(Состояние)

	Результат = ВыполнитьЗапрос(Состояние, "GET", АдресСервиса("/account"), ЗаголовкиДанных(Состояние), Неопределено);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Результат.Значение) <> Тип("Массив") Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
			НСтр("ru = 'список счетов не массив'; uk = 'список рахунків не масив'"), Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Каждого Элемент Из Результат.Значение Цикл
		Если ТипЗнч(Элемент) = Тип("Соответствие") И СтрокаИзJSON(Элемент["iban"]) = Состояние.НомерСчета Тогда
			Кандидаты.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	ВсегоПодIBAN = Кандидаты.Количество();
	Если Кандидаты.Количество() > 1 Тогда
		ПоПаре = Новый Массив;
		Для Каждого Элемент Из Кандидаты Цикл
			Если Не ПустаяСтрока(Состояние.ВалютаСчета) И СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СтрокаИзJSON(Элемент["currency"])) = Состояние.ВалютаСчета Тогда
				ПоПаре.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
		Если ПоПаре.Количество() <> 1 Тогда
			// Факты диагностики: сколько счетов под IBAN и (если передан) код валюты - по ним отказ отличается от «счета нет под IBAN»; в оракуле - Количество и Код.
			КодВалюты = ?(ПустаяСтрока(Состояние.ВалютаСчета), НСтр("ru = 'не передана'; uk = 'не передано'"), Состояние.ВалютаСчета);
			Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
				НСтр("ru = 'Банк %1: под запрошенным IBAN несколько счетов в разных валютах (счетов: %2), а валюта банковского счета в учете (код: %3) не дает однозначной пары (IBAN, валюта); чтение не начато.';
					|uk = 'Банк %1: під запитаним IBAN кілька рахунків у різних валютах (рахунків: %2), а валюта банківського рахунку в обліку (код: %3) не дає однозначної пари (IBAN, валюта); читання не розпочато.'"),
				НазваниеБанка(), Формат(ВсегоПодIBAN, "ЧГ=0"), КодВалюты));
			Возврат Неопределено;
		КонецЕсли;
		Кандидаты = ПоПаре;
	КонецЕсли;

	Если Кандидаты.Количество() = 1 Тогда
		Элемент = Кандидаты[0];
		Идентификатор = СтрокаИзJSON(Элемент["accountId"]);
		Если Не ПустаяСтрока(Идентификатор) Тогда
			Номера = Новый Массив;
			Для Каждого Имя Из СтрРазделить("number,altNumber", ",") Цикл
				Номер = СокрЛП(СтрокаИзJSON(Элемент[Имя]));
				Если Не ПустаяСтрока(Номер) Тогда
					Номера.Добавить(Номер);
				КонецЕсли;
			КонецЦикла;
			Возврат Новый Структура("Идентификатор, Валюта, Номера", Идентификатор, СтрокаИзJSON(Элемент["currency"]), Номера);
		КонецЕсли;
	КонецЕсли;

	Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
		НСтр("ru = 'Банк %1: счет с запрошенным IBAN не найден в списке счетов клиента (счетов под IBAN: %2).'; uk = 'Банк %1: рахунок із запитаним IBAN не знайдено у списку рахунків клієнта (рахунків під IBAN: %2).'"),
		НазваниеБанка(), Формат(ВсегоПодIBAN, "ЧГ=0")));
	Возврат Неопределено;

КонецФункции

Функция ЗаголовкиДанных(Состояние)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Состояние.Токен);
	Заголовки.Вставить("X-App-Channel", "pure-api");
	// GUID запроса и сессии случайные, отпечаток источника - константа без учетных и персональных данных; в диагностику не попадает.
	Заголовки.Вставить("X-Flow-ID", Строка(Новый УникальныйИдентификатор) + ":" + Состояние.СессияФлоу + ":EX");
	Заголовки.Вставить("Content-Type", "application/json");
	Возврат Заголовки;

КонецФункции

// ЗаписиОтвета searcher без пагинации: обход периода пополам в глубину, ранняя половина первой. Номер документов сквозной по принятым ответам.
Процедура ЧитатьДокументы(Состояние, Параметры, Выписка, Счет, КодВалюты)

	Верх = Мин(Параметры.КонецПериода, Состояние.МоментМестный);
	Стек = Новый Массив;
	Стек.Добавить(Новый Структура("От, До", Параметры.НачалоПериода, Верх));

	Пока Стек.Количество() > 0 Цикл
		Подпериод = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		От = Подпериод.От;
		До = Подпериод.До;

		// Границы запроса (D36 п. 11, run2): целые календарные сутки, обе границы включительно; верх (До) уже не позже момента чтения (Верх).
		ЗапросС = НачалоДня(От);
		ЗапросПо = КонецДня(До);
		Результат = ЗапроситьДокументы(Состояние, Счет, ЗапросС, ЗапросПо);
		Если Результат = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗаписиОтвета = Результат.Значение;
		Если ТипЗнч(ЗаписиОтвета) <> Тип("Массив") Тогда
			Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
				НСтр("ru = 'ответ не массив'; uk = 'відповідь не масив'"), Состояние.УчетныеДанные));
			Возврат;
		КонецЕсли;

		// Аномалия границ (D36 п. 11): ДЕНЬ operationDate вне суток ЗАПРОСА (границы запроса - целые сутки, поэтому сравнение моментов = сравнение дней).
		// Документ тех же суток, но вне периода (подпериода) - не аномалия, а молчаливый отсев фильтром ОбработатьДокумент. Ответ в конверт не берется, «Повторить».
		Аномалия = Ложь;
		Для Каждого Документ Из ЗаписиОтвета Цикл
			Если ТипЗнч(Документ) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Момент = ДатаИзТекстаПУМБ(СтрокаИзJSON(Документ["operationDate"]));
			Если Момент = Неопределено Тогда
				Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
					НСтр("ru = 'дата операции не в формате dd.MM.yyyy HH:mm:ss'; uk = 'дата операції не у форматі dd.MM.yyyy HH:mm:ss'"), Состояние.УчетныеДанные));
				Возврат;
			КонецЕсли;
			Если Момент < ЗапросС Или Момент > ЗапросПо Тогда
				Аномалия = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Аномалия Тогда
			Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), 200,
				НСтр("ru = 'операция вне границ запроса (аномалия границ), ответ не принят'; uk = 'операція поза межами запиту (аномалія меж), відповідь не прийнято'"),
				Состояние.УчетныеДанные));
			Возврат;
		КонецЕсли;

		// Без пагинации (Р4): ответ на пороге - период пополам (ответ не берется, половины перечитают его); сутки на пороге - «ДействиеЧеловека».
		Если ЗаписиОтвета.Количество() >= ПорогОтвета() Тогда
			Половины = ПоловинаПериода(От, До);
			Если Половины = Неопределено Тогда
				Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
					НСтр("ru = 'Банк %1: за сутки %2 банк вернул %3 документов (статус 200) при пороге %4; сутки не делятся, читание остановлено и неполное. Повтор не поможет: сузьте период или обратитесь в банк.';
						|uk = 'Банк %1: за добу %2 банк повернув %3 документів (статус 200) при порозі %4; доба не ділиться, читання зупинено і неповне. Повтор не допоможе: звузьте період або зверніться до банку.'"),
					НазваниеБанка(), Формат(От, "ДФ=dd.MM.yyyy"), Формат(ЗаписиОтвета.Количество(), "ЧГ=0"), Формат(ПорогОтвета(), "ЧГ=0")));
				Возврат;
			КонецЕсли;
			Стек.Добавить(Половины[1]);
			Стек.Добавить(Половины[0]);
			Продолжить;
		КонецЕсли;

		// Тип документа (рішення після run4): невідомий тип - відмова ВСЬОГО читання, операцій цієї відповіді в конверті немає.
		Если ЕстьНеизвестныйТип(Состояние, ЗаписиОтвета, От, До) Тогда
			Возврат;
		КонецЕсли;

		Для Каждого Документ Из ЗаписиОтвета Цикл
			Состояние.Номер = Состояние.Номер + 1;
			ОбработатьДокумент(Состояние, Выписка, Состояние.Номер, Документ, Счет, КодВалюты, От, До);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Типы документа searcher (измерено run4, 60 дней). Движение денег - UAH и CUR_ADV; STM, CUR, CUR_C, CUR_S - известные «не движение»; остальное - неизвестное.
Функция ТипыДвижения()

	Возврат СтрРазделить("UAH,CUR_ADV", ",");

КонецФункции

Функция ТипыНеДвижения()

	Возврат СтрРазделить("STM,CUR,CUR_C,CUR_S", ",");

КонецФункции

// Ищет в ответе документы неизвестного типа (в периоде: вне периода документ отбрасывается молча, как и для остальных правил). Находит - ставит отказ
// «ДействиеЧеловека» с первым неизвестным типом (в порядке документов ответа), числом его документов и первыми сутками; остальные неизвестные типы человек увидит после исправления.
//
// Возвращаемое значение:
//  Булево - Истина, если отказ поставлен.
Функция ЕстьНеизвестныйТип(Состояние, ЗаписиОтвета, ОкноОт, ОкноДо)

	Первый = Неопределено;
	Количество = 0;
	Первые = Неопределено;
	Для Каждого Документ Из ЗаписиОтвета Цикл
		Если ТипЗнч(Документ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Тип = СтрокаИзJSON(Документ["type"]);
		Если ТипыДвижения().Найти(Тип) <> Неопределено Или ТипыНеДвижения().Найти(Тип) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Момент = ДатаИзТекстаПУМБ(СтрокаИзJSON(Документ["operationDate"]));
		Если Момент < ОкноОт Или Момент > ОкноДо Тогда
			Продолжить;
		КонецЕсли;
		Если Первый = Неопределено Тогда
			Первый = Тип;
		КонецЕсли;
		Если Тип = Первый Тогда
			Количество = Количество + 1;
			Первые = ?(Первые = Неопределено, Момент, Мин(Первые, Момент));
		КонецЕсли;
	КонецЦикла;

	Если Первый = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
		НСтр("ru = 'Банк %1: в ответе (статус 200) документ неизвестного типа %2 (документов этого типа %3, первые сутки %4); чтение остановлено и неполное. Повтор не поможет: нужно решить, движение ли это денег.';
			|uk = 'Банк %1: у відповіді (статус 200) документ невідомого типу %2 (документів цього типу %3, перша доба %4); читання зупинено і неповне. Повтор не допоможе: потрібно вирішити, чи це рух коштів.'"),
		НазваниеБанка(), ?(ПустаяСтрока(Первый), НСтр("ru = '(не задан)'; uk = '(не заданий)'"), Первый), Формат(Количество, "ЧГ=0"), Формат(Первые, "ДФ=dd.MM.yyyy")));
	Возврат Истина;

КонецФункции

// Делит период [От, До] пополам по СУТКАМ: первая половина - Цел(суток / 2), вторая - остаток; граница - полночь; половины без промежутка и перекрытия
// ([От, полночь - 1 с] и [полночь, До]). Период в пределах суток не делится.
//
// Возвращаемое значение:
//  Массив из Структура (От, До), Неопределено - период в пределах одних суток.
Функция ПоловинаПериода(От, До)

	Суток = Цел((НачалоДня(До) - НачалоДня(От)) / 86400) + 1;
	Если Суток < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Полночь = НачалоДня(От) + Цел(Суток / 2) * 86400;
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("От, До", От, Полночь - 1));
	Результат.Добавить(Новый Структура("От, До", Полночь, До));
	Возврат Результат;

КонецФункции

Функция ЗапроситьДокументы(Состояние, Счет, От, До)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("fromDate");
	Запись.ЗаписатьЗначение(ТекстДаты(От));
	Запись.ЗаписатьИмяСвойства("toDate");
	Запись.ЗаписатьЗначение(ТекстДаты(До));
	Запись.ЗаписатьИмяСвойства("documentAccounts");
	Запись.ЗаписатьНачалоМассива();
	Запись.ЗаписатьЗначение(Счет.Идентификатор);
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Тело = Запись.Закрыть();

	Возврат ВыполнитьЗапрос(Состояние, "POST", АдресСервиса("/document/searcher"), ЗаголовкиДанных(Состояние), Тело);

КонецФункции

// Один запрос через транспорт. Возвращает Структуру (Значение - прочитанный JSON) или Неопределено после Отказать. Паузы нет: банк лимит частоты не заявляет
// (429 - «Повторить» без повтора, модель Step 3).
Функция ВыполнитьЗапрос(Состояние, Метод, Адрес, Заголовки, Тело)

	Ответ = Состояние.Транспорт.ВыполнитьЗапрос(Метод, Адрес, Заголовки, Тело);

	Если Ответ.Сбой Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: ответа нет (%2): %3'; uk = 'Банк %1: відповіді немає (%2): %3'"), НазваниеБанка(), Ответ.ВидСбоя, Ответ.ТекстСбоя));
		Возврат Неопределено;
	КонецЕсли;

	Тело = СМП_КоннекторыБанковОбщее.ПрочитатьJSONИзТела(Ответ.Тело, СМП_КоннекторыБанковОбщее.КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8"));

	Если Ответ.Статус <> 200 Тогда
		Класс = СМП_КоннекторыБанковОбщее.КлассОтказаПоСтатусуHTTP(Ответ.Статус);
		Если Класс = "" Тогда
			Класс = "Повторить";
		КонецЕсли;
		Описание = ВырезатьЗначения(ОписаниеБанка(Тело), Состояние.УчетныеДанные);
		Отказать(Состояние, Класс, СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус, Описание, Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Если Не Тело.Успех Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус, Тело.Текст, Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Значение", Тело.Значение);

КонецФункции

// Описание ошибки банка: error_description (Keycloak / OAuth2), затем errorDescription, message; нет - пусто.
Функция ОписаниеБанка(Тело)

	Если Не Тело.Успех Или ТипЗнч(Тело.Значение) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("error_description,errorDescription,message", ",") Цикл
		Значение = Тело.Значение[Имя];
		Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
			Возврат СтрокаИзJSON(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Вырезает значения учетных данных из описания банка без учета регистра: вместо каждого вхождения - метка; длинные значения первыми.
Функция ВырезатьЗначения(Текст, УчетныеДанные)

	Значения = Новый Массив;
	Для Каждого Элемент Из УчетныеДанные Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") И Не ПустаяСтрока(Элемент.Значение) Тогда
			Значения.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Длина");
	Для Каждого Значение Из Значения Цикл
		Строка = Таблица.Добавить();
		Строка.Значение = Значение;
		Строка.Длина = СтрДлина(Значение);
	КонецЦикла;
	Таблица.Сортировать("Длина Убыв");

	Результат = Текст;
	Для Каждого Строка Из Таблица Цикл
		Нижний = НРег(Строка.Значение);
		Позиция = СтрНайти(НРег(Результат), Нижний);
		Пока Позиция > 0 Цикл
			Результат = Лев(Результат, Позиция - 1) + МеткаВырезано() + Сред(Результат, Позиция + Строка.Длина);
			Следующая = Позиция + СтрДлина(МеткаВырезано());
			Позиция = ?(Следующая > СтрДлина(Результат), 0, СтрНайти(НРег(Результат), Нижний, НаправлениеПоиска.СНачала, Следующая));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МеткаВырезано()

	Возврат "<вирізано>";

КонецФункции

Процедура Отказать(Состояние, Класс, Текст)

	Если Состояние.Отказ = Неопределено Тогда
		Состояние.Отказ = Новый Структура("Класс, Тексты", Класс, Новый Массив);
	КонецЕсли;
	Состояние.Отказ.Тексты.Добавить(СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(Текст, Состояние.УчетныеДанные));

КонецПроцедуры

// Один документ searcher: окно периода -> тип (не движение) -> состояние -> идентификатор -> сторона счета -> направление -> валюта -> сумма -> операция.
Процедура ОбработатьДокумент(Состояние, Выписка, Номер, Документ, Счет, КодВалюты, ОкноОт, ОкноДо)

	Если ТипЗнч(Документ) <> Тип("Соответствие") Тогда
		ДобавитьДиагностику(Выписка, "Ошибка", Номер, НСтр("ru = 'Банк ПУМБ: запись выписки не объект JSON.'; uk = 'Банк ПУМБ: запис виписки не є об''єктом JSON.'"));
		Возврат;
	КонецЕсли;

	Момент = ДатаИзТекстаПУМБ(СтрокаИзJSON(Документ["operationDate"]));
	// Вне периода (подпериода), но в сутках запроса - отбрасывается молча (точный период - фильтр коннектора по operationDate); номер остается занятым (D36 п. 11).
	Если Момент < ОкноОт Или Момент > ОкноДо Тогда
		Возврат;
	КонецЕсли;

	// Известные «не движение» (измерено run4): STM - ежедневная запись остатка счета; CUR, CUR_C, CUR_S - заявки, у каждой есть пара на гривневом счете,
	// движение валюты банк отдает авизо CUR_ADV. Не операция, диагностики нет. Неизвестный тип сюда не доходит: ответ с ним отклонен целиком (ЕстьНеизвестныйТип).
	Если ТипыНеДвижения().Найти(СтрокаИзJSON(Документ["type"])) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = СтрокаИзJSON(Документ["docId"]);

	// Состояния (отступ 3): PROCESSED - операция; скасованный и неостаточный - Предупреждение; неизвестный - Ошибка.
	СостояниеДокумента = СтрокаИзJSON(Документ["state"]);
	Если СостояниеДокумента <> "PROCESSED" Тогда
		Если СостояниеСкасовано(СостояниеДокумента) Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: документ %1 в состоянии %2 отклонен и не загружен.'; uk = 'Банк ПУМБ: документ %1 у стані %2 відхилено і не завантажено.'"),
				Идентификатор, СостояниеДокумента));
		ИначеЕсли СостояниеНеостаточно(СостояниеДокумента) Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: документ %1 в состоянии %2 еще не проведен и не загружен; граница доверия не позже его времени.';
					|uk = 'Банк ПУМБ: документ %1 у стані %2 ще не проведено і не завантажено; межа довіри не пізніше його часу.'"),
				Идентификатор, СостояниеДокумента));
			Состояние.Неостаточные.Добавить(Момент);
		Иначе
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: документ %1 в неизвестном состоянии %2.'; uk = 'Банк ПУМБ: документ %1 у невідомому стані %2.'"),
				Идентификатор, СостояниеДокумента));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// Идентификатор операции - docId: от 1 до 50 символов (D28); длина без значения.
	Если СтрДлина(Идентификатор) < 1 Или СтрДлина(Идентификатор) > 50 Тогда
		ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Банк ПУМБ: идентификатор документа (docId) пуст или длиннее 50 символов (длина %1).';
				|uk = 'Банк ПУМБ: ідентифікатор документа (docId) порожній або довший за 50 символів (довжина %1).'"), Формат(СтрДлина(Идентификатор), "ЧГ=0")));
		Возврат;
	КонецЕсли;

	Отправитель = СтрокаИзJSON(Документ["senderIBAN"]);
	Получатель = СтрокаИзJSON(Документ["correspondentIBAN"]);
	Сторона = СторонаСчета(Состояние.НомерСчета, Счет, Документ, Отправитель, Получатель);
	Если Сторона = "" Тогда
		Если ПустаяСтрока(Отправитель) И ПустаяСтрока(Получатель) Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: у документа %1 нет IBAN ни одной из сторон, и номер счета не совпал с запрошенным: чей это документ, не установить.';
					|uk = 'Банк ПУМБ: у документа %1 немає IBAN жодної зі сторін, і номер рахунку не збігся із запитаним: чий це документ, не встановити.'"), Идентификатор));
		Иначе
			Состояние.ЧужихДокументов = Состояние.ЧужихДокументов + 1;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Исходящая = Сторона = "исходящая";

	// Направление по ознаке банка против стороны счета: расхождение - Ошибка (знак движения денег хуже пропущенной операции); пустое - не расхождение.
	Направление = СтрокаИзJSON(Документ["direction"]);
	Если Не ПустаяСтрока(Направление) Тогда
		Если Направление <> "OUTBOUND" И Направление <> "INBOUND" Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: у документа %2 неизвестное направление direction %1.'; uk = 'Банк ПУМБ: у документа %2 невідомий напрям direction %1.'"), Направление, Идентификатор));
			Возврат;
		ИначеЕсли (Направление = "OUTBOUND") <> Исходящая Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: у документа %1 направление банка не совпадает со стороной запрошенного счета; документ не загружен.';
					|uk = 'Банк ПУМБ: у документа %1 напрям банку не збігається зі стороною запитаного рахунку; документ не завантажено.'"), Идентификатор));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Валюта документа (отступ 1/2): не определена - Предупреждение, операция идет; чужая относительно валюты счета - Предупреждение, операции нет.
	ТекстВалюты = СтрокаИзJSON(Документ["currencyCode"]);
	ВалютаДокумента = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(ТекстВалюты);
	Если ВалютаДокумента = Неопределено Или ВалютаДокумента = "" Тогда
		ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
			НСтр("ru = 'Банк ПУМБ: у документа %1 валюта %2 не определена; документ загружен как гривна.';
				|uk = 'Банк ПУМБ: у документа %1 валюта %2 не визначена; документ завантажено як гривню.'"), Идентификатор, ТекстВалюты));
	Иначе
		ВалютаСчета = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(Счет.Валюта);
		Если Не ПустаяСтрока(ВалютаСчета) И ВалютаСчета <> Неопределено И ВалютаДокумента <> ВалютаСчета Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'Банк ПУМБ: документ %1 в валюте %2, а валюта счета другая: операция не загружена.';
					|uk = 'Банк ПУМБ: документ %1 у валюті %2, а валюта рахунку інша: операцію не завантажено.'"), Идентификатор, ВалютаДокумента));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Сумма: нерозбираемая, нулевая или отрицательная - Ошибка, не операция (D28).
	Сумма = СуммаИзJSON(Документ["amount"]);
	Если Сумма = Неопределено Или Сумма <= 0 Тогда
		ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Банк ПУМБ: у документа %1 сумма не положительное число.'; uk = 'Банк ПУМБ: у документа %1 сума не є додатним числом.'"), Идентификатор));
		Возврат;
	КонецЕсли;

	Контрагент = ?(Исходящая, "correspondent", "sender");

	Операция = Выписка.Операции.Добавить();
	Операция.ПорядковыйНомер = Номер;
	Операция.НомерСчета = Состояние.НомерСчета;
	Операция.Валюта = КодВалюты;
	Операция.ДатаОперации = Момент;
	Операция.НомерДокумента = Идентификатор;
	Операция.ДатаДокумента = НачалоДня(Момент);
	Операция.Сумма = Сумма;
	Операция.Направление = ?(Исходящая, "Списано", "Поступило");
	Операция.ИдентификаторОперации = Идентификатор;
	Операция.КонтрагентНаименование = СтрокаИзJSON(Документ[Контрагент + "Name"]);
	Операция.КонтрагентНомерСчета = ?(Исходящая, Получатель, Отправитель);
	Операция.КонтрагентКод = СтрокаИзJSON(Документ[Контрагент + "TaxId"]);
	Операция.КонтрагентМФО = СтрокаИзJSON(Документ[Контрагент + "BankMfo"]);
	Операция.НазначениеПлатежа = СтрокаИзJSON(Документ["description"]);
	Операция.СырыеДанные = ТекстJSON(Документ);

КонецПроцедуры

// Фильтр конектора по счету (отступ 1): документ наш, если запрошенный IBAN среди сторон, или номер запрошенного счета (number/altNumber) среди номеров сторон;
// IBAN старше номера.
//
// Возвращаемое значение:
//  Строка - "исходящая" (счет - отправитель), "входящая" (счет - получатель), "" (чужой).
Функция СторонаСчета(Свой, Счет, Документ, Отправитель, Получатель)

	Если Отправитель = Свой Тогда
		Возврат "исходящая";
	ИначеЕсли Получатель = Свой Тогда
		Возврат "входящая";
	КонецЕсли;
	НомерОтправителя = СокрЛП(СтрокаИзJSON(Документ["senderAccountNumber"]));
	Если Счет.Номера.Найти(НомерОтправителя) <> Неопределено Тогда
		Возврат "исходящая";
	КонецЕсли;
	НомерПолучателя = СокрЛП(СтрокаИзJSON(Документ["correspondentAccountNumber"]));
	Если Счет.Номера.Найти(НомерПолучателя) <> Неопределено Тогда
		Возврат "входящая";
	КонецЕсли;
	Возврат "";

КонецФункции

// Скасованные состояния документа (enum VeganetDocumentItem.state, swagger).
Функция СостояниеСкасовано(Значение)

	Возврат Значение = "REJECTED" Или Значение = "REJECTED_BY_ACCO" Или Значение = "REJECTED_BY_OPER" Или Значение = "SYSTEM_ERROR";

КонецФункции

// Неостаточные состояния документа (enum VeganetDocumentItem.state, swagger); PROCESSED - проведен.
Функция СостояниеНеостаточно(Значение)

	Возврат Значение = "INPUT" Или Значение = "ACCEPTING" Или Значение = "ACCEPTED" Или Значение = "READY_TO_SEND" Или Значение = "SENDING"
		Или Значение = "TAKE_IN" Или Значение = "ROUTED" Или Значение = "UPLOADED" Или Значение = "ACCEPTED_BY_ACCO" Или Значение = "ACCEPTED_BY_OPER"
		Или Значение = "SENT_TO_EPS";

КонецФункции

// Сумма из JSON: строка (запятая или точка, пробелы) или число; нечитаемое - Неопределено.
Функция СуммаИзJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Окр(Значение, 2);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Значение), Символ(160), ""), " ", ""), ",", ".");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Окр(Число(Текст), 2);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Дата из формата dd.MM.yyyy HH:mm:ss (гипотеза, до замера), киевское местное время; иной формат - Неопределено.
Функция ДатаИзТекстаПУМБ(Текст)

	Если СтрДлина(Текст) <> 19 Или Сред(Текст, 3, 1) <> "." Или Сред(Текст, 6, 1) <> "." Или Сред(Текст, 11, 1) <> " "
		Или Сред(Текст, 14, 1) <> ":" Или Сред(Текст, 17, 1) <> ":" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цифры = Лев(Текст, 2) + Сред(Текст, 4, 2) + Сред(Текст, 7, 4) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2) + Прав(Текст, 2);
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Результат = Дата(Число(Сред(Текст, 7, 4)), Число(Сред(Текст, 4, 2)), Число(Лев(Текст, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Прав(Текст, 2)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТекстДаты(Результат) <> Текст Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ТекстДаты(Значение)

	Возврат Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'");

КонецФункции

Функция Кодировать(Значение)

	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция СтрокаИзJSON(Значение)

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ДобавитьДиагностику(Выписка, Уровень, Номер, Текст)

	Строка = Выписка.Диагностика.Добавить();
	Строка.Уровень = Уровень;
	Строка.ПорядковыйНомер = Номер;
	Строка.Текст = Текст;

КонецПроцедуры

#КонецОбласти
