// Запись документов банка по плану загрузки (план 04): из строк плана создает и проводит ПоступлениеНаСчет / РасходСоСчета.
//
// Граница ответственности: модуль ПИШЕТ документы (и, начиная с задачи 4, общие объекты пакета); разбор выписки и распознавание
// - СМП_ВыпискаБанка и СМП_РаспознаваниеОпераций. Результат - данные (таблицы), не сообщения пользователю: форма и регламент
// (этапы 5 и 6) показывают его сами.
//
// Инварианты (D3, D5, D7, D16, D17, D20, D35.5):
//  - наличный документ не открывается для записи и не проводится (D5); помеченный на удаление остается помеченным;
//  - каждая операция - документ (D3): нехватка данных дает непроведенный документ с причиной в результате;
//  - документ - отдельная единица записи: ошибка одного не откатывает и не блокирует остальные;
//  - ничего не удаляется и не помечается на удаление (D7);
//  - автор и настройки - ответственного из контекста; обращения к текущему пользователю сеанса в модуле нет (D16);
//  - история выбора значений реквизитов (ИсторияЗначенийРеквизитовПриЗагрузкеИзКлиентаБанка) не пишется (D11).

#Область ПрограммныйИнтерфейс

#Область Литералы

// Результат строки: документ записан и проведен.
Функция РезультатСоздан() Экспорт

	Возврат "Создан";

КонецФункции

// Результат строки: документ записан, но не проведен; причина - замечание уровня "Ошибка".
Функция РезультатСозданНепроведенным() Экспорт

	Возврат "СозданНепроведенным";

КонецФункции

// Результат строки: документ операции уже есть в базе, его не трогали.
Функция РезультатУжеЗагружен() Экспорт

	Возврат "УжеЗагружен";

КонецФункции

// Результат строки: документ не записан; причина - замечание уровня "Ошибка".
Функция РезультатОшибка() Экспорт

	Возврат "Ошибка";

КонецФункции

#КонецОбласти

// Новый контекст записи.
//
// Возвращаемое значение:
//  Структура - контекст:
//   * Ответственный - СправочникСсылка.Пользователи - ОБЯЗАТЕЛЬНЫЙ (D16): автор документов и источник настроек. Регламент берет
//     его из учетной записи (этап 5), интерактив - текущего пользователя (этап 6; это делает форма, не модуль записи).
//   * ГруппаДоступаКонтрагентов - СправочникСсылка.ГруппыДоступаКонтрагентов - необязательная: группа доступа новых
//     контрагентов (D26); по умолчанию пустая. Реквизит учетной записи ГруппаДоступаДляНовыхКонтрагентов.
Функция НовыйКонтекстЗаписи() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
	Контекст.Вставить("ГруппаДоступаКонтрагентов", Справочники.ГруппыДоступаКонтрагентов.ПустаяСсылка());
	Возврат Контекст;

КонецФункции

// Новый пустой результат записи.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Операции - ТаблицаЗначений - строка на строку плана:
//    ** ПорядковыйНомер - Число - из плана.
//    ** Документ - ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета - созданный или уже загруженный документ;
//       пуст, только если документ не удалось даже записать.
//    ** Результат - Строка - РезультатСоздан / РезультатСозданНепроведенным / РезультатУжеЗагружен / РезультатОшибка.
//    ** СозданКонтрагент - СправочникСсылка.Контрагенты - созданный этой записью объект или пусто.
//    ** СозданСчет - СправочникСсылка.БанковскиеСчета - созданный этой записью объект или пусто.
//    ** СозданДоговор - СправочникСсылка.ДоговорыКонтрагентов - созданный этой записью объект или пусто.
//   * Замечания - ТаблицаЗначений - та же схема, что в плане (ПорядковыйНомер, Поле, Уровень, Текст). Причина результатов
//     "СозданНепроведенным" и "Ошибка" - замечание уровня "Ошибка"; прочее (основу не взяли, документ найден повторной
//     проверкой) - "Предупреждение". Замечания распознавания в результат не копируются.
Функция НовыйРезультатЗаписи() Экспорт

	Результат = Новый Структура;

	Операции = Новый ТаблицаЗначений;
	Операции.Колонки.Добавить("ПорядковыйНомер",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Операции.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета"));
	Операции.Колонки.Добавить("Результат", ОписаниеСтроки());
	Операции.Колонки.Добавить("СозданКонтрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Операции.Колонки.Добавить("СозданСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Операции.Колонки.Добавить("СозданДоговор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Результат.Вставить("Операции", Операции);

	Замечания = Новый ТаблицаЗначений;
	Замечания.Колонки.Добавить("ПорядковыйНомер",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	Замечания.Колонки.Добавить("Поле", ОписаниеСтроки());
	Замечания.Колонки.Добавить("Уровень", ОписаниеСтроки());
	Замечания.Колонки.Добавить("Текст", ОписаниеСтроки());
	Результат.Вставить("Замечания", Замечания);

	Возврат Результат;

КонецФункции

// Записывает план: для каждой строки, у которой документа еще нет, создает и пытается провести документ.
//
// ВЫЗЫВАТЬ ПОЗА ТРАНЗАКЦИЕЙ; в транзакции вызова отказ проведения одного документа (исключение из обработки проведения)
// сломает весь пакет: платформа не дает продолжить работу с базой в транзакции, где была ошибка. Гипотеза плана (не выведена
// измерением): вне внешней транзакции Записать() документа фиксируется, а исключение следующего Записать(Проведение) откатывает
// только проведение - документ остается записанным непроведенным (проверка - план 4б). Проверки ТранзакцияАктивна() модуль
// не делает: это условие вызова, а не проверка во время выполнения.
//
// Очередь сообщений пользователя очищается перед проверкой заполнения каждого документа (иначе в причины попали бы
// посторонние сообщения): это уничтожает и сообщения, накопленные вызывающим кодом до Записать. Для регламента безвредно;
// как вести себя форме (этап 6) - решение этапа 6.
//
// Три прохода, порядок обязателен:
//  1. повторная проверка ВСЕГО пакета (D35.5) - одним проходом, до создания первого документа: проверка перед каждой строкой
//     сочла бы документ, только что созданный этим же вызовом, наличным для следующей такой же операции (D35.4б);
//  2. общие объекты пакета (контрагент, счет, договор, на которые ссылаются несколько документов) - ОТДЕЛЬНАЯ единица записи,
//     до документов: откат документа не должен оставить другие документы со ссылкой на несуществующий объект или создать объект
//     дважды. Способ (с транзакциями или без) определяется зондом задачи 0; в задаче 3 шаг - точка расширения для задачи 4;
//  3. документы - по одному, каждый независимо.
//
// Параметры:
//  План - Структура - см. СМП_РаспознаваниеОпераций.НовыйПланЗагрузки; не изменяется.
//  Контекст - Структура - см. НовыйКонтекстЗаписи; Ответственный обязателен: пустой - исключение до записи любого документа.
//
// Возвращаемое значение:
//  Структура - см. НовыйРезультатЗаписи.
Функция Записать(План, Контекст) Экспорт

	Если Не ЗначениеЗаполнено(Контекст.Ответственный) Тогда
		ВызватьИсключение НСтр("ru = 'Записать: поле контекста ""Ответственный"" не заполнено, оно обязательно (автор документов).';
			|uk = 'Записати: поле контексту ""Відповідальний"" не заповнено, воно потрібне (автор документів).'");
	КонецЕсли;

	Результат = НовыйРезультатЗаписи();

	// Проход 1.
	НайденныеПовторно = СМП_РаспознаваниеОпераций.ЗагруженныеДокументыСтрокПлана(План);

	// Проход 2.
	Объекты = ЗаписатьОбщиеОбъектыПакета(План, Контекст, Результат, НайденныеПовторно);

	// Проход 3.
	Для Каждого СтрокаПлана Из План.Операции Цикл
		СтрокаРезультата = Результат.Операции.Добавить();
		СтрокаРезультата.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер;
		ОбъектыСтроки = Объекты.Получить(СтрокаПлана.ПорядковыйНомер);
		ОтметитьСозданныеОбъекты(СтрокаРезультата, ОбъектыСтроки);

		Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			// D5: документ не открывается для записи, пометка на удаление не снимается.
			СтрокаРезультата.Документ = СтрокаПлана.ЗагруженныйДокумент;
			СтрокаРезультата.Результат = РезультатУжеЗагружен();
			Продолжить;
		КонецЕсли;

		ДокументПовторно = НайденныеПовторно.Получить(СтрокаПлана);
		Если ДокументПовторно <> Неопределено Тогда
			СтрокаРезультата.Документ = ДокументПовторно;
			СтрокаРезультата.Результат = РезультатУжеЗагружен();
			ДобавитьЗамечание(Результат, СтрокаПлана.ПорядковыйНомер, "ЗагруженныйДокумент",
				СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Документ операции найден повторной проверкой перед записью: операцию загрузил другой запуск после распознавания.';
					|uk = 'Документ операції знайдено повторною перевіркою перед записом: операцію завантажив інший запуск після розпізнавання.'"));
			Продолжить;
		КонецЕсли;

		ЗаписатьДокументСтроки(Результат, СтрокаРезультата, СтрокаПлана, Контекст, ОбъектыСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет ОТКРЫТЫЙ объект документа фактами банка и решениями строки плана так, как заполнила бы форма вендора (задача 5).
// Создание объекта, заполнение и запись/проведение - отдельные шаги: тем же заполнением этап 6 заполнит наличный документ. Не пишет в
// базу.
//
// Порядок: штатное Заполнить вендора с ключами НАСТРОЕК ОТВЕТСТВЕННОГО (D16) -> факты банка -> реквизиты по виду операции (контрагент и
// договор для видов с расчетами, подотчетник, вид налога, счет перевода, корреспонденция) -> статья, проект, подразделение -> ставка НДС
// -> автор. Данные плана важнее значений по умолчанию (D15). Суммы разнесения и основу добавляет задача 7.
//
// Параметры:
//  Документ - ДокументОбъект.ПоступлениеНаСчет, ДокументОбъект.РасходСоСчета - открытый (новый или наличный) документ.
//  СтрокаПлана - СтрокаТаблицыЗначений - строка План.Операции.
//  Контекст - Структура - см. НовыйКонтекстЗаписи.
//  ОбъектыСтроки - Структура, Неопределено - объекты, созданные этой записью для строки (проход 2): Контрагент, СчетКонтрагента,
//    Договор (ссылка или Неопределено). Заполненные перекрывают одноименные колонки плана: план не меняется, поэтому созданные
//    объекты в него не попадают.
Процедура ЗаполнитьДокументПоСтрокеПлана(Документ, СтрокаПлана, Контекст, ОбъектыСтроки = Неопределено) Экспорт

	ДатаЗаписи = ДатаДокументаЗаписи(СтрокаПлана);
	ЭтоРасход = (ТипЗнч(Документ) = Тип("ДокументОбъект.РасходСоСчета"));
	ВидОперации = СтрокаПлана.ВидОперации;
	Контрагент = ОбъектСтроки(ОбъектыСтроки, "Контрагент", СтрокаПлана.Контрагент);
	СчетКонтрагента = ОбъектСтроки(ОбъектыСтроки, "СчетКонтрагента", СтрокаПлана.СчетКонтрагента);
	Договор = ОбъектСтроки(ОбъектыСтроки, "Договор", СтрокаПлана.Договор);
	ВидСКонтрагентом = СМП_РаспознаваниеОпераций.ВидОперацииТребуетКонтрагента(ВидОперации);
	КонтрагентДокумента = ?(ВидСКонтрагентом И ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контрагент),
		Контрагент, Справочники.Контрагенты.ПустаяСсылка());

	// Штатное заполнение вендора: значения по умолчанию документа. Оно берет автора и настройки пользователя СЕАНСА (измерено в
	// задаче 1), поэтому настройки ОТВЕТСТВЕННОГО подаются ключами данных (ключи побеждают настройки сеанса - находка 2 задачи 1,
	// ДополнитьСтруктуру без перезаписи), а автор присваивается ПОСЛЕ заполнения. Ключи подаются и когда значение пусто: пустой ключ
	// тоже не дает подставить настройку сеанса. Структура мутируется вендором - у каждого документа своя.
	Настройки = НастройкиОтветственного(Контекст.Ответственный);
	ИмяПодразделенияШапки = ?(ЭтоРасход, "Подразделение", "ПодразделениеЗатраты");
	Данные = Новый Структура;
	Данные.Вставить("Организация", СтрокаПлана.Организация);
	Данные.Вставить("ВидОперации", ВидОперации);
	Данные.Вставить("БанковскийСчет", СтрокаПлана.БанковскийСчет);
	Если ЗначениеЗаполнено(КонтрагентДокумента) Тогда
		Данные.Вставить("Контрагент", КонтрагентДокумента);
		Если ЗначениеЗаполнено(Договор) Тогда
			Данные.Вставить("Договор", Договор);
		КонецЕсли;
	КонецЕсли;
	Данные.Вставить("ПоложениеСтатьи", Настройки.ПоложениеСтатьи);
	Данные.Вставить("ПоложениеПодразделения", Настройки.ПоложениеПодразделения);
	Данные.Вставить("ПоложениеПроекта", Настройки.ПоложениеПроекта);
	Данные.Вставить(ИмяПодразделенияШапки, Настройки.Подразделение);
	Документ.Дата = ДатаЗаписи;
	Документ.Заполнить(Данные);

	Документ.Дата = ДатаЗаписи;
	Документ.УстановитьНовыйНомер();
	Документ.Организация = СтрокаПлана.Организация;
	Документ.ВидОперации = ВидОперации;
	Документ.БанковскийСчет = СтрокаПлана.БанковскийСчет;
	Документ.ВалютаДенежныхСредств = СтрокаПлана.БанковскийСчет.ВалютаДенежныхСредств;
	Документ.СуммаДокумента = СтрокаПлана.Сумма;
	Документ.НазначениеПлатежа = СтрокаПлана.НазначениеПлатежа;
	Документ.НалогообложениеНДС = НалогиУНФ.НалогообложениеНДС(СтрокаПлана.Организация, , ДатаЗаписи);

	// Входящие номер и дата - тем же правилом, что составной ключ шага 0 (D17): день документа операции, а при пустой дате
	// документа - день даты операции. Одна функция с шагом 0, не повтор правила: документ узнает сам себя при повторной загрузке.
	Документ.НомерВходящегоДокумента = СМП_РаспознаваниеОпераций.НомерВходящегоДокументаОперации(СтрокаПлана);
	Документ.ДатаВходящегоДокумента = СМП_РаспознаваниеОпераций.ДеньДокументаОперации(СтрокаПлана);

	// Идентификатор - без пробелов по краям: шаг 0 ищет по нормализованному значению (одна функция с шагом 0). Длиннее реквизита
	// он сюда не доходит: ЗаписатьДокументСтроки отказывает до создания документа.
	Идентификатор = СМП_РаспознаваниеОпераций.ИдентификаторОперацииСтроки(СтрокаПлана);
	Если Не ПустаяСтрока(Идентификатор) Тогда
		Документ.СМП_ИДТранзакцииБанка = Идентификатор;
	КонецЕсли;

	// Реквизиты по виду операции. Виды без расчетов (переводы, зарплата, налоги, "Прочее", личные средства) контрагента и строки
	// расшифровки не получают (журнал плана 04, задача 1, находка 13); виды, которым нужны данные вендорских подсистем, продукт
	// не доукомплектовывает: документ не пройдет ПроверитьЗаполнение и останется непроведенным с причиной.
	Если ЗначениеЗаполнено(КонтрагентДокумента) Тогда
		Документ.Контрагент = КонтрагентДокумента;
		Если ЗначениеЗаполнено(СчетКонтрагента) Тогда
			Документ.СчетКонтрагента = СчетКонтрагента;
		КонецЕсли;
	КонецЕсли;
	Если ЭтоВидПеревода(ВидОперации) И ЗначениеЗаполнено(СчетКонтрагента) Тогда
		Документ.СчетКонтрагента = СчетКонтрагента;
	КонецЕсли;
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Сотрудники") И ЗначениеЗаполнено(Контрагент)
		И Документ.Метаданные().Реквизиты.Найти("Подотчетник") <> Неопределено Тогда
		// Зарплата сотруднику и выдача подотчетнику: сотрудник в реквизите Подотчетник (находка 13), контрагента нет.
		Документ.Подотчетник = Контрагент;
	КонецЕсли;
	Если ВидОперацииНалоги(ВидОперации) И ЗначениеЗаполнено(СтрокаПлана.ВидНалога) Тогда
		// Вид налога плана; пустой - документ непроведен с причиной (D12), продукт его не выдумывает.
		Документ.ВидНалога = СтрокаПлана.ВидНалога;
	КонецЕсли;

	// Корреспонденция: данные плана (правило, поручение) не перебиваются (D35.10); пустая - по виду операции. Источник правила:
	// ФормыДокументовДеньги.ЗаполнитьКорреспонденцию (процедура приватная, вызвать ее нельзя): личные средства предпринимателя -
	// НераспределеннаяПрибыль, комиссия банка - ПрочиеРасходы. Ветка вендора для выключенной опции "ОтображатьСчетаУчета" (корреспонденцию
	// "Прочее"/"На расходы"/"Прочие расчеты" форма ставит сама) не перенесена: в измеренной базе опция включена.
	Если ЗначениеЗаполнено(СтрокаПлана.Корреспонденция) Тогда
		Документ.Корреспонденция = СтрокаПлана.Корреспонденция;
	Иначе
		КорреспонденцияПоВиду = КорреспонденцияПоВидуОперации(ВидОперации);
		Если ЗначениеЗаполнено(КорреспонденцияПоВиду) Тогда
			Документ.Корреспонденция = КорреспонденцияПоВиду;
		КонецЕсли;
	КонецЕсли;

	// Строку расшифровки Заполнить(Контрагент, Договор) с сервера не создает (задача 1, находка 6): это делает обработчик ФОРМЫ.
	// Достаточный набор (находка 13): договор, суммы, курс, ставка. Платеж без документа основания - аванс; основу и разнесение по
	// долгам добавит задача 7.
	Если ЗначениеЗаполнено(КонтрагентДокумента) И ЗначениеЗаполнено(Договор)
		И СМП_РаспознаваниеОпераций.ВидОперацииТребуетДоговор(ВидОперации) Тогда
		Документ.РасшифровкаПлатежа.Очистить();
		Строка = Документ.РасшифровкаПлатежа.Добавить();
		Строка.Договор = Договор;
		Строка.ПризнакАванса = Истина;
		Строка.Курс = 1;
		Строка.Кратность = 1;
		Строка.СуммаПлатежа = СтрокаПлана.Сумма;
		Строка.СуммаРасчетов = СтрокаПлана.Сумма;
		// Способ зачета (D34, задача 6): основы у строки нет (задача 7 добавит строки таблицы с основой в СпособЗачетаСтрокиПлана).
		СозданоЗаписью = ЗначениеЗаполнено(ОбъектСтроки(ОбъектыСтроки, "Контрагент", Неопределено))
			Или ЗначениеЗаполнено(ОбъектСтроки(ОбъектыСтроки, "Договор", Неопределено));
		Строка.СпособЗачета = СпособЗачетаСтрокиПлана(ВидОперации, Договор, КонтрагентДокумента, СозданоЗаписью);
		ЗаполнитьСтавкуНДССтроки(Документ, Строка, СтрокаПлана, Договор, ДатаЗаписи, ЭтоРасход);
	КонецЕсли;

	// Статья: данные плана (D14: правило, договор, контрагент), иначе вендорская статья ПО ВИДУ ОПЕРАЦИИ (задача 1, находка 5:
	// ПолучитьДанныеСтатьиДДС вызывается с сервера без формы; статья контрагента в ней приоритетнее статьи вида).
	Статья = СтрокаПлана.СтатьяДДС;
	Если Не ЗначениеЗаполнено(Статья) Тогда
		Статья = ФормыДокументовДеньги.ПолучитьДанныеСтатьиДДС(Новый Структура("Объект", Документ)).Статья;
	КонецЕсли;

	// Проект: проект правила важнее проекта договора (D35.1); договора - вендорской функцией при включенном учете по проектам
	// (находка 9; функция берет дату сеанса, а не дату документа). Подразделение: подразделение правила, иначе основное подразделение
	// ответственного (D16).
	Проект = СтрокаПлана.Проект;
	Если Не ЗначениеЗаполнено(Проект) И ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(КонтрагентДокумента)
		И ПолучитьФункциональнуюОпцию("УчетПоПроектам") Тогда
		Проект = Справочники.Проекты.ПолучитьПроектПоДоговору(Договор);
	КонецЕсли;
	Подразделение = ?(ЗначениеЗаполнено(СтрокаПлана.Подразделение), СтрокаПлана.Подразделение, Настройки.Подразделение);

	РазложитьАналитикуПоПоложению(Документ, ИмяПодразделенияШапки, Статья, Проект, Подразделение);

	// D16: автор - ответственный, не пользователь сеанса.
	Документ.Автор = Контекст.Ответственный;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проход 2: общие объекты пакета (контрагент, счет, договор) создаются здесь, ДО документов, отдельной единицей записи каждый:
// объект записывается своей записью (платформа делает ее транзакцией), и документ, который потом не записался или не проведен,
// объект не откатывает; следующий документ с тем же контрагентом находит его в Объекты. Порядок: контрагенты, договоры
// (договору нужен контрагент), счета (счету нужен контрагент).
//
// Создаются объекты только строк, для которых документ будет записываться: загруженные и найденные повторно строки, а также строки
// без вида документа, операции или организации пропускаются. Строка с отказом по длине идентификатора операции объекты создает
// (отказ документа наступает после создания объектов, и они остаются: другая строка пакета того же контрагента их использует).
//
// Объект, не прошедший ПроверитьЗаполнение или не записанный, не создается: причина - замечание уровня "Предупреждение" на каждой
// строке группы (документ строки записывается без объекта; если без него проверка заполнения документа не пройдет, причина
// непроведения - уже замечание "Ошибка" документа).
//
// Возвращаемое значение:
//  Соответствие - ПорядковыйНомер строки -> Структура: Контрагент, СчетКонтрагента, Договор (объекты для документа строки: созданные
//    этой записью; Неопределено, если не создавались), СозданКонтрагент, СозданСчет, СозданДоговор (только на ПЕРВОЙ строке группы
//    объект учитывается как "создан этой строкой": протокол D32 считает созданное один раз).
Функция ЗаписатьОбщиеОбъектыПакета(План, Контекст, Результат, НайденныеПовторно)

	Объекты = Новый Соответствие;
	Строки = Новый Массив;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Или НайденныеПовторно.Получить(СтрокаПлана) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПричинаОтказаСтроки(СтрокаПлана, Ложь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Объекты.Вставить(СтрокаПлана.ПорядковыйНомер, Новый Структура("Контрагент, СчетКонтрагента, Договор, СозданКонтрагент, СозданСчет, СозданДоговор",
			Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено));
		Строки.Добавить(СтрокаПлана);
	КонецЦикла;

	НовыеКонтрагенты = СоздатьКонтрагентовПакета(Строки, Контекст, Результат, Объекты);
	СоздатьДоговорыПакета(Строки, Результат, Объекты, НовыеКонтрагенты);
	СоздатьСчетаПакета(Строки, Результат, Объекты);

	Возврат Объекты;

КонецФункции

// Контрагенты "Создать": группы строк одного нового контрагента - по ключам поиска распознавания (счет, код, название; одна
// реализация в СМП_РаспознаваниеОпераций.ГруппыНовыхКонтрагентов). Возвращает Соответствие "созданный контрагент -> порядковый номер
// первой строки его группы" (на ней учитывается созданное вместе с контрагентом, например договор вендора).
Функция СоздатьКонтрагентовПакета(Строки, Контекст, Результат, Объекты)

	Новые = Новый Соответствие;
	Кандидаты = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если СтрокаПлана.ДействиеКонтрагент = СМП_РаспознаваниеОпераций.ДействиеСоздать()
			И Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
			Кандидаты.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Группа Из СМП_РаспознаваниеОпераций.ГруппыНовыхКонтрагентов(Кандидаты) Цикл
		// Исключение вендорского вызова не обрывает пакет: причина - предупреждение на каждой строке группы, документы пишутся без контрагента.
		Контрагент = Неопределено;
		Попытка
			Контрагент = СоздатьКонтрагента(Группа, Контекст, Результат);
		Исключение
			ДобавитьЗамечаниеГруппы(Результат, Группа, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Контрагент не создан: ';uk = 'Контрагента не створено: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Контрагент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Новые.Вставить(Контрагент, Группа[0].ПорядковыйНомер);
		Для Каждого СтрокаПлана Из Группа Цикл
			Объекты.Получить(СтрокаПлана.ПорядковыйНомер).Контрагент = Контрагент;
		КонецЦикла;
		Объекты.Получить(Группа[0].ПорядковыйНомер).СозданКонтрагент = Контрагент;
	КонецЦикла;

	Возврат Новые;

КонецФункции

// Контрагент группы строк. Создание так, как создает вендор: Заполнить(Структура) - обработчик заполнения вендора берет значения
// из структуры (ЗаполнитьЗначенияСвойств) и дозаполняет остальное по умолчанию; ролей (покупатель / поставщик / прочие) - вендорская
// КлассификацияКонтактов.ТипОтношенийСКонтрагентомПоВидуОперации (объединение по строкам группы); признаки учета расчетов -
// вендорские значения для нового контрагента (РасчетыРаботаСФормамиВызовСервера); договор по умолчанию и регистр дублей
// вендор создает сам при записи (запись без ОбменДанными.Загрузка).
//
// Вид контрагента вендор из кода не выводит (журнал плана 04, задача 2, находка 3), его ставит продукт: 10 цифр (РНОКПП) -
// физлицо-предприниматель, код в ИНН; 8 цифр (ЕДРПОУ) - юридическое лицо, код в КодПоЕДРПОУ; нет пригодного кода - значение вендора.
//
// D16 (задача 5): ответственный контрагента, вид без пригодного кода и группа доступа берутся из настроек ОТВЕТСТВЕННОГО из контекста, не
// пользователя сеанса, которого вендор берет в ДозаполнитьПоУмолчанию (вызывается из ОбработкаЗаполнения при ПУСТЫХ реквизитах). Ответственный
// и группа присваиваются после Заполнить (в том числе пустыми); вид без настройки - отказ создания, группа - цепочка см. ниже. Возвращает
// Неопределено, если контрагент не создан (причина - предупреждение на строках группы).
Функция СоздатьКонтрагента(Группа, Контекст, Результат)

	Название = "";
	Код = "";
	НомерСчета = "";
	Покупатель = Ложь;
	Поставщик = Ложь;
	ПрочиеОтношения = Ложь;
	Для Каждого СтрокаПлана Из Группа Цикл
		Ключи = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана);
		Если ПустаяСтрока(Название) Тогда
			Название = Ключи.Название;
		КонецЕсли;
		Если ПустаяСтрока(Код) И Ключи.Код.Использовать Тогда
			Код = Ключи.Код.Нормализованный;
		КонецЕсли;
		Если ПустаяСтрока(НомерСчета) Тогда
			НомерСчета = Ключи.Номер;
		КонецЕсли;
		Отношения = КлассификацияКонтактов.ТипОтношенийСКонтрагентомПоВидуОперации(СтрокаПлана.ВидОперации);
		Покупатель = Покупатель Или Отношения.Покупатель;
		Поставщик = Поставщик Или Отношения.Поставщик;
		ПрочиеОтношения = ПрочиеОтношения Или Отношения.ПрочиеОтношения;
	КонецЦикла;

	Если ПустаяСтрока(Название) Тогда
		// Название обязательно для записи; в операции его нет - берется код или номер счета (создание возможно: есть код или счет).
		Название = ?(ПустаяСтрока(Код), НомерСчета, Код);
		Если Не ПустаяСтрока(Название) Тогда
			ДобавитьЗамечаниеГруппы(Результат, Группа, "КонтрагентНаименование", СМП_ВыпискаБанка.УровеньПредупреждение(),
				СтрШаблон(НСтр("ru = 'В операции нет названия контрагента: наименованием нового контрагента взято ""%1"".';
					|uk = 'В операції немає назви контрагента: найменуванням нового контрагента взято ""%1"".'"), Название));
		КонецЕсли;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Наименование", Лев(Название, Метаданные.Справочники.Контрагенты.ДлинаНаименования));
	Если СтрДлина(Код) = 10 Тогда
		Данные.Вставить("ИНН", Код);
		Данные.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	ИначеЕсли СтрДлина(Код) = 8 Тогда
		Данные.Вставить("КодПоЕДРПОУ", Код);
		Данные.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	КонецЕсли;
	Данные.Вставить("Покупатель", Покупатель);
	Данные.Вставить("Поставщик", Поставщик);
	Данные.Вставить("ПрочиеОтношения", ПрочиеОтношения);
	// Вид без пригодного кода - СТРОГО из настройки "Основной вид контрагента" ОТВЕТСТВЕННОГО (D16; сеансовое значение - никогда:
	// регламент идет от чужого имени или без него). Настройки нет - контрагент не создается (D3: документ записывается без него,
	// непроведенным), причина называет настройку и пользователя, у которого ее задать. Ключ подается всегда (пустого не бывает:
	// при пустой настройке мы сюда не доходим), чтобы ДозаполнитьПоУмолчанию не подставил вид пользователя сеанса.
	Если Не Данные.Свойство("ВидКонтрагента") Тогда
		ВидОтветственного = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Контекст.Ответственный,
			"ОсновнойВидКонтрагента");
		Если Не ЗначениеЗаполнено(ВидОтветственного) Тогда
			ДобавитьЗамечаниеГруппы(Результат, Группа, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
				СтрШаблон(НСтр("ru = 'Контрагент не создан: в операции нет пригодного кода (ЕДРПОУ / РНОКПП), а у ответственного ""%1"" не задана настройка ""Основной вид контрагента"": задайте ее у этого пользователя.';
					|uk = 'Контрагента не створено: в операції немає придатного коду (ЄДРПОУ / РНОКПП), а у відповідального ""%1"" не задано налаштування ""Основний вид контрагента"": задайте його у цього користувача.'"),
					Строка(Контекст.Ответственный)));
			Возврат Неопределено;
		КонецЕсли;
		Данные.Вставить("ВидКонтрагента", ВидОтветственного);
	КонецЕсли;

	// Группа доступа (D26, D16), цепочка: (1) учетная запись банка (Контекст.ГруппаДоступаКонтрагентов) -> (2) настройка "Основная
	// группа доступа" ОТВЕТСТВЕННОГО, как есть, без проверки доступности правами сеанса -> (3) в справочнике РОВНО одна группа ->
	// иначе контрагент не создается. Вендорская ГруппаДоступаПоУмолчанию не годится: ее запасной вариант - "первая разрешенная"
	// (ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 без порядка, права СЕАНСА) - молчаливый выбор из нескольких. Группы НЕ используются (опция) -
	// вендор группу не требует (ОбработкаПроверкиЗаполнения контрагента снимает проверку): остается пустой.
	ГруппаДоступа = Справочники.ГруппыДоступаКонтрагентов.ПустаяСсылка();
	Если ЗначениеЗаполнено(Контекст.ГруппаДоступаКонтрагентов) Тогда
		ГруппаДоступа = Контекст.ГруппаДоступаКонтрагентов;
	ИначеЕсли Справочники.ГруппыДоступаКонтрагентов.ИспользуютсяГруппыДоступа() Тогда
		ГруппаДоступа = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Контекст.Ответственный,
			"ОсновнаяГруппаДоступаКонтрагентов");
		Если Не ЗначениеЗаполнено(ГруппаДоступа) Тогда
			ВсеГруппы = НеПомеченныеГруппыДоступаКонтрагентов();
			Если ВсеГруппы.Количество() <> 1 Тогда
				ДобавитьЗамечаниеГруппы(Результат, Группа, "Контрагент", СМП_ВыпискаБанка.УровеньПредупреждение(),
					СтрШаблон(НСтр("ru = 'Контрагент не создан: группа доступа новых контрагентов не определена (в справочнике групп доступа: %1, а нужна ровно одна). Задайте ""Группа доступа для новых контрагентов"" в учетной записи банка или настройку ""Основная группа доступа"" у ответственного ""%2"".';
						|uk = 'Контрагента не створено: групу доступу нових контрагентів не визначено (у довіднику груп доступу: %1, а потрібна рівно одна). Задайте ""Група доступу для нових контрагентів"" в обліковому записі банку або налаштування ""Основна група доступу"" у відповідального ""%2"".'"),
						Формат(ВсеГруппы.Количество(), "ЧН=0; ЧГ="), Строка(Контекст.Ответственный)));
				Возврат Неопределено;
			КонецЕсли;
			ГруппаДоступа = ВсеГруппы[0];
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ГруппаДоступа) Тогда
		Данные.Вставить("ГруппаДоступа", ГруппаДоступа);
	КонецЕсли;
	Для Каждого Элемент Из РасчетыРаботаСФормамиВызовСервера.ПолучитьЗначенияРеквизитовПоУмолчаниюДляНовогоКонтрагента() Цикл
		Данные.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Заполнить(Данные);
	// D16: ответственный контрагента (Сотрудники) - настройка "ОсновнойОтветственный" ОТВЕТСТВЕННОГО из контекста, как вендорский
	// ДозаполнитьПоУмолчанию делает для пользователя сеанса. Присваивается и пустым: пустая настройка не должна дать сеансовую.
	Объект.Ответственный = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Контекст.Ответственный,
		"ОсновнойОтветственный");
	// Группа доступа - тем же способом: вендорский ДозаполнитьПоУмолчанию (в ОбработкаЗаполнения) при пустой группе взял бы "первую
	// разрешенную" по правам сеанса; здесь она уже определена выше (или осознанно пуста, когда группы доступа не используются).
	Объект.ГруппаДоступа = ГруппаДоступа;

	Возврат ЗаписатьОбъектПакета(Объект, Группа, Результат, "Контрагент", НСтр("ru = 'Контрагент не создан';uk = 'Контрагента не створено'"));

КонецФункции

// Договоры "Создать": ключ группы - контрагент, организация плана, вид договора (по виду операции). Для НОВОГО контрагента первый
// договор - тот, что вендор создал при записи контрагента (D6): он доналаштовывается (организация плана, вид по операции, валюта
// банковского счета плана, наименование по шаблону вендора) и регистрируется основным вендорской ЗаписатьДоговорПоУмолчанию; рядом
// с ним второй договор не создается. Договор следующего вида / организации того же нового контрагента, а также договор
// найденного контрагента - новый, по рецепту журнала плана 04 (задача 2, находка 9): Заполнить по контрагенту, вид, организация,
// наименование по шаблону вендора. Номер и дата договора не выдумываются (D6).
Процедура СоздатьДоговорыПакета(Строки, Результат, Объекты, НовыеКонтрагенты)

	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если СтрокаПлана.ДействиеДоговор <> СМП_РаспознаваниеОпераций.ДействиеСоздать() Или ЗначениеЗаполнено(СтрокаПлана.Договор) Тогда
			Продолжить;
		КонецЕсли;
		Контрагент = КонтрагентСтроки(СтрокаПлана, Объекты);
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Продолжить;
		КонецЕсли;
		Виды = СМП_РаспознаваниеОпераций.ВидыДоговораДляВидаОперации(СтрокаПлана.ВидОперации);
		Вид = ?(Виды.Количество() > 0, Виды[0], Перечисления.ВидыДоговоров.ПустаяСсылка());
		Ключ = XMLСтрока(Контрагент) + "|" + XMLСтрока(СтрокаПлана.Организация) + "|" + Строка(Вид);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Контрагент, Организация, Вид, Строки", Контрагент, СтрокаПлана.Организация, Вид, Новый Массив);
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;
		Группа.Строки.Добавить(СтрокаПлана);
	КонецЦикла;

	// Договор вендора "использован" (настроен) только при успехе: после неудачи следующая группа того же контрагента пробует настроить
	// ТОТ ЖЕ договор вендора, а не создает второй рядом с ним. Учтен как созданный (СозданДоговор) - один раз, даже если настройка не удалась.
	ВендорскийНастроен = Новый Соответствие;
	ВендорскийУчтен = Новый Соответствие;
	Для Каждого Группа Из Порядок Цикл
		Договор = Неопределено;
		Попытка
			Если НовыеКонтрагенты.Получить(Группа.Контрагент) <> Неопределено И ВендорскийНастроен.Получить(Группа.Контрагент) = Неопределено Тогда
				Итог = ДоналадитьДоговорВендора(Группа, Результат);
				Если Итог.Настроен Тогда
					ВендорскийНастроен.Вставить(Группа.Контрагент, Истина);
				КонецЕсли;
				Если ЗначениеЗаполнено(Итог.Вендорский) И ВендорскийУчтен.Получить(Группа.Контрагент) = Неопределено Тогда
					ВендорскийУчтен.Вставить(Группа.Контрагент, Истина);
					Объекты.Получить(НовыеКонтрагенты.Получить(Группа.Контрагент)).СозданДоговор = Итог.Вендорский;
				КонецЕсли;
				Договор = Итог.Договор;
			Иначе
				Договор = СоздатьДоговор(Группа, Результат);
				Если Договор <> Неопределено Тогда
					Объекты.Получить(Группа.Строки[0].ПорядковыйНомер).СозданДоговор = Договор;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ДобавитьЗамечаниеГруппы(Результат, Группа.Строки, "Договор", СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Договор не создан: ';uk = 'Договір не створено: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Договор = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаПлана Из Группа.Строки Цикл
			Объекты.Получить(СтрокаПлана.ПорядковыйНомер).Договор = Договор;
		КонецЦикла;
	КонецЦикла;

	// Договор вендора нового контрагента - объект, созданный этой записью, даже если ни одной его группе договор "Создать" не нужен.
	Для Каждого Элемент Из НовыеКонтрагенты Цикл
		Если ВендорскийУчтен.Получить(Элемент.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Вендорский = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Элемент.Ключ);
			Если ЗначениеЗаполнено(Вендорский) Тогда
				Объекты.Получить(Элемент.Значение).СозданДоговор = Вендорский;
			КонецЕсли;
		Исключение
			// Договор вендора не учтен как созданный: причина - предупреждение на первой строке группы контрагента, не молчание.
			ДобавитьЗамечание(Результат, Элемент.Значение, "Договор", СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Договор, созданный вендором, не учтен: ';uk = 'Договір, створений вендором, не враховано: '")
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Итог: Структура - Договор (договор для документов: настроенный; Неопределено, если настроить не удалось), Вендорский (договор,
// созданный вендором при записи контрагента, - учитывается как созданный этой записью даже при неудаче настройки), Настроен.
Функция ДоналадитьДоговорВендора(Группа, Результат)

	Итог = Новый Структура("Договор, Вендорский, Настроен", Неопределено, Неопределено, Ложь);
	Ссылка = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(Группа.Контрагент);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Итог.Договор = СоздатьДоговор(Группа, Результат);
		Итог.Настроен = (Итог.Договор <> Неопределено);
		Итог.Вендорский = Итог.Договор;
		Возврат Итог;
	КонецЕсли;
	Итог.Вендорский = Ссылка;

	Объект = Ссылка.ПолучитьОбъект();
	ЗаполнитьРеквизитыДоговора(Объект, Группа);
	Записанный = ЗаписатьОбъектПакета(Объект, Группа.Строки, Результат, "Договор",
		НСтр("ru = 'Договор контрагента, созданный вендором, не настроен (учтен как созданный, но не годится документу)';uk = 'Договір контрагента, створений вендором, не налаштовано (враховано як створений, але не годиться документу)'"));
	Если Записанный = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Договор = Записанный;
	Итог.Настроен = Истина;

	Попытка
		Справочники.ДоговорыКонтрагентов.ЗаписатьДоговорПоУмолчанию(Записанный);
	Исключение
		ДобавитьЗамечаниеГруппы(Результат, Группа.Строки, "Договор", СМП_ВыпискаБанка.УровеньПредупреждение(),
			НСтр("ru = 'Договор настроен, но основным не зарегистрирован: ';uk = 'Договір налаштовано, але основним не зареєстровано: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Итог;

КонецФункции

Функция СоздатьДоговор(Группа, Результат)

	Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Объект.Заполнить(Новый Структура("ОснованиеЗаполнения", Группа.Контрагент));
	ЗаполнитьРеквизитыДоговора(Объект, Группа);

	Возврат ЗаписатьОбъектПакета(Объект, Группа.Строки, Результат, "Договор", НСтр("ru = 'Договор не создан';uk = 'Договір не створено'"));

КонецФункции

Процедура ЗаполнитьРеквизитыДоговора(Объект, Группа)

	Объект.Организация = Группа.Организация;
	Если ЗначениеЗаполнено(Группа.Вид) Тогда
		Объект.ВидДоговора = Группа.Вид;
	КонецЕсли;
	Объект.ВалютаРасчетов = Группа.Строки[0].БанковскийСчет.ВалютаДенежныхСредств;
	Объект.Наименование = ШаблоныНаименований.НаименованиеДоговораПоУмолчанию(Объект);

КонецПроцедуры

// Счета "Создать": ключ группы - контрагент и номер (без пробелов, верхний регистр - так счет найдет поиск распознавания). Банк - по
// МФО тем, что дает вендорская ПолучитьТаблицуБанковПоРеквизитам("Код", МФО), которой пользуется форма банковского счета: одна
// строка - этот банк; пусто или несколько (форма в этом случае просит человека выбрать) - счет не создается, предупреждение на
// поле СчетКонтрагента. Остальное - Заполнить по контрагенту и вендорский СформироватьНаименование.
Процедура СоздатьСчетаПакета(Строки, Результат, Объекты)

	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого СтрокаПлана Из Строки Цикл
		Если СтрокаПлана.ДействиеСчет <> СМП_РаспознаваниеОпераций.ДействиеСоздать() Или ЗначениеЗаполнено(СтрокаПлана.СчетКонтрагента) Тогда
			Продолжить;
		КонецЕсли;
		Контрагент = КонтрагентСтроки(СтрокаПлана, Объекты);
		Номер = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Номер;
		Если Не ЗначениеЗаполнено(Контрагент) Или ПустаяСтрока(Номер) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = XMLСтрока(Контрагент) + "|" + Номер;
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Контрагент, Номер, МФО, Строки", Контрагент, Номер, "", Новый Массив);
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;
		Если ПустаяСтрока(Группа.МФО) Тогда
			Группа.МФО = СокрЛП(СтрокаПлана.КонтрагентМФО);
		КонецЕсли;
		Группа.Строки.Добавить(СтрокаПлана);
	КонецЦикла;

	Для Каждого Группа Из Порядок Цикл
		Попытка
			СоздатьСчетГруппы(Группа, Результат, Объекты);
		Исключение
			ДобавитьЗамечаниеГруппы(Результат, Группа.Строки, "СчетКонтрагента", СМП_ВыпискаБанка.УровеньПредупреждение(),
				НСтр("ru = 'Счет контрагента не создан: ';uk = 'Рахунок контрагента не створено: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Один счет группы (вызывается в Попытке: исключение вендорских вызовов не обрывает пакет).
Процедура СоздатьСчетГруппы(Группа, Результат, Объекты)

	Причина = "";
	Банк = БанкПоМФО(Группа.МФО, Причина);
	Если Банк = Неопределено Тогда
		ДобавитьЗамечаниеГруппы(Результат, Группа.Строки, "СчетКонтрагента", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента не создан: %1';uk = 'Рахунок контрагента не створено: %1'"), Причина));
		Возврат;
	КонецЕсли;
	Если СтрДлина(Группа.Номер) > Метаданные.Справочники.БанковскиеСчета.Реквизиты.НомерСчета.Тип.КвалификаторыСтроки.Длина Тогда
		ДобавитьЗамечаниеГруппы(Результат, Группа.Строки, "СчетКонтрагента", СМП_ВыпискаБанка.УровеньПредупреждение(),
			СтрШаблон(НСтр("ru = 'Счет контрагента не создан: номер ""%1"" длиннее реквизита номера счета.';uk = 'Рахунок контрагента не створено: номер ""%1"" довший за реквізит номера рахунку.'"), Группа.Номер));
		Возврат;
	КонецЕсли;

	Объект = Справочники.БанковскиеСчета.СоздатьЭлемент();
	Объект.Заполнить(Группа.Контрагент);
	Объект.НомерСчета = Группа.Номер;
	Объект.Банк = Банк;
	Объект.СформироватьНаименование();
	Ссылка = ЗаписатьОбъектПакета(Объект, Группа.Строки, Результат, "СчетКонтрагента", НСтр("ru = 'Счет контрагента не создан';uk = 'Рахунок контрагента не створено'"));
	Если Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПлана Из Группа.Строки Цикл
		Объекты.Получить(СтрокаПлана.ПорядковыйНомер).СчетКонтрагента = Ссылка;
	КонецЦикла;
	Объекты.Получить(Группа.Строки[0].ПорядковыйНомер).СозданСчет = Ссылка;

КонецПроцедуры

// Банк по МФО так, как ищет форма банковского счета (Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", МФО)).
// Ровно один найденный банк (не группа) - он. Иначе Неопределено и причина: МФО не указан, банка нет, банков несколько (в справочнике
// коды банков не уникальны - журнал плана 04, задача 4) или найдена группа.
Функция БанкПоМФО(МФО, Причина)

	Если ПустаяСтрока(МФО) Тогда
		Причина = НСтр("ru = 'в операции не указан МФО банка.';uk = 'в операції не вказано МФО банку.'");
		Возврат Неопределено;
	КонецЕсли;

	Банки = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", МФО);
	Если Банки.Количество() = 0 Тогда
		Причина = СтрШаблон(НСтр("ru = 'банка с МФО %1 нет в справочнике банков.';uk = 'банку з МФО %1 немає у довіднику банків.'"), МФО);
		Возврат Неопределено;
	КонецЕсли;
	Если Банки.Количество() > 1 Тогда
		Причина = СтрШаблон(НСтр("ru = 'в справочнике банков несколько банков (%2) с МФО %1: банк однозначно определить нельзя.';uk = 'у довіднику банків кілька банків (%2) з МФО %1: банк однозначно визначити неможливо.'"),
			МФО, Формат(Банки.Количество(), "ЧГ="));
		Возврат Неопределено;
	КонецЕсли;
	Если Банки[0].Ссылка.ЭтоГруппа Тогда
		Причина = СтрШаблон(НСтр("ru = 'по МФО %1 найдена группа банков, а не банк.';uk = 'за МФО %1 знайдено групу банків, а не банк.'"), МФО);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Банки[0].Ссылка;

КонецФункции

// Запись созданного пакетом объекта: сначала ПроверитьЗаполнение (как у документа), затем Записать. Возвращает ссылку или
// Неопределено; причина отказа (сообщения вендора или текст исключения) идет предупреждением на каждую строку группы.
Функция ЗаписатьОбъектПакета(Объект, Строки, Результат, Поле, Что)

	Причины = Новый Массив;
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Если Объект.ПроверитьЗаполнение() Тогда
			Объект.Записать();
			Возврат Объект.Ссылка;
		КонецЕсли;
		Причины = ТекстыСообщенийПользователю();
		Если Причины.Количество() = 0 Тогда
			Причины.Добавить(НСтр("ru = 'Проверка заполнения не пройдена.';uk = 'Перевірку заповнення не пройдено.'"));
		КонецЕсли;
	Исключение
		Причины.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ДобавитьЗамечаниеГруппы(Результат, Строки, Поле, СМП_ВыпискаБанка.УровеньПредупреждение(), Что + ": " + СтрСоединить(Причины, " "));

	Возврат Неопределено;

КонецФункции

// Замечание на каждую строку группы (Строки - массив строк плана).
Процедура ДобавитьЗамечаниеГруппы(Результат, Строки, Поле, Уровень, Текст)

	Для Каждого СтрокаПлана Из Строки Цикл
		ДобавитьЗамечание(Результат, СтрокаПлана.ПорядковыйНомер, Поле, Уровень, Текст);
	КонецЦикла;

КонецПроцедуры

// Контрагент строки: созданный этой записью, иначе контрагент плана (только справочник Контрагенты - сотрудник контрагентом
// счета и договора не является).
Функция КонтрагентСтроки(СтрокаПлана, Объекты)

	Созданный = Объекты.Получить(СтрокаПлана.ПорядковыйНомер).Контрагент;
	Если ЗначениеЗаполнено(Созданный) Тогда
		Возврат Созданный;
	КонецЕсли;
	Если ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Возврат СтрокаПлана.Контрагент;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Значение объекта строки (созданного проходом 2) или значение по умолчанию.
Функция ОбъектСтроки(ОбъектыСтроки, Имя, ПоУмолчанию)

	Если ОбъектыСтроки <> Неопределено И ЗначениеЗаполнено(ОбъектыСтроки[Имя]) Тогда
		Возврат ОбъектыСтроки[Имя];
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

// Созданное для строки - в строку результата (колонки "создан" заполняются только там, где объект учитывается как созданный).
Процедура ОтметитьСозданныеОбъекты(СтрокаРезультата, ОбъектыСтроки)

	Если ОбъектыСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектыСтроки.СозданКонтрагент) Тогда
		СтрокаРезультата.СозданКонтрагент = ОбъектыСтроки.СозданКонтрагент;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектыСтроки.СозданСчет) Тогда
		СтрокаРезультата.СозданСчет = ОбъектыСтроки.СозданСчет;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектыСтроки.СозданДоговор) Тогда
		СтрокаРезультата.СозданДоговор = ОбъектыСтроки.СозданДоговор;
	КонецЕсли;

КонецПроцедуры

// Причина, по которой документ строки не записывается (Структура: Поле, Текст), или Неопределено. УчитыватьИдентификатор = Ложь:
// только то, без чего строка непригодна вообще (проход 2 по ней объекты не создает).
Функция ПричинаОтказаСтроки(СтрокаПлана, УчитыватьИдентификатор)

	Если ПустаяСтрока(СтрокаПлана.ВидДокумента) Тогда
		Возврат Новый Структура("Поле, Текст", "ВидДокумента",
			НСтр("ru = 'Строка плана без вида документа (направление операции не из контракта): документ не записан.';
				|uk = 'Рядок плану без виду документа (напрямок операції не з контракту): документ не записано.'"));
	КонецЕсли;
	Если СтрокаПлана.ВидДокумента <> СМП_РаспознаваниеОпераций.ВидДокументаПоступлениеНаСчет()
		И СтрокаПлана.ВидДокумента <> СМП_РаспознаваниеОпераций.ВидДокументаРасходСоСчета() Тогда
		Возврат Новый Структура("Поле, Текст", "ВидДокумента",
			СтрШаблон(НСтр("ru = 'Неизвестный вид документа ""%1"": документ не записан.';
				|uk = 'Невідомий вид документа ""%1"": документ не записано.'"), СтрокаПлана.ВидДокумента));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаПлана.ВидОперации) Тогда
		Возврат Новый Структура("Поле, Текст", "ВидОперации",
			НСтр("ru = 'В строке плана не определен вид операции: документ не записан.';
				|uk = 'У рядку плану не визначено вид операції: документ не записано.'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтрокаПлана.Организация) Или Не ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) Тогда
		Возврат Новый Структура("Поле, Текст", "Организация",
			НСтр("ru = 'В строке плана не заполнены организация или банковский счет: документ не записан.';
				|uk = 'У рядку плану не заповнено організацію або банківський рахунок: документ не записано.'"));
	КонецЕсли;

	// Идентификатор длиннее реквизита платформа молча обрезала бы, и документ не узнал бы сам себя (дубль при повторной загрузке):
	// отказ, а не обрезка. Длина и значение - те же функции, что у ключа шага 0.
	Если УчитыватьИдентификатор
		И СтрДлина(СМП_РаспознаваниеОпераций.ИдентификаторОперацииСтроки(СтрокаПлана)) > СМП_РаспознаваниеОпераций.ДлинаИдентификатораОперации() Тогда
		Возврат Новый Структура("Поле, Текст", "ИдентификаторОперации",
			СтрШаблон(НСтр("ru = 'Идентификатор операции длиннее %1 знаков (длина реквизита документа): документ не записан, чтобы платформа не обрезала идентификатор.';
				|uk = 'Ідентифікатор операції довший за %1 знаків (довжина реквізиту документа): документ не записано, щоб платформа не обрізала ідентифікатор.'"),
				Формат(СМП_РаспознаваниеОпераций.ДлинаИдентификатораОперации(), "ЧГ=")));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Процедура ЗаписатьДокументСтроки(Результат, СтрокаРезультата, СтрокаПлана, Контекст, ОбъектыСтроки)

	Номер = СтрокаПлана.ПорядковыйНомер;

	Причина = ПричинаОтказаСтроки(СтрокаПлана, Истина);
	Если Причина <> Неопределено Тогда
		ОтказЗаписи(Результат, СтрокаРезультата, Причина.Поле, Причина.Текст);
		Возврат;
	КонецЕсли;

	// Создание и запись. Ошибка записи не останавливает пакет: причина идет в результат.
	Документ = Неопределено;
	Попытка
		Документ = Документы[СтрокаПлана.ВидДокумента].СоздатьДокумент();
		ЗаполнитьДокументПоСтрокеПлана(Документ, СтрокаПлана, Контекст, ОбъектыСтроки);
		Документ.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ОтказЗаписи(Результат, СтрокаРезультата, "",
			СтрШаблон(НСтр("ru = 'Документ не записан: %1';
				|uk = 'Документ не записано: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	СтрокаРезультата.Документ = Документ.Ссылка;
	ПровестиДокумент(Результат, СтрокаРезультата, Документ, Номер);

КонецПроцедуры

// Проверка заполнения, затем проведение (D20; решение консультанта по зонду задачи 0). Записать(Проведение) проверку
// заполнения НЕ выполняет (факт (в) задачи 0), поэтому ее вызов явный - как в старой обработке (СМП_КлиентБанк, ManagerModule).
// Тексты сообщений вендора и исключений только переносятся в результат; логика на них не строится.
Процедура ПровестиДокумент(Результат, СтрокаРезультата, Документ, Номер)

	// Сообщения, висевшие в очереди до записи, к этому документу не относятся.
	ПолучитьСообщенияПользователю(Истина);

	Причины = Новый Массив;
	Попытка
		Если Документ.ПроверитьЗаполнение() Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			Если Документ.Проведен Тогда
				СтрокаРезультата.Результат = РезультатСоздан();
				ПолучитьСообщенияПользователю(Истина);
				Возврат;
			КонецЕсли;
			// Отказ проведения без исключения (Отказ = Истина в обработчике): причина - сообщения вендора.
			Причины = ТекстыСообщенийПользователю();
			Если Причины.Количество() = 0 Тогда
				Причины.Добавить(НСтр("ru = 'Вендор отказал в проведении документа без пояснения.';
					|uk = 'Вендор відмовив у проведенні документа без пояснення.'"));
			КонецЕсли;
		Иначе
			Причины = ТекстыСообщенийПользователю();
			Если Причины.Количество() = 0 Тогда
				Причины.Добавить(НСтр("ru = 'Проверка заполнения документа не пройдена.';
					|uk = 'Перевірку заповнення документа не пройдено.'"));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Причины.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СтрокаРезультата.Результат = РезультатСозданНепроведенным();
	Для Каждого Причина Из Причины Цикл
		ДобавитьЗамечание(Результат, Номер, "", СМП_ВыпискаБанка.УровеньОшибка(), Причина);
	КонецЦикла;

КонецПроцедуры

Процедура ОтказЗаписи(Результат, СтрокаРезультата, Поле, Текст)

	СтрокаРезультата.Результат = РезультатОшибка();
	ДобавитьЗамечание(Результат, СтрокаРезультата.ПорядковыйНомер, Поле, СМП_ВыпискаБанка.УровеньОшибка(), Текст);

КонецПроцедуры

Процедура ДобавитьЗамечание(Результат, ПорядковыйНомер, Поле, Уровень, Текст)

	Замечание = Результат.Замечания.Добавить();
	Замечание.ПорядковыйНомер = ПорядковыйНомер;
	Замечание.Поле = Поле;
	Замечание.Уровень = Уровень;
	Замечание.Текст = Текст;

КонецПроцедуры

// Тексты сообщений пользователю, накопленные в очереди (с очисткой очереди).
Функция ТекстыСообщенийПользователю()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат Тексты;

КонецФункции

// Дата документа (время документа) - по поведению старой обработки (СМП_КлиентБанк, ManagerModule.bsl, реквизит "Дата" в
// ЗаполнитьРеквизитыПоступлениеНаСчет и ЗаполнитьРеквизитыРасходСоСчета): дата с временем - как есть; день = сегодняшний день
// сеанса - текущее время сеанса; иначе полдень этого дня. Исходная дата ("ДатаДок" старой обработки) здесь - ДатаДокумента,
// а пустая - ДатаОперации (та же замена, что в ключе шага 0).
Функция ДатаДокументаЗаписи(СтрокаПлана)

	ДатаИсходная = ?(ЗначениеЗаполнено(СтрокаПлана.ДатаДокумента), СтрокаПлана.ДатаДокумента, СтрокаПлана.ДатаОперации);

	Если НачалоДня(ДатаИсходная) <> ДатаИсходная Тогда
		Возврат ДатаИсходная;
	КонецЕсли;
	Если НачалоДня(ДатаИсходная) = НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;

	Возврат НачалоДня(ДатаИсходная) + 12 * 3600;

КонецФункции

Функция ОписаниеСтроки()

	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));

КонецФункции

// Группы доступа контрагентов в справочнике, не помеченные на удаление, БЕЗ ограничения правами сеанса (привилегированный режим на
// время запроса, без РАЗРЕШЕННЫЕ): регламент идет от чужого имени, права сеанса - не основание для выбора группы (D16).
Функция НеПомеченныеГруппыДоступаКонтрагентов()

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Группы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ГруппыДоступаКонтрагентов КАК Группы
			|ГДЕ
			|	НЕ Группы.ПометкаУдаления");
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		// Режим сбрасывается и при исключении; само исключение не глотается - его обработает вызывающий.
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Настройки ОТВЕТСТВЕННОГО (D16), читаемые вендорской УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя по
// ПЕРЕДАННОМУ пользователю (задача 1, находка 3), а не пользователя сеанса. Положение с пустой настройкой - "в шапке", как у вендора
// (ЗаполнениеОбъектовУНФ.ДополнитьПоложениеСтатьиВБанковскихДокументах и соседние).
//
// Возвращаемое значение:
//  Структура - Подразделение (основное подразделение), ПоложениеСтатьи, ПоложениеПодразделения, ПоложениеПроекта.
Функция НастройкиОтветственного(Ответственный)

	ВШапке = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
	Настройки = Новый Структура;
	Настройки.Вставить("Подразделение",
		УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Ответственный, "ОсновноеПодразделение"));
	Имена = Новый Структура("ПоложениеСтатьи, ПоложениеПодразделения, ПоложениеПроекта",
		"ПоложениеСтатьи", "ПоложениеПодразделенияВДенежныхДокументах", "ПоложениеПроекта");
	Для Каждого Имя Из Имена Цикл
		Значение = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Ответственный, Имя.Значение);
		Настройки.Вставить(Имя.Ключ, ?(ЗначениеЗаполнено(Значение), Значение, ВШапке));
	КонецЦикла;

	Возврат Настройки;

КонецФункции

// Способ зачета (Авто / Вручную) строки расшифровки платежа по правилу D34 (таблица спеки), строки БЕЗ найденной основы. Строки со
// ЗНАЙДЕННОЙ основой добавляются сюда же (задача 7); сумму при "Авто" не распределяем: один рядок на всю сумму, распределяет вендор при
// проведении (журнал плана 01, задача 5, 3а) - собственного разнесения по долгам нет. ВариантЗаполненияРасшифровки = Автоматически
// импорт не ставит никогда.
//
// Порядок строк таблицы D34:
//  1. вид вне {от покупателя, от нашей организации, поставщику, нашей организации} - "Вручную": вендорский Авто для других видов не
//     нормализуется (журнал плана 01, задача 5, 2ж). Перечень вида - вендорская РасчетыПроведениеДокументов.ЭтоВидОперацииВзаиморасчетов
//     (те же четыре вида банка плюс кассовые);
//  2. контрагент или договор создан этой записью - константа "Разносить оплату" (СпособРазнесенияОплатыПоУмолчанию), а не уровень
//     контрагента / договора: договор, созданный для найденного контрагента, наследует его уровень (измерено, задача 6);
//  3. иначе - вендорская РасчетыРаботаСФормамиВызовСервера.СпособРазнесенияОплатыДляДоговора: договор (если ВестиРасчетыПоДоговорам)
//     -> контрагент -> константа.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета
//  Договор - СправочникСсылка.ДоговорыКонтрагентов
//  Контрагент - СправочникСсылка.Контрагенты
//  СозданоЗаписью - Булево - контрагент или договор строки создан этим вызовом Записать
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей
Функция СпособЗачетаСтрокиПлана(ВидОперации, Договор, Контрагент, СозданоЗаписью)

	Если Не РасчетыПроведениеДокументов.ЭтоВидОперацииВзаиморасчетов(ВидОперации) Тогда
		Возврат Перечисления.СпособыЗачетаИРаспределенияПлатежей.Вручную;
	КонецЕсли;
	Если СозданоЗаписью Тогда
		Возврат РасчетыРаботаСФормамиВызовСервера.ПолучитьСпособРазнесенияОплатыПоУмолчанию();
	КонецЕсли;

	Возврат РасчетыРаботаСФормамиВызовСервера.СпособРазнесенияОплатыДляДоговора(Договор, Контрагент);

КонецФункции

Функция ЭтоВидПеревода(ВидОперации)

	Возврат ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ПереводСДругогоСчета
		Или ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ПереводНаДругойСчет;

КонецФункции

Функция ВидОперацииНалоги(ВидОперации)

	Возврат ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.Налоги
		Или ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Налоги;

КонецФункции

// Корреспонденция по виду операции, когда плана нет (источник - ФормыДокументовДеньги.ЗаполнитьКорреспонденцию, см. вызывающий код).
Функция КорреспонденцияПоВидуОперации(ВидОперации)

	Если ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ЛичныеСредстваПредпринимателя
		Или ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.ЛичныеСредстваПредпринимателя Тогда
		Возврат ПланыСчетов.Управленческий.НераспределеннаяПрибыль;
	КонецЕсли;
	Если ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.КомиссияБанка Тогда
		Возврат ПланыСчетов.Управленческий.ПрочиеРасходы;
	КонецЕсли;

	Возврат ПланыСчетов.Управленческий.ПустаяСсылка();

КонецФункции

// Ставка НДС и сумма НДС строки расшифровки - вендорскими функциями (журнал плана 04, задача 1, находки 7 и 8), как в форме ЭТОГО
// документа (D15): "без НДС" плана - ставка "Без ПДВ"; РасходСоСчета - по способу заполнения ставки договора, далее по организации
// (РасчетыРаботаСФормамиВызовСервера.СтавкаНДСПоОрганизацииНалогообложениеНДСИСпособуЗаполнения, ее зовет форма РасходСоСчета);
// ПоступлениеНаСчет способ договора не читает - ставка по налогообложению документа и организации (ЗаполнитьСтавкуНДСПоУмолчанию,
// ее зовет форма ПоступлениеНаСчет). Расхождение между документами вендорское и не выравнивается.
Процедура ЗаполнитьСтавкуНДССтроки(Документ, Строка, СтрокаПлана, Договор, ДатаЗаписи, ЭтоРасход)

	Если СтрокаПлана.БезНДС Тогда
		Строка.СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьСтавкуНДСБезНДС();
	ИначеЕсли ЭтоРасход Тогда
		Способ = Справочники.ДоговорыКонтрагентов.СпособЗаполненияСтавкиНДСПоДоговору(Договор);
		Строка.СтавкаНДС = РасчетыРаботаСФормамиВызовСервера.СтавкаНДСПоОрганизацииНалогообложениеНДСИСпособуЗаполнения(
			СтрокаПлана.Организация, ДатаЗаписи, Способ);
	Иначе
		Ставка = Неопределено;
		ЧислоСтавки = Неопределено;
		РасчетыРаботаСФормамиВызовСервера.ЗаполнитьСтавкуНДСПоУмолчанию(Ставка, ЧислоСтавки, Документ.НалогообложениеНДС,
			СтрокаПлана.Организация);
		Строка.СтавкаНДС = Ставка;
	КонецЕсли;
	РасчетыРаботаСФормамиВызовСервера.РассчитатьСуммуНДСНаСервере(Строка);

КонецПроцедуры

// Кладет статью, проект и подразделение туда, где вендор держит их при положении документа (D15, находка 10): "в шапке" - в шапку
// (строки расшифровки вендор заполнит из шапки при записи); "в табличной части" - в строки расшифровки (шапку вендор заполнит из строк
// при записи; до записи она пуста), а если строк нет (виды без расчетов) - в шапку, больше класть некуда. Пустое значение не пишется.
Процедура РазложитьАналитикуПоПоложению(Документ, ИмяПодразделенияШапки, Статья, Проект, Подразделение)

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Значение, ИмяШапки, ИмяСтроки, ИмяПоложения", Статья, "Статья", "СтатьяДДС", "ПоложениеСтатьи"));
	Описания.Добавить(Новый Структура("Значение, ИмяШапки, ИмяСтроки, ИмяПоложения", Проект, "Проект", "Проект", "ПоложениеПроекта"));
	Описания.Добавить(Новый Структура("Значение, ИмяШапки, ИмяСтроки, ИмяПоложения", Подразделение, ИмяПодразделенияШапки, "Подразделение",
		"ПоложениеПодразделения"));

	ВТабличнойЧасти = Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти;
	Для Каждого Описание Из Описания Цикл
		Если Не ЗначениеЗаполнено(Описание.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Документ[Описание.ИмяПоложения] = ВТабличнойЧасти И Документ.РасшифровкаПлатежа.Количество() > 0 Тогда
			Для Каждого СтрокаРасшифровки Из Документ.РасшифровкаПлатежа Цикл
				СтрокаРасшифровки[Описание.ИмяСтроки] = Описание.Значение;
			КонецЦикла;
			Документ[Описание.ИмяШапки] = Документ.Метаданные().Реквизиты[Описание.ИмяШапки].Тип.ПривестиЗначение();
		Иначе
			Документ[Описание.ИмяШапки] = Описание.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
