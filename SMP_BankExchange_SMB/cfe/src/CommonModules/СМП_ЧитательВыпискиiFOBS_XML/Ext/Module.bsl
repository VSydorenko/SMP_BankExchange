// Читатель выписок: iFOBS, файл XML ROWDATA/ROW - Южный банк (Пивденный), план 03, задача 10.
// Один банк, один формат: корень ROWDATA, под ним строки ROW, все данные - атрибуты ROW, одна строка - одна операция.
// Файл читается из потока контейнером СМП_ЧтениеВыписокОбщее.ЗаписиXML (ни временного файла, ни копии файла в буфер).
//
// Атрибуты (как в старой обработке):
//   DOCUMENTNO - номер документа (как есть)     DOCUMENTDATE - дата (ррррммдд)    BOOKEDDATE - проведено (ррррммддTчч:мм:сс...)
//   SUMMA - сумма в КОПЕЙКАХ, только цифры      OPERATIONID - направление («0» - списано, «1» - поступило)
//   CURRENCYID - код валюты    PLATPURPOSE - назначение платежа
//   IBAN - НАШ счет строки (в обоих направлениях; в файле может быть несколько наших счетов, фильтр - в платформе)
//   контрагент: CORRIBAN (счет), CORRIDENTIFYCODE (код), CORRBANKID (МФО), CORRCONTRAGENTSNAME (наименование)
//   не читаются: ACCOUNTNO, CORRACCOUNTNO, BANKID, IDENTIFYCODE, BANKNAME, CORRBANKNAME, DATAVERSION и прочее.
//
// Известные особенности и отступы, воспроизведенные или сделанные намеренно:
//  - ДатаОперации = DOCUMENTDATE + время Сред(BOOKEDDATE, 10, 8): ровно то, что старая обработка клала в Дата и (через
//    ДатаСписано/ДатаПоступило) в ДатаДок. День ДатаДок старой = день ДатаОперации, поэтому ДатаДокумента не заполняется
//    (спека D17, коммит 1db1c65), как в задачах 6-9. День BOOKEDDATE может отличаться от DOCUMENTDATE (в образцах 4 из 113):
//    воспроизводится DOCUMENTDATE;
//  - поля ключа (D17): НомерДокумента = DOCUMENTNO как есть, КонтрагентНомерСчета = CORRIBAN (нет атрибута - пусто:
//    известная особенность, CORRACCOUNTNO не читается), Сумма = SUMMA / 100;
//  - BOOKEDDATE без времени (дата ррррммдд, пусто, нет) - решение планировщика: у ОТП в XML BOOKEDDATE - только дата, и это
//    единственное, чем он отличается от Южного. ФайлПохожНаФормат требует время в первой строке (шаблон ррррммддTчч:мм:сс,
//    хвост после секунд не проверяется); в остальных строках иное - «Ошибка» с сырым значением. ИЗВЕСТНАЯ ОСОБЕННОСТЬ:
//    файл Южного без времени в BOOKEDDATE не узнается;
//  - SUMMA - целое число копеек, ТОЛЬКО цифры (после снятия пробелов по краям): разделитель, знак, пробел внутри - «Ошибка»
//    с сырым значением (общий разбор принял бы «12.5» и дал бы 0.125);
//  - направление строго: иное, чем «0» и «1» (в том числе пусто и нет атрибута), - «Ошибка» (старая: все, кроме «0», - поступление);
//  - нераспознанные дата, сумма, код валюты - «Ошибка» с сырым значением (отступ 2); буквенный код валюты - числовой;
//  - DOCUMENTDATE строго из 8 цифр (хвост - «Ошибка»), BOOKEDDATE без секунд - «Ошибка»;
//  - строка без IBAN: нашего счета не определить - «Ошибка» (старая обработка такую строку молча не загружала);
//  - назначение: ПС -> пробел, пробелы по краям снимаются (как у старой: СокрЛП в конце);
//  - кодировку задает декларация XML (платформа читает ее сама); заявленная windows-1251 - кодировка образцов;
//  - DATAVERSION не читается: ИдентификаторОперации пуст, ДаетИдентификаторыОпераций = Ложь; остатков в файле нет;
//  - ПорядковыйНомер - порядковый номер элемента ROW в файле.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет «Ошибка» с сырым
// значением, ЧтениеПолное остается Ложь. Оборванный или поврежденный XML: исключение контейнера ловит диспетчер реестра.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер XML и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("xml");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиiFOBS_XML");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'iFOBS, файл XML (Южный банк)';
		|uk = 'iFOBS, файл XML (Південний банк)'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (кодировку XML задает декларация файла).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	// Исключение контейнера (оборванный или поврежденный XML) наружу не идет: его ловит диспетчер реестра и пишет
	// «Ошибка» с полным текстом, конверт не принят, чтение не полное.
	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиXML(Данные, "ROW");

	Если Записи.Количество() = 0 Тогда
		ДобавитьСообщение(Выписка, "Ошибка", 0, НСтр("ru = 'Файл не содержит ни одной строки ROW.';
			|uk = 'Файл не містить жодного рядка ROW.'"));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	Для Каждого Запись Из Записи Цикл
		Операция = РазобратьЗапись(Запись, Выписка);
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка начала файла: «файл похож на этот формат». Из потока читаются только корень и первая строка:
// корень ROWDATA, первый элемент внутри - ROW с атрибутами DOCUMENTDATE, BOOKEDDATE, SUMMA, OPERATIONID, IBAN, причем
// BOOKEDDATE - со временем (так Южный отличается от ОТП в XML). Файл целиком не читается и в буфер не копируется.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	Если Данные.Размер() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Поток = Неопределено;
	Чтение = Неопределено;
	Результат = Ложь;
	Попытка
		Поток = Данные.ОткрытьПотокДляЧтения();
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьПоток(Поток);
		БылКорень = Ложь;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			Если Не БылКорень Тогда
				Если Чтение.ЛокальноеИмя <> "ROWDATA" Тогда
					Прервать;
				КонецЕсли;
				БылКорень = Истина;
				Продолжить;
			КонецЕсли;
			Если Чтение.ЛокальноеИмя = "ROW" Тогда
				Результат = АтрибутыПервойСтрокиПодходят(Чтение);
			КонецЕсли;
			Прервать;
		КонецЦикла;
	Исключение
		Результат = Ложь;
	КонецПопытки;

	Если Чтение <> Неопределено Тогда
		Попытка
			Чтение.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Поток <> Неопределено Тогда
		Попытка
			Поток.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образцов (20-samples.md): windows-1251 (в декларации XML).
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

// Атрибуты текущей строки ROW читателя подходят формату: есть пять обязательных, BOOKEDDATE - со временем.
Функция АтрибутыПервойСтрокиПодходят(Чтение)

	Атрибуты = Новый Соответствие;
	Для Индекс = 0 По Чтение.КоличествоАтрибутов() - 1 Цикл
		Атрибуты.Вставить(Чтение.ИмяАтрибута(Индекс), Чтение.ЗначениеАтрибута(Индекс));
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("DOCUMENTDATE,BOOKEDDATE,SUMMA,OPERATIONID,IBAN", ",") Цикл
		Если Атрибуты[Имя] = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ВремяПоШаблону(Атрибуты["BOOKEDDATE"]);

КонецФункции

// BOOKEDDATE со временем: ррррммддTчч:мм:сс (хвост после секунд не проверяется); время - на позициях 10-17, откуда его
// брала старая обработка.
Функция ВремяПоШаблону(Текст)

	Если СтрДлина(Текст) < 17 Или Сред(Текст, 9, 1) <> "T" Или Сред(Текст, 12, 1) <> ":" Или Сред(Текст, 15, 1) <> ":" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТолькоЦифры(Лев(Текст, 8) + Сред(Текст, 10, 2) + Сред(Текст, 13, 2) + Сред(Текст, 16, 2));

КонецФункции

Функция ТолькоЦифры(Текст)

	Если СтрДлина(Текст) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Значение атрибута как есть или пустая строка, если атрибута нет.
Функция Атрибут(Поля, Имя)

	Значение = Поля[Имя];
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

// Значение атрибута, пробелы по краям сняты.
Функция Поле(Поля, Имя)

	Возврат СокрЛП(Атрибут(Поля, Имя));

КонецФункции

// Разбирает строку ROW в структуру операции или возвращает Неопределено, дописав в диагностику «Ошибка» по каждому
// нераспознанному значению (строка в Операции не попадает).
Функция РазобратьЗапись(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = Запись.Поля;
	Ошибок = 0;

	// Наш счет строки.
	НашСчет = Поле(Поля, "IBAN");
	Если ПустаяСтрока(НашСчет) Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, НСтр("ru = 'Строка не прочитана: нет атрибута IBAN (нашего счета строки).';
			|uk = 'Рядок не прочитано: немає атрибута IBAN (нашого рахунку рядка).'"));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Дата операции: DOCUMENTDATE (8 цифр) + время Сред(BOOKEDDATE, 10, 8), как у старой обработки.
	ДатаОперации = Неопределено;
	СырьеДаты = Поле(Поля, "DOCUMENTDATE");
	День = Неопределено;
	Если СтрДлина(СырьеДаты) = 8 Тогда
		День = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "ррррммдд");
	КонецЕсли;
	Если День = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату документа DOCUMENTDATE: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату документа DOCUMENTDATE: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	Иначе
		СырьеВремени = Атрибут(Поля, "BOOKEDDATE");
		Если ВремяПоШаблону(СырьеВремени) Тогда
			ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(
				Сред(СырьеДаты, 7, 2) + "." + Сред(СырьеДаты, 5, 2) + "." + Лев(СырьеДаты, 4) + " " + Сред(СырьеВремени, 10, 8),
				"дд.мм.рррр чч:мм:сс");
		КонецЕсли;
		Если ДатаОперации = Неопределено Тогда
			ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'Строка не прочитана: не удалось разобрать время проведения BOOKEDDATE: «%1», ожидалось ррррммддTчч:мм:сс.';
					|uk = 'Рядок не прочитано: не вдалося розібрати час проведення BOOKEDDATE: «%1», очікувалось ррррммддTгг:хх:сс.'"),
				СырьеВремени));
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЕсли;

	// Направление - строго по OPERATIONID.
	СырьеНаправления = Поле(Поля, "OPERATIONID");
	Поступило = Ложь;
	Если СырьеНаправления = "1" Тогда
		Поступило = Истина;
	ИначеЕсли СырьеНаправления <> "0" Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный признак направления OPERATIONID: «%1», ожидалось 0 или 1.';
				|uk = 'Рядок не прочитано: невідома ознака напряму OPERATIONID: «%1», очікувалось 0 або 1.'"),
			СырьеНаправления));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Сумма - целое число копеек: только цифры. Разделитель, знак, пробел внутри - не сумма.
	СырьеСуммы = Поле(Поля, "SUMMA");
	Сумма = Неопределено;
	Если ТолькоЦифры(СырьеСуммы) Тогда
		Сумма = Число(СырьеСуммы) / 100;
	КонецЕсли;
	Если Сумма = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму SUMMA (копейки, только цифры): «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати суму SUMMA (копійки, лише цифри): «%1».'"),
			СырьеСуммы));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Валюта - числовой код; пустой - валюта счета.
	СырьеВалюты = Поле(Поля, "CURRENCYID");
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать код валюты CURRENCYID: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати код валюти CURRENCYID: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", НашСчет);
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", Атрибут(Поля, "DOCUMENTNO"));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", ?(Поступило, "Поступило", "Списано"));
	Операция.Вставить("КонтрагентНаименование", Поле(Поля, "CORRCONTRAGENTSNAME"));
	Операция.Вставить("КонтрагентНомерСчета", Поле(Поля, "CORRIBAN"));
	Операция.Вставить("КонтрагентКод", Поле(Поля, "CORRIDENTIFYCODE"));
	Операция.Вставить("КонтрагентМФО", Поле(Поля, "CORRBANKID"));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(СтрЗаменить(Атрибут(Поля, "PLATPURPOSE"), Символы.ПС, " ")));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

Процедура ДобавитьСообщение(Выписка, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

