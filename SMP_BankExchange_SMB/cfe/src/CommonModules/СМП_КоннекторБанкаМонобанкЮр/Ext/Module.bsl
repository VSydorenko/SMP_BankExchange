// Конектор API monobank для юросіб (corp-api.monobank.ua): читач за контрактом D28 (план 05а, задача 4, D36).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только с типами
// платформы и с другими воротами (СМП_КоннекторыБанковОбщее, СМП_ЧтениеВыписокОбщее). Базу, метаданные, сеанс, локаль
// и серверные часы не читает; даты и числа форматирует явным форматом; сеть и паузу видит только через
// Параметры.Транспорт (ВыполнитьЗапрос, Пауза). Исключений наружу не бросает: отказ банка классифицирует сам в
// Выписка.КлассОтказа (D36 п. 8), прочитанное до отказа остается в конверте.
//
// Что читает: выписку за период страницами и подобовые балансы (граница остаточности банка, D36 п. 10). Поведение
// предшественника (СМП_РаботаСБанкамиМонобанкЮрAPIСервер) сохранено в полях ключа D17 и в наборе операций; отступы
// от него - только ухваленные планом 05а:
//  - PENDING и DECLINED не идут в Операции, а дают рядок Предупреждение (PENDING еще и сдвигает ГраницуДоверия);
//  - сторно (reverse = true) в отдельной записи со своим id - обычная операция своего направления (случай «а»,
//    D36 п. 5); запись сторно с id оригинала - рядок Ошибка (случай «б»);
//  - призначение платежа не обрезается до 255 (длину проверяет платформа);
//  - все даты - киевское время с явным поясом (D36 п. 7);
//  - границы запроса берутся с запасом (D36 п. 11, спеки 71b3771 и a90f7ea): от НачалоПериода минус секунда до меньшего из КонецПериода плюс
//    секунда и момента чтения транспорта; операции вне периода, но в границах запроса, отбрасываются молча; граница доверия не позже момента чтения;
//  - пауза по заголовку банка ограничена пределом (D36 п. 8): больше - «Повторить» без ожидания, диагностика называет запрошенную паузу.
//
// Дата операции и день документа - момент проведения completedTime, а при его отсутствии - time (как у
// предшественника, D17). Момент неостаточной операции для границы доверия - time (создание).
//
// Порядок выписки банк документацией не гарантирует (наблюдалось «от новых к старым», параметр direction игнорируется):
// конектор на порядок не опирается. Пагинация - сдвиг верхней границы на самую раннюю time страницы + 1 (банк не возвращает
// операцию с time = to, журнал 05а, 9e1eb08, поэтому секунда пограничной операции охватывается вторично, а повторы снимает
// дедупликация по id); если
// страница полная и целиком в одной секунде, курсор застрял: «ДействиеЧеловека», чтение идет дальше, неполной остается
// только секунды между новой и текущей границей (D36 п. 11, спека 4988aba). Правила продолжения - в одной функции, ВерхняяГраницаПродолжения.

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок, docs/architecture/reader-contract.md).
//
// Возвращаемое значение:
//  Структура - описание: читач API, идентификаторы операций есть (id банка), остатков нет.
Функция ОписаниеЧитателя() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_КоннекторБанкаМонобанкЮр");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'monobank, юридические лица (API)'; uk = 'monobank, юридичні особи (API)'"));
	Описание.Вставить("РасширенияФайлов", Новый Массив);
	Описание.Вставить("Кодировка", "");
	Описание.Вставить("ДаетИдентификаторыОпераций", Истина);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает выписку в конверт платформы с рабочим размером страницы.
//
// Параметры:
//  Данные - Неопределено - у конектора API данных-файла нет (D36 п. 2).
//  Параметры - Структура - параметры чтения (НомерСчета, НачалоПериода, КонецПериода, УчетныеДанные.Токен, Транспорт).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РабочийРазмерСтраницы());

КонецПроцедуры

// Читает выписку с заданным размером страницы (limit). Продукт всегда читает рабочим размером (Прочитать); параметр
// нужен тесту: записи run1 сняты рекордером с другими limit, а транспорт воспроизведения сверяет запрос с записанным.
// Шов для тестов: лишь меньший (или равный) рабочего лимита; больший - исключение.
//
// Параметры:
//  Параметры - Структура - см. Прочитать.
//  Выписка - Структура - конверт платформы.
//  РазмерСтраницы - Число - limit запроса выписки; должен быть положительным.
Процедура ПрочитатьСРазмеромСтраницы(Параметры, Выписка, РазмерСтраницы) Экспорт

	// Шов для тестов, только меньше рабочего лимита: больший лимит нарушил бы вывод D36 п. 11 (конец - по короткой странице).
	Если ТипЗнч(РазмерСтраницы) <> Тип("Число") Или РазмерСтраницы < 1 Или РазмерСтраницы > РабочийРазмерСтраницы() Тогда
		ВызватьИсключение НСтр("ru = 'Размер страницы должен быть от 1 до рабочего лимита.'; uk = 'Розмір сторінки має бути від 1 до робочого ліміту.'");
	КонецЕсли;

	Выписка.НачалоПериода = Параметры.НачалоПериода;
	Выписка.КонецПериода = Параметры.КонецПериода;

	Состояние = Новый Структура;
	Состояние.Вставить("Транспорт", Параметры.Транспорт);
	Состояние.Вставить("УчетныеДанные", Параметры.УчетныеДанные);
	Состояние.Вставить("НомерСчета", Параметры.НомерСчета);
	Состояние.Вставить("Записи", Новый Массив);
	Состояние.Вставить("ПаузаПередЗапросом", 0);
	Состояние.Вставить("Отказ", Неопределено);
	Состояние.Вставить("МоментUnix", 0);
	Состояние.Вставить("Нижняя", 0);
	Состояние.Вставить("Верхняя", 0);
	Состояние.Вставить("ПериодС", 0);
	Состояние.Вставить("ПериодПо", 0);

	Если Состояние.Транспорт = Неопределено Или ТипЗнч(Состояние.УчетныеДанные) <> Тип("Структура")
		Или Не Состояние.УчетныеДанные.Свойство("Токен") Тогда
		Отказать(Состояние, "ДействиеЧеловека", НСтр("ru = 'Банк monobank юросіб: не переданы транспорт или токен.';
			|uk = 'Банк monobank юросіб: не передано транспорт або токен.'"));
	Иначе
		ПодготовитьОкно(Состояние, Параметры);
		Если Состояние.Отказ = Неопределено Тогда
			Если ЧтениеБудущегоПериода(Состояние, Параметры, Выписка) Тогда
				Возврат;
			КонецЕсли;
			ПрочитатьСтраницы(Состояние, Параметры, РазмерСтраницы);
		КонецЕсли;
	КонецЕсли;

	// Операции читаются и тогда, когда чтение оборвалось: прочитанное лежит в конверте.
	Неостаточные = Новый Массив;
	ОбработатьЗаписи(Состояние, Выписка, Неостаточные);

	Граница = Неопределено;
	Если Состояние.Отказ = Неопределено Тогда
		Граница = ПрочитатьГраницуБанка(Состояние, Параметры);
	КонецЕсли;

	Если Состояние.Отказ <> Неопределено Тогда
		Выписка.КлассОтказа = Состояние.Отказ.Класс;
		Выписка.ЧтениеПолное = Ложь;
		Выписка.ГраницаДоверия = Параметры.НачалоПериода;
		Для Каждого Текст Из Состояние.Отказ.Тексты Цикл
			ДобавитьДиагностику(Выписка, "Предупреждение", 0, Текст);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	// Межа довіри не пізніша за момент читання (D36 п. 10, a90f7ea): читання періоду, що кінчається в майбутньому, може бути повним, а курсор
	// рухається лише до моменту читання.
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Параметры.КонецПериода);
	Кандидаты.Добавить(СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Состояние.МоментUnix));
	Для Каждого Момент Из Неостаточные Цикл
		Кандидаты.Добавить(Момент);
	КонецЦикла;
	Если Граница <> Неопределено Тогда
		Кандидаты.Добавить(Граница);
	КонецЕсли;
	Самая = Кандидаты[0];
	Для Каждого Кандидат Из Кандидаты Цикл
		Самая = Мин(Самая, Кандидат);
	КонецЦикла;

	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Макс(Параметры.НачалоПериода, Самая);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Окно первого запроса (D36 п. 11, спеки 71b3771 и a90f7ea): нижняя граница - НачалоПериода минус секунда (семантика from у банка
// не измерена); верхняя - меньшее из КонецПериода плюс секунда и момента чтения. Транспорт дает момент в UTC, а границы периода - киевское
// время: сравниваются в одной шкале, секундах Unix. Часы сервера не читаются. НачалоПериода и КонецПериода - включительные моменты.
Процедура ПодготовитьОкно(Состояние, Параметры)

	МоментЧтения = Состояние.Транспорт.ТекущийМомент();
	Если ТипЗнч(МоментЧтения) <> Тип("Дата") Или Не ЗначениеЗаполнено(МоментЧтения) Тогда
		Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
			НСтр("ru = 'Банк %1: транспорт не вернул момент чтения.'; uk = 'Банк %1: транспорт не повернув момент читання.'"), НазваниеБанка()));
		Возврат;
	КонецЕсли;

	Состояние.МоментUnix = МоментЧтения - Дата(1970, 1, 1, 0, 0, 0);
	Состояние.ПериодС = СМП_КоннекторыБанковОбщее.КиевскоеВремяВМоментUnix(Параметры.НачалоПериода);
	Состояние.ПериодПо = СМП_КоннекторыБанковОбщее.КиевскоеВремяВМоментUnix(Параметры.КонецПериода);
	Состояние.Нижняя = Состояние.ПериодС - 1;
	Состояние.Верхняя = Мин(Состояние.ПериодПо + 1, Состояние.МоментUnix);

КонецПроцедуры

// НачалоПериода позже момента чтения (D36 п. 11, спека 0d071e2): запросов нет, конверт пуст, чтение полное, граница доверия - НачалоПериода
// (затискание п. 10 действует после выбора самой ранней границы). Порядок проверок: период наоборот (точка чтения) -> эта ветка -> обычное
// чтение. ЕДИНСТВЕННОЕ место ветки.
Функция ЧтениеБудущегоПериода(Состояние, Параметры, Выписка)

	Если Состояние.ПериодС <= Состояние.МоментUnix Тогда
		Возврат Ложь;
	КонецЕсли;
	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Параметры.НачалоПериода;
	Возврат Истина;

КонецФункции

// Предел паузы по заголовку банка (D36 п. 8, спека a90f7ea), секунды. Не меньше документированного интервала между запросами выписки
// (60 с у ФОП), иначе обычное ограничение частоты стало бы отказом; вдвое больше - запас на разброс. Банк просит больше - конектор не
// ждет: «Повторить», а диагностика называет запрошенную паузу (иначе один заголовок остановил бы регламент на часы).
Функция ПотолокПаузы()

	Возврат 120;

КонецФункции

// Записи выписки, принадлежащие периоду: операции вне НачалоПериода...КонецПериода, но в границах запроса, отбрасываются молча (D36 п. 11);
// номера отброшенных остаются занятыми. Запись без читаемого времени остается (ее разберет обработка записей).
Функция ЗаписиПериода(Состояние)

	Результат = Новый Массив;
	Для Каждого Запись Из Состояние.Записи Цикл
		Если ТипЗнч(Запись.Данные) = Тип("Соответствие") Тогда
			Время = ЦелоеИзJSON(Запись.Данные["time"]);
			Если Время <> Неопределено И (Время < Состояние.ПериодС Или Время > Состояние.ПериодПо) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Рабочий размер страницы (limit запроса выписки). Конец чтения конектор определяет по странице, КОРОЧЕ запрошенного
// limit (D36 п. 11, у банка нет признака конца), а это верно лишь пока банк сам не обрезает страницу ниже запрошенного
// limit. Поэтому limit не больше измеренной нижней границы максимума страницы: в run1 limit=500 вернул 33 операции
// за раз (журнал docs/superpowers/plans/2026-10-15-smb-import-platform-05a-runs.md, «Задача 1, Step 3», пункт 8), то
// есть максимум не меньше 33. Берется 30 с запасом (как в оракуле tools/statement-samples/apilib/common.py). После
// второго прогона рекордера (run2) значение пересматривают по измерению.
Функция РабочийРазмерСтраницы()

	Возврат 30;

КонецФункции

Функция НазваниеБанка()

	Возврат "monobank юросіб";

КонецФункции

// Читает страницы выписки сдвигом верхней границы; записи складывает в Состояние.Записи, отказ - в Состояние.Отказ.
Процедура ПрочитатьСтраницы(Состояние, Параметры, РазмерСтраницы)

	Начало = Состояние.Нижняя;
	Верхняя = Состояние.Верхняя;
	Номер = 0;

	Пока Истина Цикл

		Адрес = СтрШаблон("https://corp-api.monobank.ua/ext/v1/statement/%1/%2/%3?limit=%4",
			Параметры.НомерСчета, Формат(Начало, "ЧГ=0"), Формат(Верхняя, "ЧГ=0"), Формат(РазмерСтраницы, "ЧГ=0"));
		Страница = ЗапроситьМассив(Состояние, Адрес);
		Если Страница = Неопределено Тогда
			Возврат;
		КонецЕсли;

		// Сначала границы ответа (до добавления записей): ответ вне границ запроса - аномалия, «Повторить», ЭТА страница в конверт
		// не берется, прочитанные раньше остаются (D36 п. 8). Границы - ФАКТИЧЕСКИЕ границы запроса (с запасом), не период. time = to аномалией
		// НЕ является (банк не возвращает операцию с time = to, журнал 05а, 9e1eb08, но исключительность границы и дробные секунды не
		// выяснены; повторы снимает id).
		Если ОтветВнеГраниц(Страница, Начало, Верхняя) Тогда
			Отказать(Состояние, "Повторить", СтрШаблон(
				НСтр("ru = 'Банк %1: в ответе есть операции вне границ запроса (time больше to или меньше from, статус 200); продолжить чтение нельзя, чтение неполное.';
					|uk = 'Банк %1: у відповіді є операції поза межами запиту (time більше за to або менше за from, статус 200); продовжити читання не можна, читання неповне.'"),
				НазваниеБанка()));
			Возврат;
		КонецЕсли;

		Наименьшая = Неопределено;
		Для Каждого Запись Из Страница Цикл
			Номер = Номер + 1;
			Состояние.Записи.Добавить(Новый Структура("Номер, Данные", Номер, Запись));
			Если ТипЗнч(Запись) = Тип("Соответствие") Тогда
				Время = ЦелоеИзJSON(Запись["time"]);
				Если Время <> Неопределено И (Наименьшая = Неопределено Или Время < Наименьшая) Тогда
					Наименьшая = Время;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		// Конец чтения: страница короче запрошенного limit (D36 п. 11); кратное limit число операций дает пустую
		// последнюю страницу.
		Если Страница.Количество() < РазмерСтраницы Тогда
			Возврат;
		КонецЕсли;

		// Полная страница: признака конца нет, читать дальше можно только сдвинув верхнюю границу (D36 п. 11).
		Верхняя = ВерхняяГраницаПродолжения(Состояние, Страница.Количество(), Наименьшая, Начало, Верхняя);
		Если Верхняя = Неопределено Тогда
			Возврат;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Есть ли в ответе операция вне границ запроса: time больше верхней границы (to) или меньше начала (from). Записи без читаемого
// time не проверяются (их разбирает обработка записей). time = to не аномалия.
Функция ОтветВнеГраниц(Страница, Начало, Верхняя)

	Для Каждого Запись Из Страница Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Время = ЦелоеИзJSON(Запись["time"]);
		Если Время <> Неопределено И (Время > Верхняя Или Время < Начало) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Верхняя граница следующего запроса после полной страницы (D36 п. 11, спека 4988aba и решения по рецензии). ЕДИНСТВЕННОЕ
// место правил продолжения; дедупликация повторов по id - ДедупликацияПоИдентификатору. Обозначения: E - самая ранняя time
// страницы, U - текущая верхняя граница.
//  1. Граница продолжения = Мин(E + 1, U): банк не возвращает операцию с time = to (журнал 05а, 9e1eb08), поэтому секунда пограничной операции
//     охватывается вторично (повторы снимает id); граница никогда не растет.
//  2. Застревание: граница продолжения = U (E >= U - 1) - запрос продолжения совпал бы с текущим. Класс «ДействиеЧеловека»
//     (повтор даст то же), чтение неполное; диагностика называет секунды U - 1 и U и число операций страницы.
//  3. Шаг после застревания: Мин(E, U - 1), строго меньше U при любой семантике to. Не прочитанными остаются секунды между
//     новой и текущей границей: одна, если граница исключительная, до двух, если включительная.
//  4. Читаемого time в полной странице нет (курсора нет, хотя «есть еще») - «Повторить».
// Цикл конечен: граница строго убывает (защитная проверка ниже) и останавливается не позже Начало; число итераций ограничено
// шириной окна в секундах, ограничения числа страниц не нужно.
//
// Параметры:
//  Состояние - Структура - состояние чтения.
//  КоличествоВСтранице - Число - сколько записей пришло на странице.
//  Наименьшая - Число, Неопределено - E, секунды Unix; Неопределено - читаемого времени нет.
//  Начало - Число - начало периода, секунды Unix.
//  Верхняя - Число - U, секунды Unix.
//
// Возвращаемое значение:
//  Число, Неопределено - верхняя граница следующего запроса или Неопределено, если читать дальше нечего или нечем.
Функция ВерхняяГраницаПродолжения(Состояние, КоличествоВСтранице, Наименьшая, Начало, Верхняя)

	Если Наименьшая = Неопределено Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: страница выписки полная, но в ней нет времени операций, чтобы продолжить чтение (статус 200); чтение неполное.';
				|uk = 'Банк %1: сторінка виписки повна, але в ній немає часу операцій, щоб продовжити читання (статус 200); читання неповне.'"),
			НазваниеБанка()));
		Возврат Неопределено;
	КонецЕсли;

	Следующая = Мин(Наименьшая + 1, Верхняя);
	Если Следующая >= Верхняя Тогда
		Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
			НСтр("ru = 'Банк %1: страница полная, продолжить чтение нечем (повтор даст то же): получено %4 операций, секунды %2 и %3: одна из них или обе могли быть прочитаны не полностью (семантика границы банка не выяснена). Загрузите этот день из файла выписки.';
				|uk = 'Банк %1: сторінка повна, продовжити читання нічим (повтор дасть те саме): отримано %4 операцій, секунди %2 і %3: одна з них або обидві могли бути прочитані не повністю (семантику межі банку не з''ясовано). Завантажте цей день із файлу виписки.'"),
			НазваниеБанка(),
			Формат(СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Верхняя - 1), "ДФ='dd.MM.yyyy HH:mm:ss'"),
			Формат(СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Верхняя), "ДФ='dd.MM.yyyy HH:mm:ss'"),
			Формат(КоличествоВСтранице, "ЧГ=0")));
		Следующая = Мин(Наименьшая, Верхняя - 1);
	КонецЕсли;

	// Читать нечего: граница дошла до начала периода (без отказа сверх уже записанного).
	Если Следующая <= Начало Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Страховка: граница обязана строго убывать; по построению сюда это не приходит, но конектор не опирается на поведение банка.
	Если Следующая >= Верхняя Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: граница продолжения не уменьшилась, продолжить чтение невозможно; чтение неполное.';
				|uk = 'Банк %1: межа продовження не зменшилась, продовжити читання неможливо; читання неповне.'"),
			НазваниеБанка()));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Следующая;

КонецФункции

// Банковская граница остаточности: начало первого дня запрошенного периода без isFinal = true в balances (день без
// строки баланса - неостаточный). Неопределено - все дни остаточны. Сбой обмена - отказ (D36 п. 8, 10).
Функция ПрочитатьГраницуБанка(Состояние, Параметры)

	Адрес = СтрШаблон("https://corp-api.monobank.ua/ext/v1/accounts/%1/balances?dateFrom=%2&dateTo=%3",
		Параметры.НомерСчета, Формат(Параметры.НачалоПериода, "ДФ=yyyy-MM-dd"), Формат(Параметры.КонецПериода, "ДФ=yyyy-MM-dd"));
	Балансы = ЗапроситьМассив(Состояние, Адрес);
	Если Балансы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Остаточные = Новый Соответствие;
	Для Каждого Баланс Из Балансы Цикл
		Если ТипЗнч(Баланс) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СтрокаИзJSON(Баланс["date"]);
		Если ПустаяСтрока(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		// День остаточен, только если остаточны ВСЕ его рядки.
		Было = Остаточные[Ключ];
		Остаточные[Ключ] = (Было = Неопределено Или Было = Истина) И Баланс["isFinal"] = Истина;
	КонецЦикла;

	День = НачалоДня(Параметры.НачалоПериода);
	Последний = НачалоДня(Параметры.КонецПериода);
	Пока День <= Последний Цикл
		Если Остаточные[Формат(День, "ДФ=yyyy-MM-dd")] <> Истина Тогда
			Возврат День;
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// GET, ответ которого должен быть JSON-массивом. Одна повторная попытка после 429 (пауза по заголовку), пауза
// перед следующим запросом при исчерпанном лимите. Любая отмена - Отказать и Неопределено.
Функция ЗапроситьМассив(Состояние, Адрес)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("x-token", Состояние.УчетныеДанные.Токен);
	Заголовки.Вставить("accept", "application/json");

	Ответ = Неопределено;
	Для НомерПопытки = 1 По 2 Цикл
		// Пауза выполняется перед следующим запросом, а не сразу: после последнего обмена ждать нечего.
		Если Состояние.ПаузаПередЗапросом > 0 Тогда
			Состояние.Транспорт.Пауза(Состояние.ПаузаПередЗапросом);
			Состояние.ПаузаПередЗапросом = 0;
		КонецЕсли;
		Ответ = Состояние.Транспорт.ВыполнитьЗапрос("GET", Адрес, Заголовки, Неопределено);
		Если Не Ответ.Сбой И Ответ.Статус = 429 И НомерПопытки = 1 Тогда
			Запрошено = СекундыПаузы(Ответ);
			Если Запрошено > ПотолокПаузы() Тогда
				Отказать(Состояние, "Повторить", СтрШаблон(
					НСтр("ru = 'Банк %1: статус 429 (%4), банк просит паузу %2 с, это больше предела %3 с; ожидание не выполняется, чтение неполное, повторите позже.';
						|uk = 'Банк %1: статус 429 (%4), банк просить паузу %2 с, це більше за межу %3 с; очікування не виконується, читання неповне, повторіть пізніше.'"),
					НазваниеБанка(), Формат(Запрошено, "ЧГ=0"), Формат(ПотолокПаузы(), "ЧГ=0"),
					ОписаниеБанка(СМП_КоннекторыБанковОбщее.ПрочитатьJSONИзТела(Ответ.Тело,
						СМП_КоннекторыБанковОбщее.КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8")))));
				Возврат Неопределено;
			КонецЕсли;
			Состояние.ПаузаПередЗапросом = Запрошено;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если Ответ.Сбой Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: ответа нет (%2): %3';
				|uk = 'Банк %1: відповіді немає (%2): %3'"),
			НазваниеБанка(), Ответ.ВидСбоя, Ответ.ТекстСбоя));
		Возврат Неопределено;
	КонецЕсли;

	Тело = СМП_КоннекторыБанковОбщее.ПрочитатьJSONИзТела(Ответ.Тело, СМП_КоннекторыБанковОбщее.КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8"));

	Если Ответ.Статус <> 200 Тогда
		Класс = СМП_КоннекторыБанковОбщее.КлассОтказаПоСтатусуHTTP(Ответ.Статус);
		Если Класс = "" Тогда
			// 2xx, кроме 200, - неожиданный ответ: временная проблема.
			Класс = "Повторить";
		КонецЕсли;
		Отказать(Состояние, Класс, СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			ОписаниеБанка(Тело), Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	Если Не Тело.Успех Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			Тело.Текст, Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Тело.Значение) <> Тип("Массив") Тогда
		Отказать(Состояние, "Повторить", СМП_КоннекторыБанковОбщее.ТекстОтказаБанка(НазваниеБанка(), Ответ.Статус,
			НСтр("ru = 'ожидался массив'; uk = 'очікувався масив'"), Состояние.УчетныеДанные));
		Возврат Неопределено;
	КонецЕсли;

	// Лимит запросов исчерпан: следующий запрос упал бы на 429, ждем заранее.
	Если СокрЛП(Строка(Ответ.Заголовки["x-rate-limit-remaining"])) = "0" Тогда
		// Упреждающая пауза не длиннее предела: если банк после нее все же откажет 429, сработает проверка предела выше.
		Состояние.ПаузаПередЗапросом = Мин(СекундыПаузы(Ответ), ПотолокПаузы());
	КонецЕсли;

	Возврат Тело.Значение;

КонецФункции

// Пауза по заголовкам ответа: x-rate-limit-retry-after-seconds, затем retry-after (целое число секунд); иначе 60 секунд. Заголовок,
// который не разобран (в том числе retry-after в виде HTTP-даты), означает паузу конектора по умолчанию - 60 с, а не ошибку.
Функция СекундыПаузы(Ответ)

	Для Каждого Имя Из СтрРазделить("x-rate-limit-retry-after-seconds,retry-after", ",") Цикл
		Значение = Ответ.Заголовки[Имя];
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Секунд = ЦелоеИзJSON(СокрЛП(Значение));
		Если Секунд <> Неопределено И Секунд > 0 Тогда
			Возврат Секунд;
		КонецЕсли;
	КонецЦикла;
	Возврат 60;

КонецФункции

// Описание ошибки банка из тела: errorDescription, затем message; пусто, если тела нет или оно не объект.
Функция ОписаниеБанка(Тело)

	Если Тело.Успех И ТипЗнч(Тело.Значение) = Тип("Соответствие") Тогда
		Для Каждого Имя Из СтрРазделить("errorDescription,message", ",") Цикл
			Значение = Тело.Значение[Имя];
			Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
				Возврат СтрокаИзJSON(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";

КонецФункции

// Первый отказ определяет класс (причина, остановившая чтение или сделавшая его неполным); тексты копятся все.
Процедура Отказать(Состояние, Класс, Текст)

	Если Состояние.Отказ = Неопределено Тогда
		Состояние.Отказ = Новый Структура("Класс, Тексты", Класс, Новый Массив);
	КонецЕсли;
	Состояние.Отказ.Тексты.Добавить(СМП_КоннекторыБанковОбщее.УбратьУчетныеДанные(Текст, Состояние.УчетныеДанные));

КонецПроцедуры

// Записи -> операции и диагностика. Неостаточные - моменты создания (time) PENDING для границы доверия.
Процедура ОбработатьЗаписи(Состояние, Выписка, Неостаточные)

	Записи = ЗаписиПериода(Состояние);
	Тексты = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Тексты[Запись.Номер] = ТекстJSON(Запись.Данные);
	КонецЦикла;

	Пропустить = ДедупликацияПоИдентификатору(Записи, Тексты, Выписка);

	// Остаточные записи по id: сторно с id оригинала обнаруживается по ним.
	ПоИдентификатору = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Если Не ЭтоСоответствие(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Если Не Остаточная(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоИдентификатору[ИдентификаторЗаписи(Запись)];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоИдентификатору[ИдентификаторЗаписи(Запись)] = Список;
		КонецЕсли;
		Список.Добавить(Запись);
	КонецЦикла;

	Для Каждого Запись Из Записи Цикл

		Номер = Запись.Номер;
		Если Пропустить[Номер] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоСоответствие(Запись) Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, НСтр("ru = 'monobank юросіб: запись выписки не объект JSON.';
				|uk = 'monobank юросіб: запис виписки не є об''єктом JSON.'"));
			Продолжить;
		КонецЕсли;

		Данные = Запись.Данные;
		Идентификатор = ИдентификаторЗаписи(Запись);
		ВремяСоздания = ЦелоеИзJSON(Данные["time"]);
		ВремяПроведения = ?(Данные["completedTime"] = Неопределено Или ТипЗнч(Данные["completedTime"]) = Тип("Null"),
			ВремяСоздания, ЦелоеИзJSON(Данные["completedTime"]));
		Если ВремяСоздания = Неопределено Или ВремяПроведения = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: у операции %1 не читается время (time или completedTime).';
					|uk = 'monobank юросіб: в операції %1 не читається час (time або completedTime).'"), Идентификатор));
			Продолжить;
		КонецЕсли;
		Создана = СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(ВремяСоздания);
		Проведена = СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(ВремяПроведения);

		СтатусОперации = СтрокаИзJSON(Данные["status"]);
		Если СтатусОперации = "PENDING" Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: операция %1 в состоянии %2 еще не проведена и не загружена; граница доверия не позже ее времени.';
					|uk = 'monobank юросіб: операція %1 у стані %2 ще не проведена і не завантажена; межа довіри не пізніше її часу.'"),
				Идентификатор, СтатусОперации));
			Неостаточные.Добавить(Создана);
			Продолжить;
		ИначеЕсли СтатусОперации = "DECLINED" Тогда
			ДобавитьДиагностику(Выписка, "Предупреждение", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: операция %1 отклонена банком (состояние %2) и не загружена.';
					|uk = 'monobank юросіб: операція %1 відхилена банком (стан %2) і не завантажена.'"),
				Идентификатор, СтатусОперации));
			Продолжить;
		ИначеЕсли СтатусОперации <> "DONE" Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: операция %1 в неизвестном состоянии %2.';
					|uk = 'monobank юросіб: операція %1 у невідомому стані %2.'"), Идентификатор, СтатусОперации));
			Продолжить;
		КонецЕсли;

		Если Данные["reverse"] = Истина Тогда
			// Случай «б» (D36 п. 5): запись сторно с id оригинала - состояние оригинала изменилось, подать ее
			// отдельной операцией нельзя. Случай «а» (свой id) - обычная операция ниже.
			Совпала = Ложь;
			Для Каждого Другая Из ?(ПоИдентификатору[Идентификатор] = Неопределено, Новый Массив, ПоИдентификатору[Идентификатор]) Цикл
				Если Другая.Номер <> Номер И Другая.Данные["reverse"] <> Истина Тогда
					Совпала = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Совпала Тогда
				ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
					НСтр("ru = 'monobank юросіб: запись %1 (reverse) повторяет идентификатор исходной операции: банк изменил состояние переданной операции, отдельного документа возврата нет.';
						|uk = 'monobank юросіб: запис %1 (reverse) повторює ідентифікатор вихідної операції: банк змінив стан переданої операції, окремого документа повернення немає.'"),
					Идентификатор));
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Сумма = Данные["amount"];
		Если ТипЗнч(Сумма) <> Тип("Число") Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: у операции %1 сумма не число.'; uk = 'monobank юросіб: в операції %1 сума не є числом.'"),
				Идентификатор));
			Продолжить;
		КонецЕсли;

		Валюта = КодВалюты(Данные["currencyCode"]);
		Если Валюта = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: у операции %1 неизвестный код валюты %2.';
					|uk = 'monobank юросіб: в операції %1 невідомий код валюти %2.'"),
				Идентификатор, СтрокаИзJSON(Данные["currencyCode"])));
			Продолжить;
		КонецЕсли;

		Операция = Выписка.Операции.Добавить();
		Операция.ПорядковыйНомер = Номер;
		Операция.НомерСчета = Состояние.НомерСчета;
		Операция.Валюта = Валюта;
		Операция.ДатаОперации = Проведена;
		Операция.НомерДокумента = Идентификатор;
		Операция.ДатаДокумента = НачалоДня(Проведена);
		Операция.Сумма = ?(Сумма < 0, -Сумма, Сумма) / 100;
		Операция.Направление = ?(Сумма < 0, "Списано", "Поступило");
		Операция.ИдентификаторОперации = Идентификатор;
		Операция.КонтрагентНаименование = СтрокаИзJSON(Данные["counterName"]);
		Операция.КонтрагентНомерСчета = СтрокаИзJSON(Данные["counterIban"]);
		Операция.КонтрагентКод = СтрокаИзJSON(Данные["counterEdrpou"]);
		Операция.КонтрагентМФО = "";
		Операция.НазначениеПлатежа = НазначениеПлатежа(Данные);
		Операция.СырыеДанные = Тексты[Номер];

	КонецЦикла;

КонецПроцедуры

// Дедупликация внутри одного чтения по id (границы страниц на секунде дают повторы). Фильтр состояния - СПЕРШУ, как у
// предшественника: неостаточная запись в «виденных» не остается, поэтому DONE с тем же id на другой странице не теряется.
// Тождественный повтор - один раз; тот же id с другим содержанием, не пара сторно, - рядок Ошибка, повтор пропускается.
//
// Возвращаемое значение:
//  Соответствие - номера записей, которые дальше не обрабатываются.
Функция ДедупликацияПоИдентификатору(Записи, Тексты, Выписка)

	Пропустить = Новый Соответствие;
	Виденные = Новый Соответствие;
	ВиденныеНеостаточные = Новый Соответствие;

	Для Каждого Запись Из Записи Цикл
		Если Не ЭтоСоответствие(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = ИдентификаторЗаписи(Запись);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ?(Остаточная(Запись), Виденные, ВиденныеНеостаточные);
		Предыдущая = Таблица[Идентификатор];
		Если Предыдущая = Неопределено Тогда
			Таблица[Идентификатор] = Запись;
		ИначеЕсли Тексты[Предыдущая.Номер] = Тексты[Запись.Номер] Тогда
			Пропустить[Запись.Номер] = Истина;
		ИначеЕсли Таблица = Виденные И Не (Сторно(Запись) Или Сторно(Предыдущая)) Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Запись.Номер, СтрШаблон(
				НСтр("ru = 'monobank юросіб: идентификатор %1 повторяется с другим содержанием (конфликтный дубль); повтор пропущен.';
					|uk = 'monobank юросіб: ідентифікатор %1 повторюється з іншим змістом (конфліктний дубль); повтор пропущено.'"),
				Идентификатор));
			Пропустить[Запись.Номер] = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Пропустить;

КонецФункции

Функция ЭтоСоответствие(Запись)

	Возврат ТипЗнч(Запись.Данные) = Тип("Соответствие");

КонецФункции

Функция Остаточная(Запись)

	Возврат СтрокаИзJSON(Запись.Данные["status"]) = "DONE";

КонецФункции

Функция Сторно(Запись)

	Возврат Остаточная(Запись) И Запись.Данные["reverse"] = Истина;

КонецФункции

Функция ИдентификаторЗаписи(Запись)

	Возврат СтрокаИзJSON(Запись.Данные["id"]);

КонецФункции

// Назначение: description и «Фактичний платник» (ultimateDebit: наименование и код), без обрезания до 255 (отступ 5).
Функция НазначениеПлатежа(Данные)

	Результат = СокрЛП(СтрокаИзJSON(Данные["description"]));
	Плательщик = Данные["ultimateDebit"];
	Если ТипЗнч(Плательщик) = Тип("Соответствие") Тогда
		Представление = СокрЛП(СокрЛП(СтрокаИзJSON(Плательщик["name"])) + " " + СокрЛП(СтрокаИзJSON(Плательщик["idCode"])));
		Если Не ПустаяСтрока(Представление) Тогда
			Результат = Результат + " Фактичний платник: " + Представление;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Числовой код валюты тремя цифрами: нет поля - пусто (валюта счета); неизвестный код - Неопределено.
Функция КодВалюты(Значение)

	Текст = СокрЛП(СтрокаИзJSON(Значение));
	Если Текст <> "" И СтрДлина(Текст) < 3 И ТолькоЦифры(Текст) Тогда
		Текст = Лев("000", 3 - СтрДлина(Текст)) + Текст;
	КонецЕсли;
	Возврат СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(Текст);

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Целое из значения JSON: число или строка-число; иначе Неопределено.
Функция ЦелоеИзJSON(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Цел(Число(СокрЛП(Значение)));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Строка из значения JSON: нет значения и null - пусто (не слово «Неопределено»); число - без разделителей групп.
Функция СтрокаИзJSON(Значение)

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		// Массив или объект JSON вместо скаляра - пусто, а не представление платформы.
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ТекстJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ДобавитьДиагностику(Выписка, Уровень, Номер, Текст)

	Строка = Выписка.Диагностика.Добавить();
	Строка.Уровень = Уровень;
	Строка.ПорядковыйНомер = Номер;
	Строка.Текст = Текст;

КонецПроцедуры

#КонецОбласти
