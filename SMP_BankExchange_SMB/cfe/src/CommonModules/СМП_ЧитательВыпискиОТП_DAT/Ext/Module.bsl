// Читатель выписок: ОТП Банк, текст фиксированной ширины (.dat), поколение 1191 символ (план 03, задача 8).
// Один банк, один формат; строки по 1191 символ, без заголовка и итогов, каждая строка - одна операция.
// Поколение 660, DBF и XML ОТП этот модуль не читает (D30).
//
// Позиции полей - как в старой обработке (Сред, с единицы; длина в символах):
//   115,1 флаг направления («1» - поступило, «0» - списано)   117,16 сумма в копейках: только цифры
//   132,11 номер документа   1186,6 дата ррммдд
//   плательщик: счет 29,29   МФО 1,10   код 976,14   наименование 185,138
//   получатель: счет 86,29   МФО 58,9   код 1005,14  наименование 324,138
//   464,500 назначение платежа
//
// Известные особенности старой обработки, воспроизведенные как есть:
//  - номер документа берется с позиции 132, а не 134: к нему приклеен вид документа (первый символ).
//    Составной ключ (D17) берет номер как есть;
//  - наименование плательщика читается с позиции 185 (поле начинается на 184): первая буква теряется;
//  - поля номера (132, 11) и суммы (117, 16) перекрываются на позиции 132 (в образце там пробел);
//  - время операции в файле нет: 00:00:00; валюту старая обработка не читает: пуста (валюта счета).
// ДатаДокумента не заполняется: старая обработка кладет в ДатаДок день операции, а составной ключ при
// пустой ДатаДокумента берет дату операции (спека, D17). Девятизначный идентификатор банка не читается:
// стабильность между выгрузками не доказана, а ключ D17 на неверном идентификаторе опасен.
//
// Наш счет строки (НомерСчета) - из полей файла, а не из Параметры.НомерСчета: по направлению это счет
// получателя («1») или плательщика («0»); так фильтр чужих счетов платформы видит настоящий счет строки.
// Направление строго: любое иное значение флага - «Ошибка» с сырым значением (старая обработка считала
// списанием все, кроме «1»). Строка короче 1191 символа - «Ошибка» с номером строки; длиннее читается
// теми же позициями.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет «Ошибка» с
// сырым значением, ЧтениеПолное остается Ложь.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер фиксированной ширины и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("dat");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиОТП_DAT");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'ОТП Банк, текстовый файл (.dat)';
		|uk = 'ОТП Банк, текстовий файл (.dat)'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (Кодировка - из описания читателя).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	КодировкаФайла = Параметры.Кодировка;
	Если ПустаяСтрока(КодировкаФайла) Тогда
		КодировкаФайла = Кодировка();
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.СтрокиФиксированнойШирины(Данные, КодировкаФайла);
	Если Записи.Количество() = 0 Тогда
		ДобавитьСообщение(Выписка, "Ошибка", 0, НСтр("ru = 'Файл пуст: в нем нет ни одной строки.';
			|uk = 'Файл порожній: у ньому немає жодного рядка.'"));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	Для Каждого Запись Из Записи Цикл
		Операция = РазобратьЗапись(Запись, Выписка);
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка начала файла: «файл похож на этот формат». Читает только начало файла: первая строка
// ровно 1191 символ (поколение 660 и другие длины отпадают), флаг направления - «0» или «1», последние
// шесть символов - цифры даты. Остальные строки не проверяются.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	// Из потока читается только начало файла; файл целиком в буфер не копируется.
	Начало = СМП_ЧтениеВыписокОбщее.НачалоДанных(Данные, 4096);
	Если Начало.Размер() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.СтрокиФиксированнойШирины(Начало, Кодировка());
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Строка = Записи[0].Сырые;
	Если СтрДлина(Строка) <> ДлинаСтроки() Тогда
		Возврат Ложь;
	КонецЕсли;

	Флаг = СМП_ЧтениеВыписокОбщее.ПолеФиксированнойШирины(Строка, 115, 1);
	Возврат (Флаг = "0" Или Флаг = "1")
		И ТолькоЦифры(СМП_ЧтениеВыписокОбщее.ПолеФиксированнойШирины(Строка, 1186, 6));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образца (20-samples.md): windows-1251.
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

// Длина строки поколения 1191.
Функция ДлинаСтроки()

	Возврат 1191;

КонецФункции

Функция ТолькоЦифры(Текст)

	Если СтрДлина(Текст) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Позиция);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция Поле(Строка, Позиция, Длина)

	Возврат СМП_ЧтениеВыписокОбщее.ПолеФиксированнойШирины(Строка, Позиция, Длина);

КонецФункции

// Разбирает запись в структуру операции или возвращает Неопределено, дописав в диагностику «Ошибка» по каждому
// нераспознанному значению (строка в Операции не попадает).
Функция РазобратьЗапись(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Строка = Запись.Сырые;

	Если СтрДлина(Строка) < ДлинаСтроки() Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'В строке %1 символов: %2, нужно не меньше %3. Строка не прочитана.';
				|uk = 'У рядку %1 символів: %2, потрібно не менше %3. Рядок не прочитано.'"),
			Формат(Номер, "ЧГ="), Формат(СтрДлина(Строка), "ЧГ="), Формат(ДлинаСтроки(), "ЧГ=")));
		Возврат Неопределено;
	КонецЕсли;

	Ошибок = 0;

	// Дата ррммдд: в файле только день, времени нет.
	СырьеДаты = Поле(Строка, 1186, 6);
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "ррммдд");
	Если ДатаОперации = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату операции: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Направление - строго по флагу.
	СырьеФлага = Поле(Строка, 115, 1);
	Поступило = Ложь;
	Если СырьеФлага = "1" Тогда
		Поступило = Истина;
	ИначеЕсли СырьеФлага <> "0" Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный признак направления: «%1», ожидалось 0 или 1.';
				|uk = 'Рядок не прочитано: невідома ознака напряму: «%1», очікувалось 0 або 1.'"),
			СырьеФлага));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Сумма - целое число копеек: только цифры (после снятия пробелов по краям). Разделитель, дробная часть,
	// знак, буквы, пробел внутри - не сумма: общий разбор суммы принял бы «12.5» и дал 0.125 (в 100 раз меньше).
	СырьеСуммы = Поле(Строка, 117, 16);
	Сумма = Неопределено;
	Если ТолькоЦифры(СырьеСуммы) Тогда
		Сумма = Число(СырьеСуммы);
	КонецЕсли;
	Если Сумма = Неопределено Тогда
		ДобавитьСообщение(Выписка, "Ошибка", Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати суму: «%1».'"),
			СырьеСуммы));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", Поле(Строка, 132, 11));
	Операция.Вставить("Сумма", Сумма / 100);
	Операция.Вставить("НазначениеПлатежа", Поле(Строка, 464, 500));
	Операция.Вставить("СырыеДанные", Запись.Сырые);

	Если Поступило Тогда
		Операция.Вставить("Направление", "Поступило");
		Операция.Вставить("НомерСчета", Поле(Строка, 86, 29));
		Операция.Вставить("КонтрагентНомерСчета", Поле(Строка, 29, 29));
		Операция.Вставить("КонтрагентМФО", Поле(Строка, 1, 10));
		Операция.Вставить("КонтрагентКод", Поле(Строка, 976, 14));
		Операция.Вставить("КонтрагентНаименование", Поле(Строка, 185, 138));
	Иначе
		Операция.Вставить("Направление", "Списано");
		Операция.Вставить("НомерСчета", Поле(Строка, 29, 29));
		Операция.Вставить("КонтрагентНомерСчета", Поле(Строка, 86, 29));
		Операция.Вставить("КонтрагентМФО", Поле(Строка, 58, 9));
		Операция.Вставить("КонтрагентКод", Поле(Строка, 1005, 14));
		Операция.Вставить("КонтрагентНаименование", Поле(Строка, 324, 138));
	КонецЕсли;

	Возврат Операция;

КонецФункции

Процедура ДобавитьСообщение(Выписка, Уровень, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = Уровень;
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

#КонецОбласти
