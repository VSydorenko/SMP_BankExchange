// Серверная часть справочного транспорта СМП_ТранспортHTTP: ожидание (пауза между запросами к API банка).
//
// Модуль не ворота переносимости: транспорт конфигурационный (D36 п. 1). Вынесен из обработки, потому
// что цель фонового задания - экспортный метод общего модуля, а методом обработки задание не запустить.

#Область ПрограммныйИнтерфейс

// Ожидание без загрузки процессора, по образцу ОбщегоНазначенияБТС.Пауза и предшественника
// (СМП_РаботаСБанкамиМонобанкAPIСервер.Пауза): фоновое задание ждет само себя. В фоновом задании
// метод ждет у текущего задания; вне фонового задания запускает вспомогательное, которое делает то же,
// и ожидает его завершения не дольше Секунд.
//
// Платформа не имеет вызова ожидания. Основание выбора: цикл по ТекущаяУниверсальнаяДата грузил бы
// процессор, а фоновое задание, ожидающее само себя, блокируется в платформе. Ограничение: фоновые
// задания есть только на сервере. Вызов вне серверного контекста (клиент, веб-клиент) не работает:
// там этот модуль недоступен (флаг Сервер, клиентский контекст выключен) - транспорт предназначен для
// фонового выполнения регламента (этап 5б), а не для интерактивного клиента.
//
// Параметры:
//  Секунды - Число - длительность паузы; нуль и меньше - возврат сразу.
Процедура Пауза(Секунды) Экспорт

	Ждать = СекундыОжидания(Секунды);
	Если Ждать = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
		Если ФоновоеЗадание = Неопределено Тогда
			Параметры = Новый Массив;
			Параметры.Добавить(Ждать);
			ФоновоеЗадание = ФоновыеЗадания.Выполнить("СМП_ТранспортHTTPСервер.Пауза", Параметры, ,
				НСтр("ru = 'Пауза между запросами к банку'; uk = 'Пауза між запитами до банку'"));
		КонецЕсли;

		ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Ждать);
	Исключение
		// Пауза - лучшее усилие: сбой ожидания не должен выходить в конектор исключением (точка чтения
		// превратила бы его в «действие человека», хотя это временный сбой). Пауза пропущена, причина
		// - в журнале регистрации; пропущенная пауза в худшем случае даст отказ банка по лимиту, а он
		// конектору знаком (429, класс «повторить»).
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ТранспортHTTP.Пауза'; uk = 'СМП.ТранспортHTTP.Пауза'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = 'Пауза %1 с пропущена из-за сбоя ожидания: %2';
				|uk = 'Паузу %1 с пропущено через збій очікування: %2'"),
				Формат(Ждать, "ЧН=0; ЧГ="), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Целые секунды ожидания для паузы. Фоновое задание ждет саму себя с целым таймаутом, и нуль платформа
// может прочитать как «без ограничения времени» (задание повисло бы), поэтому дробные значения
// (0 < x < 1) округляются вверх до секунды, а нуль, отрицательное и не число - «не ждать» (0).
//
// Параметры:
//  Секунды - Произвольный - запрошенная пауза.
//
// Возвращаемое значение:
//  Число - целое число секунд; 0 - не ждать.
Функция СекундыОжидания(Секунды) Экспорт

	Если ТипЗнч(Секунды) <> Тип("Число") Или Секунды <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(1, Окр(Секунды, 0, РежимОкругления.Окр15как20));

КонецФункции

#КонецОбласти
