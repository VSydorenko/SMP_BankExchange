// Спільні функції конекторів API (план 05а, задача 3; спека D36 п. 1, 7, 8).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только
// с типами платформы, не читает метаданные, сеанс и серверные часы. Пояс времени всегда
// явный. Сюда вынесено только то, что у конекторов банков общее на самом деле: перевод момента Unix
// в киевское время, чтение JSON из тела в явной кодировке, класс отказа по статусу HTTP, текст отказа
// банка для человека без учетных данных и форма ответа транспорта.
//
// Модуль не знает транспорта (он приходит конектору значением в Параметры.Транспорт) и банков. Курсор, период регламента и перекрытие
// (ADR-0014) ядру неизвестны: оно выполняет запрос, классифицирует отказ, маскирует секреты и завершает чтение, а обход периода и
// отображение полей остаются в конекторе.
//
// Ядро запроса и хвоста читает Состояние конектора - структуру с полями:
//  * Банк - Строка - название банка для текстов отказа;
//  * Транспорт - объект с методами ВыполнитьЗапрос, Пауза, ТекущийМомент;
//  * УчетныеДанные - Структура, Неопределено - учетные данные чтения (их значения - секреты);
//  * Отказ - Неопределено или Структура (Класс, Тексты) - первый отказ определяет класс, тексты копятся все;
//  * ПаузаПередЗапросом - Число - сколько секунд ждать перед следующим запросом (0 - не ждать);
//  * МоментUnix - Число - момент чтения, секунды Unix (для ЧтениеБудущегоПериода);
//  * Страниц, ПотолокСтраниц - Число - счетчик страниц и предел (для ДостигнутПотолок);
//  необязательные: Токен - Строка - сеансовый токен, полученный в ходе чтения (маскируется как учетные данные);
//  Остановка - Булево - ставится отказом с признаком Остановить.

#Область ПрограммныйИнтерфейс

// Момент Unix (секунды с 1970-01-01 00:00:00 UTC) в киевское местное время. Пояс явный: пояс сеанса
// результат не меняет. Местное время вокруг осеннего перехода неоднозначно (час повторяется), это
// свойство местного времени, а не функции.
//
// Параметры:
//  Секунды - Число - момент Unix в секундах.
//
// Возвращаемое значение:
//  Дата - киевское местное время.
Функция МоментUnixВКиевскоеВремя(Секунды) Экспорт

	МоментUTC = Дата(1970, 1, 1) + Цел(Секунды);
	Возврат МестноеВремя(МоментUTC, ЧасовойПоясКиев());

КонецФункции

// Киевское местное время в момент Unix (секунды). Неоднозначный час осеннего перехода платформа берет
// как второе (зимнее) вхождение, несуществующий час весны - как зимнее смещение (измерено задачей 0).
//
// Параметры:
//  МестноеВремя - Дата - киевское местное время.
//
// Возвращаемое значение:
//  Число - секунды с 1970-01-01 00:00:00 UTC.
Функция КиевскоеВремяВМоментUnix(МестноеВремя) Экспорт

	Возврат УниверсальноеВремя(МестноеВремя, ЧасовойПоясКиев()) - Дата(1970, 1, 1);

КонецФункции

// Пустой ответ транспорта: одна форма у справочного транспорта продукта и у транспорта воспроизведения.
//
// Возвращаемое значение:
//  Структура - ответ:
//   * Сбой - Булево - Истина, если ответа банка нет (сеть, таймаут и подобное); тогда Статус = 0.
//   * ВидСбоя - Строка - "timeout", "network" или "other"; пустая при отсутствии сбоя.
//   * ТекстСбоя - Строка - текст для человека; не содержит заголовков запроса (в них учетные данные).
//   * Статус - Число - HTTP-статус; 0 при сбое.
//   * Заголовки - Соответствие - заголовки ответа, имена в нижнем регистре.
//   * Тело - ДвоичныеДанные - тело ответа байтами, как пришло.
Функция НовыйОтветТранспорта() Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("Сбой", Ложь);
	Ответ.Вставить("ВидСбоя", "");
	Ответ.Вставить("ТекстСбоя", "");
	Ответ.Вставить("Статус", 0);
	Ответ.Вставить("Заголовки", Новый Соответствие);
	Ответ.Вставить("Тело", Base64Значение(""));
	Возврат Ответ;

КонецФункции

// Читает JSON из тела ответа в явной кодировке, без исключения наружу. Тело, не являющееся JSON (страница
// ошибки прокси, обрезанный ответ, пустое тело), - не исключение, а Успех = Ложь с причиной: решение о
// классе отказа за конектором (D36 п. 8: тело не того формата - "повторить").
//
// Параметры:
//  Тело - ДвоичныеДанные - тело ответа.
//  Кодировка - Строка - кодировка тела, например "utf-8" или "windows-1251"; явная, по умолчанию не угадывается.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Успех - Булево - Истина, если тело прочитано как JSON.
//   * Значение - Соответствие, Массив, Произвольный, Неопределено - прочитанное; объекты JSON - Соответствие.
//   * Текст - Строка - причина при неудаче; пустая при успехе. Не содержит тела.
Функция ПрочитатьJSONИзТела(Тело, Кодировка) Экспорт

	Результат = Новый Структура("Успех, Значение, Текст", Ложь, Неопределено, "");

	Если ТипЗнч(Тело) <> Тип("ДвоичныеДанные") Или Тело.Размер() = 0 Тогда
		Результат.Текст = НСтр("ru = 'Тело ответа пустое.'; uk = 'Тіло відповіді порожнє.'");
		Возврат Результат;
	КонецЕсли;

	Чтение = Неопределено;
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Тело, Кодировка);
		Если Лев(Текст, 1) = Символ(65279) Тогда
			Текст = Сред(Текст, 2);
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Результат.Значение = Значение;
		Результат.Успех = Истина;
	Исключение
		Результат.Значение = Неопределено;
		Результат.Успех = Ложь;
		Результат.Текст = СтрШаблон(
			НСтр("ru = 'Тело ответа не прочитано как JSON: %1';
				|uk = 'Тіло відповіді не прочитано як JSON: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если Чтение <> Неопределено Тогда
			Попытка
				Чтение.Закрыть();
			Исключение
				// Закрытие чтения не должно менять результат.
			КонецПопытки;
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Кодировка тела из заголовка content-type ответа ("...; charset=windows-1251"), в нижнем регистре.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки ответа, имена в нижнем регистре.
//  ПоУмолчанию - Строка - что вернуть, если в заголовках кодировки нет.
//
// Возвращаемое значение:
//  Строка - имя кодировки.
Функция КодировкаИзЗаголовков(Заголовки, ПоУмолчанию) Экспорт

	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	ТипСодержимого = Заголовки["content-type"];
	Если ТипЗнч(ТипСодержимого) <> Тип("Строка") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Нижний = НРег(ТипСодержимого);
	Позиция = СтрНайти(Нижний, "charset=");
	Если Позиция = 0 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Остаток = Сред(Нижний, Позиция + СтрДлина("charset="));
	Конец = СтрНайти(Остаток, ";");
	Если Конец > 0 Тогда
		Остаток = Лев(Остаток, Конец - 1);
	КонецЕсли;
	Результат = СокрЛП(СтрЗаменить(СтрЗаменить(Остаток, """", ""), "'", ""));
	Возврат ?(ПустаяСтрока(Результат), ПоУмолчанию, Результат);

КонецФункции

// Класс отказа по статусу HTTP: отвечает на вопрос «поможет ли повтор» (D36 п. 8).
// - 2xx - отказа нет;
// - 408, 429 (после допустимого повтора конектора), 5xx - "Повторить";
// - остальные: 401 и 403 (аутентификация), другие 4xx, а также 3xx и 1xx - "ДействиеЧеловека";
// - статус 0 (ответа не было, сбой транспорта) - "Повторить".
//
// Параметры:
//  Статус - Число - HTTP-статус ответа.
//
// Возвращаемое значение:
//  Строка - значение КлассОтказа контракта (см. СМП_ВыпискаБанка.КлассОтказа*).
Функция КлассОтказаПоСтатусуHTTP(Статус) Экспорт

	Если Статус >= 200 И Статус < 300 Тогда
		Возврат СМП_ВыпискаБанка.КлассОтказаНет();
	КонецЕсли;
	Если Статус = 0 Или Статус = 408 Или Статус = 429 Или (Статус >= 500 И Статус < 600) Тогда
		Возврат СМП_ВыпискаБанка.КлассОтказаПовторить();
	КонецЕсли;
	Возврат СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека();

КонецФункции

// Текст отказа банка для человека: называет банк, статус и описание банка; учетных данных не содержит.
// Описание банка укорачивается (страница ошибки прокси не должна попасть в журнал целиком).
//
// Параметры:
//  Банк - Строка - название банка для человека.
//  Статус - Число - HTTP-статус отказа.
//  ОписаниеБанка - Строка, Неопределено - текст ошибки, который вернул банк; может быть пустым.
//  УчетныеДанные - Структура, Неопределено - учетные данные: их значения вырезаются из текста.
//
// Возвращаемое значение:
//  Строка - текст отказа.
Функция ТекстОтказаБанка(Банк, Статус, ОписаниеБанка, УчетныеДанные) Экспорт

	Описание = ?(ТипЗнч(ОписаниеБанка) = Тип("Строка"), СокрЛП(ОписаниеБанка), "");
	Описание = СокрЛП(СтрЗаменить(СтрЗаменить(Описание, Символы.ПС, " "), Символы.ВК, " "));
	// Сначала вырезаем учетные данные, потом обрезаем: иначе значение, пересекшее границу обрезания,
	// оставило бы видимый префикс.
	Описание = УбратьУчетныеДанные(Описание, УчетныеДанные);
	Если СтрДлина(Описание) > МаксимальнаяДлинаОписанияБанка() Тогда
		Описание = Лев(Описание, МаксимальнаяДлинаОписанияБанка()) + "...";
	КонецЕсли;

	ТекстСтатуса = ?(ТипЗнч(Статус) = Тип("Число"), Формат(Статус, "ЧН=0; ЧГ="), "");

	Если ПустаяСтрока(Описание) Тогда
		Текст = СтрШаблон(
			НСтр("ru = 'Банк %1 отказал в запросе, статус %2.'; uk = 'Банк %1 відмовив у запиті, статус %2.'"),
			Банк, ТекстСтатуса);
	Иначе
		Текст = СтрШаблон(
			НСтр("ru = 'Банк %1 отказал в запросе, статус %2: %3';
				|uk = 'Банк %1 відмовив у запиті, статус %2: %3'"),
			Банк, ТекстСтатуса, Описание);
	КонецЕсли;

	Возврат УбратьУчетныеДанные(Текст, УчетныеДанные);

КонецФункции

// Вырезает из текста значения секретов (заменяет на "***"): токен не должен попасть ни в диагностику, ни в текст
// исключения, ни в журнал (D36 п. 3). Единственное место маскирования для всех конекторов и точки чтения. Каждое
// значение вырезается без учета регистра в трех видах: как есть, после СокрЛП и в URL-кодировании (ПУМБ кладет
// учетные данные в тело form-urlencoded, банк может вернуть тело в тексте ошибки). Формы режутся от длинной к
// короткой: короткое значение, входящее в длинное, не должно оставить хвост длинного.
//
// Параметры:
//  Текст - Строка - текст.
//  УчетныеДанные - Структура, Неопределено - секреты с рядковыми полями: учетные данные чтения и, если есть,
//    сеансовый токен (см. СекретыСостояния; точка чтения сеансового токена не видит).
//
// Возвращаемое значение:
//  Строка - текст без значений секретов.
Функция УбратьУчетныеДанные(Текст, УчетныеДанные) Экспорт

	Если ТипЗнч(УчетныеДанные) <> Тип("Структура") Или ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат УбратьФормы(Текст, ФормыСекретов(УчетныеДанные));

КонецФункции

// Секреты состояния чтения: значения учетных данных и сеансовый токен (Состояние.Токен), полученный в ходе чтения.
//
// Параметры:
//  Состояние - Структура - состояние чтения конектора.
//
// Возвращаемое значение:
//  Структура - секреты для УбратьУчетныеДанные.
Функция СекретыСостояния(Состояние) Экспорт

	Секреты = Новый Структура;
	Если Состояние.Свойство("УчетныеДанные") И ТипЗнч(Состояние.УчетныеДанные) = Тип("Структура") Тогда
		Для Каждого Элемент Из Состояние.УчетныеДанные Цикл
			Секреты.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	Если Состояние.Свойство("Токен") Тогда
		Секреты.Вставить("СеансовыйТокен", Состояние.Токен);
	КонецЕсли;
	Возврат Секреты;

КонецФункции

// Первый отказ определяет класс (причина, остановившая чтение или сделавшая его неполным); тексты копятся все.
// Текст идет в Состояние.Отказ уже без секретов состояния.
//
// Параметры:
//  Состояние - Структура - состояние чтения конектора.
//  Класс - Строка - класс отказа контракта.
//  Текст - Строка - текст отказа для человека.
//  Остановить - Булево - чтение дальше не идет (Состояние.Остановка), только для конектора, у которого это поле есть.
Процедура Отказать(Состояние, Класс, Текст, Остановить = Ложь) Экспорт

	Если Состояние.Отказ = Неопределено Тогда
		Состояние.Отказ = Новый Структура("Класс, Тексты", Класс, Новый Массив);
	КонецЕсли;
	Состояние.Отказ.Тексты.Добавить(УбратьУчетныеДанные(Текст, СекретыСостояния(Состояние)));
	Если Остановить Тогда
		Состояние.Остановка = Истина;
	КонецЕсли;

КонецПроцедуры

// Запрос банка: одна структура (метод, адрес, заголовки, тело, очікуваний тип, политика пауз). Заполняет конектор.
//
// Возвращаемое значение:
//  Структура - запрос:
//   * Метод - Строка - HTTP-метод.
//   * Адрес - Строка - полный адрес.
//   * Заголовки - Соответствие - заголовки запроса (в них учетные данные).
//   * Тело - Строка, ДвоичныеДанные, Неопределено - тело запроса.
//   * ОжидаемыйТип - Строка - "Соответствие", "Массив" или "" (тип тела ответа не проверяется).
//   * ПоляОписания - Строка - имена полей тела ответа через запятую, из которых берется описание ошибки банка (первое найденное).
//   * Повтор429 - Булево - одна повторная попытка после 429 с паузой по заголовкам (предел паузы - ПотолокПаузы).
//   * ПаузаПослеУспеха - Число - пауза перед следующим запросом после успешного (секунды; 0 - нет паузы).
//   * ПаузаПоЛимиту - Булево - после успешного запроса с заголовком x-rate-limit-remaining = 0 следующий запрос ждет паузу по заголовкам (не дольше предела).
//   * Остановить - Булево - отказ запроса останавливает чтение (см. Отказать).
Функция НовыйЗапросБанка() Экспорт

	Запрос = Новый Структура;
	Запрос.Вставить("Метод", "GET");
	Запрос.Вставить("Адрес", "");
	Запрос.Вставить("Заголовки", Новый Соответствие);
	Запрос.Вставить("Тело", Неопределено);
	Запрос.Вставить("ОжидаемыйТип", "");
	Запрос.Вставить("ПоляОписания", "message");
	Запрос.Вставить("Повтор429", Ложь);
	Запрос.Вставить("ПаузаПослеУспеха", 0);
	Запрос.Вставить("ПаузаПоЛимиту", Ложь);
	Запрос.Вставить("Остановить", Ложь);
	Возврат Запрос;

КонецФункции

// Выполняет один запрос банка через транспорт состояния: паузы, повтор после 429, класс отказа по статусу и телу, текст отказа без
// секретов. Любой отказ записан в Состояние.Отказ (Отказать); исключений наружу нет. D36 п. 7, 8.
//
// Параметры:
//  Состояние - Структура - состояние чтения конектора (см. описание модуля).
//  Запрос - Структура - см. НовыйЗапросБанка.
//
// Возвращаемое значение:
//  Структура - ответ:
//   * Успех - Булево - Истина, если статус 200 и тело прочитано как JSON ожидаемого типа.
//   * Статус - Число - HTTP-статус; 0, если ответа не было.
//   * Значение - Произвольный - прочитанный JSON при успехе, иначе Неопределено.
//   * КлассОтказа - Строка - класс отказа при неудаче, иначе пусто.
//   * Текст - Строка - текст отказа без секретов при неудаче, иначе пусто.
Функция ВыполнитьЗапросБанка(Состояние, Запрос) Экспорт

	Ответ = Неопределено;
	Для НомерПопытки = 1 По 2 Цикл
		// Пауза выполняется перед следующим запросом, а не сразу: после последнего обмена ждать нечего.
		Если Состояние.ПаузаПередЗапросом > 0 Тогда
			Состояние.Транспорт.Пауза(Состояние.ПаузаПередЗапросом);
			Состояние.ПаузаПередЗапросом = 0;
		КонецЕсли;
		Ответ = Состояние.Транспорт.ВыполнитьЗапрос(Запрос.Метод, Запрос.Адрес, Запрос.Заголовки, Запрос.Тело);
		Если Запрос.Повтор429 И Не Ответ.Сбой И Ответ.Статус = 429 И НомерПопытки = 1 Тогда
			Запрошено = СекундыПаузы(Ответ);
			Если Запрошено > ПотолокПаузы() Тогда
				Возврат ОтказЗапроса(Состояние, Запрос, "Повторить", СтрШаблон(
					НСтр("ru = 'Банк %1: статус 429 (%4), банк просит паузу %2 с, это больше предела %3 с; ожидание не выполняется, чтение неполное, повторите позже.';
						|uk = 'Банк %1: статус 429 (%4), банк просить паузу %2 с, це більше за межу %3 с; очікування не виконується, читання неповне, повторіть пізніше.'"),
					Состояние.Банк, Формат(Запрошено, "ЧГ=0"), Формат(ПотолокПаузы(), "ЧГ=0"),
					ОписаниеОшибкиБанка(ПрочитатьJSONИзТела(Ответ.Тело, КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8")), Запрос.ПоляОписания)), 429);
			КонецЕсли;
			Состояние.ПаузаПередЗапросом = Запрошено;
			Продолжить;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если Ответ.Сбой Тогда
		Возврат ОтказЗапроса(Состояние, Запрос, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: ответа нет (%2): %3';
				|uk = 'Банк %1: відповіді немає (%2): %3'"),
			Состояние.Банк, Ответ.ВидСбоя, Ответ.ТекстСбоя), 0);
	КонецЕсли;

	Тело = ПрочитатьJSONИзТела(Ответ.Тело, КодировкаИзЗаголовков(Ответ.Заголовки, "utf-8"));
	Секреты = СекретыСостояния(Состояние);

	Если Ответ.Статус <> 200 Тогда
		Класс = КлассОтказаПоСтатусуHTTP(Ответ.Статус);
		Если Класс = "" Тогда
			// 2xx, кроме 200, - неожиданный ответ: временная проблема.
			Класс = "Повторить";
		КонецЕсли;
		Возврат ОтказЗапроса(Состояние, Запрос, Класс, ТекстОтказаБанка(Состояние.Банк, Ответ.Статус,
			ОписаниеОшибкиБанка(Тело, Запрос.ПоляОписания), Секреты), Ответ.Статус);
	КонецЕсли;

	Если Не Тело.Успех Тогда
		Возврат ОтказЗапроса(Состояние, Запрос, "Повторить", ТекстОтказаБанка(Состояние.Банк, Ответ.Статус, Тело.Текст, Секреты), Ответ.Статус);
	КонецЕсли;
	Если Запрос.ОжидаемыйТип <> "" И ТипЗнч(Тело.Значение) <> Тип(Запрос.ОжидаемыйТип) Тогда
		Возврат ОтказЗапроса(Состояние, Запрос, "Повторить", ТекстОтказаБанка(Состояние.Банк, Ответ.Статус,
			?(Запрос.ОжидаемыйТип = "Массив", НСтр("ru = 'ожидался массив'; uk = 'очікувався масив'"),
				НСтр("ru = 'ожидался объект'; uk = 'очікувався об''єкт'")), Секреты), Ответ.Статус);
	КонецЕсли;

	Состояние.ПаузаПередЗапросом = Запрос.ПаузаПослеУспеха;
	// Лимит запросов исчерпан: следующий запрос упал бы на 429, ждем заранее, но не дольше предела (если банк после паузы
	// все же откажет 429, сработает проверка предела выше).
	Если Запрос.ПаузаПоЛимиту И СокрЛП(Строка(Ответ.Заголовки["x-rate-limit-remaining"])) = "0" Тогда
		Состояние.ПаузаПередЗапросом = Мин(СекундыПаузы(Ответ), ПотолокПаузы());
	КонецЕсли;

	Результат = Новый Структура("Успех, Статус, Значение, КлассОтказа, Текст", Истина, Ответ.Статус, Тело.Значение, "", "");
	Возврат Результат;

КонецФункции

// Завершает чтение конектора (D36 п. 8, 10): отказ - класс, неполное чтение, граница доверия в начале периода, тексты отказа в диагностику;
// без отказа - полное чтение и граница доверия - самая ранняя из кандидатов, не раньше начала периода. Если чтение остановил предел страниц
// (в Состояние есть ключ ГраницаПотолка, см. ДостигнутПотолок), в конверт кладется ПрочитанныйОтрезок: от начала периода до момента остановки
// или от момента остановки до конца периода, по направлению чтения конектора; в нем же ключ ГраницаДоверия (план 5б, Р-6) - самая ранняя из
// кандидатов, лежащих внутри отрезка, а если таких нет - конец отрезка. Регламент рукой границу отрезка не вычисляет: ядро знает кандидатов,
// регламент берет готовое значение. Затем секреты состояния (учетные данные и сеансовый токен)
// вырезаются из диагностики и СырыеДанные конверта: точка чтения сеансового токена не видит.
//
// Параметры:
//  Состояние - Структура - состояние чтения конектора (Отказ, УчетныеДанные, Токен; необязательно ГраницаПотолка).
//  Параметры - Структура - параметры чтения (НачалоПериода, КонецПериода).
//  Выписка - Структура - конверт платформы.
//  Кандидаты - Массив из Дата - моменты, не позже которых граница доверия: конец периода, момент чтения, неостаточные операции,
//    граница банка. Не пуст.
Процедура ЗавершитьЧтение(Состояние, Параметры, Выписка, Кандидаты) Экспорт

	Если Состояние.Отказ <> Неопределено Тогда
		Выписка.КлассОтказа = Состояние.Отказ.Класс;
		Выписка.ЧтениеПолное = Ложь;
		Выписка.ГраницаДоверия = Параметры.НачалоПериода;
		Для Каждого Текст Из Состояние.Отказ.Тексты Цикл
			ДобавитьДиагностику(Выписка, "Предупреждение", 0, Текст);
		КонецЦикла;
	Иначе
		Самая = Кандидаты[0];
		Для Каждого Кандидат Из Кандидаты Цикл
			Самая = Мин(Самая, Кандидат);
		КонецЦикла;
		Выписка.КлассОтказа = "";
		Выписка.ЧтениеПолное = Истина;
		Выписка.ГраницаДоверия = Макс(Параметры.НачалоПериода, Самая);
	КонецЕсли;

	// Прочитанный отрезок: ставит только ядро и только при пределе страниц (признак - ключ, а не класс отказа: Отказ.Класс фиксирует
	// первый отказ). Момент ограничен периодом, отрезок всегда внутри него.
	Выписка.ПрочитанныйОтрезок = Неопределено;
	Если Состояние.Свойство("ГраницаПотолка") Тогда
		Момент = Макс(Параметры.НачалоПериода, Мин(Состояние.ГраницаПотолка.Момент, Параметры.КонецПериода));
		Выписка.ПрочитанныйОтрезок = ?(Состояние.ГраницаПотолка.ОтКонца,
			Новый Структура("Начало, Конец", Момент, Параметры.КонецПериода),
			Новый Структура("Начало, Конец", Параметры.НачалоПериода, Момент));
		// Граница доверия отрезка (Р-6): самый ранний кандидат внутри отрезка; кандидат вне отрезка (за непрочитанной частью) о нем ничего не говорит.
		ГраницаОтрезка = Выписка.ПрочитанныйОтрезок.Конец;
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат >= Выписка.ПрочитанныйОтрезок.Начало И Кандидат < ГраницаОтрезка Тогда
				ГраницаОтрезка = Кандидат;
			КонецЕсли;
		КонецЦикла;
		Выписка.ПрочитанныйОтрезок.Вставить("ГраницаДоверия", ГраницаОтрезка);
	КонецЕсли;

	Формы = ФормыСекретов(СекретыСостояния(Состояние));
	УбратьИзКолонки(Выписка.Диагностика, "Текст", Формы);
	УбратьИзКолонки(Выписка.Операции, "СырыеДанные", Формы);

КонецПроцедуры

// НачалоПериода позже момента чтения (D36 п. 11): запросов нет, конверт пуст, чтение полное, граница доверия - НачалоПериода. Порядок
// проверок: период наоборот (точка чтения) -> эта ветка -> обычное чтение. ЕДИНСТВЕННОЕ место ветки.
//
// Параметры:
//  Состояние - Структура - состояние чтения (МоментUnix).
//  Параметры - Структура - параметры чтения (НачалоПериода).
//  Выписка - Структура - конверт платформы.
//
// Возвращаемое значение:
//  Булево - Истина, если чтение закончено этой веткой.
Функция ЧтениеБудущегоПериода(Состояние, Параметры, Выписка) Экспорт

	Если КиевскоеВремяВМоментUnix(Параметры.НачалоПериода) <= Состояние.МоментUnix Тогда
		Возврат Ложь;
	КонецЕсли;
	Выписка.КлассОтказа = "";
	Выписка.ЧтениеПолное = Истина;
	Выписка.ГраницаДоверия = Параметры.НачалоПериода;
	Возврат Истина;

КонецФункции

// Достигнут ли предел страниц (предохранитель от бесконечного цикла, D36 п. 11): отказ «ДействиеЧеловека» с числом страниц, операций и
// границей, на которой чтение остановлено. При пределе в Состояние кладется ключ ГраницаПотолка (момент и направление): по нему
// ЗавершитьЧтение строит ПрочитанныйОтрезок конверта. Признак «предел» - наличие ключа, а не класс отказа (решение 9 плана 6б).
//
// Параметры:
//  Состояние - Структура - состояние чтения (Страниц, ПотолокСтраниц); при пределе получает ключ ГраницаПотолка.
//  Момент - Дата - граница, на которой остановлено чтение, киевское время.
//  Операций - Число - сколько операций прочитано.
//  Остановить - Булево - см. Отказать.
//  ОтКонца - Булево - направление чтения: Ложь - от начала периода (прочитанное - до Момента), Истина - от конца периода
//    (прочитанное - от Момента).
//
// Возвращаемое значение:
//  Булево - Истина, если предел достигнут и отказ записан.
Функция ДостигнутПотолок(Состояние, Момент, Операций, Остановить = Ложь, ОтКонца = Ложь) Экспорт

	Если Состояние.Страниц < Состояние.ПотолокСтраниц Тогда
		Возврат Ложь;
	КонецЕсли;
	Состояние.Вставить("ГраницаПотолка", Новый Структура("Момент, ОтКонца", Момент, ОтКонца));
	Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
		НСтр("ru = 'Банк %1: достигнут предел страниц чтения (%2 страниц, %3 операций, статус 200); чтение остановлено на границе %4 и неполное. Повтор не поможет: сузьте период и загрузите остальное отдельным чтением.';
			|uk = 'Банк %1: досягнуто межу сторінок читання (%2 сторінок, %3 операцій, статус 200); читання зупинено на межі %4 і неповне. Повтор не допоможе: звузьте період і завантажте решту окремим читанням.'"),
		Состояние.Банк, Формат(Состояние.Страниц, "ЧГ=0"), Формат(Операций, "ЧГ=0"), Формат(Момент, "ДФ='dd.MM.yyyy HH:mm:ss'")), Остановить);
	Возврат Истина;

КонецФункции

// Есть ли в ответе операция вне границ запроса: time больше верхней границы (to) или меньше начала (from). Записи без читаемого
// time не проверяются (их разбирает обработка записей). time = to не аномалия.
//
// Параметры:
//  Страница - Массив - записи ответа.
//  Начало - Число - from запроса, секунды Unix.
//  Верхняя - Число - to запроса, секунды Unix.
//
// Возвращаемое значение:
//  Булево - Истина, если есть операция вне границ.
Функция ОтветВнеГраниц(Страница, Начало, Верхняя) Экспорт

	Для Каждого Запись Из Страница Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Время = ЦелоеИзJSON(Запись["time"]);
		Если Время <> Неопределено И (Время > Верхняя Или Время < Начало) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Верхняя граница следующего запроса после полной страницы (D36 п. 11, спека 4988aba). ЕДИНСТВЕННОЕ место правил продолжения;
// дедупликация повторов по id - ДедупликацияПоИдентификатору. Обозначения: E - самая ранняя time страницы, U - текущая верхняя
// граница отрезка.
//  1. Граница продолжения = Мин(E + 1, U): секунда пограничной операции охватывается вторично (повторы снимает id); граница
//     никогда не растет. Не зависит от того, включительна ли to у банка (банк не возвращает операцию с time = to).
//  2. Застревание: граница продолжения = U (E >= U - 1) - запрос продолжения совпал бы с текущим. Класс «ДействиеЧеловека»
//     (повтор даст то же), чтение неполное, но дальше идет; диагностика называет секунды U - 1 и U и число операций страницы.
//  3. Шаг после застревания: Мин(E, U - 1), строго меньше U при любой семантике to.
//  4. Читаемого time в полной странице нет (курсора нет, хотя «есть еще») - «Повторить».
// Отрезок исчерпан (граница дошла до его начала) - Неопределено без отказа сверх уже записанного. Цикл конечен: граница строго убывает
// (защитная проверка ниже).
//
// Параметры:
//  Состояние - Структура - состояние чтения.
//  КоличествоВСтранице - Число - сколько записей пришло на странице.
//  Наименьшая - Число, Неопределено - E, секунды Unix; Неопределено - читаемого времени нет.
//  Начало - Число - начало отрезка, секунды Unix.
//  Верхняя - Число - U, секунды Unix.
//  Остановить - Булево - отказы «нет времени» и «граница не уменьшилась» останавливают чтение (см. Отказать); застревание не останавливает.
//
// Возвращаемое значение:
//  Число, Неопределено - верхняя граница следующего запроса или Неопределено, если в этом отрезке читать дальше нечего или нечем.
Функция ВерхняяГраницаПродолжения(Состояние, КоличествоВСтранице, Наименьшая, Начало, Верхняя, Остановить = Ложь) Экспорт

	Если Наименьшая = Неопределено Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: страница выписки полная, но в ней нет времени операций, чтобы продолжить чтение (статус 200); чтение неполное.';
				|uk = 'Банк %1: сторінка виписки повна, але в ній немає часу операцій, щоб продовжити читання (статус 200); читання неповне.'"),
			Состояние.Банк), Остановить);
		Возврат Неопределено;
	КонецЕсли;

	Следующая = Мин(Наименьшая + 1, Верхняя);
	Если Следующая >= Верхняя Тогда
		Отказать(Состояние, "ДействиеЧеловека", СтрШаблон(
			НСтр("ru = 'Банк %1: страница полная, продолжить чтение нечем (повтор даст то же): получено %4 операций, секунды %2 и %3: одна из них или обе могли быть прочитаны не полностью (семантика границы банка не выяснена). Загрузите этот день из файла выписки.';
				|uk = 'Банк %1: сторінка повна, продовжити читання нічим (повтор дасть те саме): отримано %4 операцій, секунди %2 і %3: одна з них або обидві могли бути прочитані не повністю (семантику межі банку не з''ясовано). Завантажте цей день із файлу виписки.'"),
			Состояние.Банк,
			Формат(МоментUnixВКиевскоеВремя(Верхняя - 1), "ДФ='dd.MM.yyyy HH:mm:ss'"),
			Формат(МоментUnixВКиевскоеВремя(Верхняя), "ДФ='dd.MM.yyyy HH:mm:ss'"),
			Формат(КоличествоВСтранице, "ЧГ=0")));
		Следующая = Мин(Наименьшая, Верхняя - 1);
	КонецЕсли;

	Если Следующая <= Начало Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Страховка: граница обязана строго убывать; по построению сюда это не приходит, но конектор не опирается на поведение банка.
	Если Следующая >= Верхняя Тогда
		Отказать(Состояние, "Повторить", СтрШаблон(
			НСтр("ru = 'Банк %1: граница продолжения не уменьшилась, продолжить чтение невозможно; чтение неполное.';
				|uk = 'Банк %1: межа продовження не зменшилась, продовжити читання неможливо; читання неповне.'"),
			Состояние.Банк), Остановить);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Следующая;

КонецФункции

// Правила дедупликации записей по идентификатору: что у банка отличается (D36 п. 5). Функций как значений в BSL нет, поэтому конектор
// кладет в правила не условия, а номера записей, к которым они применимы.
//
// Параметры:
//  Банк - Строка - название банка для текста рядка Ошибка.
//  ИмяПоляИдентификатора - Строка - поле записи, в котором лежит идентификатор ("ID", "id").
//
// Возвращаемое значение:
//  Структура - правила:
//   * Банк - Строка.
//   * ИмяПоляИдентификатора - Строка.
//   * Неостаточные - Соответствие - номер записи -> Истина: запись не остаточная (hold, PENDING, состояние p/n); в «виденных» не остается.
//   * Исключенные - Соответствие - номер записи -> Истина: пара с такой записью (сторно, состояние t) не конфликтный дубль.
Функция НовыеПравилаДедупликации(Банк, ИмяПоляИдентификатора) Экспорт

	Возврат Новый Структура("Банк, ИмяПоляИдентификатора, Неостаточные, Исключенные", Банк, ИмяПоляИдентификатора, Новый Соответствие, Новый Соответствие);

КонецФункции

// Дедупликация внутри одного чтения по идентификатору (границы страниц дают повторы). Фильтр состояния - СПЕРШУ: неостаточная
// запись в «виденных» не остается, поэтому проведенная с тем же идентификатором на другой странице не теряется. Тождественный повтор -
// один раз; тот же идентификатор с другим содержанием, не пара из Правила.Исключенные, - рядок Ошибка, повтор пропускается.
//
// Параметры:
//  Записи - Массив из Структура - записи (Номер, Данные).
//  Тексты - Соответствие - номер записи -> текст JSON записи.
//  Выписка - Структура - конверт платформы (рядки Ошибка).
//  Правила - Структура - см. НовыеПравилаДедупликации.
//
// Возвращаемое значение:
//  Соответствие - номера записей, которые дальше не обрабатываются.
Функция ДедупликацияПоИдентификатору(Записи, Тексты, Выписка, Правила) Экспорт

	Пропустить = Новый Соответствие;
	Виденные = Новый Соответствие;
	ВиденныеНеостаточные = Новый Соответствие;

	Для Каждого Запись Из Записи Цикл
		Если Не ЭтоСоответствие(Запись) Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = СтрокаИзJSON(Запись.Данные[Правила.ИмяПоляИдентификатора]);
		Если ПустаяСтрока(Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ?(Правила.Неостаточные[Запись.Номер] = Неопределено, Виденные, ВиденныеНеостаточные);
		Предыдущая = Таблица[Идентификатор];
		Если Предыдущая = Неопределено Тогда
			Таблица[Идентификатор] = Запись;
		ИначеЕсли Тексты[Предыдущая.Номер] = Тексты[Запись.Номер] Тогда
			Пропустить[Запись.Номер] = Истина;
		ИначеЕсли Таблица = Виденные И Правила.Исключенные[Запись.Номер] = Неопределено И Правила.Исключенные[Предыдущая.Номер] = Неопределено Тогда
			ДобавитьДиагностику(Выписка, "Ошибка", Запись.Номер, СтрШаблон(
				НСтр("ru = '%2: идентификатор %1 повторяется с другим содержанием (конфликтный дубль); повтор пропущен.';
					|uk = '%2: ідентифікатор %1 повторюється з іншим змістом (конфліктний дубль); повтор пропущено.'"),
				Идентификатор, Правила.Банк));
			Пропустить[Запись.Номер] = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Пропустить;

КонецФункции

// Запись выписки - объект JSON (Соответствие).
Функция ЭтоСоответствие(Запись) Экспорт

	Возврат ТипЗнч(Запись.Данные) = Тип("Соответствие");

КонецФункции

// Числовой код валюты тремя цифрами: нет поля - пусто (валюта счета); неизвестный код - Неопределено. Разбор кода - СМП_ЧтениеВыписокОбщее.
Функция КодВалюты(Значение) Экспорт

	Текст = СокрЛП(СтрокаИзJSON(Значение));
	Если Текст <> "" И СтрДлина(Текст) < 3 И ТолькоЦифры(Текст) Тогда
		Текст = Лев("000", 3 - СтрДлина(Текст)) + Текст;
	КонецЕсли;
	Возврат СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(Текст);

КонецФункции

Функция ТолькоЦифры(Текст) Экспорт

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Целое из значения JSON: число или строка-число; иначе Неопределено.
Функция ЦелоеИзJSON(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Цел(Число(СокрЛП(Значение)));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Строка из значения JSON: нет значения и null - пусто (не слово «Неопределено»); число - без разделителей групп.
Функция СтрокаИзJSON(Значение) Экспорт

	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		// Массив или объект JSON вместо скаляра - пусто, а не представление платформы.
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ТекстJSON(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Процедура ДобавитьДиагностику(Выписка, Уровень, Номер, Текст) Экспорт

	Строка = Выписка.Диагностика.Добавить();
	Строка.Уровень = Уровень;
	Строка.ПорядковыйНомер = Номер;
	Строка.Текст = Текст;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя киевского часового пояса, которое принимает платформа 8.3.27 (измерено задачей 0: "Europe/Kyiv"
// платформа отклоняет). Единственное место, где имя задано.
Функция ЧасовойПоясКиев()

	Возврат "Europe/Kiev";

КонецФункции

// Сколько символов описания банка попадает в текст отказа.
Функция МаксимальнаяДлинаОписанияБанка()

	Возврат 300;

КонецФункции

// Отказ запроса: запись в Состояние.Отказ и ответ ядра с Успех = Ложь.
Функция ОтказЗапроса(Состояние, Запрос, Класс, Текст, Статус)

	Отказать(Состояние, Класс, Текст, Запрос.Остановить);
	Тексты = Состояние.Отказ.Тексты;
	Возврат Новый Структура("Успех, Статус, Значение, КлассОтказа, Текст", Ложь, Статус, Неопределено, Класс, Тексты[Тексты.ВГраница()]);

КонецФункции

// Предел паузы по заголовку банка (D36 п. 8, спека a90f7ea), секунды. Не меньше документированного интервала между запросами
// выписки (60 с у ФОП), иначе обычное ограничение частоты стало бы отказом; вдвое больше - запас на разброс. Банк просит больше -
// конектор не ждет: «Повторить», а диагностика называет запрошенную паузу (иначе один заголовок остановил бы регламент на часы).
Функция ПотолокПаузы()

	Возврат 120;

КонецФункции

// Пауза по заголовкам ответа: x-rate-limit-retry-after-seconds, затем retry-after (целое число секунд); иначе 60 секунд. Заголовок,
// который не разобран (в том числе retry-after в виде HTTP-даты), означает паузу конектора по умолчанию - 60 с, а не ошибку.
Функция СекундыПаузы(Ответ)

	Для Каждого Имя Из СтрРазделить("x-rate-limit-retry-after-seconds,retry-after", ",") Цикл
		Значение = Ответ.Заголовки[Имя];
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Секунд = ЦелоеИзJSON(СокрЛП(Значение));
		Если Секунд <> Неопределено И Секунд > 0 Тогда
			Возврат Секунд;
		КонецЕсли;
	КонецЦикла;
	Возврат 60;

КонецФункции

// Описание ошибки банка из тела: первое найденное из полей (ПоляОписания, через запятую); пусто, если тела нет или оно не объект.
Функция ОписаниеОшибкиБанка(Тело, ПоляОписания)

	Если Не Тело.Успех Или ТипЗнч(Тело.Значение) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ПоляОписания, ",") Цикл
		Значение = Тело.Значение[Имя];
		Если Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
			Возврат СтрокаИзJSON(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Формы секретов для вырезания: каждое строковое значение - как есть, после СокрЛП и в URL-кодировании обеих; от длинной к короткой.
Функция ФормыСекретов(Секреты)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Длина");
	Показаны = Новый Соответствие;
	Для Каждого Элемент Из Секреты Цикл
		Если ТипЗнч(Элемент.Значение) <> Тип("Строка") Или ПустаяСтрока(Элемент.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Формы = Новый Массив;
		Формы.Добавить(Элемент.Значение);
		Формы.Добавить(СокрЛП(Элемент.Значение));
		Формы.Добавить(КодироватьСтроку(Элемент.Значение, СпособКодированияСтроки.КодировкаURL));
		Формы.Добавить(КодироватьСтроку(СокрЛП(Элемент.Значение), СпособКодированияСтроки.КодировкаURL));
		Для Каждого Форма Из Формы Цикл
			Если Форма = "" Или Показаны[Форма] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Показаны[Форма] = Истина;
			Строка = Таблица.Добавить();
			Строка.Значение = Форма;
			Строка.Длина = СтрДлина(Форма);
		КонецЦикла;
	КонецЦикла;
	Таблица.Сортировать("Длина Убыв");
	Возврат Таблица.ВыгрузитьКолонку("Значение");

КонецФункции

// Вырезает формы секретов из текста без учета регистра.
Функция УбратьФормы(Текст, Формы)

	Результат = Текст;
	Для Каждого Форма Из Формы Цикл
		Результат = ЗаменитьБезУчетаРегистра(Результат, Форма);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заменяет каждое вхождение образца на "***" без учета регистра; остальной текст не меняется.
Функция ЗаменитьБезУчетаРегистра(Текст, Образец)

	Нижний = НРег(Текст);
	НижнийОбразец = НРег(Образец);
	Длина = СтрДлина(Образец);
	Результат = "";
	Начало = 1;
	Пока Начало <= СтрДлина(Текст) Цикл
		Позиция = СтрНайти(Нижний, НижнийОбразец, НаправлениеПоиска.СНачала, Начало);
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Сред(Текст, Начало, Позиция - Начало) + "***";
		Начало = Позиция + Длина;
	КонецЦикла;
	Возврат Результат + Сред(Текст, Начало);

КонецФункции

// Вырезает формы секретов из колонки таблицы. Таблицу, которая не таблица или без колонки (конверт испорчен читателем), не трогает.
Процедура УбратьИзКолонки(Таблица, ИмяКолонки, Формы)

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Или Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из Таблица Цикл
		Значение = Строка[ИмяКолонки];
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Строка[ИмяКолонки] = УбратьФормы(Значение, Формы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
