// Спільні функції конекторів API (план 05а, задача 3; спека D36 п. 1, 7, 8).
//
// Модуль - ворота переносимости (D27, D29, docs/architecture/testing.md, раздел 5): работает только
// с типами платформы, не читает метаданные, сеанс и серверные часы. Пояс времени всегда
// явный. Сюда вынесено только то, что у конекторов банков общее на самом деле: перевод момента Unix
// в киевское время, чтение JSON из тела в явной кодировке, класс отказа по статусу HTTP, текст отказа
// банка для человека без учетных данных и форма ответа транспорта.
//
// Модуль не знает транспорта (он приходит конектору значением в Параметры.Транспорт) и банков.

#Область ПрограммныйИнтерфейс

// Имя киевского часового пояса, которое принимает платформа 8.3.27 (измерено задачей 0: "Europe/Kyiv"
// платформа отклоняет). Единственное место, где имя задано.
//
// Возвращаемое значение:
//  Строка - "Europe/Kiev".
Функция ЧасовойПоясКиев() Экспорт

	Возврат "Europe/Kiev";

КонецФункции

// Момент Unix (секунды с 1970-01-01 00:00:00 UTC) в киевское местное время. Пояс явный: пояс сеанса
// результат не меняет. Местное время вокруг осеннего перехода неоднозначно (час повторяется), это
// свойство местного времени, а не функции.
//
// Параметры:
//  Секунды - Число - момент Unix в секундах.
//
// Возвращаемое значение:
//  Дата - киевское местное время.
Функция МоментUnixВКиевскоеВремя(Секунды) Экспорт

	МоментUTC = Дата(1970, 1, 1) + Цел(Секунды);
	Возврат МестноеВремя(МоментUTC, ЧасовойПоясКиев());

КонецФункции

// Киевское местное время в момент Unix (секунды). Неоднозначный час осеннего перехода платформа берет
// как второе (зимнее) вхождение, несуществующий час весны - как зимнее смещение (измерено задачей 0).
//
// Параметры:
//  МестноеВремя - Дата - киевское местное время.
//
// Возвращаемое значение:
//  Число - секунды с 1970-01-01 00:00:00 UTC.
Функция КиевскоеВремяВМоментUnix(МестноеВремя) Экспорт

	Возврат УниверсальноеВремя(МестноеВремя, ЧасовойПоясКиев()) - Дата(1970, 1, 1);

КонецФункции

// Пустой ответ транспорта: одна форма у справочного транспорта продукта и у транспорта воспроизведения.
//
// Возвращаемое значение:
//  Структура - ответ:
//   * Сбой - Булево - Истина, если ответа банка нет (сеть, таймаут и подобное); тогда Статус = 0.
//   * ВидСбоя - Строка - "timeout", "network" или "other"; пустая при отсутствии сбоя.
//   * ТекстСбоя - Строка - текст для человека; не содержит заголовков запроса (в них учетные данные).
//   * Статус - Число - HTTP-статус; 0 при сбое.
//   * Заголовки - Соответствие - заголовки ответа, имена в нижнем регистре.
//   * Тело - ДвоичныеДанные - тело ответа байтами, как пришло.
Функция НовыйОтветТранспорта() Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("Сбой", Ложь);
	Ответ.Вставить("ВидСбоя", "");
	Ответ.Вставить("ТекстСбоя", "");
	Ответ.Вставить("Статус", 0);
	Ответ.Вставить("Заголовки", Новый Соответствие);
	Ответ.Вставить("Тело", Base64Значение(""));
	Возврат Ответ;

КонецФункции

// Читает JSON из тела ответа в явной кодировке, без исключения наружу. Тело, не являющееся JSON (страница
// ошибки прокси, обрезанный ответ, пустое тело), - не исключение, а Успех = Ложь с причиной: решение о
// классе отказа за конектором (D36 п. 8: тело не того формата - "повторить").
//
// Параметры:
//  Тело - ДвоичныеДанные - тело ответа.
//  Кодировка - Строка - кодировка тела, например "utf-8" или "windows-1251"; явная, по умолчанию не угадывается.
//
// Возвращаемое значение:
//  Структура - результат:
//   * Успех - Булево - Истина, если тело прочитано как JSON.
//   * Значение - Соответствие, Массив, Произвольный, Неопределено - прочитанное; объекты JSON - Соответствие.
//   * Текст - Строка - причина при неудаче; пустая при успехе. Не содержит тела.
Функция ПрочитатьJSONИзТела(Тело, Кодировка) Экспорт

	Результат = Новый Структура("Успех, Значение, Текст", Ложь, Неопределено, "");

	Если ТипЗнч(Тело) <> Тип("ДвоичныеДанные") Или Тело.Размер() = 0 Тогда
		Результат.Текст = НСтр("ru = 'Тело ответа пустое.'; uk = 'Тіло відповіді порожнє.'");
		Возврат Результат;
	КонецЕсли;

	Чтение = Неопределено;
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Тело, Кодировка);
		Если Лев(Текст, 1) = Символ(65279) Тогда
			Текст = Сред(Текст, 2);
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Результат.Значение = Значение;
		Результат.Успех = Истина;
	Исключение
		Результат.Значение = Неопределено;
		Результат.Успех = Ложь;
		Результат.Текст = СтрШаблон(
			НСтр("ru = 'Тело ответа не прочитано как JSON: %1';
				|uk = 'Тіло відповіді не прочитано як JSON: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если Чтение <> Неопределено Тогда
			Попытка
				Чтение.Закрыть();
			Исключение
				// Закрытие чтения не должно менять результат.
			КонецПопытки;
		КонецЕсли;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Кодировка тела из заголовка content-type ответа ("...; charset=windows-1251"), в нижнем регистре.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки ответа, имена в нижнем регистре.
//  ПоУмолчанию - Строка - что вернуть, если в заголовках кодировки нет.
//
// Возвращаемое значение:
//  Строка - имя кодировки.
Функция КодировкаИзЗаголовков(Заголовки, ПоУмолчанию) Экспорт

	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	ТипСодержимого = Заголовки["content-type"];
	Если ТипЗнч(ТипСодержимого) <> Тип("Строка") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Нижний = НРег(ТипСодержимого);
	Позиция = СтрНайти(Нижний, "charset=");
	Если Позиция = 0 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Остаток = Сред(Нижний, Позиция + СтрДлина("charset="));
	Конец = СтрНайти(Остаток, ";");
	Если Конец > 0 Тогда
		Остаток = Лев(Остаток, Конец - 1);
	КонецЕсли;
	Результат = СокрЛП(СтрЗаменить(СтрЗаменить(Остаток, """", ""), "'", ""));
	Возврат ?(ПустаяСтрока(Результат), ПоУмолчанию, Результат);

КонецФункции

// Класс отказа по статусу HTTP: отвечает на вопрос «поможет ли повтор» (D36 п. 8).
// - 2xx - отказа нет;
// - 408, 429 (после допустимого повтора конектора), 5xx - "Повторить";
// - остальные: 401 и 403 (аутентификация), другие 4xx, а также 3xx и 1xx - "ДействиеЧеловека";
// - статус 0 (ответа не было, сбой транспорта) - "Повторить".
//
// Параметры:
//  Статус - Число - HTTP-статус ответа.
//
// Возвращаемое значение:
//  Строка - значение КлассОтказа контракта (см. СМП_ВыпискаБанка.КлассОтказа*).
Функция КлассОтказаПоСтатусуHTTP(Статус) Экспорт

	Если Статус >= 200 И Статус < 300 Тогда
		Возврат СМП_ВыпискаБанка.КлассОтказаНет();
	КонецЕсли;
	Если Статус = 0 Или Статус = 408 Или Статус = 429 Или (Статус >= 500 И Статус < 600) Тогда
		Возврат СМП_ВыпискаБанка.КлассОтказаПовторить();
	КонецЕсли;
	Возврат СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека();

КонецФункции

// Текст отказа банка для человека: называет банк, статус и описание банка; учетных данных не содержит.
// Описание банка укорачивается (страница ошибки прокси не должна попасть в журнал целиком).
//
// Параметры:
//  Банк - Строка - название банка для человека.
//  Статус - Число - HTTP-статус отказа.
//  ОписаниеБанка - Строка, Неопределено - текст ошибки, который вернул банк; может быть пустым.
//  УчетныеДанные - Структура, Неопределено - учетные данные: их значения вырезаются из текста.
//
// Возвращаемое значение:
//  Строка - текст отказа.
Функция ТекстОтказаБанка(Банк, Статус, ОписаниеБанка, УчетныеДанные) Экспорт

	Описание = ?(ТипЗнч(ОписаниеБанка) = Тип("Строка"), СокрЛП(ОписаниеБанка), "");
	Описание = СокрЛП(СтрЗаменить(СтрЗаменить(Описание, Символы.ПС, " "), Символы.ВК, " "));
	// Сначала вырезаем учетные данные, потом обрезаем: иначе значение, пересекшее границу обрезания,
	// оставило бы видимый префикс.
	Описание = УбратьУчетныеДанные(Описание, УчетныеДанные);
	Если СтрДлина(Описание) > МаксимальнаяДлинаОписанияБанка() Тогда
		Описание = Лев(Описание, МаксимальнаяДлинаОписанияБанка()) + "...";
	КонецЕсли;

	ТекстСтатуса = ?(ТипЗнч(Статус) = Тип("Число"), Формат(Статус, "ЧН=0; ЧГ="), "");

	Если ПустаяСтрока(Описание) Тогда
		Текст = СтрШаблон(
			НСтр("ru = 'Банк %1 отказал в запросе, статус %2.'; uk = 'Банк %1 відмовив у запиті, статус %2.'"),
			Банк, ТекстСтатуса);
	Иначе
		Текст = СтрШаблон(
			НСтр("ru = 'Банк %1 отказал в запросе, статус %2: %3';
				|uk = 'Банк %1 відмовив у запиті, статус %2: %3'"),
			Банк, ТекстСтатуса, Описание);
	КонецЕсли;

	Возврат УбратьУчетныеДанные(Текст, УчетныеДанные);

КонецФункции

// Вырезает из текста значения учетных данных (заменяет на "***"): токен не должен попасть ни в
// диагностику, ни в текст исключения, ни в журнал (D36 п. 3). Значения вырезаются от длинного к
// короткому: короткое значение, входящее в длинное, не должно оставить хвост длинного.
//
// Параметры:
//  Текст - Строка - текст.
//  УчетныеДанные - Структура, Неопределено - учетные данные с рядковыми полями.
//
// Возвращаемое значение:
//  Строка - текст без значений учетных данных.
Функция УбратьУчетныеДанные(Текст, УчетныеДанные) Экспорт

	Если ТипЗнч(УчетныеДанные) <> Тип("Структура") Или ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Текст;
	КонецЕсли;

	Значения = Новый ТаблицаЗначений;
	Значения.Колонки.Добавить("Значение");
	Значения.Колонки.Добавить("Длина");
	Для Каждого Элемент Из УчетныеДанные Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") И Не ПустаяСтрока(Элемент.Значение) Тогда
			Строка = Значения.Добавить();
			Строка.Значение = СокрЛП(Элемент.Значение);
			Строка.Длина = СтрДлина(Строка.Значение);
		КонецЕсли;
	КонецЦикла;
	Значения.Сортировать("Длина Убыв");

	Результат = Текст;
	Для Каждого Строка Из Значения Цикл
		Результат = СтрЗаменить(Результат, Строка.Значение, "***");
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сколько символов описания банка попадает в текст отказа.
Функция МаксимальнаяДлинаОписанияБанка()

	Возврат 300;

КонецФункции

#КонецОбласти
