////////////////////////////////////////////////////////////////////////////////
// СМП_РаботаСБанкамиМонобанкЮрAPIСервер: подключение, получение и разбор выписки через API счетов юридических лиц monobank
// Описание API: https://corp-api.monobank.ua/
// Это отдельное API, не совместимое с персональным (ФОП): другой хост, IBAN вместо id счета,
// статусы вместо hold, строковый код валюты, UUID транзакции, нет вебхука.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Загрузка выписки из формы обработки СМП_КлиентБанк. Сигнатура — как у СМП_РаботаСБанкамиМонобанкAPIСервер.
//
// Параметры:
//   ФормаЗагрузкиКлиентБанка - ФормаКлиентскогоПриложения - обработка КлиентБанк: ФормаЗагрузка.
//   УчетнаяЗаписьБанка - СправочникСсылка.СМП_УчетныеЗаписиБанков
//   ТокенАвторизации - Строка - x-token API юрлиц.
//   ТаблицаТаблицДокументов - ТаблицаЗначений
//   ТаблицаКонтрагентов - ДеревоЗначений
//
Процедура ЗагрузитьДанныеПоВыписке(ФормаЗагрузкиКлиентБанка, УчетнаяЗаписьБанка, ТокенАвторизации, ТаблицаТаблицДокументов, ТаблицаКонтрагентов) Экспорт
	
	ФормаЗагрузкиКлиентБанка.ТаблицаКонтрагентов.ПолучитьЭлементы().Очистить();
	ДокументыКИмпорту = ФормаЗагрузкиКлиентБанка.Объект.Загрузка.Выгрузить();
	ДокументыКИмпорту.Колонки.Добавить("КодНазПлатежа", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(1)));
	
	ИмпортНеПустые = Неопределено;
	ИмпортНеПустыеПлатежноеПоручение = Неопределено;
	ИмпортНеПустыеПлатежноеПоручениеБюджет = Неопределено;
	РасчетныеСчетаКИмпорту = ФормаЗагрузкиКлиентБанка.Объект.ИмпортРасчетныеСчета.Выгрузить();
	Обработки.СМП_КлиентБанк.СформироватьСоответствияНеПустыхПриИмпорте(ИмпортНеПустые, ИмпортНеПустыеПлатежноеПоручение, ИмпортНеПустыеПлатежноеПоручениеБюджет);
	
	СтруктураЗаголовок = Новый Структура(ВРег("ВерсияФормата,Кодировка,Отправитель,Получатель,ДатаСоздания,ВремяСоздания,ДатаНачала,ДатаКонца"));
	ФормаЗагрузкиКлиентБанка.ИмпортЗаголовок = СтруктураЗаголовок;
	РасчетныеСчетаКИмпорту.Очистить();
	ДокументыКИмпорту.Очистить();
	
	КонтекстФормы = Новый Структура;
	КонтекстФормы.Вставить("ИмпортТекстДляРазбора", "");
	КонтекстФормы.Вставить("ПослеЗагрузкиВыписокВ1С", ФормаЗагрузкиКлиентБанка.ПослеЗагрузкиВыписокВ1С);
	КонтекстФормы.Вставить("ИскатьВСправочникеСоответствий", ФормаЗагрузкиКлиентБанка.ИскатьВСправочникеСоответствий);
	КонтекстФормы.Вставить("ТаблицаКонтрагентов", ТаблицаКонтрагентов);
	КонтекстФормы.Вставить("РасчетныеСчетаКИмпорту", РасчетныеСчетаКИмпорту);
	КонтекстФормы.Вставить("ДокументыКИмпорту", ДокументыКИмпорту);
	КонтекстФормы.Вставить("ТаблицаТаблицДокументов", ТаблицаТаблицДокументов);
	
	Если ФормаЗагрузкиКлиентБанка.ПослеЗагрузкиВыписокВ1С Тогда
		КонтекстФормы.Вставить("СтруктураДанныхЗагрузки", ФормаЗагрузкиКлиентБанка.СтруктураДанныхЗагрузки);
	КонецЕсли;
	
	ВременнаяСтрока = ФормаЗагрузкиКлиентБанка.ТаблицаТаблицДокументов.Добавить();
	КонтекстФормы.Вставить("ТаблицаНайденныхДокументов", ВременнаяСтрока.ТаблицаНайденныхДокументов.Выгрузить());
	ФормаЗагрузкиКлиентБанка.ТаблицаТаблицДокументов.Удалить(0);
	КонтекстФормы.Вставить("ЕстьОтборПоБанковскомуСчету", ФормаЗагрузкиКлиентБанка.ЕстьОтборПоБанковскомуСчету);
	КонтекстФормы.Вставить("ВыдаватьСообщенияОНеверныхРеквизитахИСекциях", ФормаЗагрузкиКлиентБанка.ВыдаватьСообщенияОНеверныхРеквизитахИСекциях);
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Организация", ФормаЗагрузкиКлиентБанка.Объект.Организация);
	СтруктураОбъекта.Вставить("БанковскийСчет", ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет);
	СтруктураОбъекта.Вставить("АвтоматическиПодставлятьДокументы", ФормаЗагрузкиКлиентБанка.Объект.АвтоматическиПодставлятьДокументы);
	СтруктураОбъекта.Вставить("АнализироватьИсториюВыбораЗначенийРеквизитов", ФормаЗагрузкиКлиентБанка.Объект.АнализироватьИсториюВыбораЗначенийРеквизитов);
	СтруктураОбъекта.Вставить("СтатьяДДСИсходящий", ФормаЗагрузкиКлиентБанка.Объект.СтатьяДДСИсходящий);
	СтруктураОбъекта.Вставить("СтатьяДДСВходящий", ФормаЗагрузкиКлиентБанка.Объект.СтатьяДДСВходящий);
	СтруктураОбъекта.Вставить("СпособЗачета", ФормаЗагрузкиКлиентБанка.Объект.СпособЗачета);
	КонтекстФормы.Вставить("Объект", СтруктураОбъекта);
	
	НомерСчетаIBAN = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет, "НомерСчета", Истина);
	Сессия = НоваяСессия(ТокенАвторизации);
	НачалоПериода = ФормаЗагрузкиКлиентБанка.Объект.НачПериода;
	КонецПериода = КонецДня(ФормаЗагрузкиКлиентБанка.Объект.КонПериода);
	
	РезультатЧтения = ПрочитатьТранзакции(Сессия, НомерСчетаIBAN, НачалоПериода, КонецПериода);
	ЗаполнитьТаблицуДаннымиТранзакций(РезультатЧтения.Транзакции, ДокументыКИмпорту, НомерСчетаIBAN);
	
	// §7: удалять документы, которых нет в выписке, можно только при полной выписке за закрытые в банке дни.
	Если Не СинхронизацияРазрешена(Сессия, НомерСчетаIBAN, РезультатЧтения) Тогда
		ФормаЗагрузкиКлиентБанка.Объект.НеУдалятьДокументыКоторыхНетВВыписке = Истина;
	КонецЕсли;
	
	// Ошибки собираем после СинхронизацияРазрешена — она дописывает в РезультатЧтения.Ошибки ошибки balances.
	Для Каждого ТекстОшибки Из РезультатЧтения.Ошибки Цикл
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЦикла;
	
	КоличествоНеНайденныхКонтрагентов = 0;
	КоличествоНеНайденныхРСчетов = 0;
	
	ПараметрыВыделенияКолонок = Новый Структура("ВыделитьКолонкуДокумент, ВыделитьКолонкуСуммаСписано, ВыделитьКолонкуСуммаПоступило,
	|ВыделитьКолонкуКонтрагент, ВыделитьКолонкуДоговор, ВыделитьКолонкуРСКонтрагента, ВыделитьКолонкуВидОперации",
	Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	
	НомерСтроки = 0;
	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл
		Если (СтрокаДокумента.ПлательщикСчет = ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет.НомерСчета
			Или СтрокаДокумента.ПолучательСчет = ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет.НомерСчета)
			И ЗначениеЗаполнено(ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет.ВалютаДенежныхСредств) Тогда
			
			ФормаЗагрузкиКлиентБанка.БанковскийСчетНомер = ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет.НомерСчета;
			ФормаЗагрузкиКлиентБанка.БанковскийСчетВалюта = ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет.ВалютаДенежныхСредств;
			
			Обработки.СМП_КлиентБанк.РаспознатьДанныеВСтрокеДокумента(СтрокаДокумента, Неопределено, ПараметрыВыделенияКолонок,
			ФормаЗагрузкиКлиентБанка.Объект, ТаблицаТаблицДокументов, КонтекстФормы, ФормаЗагрузкиКлиентБанка.ПослеЗагрузкиВыписокВ1С);
			НомерСтроки = НомерСтроки + 1;
			СтрокаДокумента.НомерСтроки = НомерСтроки;
			
			Для Каждого КолонкаИмпорта Из ДокументыКИмпорту.Колонки Цикл
				Обработки.СМП_КлиентБанк.ПроверитьНаПустоеЗначениеИмпорта(СтрокаДокумента, КолонкаИмпорта.Имя, КолонкаИмпорта.Заголовок, ИмпортНеПустые);
			КонецЦикла;
			
			Если ТипЗнч(СтрокаДокумента.Контрагент) = Тип("Строка")
				Или ТипЗнч(СтрокаДокумента.СчетКонтрагента) = Тип("Строка")
				Или ТипЗнч(СтрокаДокумента.Договор) = Тип("Строка") Тогда
				Обработки.СМП_КлиентБанк.СписокНенайденных(СтрокаДокумента, ФормаЗагрузкиКлиентБанка.Объект.БанковскийСчет,
				ТаблицаКонтрагентов, КоличествоНеНайденныхКонтрагентов, КоличествоНеНайденныхРСчетов);
			КонецЕсли;
		Иначе
			СтрокаДокумента.НомерСтроки = 0;
		КонецЕсли;
	КонецЦикла;
	
	Индекс = ДокументыКИмпорту.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ДокументыКИмпорту[Индекс].НомерСтроки = 0 Тогда
			ДокументыКИмпорту.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл
		СтрокаДокумента.Загружать = ПустаяСтрока(СтрокаДокумента.ОписаниеОшибок);
		СтрокаДокумента.НазначениеПлатежа = СокрЛП(СтрокаДокумента.НазначениеПлатежа);
		СтрокаДокумента.НомерКартинки = ?(ПустаяСтрока(СтрокаДокумента.ОписаниеОшибок), 0, 1);
	КонецЦикла;
	
	ФормаЗагрузкиКлиентБанка.Объект.Загрузка.Очистить();
	ФормаЗагрузкиКлиентБанка.Объект.Загрузка.Загрузить(ДокументыКИмпорту);
	ФормаЗагрузкиКлиентБанка.Объект.ИмпортРасчетныеСчета.Очистить();
	ФормаЗагрузкиКлиентБанка.Объект.ИмпортРасчетныеСчета.Загрузить(РасчетныеСчетаКИмпорту);
	
КонецПроцедуры

// Регламентный обмен: период от курсора (§8), синхронизация-удаление только по §7, курсор — только при полном чтении.
// Курсор возвращается вызывающему и записывается им после успешной загрузки — иначе при ошибке
// загрузки транзакции были бы потеряны.
//
// Параметры:
//   Объект - ОбработкаОбъект.СМП_КлиентБанк
//   Настройки - СправочникСсылка.СМП_УчетныеЗаписиБанков
//
// Возвращаемое значение:
//   Структура, Неопределено - курсор для СМП_РаботаСБанкамиМонобанкЮрAPIСервер.ЗаписатьКурсорРегламента;
//     Неопределено, если курсор не изменился.
//
Функция ВыполнитьРегламент(Объект, Настройки) Экспорт
	
	ДокументыКИмпорту = Объект.Загрузка.Выгрузить();
	РасчетныеСчетаКИмпорту = Объект.ИмпортРасчетныеСчета.Выгрузить();
	ДокументыКИмпорту.Очистить();
	РасчетныеСчетаКИмпорту.Очистить();
	
	НомерСчетаIBAN = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.БанковскийСчет, "НомерСчета", Истина);
	Сессия = НоваяСессия(Настройки.Токен);
	
	Курсор = ПолучитьЗначениеСведения(Объект.БанковскийСчет);
	
	Если Курсор <> Неопределено И ЗначениеЗаполнено(Курсор.ДатаТранзакции) Тогда
		НачалоПериода = НачалоДня(Курсор.ДатаТранзакции);
	Иначе
		НачалоПериода = Объект.НачПериода;
	КонецЕсли;
	
	КонецПериода = ТекущаяДатаСеанса();
	
	РезультатЧтения = ПрочитатьТранзакции(Сессия, НомерСчетаIBAN, НачалоПериода, КонецПериода);
	ЗаполнитьТаблицуДаннымиТранзакций(РезультатЧтения.Транзакции, ДокументыКИмпорту, НомерСчетаIBAN);
	РаспознатьДокументыДляРегламента(Объект, ДокументыКИмпорту);
	
	Если Не СинхронизацияРазрешена(Сессия, НомерСчетаIBAN, РезультатЧтения) Тогда
		Объект.НеУдалятьДокументыКоторыхНетВВыписке = Истина;
	КонецЕсли;
	
	// Ошибки собираем после СинхронизацияРазрешена — она дописывает в РезультатЧтения.Ошибки ошибки balances.
	Для Каждого ТекстОшибки Из РезультатЧтения.Ошибки Цикл
		ЗаписьЖурналаРегистрации("monobank (юрособи)", УровеньЖурналаРегистрации.Ошибка, , Настройки, ТекстОшибки);
	КонецЦикла;
	
	ДатаНовогоКурсора = ДатаКурсора(РезультатЧтения, КонецПериода);
	
	Объект.Загрузка.Очистить();
	Объект.Загрузка.Загрузить(ДокументыКИмпорту);
	Объект.ИмпортРасчетныеСчета.Очистить();
	Объект.ИмпортРасчетныеСчета.Загрузить(РасчетныеСчетаКИмпорту);
	
	Если Не ЗначениеЗаполнено(ДатаНовогоКурсора) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("ИДТранзакции, ДатаТранзакции", РезультатЧтения.ИДПоследнейЗагруженной, ДатаНовогоКурсора);
	
КонецФункции

// Записывает курсор регламентного обмена monobank после того, как вызывающий успешно передал
// документы в Обработка.Загрузить — иначе при исключении курсор сдвинулся бы раньше загрузки.
//
// Параметры:
//   БанковскийСчет - СправочникСсылка.СМП_УчетныеЗаписиБанков
//   Курсор - Структура - см. ВыполнитьРегламент.
//
Процедура ЗаписатьКурсорРегламента(БанковскийСчет, Курсор) Экспорт
	
	ЗаписатьЗначениеСведения(БанковскийСчет, Курсор.ИДТранзакции, Курсор.ДатаТранзакции);
	
КонецПроцедуры

// Ожидание без загрузки процессора — по образцу ОбщегоНазначенияБТС.Пауза (см. модуль ФОП).
//
Процедура Пауза(Секунд) Экспорт
	
	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("СМП_РаботаСБанкамиМонобанкЮрAPIСервер.Пауза", Параметры, , "monobank (юрособи): пауза між запитами");
	КонецЕсли;
	
	ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяСессия(ТокенАвторизации)
	
	Сессия = КоннекторHTTP_BankExchange.СоздатьСессию();
	Сессия.Заголовки.Вставить("x-token", ТокенАвторизации);
	Сессия.Заголовки.Вставить("accept", "application/json"); // без него API отвечает ошибкой
	Возврат Сессия;
	
КонецФункции

// Читает транзакции API юрлиц за период: страницы по 500 (limit передается всегда — по умолчанию банк отдает 10),
// сдвиг верхней границы при полной странице, учет лимитов по заголовкам ответа.
// Загружаются только status = DONE; PENDING запоминается как пропущенная (для курсора), DECLINED и reverse пропускаются.
//
// Параметры:
//   Сессия - Структура - см. НоваяСессия.
//   НомерСчетаIBAN - Строка
//   НачалоПериода, КонецПериода - Дата - местное время.
//
// Возвращаемое значение:
//   Структура - как у СМП_РаботаСБанкамиМонобанкAPIСервер.ПрочитатьТранзакции:
//     Транзакции, Полная, ИДПоследнейЗагруженной, ВремяПоследнейЗагруженной, ВремяПервойПропущенной, Ошибки,
//     плюс ДатыЗагруженных - Массив из Дата - начала суток (местное время) загруженных транзакций.
//
Функция ПрочитатьТранзакции(Сессия, НомерСчетаIBAN, НачалоПериода, КонецПериода)
	
	Результат = Новый Структура;
	Результат.Вставить("Транзакции", Новый Массив);
	Результат.Вставить("Полная", Истина);
	Результат.Вставить("ИДПоследнейЗагруженной", "");
	Результат.Вставить("ВремяПоследнейЗагруженной", Дата(1, 1, 1));
	Результат.Вставить("ВремяПервойПропущенной", Дата(1, 1, 1));
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("ДатыЗагруженных", Новый Массив);
	
	ДобавленныеИдентификаторы = Новый Соответствие;
	ДобавленныеДаты = Новый Соответствие;
	ВерхняяГраница = КонецПериода;
	
	Пока Истина Цикл
		
		// Допущение A плана (не подтверждено специей corp-api.monobank.ua — сайт недоступен агенту, 403):
		// from/to передаются как unix-секунды UTC, как в персональном API. Сверить чек-листом задачи 8.
		URL = СтрШаблон("https://corp-api.monobank.ua/ext/v1/statement/%1/%2/%3?limit=%4",
		НомерСчетаIBAN, ДатаВремяВUnixTime(НачалоПериода), ДатаВремяВUnixTime(ВерхняяГраница), РазмерСтраницы());
		Ответ = ВыполнитьЗапросСУчетомЛимита(Сессия, URL);
		
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Полная = Ложь;
			Результат.Ошибки.Добавить(ОписаниеОшибкиОтвета(Ответ, СтрокаПериода(НачалоПериода, ВерхняяГраница)));
			Возврат Результат;
		КонецЕсли;
		
		Страница = КоннекторHTTP_BankExchange.КакJson(Ответ);
		Если ТипЗнч(Страница) <> Тип("Массив") Тогда
			Результат.Полная = Ложь;
			Результат.Ошибки.Добавить(НСтр("ru = 'monobank (юрлица): изменился формат получаемых данных. Обратитесь к разработчику.'; uk = 'monobank (юрособи): змінився формат отримуваних даних. Зверніться до розробника.'"));
			Возврат Результат;
		КонецЕсли;
		
		ВремяСамойРанней = Неопределено;
		Для Каждого Транзакция Из Страница Цикл
			
			// Допущение B плана: time и completedTime — unix-секунды (см. ДатаИзUnixTime ниже). Не подтверждено.
			ВремяСоздания = ДатаИзUnixTime(Транзакция["time"]);
			Если ВремяСамойРанней = Неопределено Или ВремяСоздания < ВремяСамойРанней Тогда
				ВремяСамойРанней = ВремяСоздания;
			КонецЕсли;
			
			Статус = Строка(Транзакция["status"]);
			Если Статус = "PENDING" Тогда
				Если Не ЗначениеЗаполнено(Результат.ВремяПервойПропущенной)
					Или ВремяСоздания < Результат.ВремяПервойПропущенной Тогда
					Результат.ВремяПервойПропущенной = ВремяСоздания;
				КонецЕсли;
				Продолжить;
			ИначеЕсли Статус <> "DONE" Или Транзакция["reverse"] = Истина Тогда
				// DECLINED и сторно в учет не идут (§6 спеки).
				Продолжить;
			КонецЕсли;
			
			Если ДобавленныеИдентификаторы[Транзакция["id"]] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДобавленныеИдентификаторы.Вставить(Транзакция["id"], Истина);
			
			Результат.Транзакции.Добавить(Транзакция);
			
			ВремяПроведения = ДатаИзUnixTime(?(Транзакция["completedTime"] = Неопределено, Транзакция["time"], Транзакция["completedTime"]));
			Если ВремяПроведения > Результат.ВремяПоследнейЗагруженной Тогда
				Результат.ВремяПоследнейЗагруженной = ВремяПроведения;
				Результат.ИДПоследнейЗагруженной = Транзакция["id"];
			КонецЕсли;
			
			Если ДобавленныеДаты[НачалоДня(ВремяПроведения)] = Неопределено Тогда
				ДобавленныеДаты.Вставить(НачалоДня(ВремяПроведения), Истина);
				Результат.ДатыЗагруженных.Добавить(НачалоДня(ВремяПроведения));
			КонецЕсли;
			
		КонецЦикла;
		
		Если Страница.Количество() < РазмерСтраницы() Тогда
			Прервать;
		КонецЕсли;
		
		// Допущение D плана, не подтверждено: страница отсортирована от новых к старым; при полной
		// странице, дошедшей до начала периода, считаем чтение неполным — курсор не двигаем,
		// синхронизацию не включаем.
		Если ВремяСамойРанней = Неопределено Или ВремяСамойРанней <= НачалоПериода Тогда
			Результат.Полная = Ложь;
			Прервать;
		КонецЕсли;
		
		// Граница не уменьшилась — тот же запрос повторился бы бесконечно.
		Если ВремяСамойРанней >= ВерхняяГраница Тогда
			Результат.Полная = Ложь;
			Прервать;
		КонецЕсли;
		
		ВерхняяГраница = ВремяСамойРанней;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// GET с учетом лимитов API юрлиц: если остаток запросов исчерпан или пришел 429 — пауза на
// x-rate-Limit-retry-after-seconds и один повтор.
//
Функция ВыполнитьЗапросСУчетомЛимита(Сессия, URL)
	
	Ответ = КоннекторHTTP_BankExchange.Get(URL, , , Сессия);
	
	Если Ответ.КодСостояния = 429 Тогда
		Пауза(СекундДоСбросаЛимита(Ответ));
		Ответ = КоннекторHTTP_BankExchange.Get(URL, , , Сессия);
	КонецЕсли;
	
	Если Ответ.КодСостояния = 200 И ЗначениеЗаголовка(Ответ.Заголовки, "x-rate-limit-remaining") = "0" Тогда
		// Следующий запрос упадет на 429 — переждем заранее.
		Пауза(СекундДоСбросаЛимита(Ответ));
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция СекундДоСбросаЛимита(Ответ)
	
	Значение = ЗначениеЗаголовка(Ответ.Заголовки, "x-rate-limit-retry-after-seconds");
	Попытка
		Секунд = Число(Значение);
	Исключение
		Секунд = 0;
	КонецПопытки;
	Возврат ?(Секунд > 0, Секунд, 60);
	
КонецФункции

// Заголовки ответа ищем без учета регистра: банк пишет x-rate-Limit-retry-after-seconds, платформа может привести к нижнему.
//
Функция ЗначениеЗаголовка(Заголовки, Имя)
	
	Для Каждого КлючЗначение Из Заголовки Цикл
		Если НРег(КлючЗначение.Ключ) = НРег(Имя) Тогда
			Возврат СокрЛП(Строка(КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// §7: удалять документы, которых нет в выписке, разрешено, только если выписка вытянута полностью
// и каждый загруженный день закрыт в банке (isFinal = true).
//
Функция СинхронизацияРазрешена(Сессия, НомерСчетаIBAN, РезультатЧтения)
	
	Если Не РезультатЧтения.Полная Или РезультатЧтения.ДатыЗагруженных.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ДеньЗагрузки Из РезультатЧтения.ДатыЗагруженных Цикл
		Если Не ДатаФинальная(Сессия, НомерСчетаIBAN, ДеньЗагрузки, РезультатЧтения.Ошибки) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Признак финальности баланса на дату: «true — баланс окончательный, все операции за день проведены».
// Формат запроса и ответа — предположение C плана, не подтверждено; при сомнении (пустой ответ,
// элемент не Соответствие или isFinal <> Истина хотя бы у одного элемента) функция возвращает Ложь —
// требуем isFinal = Истина у всех элементов ответа, а не хотя бы у одного.
//
Функция ДатаФинальная(Сессия, НомерСчетаIBAN, ДеньЗагрузки, Ошибки)
	
	URL = СтрШаблон("https://corp-api.monobank.ua/ext/v1/accounts/%1/balances?from=%2&to=%3",
	НомерСчетаIBAN, ДатаВремяВUnixTime(НачалоДня(ДеньЗагрузки)), ДатаВремяВUnixTime(КонецДня(ДеньЗагрузки)));
	Ответ = ВыполнитьЗапросСУчетомЛимита(Сессия, URL);
	
	Если Ответ.КодСостояния <> 200 Тогда
		Ошибки.Добавить(ОписаниеОшибкиОтвета(Ответ, "balances " + Формат(ДеньЗагрузки, "ДФ=dd.MM.yyyy")));
		Возврат Ложь;
	КонецЕсли;
	
	Балансы = КоннекторHTTP_BankExchange.КакJson(Ответ);
	Если ТипЗнч(Балансы) <> Тип("Массив") Или Балансы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Баланс Из Балансы Цикл
		Если ТипЗнч(Баланс) <> Тип("Соответствие") Или Баланс["isFinal"] <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ОписаниеОшибкиОтвета(Ответ, Контекст)
	
	ОписаниеБанка = "";
	Попытка
		Тело = КоннекторHTTP_BankExchange.КакJson(Ответ);
		Если ТипЗнч(Тело) = Тип("Соответствие") И Тело["errorDescription"] <> Неопределено Тогда
			ОписаниеБанка = Строка(Тело["errorDescription"]);
		КонецЕсли;
	Исключение
		ОписаниеБанка = "";
	КонецПопытки;
	
	Если Ответ.КодСостояния = 429 Тогда
		Шаблон = НСтр("ru = 'monobank (юрлица): превышен лимит запросов (429) при чтении %1. %2';
		|uk = 'monobank (юрособи): перевищено ліміт запитів (429) при читанні %1. %2'");
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		Шаблон = НСтр("ru = 'monobank (юрлица): данные не найдены (404) при чтении %1 — проверьте IBAN и период. %2';
		|uk = 'monobank (юрособи): дані не знайдено (404) при читанні %1 — перевірте IBAN і період. %2'");
	Иначе
		Шаблон = НСтр("ru = 'monobank (юрлица): ошибка HTTP %3 при чтении %1. %2';
		|uk = 'monobank (юрособи): помилка HTTP %3 при читанні %1. %2'");
	КонецЕсли;
	
	Возврат СокрЛП(СтрШаблон(Шаблон, Контекст, ОписаниеБанка, Ответ.КодСостояния));
	
КонецФункции

Функция СтрокаПериода(Начало, Конец)
	
	Возврат Формат(Начало, "ДФ='dd.MM.yyyy HH:mm:ss'") + " - " + Формат(Конец, "ДФ='dd.MM.yyyy HH:mm:ss'");
	
КонецФункции

Функция ДатаВремяВUnixTime(ДатаВремя)
	
	Возврат Формат(УниверсальноеВремя(ДатаВремя) - Дата("19700101"), "ЧГ=0");
	
КонецФункции

Функция ДатаИзUnixTime(Секунды)
	
	Возврат МестноеВремя(Дата("19700101") + Секунды);
	
КонецФункции

// Максимум API — 500; по умолчанию банк отдает 10, поэтому limit передается всегда.
Функция РазмерСтраницы()
	
	Возврат 500;
	
КонецФункции

// В API юрлиц description — это уже «Призначення операції». Фактический плательщик (ultimateDebit) дописывается.
//
Функция НазначениеПлатежаИзТранзакции(Транзакция)
	
	Результат = СокрЛП(Строка(Транзакция["description"]));
	
	Плательщик = Транзакция["ultimateDebit"];
	
	Если ТипЗнч(Плательщик) = Тип("Соответствие") Тогда
		Представление = СокрЛП(СокрЛП(Строка(Плательщик["name"])) + " " + СокрЛП(Строка(Плательщик["idCode"])));
		Если Не ПустаяСтрока(Представление) Тогда
			Результат = Результат + " Фактичний платник: " + Представление;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Лев(Результат, 255);
	
КонецФункции

// Переносит транзакции в таблицу импорта. Дата документа — completedTime (проведение), не time (создание).
//
Процедура ЗаполнитьТаблицуДаннымиТранзакций(МассивТранзакций, ДокументыКИмпорту, НомерСчетаIBAN)
	
	Для Каждого мТранзакция Из МассивТранзакций Цикл
		
		КонтрагентСчет = мТранзакция["counterIban"];
		КонтрагентЕДРПОУ = мТранзакция["counterEdrpou"];
		КонтрагентНаименование = мТранзакция["counterName"];
		мДатаТранзакции = ДатаИзUnixTime(?(мТранзакция["completedTime"] = Неопределено, мТранзакция["time"], мТранзакция["completedTime"]));
		мДатаТрСтрокой = Формат(мДатаТранзакции, "ДФ='dd.MM.yyyy HH:mm:ss'");
		
		НоваяСтрока = ДокументыКИмпорту.Добавить();
		НоваяСтрока.ДокументИД = мТранзакция["id"];
		НоваяСтрока.ИДТранзакцииБанка = мТранзакция["id"];
		НоваяСтрока.Дата = мДатаТрСтрокой;
		НоваяСтрока.НазначениеПлатежа = НазначениеПлатежаИзТранзакции(мТранзакция);
		НоваяСтрока.НомерДок = мТранзакция["id"];
		НоваяСтрока.Номер = НоваяСтрока.НомерДок;
		
		мСумма = мТранзакция["amount"] / 100; // суммы транзакций в копейках (в отличие от Account.balance)
		НоваяСтрока.СуммаДокумента = ?(мСумма < 0, -1 * мСумма, мСумма);
		
		Если мСумма < 0 Тогда
			НоваяСтрока.Операция = "ПлатежноеПоручение";
			НоваяСтрока.Сумма = Формат(НоваяСтрока.СуммаДокумента, "ЧГ=0");
			НоваяСтрока.СуммаСписано = НоваяСтрока.СуммаДокумента;
			НоваяСтрока.ПлательщикСчет = НомерСчетаIBAN;
			НоваяСтрока.ПолучательСчет = КонтрагентСчет;
			НоваяСтрока.ПолучательКПП = КонтрагентЕДРПОУ;
			НоваяСтрока.Получатель = КонтрагентНаименование;
			НоваяСтрока.ДатаСписано = мДатаТрСтрокой;
			НоваяСтрока.Списано = мДатаТранзакции;
		Иначе
			НоваяСтрока.Операция = "ПлатежноеТребование";
			НоваяСтрока.Сумма = Формат(НоваяСтрока.СуммаДокумента, "ЧГ=0");
			НоваяСтрока.ПлательщикСчет = КонтрагентСчет;
			НоваяСтрока.ПлательщикКПП = КонтрагентЕДРПОУ;
			НоваяСтрока.Плательщик = КонтрагентНаименование;
			НоваяСтрока.ПолучательСчет = НомерСчетаIBAN;
			НоваяСтрока.СуммаПоступило = НоваяСтрока.СуммаДокумента;
			НоваяСтрока.ДатаПоступило = мДатаТрСтрокой;
			НоваяСтрока.Поступило = мДатаТранзакции;
		КонецЕсли;
		
		НоваяСтрока.КодВалюты = СокрЛП(Строка(мТранзакция["currencyCode"])); // строка, в отличие от персонального API
		
	КонецЦикла;
	
КонецПроцедуры

// Копия одноименной процедуры модуля ФОП: общий распознаватель обработки без формы.
//
Процедура РаспознатьДокументыДляРегламента(Объект, ДокументыКИмпорту)
	
	ТаблицаНайденныхДокументов = Новый ТаблицаЗначений;
	ТаблицаНайденныхДокументов.Колонки.Добавить("БудетОбрабатыватьсяПриЗагрузке", Новый ОписаниеТипов("Булево"));
	
	ТаблицаТаблицДокументов = Новый ТаблицаЗначений;
	ТаблицаТаблицДокументов.Колонки.Добавить("НомерСтрокиВТаблицеИмпорта", Новый ОписаниеТипов("Число"));
	ТаблицаТаблицДокументов.Колонки.Добавить("ТаблицаНайденныхДокументов", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	КонтекстФормы = Новый Структура;
	КонтекстФормы.Вставить("ТаблицаНайденныхДокументов", ТаблицаНайденныхДокументов);
	
	ПараметрыВыделенияКолонок = Новый Структура("ВыделитьКолонкуДокумент, ВыделитьКолонкуСуммаСписано, ВыделитьКолонкуСуммаПоступило,
	|ВыделитьКолонкуКонтрагент, ВыделитьКолонкуДоговор, ВыделитьКолонкуРСКонтрагента, ВыделитьКолонкуВидОперации",
	Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	
	НомерСчета = Объект.БанковскийСчет.НомерСчета;
	НомерСтроки = 0;
	
	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл
		Если (СтрокаДокумента.ПлательщикСчет = НомерСчета Или СтрокаДокумента.ПолучательСчет = НомерСчета)
			И ЗначениеЗаполнено(Объект.БанковскийСчет.ВалютаДенежныхСредств) Тогда
			Обработки.СМП_КлиентБанк.РаспознатьДанныеВСтрокеДокумента(СтрокаДокумента, Неопределено, ПараметрыВыделенияКолонок,
			Объект, ТаблицаТаблицДокументов, КонтекстФормы, Ложь);
			НомерСтроки = НомерСтроки + 1;
			СтрокаДокумента.НомерСтроки = НомерСтроки;
		Иначе
			СтрокаДокумента.НомерСтроки = 0;
		КонецЕсли;
	КонецЦикла;
	
	Индекс = ДокументыКИмпорту.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ДокументыКИмпорту[Индекс].НомерСтроки = 0 Тогда
			ДокументыКИмпорту.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл
		// Как в регламенте ПриватБанка: строки с замечаниями распознавателя не отбрасываем —
		// документ создается, а замечание уходит в журнал регистрации, иначе курсор пройдет мимо операции.
		Если Не СтрокаДокумента.Проведен Тогда
			СтрокаДокумента.Загружать = Истина;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтрокаДокумента.ОписаниеОшибок) Тогда
			ЗаписьЖурналаРегистрации("monobank (юрособи)", УровеньЖурналаРегистрации.Предупреждение, , Объект.БанковскийСчет,
			СтрШаблон(НСтр("ru = 'Транзакция %1 от %2: %3. Если документ не записался — загрузите период вручную из формы обработки.';
			|uk = 'Транзакція %1 від %2: %3. Якщо документ не записався — завантажте період вручну з форми обробки.'"),
			СтрокаДокумента.ИДТранзакцииБанка, СтрокаДокумента.Дата, СтрокаДокумента.ОписаниеОшибок));
		КонецЕсли;
		СтрокаДокумента.НазначениеПлатежа = СокрЛП(СтрокаДокумента.НазначениеПлатежа);
		СтрокаДокумента.НомерКартинки = ?(ПустаяСтрока(СтрокаДокумента.ОписаниеОшибок), 0, 1);
	КонецЦикла;
	
КонецПроцедуры

// Дата нового курсора (§8): последняя загруженная, но не позже первой PENDING; при неполном чтении — пусто.
//
Функция ДатаКурсора(РезультатЧтения, КонецПериода)
	
	Если Не РезультатЧтения.Полная Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатЧтения.ВремяПоследнейЗагруженной) Тогда
		Результат = РезультатЧтения.ВремяПоследнейЗагруженной;
	Иначе
		Результат = КонецПериода;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатЧтения.ВремяПервойПропущенной)
		И РезультатЧтения.ВремяПервойПропущенной < Результат Тогда
		Результат = РезультатЧтения.ВремяПервойПропущенной;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьЗначениеСведения(Владелец, Значение, ДатаЗначения)
	
	Рег = РегистрыСведений.СМП_НомерПоследнейТранзакции.СоздатьМенеджерЗаписи();
	Рег.БанковскийСчет = Владелец;
	Рег.ИДТранзакции = Значение;
	Рег.ДатаТранзакции = ДатаЗначения;
	Рег.Записать();
	
КонецПроцедуры

Функция ПолучитьЗначениеСведения(Владелец)
	
	Рег = РегистрыСведений.СМП_НомерПоследнейТранзакции.СоздатьМенеджерЗаписи();
	Рег.БанковскийСчет = Владелец;
	Рег.Прочитать();
	
	Если Рег.Выбран() Тогда
		Данные = Новый Структура;
		Данные.Вставить("ИДТранзакции", Рег.ИДТранзакции);
		Данные.Вставить("ДатаТранзакции", Рег.ДатаТранзакции);
		Возврат Данные;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти
