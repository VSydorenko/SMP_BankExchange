// Читатель выписок: CSV клиент-банка (формат «iFOBS» - гипотеза о происхождении, для кода это
// только имя). Один модуль на шесть банков: ПроКредит, УкрСиб, Восток, Райффайзен, Универсал, Акорд.
//
// Правило одно на все банки, выведенное из образцов (план 03, задача 6). Колонки берутся по номеру
// (0-based), а не по названию заголовка: эталон - стара обработка, она читала по номеру.
//   0 код владельца счета   1 МФО владельца     2 наш счет          3 валюта
//   4 дата и время операции 5 код операции      6 МФО банка контрагента   7 назва банка
//   8 счет контрагента      9 код контрагента   10 контрагент        11 номер документа
//   12 дата документа (не читается)             13 дебет             14 кредит
//   15 назначение платежа   16 гривневое покрытие (не читается)
// Первая запись - заголовок. Завершающий «;» дает лишнее пустое поле - не ошибка.
//
// Направление: заполнена колонка «Дебет» - «Списано», «Кредит» - «Поступило»; сумма берется из
// заполненной колонки. «Заполнена» - непорожняя после обрезания пробелов (ни один банк в образцах не
// пишет нуль в противоположную колонку). Обе пусты или обе заполнены - «Ошибка».
// МФО контрагента - из колонки 6, а если она пуста - из IBAN контрагента (позиции 5-10).
// Наш счет строки (НомерСчета) - из колонки 2 файла, а не из Параметры.НомерСчета: так фильтр
// чужих счетов платформы видит настоящий счет строки.
// ДатаДокумента не заполняется: старые обработки пишут день документа как день даты операции, а
// составной ключ шага 0 берет дату документа и при ее отсутствии - дату операции (спека, D17).
// Идентификатора операции банк не дает, остатков в файле нет.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет
// «Ошибка» с сырым значением, ЧтениеПолное остается Ложь.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер CSV и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("csv");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиiFOBS_CSV");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'CSV клиент-банка (ПроКредит, УкрСиб, Восток, Райффайзен, Универсал, Акорд)';
		|uk = 'CSV клієнт-банку (ПроКредит, Укрсиб, Восток, Райффайзен, Універсал, Акорд)'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (Кодировка - из описания читателя).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	КодировкаФайла = Параметры.Кодировка;
	Если ПустаяСтрока(КодировкаФайла) Тогда
		КодировкаФайла = Кодировка();
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Данные, КодировкаФайла, ";");
	Если Записи.Количество() = 0 Тогда
		ДобавитьОшибку(Выписка, 0, НСтр("ru = 'Файл пуст: нет даже строки заголовка.';
			|uk = 'Файл порожній: немає навіть рядка заголовка.'"));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	// Первая запись - заголовок.
	Для Индекс = 1 По Записи.ВГраница() Цикл
		Запись = Записи[Индекс];
		Операция = РазобратьЗапись(Запись, Выписка);
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка начала файла: «файл похож на этот формат». Читает только начало файла и сверяет
// заголовок по позициям колонок: число колонок и названия колонок 0, 2, 4, 13, 14, 15. Название колонки
// номера документа (11) не участвует: в образце Аваль она «Документ», у остальных «Номер документа».
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	// Из потока читается только начало файла; файл целиком в буфер не копируется.
	Начало = СМП_ЧтениеВыписокОбщее.НачалоДанных(Данные, 4096);
	Если Начало.Размер() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Начало, Кодировка(), ";");
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Поля = Записи[0].Поля;
	Если Поля.Количество() < 17 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяКолонки(Поля, 0) = "єдрпоу"
		И ИмяКолонки(Поля, 2) = "рахунок"
		И Лев(ИмяКолонки(Поля, 4), 11) = "дата операц"
		И ИмяКолонки(Поля, 13) = "дебет"
		И ИмяКолонки(Поля, 14) = "кредит"
		И ИмяКолонки(Поля, 15) = "призначення платежу";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образцов (20-samples.md): windows-1251.
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

Функция ИмяКолонки(Поля, Номер)

	Возврат НРег(СокрЛП(Поля[Номер]));

КонецФункции

// Разбирает запись в структуру операции или возвращает Неопределено, дописав в диагностику «Ошибка»
// по каждому нераспознанному значению (строка в Операции не попадает).
Функция РазобратьЗапись(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = Запись.Поля;

	Если Поля.Количество() < 16 Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'В строке %1 полей: %2, нужно не меньше 16. Строка не прочитана.';
				|uk = 'У рядку %1 полів: %2, потрібно не менше 16. Рядок не прочитано.'"),
			Формат(Номер, "ЧГ="), Формат(Поля.Количество(), "ЧГ=")));
		Возврат Неопределено;
	КонецЕсли;

	Ошибок = 0;

	Если ПустоеПоле(Поля[0]) Тогда
		ДобавитьОшибку(Выписка, Номер, НСтр("ru = 'Строка не прочитана: пуст код владельца счета (колонка 1).';
			|uk = 'Рядок не прочитано: порожній код власника рахунку (колонка 1).'"));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Сумма и направление: заполнена ровно одна из колонок «Дебет» (13) и «Кредит» (14).
	Дебет = СокрЛП(Поля[13]);
	Кредит = СокрЛП(Поля[14]);
	Сумма = Неопределено;
	Направление = "";
	Если ПустоеПоле(Дебет) И ПустоеПоле(Кредит) Тогда
		ДобавитьОшибку(Выписка, Номер, НСтр("ru = 'Строка не прочитана: не заполнена ни одна из колонок «Дебет» и «Кредит».';
			|uk = 'Рядок не прочитано: не заповнено жодної з колонок «Дебет» і «Кредит».'"));
		Ошибок = Ошибок + 1;
	ИначеЕсли Не ПустоеПоле(Дебет) И Не ПустоеПоле(Кредит) Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: заполнены обе колонки «Дебет» (%1) и «Кредит» (%2), направление неоднозначно.';
				|uk = 'Рядок не прочитано: заповнено обидві колонки «Дебет» (%1) і «Кредит» (%2), напрям неоднозначний.'"),
			Дебет, Кредит));
		Ошибок = Ошибок + 1;
	Иначе
		Направление = ?(ПустоеПоле(Дебет), "Поступило", "Списано");
		СырьеСуммы = ?(ПустоеПоле(Дебет), Кредит, Дебет);
		Сумма = СМП_ЧтениеВыписокОбщее.РазобратьСумму(СырьеСуммы);
		Если Сумма = Неопределено Тогда
			ДобавитьОшибку(Выписка, Номер, СтрШаблон(
				НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму: «%1».';
					|uk = 'Рядок не прочитано: не вдалося розібрати суму: «%1».'"),
				СырьеСуммы));
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЕсли;

	// Дата и время операции: с секундами или без.
	СырьеДаты = СокрЛП(Поля[4]);
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр чч:мм:сс");
	Если ДатаОперации = Неопределено Тогда
		ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр чч:мм");
	КонецЕсли;
	Если ДатаОперации = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату операции: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Валюта: буквенный код становится числовым, пустая - валюта счета.
	СырьеВалюты = СокрЛП(Поля[3]);
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный код валюты: «%1».';
				|uk = 'Рядок не прочитано: невідомий код валюти: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	СчетКонтрагента = СокрЛП(Поля[8]);

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", СокрЛП(Поля[2]));
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", СокрЛП(Поля[11]));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", Направление);
	Операция.Вставить("КонтрагентНаименование", СокрЛП(Поля[10]));
	Операция.Вставить("КонтрагентНомерСчета", СчетКонтрагента);
	Операция.Вставить("КонтрагентКод", СокрЛП(Поля[9]));
	Операция.Вставить("КонтрагентМФО", МФОКонтрагента(СокрЛП(Поля[6]), СчетКонтрагента));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(Поля[15]));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

// МФО контрагента: из колонки, а если она пуста - из IBAN (позиции 5-10); для счета не в формате IBAN - пусто.
Функция МФОКонтрагента(МФОКолонки, СчетКонтрагента)

	Если Не ПустаяСтрока(МФОКолонки) Тогда
		Возврат МФОКолонки;
	КонецЕсли;
	Если СтрДлина(СчетКонтрагента) = 29 И ВРег(Лев(СчетКонтрагента, 2)) = "UA" Тогда
		Возврат Сред(СчетКонтрагента, 5, 6);
	КонецЕсли;
	Возврат "";

КонецФункции

// Пустое поле: пробелы (в том числе неразрывные) не считаются значением.
Функция ПустоеПоле(Текст)

	Возврат ПустаяСтрока(СтрЗаменить(Текст, Символ(160), " "));

КонецФункции

Процедура ДобавитьОшибку(Выписка, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = "Ошибка";
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

#КонецОбласти
