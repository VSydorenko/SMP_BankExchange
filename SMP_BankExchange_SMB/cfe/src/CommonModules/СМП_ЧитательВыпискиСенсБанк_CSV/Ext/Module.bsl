// Читатель выписок: CSV Сенс Банка. Одна строка реестра, две раскладки файла - ветки одного модуля (план 03,
// задача 7). Раскладку выбирает признак записи, как в старой обработке: длина первой колонки данных больше 10 -
// «ТОВ» (юридическое лицо, 19 колонок), иначе «ФОП» (17 колонок). Выбор идет по каждой записи.
//
// Колонки берутся по номеру (0-based), как в старой обработке.
// Раскладка ТОВ: 1 наш IBAN, 2 операция («Дебет» или «Кредит»), 4 IBAN контрагента, 5 МФО контрагента,
//   6 наименование контрагента, 7 код контрагента, 8 назначение, 10 номер документа, 11 сумма, 12 валюта,
//   13 час проведения, 14 дата документа. Дата операции = дата документа (14) плюс час проведения (13): так
//   делает старая обработка, а не по колонке «Дата проведения» (9).
// Раскладка ФОП: 0 дата операции (только дата, время 00:00:00), 4 наш счет (IBAN), 5 валюта, 6 МФО контрагента,
//   8 счет контрагента, 9 код контрагента, 10 наименование контрагента, 11 номер документа, 13 дебет, 14 кредит,
//   15 назначение.
// Отступление 2 (уточнено планувальником): валюта ФОП - из колонки «Валюта» (5), а не из колонки МФО (3), как
// читала старая обработка; UAH -> 980, пустая - валюта счета.
//
// Направление ТОВ строго: «Кредит» - поступило, «Дебет» - списано (после обрезания пробелов), иное - «Ошибка».
// Направление ФОП: колонки «Дебет» и «Кредит» разбираются как числа, пустая колонка - ноль; ненулевая ровно одна -
// направление и сумма из нее; обе нулевые или обе ненулевые - «Ошибка»; нераспознанное значение - «Ошибка» с
// сырым значением.
// Наш счет строки (НомерСчета) - из колонки файла, а не из Параметры.НомерСчета: так фильтр чужих счетов
// платформы видит настоящий счет строки.
// ДатаДокумента не заполняется: старая обработка кладет в ДатаДок день операции, а составной ключ при пустой
// ДатаДокумента берет дату операции (спека, D17). Пустой IBAN контрагента остается пустым (как в старой обработке).
// Идентификатора операции банк не дает, остатков в файле нет.
//
// Нераспознанное значение не становится данными: строка не попадает в Операции, в диагностику идет «Ошибка» с
// сырым значением, ЧтениеПолное остается Ложь.
//
// Модуль ПЕРЕНОСИМЫЙ: не обращается к объектам конфигурации; пользуется только общим модулем
// СМП_ЧтениеВыписокОбщее (контейнер CSV и разбор значений).

#Область ПрограммныйИнтерфейс

// Описание читателя (контракт читателя выписок).
//
// Возвращаемое значение:
//  Структура - см. docs/architecture/reader-contract.md.
Функция ОписаниеЧитателя() Экспорт

	Расширения = Новый Массив;
	Расширения.Добавить("csv");

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ЧитательВыпискиСенсБанк_CSV");
	Описание.Вставить("ВерсияКонтракта", 1);
	Описание.Вставить("Наименование", НСтр("ru = 'CSV Сенс Банка (юридические лица и ФОП)';
		|uk = 'CSV Сенс Банку (юридичні особи та ФОП)'"));
	Описание.Вставить("РасширенияФайлов", Расширения);
	Описание.Вставить("Кодировка", Кодировка());
	Описание.Вставить("ДаетИдентификаторыОпераций", Ложь);
	Описание.Вставить("ДаетОстатки", Ложь);
	Возврат Описание;

КонецФункции

// Читает файл в конверт платформы.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//  Параметры - Структура - параметры чтения (Кодировка - из описания читателя).
//  Выписка - Структура - конверт платформы.
Процедура Прочитать(Данные, Параметры, Выписка) Экспорт

	КодировкаФайла = Параметры.Кодировка;
	Если ПустаяСтрока(КодировкаФайла) Тогда
		КодировкаФайла = Кодировка();
	КонецЕсли;

	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Данные, КодировкаФайла, ";");
	Если Записи.Количество() = 0 Тогда
		ДобавитьОшибку(Выписка, 0, НСтр("ru = 'Файл пуст: нет даже строки заголовка.';
			|uk = 'Файл порожній: немає навіть рядка заголовка.'"));
		Возврат;
	КонецЕсли;

	Потери = 0;
	Наименьшая = Неопределено;
	Наибольшая = Неопределено;

	// Первая запись - заголовок.
	Для Индекс = 1 По Записи.ВГраница() Цикл
		Запись = Записи[Индекс];
		Если ЭтоРаскладкаТОВ(Запись.Поля) Тогда
			Операция = РазобратьЗаписьТОВ(Запись, Выписка);
		Иначе
			Операция = РазобратьЗаписьФОП(Запись, Выписка);
		КонецЕсли;
		Если Операция = Неопределено Тогда
			Потери = Потери + 1;
			Продолжить;
		КонецЕсли;
		НоваяОперация = Выписка.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяОперация, Операция);
		Наименьшая = ?(Наименьшая = Неопределено, Операция.ДатаОперации, Мин(Наименьшая, Операция.ДатаОперации));
		Наибольшая = ?(Наибольшая = Неопределено, Операция.ДатаОперации, Макс(Наибольшая, Операция.ДатаОперации));
	КонецЦикла;

	// Период выписки - из дат операций: в файле шапки с периодом нет.
	Если Наименьшая <> Неопределено Тогда
		Выписка.НачалоПериода = НачалоДня(Наименьшая);
		Выписка.КонецПериода = КонецДня(Наибольшая);
	КонецЕсли;

	Выписка.ЧтениеПолное = Потери = 0;

КонецПроцедуры

// Дешевая проверка начала файла: «файл похож на этот формат». Читает только начало файла и сверяет заголовок по
// позициям колонок (регистр названий не важен). Раскладка заголовка: первая колонка «Наш рахунок» - ТОВ (не меньше
// 19 колонок; названия колонок 1, 2, 4, 11, 13, 14), иначе ФОП (не меньше 17 колонок; названия колонок 0, 4, 11,
// 13, 14, 15).
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое выписки.
//
// Возвращаемое значение:
//  Булево - Истина, если файл похож на формат.
Функция ФайлПохожНаФормат(Данные) Экспорт

	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	Если Буфер.Размер = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Начало = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.ПолучитьСрез(0, Мин(Буфер.Размер, 4096)));
	Записи = СМП_ЧтениеВыписокОбщее.ЗаписиCSV(Начало, Кодировка(), ";");
	Если Записи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Поля = Записи[0].Поля;
	Если Поля.Количество() < 1 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ИмяКолонки(Поля, 0) = "наш рахунок" Тогда
		Возврат Поля.Количество() >= КолонокТОВ()
			И ИмяКолонки(Поля, 1) = "наш iban"
			И ИмяКолонки(Поля, 2) = "операція"
			И ИмяКолонки(Поля, 4) = "iban"
			И ИмяКолонки(Поля, 11) = "сума"
			И ИмяКолонки(Поля, 13) = "час проведення"
			И ИмяКолонки(Поля, 14) = "дата документа";
	КонецЕсли;

	Возврат Поля.Количество() >= КолонокФОП()
		И ИмяКолонки(Поля, 0) = "дата операции"
		И ИмяКолонки(Поля, 4) = "счет"
		И ИмяКолонки(Поля, 11) = "номер документа"
		И ИмяКолонки(Поля, 13) = "дебет"
		И ИмяКолонки(Поля, 14) = "кредит"
		И ИмяКолонки(Поля, 15) = "назначение платежа";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кодировка образцов (20-samples.md): windows-1251.
Функция Кодировка()

	Возврат "windows-1251";

КонецФункции

// Сколько колонок читает раскладка ТОВ (последняя читаемая - 14, наименьшая нужная запись - 19 колонок образца).
Функция КолонокТОВ()

	Возврат 19;

КонецФункции

// Сколько колонок читает раскладка ФОП (последняя читаемая - 15, колонок образца - 17).
Функция КолонокФОП()

	Возврат 17;

КонецФункции

Функция ИмяКолонки(Поля, Номер)

	Если Номер > Поля.ВГраница() Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(СокрЛП(Поля[Номер]));

КонецФункции

// Признак раскладки ТОВ (как в старой обработке): первая колонка данных длиннее 10 символов.
Функция ЭтоРаскладкаТОВ(Поля)

	Возврат СтрДлина(СокрЛП(Поля[0])) > 10;

КонецФункции

Функция ОшибкаКоротко(Выписка, Номер, Поля, Нужно)

	ДобавитьОшибку(Выписка, Номер, СтрШаблон(
		НСтр("ru = 'В строке %1 полей: %2, нужно не меньше %3. Строка не прочитана.';
			|uk = 'У рядку %1 полів: %2, потрібно не менше %3. Рядок не прочитано.'"),
		Формат(Номер, "ЧГ="), Формат(Поля.Количество(), "ЧГ="), Формат(Нужно, "ЧГ=")));
	Возврат Неопределено;

КонецФункции

// Раскладка ТОВ: возвращает структуру операции или Неопределено (с диагностикой «Ошибка» по каждому значению).
Функция РазобратьЗаписьТОВ(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = Запись.Поля;
	Если Поля.Количество() < КолонокТОВ() Тогда
		Возврат ОшибкаКоротко(Выписка, Номер, Поля, КолонокТОВ());
	КонецЕсли;

	Ошибок = 0;

	// Направление: строго «Кредит» или «Дебет».
	СырьеОперации = СокрЛП(Поля[2]);
	Направление = "";
	Если СырьеОперации = "Кредит" Тогда
		Направление = "Поступило";
	ИначеЕсли СырьеОперации = "Дебет" Тогда
		Направление = "Списано";
	Иначе
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестная операция: «%1», ожидалось «Дебет» или «Кредит».';
				|uk = 'Рядок не прочитано: невідома операція: «%1», очікувалось «Дебет» або «Кредит».'"),
			СырьеОперации));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	СырьеСуммы = СокрЛП(Поля[11]);
	Сумма = СМП_ЧтениеВыписокОбщее.РазобратьСумму(СырьеСуммы);
	Если Сумма = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати суму: «%1».'"),
			СырьеСуммы));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Дата операции: дата документа (14) и час проведения (13), с секундами или без.
	СырьеДаты = СокрЛП(Поля[14]) + " " + СокрЛП(Поля[13]);
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр чч:мм:сс");
	Если ДатаОперации = Неопределено Тогда
		ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр чч:мм");
	КонецЕсли;
	Если ДатаОперации = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату и время операции: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату і час операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	СырьеВалюты = СокрЛП(Поля[12]);
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный код валюты: «%1».';
				|uk = 'Рядок не прочитано: невідомий код валюти: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", СокрЛП(Поля[1]));
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", СокрЛП(Поля[10]));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", Направление);
	Операция.Вставить("КонтрагентНаименование", СокрЛП(Поля[6]));
	Операция.Вставить("КонтрагентНомерСчета", СокрЛП(Поля[4]));
	Операция.Вставить("КонтрагентКод", СокрЛП(Поля[7]));
	Операция.Вставить("КонтрагентМФО", СокрЛП(Поля[5]));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(Поля[8]));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

// Раскладка ФОП: возвращает структуру операции или Неопределено (с диагностикой «Ошибка» по каждому значению).
Функция РазобратьЗаписьФОП(Запись, Выписка)

	Номер = Запись.НомерВИсточнике;
	Поля = Запись.Поля;
	Если Поля.Количество() < КолонокФОП() Тогда
		Возврат ОшибкаКоротко(Выписка, Номер, Поля, КолонокФОП());
	КонецЕсли;

	Ошибок = 0;

	СырьеДаты = СокрЛП(Поля[0]);
	ДатаОперации = СМП_ЧтениеВыписокОбщее.РазобратьДату(СырьеДаты, "дд.мм.рррр");
	Если ДатаОперации = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать дату операции: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати дату операції: «%1».'"),
			СырьеДаты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	// Дебет и кредит как числа, пустая колонка - ноль.
	Дебет = ЧислоКолонки(Поля[13], Выписка, Номер);
	Кредит = ЧислоКолонки(Поля[14], Выписка, Номер);
	Если Дебет = Неопределено Или Кредит = Неопределено Тогда
		Ошибок = Ошибок + ?(Дебет = Неопределено, 1, 0) + ?(Кредит = Неопределено, 1, 0);
	КонецЕсли;
	Сумма = 0;
	Направление = "";
	Если Дебет <> Неопределено И Кредит <> Неопределено Тогда
		Если Дебет <> 0 И Кредит = 0 Тогда
			Направление = "Списано";
			Сумма = Дебет;
		ИначеЕсли Кредит <> 0 И Дебет = 0 Тогда
			Направление = "Поступило";
			Сумма = Кредит;
		Иначе
			ДобавитьОшибку(Выписка, Номер, СтрШаблон(
				НСтр("ru = 'Строка не прочитана: направление неоднозначно: дебет «%1», кредит «%2» (должна быть ненулевой ровно одна колонка).';
					|uk = 'Рядок не прочитано: напрям неоднозначний: дебет «%1», кредит «%2» (має бути ненульовою рівно одна колонка).'"),
				СокрЛП(Поля[13]), СокрЛП(Поля[14])));
			Ошибок = Ошибок + 1;
		КонецЕсли;
	КонецЕсли;

	// Отступление 2: валюта из колонки «Валюта» (5), а не из колонки МФО (3).
	СырьеВалюты = СокрЛП(Поля[5]);
	Валюта = СМП_ЧтениеВыписокОбщее.ЧисловойКодВалюты(СырьеВалюты);
	Если Валюта = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: неизвестный код валюты: «%1».';
				|uk = 'Рядок не прочитано: невідомий код валюти: «%1».'"),
			СырьеВалюты));
		Ошибок = Ошибок + 1;
	КонецЕсли;

	Если Ошибок > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("ПорядковыйНомер", Номер);
	Операция.Вставить("НомерСчета", СокрЛП(Поля[4]));
	Операция.Вставить("Валюта", Валюта);
	Операция.Вставить("ДатаОперации", ДатаОперации);
	Операция.Вставить("НомерДокумента", СокрЛП(Поля[11]));
	Операция.Вставить("Сумма", Сумма);
	Операция.Вставить("Направление", Направление);
	Операция.Вставить("КонтрагентНаименование", СокрЛП(Поля[10]));
	Операция.Вставить("КонтрагентНомерСчета", СокрЛП(Поля[8]));
	Операция.Вставить("КонтрагентКод", СокрЛП(Поля[9]));
	Операция.Вставить("КонтрагентМФО", СокрЛП(Поля[6]));
	Операция.Вставить("НазначениеПлатежа", СокрЛП(Поля[15]));
	Операция.Вставить("СырыеДанные", Запись.Сырые);
	Возврат Операция;

КонецФункции

// Число колонки дебета/кредита: пустая колонка - ноль; нераспознанное значение - «Ошибка» с сырым значением,
// результат Неопределено (счетчик ошибок строки ведет вызывающий).
Функция ЧислоКолонки(Текст, Выписка, Номер)

	Сырье = СокрЛП(Текст);
	Если ПустаяСтрока(СтрЗаменить(Сырье, Символ(160), " ")) Тогда
		Возврат 0;
	КонецЕсли;
	Значение = СМП_ЧтениеВыписокОбщее.РазобратьСумму(Сырье);
	Если Значение = Неопределено Тогда
		ДобавитьОшибку(Выписка, Номер, СтрШаблон(
			НСтр("ru = 'Строка не прочитана: не удалось разобрать сумму: «%1».';
				|uk = 'Рядок не прочитано: не вдалося розібрати суму: «%1».'"),
			Сырье));
	КонецЕсли;
	Возврат Значение;

КонецФункции

Процедура ДобавитьОшибку(Выписка, ПорядковыйНомер, Текст)

	Сообщение = Выписка.Диагностика.Добавить();
	Сообщение.Уровень = "Ошибка";
	Сообщение.ПорядковыйНомер = ПорядковыйНомер;
	Сообщение.Текст = Текст;

КонецПроцедуры

#КонецОбласти
