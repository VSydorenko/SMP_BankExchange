// Формат вывода платежных поручений: текстовый iFOBS doc/ua_payment (банки Акорд, Восток, Райффайзен, УкрГаз,
// Универсал; план 07, задача 3). Дзеркало модуля формата чтения: один модуль на формат, банк определяет реестр,
// а не этот модуль.
//
// Эталон - Выгрузить_Бух копий обработок банков (DataProcessors/СМП_ОбработкаВыпискиБанка_*): файл совпадает с ним
// байт в байт, кроме названных отступлений плана:
//  - байты формируются в памяти (поток), без временного файла;
//  - CLN_OKPO/RCPT_OKPO - по смыслу для всех банков: CLN_* - наша организация (Плательщик), RCPT_* - получатель
//    (три копии эталона переставляют коды - дефект, не воспроизводится);
//  - время (момент создания) и имя файла - параметры, текущее время модуль не читает.
//
// Что пишется (14 строк ключ=значение на поручение, всего 17 строк с заголовком и пустыми):
//  Content-Type=doc/ua_payment, пустая строка, DATE_DOC, NUM_DOC, AMOUNT, CLN_NAME, CLN_OKPO, CLN_ACCOUNT,
//  CLN_BANK_NAME, CLN_BANK_MFO, RCPT_NAME, RCPT_OKPO, RCPT_ACCOUNT, RCPT_BANK_NAME, RCPT_BANK_MFO, PAYMENT_DETAILS,
//  пустая строка. Кодировка windows-1251 без BOM, перевод строки CRLF, файл кончается пустой строкой; нуль поручений -
//  пустой файл (0 байт).
// Пределы: NUM_DOC - последние 10 символов номера (теряется ЛЕВАЯ часть); названия - 40; банки - 45; назначение - 160
// ПОСЛЕ очистки. Названия сторон не очищаются. В назначении удаляется все, кроме: пробела, кириллицы (с ёЁ),
// украинских ІіЇїЄє, латиницы, цифр и знаков . , ; (в частности, удаляются ґ Ґ ' " = - / : № скобки % < > _ и
// неразрывный пробел). Код, счет и МФО пишутся как есть (форматные строки эталона над строками значений ничего не
// меняют, измерено в задаче 0). Сумма: две дробные, разделитель точка, без разделителя групп; нулевая сумма -
// пустое значение (AMOUNT=). Дата дд.ММ.гггг. Все форматы явные: язык сеанса на результат не влияет.
//
// Что обрезано или очищено, модуль не прячет: на каждое такое поле поручения возвращается предупреждение.
//
// Модуль ПЕРЕНОСИМЫЙ (D27, D29): не обращается к объектам конфигурации, не выполняет запросов, не читает текущее
// время и локаль сеанса; пользуется только платформой.

#Область ПрограммныйИнтерфейс

// Описание формата.
//
// Возвращаемое значение:
//  Структура:
//   * Идентификатор - Строка - имя модуля формата.
//   * Наименование - Строка - название формата для человека.
//   * РасширениеФайла - Строка - расширение файла вывода без точки (как ФорматФайлаВыгрузки() копий обработок).
//   * Кодировка - Строка - кодировка файла.
Функция ОписаниеФормата() Экспорт

	Описание = Новый Структура;
	Описание.Вставить("Идентификатор", "СМП_ФорматВыгрузкиiFOBS_TXT");
	Описание.Вставить("Наименование", НСтр("ru = 'Текстовый файл клиент-банка iFOBS (doc/ua_payment)';
		|uk = 'Текстовий файл клієнт-банку iFOBS (doc/ua_payment)'"));
	Описание.Вставить("РасширениеФайла", "txt");
	Описание.Вставить("Кодировка", "windows-1251");
	Возврат Описание;

КонецФункции

// Новые параметры формирования файла.
//
// Возвращаемое значение:
//  Структура:
//   * Момент - Дата - момент создания файла (задает вызывающий; модуль текущее время не читает). iFOBS не пишет
//              время в файл, момент нужен имени файла.
Функция НовыеПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Момент", Дата(1, 1, 1));
	Возврат Параметры;

КонецФункции

// Предлагаемое имя файла: iFOBS_ггггММдд_ЧЧммсс.<расширение>, 24-часовой формат; зависит только от момента.
//
// Параметры:
//  Момент - Дата - момент создания файла.
//
// Возвращаемое значение:
//  Строка
Функция ПредлагаемоеИмяФайла(Момент) Экспорт

	Возврат "iFOBS_" + Формат(Момент, "ДФ=yyyyMMdd") + "_" + Формат(Момент, "ДФ=HHmmss") + "." + ОписаниеФормата().РасширениеФайла;

КонецФункции

// Формирует файл вывода для нормализованных поручений (СМП_ВыгрузкаПлатежей.НовоеПоручение).
//
// Параметры:
//  Поручения - Массив из Структура - нормализованные поручения.
//  Параметры - Структура - см. НовыеПараметры.
//
// Возвращаемое значение:
//  Структура:
//   * Данные - ДвоичныеДанные - файл; при нуле поручений - 0 байт.
//   * Предупреждения - Массив из Структура - по одному на каждое обрезанное или очищенное поле поручения, в порядке
//                      поручений и полей в файле:
//    ** ИндексПоручения - Число - индекс поручения в массиве Поручения (с нуля).
//    ** Поле - Строка - ключ файла ("CLN_NAME", "PAYMENT_DETAILS" и т.д.).
//    ** Действие - Строка - "Обрезано" или "Очищено".
//    ** Предел - Число - для "Обрезано": число символов, до которого обрезано; для "Очищено" - 0.
//    ** Символы - Строка - для "Очищено": набор прибранных символов (без повторов, в порядке появления);
//                для "Обрезано" - пустая строка.
//    ** Текст - Строка - текст для человека.
Функция Сформировать(Поручения, Параметры) Экспорт

	ПроверитьВход(Поручения, Параметры);

	Предупреждения = Новый Массив;
	Файл = Новый ТекстовыйДокумент;
	Файл.УстановитьТипФайла("windows-1251");

	Для Индекс = 0 По Поручения.ВГраница() Цикл
		ДобавитьЗапись(Файл, Поручения[Индекс], Индекс, Предупреждения);
	КонецЦикла;

	Поток = Новый ПотокВПамяти;
	Файл.Записать(Поток, "windows-1251");

	Результат = Новый Структура;
	Результат.Вставить("Данные", Поток.ЗакрытьИПолучитьДвоичныеДанные());
	Результат.Вставить("Предупреждения", Предупреждения);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебные

Процедура ДобавитьЗапись(Файл, Поручение, Индекс, Предупреждения)

	Плательщик = Поручение.Плательщик;
	Получатель = Поручение.Получатель;

	Файл.ДобавитьСтроку("Content-Type=doc/ua_payment");
	Файл.ДобавитьСтроку("");
	Файл.ДобавитьСтроку("DATE_DOC=" + Формат(Поручение.Дата, "ДФ=dd.MM.yyyy"));
	Файл.ДобавитьСтроку("NUM_DOC=" + ПравыеСимволы(Поручение.Номер, 10, Индекс, "NUM_DOC", Предупреждения));
	Файл.ДобавитьСтроку("AMOUNT=" + Формат(Поручение.Сумма, "ЧЦ=14;ЧДЦ=2;ЧРД=.;ЧГ=0"));

	Файл.ДобавитьСтроку("CLN_NAME=" + ЛевыеСимволы(Плательщик.Наименование, 40, Индекс, "CLN_NAME", Предупреждения));
	Файл.ДобавитьСтроку("CLN_OKPO=" + Плательщик.Код);
	Файл.ДобавитьСтроку("CLN_ACCOUNT=" + Плательщик.НомерСчета);
	Файл.ДобавитьСтроку("CLN_BANK_NAME=" + ЛевыеСимволы(Плательщик.Банк, 45, Индекс, "CLN_BANK_NAME", Предупреждения));
	Файл.ДобавитьСтроку("CLN_BANK_MFO=" + Плательщик.МФО);

	Файл.ДобавитьСтроку("RCPT_NAME=" + ЛевыеСимволы(Получатель.Наименование, 40, Индекс, "RCPT_NAME", Предупреждения));
	Файл.ДобавитьСтроку("RCPT_OKPO=" + Получатель.Код);
	Файл.ДобавитьСтроку("RCPT_ACCOUNT=" + Получатель.НомерСчета);
	Файл.ДобавитьСтроку("RCPT_BANK_NAME=" + ЛевыеСимволы(Получатель.Банк, 45, Индекс, "RCPT_BANK_NAME", Предупреждения));
	Файл.ДобавитьСтроку("RCPT_BANK_MFO=" + Получатель.МФО);

	Файл.ДобавитьСтроку("PAYMENT_DETAILS=" + НазначениеПлатежа(Поручение.НазначениеПлатежа, Индекс, Предупреждения));
	Файл.ДобавитьСтроку("");

КонецПроцедуры

// Назначение: сначала очистка недопустимых символов, потом обрезание до 160 (порядок эталона).
Функция НазначениеПлатежа(Знач Текст, Индекс, Предупреждения)

	Убрано = "";
	Результат = Новый Массив;
	Допустимые = ДопустимыеСимволыНазначения();
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти(Допустимые, Знак) > 0 Тогда
			Результат.Добавить(Знак);
		ИначеЕсли СтрНайти(Убрано, Знак) = 0 Тогда
			Убрано = Убрано + Знак;
		КонецЕсли;
	КонецЦикла;

	Если Убрано <> "" Тогда
		Предупреждения.Добавить(НовоеПредупреждение(Индекс, "PAYMENT_DETAILS", "Очищено", 0, Убрано,
			СтрШаблон(НСтр("ru = 'Поле %1: очищены символы: %2.'; uk = 'Поле %1: очищено символи: %2.'"),
			"PAYMENT_DETAILS", ПредставлениеНабора(Убрано))));
	КонецЕсли;

	Возврат ЛевыеСимволы(СтрСоединить(Результат), 160, Индекс, "PAYMENT_DETAILS", Предупреждения);

КонецФункции

Функция ДопустимыеСимволыНазначения()

	Возврат " абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.,ІіЇїЄє;";

КонецФункции

Функция ЛевыеСимволы(Значение, Предел, Индекс, Поле, Предупреждения)

	Если СтрДлина(Значение) > Предел Тогда
		Предупреждения.Добавить(НовоеПредупреждение(Индекс, Поле, "Обрезано", Предел, "", ТекстОбрезания(Поле, Предел)));
	КонецЕсли;
	Возврат Лев(Значение, Предел);

КонецФункции

Функция ПравыеСимволы(Значение, Предел, Индекс, Поле, Предупреждения)

	Если СтрДлина(Значение) > Предел Тогда
		Предупреждения.Добавить(НовоеПредупреждение(Индекс, Поле, "Обрезано", Предел, "", ТекстОбрезания(Поле, Предел)));
	КонецЕсли;
	Возврат Прав(Значение, Предел);

КонецФункции

Функция ТекстОбрезания(Поле, Предел)

	Возврат СтрШаблон(НСтр("ru = 'Поле %1: обрезано до %2 символов.'; uk = 'Поле %1: обрізано до %2 символів.'"),
		Поле, Формат(Предел, "ЧГ=0"));

КонецФункции

Функция НовоеПредупреждение(Индекс, Поле, Действие, Предел, Символы, Текст)

	Предупреждение = Новый Структура;
	Предупреждение.Вставить("ИндексПоручения", Индекс);
	Предупреждение.Вставить("Поле", Поле);
	Предупреждение.Вставить("Действие", Действие);
	Предупреждение.Вставить("Предел", Предел);
	Предупреждение.Вставить("Символы", Символы);
	Предупреждение.Вставить("Текст", Текст);
	Возврат Предупреждение;

КонецФункции

// Набор символов для человека: видимые - сами, невидимые и управляющие (в том числе неразрывный пробел) - кодом U+XXXX.
Функция ПредставлениеНабора(Набор)

	Части = Новый Массив;
	Для Позиция = 1 По СтрДлина(Набор) Цикл
		Знак = Сред(Набор, Позиция, 1);
		Код = КодСимвола(Знак);
		Если Код <= 32 Или Код = 127 Или Код = 160 Тогда
			Части.Добавить("U+" + ШестнадцатеричныйКод(Код));
		Иначе
			Части.Добавить(Знак);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ШестнадцатеричныйКод(Код)

	Цифры = "0123456789ABCDEF";
	Результат = "";
	Остаток = Код;
	Для Номер = 1 По 4 Цикл
		Результат = Сред(Цифры, Остаток % 16 + 1, 1) + Результат;
		Остаток = Цел(Остаток / 16);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьВход(Поручения, Параметры)

	Если ТипЗнч(Параметры) <> Тип("Структура") Или Не Параметры.Свойство("Момент") Тогда
		ВызватьИсключение НСтр("ru = 'Параметры: нет поля Момент.'; uk = 'Параметри: немає поля Момент.'");
	КонецЕсли;
	Если ТипЗнч(Параметры.Момент) <> Тип("Дата") Тогда
		ВызватьИсключение НСтр("ru = 'Параметры.Момент: ожидается значение типа Дата.'; uk = 'Параметри.Момент: очікується значення типу Дата.'");
	КонецЕсли;
	Если ТипЗнч(Поручения) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'Поручения: ожидается Массив нормализованных поручений.'; uk = 'Поручения: очікується Масив нормалізованих доручень.'");
	КонецЕсли;

	Для Индекс = 0 По Поручения.ВГраница() Цикл
		Поручение = Поручения[Индекс];
		ПроверитьСтруктуру(Поручение, "Номер,Дата,Сумма,НазначениеПлатежа,Плательщик,Получатель", "Поручения[" + Индекс + "]");
		Для Каждого Сторона Из СтрРазделить("Плательщик,Получатель", ",") Цикл
			ПроверитьСтруктуру(Поручение[Сторона], "Наименование,Код,НомерСчета,Банк,МФО", "Поручения[" + Индекс + "]." + Сторона);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьСтруктуру(Значение, Поля, Путь)

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = '%1: ожидается Структура.'; uk = '%1: очікується Структура.'"), Путь);
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
		Если Не Значение.Свойство(Поле) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = '%1: нет поля %2.'; uk = '%1: немає поля %2.'"), Путь, Поле);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
