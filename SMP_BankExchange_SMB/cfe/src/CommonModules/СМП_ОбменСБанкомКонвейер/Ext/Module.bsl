// Конвейер регламента обмена с банком (план 5б, решения 1-4, 8-10, 12): один запуск по учетной записи - блокировка, период от курсора,
// чтение точкой входа 6б (ВернутьПлан), запись без человека, ход курсора, состояние обмена и событие журнала регистрации.
// Банка конвейер не знает: строку реестра и конектор решает точка чтения. Учетных данных не берет и не видит; тексты состояния и
// события журнала строит одна функция ТекстСостояния только из уже очищенных текстов точки чтения и записи (С1).
// Нового привилегированного режима нет (С4): права - пользователя завершения (регламентное задание с ИмяПользователя, команда формы).

#Область ПрограммныйИнтерфейс

// Один запуск обмена по учетной записи с настоящим транспортом: обертка регламентного задания и команды формы (задача 4).
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись, по которой идет обмен.
//
// Возвращаемое значение:
//  Структура - см. ОбменПоУчетнойЗаписи.
Функция ОбменРегламентнымЗаданием(УчетнаяЗапись) Экспорт

	Возврат ОбменПоУчетнойЗаписи(УчетнаяЗапись, Обработки.СМП_ТранспортHTTP.Создать());

КонецФункции

// Один запуск обмена по учетной записи (решения 1-4, 8, 10, 12 плана 5б). Берет блокировку записи на весь запуск (без идентификатора формы:
// снимается с концом фонового задания); занята - запуск пропускается (событие «Предупреждение», МоментПропуска, остальное состояние не трогается).
// Нить: период от курсора -> чтение точкой входа 6б -> запись плана без человека -> НовыйКурсор -> курсор и состояние одной короткой
// транзакцией. Класс «Повторить» - исключение ПОСЛЕ записи прочитанного, курсора и состояния (нейтральный текст, без текста банка).
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись, по которой идет обмен.
//  Транспорт - Произвольный - объект с методами ВыполнитьЗапрос, Пауза, ТекущийМомент (D36 п. 1).
//
// Возвращаемое значение:
//  Структура - итог запуска:
//   * Результат - ПеречислениеСсылка.СМП_РезультатыОбменаСБанком, Неопределено - итог; Неопределено - запуск пропущен или пуст.
//   * СозданоДокументов - Число - создано документов (в том числе непроведенных).
//   * НеПроведено - Число - из них непроведенных.
//   * ТекстОшибки - Строка - текст состояния (ТекстСостояния) или причина пропуска; пусто, если нечего показать.
//   * Курсор - Дата, Неопределено - курсор счета после запуска; Неопределено - курсора нет.
//   * Пропущено - Булево - запуск не выполнялся (запись занята, помечена на удаление, нет конектора).
Функция ОбменПоУчетнойЗаписи(УчетнаяЗапись, Транспорт) Экспорт

	Возврат ОбменПоУчетнойЗаписиСоШвом(УчетнаяЗапись, Транспорт, Неопределено);

КонецФункции

// То же, что ОбменПоУчетнойЗаписи, со швом для проверок, которые нельзя вызвать обычным путем (тимчасовий збій запису детерміновано
// не спровокувати; сеанс без пользователя). Продуктовые вызовы шва не передают.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись, по которой идет обмен.
//  Транспорт - Произвольный - транспорт чтения.
//  Шов - Структура, Неопределено - необязательные ключи:
//   * ИтогЗаписи - Структура - вместо записи плана берется этот итог (состав ЗаписатьПланРегламента).
//   * ТекущийПользователь - СправочникСсылка.Пользователи - вместо пользователя сеанса.
//
// Возвращаемое значение:
//  Структура - см. ОбменПоУчетнойЗаписи.
Функция ОбменПоУчетнойЗаписиСоШвом(УчетнаяЗапись, Транспорт, Шов) Экспорт

	Итог = Новый Структура("Результат, СозданоДокументов, НеПроведено, ТекстОшибки, Курсор, Пропущено", Неопределено, 0, 0, "", Неопределено, Ложь);

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "ПометкаУдаления, БанковскийСчет, Ответственный");
	Если Реквизиты.ПометкаУдаления Тогда
		Итог.Пропущено = Истина;
		Итог.ТекстОшибки = НСтр("ru = 'Учетная запись помечена на удаление: обмен не выполняется.'; uk = 'Обліковий запис позначено на видалення: обмін не виконується.'");
		Возврат Итог;
	КонецЕсли;

	Момент = МоментКиев(Транспорт);
	Если Не ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись) Тогда
		Итог.Пропущено = Истина;
		Итог.ТекстОшибки = ТекстПропущено();
		ЗаписатьПропуск(УчетнаяЗапись, Момент);
		ЗаписатьСобытие(УровеньЖурналаРегистрации.Предупреждение, УчетнаяЗапись, Итог.ТекстОшибки);
		Возврат Итог;
	КонецЕсли;

	Сутки = СекундВСутках();
	Сегодня = НачалоДня(Момент);
	Счет = Реквизиты.БанковскийСчет;
	Курсор = КурсорСчета(Счет);
	Итог.Курсор = Курсор;
	Состояние = СостояниеУчетнойЗаписи(УчетнаяЗапись);
	// Начало регламента - доба первого запуска без курсора (D18 п. 3): ставится один раз и за наличия курсора не ставится.
	НачалоРегламента = Неопределено;
	Если Курсор = Неопределено И Не ЗначениеЗаполнено(Состояние.НачалоРегламента) Тогда
		НачалоРегламента = Сегодня;
	КонецЕсли;

	Источник = Обработки.СМП_ОбменСБанком.ИсточникЧтенияСчета(Счет);
	ТекстОтказа = "";
	Если Источник.Вид = "Отказ" Тогда
		ТекстОтказа = Источник.ТекстОтказа;
	ИначеЕсли Источник.УчетнаяЗапись <> УчетнаяЗапись Тогда
		ТекстОтказа = НСтр("ru = 'Счет обслуживает другая учетная запись банка: чтение этой записью не выполняется.'; uk = 'Рахунок обслуговує інший обліковий запис банку: читання цим записом не виконується.'");
	ИначеЕсли Источник.Вид <> "Коннектор" Тогда
		Итог.Пропущено = Истина;
		Итог.ТекстОшибки = НСтр("ru = 'Для учетной записи нет конектора API: обмен не выполняется.'; uk = 'Для облікового запису немає конектора API: обмін не виконується.'");
		ЗаписатьСобытие(УровеньЖурналаРегистрации.Информация, УчетнаяЗапись, Итог.ТекстОшибки);
		Возврат Итог;
	КонецЕсли;

	Автор = Справочники.Пользователи.ПустаяСсылка();
	Если ПустаяСтрока(ТекстОтказа) Тогда
		Автор = АвторЗапуска(Реквизиты.Ответственный, ПользовательЗапуска(Шов));
		Если Не ЗначениеЗаполнено(Автор) Тогда
			ТекстОтказа = НСтр("ru = 'Не определен автор документов: укажите ответственного в учетной записи банка.'; uk = 'Не визначено автора документів: вкажіть відповідального в обліковому записі банку.'");
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Возврат ЗавершитьБезЧтения(УчетнаяЗапись, Счет, Итог, Момент, НачалоРегламента, ТекстОтказа);
	КонецЕсли;

	Реестр = СМП_ЧитателиВыписок.НайтиСтрокуКоннектора(СМП_ЧитателиВыписок.РеестрКоннекторов(), Источник.ИдентификаторСтрокиРеестра).Строка;
	Период = ПериодЗапуска(Курсор, Сегодня, Состояние.НачалоРегламента, Реестр.ПерекрытиеДней, Реестр.ГлубинаЗапускаДней);
	Если Период.Пусто Тогда
		Возврат Итог;
	КонецЕсли;

	К = ?(Курсор = Неопределено, Сегодня - Сутки, Курсор);
	Проход = ПроходЧтения(УчетнаяЗапись, Счет, Период.Начало, КонецДня(Период.Конец), Момент, Транспорт, Автор, Шов);
	// (в) стена без прогресса, а период шире суток после курсора: в том же запуске читается одна эта доба.
	Если Проход.ПрочитанныйОтрезок <> Неопределено И ГраницаЧтения(К, Проход) = Неопределено
		И (Период.Начало < К + Сутки Или Период.Конец > К + Сутки) Тогда
		ПроходДоба = ПроходЧтения(УчетнаяЗапись, Счет, К + Сутки, КонецДня(К + Сутки), Момент, Транспорт, Автор, Шов);
		Проход = ОбъединитьПроходы(Проход, ПроходДоба);
	КонецЕсли;

	Решение = НовыйКурсор(К, Проход);
	Оценка = ОценкаЗапуска(Проход, Решение);
	Если Решение.Курсор <> Неопределено Тогда
		Итог.Курсор = Решение.Курсор;
	КонецЕсли;
	Итог.Результат = Оценка.Результат;
	Итог.СозданоДокументов = Проход.Создано;
	Итог.НеПроведено = Проход.НеПроведено;
	Итог.ТекстОшибки = ТекстСостояния(Оценка.Результат, Проход.Создано, Проход.НеПроведено, Оценка.Причины);

	СохранитьЗапуск(УчетнаяЗапись, Счет, Новый Структура("Курсор, Результат, Создано, НеПроведено, ТекстОшибки, НачалоРегламента, Отметки, Момент",
		Решение.Курсор, Оценка.Результат, Проход.Создано, Проход.НеПроведено, Итог.ТекстОшибки, НачалоРегламента, Решение.Отметки, Момент));
	ЗаписатьСобытие(?(Оценка.Результат = Перечисления.СМП_РезультатыОбменаСБанком.Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
		УчетнаяЗапись, Итог.ТекстОшибки);

	Если Оценка.Повторить Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Банк %1: временный отказ при чтении выписки. Запуск будет повторен.'; uk = 'Банк %1: тимчасова відмова під час читання виписки. Запуск буде повторено.'"), Реестр.Представление);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Период запуска (решение 3 плана 5б): цели дни; начало = Макс(К + 1 - Перекрытие, НачалоРегламента), конец = Мин(К + Глубина, Сегодня).
// Без курсора К = Сегодня - 1 и нижняя граница - НачалоРегламента (состояние, а если его нет - Сегодня); с курсором (в том числе старого
// поколения, D23) НачалоРегламента не применяется. Начало позже конца - пустой запуск.
//
// Параметры:
//  Курсор - Дата, Неопределено - курсор счета; Неопределено - курсора нет.
//  Сегодня - Дата - начало текущих суток по киевскому времени.
//  НачалоРегламента - Дата - ресурс состояния; пусто - ставится первым запуском.
//  ПерекрытиеДней - Число, Неопределено - перекрытие, суток.
//  ГлубинаДней - Число, Неопределено - глубина одного запуска, суток.
//
// Возвращаемое значение:
//  Структура - Начало (Дата), Конец (Дата, начало последних суток периода), Пусто (Булево).
Функция ПериодЗапуска(Курсор, Сегодня, НачалоРегламента, ПерекрытиеДней, ГлубинаДней) Экспорт

	Сутки = СекундВСутках();
	Перекрытие = ?(ЗначениеЗаполнено(ПерекрытиеДней), ПерекрытиеДней, 0);
	Глубина = ?(ЗначениеЗаполнено(ГлубинаДней), ГлубинаДней, 1);
	Если Курсор = Неопределено Тогда
		К = Сегодня - Сутки;
		Нижняя = ?(ЗначениеЗаполнено(НачалоРегламента), НачалоРегламента, Сегодня);
	Иначе
		К = Курсор;
		Нижняя = Дата(1, 1, 1);
	КонецЕсли;

	Результат = Новый Структура("Начало, Конец, Пусто");
	Результат.Начало = Макс(К + Сутки - Перекрытие * Сутки, Нижняя);
	Результат.Конец = Мин(К + Глубина * Сутки, Сегодня);
	Результат.Пусто = Результат.Начало > Результат.Конец;
	Возврат Результат;

КонецФункции

// Новый итог чтения для НовыйКурсор: все поля со значениями «ничего не произошло» (чтение принято и полное). Конвейер дополняет его
// счетчиками записи; тесты задают только нужные поля.
//
// Параметры:
//  НачалоПериода - Дата - начало прочитанного периода.
//  КонецПериода - Дата - конец прочитанного периода.
//
// Возвращаемое значение:
//  Структура - итог чтения:
//   * Принята, ЧтениеПолное - Булево - результат точки чтения (конверт принят; чтение без отказа).
//   * КлассОтказа - Строка - класс отказа конверта.
//   * ГраницаДоверия - Дата - граница доверия конверта.
//   * ПрочитанныйОтрезок - Структура, Неопределено - Начало, Конец, ГраницаДоверия (Р-6): чтение остановила стена конектора.
//   * МоментЧтения - Дата - киевское время запуска; пусто - не ограничивает (только для стены на одних сутках).
//   * НачалоПериода, КонецПериода - Дата - период чтения.
//   * ГраницаЗаписи - Дата, Неопределено - момент самой ранней операции с временным сбоем записи.
//   * ПостоянныеОтказы - Массив из Структура - Дата, Сумма, Направление, Причина.
//   * НевалидныеСтроки - Массив из Структура - Дата, Сумма, Направление, Причина (поля, не текст).
//   * Создано, НеПроведено, Ошибок - Число; ЗаписьСбой - Булево; ТекстыПричин - Массив из Строка (уже очищенные).
Функция НовыйПроход(НачалоПериода, КонецПериода) Экспорт

	Проход = Новый Структура;
	Проход.Вставить("Принята", Истина);
	Проход.Вставить("ЧтениеПолное", Истина);
	Проход.Вставить("КлассОтказа", СМП_ВыпискаБанка.КлассОтказаНет());
	Проход.Вставить("ГраницаДоверия", КонецПериода);
	Проход.Вставить("ПрочитанныйОтрезок", Неопределено);
	Проход.Вставить("МоментЧтения", Дата(1, 1, 1));
	Проход.Вставить("НачалоПериода", НачалоПериода);
	Проход.Вставить("КонецПериода", КонецПериода);
	Проход.Вставить("ГраницаЗаписи", Неопределено);
	Проход.Вставить("ПостоянныеОтказы", Новый Массив);
	Проход.Вставить("НевалидныеСтроки", Новый Массив);
	Проход.Вставить("Создано", 0);
	Проход.Вставить("НеПроведено", 0);
	Проход.Вставить("Ошибок", 0);
	Проход.Вставить("ЗаписьСбой", Ложь);
	Проход.Вставить("ТекстыПричин", Новый Массив);
	Возврат Проход;

КонецФункции

// Ход курсора (решение 4 плана 5б; D18 п. 1, ADR-0014): чистая функция, ничего не читает и не пишет. Курсор рухается только до
// последних полных суток, не позже Мин(граница чтения, ГраницаЗаписи - 1 секунда); назад не идет. «Полные сутки до границы М» - последние
// сутки D, для которых КонецДня(D) <= М. Граница чтения: принятое полное чтение - ГраницаДоверия; стена, отрезок [А; Б] с А <= начала суток
// после курсора - Мин(Б, ГраницаДоверия отрезка) (Р-6); стена на чтении ровно суток после курсора - вся доба (исключение D18 п. 1:
// курсор за суткие, отметка «довантажте файлом»); иначе без движения. Постоянные отказы (закрытый перечень, Р-9) курсор не держат -
// их суткие идут отметками; невалидная строка без даты - курсор стоит.
//
// Параметры:
//  К - Дата - курсор или, без курсора, начало вчерашних суток (Сегодня - 1).
//  Итог - Структура - см. НовыйПроход.
//
// Возвращаемое значение:
//  Структура - Курсор (Дата, Неопределено - новое значение строго позже К или без движения), Отметки (Массив из Структура: Дата, Текст).
Функция НовыйКурсор(К, Итог) Экспорт

	Результат = Новый Структура("Курсор, Отметки", Неопределено, Новый Массив);
	Сутки = СекундВСутках();
	ОтметкиОтказов(Итог, Результат.Отметки);

	Для Каждого Строка Из Итог.НевалидныеСтроки Цикл
		Если Не ЗначениеЗаполнено(Строка.Дата) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Граница = ГраницаЧтения(К, Итог);
	Если Граница = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Итог.ГраницаЗаписи <> Неопределено Тогда
		Граница = Мин(Граница, Итог.ГраницаЗаписи - 1);
	КонецЕсли;

	Доба = ПолнаяДоба(Граница);
	Если Доба = Неопределено Или Доба <= К Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Курсор = Доба;

	Если ДобаПонадСтелей(К, Итог) И Доба >= К + Сутки Тогда
		Результат.Отметки.Добавить(Новый Структура("Дата, Текст", К + Сутки, СтрШаблон(
			НСтр("ru = 'доба %1 прочитана не полностью, довантажте ее файлом выписки'; uk = 'доба %1 прочитана не повністю, довантажте її файлом виписки'"),
			Формат(К + Сутки, "ДФ=dd.MM.yyyy"))));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Состояние обмена учетной записи (регистр СМП_СостояниеОбменаСБанком); нет записи - пустые значения.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись.
//
// Возвращаемое значение:
//  Структура - Момент, Результат, СозданоДокументов, НеПроведено, ТекстОшибки, НачалоРегламента, НедочитанныеДни, МоментПропуска.
Функция СостояниеУчетнойЗаписи(УчетнаяЗапись) Экспорт

	Менеджер = РегистрыСведений.СМП_СостояниеОбменаСБанком.СоздатьМенеджерЗаписи();
	Менеджер.УчетнаяЗапись = УчетнаяЗапись;
	Менеджер.Прочитать();
	Состояние = Новый Структура("Момент, Результат, СозданоДокументов, НеПроведено, ТекстОшибки, НачалоРегламента, НедочитанныеДни, МоментПропуска");
	ЗаполнитьЗначенияСвойств(Состояние, Менеджер);
	Возврат Состояние;

КонецФункции

// Текст состояния и события журнала (решение 9 плана 5б, С1): одна функция для обоих. Принимает только уже очищенные тексты причин
// (точка чтения вырезает учетные данные и сеансовый токен, запись отдает нейтральный текст); результат укорочен до размера ресурса.
//
// Параметры:
//  Результат - ПеречислениеСсылка.СМП_РезультатыОбменаСБанком - итог запуска.
//  Создано - Число - создано документов.
//  НеПроведено - Число - из них не проведено.
//  Причины - Массив из Строка - очищенные тексты причин.
//
// Возвращаемое значение:
//  Строка - текст не длиннее 1024 знаков.
Функция ТекстСостояния(Результат, Создано, НеПроведено, Причины) Экспорт

	Если Результат = Перечисления.СМП_РезультатыОбменаСБанком.Успех Тогда
		Заголовок = НСтр("ru = 'Обмен выполнен: создано документов %1, из них не проведено %2.'; uk = 'Обмін виконано: створено документів %1, з них не проведено %2.'");
	ИначеЕсли Результат = Перечисления.СМП_РезультатыОбменаСБанком.Ошибки Тогда
		Заголовок = НСтр("ru = 'Обмен выполнен с ошибками: создано документов %1, из них не проведено %2.'; uk = 'Обмін виконано з помилками: створено документів %1, з них не проведено %2.'");
	Иначе
		Заголовок = НСтр("ru = 'Требуется действие человека (создано документов %1, из них не проведено %2).'; uk = 'Потрібна дія людини (створено документів %1, з них не проведено %2).'");
	КонецЕсли;
	Текст = СтрШаблон(Заголовок, Формат(Создано, "ЧН=0; ЧГ="), Формат(НеПроведено, "ЧН=0; ЧГ="));
	Если Причины.Количество() > 0 Тогда
		Текст = Текст + " " + СтрСоединить(Причины, "; ");
	КонецЕсли;
	Возврат Лев(Текст, 1024);

КонецФункции

// Перечень недочитанных суток из ресурса НедочитанныеДни: строка «ггггммдд текст» на отметку.
//
// Параметры:
//  Значение - Строка - ресурс НедочитанныеДни.
//
// Возвращаемое значение:
//  Массив из Структура - Дата (начало суток), Текст.
Функция ОтметкиСостояния(Значение) Экспорт

	Результат = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Значение, Символы.ПС, Ложь) Цикл
		Если СтрДлина(Строка) > 9 Тогда
			Результат.Добавить(Новый Структура("Дата, Текст", Дата(Лев(Строка, 8)), Сред(Строка, 10)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Команда «Доба довантажена» (Р-7, Р-9): с правом Изменение на учетные записи, под блокировкой записи (с идентификатором формы), перечитать
// состояние, убрать отметки одних суток, записать. Остальные ресурсы состояния и курсор не трогаются. Блокировка снимается всегда.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись.
//  День - Дата - любые время суток снимаемой доби.
//  ИдентификаторФормы - УникальныйИдентификатор - форма, от имени которой берется блокировка.
//
// Возвращаемое значение:
//  Структура - Выполнено (Булево), Текст (Строка, причина отказа для человека).
Функция ДобаДовантажена(УчетнаяЗапись, День, ИдентификаторФормы) Экспорт

	Результат = Новый Структура("Выполнено, Текст", Ложь, "");
	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.СМП_УчетныеЗаписиБанков) Тогда
		Результат.Текст = НСтр("ru = 'Нет права изменять учетные записи банка.'; uk = 'Немає права змінювати облікові записи банку.'");
		Возврат Результат;
	КонецЕсли;
	Если Не ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись, ИдентификаторФормы) Тогда
		Результат.Текст = ТекстОбменИдет();
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуЗаписей(УчетнаяЗапись, Неопределено);
		Менеджер = РегистрыСведений.СМП_СостояниеОбменаСБанком.СоздатьМенеджерЗаписи();
		Менеджер.УчетнаяЗапись = УчетнаяЗапись;
		Менеджер.Прочитать();
		Если Менеджер.Выбран() Тогда
			Менеджер.УчетнаяЗапись = УчетнаяЗапись;
			Менеджер.НедочитанныеДни = СнятьОтметкиДоби(Менеджер.НедочитанныеДни, День);
			Менеджер.Записать(Истина);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		РазблокироватьУчетнуюЗапись(УчетнаяЗапись, ИдентификаторФормы);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьУчетнуюЗапись(УчетнаяЗапись, ИдентификаторФормы);
	Результат.Выполнено = Истина;
	Возврат Результат;

КонецФункции

// Убирает из ресурса НедочитанныеДни отметки одних суток (чистая функция).
//
// Параметры:
//  Значение - Строка - ресурс НедочитанныеДни.
//  День - Дата - любые время суток снимаемой доби.
//
// Возвращаемое значение:
//  Строка - ресурс без отметок этих суток.
Функция СнятьОтметкиДоби(Значение, День) Экспорт

	Префикс = Формат(НачалоДня(День), "ДФ=yyyyMMdd");
	Остаток = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Значение, Символы.ПС, Ложь) Цикл
		Если Лев(Строка, 8) <> Префикс Тогда
			Остаток.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Остаток, Символы.ПС);

КонецФункции

// Блокировка обмена учетной записи (решение 10 плана 5б, Р-8): ключ записи регистра СМП_СостояниеОбменаСБанком за учетной записью (не ссылка
// на справочник: право на регистр у роли бухгалтера есть, на справочник нет). Без идентификатора формы - на весь запуск конвейера (снимается
// с концом фонового задания); с ним - до явного РазблокироватьУчетнуюЗапись или закрытия формы. Занято - Ложь.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись.
//  ИдентификаторФормы - УникальныйИдентификатор, Неопределено - форма, которой принадлежит блокировка.
//
// Возвращаемое значение:
//  Булево - блокировка взята.
Функция ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись, ИдентификаторФормы = Неопределено) Экспорт

	Ключ = КлючОбмена(УчетнаяЗапись);
	Попытка
		Если ИдентификаторФормы = Неопределено Тогда
			ЗаблокироватьДанныеДляРедактирования(Ключ);
		Иначе
			ЗаблокироватьДанныеДляРедактирования(Ключ, , ИдентификаторФормы);
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Снимает блокировку, взятую формой (ЗаблокироватьУчетнуюЗапись с идентификатором формы): явно, не дожидаясь закрытия формы.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись.
//  ИдентификаторФормы - УникальныйИдентификатор - форма, взявшая блокировку.
Процедура РазблокироватьУчетнуюЗапись(УчетнаяЗапись, ИдентификаторФормы) Экспорт

	Попытка
		РазблокироватьДанныеДляРедактирования(КлючОбмена(УчетнаяЗапись), ИдентификаторФормы);
	Исключение
		// Блокировки уже нет (форма закрыта, сеанс завершен): снимать нечего.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.Регламент.Обмен'; uk = 'СМП.Регламент.Обмен'"), УровеньЖурналаРегистрации.Информация, , , КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Текст отказа формы 6б и команды «Доба довантажена», когда запись занята обменом.
//
// Возвращаемое значение:
//  Строка - текст для человека.
Функция ТекстОбменИдет() Экспорт

	Возврат НСтр("ru = 'По этой учетной записи идет обмен с банком. Повторите позже.'; uk = 'За цим обліковим записом іде обмін з банком. Повторіть пізніше.'");

КонецФункции

// Записывает пропуск запуска: только МоментПропуска; Результат, ТекстОшибки и НедочитанныеДни не трогаются (решение 10 плана 5б).
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись.
//  Момент - Дата - момент пропуска (киевское время).
Процедура ЗаписатьПропуск(УчетнаяЗапись, Момент) Экспорт

	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуЗаписей(УчетнаяЗапись, Неопределено);
		Менеджер = РегистрыСведений.СМП_СостояниеОбменаСБанком.СоздатьМенеджерЗаписи();
		Менеджер.УчетнаяЗапись = УчетнаяЗапись;
		Менеджер.Прочитать();
		Менеджер.УчетнаяЗапись = УчетнаяЗапись;
		Менеджер.МоментПропуска = Момент;
		Менеджер.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Автор документов (D16, Р-3): ответственный записи, иначе пользователь завершения, иначе пусто («укажите ответственного»).
//
// Параметры:
//  Ответственный - СправочникСсылка.Пользователи - реквизит записи.
//  ТекущийПользователь - СправочникСсылка.Пользователи - пользователь сеанса.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - автор или пустая ссылка.
Функция АвторЗапуска(Ответственный, ТекущийПользователь) Экспорт

	Если ЗначениеЗаполнено(Ответственный) Тогда
		Возврат Ответственный;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущийПользователь) И ТекущийПользователь <> Пользователи.СсылкаНеуказанногоПользователя() Тогда
		Возврат ТекущийПользователь;
	КонецЕсли;
	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СекундВСутках()

	Возврат 86400;

КонецФункции

Функция ТекстПропущено()

	Возврат НСтр("ru = 'пропущено: учетная запись занята'; uk = 'пропущено: обліковий запис зайнятий'");

КонецФункции

Процедура ЗаписатьСобытие(Уровень, УчетнаяЗапись, Текст)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.Регламент.Обмен'; uk = 'СМП.Регламент.Обмен'"), Уровень, Метаданные.Справочники.СМП_УчетныеЗаписиБанков, УчетнаяЗапись, Текст);

КонецПроцедуры

Функция КлючОбмена(УчетнаяЗапись)

	Возврат РегистрыСведений.СМП_СостояниеОбменаСБанком.СоздатьКлючЗаписи(Новый Структура("УчетнаяЗапись", УчетнаяЗапись));

КонецФункции

// Момент транспорта (UTC) -> киевское время.
Функция МоментКиев(Транспорт)

	Возврат СМП_КоннекторыБанковОбщее.МоментUnixВКиевскоеВремя(Транспорт.ТекущийМомент() - Дата(1970, 1, 1));

КонецФункции

Функция ПользовательЗапуска(Шов)

	Если Шов <> Неопределено И Шов.Свойство("ТекущийПользователь") Тогда
		Возврат Шов.ТекущийПользователь;
	КонецЕсли;
	Попытка
		Возврат Пользователи.ТекущийПользователь();
	Исключение
		// Внешний пользователь: автором документов он быть не может.
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

КонецФункции

// Курсор счета: ДатаТранзакции регистра СМП_НомерПоследнейТранзакции (D23); нет записи или дата пуста - Неопределено.
Функция КурсорСчета(Счет)

	Менеджер = РегистрыСведений.СМП_НомерПоследнейТранзакции.СоздатьМенеджерЗаписи();
	Менеджер.БанковскийСчет = Счет;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() И ЗначениеЗаполнено(Менеджер.ДатаТранзакции) Тогда
		Возврат НачалоДня(Менеджер.ДатаТранзакции);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Граница чтения для хода курсора (решение 4 плана 5б, а-г); Неопределено - чтение курсор двигать не дает.
Функция ГраницаЧтения(К, Итог)

	Сутки = СекундВСутках();
	Если Итог.ПрочитанныйОтрезок = Неопределено Тогда
		Если Итог.Принята И Итог.ЧтениеПолное Тогда
			Возврат Итог.ГраницаДоверия;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если Не Итог.Принята Тогда
		Возврат Неопределено;
	КонецЕсли;
	// (г) доба сама превышает стену: прочитанное записывается, курсор за суткие, но не за момент чтения (текущие сутки не закончены).
	Если ДобаПонадСтелей(К, Итог) Тогда
		Граница = Итог.КонецПериода;
		Если ЗначениеЗаполнено(Итог.МоментЧтения) Тогда
			Граница = Мин(Граница, Итог.МоментЧтения);
		КонецЕсли;
		Возврат Граница;
	КонецЕсли;
	// Отрезок не покрывает начало первых суток после курсора - разрыв, без движения.
	Если Итог.ПрочитанныйОтрезок.Начало > К + Сутки Тогда
		Возврат Неопределено;
	КонецЕсли;
	// (б) граница доверия отрезка: кандидаты внутри него (неостаточная операция, граница банка) не пропускаются.
	Возврат Мин(Итог.ПрочитанныйОтрезок.Конец, Итог.ПрочитанныйОтрезок.ГраницаДоверия);

КонецФункции

// Стена конектора достигнута на чтении ровно суток после курсора (доба сама превышает стену, решение 4 г).
Функция ДобаПонадСтелей(К, Итог)

	Сутки = СекундВСутках();
	Возврат Итог.ПрочитанныйОтрезок <> Неопределено И Итог.Принята
		И НачалоДня(Итог.НачалоПериода) = К + Сутки И НачалоДня(Итог.КонецПериода) = К + Сутки;

КонецФункции

// Последние полные сутки до границы М: КонецДня(D) <= М. Неопределено, если полных суток до границы нет (год 1).
Функция ПолнаяДоба(М)

	Сутки = СекундВСутках();
	Если М < Дата(1, 1, 3) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Доба = НачалоДня(М);
	Если КонецДня(Доба) > М Тогда
		Доба = Доба - Сутки;
	КонецЕсли;
	Возврат Доба;

КонецФункции

// Отметки постоянных отказов (Р-9): отклоненные записью рядки и рядки, отброшенные границей контракта (D28) с датой. Без реквизитов контрагента.
Процедура ОтметкиОтказов(Итог, Отметки)

	Образец = НСтр("ru = 'операцию %1 не записано: %2; загрузите файлом или формой'; uk = 'операцію %1 не записано: %2; завантажте файлом або формою'");
	Для Каждого Отказ Из Итог.ПостоянныеОтказы Цикл
		Отметки.Добавить(Новый Структура("Дата, Текст", НачалоДня(Отказ.Дата), СтрШаблон(Образец, ОписаниеОперации(Отказ), Отказ.Причина)));
	КонецЦикла;
	Для Каждого Строка Из Итог.НевалидныеСтроки Цикл
		Если ЗначениеЗаполнено(Строка.Дата) Тогда
			Отметки.Добавить(Новый Структура("Дата, Текст", НачалоДня(Строка.Дата), СтрШаблон(Образец, ОписаниеОперации(Строка),
				СтрШаблон(НСтр("ru = 'строка выписки не прошла проверку (поля: %1)'; uk = 'рядок виписки не пройшов перевірку (поля: %1)'"), Строка.Причина))));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеОперации(Операция)

	Возврат СтрШаблон("%1, %2, %3", Формат(Операция.Дата, "ДФ=dd.MM.yyyy"), Формат(Операция.Сумма, "ЧДЦ=2; ЧГ="), Операция.Направление);

КонецФункции

Процедура ДобавитьТекст(Тексты, Текст)

	Если Не ПустаяСтрока(Текст) И Тексты.Найти(Текст) = Неопределено Тогда
		Тексты.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Один проход чтения и записи по периоду: точка входа 6б с ВернутьПлан, затем ЗаписатьПланРегламента (или шов проверок).
Функция ПроходЧтения(УчетнаяЗапись, Счет, Начало, Конец, Момент, Транспорт, Автор, Шов)

	Проход = НовыйПроход(Начало, Конец);
	Проход.МоментЧтения = Момент;

	Вход = Обработки.СМП_ОбменСБанком.НовыйВходЧтения();
	Вход.БанковскийСчет = Счет;
	Вход.НачалоПериода = Начало;
	Вход.КонецПериода = Конец;
	Вход.ИдентификаторФормы = Новый УникальныйИдентификатор;
	Вход.ВернутьПлан = Истина;
	Чтение = Обработки.СМП_ОбменСБанком.ПрочитатьИРаспознатьВыпискуТранспортом(Вход, Транспорт);

	Проход.Принята = Чтение.Принята;
	Проход.ЧтениеПолное = Чтение.ЧтениеПолное;
	Проход.КлассОтказа = Чтение.КлассОтказа;
	Проход.ГраницаДоверия = Чтение.ГраницаДоверия;
	Проход.ПрочитанныйОтрезок = Чтение.ПрочитанныйОтрезок;
	Проход.Ошибок = Чтение.КоличествоОшибок;
	Проход.НевалидныеСтроки = Чтение.НевалидныеСтроки;

	// Причины - только тексты точки чтения (она их очистила); стена конектора причиной не считается (ее покрывает отметка доби).
	Если Не Чтение.Принята Тогда
		Для Каждого Текст Из Чтение.ТекстыОтказа Цикл
			ДобавитьТекст(Проход.ТекстыПричин, Текст);
		КонецЦикла;
	ИначеЕсли Чтение.ПрочитанныйОтрезок = Неопределено И Чтение.КлассОтказа <> СМП_ВыпискаБанка.КлассОтказаНет() Тогда
		Для Каждого Сообщение Из Чтение.Диагностика Цикл
			ДобавитьТекст(Проход.ТекстыПричин, Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;

	Если Не Чтение.Принята Тогда
		Возврат Проход;
	КонецЕсли;

	ИтогЗаписи = Неопределено;
	Если Шов <> Неопределено И Шов.Свойство("ИтогЗаписи") Тогда
		ИтогЗаписи = Шов.ИтогЗаписи;
	ИначеЕсли Чтение.План <> Неопределено И Чтение.План.Операции.Количество() > 0 Тогда
		ИтогЗаписи = Обработки.СМП_ОбменСБанком.ЗаписатьПланРегламента(Чтение.План, УчетнаяЗапись, Автор);
	КонецЕсли;
	Если ИтогЗаписи <> Неопределено Тогда
		Проход.Создано = ИтогЗаписи.Создано;
		Проход.НеПроведено = ИтогЗаписи.НеПроведено;
		Проход.ГраницаЗаписи = ИтогЗаписи.ГраницаЗаписи;
		Проход.ПостоянныеОтказы = ИтогЗаписи.ПостоянныеОтказы;
		Если Не ИтогЗаписи.Выполнено Тогда
			Проход.ЗаписьСбой = Истина;
			ДобавитьТекст(Проход.ТекстыПричин, ИтогЗаписи.ТекстОтказа);
		КонецЕсли;
	КонецЕсли;

	Возврат Проход;

КонецФункции

// Сводит два прохода запуска (первый - перечитанное целиком, второй - одна доба после курсора): чтение берется из второго, счетчики и отказы складываются.
Функция ОбъединитьПроходы(Первый, Второй)

	Второй.Создано = Второй.Создано + Первый.Создано;
	Второй.НеПроведено = Второй.НеПроведено + Первый.НеПроведено;
	Второй.ЗаписьСбой = Второй.ЗаписьСбой Или Первый.ЗаписьСбой;
	Если Первый.ГраницаЗаписи <> Неопределено Тогда
		Второй.ГраницаЗаписи = ?(Второй.ГраницаЗаписи = Неопределено, Первый.ГраницаЗаписи, Мин(Второй.ГраницаЗаписи, Первый.ГраницаЗаписи));
	КонецЕсли;
	Для Каждого Отказ Из Первый.ПостоянныеОтказы Цикл
		Второй.ПостоянныеОтказы.Добавить(Отказ);
	КонецЦикла;
	Для Каждого Строка Из Первый.НевалидныеСтроки Цикл
		Второй.НевалидныеСтроки.Добавить(Строка);
	КонецЦикла;
	Для Каждого Текст Из Первый.ТекстыПричин Цикл
		ДобавитьТекст(Второй.ТекстыПричин, Текст);
	КонецЦикла;
	Возврат Второй;

КонецФункции

// Итог запуска (решение 8 плана 5б): результат состояния, признак исключения «Повторить» и очищенные причины.
Функция ОценкаЗапуска(Проход, Решение)

	Результаты = Перечисления.СМП_РезультатыОбменаСБанком;
	ДействиеЧеловека = Ложь;
	Ошибки = Ложь;
	Повторить = Ложь;
	Причины = Новый Массив;
	Для Каждого Текст Из Проход.ТекстыПричин Цикл
		ДобавитьТекст(Причины, Текст);
	КонецЦикла;

	Стена = Проход.ПрочитанныйОтрезок <> Неопределено;
	Если Не Проход.Принята Тогда
		// Отклоненный конверт (ошибки проверки) - «ошибки»; отказ до чтения (запись, счет, настройки) - действие человека.
		Если Проход.Ошибок > 0 Тогда
			Ошибки = Истина;
		Иначе
			ДействиеЧеловека = Истина;
		КонецЕсли;
	ИначеЕсли Не Стена Тогда
		Если Проход.КлассОтказа = СМП_ВыпискаБанка.КлассОтказаПовторить() Тогда
			Повторить = Истина;
			Ошибки = Истина;
		ИначеЕсли Проход.КлассОтказа = СМП_ВыпискаБанка.КлассОтказаДействиеЧеловека() Тогда
			ДействиеЧеловека = Истина;
		КонецЕсли;
	КонецЕсли;

	Если Проход.ЗаписьСбой Или Проход.ГраницаЗаписи <> Неопределено Тогда
		ДействиеЧеловека = Истина;
		Если Не Проход.ЗаписьСбой Тогда
			ДобавитьТекст(Причины, СтрШаблон(НСтр("ru = 'часть операций не записана (временный сбой записи), начиная с %1'; uk = 'частину операцій не записано (тимчасовий збій запису), починаючи з %1'"),
				Формат(Проход.ГраницаЗаписи, "ДФ=dd.MM.yyyy")));
		КонецЕсли;
	КонецЕсли;
	Если Проход.ПостоянныеОтказы.Количество() > 0 Или Проход.НевалидныеСтроки.Количество() > 0 Тогда
		ДействиеЧеловека = Истина;
	КонецЕсли;
	Для Каждого Строка Из Проход.НевалидныеСтроки Цикл
		Если Не ЗначениеЗаполнено(Строка.Дата) Тогда
			ДобавитьТекст(Причины, НСтр("ru = 'строка выписки без даты отброшена: курсор не двигается'; uk = 'рядок виписки без дати відкинуто: курсор не рухається'"));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Отметка Из Решение.Отметки Цикл
		ДобавитьТекст(Причины, Отметка.Текст);
	КонецЦикла;

	Если Не Ошибки И Проход.НеПроведено > 0 Тогда
		Ошибки = Истина;
	КонецЕсли;

	Результат = Новый Структура("Результат, Повторить, Причины", Результаты.Успех, Повторить, Причины);
	Если ДействиеЧеловека Тогда
		Результат.Результат = Результаты.ДействиеЧеловека;
	ИначеЕсли Ошибки Тогда
		Результат.Результат = Результаты.Ошибки;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отказ до чтения: «действие человека» с текстом отказа, состояние записывается, ничего не читается и не пишется в базу, кроме состояния.
Функция ЗавершитьБезЧтения(УчетнаяЗапись, Счет, Итог, Момент, НачалоРегламента, ТекстОтказа)

	Итог.Результат = Перечисления.СМП_РезультатыОбменаСБанком.ДействиеЧеловека;
	Причины = Новый Массив;
	Причины.Добавить(ТекстОтказа);
	Итог.ТекстОшибки = ТекстСостояния(Итог.Результат, 0, 0, Причины);
	СохранитьЗапуск(УчетнаяЗапись, Счет, Новый Структура("Курсор, Результат, Создано, НеПроведено, ТекстОшибки, НачалоРегламента, Отметки, Момент",
		Неопределено, Итог.Результат, 0, 0, Итог.ТекстОшибки, НачалоРегламента, Новый Массив, Момент));
	ЗаписатьСобытие(УровеньЖурналаРегистрации.Предупреждение, УчетнаяЗапись, Итог.ТекстОшибки);
	Возврат Итог;

КонецФункции

Процедура УстановитьБлокировкуЗаписей(УчетнаяЗапись, Счет)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.СМП_СостояниеОбменаСБанком");
	Элемент.УстановитьЗначение("УчетнаяЗапись", УчетнаяЗапись);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Если Счет <> Неопределено Тогда
		Элемент = Блокировка.Добавить("РегистрСведений.СМП_НомерПоследнейТранзакции");
		Элемент.УстановитьЗначение("БанковскийСчет", Счет);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЕсли;
	Блокировка.Заблокировать();

КонецПроцедуры

// Курсор, состояние и отметки - одной короткой транзакцией под блокировкой записи (перечитать -> изменить -> записать); курсор Макс(сохраненный, новый).
Процедура СохранитьЗапуск(УчетнаяЗапись, Счет, Данные)

	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуЗаписей(УчетнаяЗапись, Счет);

		Если Данные.Курсор <> Неопределено Тогда
			МенеджерКурсора = РегистрыСведений.СМП_НомерПоследнейТранзакции.СоздатьМенеджерЗаписи();
			МенеджерКурсора.БанковскийСчет = Счет;
			МенеджерКурсора.Прочитать();
			Сохраненный = Дата(1, 1, 1);
			Если МенеджерКурсора.Выбран() И ЗначениеЗаполнено(МенеджерКурсора.ДатаТранзакции) Тогда
				Сохраненный = МенеджерКурсора.ДатаТранзакции;
			КонецЕсли;
			Если Данные.Курсор > Сохраненный Тогда
				МенеджерКурсора.БанковскийСчет = Счет;
				МенеджерКурсора.ДатаТранзакции = Данные.Курсор;
				МенеджерКурсора.Записать(Истина);
			КонецЕсли;
		КонецЕсли;

		Менеджер = РегистрыСведений.СМП_СостояниеОбменаСБанком.СоздатьМенеджерЗаписи();
		Менеджер.УчетнаяЗапись = УчетнаяЗапись;
		Менеджер.Прочитать();
		Менеджер.УчетнаяЗапись = УчетнаяЗапись;
		Менеджер.Момент = Данные.Момент;
		Менеджер.Результат = Данные.Результат;
		Менеджер.СозданоДокументов = Данные.Создано;
		Менеджер.НеПроведено = Данные.НеПроведено;
		Менеджер.ТекстОшибки = Лев(Данные.ТекстОшибки, 1024);
		Если Данные.НачалоРегламента <> Неопределено И Не ЗначениеЗаполнено(Менеджер.НачалоРегламента) Тогда
			Менеджер.НачалоРегламента = Данные.НачалоРегламента;
		КонецЕсли;
		Менеджер.НедочитанныеДни = ОбъединитьОтметки(Менеджер.НедочитанныеДни, Данные.Отметки);
		Менеджер.Записать(Истина);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Добавляет отметки к ресурсу НедочитанныеДни: строка «ггггммдд текст», без повторов, по порядку суток.
Функция ОбъединитьОтметки(Значение, Отметки)

	Строки = СтрРазделить(Значение, Символы.ПС, Ложь);
	Для Каждого Отметка Из Отметки Цикл
		Строка = Формат(НачалоДня(Отметка.Дата), "ДФ=yyyyMMdd") + " " + СтрЗаменить(Отметка.Текст, Символы.ПС, " ");
		Если Строки.Найти(Строка) = Неопределено Тогда
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС);

КонецФункции

#КонецОбласти
