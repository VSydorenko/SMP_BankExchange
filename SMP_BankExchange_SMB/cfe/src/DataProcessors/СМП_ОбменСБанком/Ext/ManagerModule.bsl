// Серверный фасад форм интерактива обмена с банком.
// Логика загрузки выписки живёт в общих модулях СМП_ЧитателиВыписок, СМП_РаспознаваниеОпераций,
// СМП_ЗаписьДокументовБанка; здесь только склейка и подготовка данных для форм (D4, D33).

#Область ПрограммныйИнтерфейс

// Учетные записи банка для банковского счета организации (не помеченные на удаление).
//
// Правило выбора (П-Е): ровно одна - она; несколько - выбирает человек в форме; ни одной - пусто.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.СМП_УчетныеЗаписиБанков - учетные записи счета, по наименованию.
Функция УчетныеЗаписиДляСчета(БанковскийСчет) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СМП_УчетныеЗаписиБанков КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.БанковскийСчет = &БанковскийСчет
		|	И НЕ УчетныеЗаписи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетныеЗаписи.Наименование");
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Результат;

КонецФункции

// Данные формы загрузки для выбранного счета: учетные записи, источник формата, варианты формата.
// Один серверный вызов на смену счета или учетной записи.
//
// Источник формата (2а): подключаемая обработка учетной записи -> строки реестра с МФО банка счета
// (одна - сама, несколько - выбор среди них) -> «другие форматы». Реквизита «читатель» в учетной
// записи пока нет (этап 5б): ветки для него нет. Выбор человека в учетную запись не пишется (D4, D26).
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - выбранная человеком; может быть пустой или
//    не относиться к счету (тогда выбор сбрасывается).
//
// Возвращаемое значение:
//  Структура - данные для показа:
//   * УчетныеЗаписи - Массив из Структура - Значение (ссылка), Представление.
//   * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - итог: выбранная, единственная или пустая.
//   * ВнешняяОбработка - Булево - формат задает подключаемая обработка учетной записи.
//   * ПредставлениеОбработки - Строка - наименование обработки для показа.
//   * МФОБанка - Строка - Банк.Код банка счета.
//   * Форматы - Массив из Структура - Идентификатор, Представление (для списка), Подсказка, Свой (Булево),
//     Предупреждение (Строка, пусто - нет); свои строки (с МФО банка счета) идут первыми.
//   * ИдентификаторПоУмолчанию - Строка - единственная своя строка реестра; иначе пусто.
Функция ДанныеФормы(БанковскийСчет, УчетнаяЗапись) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("УчетныеЗаписи", Новый Массив);
	Результат.Вставить("УчетнаяЗапись", Справочники.СМП_УчетныеЗаписиБанков.ПустаяСсылка());
	Результат.Вставить("ВнешняяОбработка", Ложь);
	Результат.Вставить("ПредставлениеОбработки", "");
	Результат.Вставить("МФОБанка", "");
	Результат.Вставить("Форматы", Новый Массив);
	Результат.Вставить("ИдентификаторПоУмолчанию", "");

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;

	УчетныеЗаписи = УчетныеЗаписиДляСчета(БанковскийСчет);
	Для Каждого Ссылка Из УчетныеЗаписи Цикл
		Результат.УчетныеЗаписи.Добавить(Новый Структура("Значение, Представление", Ссылка, Строка(Ссылка)));
	КонецЦикла;

	Если ЗначениеЗаполнено(УчетнаяЗапись) И УчетныеЗаписи.Найти(УчетнаяЗапись) <> Неопределено Тогда
		Результат.УчетнаяЗапись = УчетнаяЗапись;
	ИначеЕсли УчетныеЗаписи.Количество() = 1 Тогда
		Результат.УчетнаяЗапись = УчетныеЗаписи[0];
	КонецЕсли;

	Обработка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	Если ЗначениеЗаполнено(Результат.УчетнаяЗапись) Тогда
		Обработка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.УчетнаяЗапись, "ПодключаемаяОбработка");
	КонецЕсли;
	Если ЗначениеЗаполнено(Обработка) Тогда
		Результат.ВнешняяОбработка = Истина;
		Результат.ПредставлениеОбработки = Строка(Обработка);
		Возврат Результат;
	КонецЕсли;

	МФО = МФОБанкаСчета(БанковскийСчет);
	Результат.МФОБанка = МФО;

	Реестр = СМП_ЧитателиВыписок.РеестрЧитателей();
	Свои = Новый Массив;
	Другие = Новый Массив;
	Для Каждого СтрокаРеестра Из Реестр Цикл
		Сведения = Новый Структура;
		Сведения.Вставить("Идентификатор", СтрокаРеестра.Идентификатор);
		Сведения.Вставить("Представление", СтрокаРеестра.Представление);
		Сведения.Вставить("Подсказка", ПодсказкаТогоЖеФормата(Реестр, СтрокаРеестра));
		Сведения.Вставить("Свой", СтрокаСодержитМФО(СтрокаРеестра, МФО));
		Сведения.Вставить("Предупреждение", ПредупреждениеДляСтроки(СтрокаРеестра, МФО));
		Если Сведения.Свой Тогда
			Свои.Добавить(Сведения);
		Иначе
			Сведения.Представление = СтрШаблон(НСтр("ru = '%1 (другие форматы)'; uk = '%1 (інші формати)'"),
				Сведения.Представление);
			Другие.Добавить(Сведения);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сведения Из Свои Цикл
		Результат.Форматы.Добавить(Сведения);
	КонецЦикла;
	Для Каждого Сведения Из Другие Цикл
		Результат.Форматы.Добавить(Сведения);
	КонецЦикла;
	Если Свои.Количество() = 1 Тогда
		Результат.ИдентификаторПоУмолчанию = Свои[0].Идентификатор;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Предупреждение о несовпадении банка (2в): МФО банка счета не входит в коды банка выбранной строки реестра.
// Читание не запрещает: предупреждение показывается человеку до чтения. МФО берется как Банк.Код банка
// счета - так его берет и распознавание, IBAN не разбирается.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//  ИдентификаторСтрокиРеестра - Строка - Идентификатор строки реестра читателей.
//
// Возвращаемое значение:
//  Строка - текст для человека; пустая строка, если предупреждения нет (или строки нет в реестре).
Функция ПредупреждениеПоМФО(БанковскийСчет, ИдентификаторСтрокиРеестра) Экспорт

	Для Каждого СтрокаРеестра Из СМП_ЧитателиВыписок.РеестрЧитателей() Цикл
		Если СтрокаРеестра.Идентификатор = ИдентификаторСтрокиРеестра Тогда
			Возврат ПредупреждениеДляСтроки(СтрокаРеестра, МФОБанкаСчета(БанковскийСчет));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Вход тяжелой операции чтения и распознавания (ПрочитатьИРаспознатьВыписку).
//
// Возвращаемое значение:
//  Структура - вход:
//   * АдресФайла - Строка - адрес файла выписки во временном хранилище.
//   * ИдентификаторСтрокиРеестра - Строка - Идентификатор строки реестра читателей; пусто для внешней обработки.
//   * ВнешняяОбработка - Булево - читает подключаемая обработка учетной записи.
//   * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - может быть пустой.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - выбранный счет организации.
//   * ИдентификаторФормы - УникальныйИдентификатор - форма, к чьему хранилищу привязан план.
Функция НовыйВходЧтения() Экспорт

	Вход = Новый Структура;
	Вход.Вставить("АдресФайла", "");
	Вход.Вставить("ИдентификаторСтрокиРеестра", "");
	Вход.Вставить("ВнешняяОбработка", Ложь);
	Вход.Вставить("УчетнаяЗапись", Справочники.СМП_УчетныеЗаписиБанков.ПустаяСсылка());
	Вход.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Вход.Вставить("ИдентификаторФормы", Новый УникальныйИдентификатор);
	Возврат Вход;

КонецФункции

// Читает файл выписки и распознает операции: одна функция длительной операции (ДлительныеОперации.ВыполнитьФункцию
// из формы). В базу ничего не пишет, транзакций не открывает; отмена задания безопасна (П-Г).
//
// Параметры:
//  Вход - Структура - см. НовыйВходЧтения.
//
// Возвращаемое значение:
//  Структура - результат для формы (тексты - для человека, без внутренних имен модулей):
//   * Принята - Булево - файл прочитан и принят; при Ложь плана нет.
//   * АдресПлана - Строка - адрес плана загрузки во временном хранилище формы; пусто, если плана нет.
//   * КоличествоОпераций - Число - строк плана.
//   * ТекстыОтказа - Массив из Строка - причины отказа (уровень «Ошибка»), пусто, если файл принят.
//   * ПохожиеНа - Массив из Строка - представления строк реестра, чей формат узнал файл (при отказе).
//   * Диагностика - Массив из Структура - Уровень, ПорядковыйНомер, Текст: сообщения читателя и конверта
//     (в том числе чужие счета файла - предупреждения).
//   * КоличествоОшибок - Число - сообщений диагностики уровня «Ошибка».
//   * КоличествоПредупреждений - Число - сообщений диагностики уровня «Предупреждение».
//   * ЕстьНевалидныеСтроки - Булево - часть строк отброшена как невалидная.
Функция ПрочитатьИРаспознатьВыписку(Знач Вход) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("АдресПлана", "");
	Результат.Вставить("КоличествоОпераций", 0);
	Результат.Вставить("ТекстыОтказа", Новый Массив);
	Результат.Вставить("ПохожиеНа", Новый Массив);
	Результат.Вставить("Диагностика", Новый Массив);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("КоличествоПредупреждений", 0);
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);

	// Контексты - до чтения: счет не организации - отказ до чтения (действие человека), а не исключение Распознать.
	Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(Вход.УчетнаяЗапись, Вход.БанковскийСчет);
	Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
		Результат.ТекстыОтказа.Добавить(Контексты.ТекстОтказа);
		Возврат Результат;
	КонецЕсли;
	Для Каждого Текст Из Контексты.Предупреждения Цикл
		Результат.Диагностика.Добавить(Новый Структура("Уровень, ПорядковыйНомер, Текст",
			СМП_ВыпискаБанка.УровеньПредупреждение(), 0, Текст));
		Результат.КоличествоПредупреждений = Результат.КоличествоПредупреждений + 1;
	КонецЦикла;

	Попытка
		РезультатЧтения = ПрочитатьФайлВыписки(Вход);
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Чтение'; uk = 'СМП.ЗагрузкаВыписки.Чтение'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Результат.ТекстыОтказа.Добавить(НСтр("ru = 'Не удалось прочитать файл: внутренняя ошибка. Подробности записаны в журнал регистрации.';
			|uk = 'Не вдалося прочитати файл: внутрішня помилка. Подробиці записано в журнал реєстрації.'"));
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(РезультатЧтения) = Тип("Строка") Тогда
		// Отказ до чтения (не хватает входа): готовый текст.
		Результат.ТекстыОтказа.Добавить(РезультатЧтения);
		Возврат Результат;
	КонецЕсли;

	Результат.Принята = РезультатЧтения.Принята;
	Результат.ЕстьНевалидныеСтроки = РезультатЧтения.ЕстьНевалидныеСтроки;

	УровеньОшибка = СМП_ВыпискаБанка.УровеньОшибка();
	УровеньПредупреждение = СМП_ВыпискаБанка.УровеньПредупреждение();
	Для Каждого Сообщение Из РезультатЧтения.Диагностика Цикл
		Результат.Диагностика.Добавить(Новый Структура("Уровень, ПорядковыйНомер, Текст",
			Сообщение.Уровень, Сообщение.ПорядковыйНомер, Сообщение.Текст));
		Если Сообщение.Уровень = УровеньОшибка Тогда
			Результат.КоличествоОшибок = Результат.КоличествоОшибок + 1;
			Если Не РезультатЧтения.Принята Тогда
				Результат.ТекстыОтказа.Добавить(Сообщение.Текст);
			КонецЕсли;
		ИначеЕсли Сообщение.Уровень = УровеньПредупреждение Тогда
			Результат.КоличествоПредупреждений = Результат.КоличествоПредупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	Если Не РезультатЧтения.Принята Тогда
		Если Результат.ТекстыОтказа.Количество() = 0 Тогда
			Результат.ТекстыОтказа.Добавить(НСтр("ru = 'Файл не принят читателем без указания причины.';
				|uk = 'Файл не прийнято читачем без зазначення причини.'"));
		КонецЕсли;
		Результат.ПохожиеНа = ПредставленияСтрокРеестра(РезультатЧтения.ПохожиеСтрокиРеестра);
		Возврат Результат;
	КонецЕсли;

	// Распознавание: контексты из одной функции с регламентом 5б (счет и организация - факты выбранного счета).
	КонтекстРаспознавания = Контексты.КонтекстРаспознавания;

	Попытка
		План = СМП_РаспознаваниеОпераций.Распознать(РезультатЧтения.Операции, КонтекстРаспознавания);
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Распознавание'; uk = 'СМП.ЗагрузкаВыписки.Распознавання'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Результат.Принята = Ложь;
		// Текст исключения платформы человеку не показывается (может цитировать данные): только журнал регистрации.
		Результат.ТекстыОтказа.Добавить(
			НСтр("ru = 'Файл прочитан, но операции не удалось распознать: внутренняя ошибка. Подробности записаны в журнал регистрации.';
				|uk = 'Файл прочитано, але операції не вдалося розпізнати: внутрішня помилка. Подробиці записано в журнал реєстрації.'"));
		Возврат Результат;
	КонецПопытки;

	Результат.КоличествоОпераций = План.Операции.Количество();
	Результат.АдресПлана = ПоместитьВоВременноеХранилище(План, Вход.ИдентификаторФормы);
	Возврат Результат;

КонецФункции

// Проекция плана загрузки для таблицы формы: плоская таблица примитивных и ссылочных типов
// (без СырыеДанные и вложенных структур) и остаток на счете. Один серверный вызов на весь план;
// запросов на строку нет. План не изменяется, в базу ничего не пишется.
//
// Ключ строки - ПорядковыйНомер операции (D28): таблица формы может сортироваться и отбираться,
// номер строки таблицы ключом быть не может.
//
// Отметки (D5): «Загружать» - Истина для строк без найденного документа (в том числе со
// замечанием «Ошибка» и без ВидДокумента: причина видна в строке, D3); у строк с найденным
// документом «Загружать» = Ложь и недоступна. «Перезаписать» - Ложь; доступна только для
// строк с найденным документом, не помеченным на удаление.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки (СМП_РаспознаваниеОпераций.НовыйПланЗагрузки) во временном хранилище.
//
// Возвращаемое значение:
//  Структура - проекция плана:
//   * Найден - Булево - план получен; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека, если плана нет.
//   * Строки - ТаблицаЗначений - строка на операцию:
//    ** Загружать - Булево - отметка «Загружать».
//    ** ЗагружатьДоступно - Булево - отметку можно менять (нет найденного документа).
//    ** Перезаписать - Булево - отметка «Перезаписать».
//    ** ПерезаписатьДоступно - Булево - отметку можно менять (есть найденный документ, не помеченный на удаление).
//    ** ПорядковыйНомер - Число - ключ строки.
//    ** НомерДокумента - Строка - номер документа банка.
//    ** ДатаДокумента - Дата - дата документа банка.
//    ** СуммаПоступление - Число - сумма, если направление «Поступило»; иначе 0.
//    ** СуммаСписание - Число - сумма, если направление «Списано»; иначе 0.
//    ** КонтрагентНаименование - Строка - наименование контрагента из банка.
//    ** Контрагент - СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники - определенный контрагент.
//    ** КонтрагентПредставление - Строка - представление определенного контрагента, а если не определен -
//       наименование из банка.
//    ** НазначениеПлатежа - Строка - назначение платежа.
//    ** ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета -
//       вид операции.
//    ** СтатьяДДС - СправочникСсылка.СтатьиДвиженияДенежныхСредств - статья.
//    ** Корреспонденция - ПланСчетовСсылка.Управленческий - корреспонденция.
//    ** Договор - СправочникСсылка.ДоговорыКонтрагентов - договор.
//    ** СчетКонтрагента - СправочникСсылка.БанковскиеСчета - банковский счет контрагента.
//    ** ПлатежноеПоручение - ДокументСсылка.ПлатежноеПоручение - платежное поручение.
//    ** Основа - Строка - представление ДокументПоНомеру (заказ, счет на оплату, документ расчетов).
//    ** ЗагруженныйДокумент - ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета - найденный документ.
//    ** ЗагруженныйПомеченНаУдаление - Булево - найденный документ помечен на удаление.
//    ** ВерсияДокумента - Строка - ВерсияДанных найденного документа (только показ и передача дальше).
//    ** ПроверьтеОперацию - Булево - ни один источник вида операции не сработал (D24).
//    ** СпособЗачета - ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей - способ зачета, выбранный человеком; пусто - по правилу D34.
//    ** ОсноваДоступна - Булево - основу строки можно выбирать (способ зачета не «Авто»; при «Авто» форма вендора выбор основы блокирует).
//    ** УровеньЗамечаний - Строка - высший уровень замечаний строки («Ошибка», «Предупреждение») или пусто.
//    ** ЕстьОшибка - Булево - у строки есть замечание «Ошибка».
//    ** ЕстьПредупреждение - Булево - у строки есть замечание «Предупреждение».
//    ** КоличествоЗамечаний - Число - число замечаний строки.
//    ** СтрокаНеЗаписывается - Булево - ВидДокумента пуст: запись такой строки закончится «Ошибкой».
//   * ЕстьОстаток - Булево - остаток на счете получен.
//   * ОстатокНаСчете - Число - остаток на счете в учете (вендорская функция, на текущий момент).
Функция ПроекцияПлана(АдресПлана) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Строки", НоваяТаблицаПроекции());
	Результат.Вставить("ЕстьОстаток", Ложь);
	Результат.Вставить("ОстатокНаСчете", 0);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'План загрузки больше не доступен на сервере. Прочитайте файл ещё раз.';
			|uk = 'План завантаження більше не доступний на сервері. Прочитайте файл ще раз.'");
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	Замечания = ЗамечанияПоСтрокам(План.Замечания);
	ДанныеДокументов = ДанныеНайденныхДокументов(План.Операции);

	Для Каждого СтрокаПлана Из План.Операции Цикл
		СтрокаПроекции = Результат.Строки.Добавить();
		ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, Замечания.Получить(СтрокаПлана.ПорядковыйНомер), ДанныеДокументов);
	КонецЦикла;

	ДанныеОстатка = ОстатокНаСчетеВУчете(План.Операции);
	Результат.ЕстьОстаток = ДанныеОстатка.ЕстьОстаток;
	Результат.ОстатокНаСчете = ДанныеОстатка.Остаток;

	Возврат Результат;

КонецФункции

// Режим правки плана: решения применяются только к строкам с переданными ключами.
//
// Возвращаемое значение:
//  Строка - "ЭтиСтроки".
Функция РежимЭтиСтроки() Экспорт

	Возврат "ЭтиСтроки";

КонецФункции

// Режим правки плана: решения применяются к строкам с переданными ключами и ко всем остальным строкам с тем же кодом И тем же
// номером счета контрагента из банка (D10). Множество определяет сервер, а не форма (D4). Строки с найденным документом в множество
// не попадают; строка без кода и без номера счета не имеет «таких же» и правится одна.
//
// Возвращаемое значение:
//  Строка - "ВсеСТемЖеКодомИСчетом".
Функция РежимВсеСТемЖеКодомИСчетом() Экспорт

	Возврат "ВсеСТемЖеКодомИСчетом";

КонецФункции

// Правка плана решением человека (П-Г плана этапа 6): применяет решения к строкам плана функцией распознавания и возвращает дельту -
// проекцию только измененных строк. План остается во временном хранилище по тому же адресу (заменяется на месте); форма не передает
// таблицу туда-обратно. Один вызов на действие человека, число вызовов от числа строк не зависит. В базу ничего не пишет.
//
// Контекст распознавания собирается из тех же источников, что и при чтении (СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи): в плане
// его нет, поэтому форма передает учетную запись и банковский счет, с которыми прочитала файл.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Ключи - Массив из Число - ПорядковыйНомер строк, к которым относится правка.
//  Режим - Строка - см. РежимЭтиСтроки, РежимВсеСТемЖеКодомИСчетом.
//  Решения - Структура - решения человека, см. СМП_РаспознаваниеОпераций.ПрименитьРешенияЧеловека (имя решения - значение).
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - учетная запись, с которой читали файл; может быть пустой.
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - банковский счет организации, выбранный человеком.
//
// Возвращаемое значение:
//  Структура - дельта правки:
//   * Найден - Булево - план получен; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * Применено - Булево - решения применены хотя бы к одной строке (план в хранилище обновлен).
//   * ТекстОтказа - Строка - текст для человека, если плана нет или по счету работать нельзя.
//   * Строки - ТаблицаЗначений - проекция измененных строк, колонки и смысл - как у ПроекцияПлана.Строки (по ПорядковыйНомер форма
//     обновляет свою таблицу); включает строки, затронутые режимом «для всех».
//   * Отказы - Массив из Структура - строки, к которым решение не применено: ПорядковыйНомер, Текст.
Функция ПрименитьРешенияЧеловека(АдресПлана, Ключи, Режим, Решения, УчетнаяЗапись, БанковскийСчет) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Применено", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Строки", НоваяТаблицаПроекции());
	Результат.Вставить("Отказы", Новый Массив);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'План загрузки больше не доступен на сервере. Прочитайте файл ещё раз.';
			|uk = 'План завантаження більше не доступний на сервері. Прочитайте файл ще раз.'");
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(УчетнаяЗапись, БанковскийСчет);
	Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
		Результат.ТекстОтказа = Контексты.ТекстОтказа;
		Возврат Результат;
	КонецЕсли;

	КлючиПрименения = Ключи;
	Если Режим = РежимВсеСТемЖеКодомИСчетом() Тогда
		КлючиПрименения = КлючиСТемЖеКодомИСчетом(План, Ключи);
	КонецЕсли;

	Применение = СМП_РаспознаваниеОпераций.ПрименитьРешенияЧеловека(План, КлючиПрименения, Решения, Контексты.КонтекстРаспознавания);
	Результат.Отказы = Применение.Отказы;
	Если Применение.Применено.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// Тот же адрес: форма держит один адрес плана на все время работы с файлом.
	ПоместитьВоВременноеХранилище(План, АдресПлана);

	Замечания = ЗамечанияПоСтрокам(План.Замечания);
	Для Каждого Ключ Из Применение.Применено Цикл
		СтрокаПлана = План.Операции.Найти(Ключ, "ПорядковыйНомер");
		СтрокаПроекции = Результат.Строки.Добавить();
		// Найденных документов среди измененных строк нет (функция распознавания такие строки отклоняет).
		ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, Замечания.Получить(Ключ), Новый Соответствие);
	КонецЦикла;
	Результат.Применено = Истина;

	Возврат Результат;

КонецФункции

// Данные карточки строки плана: факты банка, решения распознавания с источниками, замечания строки.
// Один серверный вызов на открытие карточки. План не изменяется.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//
// Возвращаемое значение:
//  Структура - данные карточки (значения - представления для показа, без внутренних литералов):
//   * Найдена - Булево - строка найдена; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека, если строки нет.
//   * Заголовок - Строка - заголовок карточки.
//   * Факты - ТаблицаЗначений - факты банка, все колонки конверта кроме сырых данных:
//    ** Заголовок - Строка - название колонки.
//    ** Значение - Строка - значение.
//   * СырыеДанные - Строка - исходные данные операции как в источнике.
//   * Решения - ТаблицаЗначений - решения распознавания:
//    ** Заголовок - Строка - название колонки плана.
//    ** Значение - Строка - значение.
//    ** Источник - Строка - источник решения или действие записи; пусто, если у колонки их нет.
//   * Замечания - ТаблицаЗначений - замечания строки:
//    ** Поле - Строка - название поля плана или пусто.
//    ** Уровень - Строка - уровень замечания.
//    ** Текст - Строка - текст замечания.
Функция ДанныеСтрокиПлана(АдресПлана, ПорядковыйНомер) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найдена", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Факты", НоваяТаблицаСтрок("Заголовок, Значение"));
	Результат.Вставить("СырыеДанные", "");
	Результат.Вставить("Решения", НоваяТаблицаСтрок("Заголовок, Значение, Источник"));
	Результат.Вставить("Замечания", НоваяТаблицаСтрок("Поле, Уровень, Текст"));

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'План загрузки больше не доступен на сервере. Прочитайте файл ещё раз.';
			|uk = 'План завантаження більше не доступний на сервері. Прочитайте файл ще раз.'");
		Возврат Результат;
	КонецЕсли;

	СтрокиПлана = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер));
	Если СтрокиПлана.Количество() = 0 Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Строка не найдена в плане загрузки.'; uk = 'Рядок не знайдено в плані завантаження.'");
		Возврат Результат;
	КонецЕсли;
	СтрокаПлана = СтрокиПлана[0];

	Результат.Найдена = Истина;
	Результат.Заголовок = СтрШаблон(НСтр("ru = 'Строка выписки № %1'; uk = 'Рядок виписки № %1'"), Формат(ПорядковыйНомер, "ЧГ=0"));

	// Факты банка - колонки конверта из конструктора контракта: новая колонка контракта появляется сама.
	КолонкиФактов = Новый Массив;
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		КолонкиФактов.Добавить(Колонка.Имя);
		Если Колонка.Имя = "СырыеДанные" Тогда
			Результат.СырыеДанные = СтрокаПлана[Колонка.Имя];
			Продолжить;
		КонецЕсли;
		СтрокаФакта = Результат.Факты.Добавить();
		СтрокаФакта.Заголовок = ЗаголовокКолонкиПлана(Колонка.Имя);
		СтрокаФакта.Значение = ПредставлениеЗначенияПлана(СтрокаПлана[Колонка.Имя]);
	КонецЦикла;

	// Решения: остальные колонки плана; источник вида, статьи и действия записи показываются рядом со своим решением.
	РешениеИИсточник = Новый Соответствие;
	РешениеИИсточник.Вставить("ВидОперации", "ИсточникВидаОперации");
	РешениеИИсточник.Вставить("СтатьяДДС", "ИсточникСтатьи");
	РешениеИИсточник.Вставить("Корреспонденция", "ИсточникКорреспонденции");
	РешениеИИсточник.Вставить("Контрагент", "ДействиеКонтрагент");
	РешениеИИсточник.Вставить("СчетКонтрагента", "ДействиеСчет");
	РешениеИИсточник.Вставить("Договор", "ДействиеДоговор");
	КолонкиИсточников = Новый Массив;
	Для Каждого Элемент Из РешениеИИсточник Цикл
		КолонкиИсточников.Добавить(Элемент.Значение);
	КонецЦикла;

	Для Каждого Колонка Из План.Операции.Колонки Цикл
		Если КолонкиФактов.Найти(Колонка.Имя) <> Неопределено Или КолонкиИсточников.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРешения = Результат.Решения.Добавить();
		СтрокаРешения.Заголовок = ЗаголовокКолонкиПлана(Колонка.Имя);
		СтрокаРешения.Значение = ПредставлениеЗначенияПлана(СтрокаПлана[Колонка.Имя]);
		ИмяИсточника = РешениеИИсточник.Получить(Колонка.Имя);
		Если ИмяИсточника <> Неопределено Тогда
			СтрокаРешения.Источник = ТекстИсточникаРешения(ИмяИсточника, СтрокаПлана[ИмяИсточника]);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Замечание Из План.Замечания.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер)) Цикл
		СтрокаЗамечания = Результат.Замечания.Добавить();
		СтрокаЗамечания.Поле = ?(ПустаяСтрока(Замечание.Поле), "", ЗаголовокКолонкиПлана(Замечание.Поле));
		СтрокаЗамечания.Уровень = ТекстУровняЗамечания(Замечание.Уровень);
		СтрокаЗамечания.Текст = Замечание.Текст;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Данные помощника реквизитов контрагента (4в) для одной строки плана: факты банка (только показ), текущие решения строки и признаки,
// от которых форма включает и выключает поля. Один серверный вызов на открытие помощника. План не изменяется. Правил учета здесь
// нет: нужен ли виду контрагент и договор отвечает СМП_РаспознаваниеОпераций.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//
// Возвращаемое значение:
//  Структура - данные помощника:
//   * Найдена - Булево - строку можно править помощником; при Ложь причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека (плана или строки нет, по строке найден загруженный документ).
//   * Заголовок - Строка - заголовок помощника.
//   * Наименование, Код, НомерСчета, МФО - Строка - факты банка о контрагенте (как в конверте).
//   * Контрагент - СправочникСсылка.Контрагенты - контрагент строки (пусто, если не определен или это сотрудник).
//   * ЭтоСотрудник - Булево - контрагент строки - сотрудник: помощник его не меняет.
//   * СчетКонтрагента - СправочникСсылка.БанковскиеСчета, Договор - СправочникСсылка.ДоговорыКонтрагентов - текущие счет и договор.
//   * БанкНовогоСчета - СправочникСсылка.Банки - банк нового счета, выбранный человеком ранее.
//   * НеСоздаватьСейчас - Булево - у контрагента строки действие "НеСоздавать" (решение человека).
//   * КонтрагентНайден - Булево - у контрагента строки действие "Найден".
//   * ТребуетсяКонтрагент, ТребуетсяДоговор - Булево - нужен ли виду операции строки контрагент и договор.
//   * Состояние - Строка - текущее решение по контрагенту, счету и договору для показа.
Функция ДанныеПомощникаКонтрагента(АдресПлана, ПорядковыйНомер) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найдена", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Код", "");
	Результат.Вставить("НомерСчета", "");
	Результат.Вставить("МФО", "");
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("ЭтоСотрудник", Ложь);
	Результат.Вставить("СчетКонтрагента", Справочники.БанковскиеСчета.ПустаяСсылка());
	Результат.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Результат.Вставить("БанкНовогоСчета", Справочники.Банки.ПустаяСсылка());
	Результат.Вставить("НеСоздаватьСейчас", Ложь);
	Результат.Вставить("КонтрагентНайден", Ложь);
	Результат.Вставить("ТребуетсяКонтрагент", Ложь);
	Результат.Вставить("ТребуетсяДоговор", Ложь);
	Результат.Вставить("Состояние", "");

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'План загрузки больше не доступен на сервере. Прочитайте файл ещё раз.';
			|uk = 'План завантаження більше не доступний на сервері. Прочитайте файл ще раз.'");
		Возврат Результат;
	КонецЕсли;

	СтрокиПлана = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер));
	Если СтрокиПлана.Количество() = 0 Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Строка не найдена в плане загрузки.'; uk = 'Рядок не знайдено в плані завантаження.'");
		Возврат Результат;
	КонецЕсли;
	СтрокаПлана = СтрокиПлана[0];

	Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
		Результат.ТекстОтказа = НСтр("ru = 'По строке найден загруженный документ: реквизиты контрагента к ней не применяются.';
			|uk = 'За рядком знайдено завантажений документ: реквізити контрагента до неї не застосовуються.'");
		Возврат Результат;
	КонецЕсли;

	Результат.Найдена = Истина;
	Результат.Заголовок = СтрШаблон(НСтр("ru = 'Реквизиты контрагента: строка выписки № %1'; uk = 'Реквізити контрагента: рядок виписки № %1'"),
		Формат(ПорядковыйНомер, "ЧГ=0"));
	Результат.Наименование = СтрокаПлана.КонтрагентНаименование;
	Результат.Код = СтрокаПлана.КонтрагентКод;
	Результат.НомерСчета = СтрокаПлана.КонтрагентНомерСчета;
	Результат.МФО = СтрокаПлана.КонтрагентМФО;

	Если ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Результат.Контрагент = СтрокаПлана.Контрагент;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Результат.ЭтоСотрудник = Истина;
	КонецЕсли;
	Результат.СчетКонтрагента = СтрокаПлана.СчетКонтрагента;
	Результат.Договор = СтрокаПлана.Договор;
	Результат.БанкНовогоСчета = СтрокаПлана.БанкНовогоСчета;
	Результат.НеСоздаватьСейчас = СтрокаПлана.ДействиеКонтрагент = СМП_РаспознаваниеОпераций.ДействиеНеСоздавать();
	Результат.КонтрагентНайден = СтрокаПлана.ДействиеКонтрагент = СМП_РаспознаваниеОпераций.ДействиеНайден();
	Если ЗначениеЗаполнено(СтрокаПлана.ВидОперации) Тогда
		Результат.ТребуетсяКонтрагент = СМП_РаспознаваниеОпераций.ВидОперацииТребуетКонтрагента(СтрокаПлана.ВидОперации);
		Результат.ТребуетсяДоговор = СМП_РаспознаваниеОпераций.ВидОперацииТребуетДоговор(СтрокаПлана.ВидОперации);
	КонецЕсли;

	Результат.Состояние = СтрШаблон(НСтр("ru = 'Сейчас: контрагент - %1; счет - %2; договор - %3.';
		|uk = 'Зараз: контрагент - %1; рахунок - %2; договір - %3.'"),
		ТекстДействияДляПомощника(СтрокаПлана.ДействиеКонтрагент), ТекстДействияДляПомощника(СтрокаПлана.ДействиеСчет),
		ТекстДействияДляПомощника(СтрокаПлана.ДействиеДоговор));

	Возврат Результат;

КонецФункции

// Значения заполнения для вендорской формы нового контрагента, счета или договора, которую помощник открывает по «создать сейчас» (D10).
// Объект создает и записывает форма вендора (как человек создал бы его сам); здесь - только подготовка значений, не создание.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//  Что - Строка - "Контрагент", "СчетКонтрагента" или "Договор".
//  Контрагент - СправочникСсылка.Контрагенты - владелец нового счета или договора; для "Контрагент" не нужен.
//  Банк - СправочникСсылка.Банки - банк нового счета, выбранный человеком; пусто - банк по МФО операции, если он определяется однозначно.
//
// Возвращаемое значение:
//  Структура - значения заполнения (ключи - реквизиты создаваемого объекта); пустая, если строки нет или значение "Что" неизвестно.
Функция ЗначенияЗаполненияДляСоздания(АдресПлана, ПорядковыйНомер, Что, Контрагент, Банк) Экспорт

	Значения = Новый Структура;
	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;
	СтрокиПлана = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер));
	Если СтрокиПлана.Количество() = 0 Тогда
		Возврат Значения;
	КонецЕсли;
	СтрокаПлана = СтрокиПлана[0];

	Если Что = "Контрагент" Тогда
		Название = СокрЛП(СтрокаПлана.КонтрагентНаименование);
		Если Не ПустаяСтрока(Название) Тогда
			Значения.Вставить("Наименование", Лев(Название, Метаданные.Справочники.Контрагенты.ДлинаНаименования));
			Значения.Вставить("НаименованиеПолное", Название);
		КонецЕсли;
		// Код - ключами поиска контрагента: пригодным считается код из 8 (ЕДРПОУ) или 10 (РНОКПП) цифр, как при создании записью.
		Код = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Код;
		Если Код.Использовать Тогда
			Если СтрДлина(Код.Нормализованный) = 10 Тогда
				Значения.Вставить("ИНН", Код.Нормализованный);
				Значения.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
			ИначеЕсли СтрДлина(Код.Нормализованный) = 8 Тогда
				Значения.Вставить("КодПоЕДРПОУ", Код.Нормализованный);
				Значения.Вставить("ВидКонтрагента", Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Что = "СчетКонтрагента" Тогда
		Значения.Вставить("Владелец", Контрагент);
		Значения.Вставить("НомерСчета", СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Номер);
		БанкСчета = Банк;
		Если Не ЗначениеЗаполнено(БанкСчета) Тогда
			Причина = "";
			БанкСчета = СМП_ЗаписьДокументовБанка.БанкПоМФО(СокрЛП(СтрокаПлана.КонтрагентМФО), Причина);
		КонецЕсли;
		Если ЗначениеЗаполнено(БанкСчета) Тогда
			Значения.Вставить("Банк", БанкСчета);
		КонецЕсли;
	ИначеЕсли Что = "Договор" Тогда
		Значения.Вставить("Владелец", Контрагент);
		Значения.Вставить("Организация", СтрокаПлана.Организация);
		Если ЗначениеЗаполнено(СтрокаПлана.ВидОперации) Тогда
			Виды = СМП_РаспознаваниеОпераций.ВидыДоговораДляВидаОперации(СтрокаПлана.ВидОперации);
			Если Виды.Количество() > 0 Тогда
				Значения.Вставить("ВидДоговора", Виды[0]);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) Тогда
			Значения.Вставить("ВалютаРасчетов", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПлана.БанковскийСчет, "ВалютаДенежныхСредств"));
		КонецЕсли;
	КонецЕсли;

	Возврат Значения;

КонецФункции

// Счет контрагента с номером из строки плана: находит счет, который человек только что создал формой вендора («создать сейчас»), чтобы
// помощник подставил его выбранным. Номер сравнивается так, как его ищет распознавание (нормализованный; текущий предпочтительнее устаревшего).
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//  Контрагент - СправочникСсылка.Контрагенты - владелец счета.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - найденный счет; пустая ссылка, если счета нет.
Функция СчетКонтрагентаСтроки(АдресПлана, ПорядковыйНомер, Контрагент) Экспорт

	Пусто = Справочники.БанковскиеСчета.ПустаяСсылка();
	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Пусто;
	КонецЕсли;
	СтрокиПлана = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер));
	Если СтрокиПлана.Количество() = 0 Тогда
		Возврат Пусто;
	КонецЕсли;
	Номер = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокиПлана[0]).Номер;
	Если ПустаяСтрока(Номер) Тогда
		Возврат Пусто;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Контрагент
		|	И НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Устаревший = Пусто;
	Пока Выборка.Следующий() Цикл
		Если СМП_РаспознаваниеОпераций.НормализоватьНомерСчета(Выборка.НомерСчета) = Номер Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Устаревший)
			И СМП_РаспознаваниеОпераций.НормализоватьНомерСчета(Выборка.НомерСчетаУстаревший) = Номер Тогда
			Устаревший = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Устаревший;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст действия записи над контрагентом, счетом или договором для показа в помощнике; пустое действие - "не определено".
Функция ТекстДействияДляПомощника(Действие)

	Если ПустаяСтрока(Действие) Тогда
		Возврат НСтр("ru = 'не определено'; uk = 'не визначено'");
	КонецЕсли;
	Возврат ТекстИсточникаРешения("Действие", Действие);

КонецФункции

// План загрузки из временного хранилища или Неопределено, если адрес недействителен (конец сеанса,
// перезапуск) или по адресу лежит не план: вызывающий показывает текст «прочитайте файл ещё раз» (П-Г).
Функция ПланИзВременногоХранилища(АдресПлана)

	Если ПустаяСтрока(АдресПлана) Или Не ЭтоАдресВременногоХранилища(АдресПлана) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		План = ПолучитьИзВременногоХранилища(АдресПлана);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(План) <> Тип("Структура") Или Не План.Свойство("Операции") Или Не План.Свойство("Замечания") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат План;

КонецФункции

// Заполняет строку проекции по строке плана (одна реализация для ПроекцияПлана и дельты правки).
//
// Параметры:
//  СтрокаПроекции - СтрокаТаблицыЗначений - строка НоваяТаблицаПроекции.
//  СтрокаПлана - СтрокаТаблицыЗначений - строка плана.
//  ДанныеЗамечаний - Структура, Неопределено - свернутые замечания строки (ЗамечанияПоСтрокам); Неопределено - замечаний нет.
//  ДанныеДокументов - Соответствие - см. ДанныеНайденныхДокументов.
Процедура ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, ДанныеЗамечаний, ДанныеДокументов)

	СтрокаПроекции.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер;
	СтрокаПроекции.НомерДокумента = СтрокаПлана.НомерДокумента;
	СтрокаПроекции.ДатаДокумента = СтрокаПлана.ДатаДокумента;
	Если СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеПоступило() Тогда
		СтрокаПроекции.СуммаПоступление = СтрокаПлана.Сумма;
	ИначеЕсли СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеСписано() Тогда
		СтрокаПроекции.СуммаСписание = СтрокаПлана.Сумма;
	КонецЕсли;

	СтрокаПроекции.КонтрагентНаименование = СтрокаПлана.КонтрагентНаименование;
	СтрокаПроекции.Контрагент = СтрокаПлана.Контрагент;
	СтрокаПроекции.КонтрагентПредставление = ?(ЗначениеЗаполнено(СтрокаПлана.Контрагент),
		Строка(СтрокаПлана.Контрагент), СтрокаПлана.КонтрагентНаименование);
	СтрокаПроекции.НазначениеПлатежа = СтрокаПлана.НазначениеПлатежа;
	СтрокаПроекции.ВидОперации = СтрокаПлана.ВидОперации;
	СтрокаПроекции.СтатьяДДС = СтрокаПлана.СтатьяДДС;
	СтрокаПроекции.Корреспонденция = СтрокаПлана.Корреспонденция;
	СтрокаПроекции.Договор = СтрокаПлана.Договор;
	СтрокаПроекции.СчетКонтрагента = СтрокаПлана.СчетКонтрагента;
	СтрокаПроекции.ПлатежноеПоручение = СтрокаПлана.ПлатежноеПоручение;
	СтрокаПроекции.Основа = ?(ЗначениеЗаполнено(СтрокаПлана.ДокументПоНомеру), Строка(СтрокаПлана.ДокументПоНомеру), "");
	СтрокаПроекции.ПроверьтеОперацию = СтрокаПлана.ПроверьтеОперацию;
	СтрокаПроекции.СпособЗачета = СтрокаПлана.СпособЗачета;
	СтрокаПроекции.ОсноваДоступна = СтрокаПлана.СпособЗачета <> Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
	СтрокаПроекции.СтрокаНеЗаписывается = ПустаяСтрока(СтрокаПлана.ВидДокумента);

	СтрокаПроекции.ЗагруженныйДокумент = СтрокаПлана.ЗагруженныйДокумент;
	ЕстьДокумент = ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент);
	Если ЕстьДокумент Тогда
		ДанныеДокумента = ДанныеДокументов.Получить(СтрокаПлана.ЗагруженныйДокумент);
		Если ДанныеДокумента <> Неопределено Тогда
			СтрокаПроекции.ЗагруженныйПомеченНаУдаление = ДанныеДокумента.ПометкаУдаления;
			СтрокаПроекции.ВерсияДокумента = ДанныеДокумента.ВерсияДанных;
		КонецЕсли;
	КонецЕсли;

	// Отметки (D5): найденные не отмечаются; перезапись помеченного на удаление недоступна.
	СтрокаПроекции.Загружать = Не ЕстьДокумент;
	СтрокаПроекции.ЗагружатьДоступно = Не ЕстьДокумент;
	СтрокаПроекции.Перезаписать = Ложь;
	СтрокаПроекции.ПерезаписатьДоступно = ЕстьДокумент И Не СтрокаПроекции.ЗагруженныйПомеченНаУдаление;

	Если ДанныеЗамечаний <> Неопределено Тогда
		СтрокаПроекции.КоличествоЗамечаний = ДанныеЗамечаний.Количество;
		СтрокаПроекции.ЕстьОшибка = ДанныеЗамечаний.ЕстьОшибка;
		СтрокаПроекции.ЕстьПредупреждение = ДанныеЗамечаний.ЕстьПредупреждение;
		СтрокаПроекции.УровеньЗамечаний = ?(ДанныеЗамечаний.ЕстьОшибка, СМП_ВыпискаБанка.УровеньОшибка(),
			СМП_ВыпискаБанка.УровеньПредупреждение());
	КонецЕсли;

КонецПроцедуры

// Ключи строк плана для режима «все с тем же кодом и счетом»: переданные ключи и все остальные строки без найденного документа, у
// которых совпадают нормализованные номер счета и код контрагента из банка с хотя бы одной из переданных строк (те же ключи, что у
// поиска контрагента, СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента). Пустая пара (ни кода, ни номера) строки не объединяет.
Функция КлючиСТемЖеКодомИСчетом(План, Ключи)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Образцы = Новый Соответствие;

	Для Каждого Ключ Из Ключи Цикл
		Если Добавленные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Ключ, Истина);
		Результат.Добавить(Ключ);
		Найденные = План.Операции.НайтиСтроки(Новый Структура("ПорядковыйНомер", Ключ));
		Если Найденные.Количество() > 0 Тогда
			Образец = КлючКодаИСчета(Найденные[0]);
			Если Не ПустаяСтрока(Образец) Тогда
				Образцы.Вставить(Образец, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если Добавленные.Получить(СтрокаПлана.ПорядковыйНомер) <> Неопределено Или ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		Образец = КлючКодаИСчета(СтрокаПлана);
		Если Не ПустаяСтрока(Образец) И Образцы.Получить(Образец) <> Неопределено Тогда
			Добавленные.Вставить(СтрокаПлана.ПорядковыйНомер, Истина);
			Результат.Добавить(СтрокаПлана.ПорядковыйНомер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Составной ключ «номер счета | код» строки плана (нормализованные); пусто, если нет ни номера, ни кода.
Функция КлючКодаИСчета(СтрокаПлана)

	Ключи = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана);
	Код = ?(Ключи.Код.Использовать, Ключи.Код.Нормализованный, ВРег(СокрЛП(СтрокаПлана.КонтрагентКод)));
	Если ПустаяСтрока(Ключи.Номер) И ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ключи.Номер + "|" + Код;

КонецФункции

// Таблица проекции плана для формы, см. ПроекцияПлана.
Функция НоваяТаблицаПроекции()

	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

	Таблица = Новый ТаблицаЗначений;
	Колонки = Таблица.Колонки;
	Колонки.Добавить("Загружать", ТипБулево);
	Колонки.Добавить("ЗагружатьДоступно", ТипБулево);
	Колонки.Добавить("Перезаписать", ТипБулево);
	Колонки.Добавить("ПерезаписатьДоступно", ТипБулево);
	Колонки.Добавить("ПорядковыйНомер", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Колонки.Добавить("НомерДокумента", ТипСтрока);
	Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Колонки.Добавить("СуммаПоступление", ТипСумма);
	Колонки.Добавить("СуммаСписание", ТипСумма);
	Колонки.Добавить("КонтрагентНаименование", ТипСтрока);
	Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники"));
	Колонки.Добавить("КонтрагентПредставление", ТипСтрока);
	Колонки.Добавить("НазначениеПлатежа", ТипСтрока);
	Колонки.Добавить("ВидОперации", Новый ОписаниеТипов(
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
	Колонки.Добавить("СтатьяДДС", Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Колонки.Добавить("Корреспонденция", Новый ОписаниеТипов("ПланСчетовСсылка.Управленческий"));
	Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Колонки.Добавить("СчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Колонки.Добавить("ПлатежноеПоручение", Новый ОписаниеТипов("ДокументСсылка.ПлатежноеПоручение"));
	Колонки.Добавить("Основа", ТипСтрока);
	Колонки.Добавить("ЗагруженныйДокумент", Новый ОписаниеТипов(
		"ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета"));
	Колонки.Добавить("ЗагруженныйПомеченНаУдаление", ТипБулево);
	Колонки.Добавить("ВерсияДокумента", ТипСтрока);
	Колонки.Добавить("ПроверьтеОперацию", ТипБулево);
	Колонки.Добавить("СпособЗачета", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей"));
	Колонки.Добавить("ОсноваДоступна", ТипБулево);
	Колонки.Добавить("УровеньЗамечаний", ТипСтрока);
	Колонки.Добавить("ЕстьОшибка", ТипБулево);
	Колонки.Добавить("ЕстьПредупреждение", ТипБулево);
	Колонки.Добавить("КоличествоЗамечаний", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Колонки.Добавить("СтрокаНеЗаписывается", ТипБулево);
	Возврат Таблица;

КонецФункции

// Таблица из строковых колонок; имена - через запятую.
Функция НоваяТаблицаСтрок(ИменаКолонок)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(ИменаКолонок, ",", Ложь) Цикл
		Таблица.Колонки.Добавить(СокрЛП(Имя), Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Замечания плана, свернутые по номеру операции: число замечаний и наличие каждого уровня.
// Номер 0 (замечание не к строке) в строки не попадает.
//
// Возвращаемое значение:
//  Соответствие - ПорядковыйНомер -> Структура (Количество, ЕстьОшибка, ЕстьПредупреждение).
Функция ЗамечанияПоСтрокам(Замечания)

	Результат = Новый Соответствие;
	УровеньОшибка = СМП_ВыпискаБанка.УровеньОшибка();
	УровеньПредупреждение = СМП_ВыпискаБанка.УровеньПредупреждение();

	Для Каждого Замечание Из Замечания Цикл
		Данные = Результат.Получить(Замечание.ПорядковыйНомер);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Количество, ЕстьОшибка, ЕстьПредупреждение", 0, Ложь, Ложь);
			Результат.Вставить(Замечание.ПорядковыйНомер, Данные);
		КонецЕсли;
		Данные.Количество = Данные.Количество + 1;
		Если Замечание.Уровень = УровеньОшибка Тогда
			Данные.ЕстьОшибка = Истина;
		ИначеЕсли Замечание.Уровень = УровеньПредупреждение Тогда
			Данные.ЕстьПредупреждение = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пометка на удаление и версия данных найденных документов: один запрос на весь план.
//
// Возвращаемое значение:
//  Соответствие - ссылка на документ -> Структура (ПометкаУдаления, ВерсияДанных).
Функция ДанныеНайденныхДокументов(Операции)

	Результат = Новый Соответствие;

	Ссылки = Новый Массив;
	Для Каждого СтрокаПлана Из Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			Ссылки.Добавить(СтрокаПлана.ЗагруженныйДокумент);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.ПометкаУдаления КАК ПометкаУдаления,
		|	Документы.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	Документ.ПоступлениеНаСчет КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документы.Ссылка,
		|	Документы.ПометкаУдаления,
		|	Документы.ВерсияДанных
		|ИЗ
		|	Документ.РасходСоСчета КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Новый Структура("ПометкаУдаления, ВерсияДанных",
			Выборка.ПометкаУдаления, Выборка.ВерсияДанных));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остаток на счете в учете - вендорской функцией, которую кличет и старая форма загрузки. Функция принимает
// счет и организацию и возвращает остаток на текущий момент (даты у нее нет); они берутся из плана - факты
// выбранного счета, которые распознавание ставит в каждую строку. Нет строк или счета - остатка нет.
//
// Возвращаемое значение:
//  Структура - ЕстьОстаток (Булево), Остаток (Число).
Функция ОстатокНаСчетеВУчете(Операции)

	Результат = Новый Структура("ЕстьОстаток, Остаток", Ложь, 0);

	БанковскийСчет = Неопределено;
	Организация = Неопределено;
	Для Каждого СтрокаПлана Из Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) И ЗначениеЗаполнено(СтрокаПлана.Организация) Тогда
			БанковскийСчет = СтрокаПлана.БанковскийСчет;
			Организация = СтрокаПлана.Организация;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если БанковскийСчет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Остаток = ДвиженияДенежныхСредствВызовСервера.ПолучитьОстатокНаСчете(БанковскийСчет, Организация);
		Результат.ЕстьОстаток = Истина;
	Исключение
		// Остаток - справочная цифра: сбой вендорской функции не мешает показать план. Текст исключения
		// человеку не показывается, подробности - в журнал регистрации.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.ОстатокНаСчете'; uk = 'СМП.ЗагрузкаВыписки.ЗалишокНаРахунку'"),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Название колонки плана для человека; колонка без названия показывается своим именем.
Функция ЗаголовокКолонкиПлана(ИмяКолонки)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("ПорядковыйНомер", НСтр("ru = 'Номер в выписке'; uk = 'Номер у виписці'"));
	Заголовки.Вставить("НомерСчета", НСтр("ru = 'Наш счет'; uk = 'Наш рахунок'"));
	Заголовки.Вставить("Валюта", НСтр("ru = 'Валюта'; uk = 'Валюта'"));
	Заголовки.Вставить("ДатаОперации", НСтр("ru = 'Дата операции'; uk = 'Дата операції'"));
	Заголовки.Вставить("НомерДокумента", НСтр("ru = 'Номер документа'; uk = 'Номер документа'"));
	Заголовки.Вставить("ДатаДокумента", НСтр("ru = 'Дата документа'; uk = 'Дата документа'"));
	Заголовки.Вставить("Сумма", НСтр("ru = 'Сумма'; uk = 'Сума'"));
