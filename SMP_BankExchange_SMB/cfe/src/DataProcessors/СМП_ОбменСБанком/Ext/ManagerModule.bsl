// Серверный фасад форм интерактива обмена с банком.
// Логика загрузки выписки живёт в общих модулях СМП_ЧитателиВыписок, СМП_РаспознаваниеОпераций,
// СМП_ЗаписьДокументовБанка; здесь только склейка и подготовка данных для форм (D4, D33).

#Область ПрограммныйИнтерфейс

// Учетные записи банка для банковского счета организации (не помеченные на удаление).
//
// Правило (решение 3 плана 6б): ровно одна - она; ни одной - пусто; несколько - отказ чтения (ИсточникЧтенияСчета).
// Человек учетную запись не выбирает.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.СМП_УчетныеЗаписиБанков - учетные записи счета, по наименованию.
Функция УчетныеЗаписиДляСчета(БанковскийСчет)

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	УчетныеЗаписи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СМП_УчетныеЗаписиБанков КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.БанковскийСчет = &БанковскийСчет
		|	И НЕ УчетныеЗаписи.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетныеЗаписи.Наименование");
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат Результат;

КонецФункции

// Данные формы загрузки для выбранного счета: источник чтения, учетная запись для показа, варианты формата файла.
// Один серверный вызов на смену счета. Учетную запись человек не выбирает: ее определяет счет (ИсточникЧтенияСчета).
// Учетных данных в результате нет: на клиент они не идут.
//
// Источник формата файла (2а): подключаемая обработка учетной записи -> строки реестра с МФО банка счета
// (одна - сама, несколько - выбор среди них) -> «другие форматы». Для конектора форматов нет.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//
// Возвращаемое значение:
//  Структура - данные для показа:
//   * Источник - Строка - "Файл", "Коннектор" или "Отказ" (ИсточникЧтенияСчета).
//   * ТекстОтказа - Строка - для источника "Отказ"; иначе пусто.
//   * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - единственная учетная запись счета или пустая.
//   * ВнешняяОбработка - Булево - формат задает подключаемая обработка учетной записи.
//   * ПредставлениеОбработки - Строка - наименование обработки для показа.
//   * МФОБанка - Строка - Банк.Код банка счета.
//   * Форматы - Массив из Структура - Идентификатор, Представление (для списка), Подсказка, Свой (Булево),
//     Предупреждение (Строка, пусто - нет); свои строки (с МФО банка счета) идут первыми.
//   * ИдентификаторПоУмолчанию - Строка - единственная своя строка реестра; иначе пусто.
Функция ДанныеФормы(БанковскийСчет) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Источник", "Файл");
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("УчетнаяЗапись", Справочники.СМП_УчетныеЗаписиБанков.ПустаяСсылка());
	Результат.Вставить("ВнешняяОбработка", Ложь);
	Результат.Вставить("ПредставлениеОбработки", "");
	Результат.Вставить("МФОБанка", "");
	Результат.Вставить("Форматы", Новый Массив);
	Результат.Вставить("ИдентификаторПоУмолчанию", "");

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Результат;
	КонецЕсли;

	Источник = ИсточникЧтенияСчета(БанковскийСчет);
	Результат.Источник = Источник.Вид;
	Результат.ТекстОтказа = Источник.ТекстОтказа;
	Результат.УчетнаяЗапись = Источник.УчетнаяЗапись;
	Если Источник.Вид <> "Файл" Тогда
		Возврат Результат;
	КонецЕсли;

	Обработка = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	Если ЗначениеЗаполнено(Результат.УчетнаяЗапись) Тогда
		Обработка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат.УчетнаяЗапись, "ПодключаемаяОбработка");
	КонецЕсли;
	Если ЗначениеЗаполнено(Обработка) Тогда
		Результат.ВнешняяОбработка = Истина;
		Результат.ПредставлениеОбработки = Строка(Обработка);
		Возврат Результат;
	КонецЕсли;

	МФО = МФОБанкаСчета(БанковскийСчет);
	Результат.МФОБанка = МФО;

	Реестр = СМП_ЧитателиВыписок.РеестрЧитателей();
	Свои = Новый Массив;
	Другие = Новый Массив;
	Для Каждого СтрокаРеестра Из Реестр Цикл
		Сведения = Новый Структура;
		Сведения.Вставить("Идентификатор", СтрокаРеестра.Идентификатор);
		Сведения.Вставить("Представление", СтрокаРеестра.Представление);
		Сведения.Вставить("Подсказка", ПодсказкаТогоЖеФормата(Реестр, СтрокаРеестра));
		Сведения.Вставить("Свой", СтрокаСодержитМФО(СтрокаРеестра, МФО));
		Сведения.Вставить("Предупреждение", ПредупреждениеДляСтроки(СтрокаРеестра, МФО));
		Если Сведения.Свой Тогда
			Свои.Добавить(Сведения);
		Иначе
			Сведения.Представление = СтрШаблон(НСтр("ru = '%1 (другие форматы)'; uk = '%1 (інші формати)'"),
				Сведения.Представление);
			Другие.Добавить(Сведения);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сведения Из Свои Цикл
		Результат.Форматы.Добавить(Сведения);
	КонецЦикла;
	Для Каждого Сведения Из Другие Цикл
		Результат.Форматы.Добавить(Сведения);
	КонецЦикла;
	Если Свои.Количество() = 1 Тогда
		Результат.ИдентификаторПоУмолчанию = Свои[0].Идентификатор;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Источник чтения банковского счета (решения 1 и 3 плана 6б): человек учетную запись не выбирает, ее определяет счет.
// Учетных записей нет - файл; одна - строку реестра решает СтрокаРеестраУчетнойЗаписи (пустой идентификатор - по банку,
// иначе по нему; невалидная настройка - отказ), несколько - отказ с названиями записей (справочник
// должен хранить одну запись на счет). Учетных данных в результате нет.
//
// Параметры:
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет организации.
//
// Возвращаемое значение:
//  Структура - источник чтения:
//   * Вид - Строка - "Файл", "Коннектор" или "Отказ".
//   * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - единственная запись счета или пустая.
//   * ИдентификаторСтрокиРеестра - Строка - строка РеестрКоннекторов для вида "Коннектор"; иначе пусто.
//   * ТекстОтказа - Строка - для вида "Отказ"; иначе пусто.
Функция ИсточникЧтенияСчета(БанковскийСчет) Экспорт

	Результат = Новый Структура("Вид, УчетнаяЗапись, ИдентификаторСтрокиРеестра, ТекстОтказа",
		"Файл", Справочники.СМП_УчетныеЗаписиБанков.ПустаяСсылка(), "", "");

	УчетныеЗаписи = УчетныеЗаписиДляСчета(БанковскийСчет);
	Если УчетныеЗаписи.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если УчетныеЗаписи.Количество() > 1 Тогда
		Названия = Новый Массив;
		Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(УчетныеЗаписи, "Наименование");
		Для Каждого Ссылка Из УчетныеЗаписи Цикл
			Названия.Добавить(Значения[Ссылка].Наименование);
		КонецЦикла;
		Результат.Вид = "Отказ";
		Результат.ТекстОтказа = СтрШаблон(
			НСтр("ru = 'Для банковского счета найдено несколько учетных записей: %1. Оставьте одну, лишние пометьте на удаление.';
				|uk = 'Для банківського рахунку знайдено кілька облікових записів: %1. Залиште один, зайві позначте на видалення.'"),
			СтрСоединить(Названия, ", "));
		Возврат Результат;
	КонецЕсли;

	Результат.УчетнаяЗапись = УчетныеЗаписи[0];
	СтрокаРеестра = СтрокаРеестраУчетнойЗаписи(УчетныеЗаписи[0]);
	Если Не ПустаяСтрока(СтрокаРеестра.ТекстОтказа) Тогда
		Результат.Вид = "Отказ";
		Результат.ТекстОтказа = СтрокаРеестра.ТекстОтказа;
	ИначеЕсли Не ПустаяСтрока(СтрокаРеестра.Идентификатор) Тогда
		Результат.Вид = "Коннектор";
		Результат.ИдентификаторСтрокиРеестра = СтрокаРеестра.Идентификатор;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Вход тяжелой операции чтения и распознавания (ПрочитатьИРаспознатьВыписку).
// Вида источника, учетной записи и учетных данных во входе нет: источник и запись определяет сервер по банковскому счету
// (ИсточникЧтенияСчета), учетные данные на клиент не идут (решения 2 и 3 плана 6б).
//
// Возвращаемое значение:
//  Структура - вход:
//   * АдресФайла - Строка - адрес файла выписки во временном хранилище (источник "Файл").
//   * ИдентификаторСтрокиРеестра - Строка - Идентификатор строки реестра читателей; пусто для внешней обработки.
//   * ВнешняяОбработка - Булево - читает подключаемая обработка учетной записи.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - выбранный счет организации.
//   * ИдентификаторФормы - УникальныйИдентификатор - форма, к чьему хранилищу привязан план.
//   * НачалоПериода - Дата - начало периода чтения по API, как дал человек (источник "Коннектор"); для файла пусто.
//   * КонецПериода - Дата - конец периода чтения по API; для файла пусто.
Функция НовыйВходЧтения() Экспорт

	Вход = Новый Структура;
	Вход.Вставить("АдресФайла", "");
	Вход.Вставить("ИдентификаторСтрокиРеестра", "");
	Вход.Вставить("ВнешняяОбработка", Ложь);
	Вход.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Вход.Вставить("ИдентификаторФормы", Новый УникальныйИдентификатор);
	Вход.Вставить("НачалоПериода", '00010101');
	Вход.Вставить("КонецПериода", '00010101');
	Вход.Вставить("ВернутьПлан", Ложь); // Булево: Истина - конвейер 5б, план возвращается в результате (поле План), временного хранилища нет (решение 5 плана 5б).
	Возврат Вход;

КонецФункции

// Читает выписку (файл или API банка) и распознает операции: одна функция длительной операции (ДлительныеОперации.ВыполнитьФункцию
// из формы). В базу ничего не пишет, транзакций не открывает; отмена задания безопасна (П-Г).
// Источник (файл, конектор API или отказ) и учетную запись определяет сервер по банковскому счету (ИсточникЧтенияСчета);
// для API транспорт создается здесь настоящий (решение 6 плана 6б), остальное - ПрочитатьИРаспознатьВыпискуТранспортом.
//
// Параметры:
//  Вход - Структура - см. НовыйВходЧтения.
//
// Возвращаемое значение:
//  Структура - результат для формы (тексты - для человека, без внутренних имен модулей):
//   * Принята - Булево - выписка прочитана и принята; при Ложь плана нет.
//   * АдресПлана - Строка - адрес плана загрузки во временном хранилище формы; пусто, если плана нет.
//   * КоличествоОпераций - Число - строк плана.
//   * ТекстыОтказа - Массив из Строка - причины отказа (уровень «Ошибка»; для API - тексты отказа точки чтения), пусто, если выписка принята.
//   * ПохожиеНа - Массив из Строка - представления строк реестра, чей формат узнал файл (при отказе).
//   * Диагностика - Массив из Структура - Уровень, ПорядковыйНомер, Текст: сообщения читателя и конверта
//     (в том числе чужие счета файла - предупреждения).
//   * КоличествоОшибок - Число - сообщений диагностики уровня «Ошибка».
//   * КоличествоПредупреждений - Число - сообщений диагностики уровня «Предупреждение».
//   * ЕстьНевалидныеСтроки - Булево - часть строк отброшена как невалидная.
//   * ЧтениеНеполное - Булево - читатель или конектор сообщил класс отказа: прочитанное неполно (D36 п. 8); у файловых читателей Ложь.
//   * КлассОтказа - Строка - класс отказа конверта (СМП_ВыпискаБанка.КлассОтказаНет() - нет); человеку внутренний литерал не показывается.
//   * ПрочитанныйОтрезок - Структура, Неопределено - Начало, Конец: что прочитано до остановки у стены конектора (рішення 9); иначе Неопределено.
//   * Источник - Строка - "Файл", "Коннектор" или "Отказ": что определил сервер (ИсточникЧтенияСчета).
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - счет, для которого читали: форма чужой результат не принимает.
//   * НачалоПериода - Дата - начало читаемого периода (НачалоДня), для источника "Коннектор"; иначе пусто.
//   * КонецПериода - Дата - конец читаемого периода (КонецДня), для источника "Коннектор"; иначе пусто.
Функция ПрочитатьИРаспознатьВыписку(Знач Вход) Экспорт

	Возврат ПрочитатьИРаспознатьВыпискуТранспортом(Вход, Обработки.СМП_ТранспортHTTP.Создать());

КонецФункции

// Точка входа чтения с явным транспортом (решение 6 плана 6б): то же, что ПрочитатьИРаспознатьВыписку, но транспорт задан параметром, как в
// СМП_ЧитателиВыписок.ПрочитатьКоннектором (D36 п. 1). Не режим и не флажок: транспорт читает только источник "Коннектор".
// Учетные данные конектора берутся здесь же, на сервере (УчетныеДанныеКоннектора), и уходят только в точку чтения.
//
// Параметры:
//  Вход - Структура - см. НовыйВходЧтения.
//  Транспорт - Произвольный - объект с методами ВыполнитьЗапрос, Пауза, ТекущийМомент (D36 п. 1).
//
// Возвращаемое значение:
//  Структура - см. ПрочитатьИРаспознатьВыписку.
Функция ПрочитатьИРаспознатьВыпискуТранспортом(Знач Вход, Транспорт) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Принята", Ложь);
	Результат.Вставить("АдресПлана", "");
	Результат.Вставить("КоличествоОпераций", 0);
	Результат.Вставить("ТекстыОтказа", Новый Массив);
	Результат.Вставить("ПохожиеНа", Новый Массив);
	Результат.Вставить("Диагностика", Новый Массив);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("КоличествоПредупреждений", 0);
	Результат.Вставить("ЕстьНевалидныеСтроки", Ложь);
	Результат.Вставить("ЧтениеНеполное", Ложь);
	Результат.Вставить("КлассОтказа", СМП_ВыпискаБанка.КлассОтказаНет());
	Результат.Вставить("ПрочитанныйОтрезок", Неопределено);
	Результат.Вставить("Источник", "Файл");
	Результат.Вставить("БанковскийСчет", Вход.БанковскийСчет);
	Результат.Вставить("НачалоПериода", '00010101');
	Результат.Вставить("КонецПериода", '00010101');
	// Поля для конвейера 5б (решение 5 плана 5б), добавлением; форма 6б их не показывает.
	//   ГраницаДоверия - Дата - момент, до которого данные окончательны (конверт); пусто для файла и без чтения.
	//   ЧтениеПолное - Булево - конверт полный и класса отказа нет.
	//   НевалидныеСтроки - Массив из Структура - Дата, Сумма, Направление, Причина: строки, отброшенные границей контракта (D28).
	//   План - Структура, Неопределено - план распознавания, только при ВернутьПлан во входе (без временного хранилища).
	// ПрочитанныйОтрезок (выше) несет и ГраницаДоверия отрезка (Р-6), когда ядро ее поставило.
	Результат.Вставить("ГраницаДоверия", '00010101');
	Результат.Вставить("ЧтениеПолное", Ложь);
	Результат.Вставить("НевалидныеСтроки", Новый Массив);
	Результат.Вставить("План", Неопределено);

	// Источник и учетная запись - решение сервера по счету; реквизитам формы (источник, учетная запись) сервер не доверяет.
	Источник = ИсточникЧтенияСчета(Вход.БанковскийСчет);
	УчетнаяЗапись = Источник.УчетнаяЗапись;
	Результат.Источник = Источник.Вид;
	Если Источник.Вид = "Отказ" Тогда
		Результат.ТекстыОтказа.Добавить(Источник.ТекстОтказа);
		Возврат Результат;
	КонецЕсли;
	ЭтоКоннектор = Источник.Вид = "Коннектор";
	// Границы дней считаются один раз здесь и передаются в чтение (решение 5).
	Если ЭтоКоннектор Тогда
		Результат.НачалоПериода = НачалоДня(Вход.НачалоПериода);
		Результат.КонецПериода = КонецДня(Вход.КонецПериода);
	КонецЕсли;

	ВернутьПлан = Вход.Свойство("ВернутьПлан") И Вход.ВернутьПлан = Истина;
	// Предупреждение формы 6б (D17, Р-4 -> B): для конектора с несовместимым ключом - если состояния обмена еще нет или период раньше НачалаРегламента.
	// Конвейеру оно не нужно: его период не бывает раньше НачалаРегламента.
	Если ЭтоКоннектор И Не ВернутьПлан Тогда
		ПредупредитьОПереходеКлюча(Результат, Источник, УчетнаяЗапись);
	КонецЕсли;

	// Контексты - до чтения: счет не организации - отказ до чтения (действие человека), а не исключение Распознать.
	Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(УчетнаяЗапись, Вход.БанковскийСчет);
	Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
		Результат.ТекстыОтказа.Добавить(Контексты.ТекстОтказа);
		Возврат Результат;
	КонецЕсли;
	Для Каждого Текст Из Контексты.Предупреждения Цикл
		Результат.Диагностика.Добавить(Новый Структура("Уровень, ПорядковыйНомер, Текст",
			СМП_ВыпискаБанка.УровеньПредупреждение(), 0, Текст));
		Результат.КоличествоПредупреждений = Результат.КоличествоПредупреждений + 1;
	КонецЦикла;

	Попытка
		Если ЭтоКоннектор Тогда
			РезультатЧтения = ПрочитатьСчетКоннектором(Вход, Источник, Транспорт, Результат.НачалоПериода, Результат.КонецПериода);
		Иначе
			РезультатЧтения = ПрочитатьФайлВыписки(Вход, УчетнаяЗапись);
		КонецЕсли;
	Исключение
		// В журнал - только исключение платформы; нового текста в журнал гілка конектора не пишет (Б3), значений учетных данных здесь нет.
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Чтение'; uk = 'СМП.ЗагрузкаВыписки.Чтение'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Результат.ТекстыОтказа.Добавить(?(ЭтоКоннектор,
			НСтр("ru = 'Не удалось прочитать выписку из банка: внутренняя ошибка. Подробности записаны в журнал регистрации.';
				|uk = 'Не вдалося прочитати виписку з банку: внутрішня помилка. Подробиці записано в журнал реєстрації.'"),
			НСтр("ru = 'Не удалось прочитать файл: внутренняя ошибка. Подробности записаны в журнал регистрации.';
				|uk = 'Не вдалося прочитати файл: внутрішня помилка. Подробиці записано в журнал реєстрації.'")));
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(РезультатЧтения) = Тип("Строка") Тогда
		// Отказ до чтения (не хватает входа): готовый текст.
		Результат.ТекстыОтказа.Добавить(РезультатЧтения);
		Возврат Результат;
	КонецЕсли;

	Результат.Принята = РезультатЧтения.Принята;
	Результат.ЕстьНевалидныеСтроки = РезультатЧтения.ЕстьНевалидныеСтроки;
	Если РезультатЧтения.Свойство("НевалидныеСтроки") Тогда
		Результат.НевалидныеСтроки = РезультатЧтения.НевалидныеСтроки;
	КонецЕсли;
	Если РезультатЧтения.Свойство("Выписка") И РезультатЧтения.Выписка.Свойство("КлассОтказа") Тогда
		Результат.КлассОтказа = РезультатЧтения.Выписка.КлассОтказа;
		Результат.ЧтениеНеполное = РезультатЧтения.Выписка.КлассОтказа <> СМП_ВыпискаБанка.КлассОтказаНет();
		Результат.ГраницаДоверия = РезультатЧтения.Выписка.ГраницаДоверия;
		// Непустой класс отказа делает чтение неполным, что бы ни стояло в конверте (СМП_ВыпискаБанка.НоваяВыписка).
		Результат.ЧтениеПолное = РезультатЧтения.Выписка.ЧтениеПолное = Истина И Не Результат.ЧтениеНеполное;
	КонецЕсли;
	// Прочитанный отрезок (решение 9) ставит ядро конекторов при остановке у стены; форма его не вычисляет, только переносит.
	Если ЭтоКоннектор И РезультатЧтения.Свойство("Выписка") И РезультатЧтения.Выписка.Свойство("ПрочитанныйОтрезок") Тогда
		Результат.ПрочитанныйОтрезок = РезультатЧтения.Выписка.ПрочитанныйОтрезок;
	КонецЕсли;

	УровеньОшибка = СМП_ВыпискаБанка.УровеньОшибка();
	УровеньПредупреждение = СМП_ВыпискаБанка.УровеньПредупреждение();
	Для Каждого Сообщение Из РезультатЧтения.Диагностика Цикл
		Результат.Диагностика.Добавить(Новый Структура("Уровень, ПорядковыйНомер, Текст",
			Сообщение.Уровень, Сообщение.ПорядковыйНомер, Сообщение.Текст));
		Если Сообщение.Уровень = УровеньОшибка Тогда
			Результат.КоличествоОшибок = Результат.КоличествоОшибок + 1;
			Если Не РезультатЧтения.Принята Тогда
				Результат.ТекстыОтказа.Добавить(Сообщение.Текст);
			КонецЕсли;
		ИначеЕсли Сообщение.Уровень = УровеньПредупреждение Тогда
			Результат.КоличествоПредупреждений = Результат.КоличествоПредупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	Если Не РезультатЧтения.Принята Тогда
		Если ЭтоКоннектор И Результат.ТекстыОтказа.Количество() = 0 Тогда
			// Отказ точки чтения до обращения к банку (период наоборот, неполные учетные данные) идет предупреждениями диагностики:
			// человеку нужен их текст, а не общая фраза.
			Для Каждого Сообщение Из РезультатЧтения.Диагностика Цикл
				Результат.ТекстыОтказа.Добавить(Сообщение.Текст);
			КонецЦикла;
		КонецЕсли;
		Если Результат.ТекстыОтказа.Количество() = 0 Тогда
			Результат.ТекстыОтказа.Добавить(?(ЭтоКоннектор,
				НСтр("ru = 'Выписка не принята без указания причины.'; uk = 'Виписку не прийнято без зазначення причини.'"),
				НСтр("ru = 'Файл не принят читателем без указания причины.';
					|uk = 'Файл не прийнято читачем без зазначення причини.'")));
		КонецЕсли;
		Результат.ПохожиеНа = ПредставленияСтрокРеестра(РезультатЧтения.ПохожиеСтрокиРеестра);
		Возврат Результат;
	КонецЕсли;

	// Распознавание: контексты из одной функции с регламентом 5б (счет и организация - факты выбранного счета).
	КонтекстРаспознавания = Контексты.КонтекстРаспознавания;

	Попытка
		План = СМП_РаспознаваниеОпераций.Распознать(РезультатЧтения.Операции, КонтекстРаспознавания);
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Распознавание'; uk = 'СМП.ЗагрузкаВыписки.Распознавання'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Результат.Принята = Ложь;
		// Текст исключения платформы человеку не показывается (может цитировать данные): только журнал регистрации.
		Результат.ТекстыОтказа.Добавить(
			НСтр("ru = 'Файл прочитан, но операции не удалось распознать: внутренняя ошибка. Подробности записаны в журнал регистрации.';
				|uk = 'Файл прочитано, але операції не вдалося розпізнати: внутрішня помилка. Подробиці записано в журнал реєстрації.'"));
		Возврат Результат;
	КонецПопытки;

	Результат.КоличествоОпераций = План.Операции.Количество();
	Если ВернутьПлан Тогда
		Результат.План = План;
		Возврат Результат;
	КонецЕсли;
	Результат.АдресПлана = ПоместитьВоВременноеХранилище(План, Вход.ИдентификаторФормы);
	Возврат Результат;

КонецФункции

// Предупреждение формы 6б о переходе ключа узнавания (D17, Р-4 -> B): конектор с несовместимым ключом (КлючНесовместим, сейчас ПУМБ) не узнает
// документы старой обработки, поэтому период, который с ними может пересечься, - решение человека. Границы перехода в коде нет: ее роль играет
// НачалоРегламента состояния этой учетной записи (ставит конвейер первым запуском без курсора). Предупреждает, если состояния еще нет
// (или НачалоРегламента не поставлено) либо период начинается раньше НачалаРегламента. Остальные конекторы не предупреждают.
//
// Параметры:
//  Результат - Структура - результат точки чтения (НачалоПериода уже НачалоДня; Диагностика, КоличествоПредупреждений дополняются).
//  Источник - Структура - см. ИсточникЧтенияСчета (вид "Коннектор").
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - запись счета.
Процедура ПредупредитьОПереходеКлюча(Результат, Источник, УчетнаяЗапись)

	Найденная = СМП_ЧитателиВыписок.НайтиСтрокуКоннектора(СМП_ЧитателиВыписок.РеестрКоннекторов(), Источник.ИдентификаторСтрокиРеестра);
	Если Найденная.Строка = Неопределено Или Не Найденная.Строка.КлючНесовместим Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Состояние.НачалоРегламента КАК НачалоРегламента
		|ИЗ
		|	РегистрСведений.СМП_СостояниеОбменаСБанком КАК Состояние
		|ГДЕ
		|	Состояние.УчетнаяЗапись = &УчетнаяЗапись");
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.НачалоРегламента) И Результат.НачалоПериода >= Выборка.НачалоРегламента Тогда
		Возврат;
	КонецЕсли;

	Текст = НСтр("ru = 'Ключ узнавания документов этого банка отличается от старой обработки: документы, загруженные ею, платформа не узнает, и операции могут задвоиться. Период начинается раньше, чем платформа начала обмен по этой учетной записи (или обмен по ней еще не начинался). Загружайте только дни, которые старая обработка не загружала.';
		|uk = 'Ключ розпізнавання документів цього банку відрізняється від старої обробки: документи, завантажені нею, платформа не розпізнає, і операції можуть задвоїтися. Період починається раніше, ніж платформа почала обмін за цим обліковим записом (або обмін за ним ще не починався). Завантажуйте лише дні, які стара обробка не завантажувала.'");
	Результат.Диагностика.Добавить(Новый Структура("Уровень, ПорядковыйНомер, Текст",
		СМП_ВыпискаБанка.УровеньПредупреждение(), 0, Текст));
	Результат.КоличествоПредупреждений = Результат.КоличествоПредупреждений + 1;

КонецПроцедуры

// Период остатка по прочитанному отрезку (решение 10 плана 6б). Направление чтения не передается: отрезок прилегает
// к одной границе периода (с начала - остаток от конца отрезка, с конца - остаток до начала отрезка), остаток - одна
// сплошная часть. Данные читаются целыми днями (решение 5), поэтому граница остатка округляется до дня момента
// остановки, а сам момент входит в остаток включно (дата записи Привата - до минуты, monobank повторно
// охватывает граничную секунду). Остаток, совпадающий с периодом чтения, не предлагается (прогресса нет,
// человек сужает период сам).
//
// Параметры:
//  ПрочитанныйОтрезок - Структура, Неопределено - Начало, Конец охваченного чтением (поле конверта).
//  НачалоПериода - Дата - начало периода, который читали.
//  КонецПериода - Дата - конец периода, который читали.
//
// Возвращаемое значение:
//  Структура, Неопределено - Начало, Конец остатка (целые дни) или Неопределено.
Функция ПериодОстатка(ПрочитанныйОтрезок, НачалоПериода, КонецПериода) Экспорт

	Если ТипЗнч(ПрочитанныйОтрезок) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Начало = НачалоДня(НачалоПериода);
	Конец = КонецДня(КонецПериода);

	Если ПрочитанныйОтрезок.Начало <= Начало И ПрочитанныйОтрезок.Конец < Конец Тогда
		НачалоОстатка = НачалоДня(ПрочитанныйОтрезок.Конец);
		КонецОстатка = Конец;
	ИначеЕсли ПрочитанныйОтрезок.Конец >= Конец И ПрочитанныйОтрезок.Начало > Начало Тогда
		НачалоОстатка = Начало;
		КонецОстатка = КонецДня(ПрочитанныйОтрезок.Начало);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Если НачалоОстатка = Начало И КонецОстатка = Конец Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Начало, Конец", НачалоОстатка, КонецОстатка);

КонецФункции

// Читает счет конектором API банка (решения 1, 2, 5, 6, 11 плана 6б). Учетные данные берет серверная функция без Экспорт
// (УчетныеДанныеКоннектора) и передает только в точку чтения; во вход, результат и журнал они не попадают.
// Период человека - границы дней, включительно; границы считает точка входа один раз, период наоборот отклоняет точка чтения.
//
// Параметры:
//  Вход - Структура - см. НовыйВходЧтения.
//  Источник - Структура - результат ИсточникЧтенияСчета с видом "Коннектор".
//  Транспорт - Произвольный - транспорт для точки чтения.
//  НачалоПериода - Дата - НачалоДня начала периода человека.
//  КонецПериода - Дата - КонецДня конца периода человека.
//
// Возвращаемое значение:
//  Структура, Строка - результат чтения (СМП_ЧитателиВыписок.НовыйРезультатЧтения) или текст отказа до чтения.
Функция ПрочитатьСчетКоннектором(Вход, Источник, Транспорт, НачалоПериода, КонецПериода)

	Если Не ЗначениеЗаполнено(Вход.НачалоПериода) И Не ЗначениеЗаполнено(Вход.КонецПериода) Тогда
		Возврат НСтр("ru = 'Период чтения не задан.'; uk = 'Період читання не задано.'");
	КонецЕсли;

	// Числовой код валюты банковского счета (D36 п. 2): рядок как есть, неоднозначное или пустое решает конектор.
	ВалютаСчета = "";
	Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Вход.БанковскийСчет, "ВалютаДенежныхСредств");
	Если ЗначениеЗаполнено(Валюта) Тогда
		ВалютаСчета = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Валюта, "Код"));
	КонецЕсли;

	Возврат СМП_ЧитателиВыписок.ПрочитатьКоннектором(Источник.ИдентификаторСтрокиРеестра, НомераСчетаДляЧтения(Вход.БанковскийСчет),
		НачалоПериода, КонецПериода, УчетныеДанныеКоннектора(Источник.УчетнаяЗапись), Транспорт, ВалютаСчета);

КонецФункции

// Проекция плана загрузки для таблицы формы: плоская таблица примитивных и ссылочных типов
// (без СырыеДанные и вложенных структур) и остаток на счете. Один серверный вызов на весь план;
// запросов на строку нет. План не изменяется, в базу ничего не пишется.
//
// Ключ строки - ПорядковыйНомер операции (D28): таблица формы может сортироваться и отбираться,
// номер строки таблицы ключом быть не может.
//
// Отметки (D5): «Загружать» - Истина для строк без найденного документа (в том числе со
// замечанием «Ошибка» и без ВидДокумента: причина видна в строке, D3); у строк с найденным
// документом «Загружать» = Ложь и недоступна. «Перезаписать» - из плана (колонка плана; распознавание
// ставит Ложь, Истина ставит решение человека «Перезаписать», ПрименитьРешенияЧеловека); доступна
// только для строк с найденным документом, не помеченным на удаление, а у уже отмеченной строки - всегда
// (чтобы отметку можно было снять).
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки (СМП_РаспознаваниеОпераций.НовыйПланЗагрузки) во временном хранилище.
//
// Возвращаемое значение:
//  Структура - проекция плана:
//   * Найден - Булево - план получен; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека, если плана нет.
//   * Строки - ТаблицаЗначений - строка на операцию:
//    ** Загружать - Булево - отметка «Загружать».
//    ** ЗагружатьДоступно - Булево - отметку можно менять (нет найденного документа).
//    ** Перезаписать - Булево - отметка «Перезаписать».
//    ** ПерезаписатьДоступно - Булево - отметку можно менять (есть найденный документ, не помеченный на удаление).
//    ** ПорядковыйНомер - Число - ключ строки.
//    ** НомерДокумента - Строка - номер документа банка.
//    ** ДатаДокумента - Дата - дата документа банка.
//    ** СуммаПоступление - Число - сумма, если направление «Поступило»; иначе 0.
//    ** СуммаСписание - Число - сумма, если направление «Списано»; иначе 0.
//    ** КонтрагентНаименование - Строка - наименование контрагента из банка.
//    ** Контрагент - СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники - определенный контрагент.
//    ** КонтрагентПредставление - Строка - представление определенного контрагента, а если не определен -
//       наименование из банка.
//    ** НазначениеПлатежа - Строка - назначение платежа.
//    ** ВидОперации - ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета -
//       вид операции.
//    ** СтатьяДДС - СправочникСсылка.СтатьиДвиженияДенежныхСредств - статья.
//    ** Корреспонденция - ПланСчетовСсылка.Управленческий - корреспонденция.
//    ** Договор - СправочникСсылка.ДоговорыКонтрагентов - договор.
//    ** СчетКонтрагента - СправочникСсылка.БанковскиеСчета - банковский счет контрагента.
//    ** ПлатежноеПоручение - ДокументСсылка.ПлатежноеПоручение - платежное поручение.
//    ** Основа - Строка - представление ДокументПоНомеру (заказ, счет на оплату, документ расчетов).
//    ** ЗагруженныйДокумент - ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета - найденный документ.
//    ** ЗагруженныйПомеченНаУдаление - Булево - найденный документ помечен на удаление.
//    ** ВерсияДокумента - Строка - ВерсияДанных найденного документа на момент распознавания (колонка плана; запись сверяет ее с версией в момент записи).
//    ** ПроверьтеОперацию - Булево - ни один источник вида операции не сработал (D24).
//    ** СпособЗачета - ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей - способ зачета, выбранный человеком; пусто - по правилу D34.
//    ** ОсноваДоступна - Булево - основу строки можно выбирать (способ зачета не «Авто»; при «Авто» форма вендора выбор основы блокирует).
//    ** УровеньЗамечаний - Строка - высший уровень замечаний строки («Ошибка», «Предупреждение») или пусто.
//    ** ЕстьОшибка - Булево - у строки есть замечание «Ошибка».
//    ** ЕстьПредупреждение - Булево - у строки есть замечание «Предупреждение».
//    ** КоличествоЗамечаний - Число - число замечаний строки.
//    ** СтрокаНеЗаписывается - Булево - ВидДокумента пуст: запись такой строки закончится «Ошибкой».
//   * ЕстьОстаток - Булево - остаток на счете получен.
//   * ОстатокНаСчете - Число - остаток на счете в учете (вендорская функция, на текущий момент).
Функция ПроекцияПлана(АдресПлана) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Строки", НоваяТаблицаПроекции());
	Результат.Вставить("ЕстьОстаток", Ложь);
	Результат.Вставить("ОстатокНаСчете", 0);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	Замечания = ЗамечанияПоСтрокам(План.Замечания);
	ДанныеДокументов = ДанныеНайденныхДокументов(План.Операции);

	Для Каждого СтрокаПлана Из План.Операции Цикл
		СтрокаПроекции = Результат.Строки.Добавить();
		ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, Замечания.Получить(СтрокаПлана.ПорядковыйНомер), ДанныеДокументов);
	КонецЦикла;

	ДанныеОстатка = ОстатокНаСчетеВУчете(План.Операции);
	Результат.ЕстьОстаток = ДанныеОстатка.ЕстьОстаток;
	Результат.ОстатокНаСчете = ДанныеОстатка.Остаток;

	Возврат Результат;

КонецФункции

// Правка плана решением человека (П-Г плана этапа 6): применяет решения к строкам плана функцией распознавания и возвращает дельту -
// проекцию только измененных строк. План остается во временном хранилище по тому же адресу (заменяется на месте); форма не передает
// таблицу туда-обратно. Один вызов на действие человека, число вызовов от числа строк не зависит. В базу ничего не пишет.
//
// Контекст распознавания собирается из тех же источников, что и при чтении (СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи): в плане
// его нет, поэтому форма передает учетную запись и банковский счет, с которыми прочитала файл.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Ключи - Массив из Число - ПорядковыйНомер строк, к которым относится правка.
//  ДляВсех - Булево - Ложь: решения применяются только к строкам с переданными ключами; Истина: к ним и ко всем остальным строкам с тем же
//    кодом И тем же номером счета контрагента из банка (D10). Множество определяет сервер, а не форма (D4). Строки с найденным документом в
//    множество не попадают, кроме строк, отмеченных к перезаписи (они распознаны как новые); строка без кода и без номера счета не имеет
//    «таких же» и правится одна.
//  Решения - Структура - решения человека, см. СМП_РаспознаваниеОпераций.ПрименитьРешенияЧеловека (имя решения - значение).
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - учетная запись, с которой читали файл; может быть пустой.
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - банковский счет организации, выбранный человеком.
//  ЗапомнитьСтатью - Булево - после применения решения «СтатьяДДС» записать статью в договор или контрагента (см. ЗапомнитьСтатьи);
//    выставляет форма по флажку «Запомнить статью» (D13), тем же вызовом, что и правку.
//
// Возвращаемое значение:
//  Структура - дельта правки:
//   * Найден - Булево - план получен; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * Применено - Булево - решения применены хотя бы к одной строке (план в хранилище обновлен).
//   * ТекстОтказа - Строка - текст для человека, если плана нет или по счету работать нельзя.
//   * Строки - ТаблицаЗначений - проекция измененных строк, колонки и смысл - как у ПроекцияПлана.Строки (по ПорядковыйНомер форма
//     обновляет свою таблицу); включает строки, затронутые режимом «для всех», и строки отказов с их текущими значениями (форма откатывает
//     клетки); если решение не применено ни к одной строке - переданные строки с текущими значениями.
//   * Отказы - Массив из Структура - строки, к которым решение не применено: ПорядковыйНомер, Текст.
//   * ТекстЗапоминания - Строка - сообщение человеку о запоминании статьи (записано / причины); пусто, если не запоминали.
//   * ЗапоминаниеТребуетВнимания - Булево - среди сообщений есть причины, по которым статья не записана.
Функция ПрименитьРешенияЧеловека(АдресПлана, Ключи, ДляВсех, Решения, УчетнаяЗапись, БанковскийСчет, ЗапомнитьСтатью = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найден", Ложь);
	Результат.Вставить("Применено", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Строки", НоваяТаблицаПроекции());
	Результат.Вставить("Отказы", Новый Массив);
	Результат.Вставить("ТекстЗапоминания", "");
	Результат.Вставить("ЗапоминаниеТребуетВнимания", Ложь);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(УчетнаяЗапись, БанковскийСчет);
	Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
		Результат.ТекстОтказа = Контексты.ТекстОтказа;
		Возврат Результат;
	КонецЕсли;

	КлючиПрименения = Ключи;
	Если ДляВсех Тогда
		КлючиПрименения = КлючиСТемЖеКодомИСчетом(План, Ключи);
	КонецЕсли;

	Применение = СМП_РаспознаваниеОпераций.ПрименитьРешенияЧеловека(План, КлючиПрименения, Решения, Контексты.КонтекстРаспознавания);
	Результат.Отказы = Применение.Отказы;

	// Строки дельты: примененные (среди них есть строки, отмеченные к перезаписи - решение «Перезаписать»: у них найденный документ) и
	// строки отказов с текущими значениями (форма откатывает клетки). Не применено ничего - переданные ключи: откатываются все клетки.
	КлючиДельты = Новый Массив;
	Если Применение.Применено.Количество() = 0 Тогда
		КлючиДельты = Ключи;
	Иначе
		// Тот же адрес: форма держит один адрес плана на все время работы с файлом.
		ПоместитьВоВременноеХранилище(План, АдресПлана);
		Для Каждого Ключ Из Применение.Применено Цикл
			КлючиДельты.Добавить(Ключ);
		КонецЦикла;
		Для Каждого ОтказСтроки Из Применение.Отказы Цикл
			КлючиДельты.Добавить(ОтказСтроки.ПорядковыйНомер);
		КонецЦикла;
		Результат.Применено = Истина;
	КонецЕсли;

	СтрокиДельты = Новый Массив;
	Добавленные = Новый Соответствие;
	Для Каждого Ключ Из КлючиДельты Цикл
		СтрокаПлана = НайтиСтрокуПлана(План, Ключ);
		Если СтрокаПлана <> Неопределено И Добавленные.Получить(Ключ) = Неопределено Тогда
			Добавленные.Вставить(Ключ, Истина);
			СтрокиДельты.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;
	Замечания = ЗамечанияПоСтрокам(План.Замечания);
	ДанныеДокументов = ДанныеНайденныхДокументов(СтрокиДельты);
	Для Каждого СтрокаПлана Из СтрокиДельты Цикл
		СтрокаПроекции = Результат.Строки.Добавить();
		ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, Замечания.Получить(СтрокаПлана.ПорядковыйНомер), ДанныеДокументов);
	КонецЦикла;
	Если Не Результат.Применено Тогда
		Возврат Результат;
	КонецЕсли;

	// Запоминание - по флажку и только если среди решений была статья; тот же серверный вызов, что и правка.
	Если ЗапомнитьСтатью И Решения.Свойство("СтатьяДДС") Тогда
		Запоминание = ЗапомнитьСтатьи(АдресПлана, Применение.Применено);
		Результат.ТекстЗапоминания = ТекстЗапоминанияСтатьи(Запоминание);
		Результат.ЗапоминаниеТребуетВнимания = Запоминание.Причины.Количество() > 0;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Вход тяжелой операции записи (ЗаписатьПлан).
//
// Возвращаемое значение:
//  Структура - вход:
//   * АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//   * Выбранные - Массив из Число - ПорядковыйНомер строк, которые человек выбрал к записи: новые с отметкой «Загружать» и найденные с
//     отметкой «Перезаписать». Остальные новые строки в запись не идут; остальные строки с найденным документом остаются в плане, но не
//     перезаписываются и в протокол не попадают.
//   * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - может быть пустой.
//   * БанковскийСчет - СправочникСсылка.БанковскиеСчета - выбранный счет организации.
//   * Ответственный - СправочникСсылка.Пользователи - ОБЯЗАТЕЛЬНЫЙ: поточный пользователь формы, автор документов (D16). Задание
//     его не читает - форма передает параметром (вимір 0.2).
//   * АдресДанныхЧтения - Строка - адрес данных чтения (Диагностика, КоличествоОшибок, КоличествоПредупреждений,
//     ЕстьНевалидныеСтроки, ЧтениеНеполное), которые форма запомнила после чтения; пусто - в протоколе чтения нет.
Функция НовыйВходЗаписи() Экспорт

	Вход = Новый Структура;
	Вход.Вставить("АдресПлана", "");
	Вход.Вставить("Выбранные", Новый Массив);
	Вход.Вставить("УчетнаяЗапись", Справочники.СМП_УчетныеЗаписиБанков.ПустаяСсылка());
	Вход.Вставить("БанковскийСчет", Справочники.БанковскиеСчета.ПустаяСсылка());
	Вход.Вставить("Ответственный", Справочники.Пользователи.ПустаяСсылка());
	Вход.Вставить("АдресДанныхЧтения", "");
	Возврат Вход;

КонецФункции

// Записывает план загрузки: одна функция длительной операции (ДлительныеОперации.ВыполнитьФункцию из формы), тем же кодом, что и
// регламент (СМП_ЗаписьДокументовБанка.Записать). ВНЕ ТРАНЗАКЦИИ: ни эта функция, ни форма транзакцию не открывают (records.md §2).
// Отмены у записи нет: остановка посередине оставила бы часть документов, протокол всегда полный.
//
// Контекст записи - из СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи (новой функции контекста нет); Ответственный - из входа,
// РазрешитьПерезапись = Истина (перезапись разрешает только форма, регламент ее не ставит никогда). Новые строки, не выбранные
// человеком, в запись не идут (ПланПакетаДляЗаписи); строки с найденным документом, не выбранные человеком, остаются в плане (они удерживают
// свой документ в повторной проверке), но перезаписываться не должны: их отметка «Перезаписать» в копии плана сбрасывается, а в протокол
// такие строки не попадают.
//
// Протокол строится из результата записи и данных чтения, а не из очереди сообщений (records.md §6). Сообщения фонового задания форма
// получает отдельно (результат тривалої операції, Сообщения) и показывает отдельным блоком.
//
// Параметры:
//  Вход - Структура - см. НовыйВходЗаписи.
//
// Возвращаемое значение:
//  Структура - протокол записи (данные для формы завершения и дельта для таблицы формы):
//   * Выполнено - Булево - запись выполнена до конца; Ложь - записи не было или она оборвалась (причина - ТекстОтказа).
//   * ТекстОтказа - Строка - текст для человека, если Выполнено = Ложь.
//   * Строки - ТаблицаЗначений - строка на каждую выбранную строку плана (в порядке плана):
//    ** ПорядковыйНомер - Число - ключ строки.
//    ** НомерДокументаБанка - Строка - номер документа банка.
//    ** ДатаДокументаБанка - Дата - дата документа банка.
//    ** СуммаПоступление - Число - сумма, если направление «Поступило»; иначе 0.
//    ** СуммаСписание - Число - сумма, если направление «Списано»; иначе 0.
//    ** КонтрагентПредставление - Строка - контрагент из плана, а если не определен - наименование из банка.
//    ** Документ - ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета - документ строки результата записи.
//    ** Результат - Строка - литерал результата (СМП_ЗаписьДокументовБанка.Результат*).
//    ** ПерезаписьЗапрошена - Булево - строка была отмечена к перезаписи.
//    ** КатегорияОтказа - Строка - для строки перезаписи с результатом «УжеЗагружен»: почему не перезаписана (из результата записи,
//       СМП_ЗаписьДокументовБанка.КатегорияОтказа*); иначе пусто.
//    ** РезультатТекст - Строка - текст результата для человека (ТекстРезультатаСтроки).
//    ** СозданКонтрагент, СозданСчет, СозданДоговор - созданные этой записью объекты или пусто.
//   * Замечания - ТаблицаЗначений - ПорядковыйНомер, Поле, Уровень, Текст: замечания записи по выбранным строкам.
//   * Счетчики - Структура - Всего, Создан, СозданНепроведенным, УжеЗагружен (только строки, не отмеченные к перезаписи), Ошибка,
//     Перезаписан, ПерезаписанНепроведенным, НеПерезаписаноПомеченНаУдаление, НеПерезаписаноИзмененПослеПоказа, НеПерезаписаноПрочее
//     (перезапись запрошена, но документ не изменен по другой причине), ПрочийРезультат (неизвестный литерал), СозданоКонтрагентов,
//     СозданоСчетов, СозданоДоговоров.
//   * Чтение - Структура - Диагностика (Массив из Структура: Уровень, ПорядковыйНомер, Текст), КоличествоОшибок, КоличествоПредупреждений,
//     ЕстьНевалидныеСтроки, ЧтениеНеполное; пустые значения, если данных чтения не передали.
//   * Дельта - ТаблицаЗначений - строки, чей документ появился или изменен записью: ПорядковыйНомер, Документ, ВерсияДокумента (текущая
//     ВерсияДанных документа), Перезаписан (Булево). Применяется к плану ПрименитьРезультатЗаписи.
Функция ЗаписатьПлан(Знач Вход) Экспорт

	Протокол = НовыйПротоколЗаписи();
	Протокол.Чтение = ДанныеЧтенияДляПротокола(Вход.АдресДанныхЧтения);

	Если Не ЗначениеЗаполнено(Вход.Ответственный) Тогда
		Протокол.ТекстОтказа = НСтр("ru = 'Запись не выполнена: не определен пользователь, который будет автором документов.';
			|uk = 'Запис не виконано: не визначено користувача, який буде автором документів.'");
		Возврат Протокол;
	КонецЕсли;

	Пакет = ПланПакетаДляЗаписи(Вход.АдресПлана, Вход.Выбранные);
	Если Не Пакет.Найден Тогда
		Протокол.ТекстОтказа = Пакет.ТекстОтказа;
		Возврат Протокол;
	КонецЕсли;

	Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(Вход.УчетнаяЗапись, Вход.БанковскийСчет);
	Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
		Протокол.ТекстОтказа = Контексты.ТекстОтказа;
		Возврат Протокол;
	КонецЕсли;
	КонтекстЗаписи = Контексты.КонтекстЗаписи;
	КонтекстЗаписи.Ответственный = Вход.Ответственный;
	КонтекстЗаписи.РазрешитьПерезапись = Истина;

	Попытка
		РезультатЗаписи = СМП_ЗаписьДокументовБанка.Записать(Пакет.План, КонтекстЗаписи);
	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Запись'; uk = 'СМП.ЗагрузкаВыписки.Запис'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		// Текст исключения платформы человеку не показывается (может цитировать данные): только журнал регистрации.
		Протокол.ТекстОтказа = НСтр("ru = 'Запись прервана внутренней ошибкой. Часть документов могла быть записана: проверьте журнал «Банк и касса», подробности записаны в журнал регистрации. Прочитайте файл ещё раз.';
			|uk = 'Запис перервано внутрішньою помилкою. Частину документів могло бути записано: перевірте журнал «Банк і каса», подробиці записано в журнал реєстрації. Прочитайте файл ще раз.'");
		Возврат Протокол;
	КонецПопытки;

	ЗаполнитьПротоколЗаписи(Протокол, Пакет, РезультатЗаписи);
	Протокол.Выполнено = Истина;
	Возврат Протокол;

КонецФункции

// Записывает план регламентом, без человека (решения 6 и 7 плана 5б): тот же СМП_ЗаписьДокументовБанка.Записать, что у интерактива, но
// РазрешитьПерезапись = Ложь (D5: документ, найденный распознаванием или повторной проверкой, регламент не перезаписывает никогда).
// Пишет все строки плана без найденного документа; документ с замечанием остается непроведенным (D20). ВНЕ ТРАНЗАКЦИИ (как Записать).
// План берется как есть (его вернула точка чтения при ВернутьПлан), временного хранилища нет. Автора передает вызывающий (D16);
// учетных данных здесь нет, исключение платформы человеку не показывается - только журнал регистрации.
//
// Параметры:
//  План - Структура - план загрузки (СМП_РаспознаваниеОпераций.НовыйПланЗагрузки), не изменяется.
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - источник настроек контекста (группа доступа, контрагент банка, глубина поиска).
//  Автор - СправочникСсылка.Пользователи - автор документов; пустой - отказ без записи.
//
// Возвращаемое значение:
//  Структура - итог записи:
//   * Выполнено - Булево - запись выполнена до конца; Ложь - отказ до записи или запись оборвана исключением (причина - ТекстОтказа).
//   * ТекстОтказа - Строка - нейтральный текст, если Выполнено = Ложь.
//   * Создано - Число - создано документов (в том числе непроведенных).
//   * НеПроведено - Число - из них непроведенных.
//   * ГраницаЗаписи - Дата, Неопределено - ДатаОперации самой ранней строки без документа с временным сбоем (Р-9: любая причина, кроме закрытого
//     перечня постоянных отказов; при Выполнено = Ложь - любая строка без документа); Неопределено - таких строк нет (конвейер берет КонецПериода).
//   * ПостоянныеОтказы - Массив из Структура - Дата, Сумма, Направление, Причина: строки, отклоненные закрытым перечнем ПричинаОтказаСтроки;
//     ГраницаЗаписи они не ставят (D18 п. 1, Р-9).
Функция ЗаписатьПланРегламента(План, УчетнаяЗапись, Автор) Экспорт

	Итог = Новый Структура("Выполнено, ТекстОтказа, Создано, НеПроведено, ГраницаЗаписи, ПостоянныеОтказы",
		Ложь, "", 0, 0, Неопределено, Новый Массив);

	РезультатЗаписи = Неопределено;
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Итог.ТекстОтказа = НСтр("ru = 'Запись не выполнена: не определен пользователь, который будет автором документов.';
			|uk = 'Запис не виконано: не визначено користувача, який буде автором документів.'");
	Иначе
		БанковскийСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			БанковскийСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "БанковскийСчет");
		КонецЕсли;
		Контексты = СМП_ЗаписьДокументовБанка.КонтекстыИзУчетнойЗаписи(УчетнаяЗапись, БанковскийСчет);
		Если Не ПустаяСтрока(Контексты.ТекстОтказа) Тогда
			Итог.ТекстОтказа = Контексты.ТекстОтказа;
		Иначе
			КонтекстЗаписи = Контексты.КонтекстЗаписи;
			КонтекстЗаписи.Ответственный = Автор;
			КонтекстЗаписи.РазрешитьПерезапись = Ложь;
			Попытка
				РезультатЗаписи = СМП_ЗаписьДокументовБанка.Записать(План, КонтекстЗаписи);
			Исключение
				Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.Запись'; uk = 'СМП.ЗагрузкаВыписки.Запис'"),
					УровеньЖурналаРегистрации.Ошибка, , , Подробно);
				Итог.ТекстОтказа = НСтр("ru = 'Запись прервана внутренней ошибкой. Часть документов могла быть записана. Подробности записаны в журнал регистрации.';
					|uk = 'Запис перервано внутрішньою помилкою. Частину документів могло бути записано. Подробиці записано в журнал реєстрації.'");
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если РезультатЗаписи = Неопределено Тогда
		// Записи не было или она оборвалась: каждая строка без документа - временный сбой (повторная проверка следующего запуска найдет записанное).
		Для Каждого СтрокаПлана Из План.Операции Цикл
			Если Не ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
				Итог.ГраницаЗаписи = РаньшеГраницаЗаписи(Итог.ГраницаЗаписи, СтрокаПлана.ДатаОперации);
			КонецЕсли;
		КонецЦикла;
		Возврат Итог;
	КонецЕсли;

	Итог.Выполнено = Истина;
	СтрокиПлана = Новый Соответствие;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		СтрокиПлана.Вставить(СтрокаПлана.ПорядковыйНомер, СтрокаПлана);
	КонецЦикла;

	Для Каждого СтрокаРезультата Из РезультатЗаписи.Операции Цикл
		Если СтрокаРезультата.Результат = СМП_ЗаписьДокументовБанка.РезультатСоздан() Тогда
			Итог.Создано = Итог.Создано + 1;
		ИначеЕсли СтрокаРезультата.Результат = СМП_ЗаписьДокументовБанка.РезультатСозданНепроведенным() Тогда
			Итог.Создано = Итог.Создано + 1;
			Итог.НеПроведено = Итог.НеПроведено + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаРезультата.Документ) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПлана = СтрокиПлана.Получить(СтрокаРезультата.ПорядковыйНомер);
		Если СтрокаПлана = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Строка без документа: постоянный отказ (закрытый перечень) курсор не держит, любая другая причина - временный сбой.
		Отказ = СМП_ЗаписьДокументовБанка.ПостоянныйОтказСтрокиПлана(СтрокаПлана);
		Если Отказ <> Неопределено Тогда
			Итог.ПостоянныеОтказы.Добавить(Новый Структура("Дата, Сумма, Направление, Причина",
				СтрокаПлана.ДатаОперации, СтрокаПлана.Сумма, СтрокаПлана.Направление, Отказ.Текст));
		Иначе
			Итог.ГраницаЗаписи = РаньшеГраницаЗаписи(Итог.ГраницаЗаписи, СтрокаПлана.ДатаОперации);
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Более ранняя из двух границ записи; Неопределено - границы еще нет.
Функция РаньшеГраницаЗаписи(Текущая, Дата)

	Если Текущая = Неопределено Или Дата < Текущая Тогда
		Возврат Дата;
	КонецЕсли;
	Возврат Текущая;

КонецФункции

// Данные для диалога перед перезаписью (один на пакет): считаются с ТОГО ЖЕ плана для записи, что пойдет в ЗаписатьПлан (те же выбранные
// строки), документы читаются в момент вызова.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Выбранные - Массив из Число - как во входе записи (НовыйВходЗаписи).
//
// Возвращаемое значение:
//  Структура - Найден (Булево), ТекстОтказа (Строка), КоличествоПерезаписать (Число - документов будет перезаписано; помеченные на удаление
//  не считаются, они не перезаписываются), КоличествоПроведенных (Число - из них проведенных: проведение будет отменено и проведено заново;
//  если не получится, документ останется непроведенным, а его движения исчезнут), КоличествоПомеченныхНаУдаление (Число - строки перезаписи,
//  которые не будут перезаписаны, потому что документ помечен на удаление).
Функция ДанныеПредупрежденияПерезаписи(АдресПлана, Выбранные) Экспорт

	Результат = Новый Структура("Найден, ТекстОтказа, КоличествоПерезаписать, КоличествоПроведенных, КоличествоПомеченныхНаУдаление",
		Ложь, "", 0, 0, 0);

	Пакет = ПланПакетаДляЗаписи(АдресПлана, Выбранные);
	Если Не Пакет.Найден Тогда
		Результат.ТекстОтказа = Пакет.ТекстОтказа;
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	СтрокиПерезаписи = Новый Массив;
	Для Каждого СтрокаПлана Из Пакет.План.Операции Цикл
		Если СтрокаПлана.Перезаписать И ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			СтрокиПерезаписи.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиПерезаписи.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ДанныеДокументов = ДанныеНайденныхДокументов(СтрокиПерезаписи);
	Ссылки = Новый Массив;
	Для Каждого СтрокаПлана Из СтрокиПерезаписи Цикл
		Данные = ДанныеДокументов.Получить(СтрокаПлана.ЗагруженныйДокумент);
		Если Данные = Неопределено Или Данные.ПометкаУдаления Тогда
			Результат.КоличествоПомеченныхНаУдаление = Результат.КоличествоПомеченныхНаУдаление + 1;
			Продолжить;
		КонецЕсли;
		Результат.КоличествоПерезаписать = Результат.КоличествоПерезаписать + 1;
		Ссылки.Добавить(СтрокаПлана.ЗагруженныйДокумент);
	КонецЦикла;

	Проведенные = ПроведенныеДокументы(Ссылки);
	Результат.КоличествоПроведенных = Проведенные.Количество();
	Возврат Результат;

КонецФункции

// Применяет результат записи к плану в хранилище и возвращает дельту проекции для таблицы формы (П-Г): для строк, чей документ появился или
// изменен записью, - найденный документ, его новая версия, отметка «Перезаписать» снята (если перезапись выполнена). «Загружать» для них
// недоступна (проекция считает ее от найденного документа), повторное «Загрузить» их не берет. Строки без изменений документа (отказ
// перезаписи, ошибка новой строки) не трогаются: версия документа в плане остается версией показа, и защита «изменен после показа» не гаснет.
// План в хранилище заменяется по тому же адресу.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Протокол - Структура - см. ЗаписатьПлан.
//
// Возвращаемое значение:
//  Структура - Найден (Булево), ТекстОтказа (Строка), Строки (ТаблицаЗначений - см. ПроекцияПлана, только измененные строки).
Функция ПрименитьРезультатЗаписи(АдресПлана, Протокол) Экспорт

	Результат = Новый Структура("Найден, ТекстОтказа, Строки", Ложь, "", НоваяТаблицаПроекции());

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	СтрокиДельты = Новый Массив;
	Для Каждого ДанныеДельты Из Протокол.Дельта Цикл
		СтрокаПлана = НайтиСтрокуПлана(План, ДанныеДельты.ПорядковыйНомер);
		Если СтрокаПлана = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПлана.ЗагруженныйДокумент = ДанныеДельты.Документ;
		СтрокаПлана.ВерсияДокумента = ДанныеДельты.ВерсияДокумента;
		Если ДанныеДельты.Перезаписан Тогда
			СтрокаПлана.Перезаписать = Ложь;
		КонецЕсли;
		СтрокиДельты.Добавить(СтрокаПлана);
	КонецЦикла;
	Если СтрокиДельты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПоместитьВоВременноеХранилище(План, АдресПлана);

	Замечания = ЗамечанияПоСтрокам(План.Замечания);
	ДанныеДокументов = ДанныеНайденныхДокументов(СтрокиДельты);
	Для Каждого СтрокаПлана Из СтрокиДельты Цикл
		СтрокаПроекции = Результат.Строки.Добавить();
		ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, Замечания.Получить(СтрокаПлана.ПорядковыйНомер), ДанныеДокументов);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Текст результата строки записи для человека по литералу результата (внутренние литералы людине не показываются, П-И). Для строки перезаписи
// с результатом «УжеЗагружен» уточняет причину по категории отказа. Неизвестный литерал показывается как есть.
//
// Параметры:
//  Литерал - Строка - СМП_ЗаписьДокументовБанка.Результат*.
//  КатегорияОтказа - Строка - см. ЗаписатьПлан (Строки.КатегорияОтказа); для остальных строк пусто.
//
// Возвращаемое значение:
//  Строка - текст на языке сеанса.
Функция ТекстРезультатаСтроки(Литерал, КатегорияОтказа = "")

	Если Литерал = СМП_ЗаписьДокументовБанка.РезультатСоздан() Тогда
		Возврат НСтр("ru = 'Создан и проведён'; uk = 'Створено і проведено'");
	ИначеЕсли Литерал = СМП_ЗаписьДокументовБанка.РезультатСозданНепроведенным() Тогда
		Возврат НСтр("ru = 'Создан, не проведён'; uk = 'Створено, не проведено'");
	ИначеЕсли Литерал = СМП_ЗаписьДокументовБанка.РезультатПерезаписан() Тогда
		Возврат НСтр("ru = 'Перезаписан и проведён'; uk = 'Перезаписано і проведено'");
	ИначеЕсли Литерал = СМП_ЗаписьДокументовБанка.РезультатПерезаписанНепроведенным() Тогда
		Возврат НСтр("ru = 'Перезаписан, не проведён'; uk = 'Перезаписано, не проведено'");
	ИначеЕсли Литерал = СМП_ЗаписьДокументовБанка.РезультатОшибка() Тогда
		Возврат НСтр("ru = 'Не записан'; uk = 'Не записано'");
	ИначеЕсли Литерал = СМП_ЗаписьДокументовБанка.РезультатУжеЗагружен() Тогда
		Если КатегорияОтказа = СМП_ЗаписьДокументовБанка.КатегорияОтказаПомеченНаУдаление() Тогда
			Возврат НСтр("ru = 'Не перезаписан: документ помечен на удаление'; uk = 'Не перезаписано: документ позначено на видалення'");
		ИначеЕсли КатегорияОтказа = СМП_ЗаписьДокументовБанка.КатегорияОтказаИзмененПослеПоказа() Тогда
			Возврат НСтр("ru = 'Не перезаписан: документ изменён после показа'; uk = 'Не перезаписано: документ змінено після показу'");
		ИначеЕсли КатегорияОтказа = СМП_ЗаписьДокументовБанка.КатегорияОтказаПрочее() Тогда
			Возврат НСтр("ru = 'Не перезаписан'; uk = 'Не перезаписано'");
		КонецЕсли;
		Возврат НСтр("ru = 'Уже загружен'; uk = 'Вже завантажено'");
	КонецЕсли;
	Возврат Литерал;

КонецФункции

// Запоминает статью ДДС строк плана там, откуда ее прочитает цепочка D14 (D13): в договоре, если контрагент ведет расчеты по договорам и
// договор известен, иначе в контрагенте. Условие «ведет расчеты по договорам» берется тем же правилом, что и при распознавании
// (СМП_РаспознаваниеОпераций.ПрочитатьУчетПоДоговорам). Запись - через объект вендорского справочника, один раз на уникальный договор /
// контрагента (пакет строк с одним договором - одна запись), и только если значение отличается. Контрагент или договор, которого еще нет
// (пусто или действие «Создать» / «Не создавать» / «Невозможно»), не записывается - причина возвращается. Пустая статья не запоминается.
// Исключение блокировки или записи не падение: человеку - короткий текст, подробности - в журнал регистрации (СМП.ЗагрузкаВыписки.ЗапомнитьСтатью).
// План не изменяется.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Ключи - Массив из Число - ПорядковыйНомер строк, статью которых запоминают (берется из плана).
//
// Возвращаемое значение:
//  Структура - итог запоминания:
//   * Записано - Число - записано объектов (договоров и контрагентов).
//   * Договоров - Число - из них договоров.
//   * Контрагентов - Число - из них контрагентов.
//   * БезИзменений - Число - объектов, у которых статья уже такая же (не записывались).
//   * Причины - Массив из Строка - тексты человеку: что и почему не записано.
Функция ЗапомнитьСтатьи(АдресПлана, Ключи)

	Результат = Новый Структура;
	Результат.Вставить("Записано", 0);
	Результат.Вставить("Договоров", 0);
	Результат.Вставить("Контрагентов", 0);
	Результат.Вставить("БезИзменений", 0);
	Результат.Вставить("Причины", Новый Массив);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.Причины.Добавить(НСтр("ru = 'План загрузки больше не доступен на сервере: статья не запомнена.';
			|uk = 'План завантаження більше не доступний на сервері: статтю не запам''ятовано.'"));
		Возврат Результат;
	КонецЕсли;

	// Строки, у которых нечего или некуда писать, считаются по причинам: одно сообщение на причину, а не на строку.
	БезСтатьи = 0;
	БезКонтрагента = 0;
	НеСуществует = 0;
	ЦелиКонтрагенты = Новый Соответствие;
	ЦелиДоговоры = Новый Соответствие;
	СтрокиКУчету = Новый Массив;
	Контрагенты = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		СтрокаПлана = НайтиСтрокуПлана(План, Ключ);
		Если СтрокаПлана = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.СтатьяДДС) Тогда
			БезСтатьи = БезСтатьи + 1;
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(СтрокаПлана.Контрагент) <> Тип("СправочникСсылка.Контрагенты") Или Не ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
			БезКонтрагента = БезКонтрагента + 1;
			Продолжить;
		КонецЕсли;
		Если ДействиеОбъектаЕщеНетВБазе(СтрокаПлана.ДействиеКонтрагент) Тогда
			НеСуществует = НеСуществует + 1;
			Продолжить;
		КонецЕсли;
		СтрокиКУчету.Добавить(СтрокаПлана);
		Если Контрагенты.Найти(СтрокаПлана.Контрагент) = Неопределено Тогда
			Контрагенты.Добавить(СтрокаПлана.Контрагент);
		КонецЕсли;
	КонецЦикла;

	УчетПоДоговорам = СМП_РаспознаваниеОпераций.ПрочитатьУчетПоДоговорам(Контрагенты);
	Для Каждого СтрокаПлана Из СтрокиКУчету Цикл
		ВедетРасчеты = УчетПоДоговорам.Получить(СтрокаПлана.Контрагент);
		Если ВедетРасчеты = Неопределено Тогда
			НеСуществует = НеСуществует + 1;
			Продолжить;
		КонецЕсли;
		ДоговорИзвестен = ТипЗнч(СтрокаПлана.Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов") И ЗначениеЗаполнено(СтрокаПлана.Договор)
			И Не ДействиеОбъектаЕщеНетВБазе(СтрокаПлана.ДействиеДоговор);
		Если ВедетРасчеты = Истина И ДоговорИзвестен Тогда
			ЦелиДоговоры.Вставить(СтрокаПлана.Договор, СтрокаПлана.СтатьяДДС);
		ИначеЕсли ВедетРасчеты = Истина И ДействиеОбъектаЕщеНетВБазе(СтрокаПлана.ДействиеДоговор) Тогда
			// Договор только будет создан (план: такой объект не записывается): статья в контрагента легла бы на все его договоры.
			НеСуществует = НеСуществует + 1;
		Иначе
			ЦелиКонтрагенты.Вставить(СтрокаПлана.Контрагент, СтрокаПлана.СтатьяДДС);
		КонецЕсли;
	КонецЦикла;

	Неудачи = Новый Массив;
	Для Каждого Цель Из ЦелиДоговоры Цикл
		ЗаписатьСтатьюВОбъект(Цель.Ключ, Цель.Значение, Результат, Неудачи);
	КонецЦикла;
	Для Каждого Цель Из ЦелиКонтрагенты Цикл
		ЗаписатьСтатьюВОбъект(Цель.Ключ, Цель.Значение, Результат, Неудачи);
	КонецЦикла;

	Если БезСтатьи > 0 Тогда
		Результат.Причины.Добавить(СтрШаблон(НСтр("ru = 'Строк с пустой статьей: %1 - пустая статья не запоминается.';
			|uk = 'Рядків з порожньою статтею: %1 - порожня стаття не запам''ятовується.'"), БезСтатьи));
	КонецЕсли;
	Если БезКонтрагента > 0 Тогда
		Результат.Причины.Добавить(СтрШаблон(НСтр("ru = 'Строк без контрагента: %1 - статью некуда записать.';
			|uk = 'Рядків без контрагента: %1 - статтю нікуди записати.'"), БезКонтрагента));
	КонецЕсли;
	Если НеСуществует > 0 Тогда
		Результат.Причины.Добавить(СтрШаблон(НСтр("ru = 'Строк, где контрагент еще не создан: %1 - статья запоминается только для существующих контрагентов и договоров.';
			|uk = 'Рядків, де контрагента ще не створено: %1 - стаття запам''ятовується лише для наявних контрагентів і договорів.'"), НеСуществует));
	КонецЕсли;
	Если Неудачи.Количество() > 0 Тогда
		Результат.Причины.Добавить(СтрШаблон(НСтр("ru = 'Не удалось записать статью (объект занят или запись отклонена): %1.';
			|uk = 'Не вдалося записати статтю (об''єкт зайнято або запис відхилено): %1.'"), СтрСоединить(Неудачи, "; ")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Данные карточки строки плана: факты банка, решения распознавания с источниками, замечания строки.
// Один серверный вызов на открытие карточки. План не изменяется.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//
// Возвращаемое значение:
//  Структура - данные карточки (значения - представления для показа, без внутренних литералов):
//   * Найдена - Булево - строка найдена; при Ложь остальные поля пусты, причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека, если строки нет.
//   * Заголовок - Строка - заголовок карточки.
//   * Факты - ТаблицаЗначений - факты банка, все колонки конверта кроме сырых данных:
//    ** Заголовок - Строка - название колонки.
//    ** Значение - Строка - значение.
//   * СырыеДанные - Строка - исходные данные операции как в источнике.
//   * Решения - ТаблицаЗначений - решения распознавания:
//    ** Заголовок - Строка - название колонки плана.
//    ** Значение - Строка - значение.
//    ** Источник - Строка - источник решения или действие записи; пусто, если у колонки их нет.
//   * Замечания - ТаблицаЗначений - замечания строки:
//    ** Поле - Строка - название поля плана или пусто.
//    ** Уровень - Строка - уровень замечания.
//    ** Текст - Строка - текст замечания.
Функция ДанныеСтрокиПлана(АдресПлана, ПорядковыйНомер) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найдена", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Факты", НоваяТаблицаСтрок("Заголовок, Значение"));
	Результат.Вставить("СырыеДанные", "");
	Результат.Вставить("Решения", НоваяТаблицаСтрок("Заголовок, Значение, Источник"));
	Результат.Вставить("Замечания", НоваяТаблицаСтрок("Поле, Уровень, Текст"));

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;

	СтрокаПлана = НайтиСтрокуПлана(План, ПорядковыйНомер);
	Если СтрокаПлана = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Строка не найдена в плане загрузки.'; uk = 'Рядок не знайдено в плані завантаження.'");
		Возврат Результат;
	КонецЕсли;

	Результат.Найдена = Истина;
	Результат.Заголовок = СтрШаблон(НСтр("ru = 'Строка выписки № %1'; uk = 'Рядок виписки № %1'"), Формат(ПорядковыйНомер, "ЧГ=0"));

	// Факты банка - колонки конверта из конструктора контракта: новая колонка контракта появляется сама.
	КолонкиФактов = Новый Массив;
	Для Каждого Колонка Из СМП_ВыпискаБанка.НоваяВыписка().Операции.Колонки Цикл
		КолонкиФактов.Добавить(Колонка.Имя);
		Если Колонка.Имя = "СырыеДанные" Тогда
			Результат.СырыеДанные = СтрокаПлана[Колонка.Имя];
			Продолжить;
		КонецЕсли;
		СтрокаФакта = Результат.Факты.Добавить();
		СтрокаФакта.Заголовок = ЗаголовокКолонкиПлана(Колонка.Имя);
		СтрокаФакта.Значение = ПредставлениеЗначенияПлана(СтрокаПлана[Колонка.Имя]);
	КонецЦикла;

	// Решения: остальные колонки плана; источник вида, статьи и действия записи показываются рядом со своим решением.
	РешениеИИсточник = Новый Соответствие;
	РешениеИИсточник.Вставить("ВидОперации", "ИсточникВидаОперации");
	РешениеИИсточник.Вставить("СтатьяДДС", "ИсточникСтатьи");
	РешениеИИсточник.Вставить("Корреспонденция", "ИсточникКорреспонденции");
	РешениеИИсточник.Вставить("Контрагент", "ДействиеКонтрагент");
	РешениеИИсточник.Вставить("СчетКонтрагента", "ДействиеСчет");
	РешениеИИсточник.Вставить("Договор", "ДействиеДоговор");
	КолонкиИсточников = Новый Массив;
	Для Каждого Элемент Из РешениеИИсточник Цикл
		КолонкиИсточников.Добавить(Элемент.Значение);
	КонецЦикла;

	Для Каждого Колонка Из План.Операции.Колонки Цикл
		Если КолонкиФактов.Найти(Колонка.Имя) <> Неопределено Или КолонкиИсточников.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРешения = Результат.Решения.Добавить();
		СтрокаРешения.Заголовок = ЗаголовокКолонкиПлана(Колонка.Имя);
		СтрокаРешения.Значение = ПредставлениеЗначенияПлана(СтрокаПлана[Колонка.Имя]);
		ИмяИсточника = РешениеИИсточник.Получить(Колонка.Имя);
		Если ИмяИсточника <> Неопределено Тогда
			СтрокаРешения.Источник = ТекстИсточникаРешения(ИмяИсточника, СтрокаПлана[ИмяИсточника]);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Замечание Из План.Замечания.НайтиСтроки(Новый Структура("ПорядковыйНомер", ПорядковыйНомер)) Цикл
		СтрокаЗамечания = Результат.Замечания.Добавить();
		СтрокаЗамечания.Поле = ?(ПустаяСтрока(Замечание.Поле), "", ЗаголовокКолонкиПлана(Замечание.Поле));
		СтрокаЗамечания.Уровень = ТекстУровняЗамечания(Замечание.Уровень);
		СтрокаЗамечания.Текст = Замечание.Текст;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Данные помощника реквизитов контрагента (4в) для одной строки плана: факты банка (только показ), текущие решения строки и признаки,
// от которых форма включает и выключает поля. Один серверный вызов на открытие помощника. План не изменяется. Правил учета здесь
// нет: нужен ли виду контрагент и договор отвечает СМП_РаспознаваниеОпераций.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//
// Возвращаемое значение:
//  Структура - данные помощника:
//   * Найдена - Булево - строку можно править помощником; при Ложь причина - в ТекстОтказа.
//   * ТекстОтказа - Строка - текст для человека (плана или строки нет, по строке найден загруженный документ).
//   * Заголовок - Строка - заголовок помощника.
//   * Наименование, Код, НомерСчета, МФО - Строка - факты банка о контрагенте (как в конверте).
//   * Контрагент - СправочникСсылка.Контрагенты - контрагент строки (пусто, если не определен или это сотрудник).
//   * ЭтоСотрудник - Булево - контрагент строки - сотрудник: помощник его не меняет.
//   * СчетКонтрагента - СправочникСсылка.БанковскиеСчета, Договор - СправочникСсылка.ДоговорыКонтрагентов - текущие счет и договор.
//   * БанкНовогоСчета - СправочникСсылка.Банки - банк нового счета, выбранный человеком ранее.
//   * НеСоздаватьСейчас - Булево - у контрагента строки действие "НеСоздавать" (решение человека).
//   * КонтрагентНайден - Булево - у контрагента строки действие "Найден".
//   * ТребуетсяКонтрагент, ТребуетсяДоговор - Булево - нужен ли виду операции строки контрагент и договор.
//   * Состояние - Строка - текущее решение по контрагенту, счету и договору для показа.
Функция ДанныеПомощникаКонтрагента(АдресПлана, ПорядковыйНомер) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Найдена", Ложь);
	Результат.Вставить("ТекстОтказа", "");
	Результат.Вставить("Заголовок", "");
	Результат.Вставить("Наименование", "");
	Результат.Вставить("Код", "");
	Результат.Вставить("НомерСчета", "");
	Результат.Вставить("МФО", "");
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("ЭтоСотрудник", Ложь);
	Результат.Вставить("СчетКонтрагента", Справочники.БанковскиеСчета.ПустаяСсылка());
	Результат.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Результат.Вставить("БанкНовогоСчета", Справочники.Банки.ПустаяСсылка());
	Результат.Вставить("МФОСчета", "");
	Результат.Вставить("БанкПоМФО", Справочники.Банки.ПустаяСсылка());
	Результат.Вставить("НеСоздаватьСейчас", Ложь);
	Результат.Вставить("КонтрагентНайден", Ложь);
	Результат.Вставить("ТребуетсяКонтрагент", Ложь);
	Результат.Вставить("ТребуетсяДоговор", Ложь);
	Результат.Вставить("Состояние", "");

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;

	СтрокаПлана = НайтиСтрокуПлана(План, ПорядковыйНомер);
	Если СтрокаПлана = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Строка не найдена в плане загрузки.'; uk = 'Рядок не знайдено в плані завантаження.'");
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
		Результат.ТекстОтказа = НСтр("ru = 'По строке найден загруженный документ: реквизиты контрагента к ней не применяются.';
			|uk = 'За рядком знайдено завантажений документ: реквізити контрагента до неї не застосовуються.'");
		Возврат Результат;
	КонецЕсли;

	Результат.Найдена = Истина;
	Результат.Заголовок = СтрШаблон(НСтр("ru = 'Реквизиты контрагента: строка выписки № %1'; uk = 'Реквізити контрагента: рядок виписки № %1'"),
		Формат(ПорядковыйНомер, "ЧГ=0"));
	Результат.Наименование = СтрокаПлана.КонтрагентНаименование;
	Результат.Код = СтрокаПлана.КонтрагентКод;
	Результат.НомерСчета = СтрокаПлана.КонтрагентНомерСчета;
	Результат.МФО = СтрокаПлана.КонтрагентМФО;

	Если ТипЗнч(СтрокаПлана.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Результат.Контрагент = СтрокаПлана.Контрагент;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПлана.Контрагент) Тогда
		Результат.ЭтоСотрудник = Истина;
	КонецЕсли;
	Результат.СчетКонтрагента = СтрокаПлана.СчетКонтрагента;
	Результат.Договор = СтрокаПлана.Договор;
	Результат.БанкНовогоСчета = СтрокаПлана.БанкНовогоСчета;
	// Банк нового счета выбирается только среди банков с МФО номера счета (вендор иной банк отклонит); единственный такой банк - он и
	// есть, выбирать не нужно (тот же поиск, что у записи).
	Результат.МФОСчета = СМП_ЗаписьДокументовБанка.МФОСчетаКонтрагента(
		СМП_ВыпискаБанка.НормализованныйНомерСчета(СтрокаПлана.КонтрагентНомерСчета), СтрокаПлана.КонтрагентМФО);
	Если Не ПустаяСтрока(Результат.МФОСчета) Тогда
		Причина = "";
		Банк = СМП_ЗаписьДокументовБанка.БанкПоМФО(Результат.МФОСчета, Причина);
		Если Банк <> Неопределено Тогда
			Результат.БанкПоМФО = Банк;
		КонецЕсли;
	КонецЕсли;
	Результат.НеСоздаватьСейчас = СтрокаПлана.ДействиеКонтрагент = СМП_РаспознаваниеОпераций.ДействиеНеСоздавать();
	Результат.КонтрагентНайден = СтрокаПлана.ДействиеКонтрагент = СМП_РаспознаваниеОпераций.ДействиеНайден();
	Если ЗначениеЗаполнено(СтрокаПлана.ВидОперации) Тогда
		Результат.ТребуетсяКонтрагент = СМП_РаспознаваниеОпераций.ВидОперацииТребуетКонтрагента(СтрокаПлана.ВидОперации);
		Результат.ТребуетсяДоговор = СМП_РаспознаваниеОпераций.ВидОперацииТребуетДоговор(СтрокаПлана.ВидОперации);
	КонецЕсли;

	Результат.Состояние = СтрШаблон(НСтр("ru = 'Сейчас: контрагент - %1; счет - %2; договор - %3.';
		|uk = 'Зараз: контрагент - %1; рахунок - %2; договір - %3.'"),
		ТекстДействияДляПомощника(СтрокаПлана.ДействиеКонтрагент), ТекстДействияДляПомощника(СтрокаПлана.ДействиеСчет),
		ТекстДействияДляПомощника(СтрокаПлана.ДействиеДоговор));

	Возврат Результат;

КонецФункции

// Значения заполнения для вендорской формы нового контрагента, счета или договора, которую помощник открывает по «создать сейчас» (D10).
// Объект создает и записывает форма вендора (как человек создал бы его сам); здесь - только подготовка значений, не создание.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//  Что - Строка - "Контрагент", "СчетКонтрагента" или "Договор".
//  Контрагент - СправочникСсылка.Контрагенты - владелец нового счета или договора; для "Контрагент" не нужен.
//  Банк - СправочникСсылка.Банки - банк нового счета, выбранный человеком; пусто - банк по МФО операции, если он определяется однозначно.
//
// Возвращаемое значение:
//  Структура - значения заполнения (ключи - реквизиты создаваемого объекта); пустая, если строки нет или значение "Что" неизвестно.
Функция ЗначенияЗаполненияДляСоздания(АдресПлана, ПорядковыйНомер, Что, Контрагент, Банк) Экспорт

	Значения = Новый Структура;
	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;
	СтрокаПлана = НайтиСтрокуПлана(План, ПорядковыйНомер);
	Если СтрокаПлана = Неопределено Тогда
		Возврат Значения;
	КонецЕсли;

	Если Что = "Контрагент" Тогда
		Название = СокрЛП(СтрокаПлана.КонтрагентНаименование);
		Если Не ПустаяСтрока(Название) Тогда
			Значения.Вставить("Наименование", Лев(Название, Метаданные.Справочники.Контрагенты.ДлинаНаименования));
			Значения.Вставить("НаименованиеПолное", Название);
		КонецЕсли;
		// Код - ключами поиска контрагента: пригодным считается код из 8 (ЕДРПОУ) или 10 (РНОКПП) цифр, как при создании записью.
		Код = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Код;
		Если Код.Использовать Тогда
			Для Каждого Элемент Из СМП_ЗаписьДокументовБанка.ЗначенияКонтрагентаПоКоду(Код.Нормализованный) Цикл
				Значения.Вставить(Элемент.Ключ, Элемент.Значение);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Что = "СчетКонтрагента" Тогда
		Значения.Вставить("Владелец", Контрагент);
		Значения.Вставить("НомерСчета", СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Номер);
		БанкСчета = Банк;
		Если Не ЗначениеЗаполнено(БанкСчета) Тогда
			Причина = "";
			БанкСчета = СМП_ЗаписьДокументовБанка.БанкПоМФО(СокрЛП(СтрокаПлана.КонтрагентМФО), Причина);
		КонецЕсли;
		Если ЗначениеЗаполнено(БанкСчета) Тогда
			Значения.Вставить("Банк", БанкСчета);
		КонецЕсли;
	ИначеЕсли Что = "Договор" Тогда
		Значения.Вставить("Владелец", Контрагент);
		Значения.Вставить("Организация", СтрокаПлана.Организация);
		Если ЗначениеЗаполнено(СтрокаПлана.ВидОперации) Тогда
			Виды = СМП_РаспознаваниеОпераций.ВидыДоговораДляВидаОперации(СтрокаПлана.ВидОперации);
			Если Виды.Количество() > 0 Тогда
				Значения.Вставить("ВидДоговора", Виды[0]);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) Тогда
			Значения.Вставить("ВалютаРасчетов", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПлана.БанковскийСчет, "ВалютаДенежныхСредств"));
		КонецЕсли;
	КонецЕсли;

	Возврат Значения;

КонецФункции

// Счет контрагента с номером из строки плана: находит счет, который человек только что создал формой вендора («создать сейчас»), чтобы
// помощник подставил его выбранным. Номер сравнивается так, как его ищет распознавание (нормализованный; текущий предпочтительнее устаревшего).
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//  Контрагент - СправочникСсылка.Контрагенты - владелец счета.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - найденный счет; пустая ссылка, если счета нет.
Функция СчетКонтрагентаСтроки(АдресПлана, ПорядковыйНомер, Контрагент) Экспорт

	Пусто = Справочники.БанковскиеСчета.ПустаяСсылка();
	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Или Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Пусто;
	КонецЕсли;
	СтрокаПлана = НайтиСтрокуПлана(План, ПорядковыйНомер);
	Если СтрокаПлана = Неопределено Тогда
		Возврат Пусто;
	КонецЕсли;
	Номер = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана).Номер;
	Если ПустаяСтрока(Номер) Тогда
		Возврат Пусто;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.НомерСчетаУстаревший КАК НомерСчетаУстаревший
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Владелец = &Контрагент
		|	И НЕ Счета.ПометкаУдаления
		|	И НЕ Счета.Недействителен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Устаревший = Пусто;
	Пока Выборка.Следующий() Цикл
		Если СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчета) = Номер Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Устаревший)
			И СМП_ВыпискаБанка.НормализованныйНомерСчета(Выборка.НомерСчетаУстаревший) = Номер Тогда
			Устаревший = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Устаревший;

КонецФункции

// Команда формы "Заполнить типовыми правилами": один серверный вызов; правила и фразы - в СМП_РаспознаваниеОпераций.
// Нет права добавлять в справочник правил - команда не прячется, человек видит причину. Текст исключения человеку не
// показывается, подробности идут в журнал регистрации.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Добавлено - Число
//   * Текст - Строка - текст человеку на языке интерфейса.
Функция ЗаполнитьТиповыеПравилаДляФормы() Экспорт

	Результат = Новый Структура("Успех, Добавлено, Текст", Ложь, 0, "");

	Если Не ПравоДоступа("Добавление", Метаданные.Справочники.СоответствияНазначенийПлатежаИРеквизитовПлатежа) Тогда
		Результат.Текст = НСтр("ru = 'Недостаточно прав для добавления правил по назначению платежа. Обратитесь к администратору.';
			|uk = 'Недостатньо прав для додавання правил за призначенням платежу. Зверніться до адміністратора.'");
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Добавлено = СМП_РаспознаваниеОпераций.ЗаполнитьТиповыеПравила();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.ТиповыеПравила'; uk = 'СМП.ЗагрузкаВыписки.ТиповіПравила'"),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Текст = НСтр("ru = 'Не удалось заполнить типовые правила. Подробности записаны в журнал регистрации.';
			|uk = 'Не вдалося заповнити типові правила. Подробиці записано в журнал реєстрації.'");
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = Истина;
	Если Результат.Добавлено = 0 Тогда
		Результат.Текст = НСтр("ru = 'Новых правил нет: типовые фразы уже есть в справочнике.';
			|uk = 'Нових правил немає: типові фрази вже є в довіднику.'");
	Иначе
		Результат.Текст = СтрШаблон(НСтр("ru = 'Добавлено правил: %1.'; uk = 'Додано правил: %1.'"), Результат.Добавлено);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Текст уровня замечания; неизвестный уровень показывается как есть. Одна реализация для карточки строки и формы завершения.
Функция ТекстУровняЗамечания(Уровень) Экспорт

	Если Уровень = СМП_ВыпискаБанка.УровеньОшибка() Тогда
		Возврат НСтр("ru = 'Ошибка'; uk = 'Помилка'");
	ИначеЕсли Уровень = СМП_ВыпискаБанка.УровеньПредупреждение() Тогда
		Возврат НСтр("ru = 'Предупреждение'; uk = 'Попередження'");
	КонецЕсли;
	Возврат Уровень;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объекта, на который указывает действие плана, еще нет в базе (он будет создан при загрузке или не создается / не определен).
Функция ДействиеОбъектаЕщеНетВБазе(Действие)

	Возврат Действие = СМП_РаспознаваниеОпераций.ДействиеСоздать()
		Или Действие = СМП_РаспознаваниеОпераций.ДействиеНеСоздавать()
		Или Действие = СМП_РаспознаваниеОпераций.ДействиеНевозможно();

КонецФункции

// Записывает статью по умолчанию в договор или контрагента, если она отличается. Объект блокируется на время записи; исключение не
// пробрасывается: подробности - в журнал регистрации, представление объекта - в Неудачи.
Процедура ЗаписатьСтатьюВОбъект(Ссылка, Статья, Итог, Неудачи)

	Заблокирован = Ложь;
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ссылка);
		Заблокирован = Истина;
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			// Объект удален между чтением плана и записью: для человека это «не записан».
			Неудачи.Добавить(Строка(Ссылка));
		ИначеЕсли Объект.СтатьяДДСПоУмолчанию = Статья Тогда
			Итог.БезИзменений = Итог.БезИзменений + 1;
		Иначе
			Объект.СтатьяДДСПоУмолчанию = Статья;
			Объект.Записать();
			Итог.Записано = Итог.Записано + 1;
			Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
				Итог.Договоров = Итог.Договоров + 1;
			Иначе
				Итог.Контрагентов = Итог.Контрагентов + 1;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Неудачи.Добавить(Строка(Ссылка));
		ЗаписьЖурналаРегистрации("СМП.ЗагрузкаВыписки.ЗапомнитьСтатью", УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Заблокирован Тогда
		Попытка
			РазблокироватьДанныеДляРедактирования(Ссылка);
		Исключение
			ЗаписьЖурналаРегистрации("СМП.ЗагрузкаВыписки.ЗапомнитьСтатью", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Текст человеку по итогу ЗапомнитьСтатьи: что записано и причины незаписанного, по строке на сообщение.
Функция ТекстЗапоминанияСтатьи(Запоминание)

	Тексты = Новый Массив;
	Если Запоминание.Записано > 0 Тогда
		Тексты.Добавить(СтрШаблон(НСтр("ru = 'Статья запомнена: договоров - %1, контрагентов - %2.';
			|uk = 'Статтю запам''ятовано: договорів - %1, контрагентів - %2.'"), Запоминание.Договоров, Запоминание.Контрагентов));
	ИначеЕсли Запоминание.Причины.Количество() = 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Статья в договоре или у контрагента уже такая же.';
			|uk = 'Стаття в договорі або в контрагента вже така сама.'"));
	КонецЕсли;
	Для Каждого Причина Из Запоминание.Причины Цикл
		Тексты.Добавить(Причина);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Текст действия записи над контрагентом, счетом или договором для показа в помощнике; пустое действие - "не определено".
Функция ТекстДействияДляПомощника(Действие)

	Если ПустаяСтрока(Действие) Тогда
		Возврат НСтр("ru = 'не определено'; uk = 'не визначено'");
	КонецЕсли;
	Возврат ТекстИсточникаРешения("Действие", Действие);

КонецФункции

// Текст человеку, когда плана по адресу больше нет.
Функция ТекстПланНеДоступен()

	Возврат НСтр("ru = 'План загрузки больше не доступен на сервере. Прочитайте файл ещё раз.';
		|uk = 'План завантаження більше не доступний на сервері. Прочитайте файл ще раз.'");

КонецФункции

// Строка плана по ключу (ПорядковыйНомер) или Неопределено.
Функция НайтиСтрокуПлана(План, ПорядковыйНомер)

	Возврат План.Операции.Найти(ПорядковыйНомер, "ПорядковыйНомер");

КонецФункции

// План загрузки из временного хранилища или Неопределено, если адрес недействителен (конец сеанса,
// перезапуск) или по адресу лежит не план: вызывающий показывает текст «прочитайте файл ещё раз» (П-Г).
Функция ПланИзВременногоХранилища(АдресПлана)

	Если ПустаяСтрока(АдресПлана) Или Не ЭтоАдресВременногоХранилища(АдресПлана) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		План = ПолучитьИзВременногоХранилища(АдресПлана);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(План) <> Тип("Структура") Или Не План.Свойство("Операции") Или Не План.Свойство("Замечания") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат План;

КонецФункции

// Заполняет строку проекции по строке плана (одна реализация для ПроекцияПлана и дельты правки).
//
// Параметры:
//  СтрокаПроекции - СтрокаТаблицыЗначений - строка НоваяТаблицаПроекции.
//  СтрокаПлана - СтрокаТаблицыЗначений - строка плана.
//  ДанныеЗамечаний - Структура, Неопределено - свернутые замечания строки (ЗамечанияПоСтрокам); Неопределено - замечаний нет.
//  ДанныеДокументов - Соответствие - см. ДанныеНайденныхДокументов.
Процедура ЗаполнитьСтрокуПроекции(СтрокаПроекции, СтрокаПлана, ДанныеЗамечаний, ДанныеДокументов)

	СтрокаПроекции.ПорядковыйНомер = СтрокаПлана.ПорядковыйНомер;
	СтрокаПроекции.НомерДокумента = СтрокаПлана.НомерДокумента;
	СтрокаПроекции.ДатаДокумента = СтрокаПлана.ДатаДокумента;
	Если СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеПоступило() Тогда
		СтрокаПроекции.СуммаПоступление = СтрокаПлана.Сумма;
	ИначеЕсли СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеСписано() Тогда
		СтрокаПроекции.СуммаСписание = СтрокаПлана.Сумма;
	КонецЕсли;

	СтрокаПроекции.КонтрагентНаименование = СтрокаПлана.КонтрагентНаименование;
	СтрокаПроекции.Контрагент = СтрокаПлана.Контрагент;
	СтрокаПроекции.КонтрагентПредставление = ?(ЗначениеЗаполнено(СтрокаПлана.Контрагент),
		Строка(СтрокаПлана.Контрагент), СтрокаПлана.КонтрагентНаименование);
	СтрокаПроекции.НазначениеПлатежа = СтрокаПлана.НазначениеПлатежа;
	СтрокаПроекции.ВидОперации = СтрокаПлана.ВидОперации;
	СтрокаПроекции.СтатьяДДС = СтрокаПлана.СтатьяДДС;
	СтрокаПроекции.Корреспонденция = СтрокаПлана.Корреспонденция;
	СтрокаПроекции.Договор = СтрокаПлана.Договор;
	СтрокаПроекции.СчетКонтрагента = СтрокаПлана.СчетКонтрагента;
	СтрокаПроекции.ПлатежноеПоручение = СтрокаПлана.ПлатежноеПоручение;
	СтрокаПроекции.Основа = ?(ЗначениеЗаполнено(СтрокаПлана.ДокументПоНомеру), Строка(СтрокаПлана.ДокументПоНомеру), "");
	СтрокаПроекции.ПроверьтеОперацию = СтрокаПлана.ПроверьтеОперацию;
	СтрокаПроекции.СпособЗачета = СтрокаПлана.СпособЗачета;
	СтрокаПроекции.ОсноваДоступна = СтрокаПлана.СпособЗачета <> Перечисления.СпособыЗачетаИРаспределенияПлатежей.Авто;
	СтрокаПроекции.СтрокаНеЗаписывается = ПустаяСтрока(СтрокаПлана.ВидДокумента);

	СтрокаПроекции.ЗагруженныйДокумент = СтрокаПлана.ЗагруженныйДокумент;
	ЕстьДокумент = ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент);
	Если ЕстьДокумент Тогда
		ДанныеДокумента = ДанныеДокументов.Получить(СтрокаПлана.ЗагруженныйДокумент);
		Если ДанныеДокумента <> Неопределено Тогда
			СтрокаПроекции.ЗагруженныйПомеченНаУдаление = ДанныеДокумента.ПометкаУдаления;
		КонецЕсли;
	КонецЕсли;
	// Версия - та, что зафиксировало распознавание (запись сверяет ее с версией в момент записи), а не текущая.
	СтрокаПроекции.ВерсияДокумента = СтрокаПлана.ВерсияДокумента;

	// Отметки (D5): найденные не отмечаются к загрузке; перезапись помеченного на удаление недоступна, а у уже отмеченной строки
	// доступна всегда - отметку можно снять.
	СтрокаПроекции.Загружать = Не ЕстьДокумент;
	СтрокаПроекции.ЗагружатьДоступно = Не ЕстьДокумент;
	СтрокаПроекции.Перезаписать = СтрокаПлана.Перезаписать;
	СтрокаПроекции.ПерезаписатьДоступно = ЕстьДокумент И (СтрокаПлана.Перезаписать Или Не СтрокаПроекции.ЗагруженныйПомеченНаУдаление);

	Если ДанныеЗамечаний <> Неопределено Тогда
		СтрокаПроекции.КоличествоЗамечаний = ДанныеЗамечаний.Количество;
		СтрокаПроекции.ЕстьОшибка = ДанныеЗамечаний.ЕстьОшибка;
		СтрокаПроекции.ЕстьПредупреждение = ДанныеЗамечаний.ЕстьПредупреждение;
		СтрокаПроекции.УровеньЗамечаний = ?(ДанныеЗамечаний.ЕстьОшибка, СМП_ВыпискаБанка.УровеньОшибка(),
			СМП_ВыпискаБанка.УровеньПредупреждение());
	КонецЕсли;

КонецПроцедуры

// Ключи строк плана для режима «все с тем же кодом и счетом»: переданные ключи и все остальные строки без найденного документа, у
// которых совпадают нормализованные номер счета и код контрагента из банка с хотя бы одной из переданных строк (те же ключи, что у
// поиска контрагента, СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента). Пустая пара (ни кода, ни номера) строки не объединяет.
Функция КлючиСТемЖеКодомИСчетом(План, Ключи)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Образцы = Новый Соответствие;

	Для Каждого Ключ Из Ключи Цикл
		Если Добавленные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Ключ, Истина);
		Результат.Добавить(Ключ);
		Найденная = НайтиСтрокуПлана(План, Ключ);
		Если Найденная <> Неопределено Тогда
			Образец = КлючКодаИСчета(Найденная);
			Если Не ПустаяСтрока(Образец) Тогда
				Образцы.Вставить(Образец, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаПлана Из План.Операции Цикл
		Если Добавленные.Получить(СтрокаПлана.ПорядковыйНомер) <> Неопределено
			Или (ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) И Не СтрокаПлана.Перезаписать) Тогда
			Продолжить;
		КонецЕсли;
		Образец = КлючКодаИСчета(СтрокаПлана);
		Если Не ПустаяСтрока(Образец) И Образцы.Получить(Образец) <> Неопределено Тогда
			Добавленные.Вставить(СтрокаПлана.ПорядковыйНомер, Истина);
			Результат.Добавить(СтрокаПлана.ПорядковыйНомер);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Составной ключ «номер счета | код» строки плана (нормализованные); пусто, если нет ни номера, ни кода.
Функция КлючКодаИСчета(СтрокаПлана)

	Ключи = СМП_РаспознаваниеОпераций.КлючиПоискаКонтрагента(СтрокаПлана);
	Код = ?(Ключи.Код.Использовать, Ключи.Код.Нормализованный, ВРег(СокрЛП(СтрокаПлана.КонтрагентКод)));
	Если ПустаяСтрока(Ключи.Номер) И ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ключи.Номер + "|" + Код;

КонецФункции

// Таблица проекции плана для формы, см. ПроекцияПлана.
Функция НоваяТаблицаПроекции()

	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

	Таблица = Новый ТаблицаЗначений;
	Колонки = Таблица.Колонки;
	Колонки.Добавить("Загружать", ТипБулево);
	Колонки.Добавить("ЗагружатьДоступно", ТипБулево);
	Колонки.Добавить("Перезаписать", ТипБулево);
	Колонки.Добавить("ПерезаписатьДоступно", ТипБулево);
	Колонки.Добавить("ПорядковыйНомер", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Колонки.Добавить("НомерДокумента", ТипСтрока);
	Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Колонки.Добавить("СуммаПоступление", ТипСумма);
	Колонки.Добавить("СуммаСписание", ТипСумма);
	Колонки.Добавить("КонтрагентНаименование", ТипСтрока);
	Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты, СправочникСсылка.Сотрудники"));
	Колонки.Добавить("КонтрагентПредставление", ТипСтрока);
	Колонки.Добавить("НазначениеПлатежа", ТипСтрока);
	Колонки.Добавить("ВидОперации", Новый ОписаниеТипов(
		"ПеречислениеСсылка.ВидыОперацийПоступлениеНаСчет, ПеречислениеСсылка.ВидыОперацийРасходСоСчета"));
	Колонки.Добавить("СтатьяДДС", Новый ОписаниеТипов("СправочникСсылка.СтатьиДвиженияДенежныхСредств"));
	Колонки.Добавить("Корреспонденция", Новый ОписаниеТипов("ПланСчетовСсылка.Управленческий"));
	Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	Колонки.Добавить("СчетКонтрагента", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Колонки.Добавить("ПлатежноеПоручение", Новый ОписаниеТипов("ДокументСсылка.ПлатежноеПоручение"));
	Колонки.Добавить("Основа", ТипСтрока);
	Колонки.Добавить("ЗагруженныйДокумент", Новый ОписаниеТипов(
		"ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета"));
	Колонки.Добавить("ЗагруженныйПомеченНаУдаление", ТипБулево);
	Колонки.Добавить("ВерсияДокумента", ТипСтрока);
	Колонки.Добавить("ПроверьтеОперацию", ТипБулево);
	Колонки.Добавить("СпособЗачета", Новый ОписаниеТипов("ПеречислениеСсылка.СпособыЗачетаИРаспределенияПлатежей"));
	Колонки.Добавить("ОсноваДоступна", ТипБулево);
	Колонки.Добавить("УровеньЗамечаний", ТипСтрока);
	Колонки.Добавить("ЕстьОшибка", ТипБулево);
	Колонки.Добавить("ЕстьПредупреждение", ТипБулево);
	Колонки.Добавить("КоличествоЗамечаний", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Колонки.Добавить("СтрокаНеЗаписывается", ТипБулево);
	Возврат Таблица;

КонецФункции

// Таблица из строковых колонок; имена - через запятую.
Функция НоваяТаблицаСтрок(ИменаКолонок)

	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить(ИменаКолонок, ",", Ложь) Цикл
		Таблица.Колонки.Добавить(СокрЛП(Имя), Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Замечания плана, свернутые по номеру операции: число замечаний и наличие каждого уровня.
// Номер 0 (замечание не к строке) в строки не попадает.
//
// Возвращаемое значение:
//  Соответствие - ПорядковыйНомер -> Структура (Количество, ЕстьОшибка, ЕстьПредупреждение).
Функция ЗамечанияПоСтрокам(Замечания)

	Результат = Новый Соответствие;
	УровеньОшибка = СМП_ВыпискаБанка.УровеньОшибка();
	УровеньПредупреждение = СМП_ВыпискаБанка.УровеньПредупреждение();

	Для Каждого Замечание Из Замечания Цикл
		Данные = Результат.Получить(Замечание.ПорядковыйНомер);
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Количество, ЕстьОшибка, ЕстьПредупреждение", 0, Ложь, Ложь);
			Результат.Вставить(Замечание.ПорядковыйНомер, Данные);
		КонецЕсли;
		Данные.Количество = Данные.Количество + 1;
		Если Замечание.Уровень = УровеньОшибка Тогда
			Данные.ЕстьОшибка = Истина;
		ИначеЕсли Замечание.Уровень = УровеньПредупреждение Тогда
			Данные.ЕстьПредупреждение = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пометка на удаление и версия данных найденных документов: один запрос на весь план.
//
// Возвращаемое значение:
//  Соответствие - ссылка на документ -> Структура (ПометкаУдаления, ВерсияДанных).
Функция ДанныеНайденныхДокументов(Операции)

	Результат = Новый Соответствие;

	Ссылки = Новый Массив;
	Для Каждого СтрокаПлана Из Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент) Тогда
			Ссылки.Добавить(СтрокаПлана.ЗагруженныйДокумент);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.ПометкаУдаления КАК ПометкаУдаления,
		|	Документы.ВерсияДанных КАК ВерсияДанных
		|ИЗ
		|	Документ.ПоступлениеНаСчет КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документы.Ссылка,
		|	Документы.ПометкаУдаления,
		|	Документы.ВерсияДанных
		|ИЗ
		|	Документ.РасходСоСчета КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Новый Структура("ПометкаУдаления, ВерсияДанных",
			Выборка.ПометкаУдаления, Выборка.ВерсияДанных));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Остаток на счете в учете - вендорской функцией, которую кличет и старая форма загрузки. Функция принимает
// счет и организацию и возвращает остаток на текущий момент (даты у нее нет); они берутся из плана - факты
// выбранного счета, которые распознавание ставит в каждую строку. Нет строк или счета - остатка нет.
//
// Возвращаемое значение:
//  Структура - ЕстьОстаток (Булево), Остаток (Число).
Функция ОстатокНаСчетеВУчете(Операции)

	Результат = Новый Структура("ЕстьОстаток, Остаток", Ложь, 0);

	БанковскийСчет = Неопределено;
	Организация = Неопределено;
	Для Каждого СтрокаПлана Из Операции Цикл
		Если ЗначениеЗаполнено(СтрокаПлана.БанковскийСчет) И ЗначениеЗаполнено(СтрокаПлана.Организация) Тогда
			БанковскийСчет = СтрокаПлана.БанковскийСчет;
			Организация = СтрокаПлана.Организация;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если БанковскийСчет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Остаток = ДвиженияДенежныхСредствВызовСервера.ПолучитьОстатокНаСчете(БанковскийСчет, Организация);
		Результат.ЕстьОстаток = Истина;
	Исключение
		// Остаток - справочная цифра: сбой вендорской функции не мешает показать план. Текст исключения
		// человеку не показывается, подробности - в журнал регистрации.
		ЗаписьЖурналаРегистрации(НСтр("ru = 'СМП.ЗагрузкаВыписки.ОстатокНаСчете'; uk = 'СМП.ЗагрузкаВыписки.ЗалишокНаРахунку'"),
			УровеньЖурналаРегистрации.Предупреждение, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;

КонецФункции

