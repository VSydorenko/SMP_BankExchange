КонецФункции

// Значение колонки плана для показа: ссылки и даты - представлением, пустое - пустой строкой, Булево - «Да»/«Нет».
Функция ПредставлениеЗначенияПлана(Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, НСтр("ru = 'Да'; uk = 'Так'"), НСтр("ru = 'Нет'; uk = 'Ні'"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Строка(Значение);
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Текст источника решения или действия записи по литералу плана; неизвестный литерал показывается как есть
// (новый литерал в расчете не теряется). Пустой литерал - пустой текст.
//
// Параметры:
//  ИмяКолонки - Строка - колонка плана: ИсточникВидаОперации, ИсточникСтатьи, ИсточникКорреспонденции или Действие*.
//  Литерал - Строка - значение колонки.
Функция ТекстИсточникаРешения(ИмяКолонки, Литерал)

	Если ПустаяСтрока(Литерал) Тогда
		Возврат "";
	КонецЕсли;

	Тексты = Новый Соответствие;
	Если ИмяКолонки = "ИсточникВидаОперации" Тогда
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникЗагруженныйДокумент(), НСтр("ru = 'найденный документ'; uk = 'знайдений документ'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСвойСчет(), НСтр("ru = 'перевод между своими счетами'; uk = 'переказ між своїми рахунками'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникНашаОрганизация(), НСтр("ru = 'другая наша организация'; uk = 'інша наша організація'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСотрудник(), НСтр("ru = 'сотрудник'; uk = 'працівник'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникПлатежноеПоручение(), НСтр("ru = 'платежное поручение'; uk = 'платіжне доручення'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникПравилоНазначения(), НСтр("ru = 'правило по назначению платежа'; uk = 'правило за призначенням платежу'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникДокументПоНомеру(), НСтр("ru = 'документ по номеру'; uk = 'документ за номером'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникПоУмолчанию(), НСтр("ru = 'по умолчанию'; uk = 'за замовчуванням'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникЧеловек(), НСтр("ru = 'выбор человека'; uk = 'вибір людини'"));
	ИначеЕсли ИмяКолонки = "ИсточникСтатьи" Тогда
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиПлатежноеПоручение(), НСтр("ru = 'платежное поручение'; uk = 'платіжне доручення'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиПравилоНазначения(), НСтр("ru = 'правило по назначению платежа'; uk = 'правило за призначенням платежу'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиДоговор(), НСтр("ru = 'договор'; uk = 'договір'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиКонтрагент(), НСтр("ru = 'контрагент'; uk = 'контрагент'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиПоВидуОперации(), НСтр("ru = 'по виду операции'; uk = 'за видом операції'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникСтатьиЧеловек(), НСтр("ru = 'выбор человека'; uk = 'вибір людини'"));
	ИначеЕсли ИмяКолонки = "ИсточникКорреспонденции" Тогда
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникКорреспонденцииПлатежноеПоручение(), НСтр("ru = 'платежное поручение'; uk = 'платіжне доручення'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникКорреспонденцииПравилоНазначения(), НСтр("ru = 'правило по назначению платежа'; uk = 'правило за призначенням платежу'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникКорреспонденцииПоВидуОперации(), НСтр("ru = 'по виду операции'; uk = 'за видом операції'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ИсточникКорреспонденцииЧеловек(), НСтр("ru = 'выбор человека'; uk = 'вибір людини'"));
	Иначе
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ДействиеНайден(), НСтр("ru = 'найден в базе'; uk = 'знайдено в базі'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ДействиеСоздать(), НСтр("ru = 'будет создан при записи'; uk = 'буде створено під час запису'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ДействиеНеТребуется(), НСтр("ru = 'не требуется'; uk = 'не потрібно'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ДействиеНевозможно(), НСтр("ru = 'нужен, но данных для создания не хватает'; uk = 'потрібен, але даних для створення не вистачає'"));
		Тексты.Вставить(СМП_РаспознаваниеОпераций.ДействиеНеСоздавать(), НСтр("ru = 'не создавать (решение человека)'; uk = 'не створювати (рішення людини)'"));
	КонецЕсли;

	Текст = Тексты.Получить(Литерал);
	Возврат ?(Текст = Неопределено, Литерал, Текст);

КонецФункции

// Пустой протокол записи (см. ЗаписатьПлан).
Функция НовыйПротоколЗаписи()

	ТипДокумента = Новый ОписаниеТипов("ДокументСсылка.ПоступлениеНаСчет, ДокументСсылка.РасходСоСчета");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипНомер = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный));
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("ПорядковыйНомер", ТипНомер);
	Строки.Колонки.Добавить("НомерДокументаБанка", ТипСтрока);
	Строки.Колонки.Добавить("ДатаДокументаБанка", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Строки.Колонки.Добавить("СуммаПоступление", ТипСумма);
	Строки.Колонки.Добавить("СуммаСписание", ТипСумма);
	Строки.Колонки.Добавить("КонтрагентПредставление", ТипСтрока);
	Строки.Колонки.Добавить("Документ", ТипДокумента);
	Строки.Колонки.Добавить("Результат", ТипСтрока);
	Строки.Колонки.Добавить("ПерезаписьЗапрошена", ТипБулево);
	Строки.Колонки.Добавить("КатегорияОтказа", ТипСтрока);
	Строки.Колонки.Добавить("РезультатТекст", ТипСтрока);
	Строки.Колонки.Добавить("СозданКонтрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Строки.Колонки.Добавить("СозданСчет", Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	Строки.Колонки.Добавить("СозданДоговор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));

	Замечания = Новый ТаблицаЗначений;
	Замечания.Колонки.Добавить("ПорядковыйНомер", ТипНомер);
	Замечания.Колонки.Добавить("Поле", ТипСтрока);
	Замечания.Колонки.Добавить("Уровень", ТипСтрока);
	Замечания.Колонки.Добавить("Текст", ТипСтрока);

	Дельта = Новый ТаблицаЗначений;
	Дельта.Колонки.Добавить("ПорядковыйНомер", ТипНомер);
	Дельта.Колонки.Добавить("Документ", ТипДокумента);
	Дельта.Колонки.Добавить("ВерсияДокумента", ТипСтрока);
	Дельта.Колонки.Добавить("Перезаписан", ТипБулево);

	Счетчики = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Всего,Создан,СозданНепроведенным,УжеЗагружен,Ошибка,Перезаписан,ПерезаписанНепроведенным,"
		+ "НеПерезаписаноПомеченНаУдаление,НеПерезаписаноИзмененПослеПоказа,НеПерезаписаноПрочее,ПрочийРезультат,"
		+ "СозданоКонтрагентов,СозданоСчетов,СозданоДоговоров", ",") Цикл
		Счетчики.Вставить(Имя, 0);
	КонецЦикла;

	Протокол = Новый Структура;
	Протокол.Вставить("Выполнено", Ложь);
	Протокол.Вставить("ТекстОтказа", "");
	Протокол.Вставить("Строки", Строки);
	Протокол.Вставить("Замечания", Замечания);
	Протокол.Вставить("Счетчики", Счетчики);
	Протокол.Вставить("Чтение", ДанныеЧтенияДляПротокола(""));
	Протокол.Вставить("Дельта", Дельта);
	Возврат Протокол;

КонецФункции

// Данные чтения для протокола записи по адресу, который форма запомнила после чтения. Нет адреса или данных - пустые значения.
Функция ДанныеЧтенияДляПротокола(АдресДанных)

	Результат = Новый Структура("Диагностика, КоличествоОшибок, КоличествоПредупреждений, ЕстьНевалидныеСтроки, ЧтениеНеполное",
		Новый Массив, 0, 0, Ложь, Ложь);
	Если ПустаяСтрока(АдресДанных) Или Не ЭтоАдресВременногоХранилища(АдресДанных) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Исключение
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Данные);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// План пакета записи (D5, находка F2 плана этапа 6): копия плана из временного хранилища без НОВЫХ строк, которые человек не выбрал
// (и без их замечаний), со сбросом отметки «Перезаписать» у строк с найденным документом, которые человек не выбрал. Такие строки остаются
// в плане ВСЕГДА: они удерживают свой документ в повторной проверке перед записью (СМП_РаспознаваниеОпераций.ЗагруженныеДокументыСтрокПлана),
// и документ не достанется другой строке с тем же составным ключом, но перезаписаны быть не должны. Одна функция для записи и для данных
// предупреждения - они считаются по одному и тому же плану. Запись отметок «Загружать» не знает и не получает (records.md §8). План в
// хранилище не меняется.
//
// Параметры:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  Выбранные - Массив из Число - ПорядковыйНомер строк, выбранных человеком к записи.
//
// Возвращаемое значение:
//  Структура - Найден (Булево), ТекстОтказа (Строка), План (Структура - копия плана, см. СМП_РаспознаваниеОпераций.НовыйПланЗагрузки),
//  НеВыбранные (Соответствие - ПорядковыйНомер -> Истина: строки с найденным документом, не выбранные человеком; в протокол не попадают).
Функция ПланПакетаДляЗаписи(АдресПлана, Выбранные)

	Результат = Новый Структура("Найден, ТекстОтказа, План, НеВыбранные", Ложь, "", Неопределено, Новый Соответствие);

	План = ПланИзВременногоХранилища(АдресПлана);
	Если План = Неопределено Тогда
		Результат.ТекстОтказа = ТекстПланНеДоступен();
		Возврат Результат;
	КонецЕсли;
	Результат.Найден = Истина;

	ВыбранныеКлючи = Новый Соответствие;
	Для Каждого Ключ Из Выбранные Цикл
		ВыбранныеКлючи.Вставить(Ключ, Истина);
	КонецЦикла;

	Копия = СМП_РаспознаваниеОпераций.НовыйПланЗагрузки();
	Оставленные = Новый Соответствие;
	Для Каждого СтрокаПлана Из План.Операции Цикл
		Выбрана = ВыбранныеКлючи.Получить(СтрокаПлана.ПорядковыйНомер) <> Неопределено;
		ЕстьДокумент = ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент);
		Если Не Выбрана И Не ЕстьДокумент Тогда
			Продолжить;
		КонецЕсли;
		СтрокаКопии = Копия.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКопии, СтрокаПлана);
		Оставленные.Вставить(СтрокаПлана.ПорядковыйНомер, Истина);
		Если Не Выбрана Тогда
			СтрокаКопии.Перезаписать = Ложь;
			Результат.НеВыбранные.Вставить(СтрокаПлана.ПорядковыйНомер, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Замечание Из План.Замечания Цикл
		Если Оставленные.Получить(Замечание.ПорядковыйНомер) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Копия.Замечания.Добавить(), Замечание);
		КонецЕсли;
	КонецЦикла;
	Результат.План = Копия;

	Возврат Результат;

КонецФункции

// Переносит результат записи в протокол: строки, замечания, счетчики (группировкой строк протокола), дельта. Категорию отказа перезаписи
// решает запись (СМП_ЗаписьДокументовБанка.ПричинаОтказаПерезаписи) и отдает в строке результата; здесь она не вычисляется.
Процедура ЗаполнитьПротоколЗаписи(Протокол, Пакет, РезультатЗаписи)

	СтрокиПлана = Новый Соответствие;
	Для Каждого СтрокаПлана Из Пакет.План.Операции Цикл
		СтрокиПлана.Вставить(СтрокаПлана.ПорядковыйНомер, СтрокаПлана);
	КонецЦикла;

	// Один запрос на все документы результата: свежая версия для дельты.
	ДокументыСтрок = Новый Массив;
	Для Каждого СтрокаРезультата Из РезультатЗаписи.Операции Цикл
		Если ЗначениеЗаполнено(СтрокаРезультата.Документ) Тогда
			ДокументыСтрок.Добавить(Новый Структура("ЗагруженныйДокумент", СтрокаРезультата.Документ));
		КонецЕсли;
	КонецЦикла;
	ДанныеДокументов = ДанныеНайденныхДокументов(ДокументыСтрок);

	Видимые = Новый Соответствие;
	Для Каждого СтрокаРезультата Из РезультатЗаписи.Операции Цикл
		Номер = СтрокаРезультата.ПорядковыйНомер;
		СтрокаПлана = СтрокиПлана.Получить(Номер);
		Если СтрокаПлана = Неопределено Или Пакет.НеВыбранные.Получить(Номер) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Видимые.Вставить(Номер, Истина);

		Литерал = СтрокаРезультата.Результат;
		ПерезаписьЗапрошена = СтрокаПлана.Перезаписать;
		Категория = СтрокаРезультата.КатегорияОтказа;

		СтрокаПротокола = Протокол.Строки.Добавить();
		СтрокаПротокола.ПорядковыйНомер = Номер;
		СтрокаПротокола.НомерДокументаБанка = СтрокаПлана.НомерДокумента;
		СтрокаПротокола.ДатаДокументаБанка = СтрокаПлана.ДатаДокумента;
		Если СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеПоступило() Тогда
			СтрокаПротокола.СуммаПоступление = СтрокаПлана.Сумма;
		ИначеЕсли СтрокаПлана.Направление = СМП_ВыпискаБанка.НаправлениеСписано() Тогда
			СтрокаПротокола.СуммаСписание = СтрокаПлана.Сумма;
		КонецЕсли;
		СтрокаПротокола.КонтрагентПредставление = ?(ЗначениеЗаполнено(СтрокаПлана.Контрагент),
			Строка(СтрокаПлана.Контрагент), СтрокаПлана.КонтрагентНаименование);
		СтрокаПротокола.Документ = СтрокаРезультата.Документ;
		СтрокаПротокола.Результат = Литерал;
		СтрокаПротокола.ПерезаписьЗапрошена = ПерезаписьЗапрошена;
		СтрокаПротокола.КатегорияОтказа = Категория;
		СтрокаПротокола.РезультатТекст = ТекстРезультатаСтроки(Литерал, Категория);
		СтрокаПротокола.СозданКонтрагент = СтрокаРезультата.СозданКонтрагент;
		СтрокаПротокола.СозданСчет = СтрокаРезультата.СозданСчет;
		СтрокаПротокола.СозданДоговор = СтрокаРезультата.СозданДоговор;

		// Дельта: документ появился (новая строка получила документ) или перезаписан. Отказ перезаписи и ошибка без документа - без дельты.
		ПерезаписанСейчас = Литерал = СМП_ЗаписьДокументовБанка.РезультатПерезаписан()
			Или Литерал = СМП_ЗаписьДокументовБанка.РезультатПерезаписанНепроведенным();
		ПоявилсяДокумент = ЗначениеЗаполнено(СтрокаРезультата.Документ) И Не ЗначениеЗаполнено(СтрокаПлана.ЗагруженныйДокумент);
		Если ПерезаписанСейчас Или ПоявилсяДокумент Тогда
			Данные = ДанныеДокументов.Получить(СтрокаРезультата.Документ);
			СтрокаДельты = Протокол.Дельта.Добавить();
			СтрокаДельты.ПорядковыйНомер = Номер;
			СтрокаДельты.Документ = СтрокаРезультата.Документ;
			СтрокаДельты.ВерсияДокумента = ?(Данные = Неопределено, "", Данные.ВерсияДанных);
			СтрокаДельты.Перезаписан = ПерезаписанСейчас;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Замечание Из РезультатЗаписи.Замечания Цикл
		Если Замечание.ПорядковыйНомер = 0 Или Видимые.Получить(Замечание.ПорядковыйНомер) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Протокол.Замечания.Добавить(), Замечание);
		КонецЕсли;
	КонецЦикла;

	ПосчитатьСчетчикиПротокола(Протокол);

КонецПроцедуры

// Счетчики протокола - группировкой его строк по результату и категории отказа перезаписи. Строка результата «УжеЗагружен» без категории -
// документ найден и не перезаписывался; с категорией - перезапись запрошена, но документ не изменен.
Процедура ПосчитатьСчетчикиПротокола(Протокол)

	Счетчики = Протокол.Счетчики;
	Строки = Протокол.Строки;

	УжеЗагружен = СМП_ЗаписьДокументовБанка.РезультатУжеЗагружен();
	Отборы = Новый Структура;
	Отборы.Вставить("Создан", Новый Структура("Результат", СМП_ЗаписьДокументовБанка.РезультатСоздан()));
	Отборы.Вставить("СозданНепроведенным", Новый Структура("Результат", СМП_ЗаписьДокументовБанка.РезультатСозданНепроведенным()));
	Отборы.Вставить("Перезаписан", Новый Структура("Результат", СМП_ЗаписьДокументовБанка.РезультатПерезаписан()));
	Отборы.Вставить("ПерезаписанНепроведенным",
		Новый Структура("Результат", СМП_ЗаписьДокументовБанка.РезультатПерезаписанНепроведенным()));
	Отборы.Вставить("Ошибка", Новый Структура("Результат", СМП_ЗаписьДокументовБанка.РезультатОшибка()));
	Отборы.Вставить("УжеЗагружен", Новый Структура("Результат, КатегорияОтказа", УжеЗагружен, ""));
	Отборы.Вставить("НеПерезаписаноПомеченНаУдаление", Новый Структура("Результат, КатегорияОтказа", УжеЗагружен,
		СМП_ЗаписьДокументовБанка.КатегорияОтказаПомеченНаУдаление()));
	Отборы.Вставить("НеПерезаписаноИзмененПослеПоказа", Новый Структура("Результат, КатегорияОтказа", УжеЗагружен,
		СМП_ЗаписьДокументовБанка.КатегорияОтказаИзмененПослеПоказа()));
	Отборы.Вставить("НеПерезаписаноПрочее", Новый Структура("Результат, КатегорияОтказа", УжеЗагружен,
		СМП_ЗаписьДокументовБанка.КатегорияОтказаПрочее()));

	Счетчики.Всего = Строки.Количество();
	Учтено = 0;
	Для Каждого Отбор Из Отборы Цикл
		Количество = Строки.НайтиСтроки(Отбор.Значение).Количество();
		Счетчики[Отбор.Ключ] = Количество;
		Учтено = Учтено + Количество;
	КонецЦикла;
	// Неизвестный литерал результата (новый литерал записи без ветки здесь).
	Счетчики.ПрочийРезультат = Счетчики.Всего - Учтено;

	Счетчики.СозданоКонтрагентов = Строки.Количество() - Строки.НайтиСтроки(Новый Структура("СозданКонтрагент",
		Справочники.Контрагенты.ПустаяСсылка())).Количество();
	Счетчики.СозданоСчетов = Строки.Количество() - Строки.НайтиСтроки(Новый Структура("СозданСчет",
		Справочники.БанковскиеСчета.ПустаяСсылка())).Количество();
	Счетчики.СозданоДоговоров = Строки.Количество() - Строки.НайтиСтроки(Новый Структура("СозданДоговор",
		Справочники.ДоговорыКонтрагентов.ПустаяСсылка())).Количество();

КонецПроцедуры

// Проведенные документы среди ссылок: один запрос.
//
// Возвращаемое значение:
//  Соответствие - ссылка на проведенный документ -> Истина.
Функция ПроведенныеДокументы(Ссылки)

	Результат = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеНаСчет КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)
		|	И Документы.Проведен
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Документы.Ссылка
		|ИЗ
		|	Документ.РасходСоСчета КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)
		|	И Документы.Проведен");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Читает файл читателем по входу. Возвращает результат чтения (СМП_ЧитателиВыписок.НовыйРезультатЧтения)
// или Строку - текст отказа до чтения. Учетная запись - определенная сервером (ИсточникЧтенияСчета), а не из входа.
Функция ПрочитатьФайлВыписки(Вход, УчетнаяЗапись)

	Если ПустаяСтрока(Вход.АдресФайла) Тогда
		Возврат НСтр("ru = 'Файл выписки не выбран.'; uk = 'Файл виписки не обрано.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Вход.БанковскийСчет) Тогда
		Возврат НСтр("ru = 'Не выбран банковский счет организации.'; uk = 'Не обрано банківський рахунок організації.'");
	КонецЕсли;

	Данные = ПолучитьИзВременногоХранилища(Вход.АдресФайла);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат НСтр("ru = 'Файл выписки больше не доступен на сервере. Выберите файл заново.';
			|uk = 'Файл виписки більше не доступний на сервері. Оберіть файл заново.'");
	КонецЕсли;

	НомераСчета = НомераСчетаДляЧтения(Вход.БанковскийСчет);

	Если Вход.ВнешняяОбработка Тогда
		Обработка = Неопределено;
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			Обработка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "ПодключаемаяОбработка");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Обработка) Тогда
			Возврат НСтр("ru = 'В учетной записи не указана подключаемая обработка чтения.';
				|uk = 'В обліковому записі не вказано підключену обробку читання.'");
		КонецЕсли;
		// Двоичные данные обработки - как в нынешней обработке: ХранилищеОбработки элемента справочника БСП.
		ДвоичныеДанныеОбработки = Обработка.ХранилищеОбработки.Получить();
		Создание = СМП_ЧитателиВыписок.СоздатьВнешнийЧитатель(ДвоичныеДанныеОбработки);
		Если Создание.Читатель = Неопределено Тогда
			Тексты = Создание.Ошибки;
			Если Тексты.Количество() = 0 Тогда
				Возврат НСтр("ru = 'Не удалось создать читатель из подключаемой обработки.';
					|uk = 'Не вдалося створити читач з підключеної обробки.'");
			КонецЕсли;
			Возврат СтрСоединить(Тексты, Символы.ПС);
		КонецЕсли;
		Возврат СМП_ЧитателиВыписок.ПрочитатьЧитателем(Создание.Читатель, Данные, НомераСчета);
	КонецЕсли;

	Если ПустаяСтрока(Вход.ИдентификаторСтрокиРеестра) Тогда
		Возврат НСтр("ru = 'Формат выписки не выбран: выберите формат файла.';
			|uk = 'Формат виписки не обрано: оберіть формат файлу.'");
	КонецЕсли;

	Возврат СМП_ЧитателиВыписок.ПрочитатьФайл(Вход.ИдентификаторСтрокиРеестра, Данные, НомераСчета);

КонецФункции

// Номера нашего счета для читателя: текущий и устаревший номер выбранного счета (как их ищет распознавание
// в ПрочитатьСчетаОрганизацийИФизлиц); текущий идет первым.
Функция НомераСчетаДляЧтения(БанковскийСчет)

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанковскийСчет, "НомерСчета, НомерСчетаУстаревший");
	Результат = Новый Массив;
	Для Каждого Номер Из СтрРазделить("НомерСчета,НомерСчетаУстаревший", ",") Цикл
		Если Не ПустаяСтрока(Реквизиты[Номер]) Тогда
			Результат.Добавить(СокрЛП(Реквизиты[Номер]));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Банк учетной записи -> идентификатор строки реестра конекторов. Запасное правило решения 12 плана 5б: пустой
// ИдентификаторСтрокиРеестра учетной записи читает как в 6б, по банку. Единственное место этой мапы; мапы реквизитов
// учетных данных здесь нет - она в строке реестра (РеквизитыУчетныхДанных, решение 13).
// NovaPay, подключаемая обработка и пустой банк - файл: конектора нет.
//
// Параметры:
//  Банк - ПеречислениеСсылка.СМП_ПоддерживаемыеИнтеграцииСБанками - банк учетной записи.
//
// Возвращаемое значение:
//  Строка - идентификатор строки РеестрКоннекторов; пустая строка - файл.
Функция ИдентификаторРеестраПоБанку(Банк)

	Интеграции = Перечисления.СМП_ПоддерживаемыеИнтеграцииСБанками;
	Если Банк = Интеграции.ПриватБанк Тогда
		Возврат "ПриватБанк_API";
	ИначеЕсли Банк = Интеграции.МОНОБанк Тогда
		Возврат "Монобанк_API";
	ИначеЕсли Банк = Интеграции.МОНОБанкЮр Тогда
		Возврат "МонобанкЮр_API";
	ИначеЕсли Банк = Интеграции.ПУМБ Тогда
		Возврат "ПУМБ_API";
	КонецЕсли;
	Возврат "";

КонецФункции

// Строка реестра конекторов учетной записи (решения 12 и 13 плана 5б, D26). Пустой ИдентификаторСтрокиРеестра записи -
// строка по банку (как в 6б); заполненный - строка по нему; неизвестный или несовместимый с банком - отказ с текстом
// (невалидная настройка). Значений учетных данных в результате нет - только имена реквизитов.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - учетная запись.
//
// Возвращаемое значение:
//  Структура - строка реестра:
//   * Идентификатор - Строка - идентификатор строки РеестрКоннекторов; пусто - файл или отказ.
//   * Поля - Структура, Неопределено - ключ учетных данных конектора -> имя реквизита учетной записи; Неопределено - файл или отказ.
//   * ТекстОтказа - Строка - непусто для невалидной настройки; иначе пусто.
Функция СтрокаРеестраУчетнойЗаписи(УчетнаяЗапись) Экспорт

	Результат = Новый Структура("Идентификатор, Поля, ТекстОтказа", "", Неопределено, "");

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, "Банк, ИдентификаторСтрокиРеестра");
	ИдентификаторПоБанку = ИдентификаторРеестраПоБанку(Реквизиты.Банк);
	ЗаданныйИдентификатор = СокрЛП(Реквизиты.ИдентификаторСтрокиРеестра);

	Идентификатор = ИдентификаторПоБанку;
	Если Не ПустаяСтрока(ЗаданныйИдентификатор) Тогда
		Реестр = СМП_ЧитателиВыписок.РеестрКоннекторов();
		Если Реестр.Найти(ЗаданныйИдентификатор, "Идентификатор") = Неопределено Тогда
			Результат.ТекстОтказа = НСтр("ru = 'В учетной записи указан неизвестный идентификатор строки реестра. Исправьте настройку.';
				|uk = 'В обліковому записі вказано невідомий ідентифікатор рядка реєстру. Виправте налаштування.'");
			Возврат Результат;
		КонецЕсли;
		Если ЗаданныйИдентификатор <> ИдентификаторПоБанку Тогда
			Результат.ТекстОтказа = НСтр("ru = 'Идентификатор строки реестра в учетной записи не соответствует ее банку. Исправьте настройку.';
				|uk = 'Ідентифікатор рядка реєстру в обліковому записі не відповідає її банку. Виправте налаштування.'");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокаРеестра = СМП_ЧитателиВыписок.РеестрКоннекторов().Найти(Идентификатор, "Идентификатор");
	Если СтрокаРеестра = Неопределено Тогда
		Результат.ТекстОтказа = НСтр("ru = 'Для банка учетной записи нет строки реестра. Исправьте настройку.';
			|uk = 'Для банку облікового запису немає рядка реєстру. Виправте налаштування.'");
		Возврат Результат;
	КонецЕсли;

	Результат.Идентификатор = Идентификатор;
	Результат.Поля = Новый Структура;
	Для Каждого Поле Из СтрокаРеестра.РеквизитыУчетныхДанных Цикл
		Результат.Поля.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Учетные данные конектора из учетной записи по мапе строки реестра (СтрокаРеестраУчетнойЗаписи, РеквизитыУчетныхДанных; решение 13 плана 5б).
// Без Экспорт: данные не идут на клиент и в реквизиты формы; зовет лишь ПрочитатьСчетКоннектором (серверная точка входа чтения),
// которая передает их в СМП_ЧитателиВыписок.ПрочитатьКоннектором. Для серверного кода с правом читать учетную запись
// это то же, что прямое чтение реквизитов.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиБанков - учетная запись счета.
//
// Возвращаемое значение:
//  Структура, Неопределено - ключи Параметры.УчетныеДанные конектора; Неопределено для файла и невалидной настройки.
Функция УчетныеДанныеКоннектора(УчетнаяЗапись)

	СтрокаРеестра = СтрокаРеестраУчетнойЗаписи(УчетнаяЗапись);
	Если СтрокаРеестра.Поля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИменаРеквизитов = Новый Массив;
	Для Каждого Поле Из СтрокаРеестра.Поля Цикл
		Если ИменаРеквизитов.Найти(Поле.Значение) = Неопределено Тогда
			ИменаРеквизитов.Добавить(Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись, СтрСоединить(ИменаРеквизитов, ","));

	Результат = Новый Структура;
	Для Каждого Поле Из СтрокаРеестра.Поля Цикл
		Результат.Вставить(Поле.Ключ, Реквизиты[Поле.Значение]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// МФО банка счета: Банк.Код (вимір 0.8), без пробелов по краям. Пустая строка, если банка или кода нет.
Функция МФОБанкаСчета(БанковскийСчет)

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Банк.Код КАК Код
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", БанковскийСчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Код <> Null Тогда
		Возврат СокрЛП(Выборка.Код);
	КонецЕсли;
	Возврат "";

КонецФункции

// Входит ли МФО в коды банка строки реестра. Пустое МФО не входит никуда.
Функция СтрокаСодержитМФО(СтрокаРеестра, МФО)

	Если ПустаяСтрока(МФО) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Код Из СтрокаРеестра.КодыБанка Цикл
		Если СокрЛП(Код) = МФО Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Текст предупреждения о несовпадении банка для строки реестра; пусто - банк совпал.
Функция ПредупреждениеДляСтроки(СтрокаРеестра, МФО)

	Если СтрокаСодержитМФО(СтрокаРеестра, МФО) Тогда
		Возврат "";
	КонецЕсли;
	Если ПустаяСтрока(МФО) Тогда
		Возврат СтрШаблон(НСтр("ru = 'У банка выбранного счета не заполнен код (МФО): проверить, что формат ""%1"" относится к этому банку, нельзя. Чтение не запрещено.';
			|uk = 'У банку вибраного рахунку не заповнено код (МФО): перевірити, що формат ""%1"" належить цьому банку, не можна. Читання не заборонено.'"),
			СтрокаРеестра.Представление);
	КонецЕсли;
	Возврат СтрШаблон(ШаблонПредупрежденияДругойБанк(), СтрокаРеестра.Представление, МФО);

КонецФункции

// Шаблон предупреждения о другом банке (вынесен отдельно, чтобы текст был в одном месте).
Функция ШаблонПредупрежденияДругойБанк()

	Возврат НСтр("ru = 'Формат ""%1"" относится к другому банку, а не к банку выбранного счета (МФО %2). Чтение не запрещено: если файл действительно из банка счета, продолжайте, иначе проверьте выбор формата.';
		|uk = 'Формат ""%1"" належить іншому банку, а не банку вибраного рахунку (МФО %2). Читання не заборонено: якщо файл справді з банку рахунку, продовжуйте, інакше перевірте вибір формату.'");

КонецФункции

// Подсказка «тот же формат дают также»: банки других строк реестра с тем же модулем формата.
Функция ПодсказкаТогоЖеФормата(Реестр, СтрокаРеестра)

	Банки = Новый Массив;
	Для Каждого Другая Из Реестр Цикл
		Если Другая.Формат = СтрокаРеестра.Формат И Другая.Идентификатор <> СтрокаРеестра.Идентификатор Тогда
			Банки.Добавить(Другая.Банк);
		КонецЕсли;
	КонецЦикла;
	Если Банки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Тот же формат дают также: %1.'; uk = 'Той самий формат дають також: %1.'"),
		СтрСоединить(Банки, ", "));

КонецФункции

// Представления строк реестра по их идентификаторам.
Функция ПредставленияСтрокРеестра(Идентификаторы)

	Результат = Новый Массив;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого СтрокаРеестра Из СМП_ЧитателиВыписок.РеестрЧитателей() Цикл
		Если Идентификаторы.Найти(СтрокаРеестра.Идентификатор) <> Неопределено Тогда
			Результат.Добавить(СтрокаРеестра.Представление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
