#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Параметр счёта тот же, что несёт структура обмена из журнала «Банк и касса»
	// (КлиентБанкВызовСервера.ПолучитьСтруктуруОбмена / ПолучитьСтруктуруПрямогоОбмена).
	Если ЗначениеЗаполнено(Параметры.БанковскийСчетОрганизации) Тогда
		БанковскийСчет = Параметры.БанковскийСчетОрганизации;
	КонецЕсли;

	// В макете формы все элементы видимы (так форма читается в конфигураторе); прячет их код.
	// Учетную запись, период, файл, формат, предупреждение МФО, таблицу плана, подвал и сводку прячет
	// ОбновитьДанныеСчетаНаСервере (СброситьРезультатЧтения, ПоказатьДанныеФормата); кнопки отмены и «Прочитать остаток» - здесь.
	Элементы.ОтменитьЧтение.Видимость = Ложь;
	Элементы.ПрочитатьОстаток.Видимость = Ложь;

	// Период чтения по API - сегодня; между открытиями не хранится (решение 5 плана 6б).
	Период = Новый СтандартныйПериод(НачалоДня(ТекущаяДатаСеанса()), КонецДня(ТекущаяДатаСеанса()));

	// Флажок «Запомнить статью» (D13): по умолчанию выключен, положение помнится для пользователя.
	ЗапомнитьСтатью = ХранилищеОбщихНастроек.Загрузить("Обработка.СМП_ОбменСБанком.ФормаЗагрузки", "ЗапомнитьСтатью") = Истина;

	ОбновитьДанныеСчетаНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БанковскийСчетПриИзменении(Элемент)

	// Один серверный вызов: учетные записи счета, источник формата, список форматов.
	ОбновитьДанныеСчетаНаСервере();

КонецПроцедуры



// Положение флажка пишется одним серверным вызовом; решения человека оно не меняет.
&НаКлиенте
Процедура ЗапомнитьСтатьюПриИзменении(Элемент)

	СохранитьПоложениеЗапомнитьСтатью(ЗапомнитьСтатью);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьПоложениеЗапомнитьСтатью(Значение)

	ХранилищеОбщихНастроек.Сохранить("Обработка.СМП_ОбменСБанком.ФормаЗагрузки", "ЗапомнитьСтатью", Значение);

КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторФорматаПриИзменении(Элемент)

	// Подсказка и предупреждение МФО берутся из данных, уже полученных с сервера: вызова нет.
	СброситьРезультатЧтения(ЭтотОбъект);
	ПоказатьДанныеФормата(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЧтениеИдет Или ЗаписьИдет Тогда
		Возврат;
	КонецЕсли;

	// Только асинхронно: файл сразу кладется во временное хранилище сервера, работает и в веб-клиенте.
	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Выберите файл выписки'; uk = 'Оберіть файл виписки'");
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	// План, сводка и класс отказа относятся к периоду, который читали: при смене периода сбрасываются (решение 5 плана 6б).
	СброситьРезультатЧтения(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьВыписку(Команда)

	Если ЧтениеИдет Или ЗаписьИдет Тогда
		Возврат;
	КонецЕсли;

	// Источник чтения определил сервер по счету (ОбновитьДанныеСчетаНаСервере): ветка - до файловых проверок.
	// Отказ (несколько учетных записей счета): читать нечем, текст показывается заново, источник пересчитывается.
	Если ИсточникЧтения = "Отказ" Тогда
		ОбновитьДанныеСчетаНаСервере();
		Возврат;
	КонецЕсли;

	// Форма не читает, пока нечего или нечем читать, и говорит почему.
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		ПоказатьСводку(НСтр("ru = 'Выберите банковский счет организации.'; uk = 'Оберіть банківський рахунок організації.'"));
		Возврат;
	КонецЕсли;
	// Файловые проверки - только для источника "Файл"; чтение по API идет за периодом, файла и формата у него нет.
	Если ИсточникЧтения = "Файл" Тогда
		Если ПустаяСтрока(АдресФайла) Тогда
			ПоказатьСводку(НСтр("ru = 'Выберите файл выписки.'; uk = 'Оберіть файл виписки.'"));
			Возврат;
		КонецЕсли;
		Если Не ВнешняяОбработка И ПустаяСтрока(ИдентификаторФормата) Тогда
			ПоказатьСводку(НСтр("ru = 'Формат выписки не выбран: выберите формат файла.'; uk = 'Формат виписки не обрано: оберіть формат файлу.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Чтение по API идет под блокировкой учетной записи (решение 10 плана 5б): занято обменом регламента или записью другой формы - отказ с текстом.
	// Блокировка снимается в ПослеЧтенияВыписки на любом исходе (и самим закрытием формы).
	Если ИсточникЧтения = "Коннектор" Тогда
		ТекстЗанято = ВзятьОбменНаСервере();
		Если Не ПустаяСтрока(ТекстЗанято) Тогда
			ПоказатьСводку(ТекстЗанято);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	СброситьРезультатЧтения(ЭтотОбъект);
	УстановитьСостояниеЧтения(Истина);

	// Один запуск и (в ПослеЧтенияВыписки) один забор результата; от размера файла число вызовов не зависит.
	Операция = ЗапуститьЧтениеНаСервере();

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	// Закрытие формы во время чтения отменяет фоновое задание: чтение побочных эффектов не имеет (П-Г).
	ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Истина;
	Оповещение = Новый ОписаниеОповещения("ПослеЧтенияВыписки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

// «Прочитать остаток» (решение 10 плана 6б): период остатка ставит сервер по прочитанному отрезку результата, дальше - тот же запуск
// чтения, что у «Прочитать выписку» (одна точка входа, учетные данные только на сервере). План прошлого чтения при этом
// сбрасывается: прочитанное до предела человек загружает обычным путем до нажатия этой кнопки; дубли повторного
// чтения ловит шаг 0 («уже загружено»).
&НаКлиенте
Процедура ПрочитатьОстаток(Команда)

	Если ЧтениеИдет Или ЗаписьИдет Тогда
		Возврат;
	КонецЕсли;

	Если Не УстановитьПериодОстаткаНаСервере() Тогда
		Возврат;
	КонецЕсли;

	ПрочитатьВыписку(Команда);

КонецПроцедуры

// Ставит в период формы остаток периода, не охваченный неполным чтением; без прочитанного отрезка в принятом результате - Ложь.
&НаСервере
Функция УстановитьПериодОстаткаНаСервере()

	ДанныеЧтения = ?(ПустаяСтрока(АдресДанныхЧтения), Неопределено, ПолучитьИзВременногоХранилища(АдресДанныхЧтения));
	Остаток = ПериодОстатка(ДанныеЧтения, Период);
	Если Остаток = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Период = Новый СтандартныйПериод(Остаток.Начало, Остаток.Конец);
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОтменитьЧтение(Команда)

	Если Не ЧтениеИдет Тогда
		Возврат;
	КонецЕсли;
	// Ожидание увидит отмену и вызовет ПослеЧтенияВыписки с Неопределено.
	ОтменитьЗаданиеНаСервере(ИдентификаторЗадания);

КонецПроцедуры

// Правила по фразе в назначении платежа - справочник вендора; открывается отдельным окном, форму выписки не блокирует.
&НаКлиенте
Процедура ПравилаПоНазначению(Команда)

	ОткрытьФорму("Справочник.СоответствияНазначенийПлатежаИРеквизитовПлатежа.ФормаСписка");

КонецПроцедуры

// Один серверный вызов. Права на запись в справочник правил команда не проверяет и не прячется: при отказе человек
// видит причину, подробности - в журнале регистрации.
&НаКлиенте
Процедура ЗаполнитьТиповыеПравилаКоманда(Команда)

	Результат = ЗаполнитьТиповыеПравилаНаСервере();
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Типовые правила'; uk = 'Типові правила'"), ,
			Результат.Текст, БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьТиповыеПравилаНаСервере()

	Возврат Обработки.СМП_ОбменСБанком.ЗаполнитьТиповыеПравилаДляФормы();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПомещенияФайла(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = ПомещенныйФайл.Хранение;
	// В веб-клиенте без расширения Имя - уже имя файла; в остальных случаях - путь, показываем лишь имя.
	ИмяФайла = ИмяФайлаБезПути(ПомещенныйФайл.Имя);
	СброситьРезультатЧтения(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияВыписки(Результат, ДополнительныеПараметры) Экспорт

	УстановитьСостояниеЧтения(Ложь);

	// Чтение закончено (выполнено, сбой или отмена): блокировку учетной записи брало только чтение по API (решение 10 плана 5б).
	Если ИсточникЧтения = "Коннектор" Тогда
		ОтпуститьОбменНаСервере();
	КонецЕсли;

	Если Результат = Неопределено Тогда
		ПоказатьСводку(НСтр("ru = 'Чтение отменено.'; uk = 'Читання скасовано.'"));
		Возврат;
	КонецЕсли;

	Если Результат.Статус <> "Выполнено" Тогда
		// Чтение по API: текст сбоя задания не показывается (учетные данные на клиент не идут): подробности - в журнале регистрации.
		Если ИсточникЧтения = "Коннектор" Тогда
			ПоказатьСводку(НСтр("ru = 'Не удалось прочитать выписку из банка. Подробности записаны в журнал регистрации.';
				|uk = 'Не вдалося прочитати виписку з банку. Подробиці записано в журнал реєстрації.'"));
		Иначе
			ПоказатьСводку(СтрШаблон(НСтр("ru = 'Не удалось прочитать файл: %1';
				|uk = 'Не вдалося прочитати файл: %1'"), Результат.КраткоеПредставлениеОшибки));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ПоказатьСводку(ПолучитьРезультатЧтенияНаСервере(Результат.АдресРезультата));

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЧтения(Идет)

	ЧтениеИдет = Идет;
	// Период недоступен во время чтения: иначе протокол показал бы период, которого задание не читало. «Прочитать остаток» тоже недоступна.
	Для Каждого ИмяЭлемента Из СтрРазделить("БанковскийСчет,ИдентификаторФормата,ИмяФайла,Период,ПрочитатьВыписку,ПрочитатьОстаток", ",") Цикл
		Элементы[ИмяЭлемента].Доступность = Не Идет;
	КонецЦикла;
	Элементы.ОтменитьЧтение.Видимость = Идет;
	Если Идет Тогда
		// Чтение по API ждет ответа банка: текст ожидания (решение 7 плана 6б; прогресса нет, конектор его не сообщает). Файл - без текста.
		Если ИсточникЧтения = "Коннектор" Тогда
			ПоказатьСводку(НСтр("ru = 'Ожидание ответа банка…'; uk = 'Очікування відповіді банку…'"));
		Иначе
			Элементы.СводкаЧтения.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьСводкуВФорме(Форма, Текст)

	Форма.СводкаЧтения = Текст;
	Форма.Элементы.СводкаЧтения.Видимость = Не ПустаяСтрока(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСводку(Текст)

	ПоказатьСводкуВФорме(ЭтотОбъект, Текст);

КонецПроцедуры

// План и сводка относятся к конкретному файлу, счету и формату: при смене любого из них сбрасываются.
&НаКлиентеНаСервереБезКонтекста
Процедура СброситьРезультатЧтения(Форма)

	Форма.АдресПлана = "";
	Форма.АдресДанныхЧтения = "";
	ОчиститьПланВФорме(Форма);
	Форма.Элементы.ПрочитатьОстаток.Видимость = Ложь;
	ПоказатьСводкуВФорме(Форма, "");

КонецПроцедуры

// Подсказка «тот же формат дают также…» и предупреждение МФО для выбранной строки реестра.
&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьДанныеФормата(Форма)

	Подсказка = "";
	Предупреждение = "";
	Если Не Форма.ВнешняяОбработка И Не ПустаяСтрока(Форма.ИдентификаторФормата) Тогда
		Строки = Форма.ДанныеФорматов.НайтиСтроки(Новый Структура("Идентификатор", Форма.ИдентификаторФормата));
		Если Строки.Количество() > 0 Тогда
			Подсказка = Строки[0].Подсказка;
			Предупреждение = Строки[0].Предупреждение;
		КонецЕсли;
	КонецЕсли;

	Форма.Элементы.ИдентификаторФормата.РасширеннаяПодсказка.Заголовок = Подсказка;
	Форма.Элементы.ДекорацияПредупрежденияФормата.Заголовок = Предупреждение;
	Форма.Элементы.ДекорацияПредупрежденияФормата.Видимость = Не ПустаяСтрока(Предупреждение);

КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаБезПути(Путь)

	Позиция = Макс(СтрНайти(Путь, "\", НаправлениеПоиска.СКонца), СтрНайти(Путь, "/", НаправлениеПоиска.СКонца));
	Возврат Сред(Путь, Позиция + 1);

КонецФункции

// Данные счета для формы: источник чтения, учетная запись для показа и список форматов файла. Один серверный вызов.
// Учетную запись человек не выбирает (решение 3 плана 6б); видимость полей ставит вид источника (решение 4).
&НаСервере
Процедура ОбновитьДанныеСчетаНаСервере()

	Данные = Обработки.СМП_ОбменСБанком.ДанныеФормы(БанковскийСчет);

	ИсточникЧтения = Данные.Источник;
	ЭтоФайл = ИсточникЧтения = "Файл";
	УчетнаяЗапись = Данные.УчетнаяЗапись;
	Элементы.УчетнаяЗапись.Видимость = ЗначениеЗаполнено(УчетнаяЗапись);

	ВнешняяОбработка = Данные.ВнешняяОбработка;
	ТекстВнешнейОбработки = ?(ВнешняяОбработка,
		СтрШаблон(НСтр("ru = 'внешняя обработка %1'; uk = 'зовнішня обробка %1'"), Данные.ПредставлениеОбработки), "");
	// Конектор: видно период; файл и формат не видны. Файл: наоборот. Отказ (несколько записей): ничего, кроме текста отказа.
	Элементы.Период.Видимость = ИсточникЧтения = "Коннектор";
	Элементы.ИмяФайла.Видимость = ЭтоФайл;
	Элементы.ТекстВнешнейОбработки.Видимость = ЭтоФайл И ВнешняяОбработка;
	Элементы.ИдентификаторФормата.Видимость = ЭтоФайл И Не ВнешняяОбработка;

	ДанныеФорматов.Очистить();
	Элементы.ИдентификаторФормата.СписокВыбора.Очистить();
	Для Каждого ДанныеФормата Из Данные.Форматы Цикл
		Элементы.ИдентификаторФормата.СписокВыбора.Добавить(ДанныеФормата.Идентификатор, ДанныеФормата.Представление);
		СтрокаДанных = ДанныеФорматов.Добавить();
		СтрокаДанных.Идентификатор = ДанныеФормата.Идентификатор;
		СтрокаДанных.Подсказка = ДанныеФормата.Подсказка;
		СтрокаДанных.Предупреждение = ДанныеФормата.Предупреждение;
	КонецЦикла;

	// Выбор человека сохраняется, пока строка есть в новом списке; иначе - единственная своя строка или пусто.
	Если ВнешняяОбработка Или ДанныеФорматов.НайтиСтроки(Новый Структура("Идентификатор", ИдентификаторФормата)).Количество() = 0 Тогда
		ИдентификаторФормата = Данные.ИдентификаторПоУмолчанию;
	КонецЕсли;

	СброситьРезультатЧтения(ЭтотОбъект);
	ПоказатьДанныеФормата(ЭтотОбъект);
	ПоказатьСводкуВФорме(ЭтотОбъект, Данные.ТекстОтказа);

КонецПроцедуры

// Вход чтения: счет, период и выбор формата файла. Учетной записи и учетных данных во входе нет: источник и запись
// сервер определяет сам по счету (решения 2, 3 плана 6б), реквизитам формы ИсточникЧтения и УчетнаяЗапись он не доверяет.
&НаСервере
Функция ЗапуститьЧтениеНаСервере()

	Вход = Обработки.СМП_ОбменСБанком.НовыйВходЧтения();
	Вход.АдресФайла = АдресФайла;
	Вход.ИдентификаторСтрокиРеестра = ?(ВнешняяОбработка, "", ИдентификаторФормата);
	Вход.ВнешняяОбработка = ВнешняяОбработка;
	Вход.БанковскийСчет = БанковскийСчет;
	Вход.ИдентификаторФормы = УникальныйИдентификатор;
	// Период нужен только чтению по API; границы дней (НачалоДня, КонецДня) берет сервер (решение 5).
	Если ИсточникЧтения = "Коннектор" Тогда
		Вход.НачалоПериода = Период.ДатаНачала;
		Вход.КонецПериода = Период.ДатаОкончания;
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Чтение и распознавание выписки банка'; uk = 'Читання і розпізнавання виписки банку'");
	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработки.СМП_ОбменСБанком.ПрочитатьИРаспознатьВыписку", Вход);

	ИдентификаторЗадания = ?(ЗначениеЗаполнено(Операция.ИдентификаторЗадания), Строка(Операция.ИдентификаторЗадания), "");
	Возврат Операция;

КонецФункции

&НаСервереБезКонтекста
Процедура ОтменитьЗаданиеНаСервере(Знач ИдентификаторЗадания)

	Если ПустаяСтрока(ИдентификаторЗадания) Тогда
		Возврат;
	КонецЕсли;
	ДлительныеОперации.ОтменитьВыполнениеЗадания(Новый УникальныйИдентификатор(ИдентификаторЗадания));

КонецПроцедуры

// Забирает результат фоновой функции: запоминает адрес плана в реквизите, возвращает сводку для человека.
&НаСервере
Функция ПолучитьРезультатЧтенияНаСервере(АдресРезультата)

	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат НСтр("ru = 'Результат чтения недоступен. Прочитайте файл ещё раз.';
			|uk = 'Результат читання недоступний. Прочитайте файл ще раз.'");
	КонецЕсли;

	// Результат задания, запущенного для другого счета (и для периода, если читали по API), форма не принимает.
	ЭтоКоннектор = Итог.Источник = "Коннектор";
	ДругойСчет = Итог.БанковскийСчет <> БанковскийСчет;
	ДругойПериод = ЭтоКоннектор И (Итог.НачалоПериода <> НачалоДня(Период.ДатаНачала)
		Или Итог.КонецПериода <> КонецДня(Период.ДатаОкончания));
	Если ДругойСчет Или ДругойПериод Тогда
		СброситьРезультатЧтения(ЭтотОбъект);
		Возврат НСтр("ru = 'Результат чтения относится к другому счету или периоду и не принят. Прочитайте ещё раз.';
			|uk = 'Результат читання стосується іншого рахунку або періоду і не прийнятий. Прочитайте ще раз.'");
	КонецЕсли;

	// Данные чтения для протокола записи (диагностика, неполнота): запись берет их по этому адресу.
	// Поля перечислены явно: класс отказа и прочитанный отрезок не попадут сюда сами (решения 8, 9 плана 6б).
	ДанныеЧтения = Новый Структура("Диагностика, КоличествоОшибок, КоличествоПредупреждений, ЕстьНевалидныеСтроки, ЧтениеНеполное, КлассОтказа, ПрочитанныйОтрезок");
	ЗаполнитьЗначенияСвойств(ДанныеЧтения, Итог);
	АдресДанныхЧтения = ПоместитьВоВременноеХранилище(ДанныеЧтения, УникальныйИдентификатор);

	Если Не Итог.Принята Тогда
		АдресПлана = "";
		Сводка = СтрШаблон(?(ЭтоКоннектор,
			НСтр("ru = 'Чтение из банка не удалось. %1'; uk = 'Читання з банку не вдалося. %1'"),
			НСтр("ru = 'Файл не принят. %1'; uk = 'Файл не прийнято. %1'")), СтрСоединить(Итог.ТекстыОтказа, Символы.ПС));
		Если Итог.ПохожиеНа.Количество() > 0 Тогда
			Сводка = Сводка + Символы.ПС + СтрШаблон(НСтр("ru = 'Файл похож на: %1.'; uk = 'Файл схожий на: %1.'"),
				СтрСоединить(Итог.ПохожиеНа, "; "));
		КонецЕсли;
		Возврат Сводка;
	КонецЕсли;

	АдресПлана = Итог.АдресПлана;
	// Проекция плана - в том же серверном вызове: отдельного вызова на заполнение таблицы нет.
	ТекстПлана = ЗаполнитьПланНаСервере();
	Сводка = СтрШаблон(НСтр("ru = 'Распознано операций: %1.'; uk = 'Розпізнано операцій: %1.'"), Итог.КоличествоОпераций);
	Сводка = Сводка + Символы.ПС + СтрШаблон(
		НСтр("ru = 'Замечания к чтению: ошибок %1, предупреждений %2.'; uk = 'Зауваження до читання: помилок %1, попереджень %2.'"),
		Итог.КоличествоОшибок, Итог.КоличествоПредупреждений);
	Если Итог.ЕстьНевалидныеСтроки Тогда
		Сводка = Сводка + Символы.ПС + НСтр("ru = 'Часть строк файла отброшена как невалидная.';
			|uk = 'Частину рядків файлу відкинуто як невалідні.'");
	КонецЕсли;
	// Неполное чтение по API: отдельный блок по классу отказа (решение 8); полное чтение - блока нет.
	Если ЭтоКоннектор И Итог.ЧтениеНеполное Тогда
		Сводка = Сводка + Символы.ПС + ТекстНеполногоЧтения(Итог);
		Остаток = ПериодОстатка(Итог, Период);
		Если Остаток <> Неопределено Тогда
			Элементы.ПрочитатьОстаток.Видимость = Истина;
			Сводка = Сводка + Символы.ПС + ТекстОстатка(Остаток);
		ИначеЕсли Итог.ПрочитанныйОтрезок <> Неопределено Тогда
			// Остаток после округления до целых дней равен периоду: одна доба превышает предел чтения (решение архитектора, спека a18554f).
			Сводка = Сводка + Символы.ПС + НСтр("ru = 'Одна доба превышает предел чтения: сузить период больше нельзя, остаток не предлагается. Загрузите остальное из файла выписки.';
				|uk = 'Одна доба перевищує межу читання: звузити період більше не можна, решту не пропонується. Завантажте решту з файлу виписки.'");
		КонецЕсли;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстПлана) Тогда
		Сводка = Сводка + Символы.ПС + ТекстПлана;
	КонецЕсли;
	Возврат Сводка;

КонецФункции

// Текст блока «неполное чтение» для человека (решение 8 плана 6б): внутренний литерал класса не показывается.
// «Повторить» - банк временно не ответил; «Действие человека» - тексты диагностики конектора.
&НаСервереБезКонтекста
Функция ТекстНеполногоЧтения(Итог)

	Если Итог.КлассОтказа = СМП_ВыпискаБанка.КлассОтказаПовторить() Тогда
		Возврат НСтр("ru = 'Банк временно не ответил: прочитанное есть в плане и загружается, повторите чтение позже.';
			|uk = 'Банк тимчасово не відповів: прочитане є в плані та завантажується, повторіть читання пізніше.'");
	КонецЕсли;

	Тексты = Новый Массив;
	Для Каждого Сообщение Из Итог.Диагностика Цикл
		Если Тексты.Количество() >= 10 Тогда
			Тексты.Добавить("...");
			Прервать;
		КонецЕсли;
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Возврат СтрШаблон(НСтр("ru = 'Чтение остановлено, нужно действие человека: %1';
		|uk = 'Читання зупинено, потрібна дія людини: %1'"), СтрСоединить(Тексты, Символы.ПС));

КонецФункции

// Текст предложения «прочитать остаток» (решение 10 плана 6б): период, не охваченный чтением, и порядок действий.
&НаСервереБезКонтекста
Функция ТекстОстатка(Остаток)

	Возврат СтрШаблон(НСтр("ru = 'Остаток периода, не охваченный чтением: %1 - %2. Прочитанное до остановки уже в плане: загрузите его, затем нажмите «Прочитать остаток».';
		|uk = 'Решта періоду, не охоплена читанням: %1 - %2. Прочитане до зупинки вже в плані: завантажте його, потім натисніть «Прочитати решту».'"),
		Формат(Остаток.Начало, "ДФ=dd.MM.yyyy"), Формат(Остаток.Конец, "ДФ=dd.MM.yyyy"));

КонецФункции

// Период остатка по прочитанному отрезку данных чтения (решение 10 плана 6б); правила - в модуле менеджера (там их проверяет зонд).
//
// Параметры:
//  ДанныеЧтения - Структура, Неопределено - данные чтения (поле ПрочитанныйОтрезок).
//  Период - СтандартныйПериод - период, который читали.
//
// Возвращаемое значение:
//  Структура, Неопределено - Начало, Конец остатка или Неопределено.
&НаСервереБезКонтекста
Функция ПериодОстатка(ДанныеЧтения, Период)

	Отрезок = ?(ТипЗнч(ДанныеЧтения) = Тип("Структура"), ДанныеЧтения.ПрочитанныйОтрезок, Неопределено);
	Возврат Обработки.СМП_ОбменСБанком.ПериодОстатка(Отрезок, Период.ДатаНачала, Период.ДатаОкончания);

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийТаблицыПлана

&НаКлиенте
Процедура ПланПроекцияЗагружатьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Строка с найденным документом не загружается (D5). Условное оформление уже закрывает отметку,
	// здесь - страховка от пути, где она все же изменилась.
	Если Не ТекущиеДанные.ЗагружатьДоступно Тогда
		ТекущиеДанные.Загружать = Ложь;
	КонецЕсли;
	ОбновитьИтогиПлана(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПланПроекцияПерезаписатьПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТекущиеДанные.ПерезаписатьДоступно Тогда
		ТекущиеДанные.Перезаписать = Ложь;
		ОбновитьИтогиПлана(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	ПрименитьОтметкуПерезаписи(ТекущиеДанные);

КонецПроцедуры

// Отметка «Перезаписать» (и ее снятие) - решение человека «Перезаписать» тем же серверным вызовом, что и остальные правки (ПрименитьРешенияПлана).
// Сервер пересчитывает строку: отмеченная к перезаписи распознается как новая, снятие возвращает ее в состояние найденного документа. Отказ
// сервера (документ помечен на удаление, исчез из базы) показывается общим сообщением, а отметка возвращается к значению в плане.
// Правки строки, сделанные после отметки, при снятии отметки исчезают - человеку об этом сообщает ненавязчивое оповещение (без модальных окон).
&НаКлиенте
Процедура ПрименитьОтметкуПерезаписи(ТекущиеДанные)

	Ключи = Новый Массив;
	Ключи.Добавить(ТекущиеДанные.ПорядковыйНомер);
	Отмечено = ТекущиеДанные.Перезаписать;
	ПрименитьРешенияПлана(Ключи, Новый Структура("Перезаписать", Отмечено));

	Если Отмечено И ТекущиеДанные.Перезаписать Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Перезапись документа'; uk = 'Перезапис документа'"), ,
			НСтр("ru = 'Строка пересчитана как новая: документ будет заполнен заново. Если снять отметку, правки этой строки исчезнут.';
				|uk = 'Рядок перераховано як новий: документ буде заповнено заново. Якщо зняти позначку, правки цього рядка зникнуть.'"));
	КонецЕсли;

КонецПроцедуры

// Двойной клик: отметка - переключает (с учетом доступности); найденный документ - его форма;
// контрагент, счет и договор - помощник реквизитов контрагента; остальные колонки - карточка строки.
&НаКлиенте
Процедура ПланПроекцияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Элементы.ПланПроекцияЗагружать Тогда
		Если ТекущиеДанные.ЗагружатьДоступно Тогда
			ТекущиеДанные.Загружать = Не ТекущиеДанные.Загружать;
			ОбновитьИтогиПлана(ЭтотОбъект);
		КонецЕсли;
	ИначеЕсли Поле = Элементы.ПланПроекцияПерезаписать Тогда
		Если ТекущиеДанные.ПерезаписатьДоступно Тогда
			ТекущиеДанные.Перезаписать = Не ТекущиеДанные.Перезаписать;
			ПрименитьОтметкуПерезаписи(ТекущиеДанные);
		ИначеЕсли ТекущиеДанные.ЗагруженныйПомеченНаУдаление Тогда
			ПоказатьОповещениеПользователя(НСтр("ru = 'Перезапись недоступна'; uk = 'Перезапис недоступний'"), ,
				НСтр("ru = 'Документ помечен на удаление: сначала снимите пометку на удаление.';
					|uk = 'Документ позначено на видалення: спершу зніміть позначку на видалення.'"));
		КонецЕсли;
	ИначеЕсли Поле = Элементы.ПланПроекцияЗагруженныйДокумент И ЗначениеЗаполнено(ТекущиеДанные.ЗагруженныйДокумент) Тогда
		ПоказатьЗначение(, ТекущиеДанные.ЗагруженныйДокумент);
	ИначеЕсли Поле = Элементы.ПланПроекцияВидОперации Тогда
		// Список видов зависит от направления строки: вид меняется только через диалог.
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(Элементы.ПланПроекция.ТекущаяСтрока);
		ОткрытьДиалогИзмененияРеквизитов(Идентификаторы);
	ИначеЕсли Поле = Элементы.ПланПроекцияКонтрагентПредставление Или Поле = Элементы.ПланПроекцияСчетКонтрагента
		Или Поле = Элементы.ПланПроекцияДоговор Тогда
		ОткрытьПомощникКонтрагентаДляСтроки(ТекущиеДанные.ПорядковыйНомер);
	ИначеЕсли Поле = Элементы.ПланПроекцияСтатьяДДС Или Поле = Элементы.ПланПроекцияКорреспонденция
		Или Поле = Элементы.ПланПроекцияСпособЗачета Тогда
		// Эти колонки правятся в клетке: стандартное редактирование, не карточка.
		СтандартнаяОбработка = Истина;
	Иначе
		ОткрытьКарточкуСтроки(ТекущиеДанные.ПорядковыйНомер);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандПлана

// Массовые действия трогают только «Загружать» и только там, где она доступна; «Перезаписать»
// они не ставят никогда (безопасность D5: перезапись - только осознанный выбор человека в строке).
&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаПлана Из ПланПроекция Цикл
		Если СтрокаПлана.ЗагружатьДоступно Тогда
			СтрокаПлана.Загружать = Истина;
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтогиПлана(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	Для Каждого СтрокаПлана Из ПланПроекция Цикл
		СтрокаПлана.Загружать = Ложь;
	КонецЦикла;
	ОбновитьИтогиПлана(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура СнятьСПредупреждениями(Команда)

	Для Каждого СтрокаПлана Из ПланПроекция Цикл
		Если СтрокаПлана.ЕстьПредупреждение Тогда
			СтрокаПлана.Загружать = Ложь;
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтогиПлана(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтрокуПлана(Команда)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьКарточкуСтроки(ТекущиеДанные.ПорядковыйНомер);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыПлана

// Карточка строки открывается не модально и только для просмотра: результата у нее нет.
&НаКлиенте
Процедура ОткрытьКарточкуСтроки(ПорядковыйНомер)

	Если ПустаяСтрока(АдресПлана) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("АдресПлана, ПорядковыйНомер", АдресПлана, ПорядковыйНомер);
	ОткрытьФорму("Обработка.СМП_ОбменСБанком.Форма.ФормаСтрокиПлана", ПараметрыФормы, ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Итоги подвала по отметкам таблицы. Считаются на клиенте из проекции - без серверных вызовов;
// остаток на счете в учете берется один раз вместе с проекцией и от отметок не зависит.
// «К поступлению» и «К списанию» - по строкам с отметкой «Загружать»; перезапись считается отдельно.
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиПлана(Форма)

	Поступление = 0;
	Списание = 0;
	Перезапись = 0;
	Для Каждого СтрокаПлана Из Форма.ПланПроекция Цикл
		Если СтрокаПлана.Загружать Тогда
			Поступление = Поступление + СтрокаПлана.СуммаПоступление;
			Списание = Списание + СтрокаПлана.СуммаСписание;
		КонецЕсли;
		Если СтрокаПлана.Перезаписать Тогда
			Перезапись = Перезапись + 1;
		КонецЕсли;
	КонецЦикла;

	Форма.ИтогоСтрок = Форма.ПланПроекция.Количество();
	Форма.ИтогоПоступление = Поступление;
	Форма.ИтогоСписание = Списание;
	Форма.ИтогоПерезаписать = Перезапись;

КонецПроцедуры

// Прячет таблицу плана и подвал и очищает проекцию (смена файла, счета, формата или новое чтение).
&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьПланВФорме(Форма)

	Форма.ПланПроекция.Очистить();
	Форма.ОстатокНаСчете = 0;
	Форма.ЕстьОстаток = Ложь;
	ОбновитьИтогиПлана(Форма);
	Форма.Элементы.ГруппаПлан.Видимость = Ложь;
	Форма.Элементы.ГруппаИтоги.Видимость = Ложь;
	Форма.Элементы.ГруппаЗагрузка.Видимость = Ложь;

КонецПроцедуры

// Заполняет проекцию плана и итоги: в том же серверном вызове, что забирает результат чтения
// (ПолучитьРезультатЧтенияНаСервере); отдельного вызова на заполнение и вызовов на строку нет.
// Возвращает текст для человека, если плана больше нет.
&НаСервере
Функция ЗаполнитьПланНаСервере()

	Проекция = Обработки.СМП_ОбменСБанком.ПроекцияПлана(АдресПлана);
	Если Не Проекция.Найден Тогда
		ОчиститьПланВФорме(ЭтотОбъект);
		Возврат Проекция.ТекстОтказа;
	КонецЕсли;

	ЗначениеВРеквизитФормы(Проекция.Строки, "ПланПроекция");
	ОстатокНаСчете = Проекция.ОстатокНаСчете;
	ЕстьОстаток = Проекция.ЕстьОстаток;
	ОбновитьИтогиПлана(ЭтотОбъект);

	Элементы.ОстатокНаСчете.Видимость = ЕстьОстаток;
	Элементы.ГруппаПлан.Видимость = Истина;
	Элементы.ГруппаИтоги.Видимость = Истина;
	Элементы.ГруппаЗагрузка.Видимость = Истина;
	Возврат "";

КонецФункции

#КонецОбласти

#Область ИзменениеРеквизитовПлана

// Диалог правки открывается не модально для выделенных строк; результат - в ПослеИзмененияРеквизитов.
&НаКлиенте
Процедура ИзменитьРеквизитыСтрокПлана(Команда)

	Идентификаторы = Новый Массив;
	Для Каждого Идентификатор Из Элементы.ПланПроекция.ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(Идентификатор);
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 И Элементы.ПланПроекция.ТекущаяСтрока <> Неопределено Тогда
		Идентификаторы.Добавить(Элементы.ПланПроекция.ТекущаяСтрока);
	КонецЕсли;
	ОткрытьДиалогИзмененияРеквизитов(Идентификаторы);

КонецПроцедуры

// Направление и виды выбранных строк форма берет из проекции и передает диалогу; правил учета здесь нет.
&НаКлиенте
Процедура ОткрытьДиалогИзмененияРеквизитов(Идентификаторы)

	Если ПустаяСтрока(АдресПлана) Или Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ключи = Новый Массив;
	ВидыСтрок = Новый Массив;
	ЕстьПоступление = Ложь;
	ЕстьСписание = Ложь;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		СтрокаПлана = ПланПроекция.НайтиПоИдентификатору(Идентификатор);
		Если СтрокаПлана = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключи.Добавить(СтрокаПлана.ПорядковыйНомер);
		Если СтрокаПлана.СуммаПоступление <> 0 Тогда
			ЕстьПоступление = Истина;
		ИначеЕсли СтрокаПлана.СуммаСписание <> 0 Тогда
			ЕстьСписание = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаПлана.ВидОперации) И ВидыСтрок.Найти(СтрокаПлана.ВидОперации) = Неопределено Тогда
			ВидыСтрок.Добавить(СтрокаПлана.ВидОперации);
		КонецЕсли;
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КоличествоСтрок", Ключи.Количество());
	ПараметрыФормы.Вставить("ЕстьПоступление", ЕстьПоступление);
	ПараметрыФормы.Вставить("ЕстьСписание", ЕстьСписание);
	ПараметрыФормы.Вставить("ВидыСтрок", ВидыСтрок);
	Оповещение = Новый ОписаниеОповещения("ПослеИзмененияРеквизитов", ЭтотОбъект, Ключи);
	ОткрытьФорму("Обработка.СМП_ОбменСБанком.Форма.ФормаИзмененияРеквизитов", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияРеквизитов(Результат, Ключи) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ПрименитьРешенияПлана(Ключи, Результат);

КонецПроцедуры

// Помощник реквизитов контрагента для текущей строки (команда и двойной клик по контрагенту, счету, договору).
&НаКлиенте
Процедура ОткрытьПомощникКонтрагента(Команда)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОткрытьПомощникКонтрагентаДляСтроки(ТекущиеДанные.ПорядковыйНомер);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПомощникКонтрагентаДляСтроки(ПорядковыйНомер)

	Если ПустаяСтрока(АдресПлана) Тогда
		Возврат;
	КонецЕсли;

	Ключи = Новый Массив;
	Ключи.Добавить(ПорядковыйНомер);
	ПараметрыФормы = Новый Структура("АдресПлана, ПорядковыйНомер", АдресПлана, ПорядковыйНомер);
	Оповещение = Новый ОписаниеОповещения("ПослеПомощникаКонтрагента", ЭтотОбъект, Ключи);
	ОткрытьФорму("Обработка.СМП_ОбменСБанком.Форма.ФормаРеквизитовКонтрагента", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Результат помощника - решения и признак «для всех»; применяются тем же вызовом, что и результат диалога (режим выбирает сервер).
&НаКлиенте
Процедура ПослеПомощникаКонтрагента(Результат, Ключи) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ПрименитьРешенияПлана(Ключи, Результат.Решения, Результат.ДляВсех);

КонецПроцедуры

&НаКлиенте
Процедура ПланПроекцияСтатьяДДСПриИзменении(Элемент)

	ПрименитьРешениеКлетки("СтатьяДДС");

КонецПроцедуры

&НаКлиенте
Процедура ПланПроекцияКорреспонденцияПриИзменении(Элемент)

	ПрименитьРешениеКлетки("Корреспонденция");

КонецПроцедуры

&НаКлиенте
Процедура ПланПроекцияСпособЗачетаПриИзменении(Элемент)

	ПрименитьРешениеКлетки("СпособЗачета");

КонецПроцедуры

// Правка в клетке - то же решение человека для одной строки, что и из диалога: тот же серверный вызов.
// Если решение не применилось, сервер возвращает прежние значения строки, и клетка откатывается.
&НаКлиенте
Процедура ПрименитьРешениеКлетки(ИмяРешения)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ключи = Новый Массив;
	Ключи.Добавить(ТекущиеДанные.ПорядковыйНомер);
	ПрименитьРешенияПлана(Ключи, Новый Структура(ИмяРешения, ТекущиеДанные[ИмяРешения]));

КонецПроцедуры

// Один серверный вызов на действие человека. Дельта обновляет колонки решений и производные, а также отметку «Перезаписать» с доступностью
// (ее меняет решение «Перезаписать»; у отказанной строки она возвращается к значению в плане); отметка «Загружать» и ее доступность остаются как
// есть. Отказы показываются одним сообщением, без модальных окон.
&НаКлиенте
Процедура ПрименитьРешенияПлана(Ключи, Решения, ДляВсех = Ложь)

	Если ПустаяСтрока(АдресПлана) Тогда
		Возврат;
	КонецЕсли;

	Итог = ПрименитьРешенияНаСервере(Ключи, Решения, ДляВсех);
	Если Не Итог.Найден Тогда
		АдресПлана = "";
		ОчиститьПланВФорме(ЭтотОбъект);
		ПоказатьСводку(Итог.ТекстОтказа);
		Возврат;
	КонецЕсли;

	ПрименитьДельтуКПроекции(ЭтотОбъект, Итог.Строки);

	Тексты = Новый Массив;
	Если Не ПустаяСтрока(Итог.ТекстОтказа) Тогда
		Тексты.Добавить(Итог.ТекстОтказа);
	КонецЕсли;
	Если Итог.Отказы.Количество() > 0 Тогда
		Тексты.Добавить(НСтр("ru = 'Не удалось изменить строки:'; uk = 'Не вдалося змінити рядки:'"));
		Для Индекс = 0 По Мин(Итог.Отказы.Количество(), 10) - 1 Цикл
			ОтказСтроки = Итог.Отказы[Индекс];
			Тексты.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: %2'; uk = 'Рядок %1: %2'"), ОтказСтроки.ПорядковыйНомер, ОтказСтроки.Текст));
		КонецЦикла;
		Если Итог.Отказы.Количество() > 10 Тогда
			Тексты.Добавить(СтрШаблон(НСтр("ru = 'и ещё строк: %1'; uk = 'та ще рядків: %1'"), Итог.Отказы.Количество() - 10));
		КонецЕсли;
	КонецЕсли;
	// Итог запоминания статьи: причины - в общем предупреждении, успех без замечаний - ненавязчивым оповещением.
	Если Не ПустаяСтрока(Итог.ТекстЗапоминания) Тогда
		Если Итог.ЗапоминаниеТребуетВнимания Или Тексты.Количество() > 0 Тогда
			Тексты.Добавить(Итог.ТекстЗапоминания);
		Иначе
			ПоказатьОповещениеПользователя(НСтр("ru = 'Запомнить статью'; uk = 'Запам''ятати статтю'"), , Итог.ТекстЗапоминания);
		КонецЕсли;
	КонецЕсли;
	Если Тексты.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Тексты, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

// Применяет решения человека к строкам плана (фасад обработки) и возвращает дельту проекции массивом структур: только колонки
// решений и производные от них. Строки, к которым решение не применилось, возвращаются с текущими значениями - форма откатывает клетку.
&НаСервере
Функция ПрименитьРешенияНаСервере(Ключи, Решения, ДляВсех)

	// Запоминание статьи (флажок формы) идет тем же вызовом, что и правка: второго серверного вызова на действие человека нет.
	// Учетную запись определяет сервер по счету, а не реквизит формы.
	Дельта = Обработки.СМП_ОбменСБанком.ПрименитьРешенияЧеловека(АдресПлана, Ключи, ДляВсех, Решения, УчетнаяЗаписьСчета(), БанковскийСчет,
		ЗапомнитьСтатью);

	Итог = Новый Структура("Найден, ТекстОтказа, Отказы, Строки, ТекстЗапоминания, ЗапоминаниеТребуетВнимания", Дельта.Найден,
		Дельта.ТекстОтказа, Дельта.Отказы, Новый Массив, Дельта.ТекстЗапоминания, Дельта.ЗапоминаниеТребуетВнимания);
	// Строки отказов (и все переданные строки, если решение не применено) приходят в дельте с текущими значениями: клетки откатываются.
	Итог.Строки = СтрокиДельтыПроекции(Дельта.Строки, "ПорядковыйНомер,Перезаписать,ПерезаписатьДоступно,ВидОперации,СтатьяДДС,"
		+ "Корреспонденция,Контрагент,КонтрагентПредставление,Договор,СчетКонтрагента,ПлатежноеПоручение,Основа,ПроверьтеОперацию,"
		+ "СпособЗачета,ОсноваДоступна,УровеньЗамечаний,ЕстьОшибка,ЕстьПредупреждение,КоличествоЗамечаний,СтрокаНеЗаписывается");
	Возврат Итог;

КонецФункции

// Строки дельты проекции (таблица менеджера) массивом структур: только перечисленные колонки.
&НаСервереБезКонтекста
Функция СтрокиДельтыПроекции(ТаблицаДельты, ПоляДельты)

	Результат = Новый Массив;
	Для Каждого СтрокаДельты Из ТаблицаДельты Цикл
		ДанныеСтроки = Новый Структура(ПоляДельты);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДельты);
		Результат.Добавить(ДанныеСтроки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Применяет дельту к таблице плана формы: колонки дельты по ключу строки (ПорядковыйНомер); итоги подвала пересчитываются.
&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьДельтуКПроекции(Форма, СтрокиДельты)

	Для Каждого СтрокаДельты Из СтрокиДельты Цикл
		Найденные = Форма.ПланПроекция.НайтиСтроки(Новый Структура("ПорядковыйНомер", СтрокаДельты.ПорядковыйНомер));
		Если Найденные.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Найденные[0], СтрокаДельты);
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтогиПлана(Форма);

КонецПроцедуры

#КонецОбласти

#Область Запись

// «Загрузить»: строки, выбранные человеком, - новые с отметкой «Загружать» и найденные с отметкой «Перезаписать». Тот же путь, что и у
// «Загрузить текущую строку»: ПодготовитьЗапись.
&НаКлиенте
Процедура ЗагрузитьВыбранныеСтроки(Команда)

	Выбранные = Новый Массив;
	Для Каждого СтрокаПлана Из ПланПроекция Цикл
		Если СтрокаПлана.Загружать Или СтрокаПлана.Перезаписать Тогда
			Выбранные.Добавить(СтрокаПлана.ПорядковыйНомер);
		КонецЕсли;
	КонецЦикла;
	ПодготовитьЗапись(Выбранные);

КонецПроцедуры

// «Загрузить текущую строку»: тот же путь, что и «Загрузить», с одним ключом (протокол, диалог завершения и оповещение - те же).
// Новая строка грузится и без отметки «Загружать» (человек просит явно); найденный документ - только с отметкой «Перезаписать».
&НаКлиенте
Процедура ЗагрузитьТекущуюСтрокуПлана(Команда)

	ТекущиеДанные = Элементы.ПланПроекция.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите строку плана.'; uk = 'Оберіть рядок плану.'"));
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.ЗагруженныйДокумент) И Не ТекущиеДанные.Перезаписать Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Документ этой операции уже загружен. Чтобы заменить его данными выписки, отметьте «Перезаписать».';
			|uk = 'Документ цієї операції вже завантажено. Щоб замінити його даними виписки, позначте «Перезаписати».'"));
		Возврат;
	КонецЕсли;

	Выбранные = Новый Массив;
	Выбранные.Добавить(ТекущиеДанные.ПорядковыйНомер);
	ПодготовитьЗапись(Выбранные);

КонецПроцедуры

// Общий путь записи: ключи выбранных строк -> (для перезаписи) данные предупреждения и вопрос на пакет -> запуск тривалої операции.
// Сервер получает только выбранные ключи: остальные новые строки в запись не идут. Серверных вызовов - не больше одного до запуска, от
// числа строк это число не зависит.
&НаКлиенте
Процедура ПодготовитьЗапись(Выбранные)

	Если ЧтениеИдет Или ЗаписьИдет Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(АдресПлана) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нечего загружать: сначала прочитайте файл выписки.'; uk = 'Нічого завантажувати: спершу прочитайте файл виписки.'"));
		Возврат;
	КонецЕсли;
	Если Выбранные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет строк к загрузке: отметьте «Загружать» или «Перезаписать».';
			|uk = 'Немає рядків до завантаження: позначте «Завантажувати» або «Перезаписати».'"));
		Возврат;
	КонецЕсли;

	СтрокПерезаписи = 0;
	Для Каждого СтрокаПлана Из ПланПроекция Цикл
		Если СтрокаПлана.Перезаписать И Выбранные.Найти(СтрокаПлана.ПорядковыйНомер) <> Неопределено Тогда
			СтрокПерезаписи = СтрокПерезаписи + 1;
		КонецЕсли;
	КонецЦикла;

	Если СтрокПерезаписи = 0 Тогда
		ЗапуститьЗапись(Выбранные);
		Возврат;
	КонецЕсли;

	// Диалог на пакет: числа считает сервер с того же плана, что пойдет в запись.
	Предупреждение = ДанныеПредупрежденияНаСервере(Выбранные);
	Если Не Предупреждение.Найден Тогда
		АдресПлана = "";
		ОчиститьПланВФорме(ЭтотОбъект);
		ПоказатьСводку(Предупреждение.ТекстОтказа);
		Возврат;
	КонецЕсли;
	Если Предупреждение.КоличествоПерезаписать = 0 Тогда
		// Перезаписывать нечего (документы помечены на удаление): диалог не нужен, отказ перезаписи будет в протоколе.
		ЗапуститьЗапись(Выбранные);
		Возврат;
	КонецЕсли;

	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Перезаписать и загрузить'; uk = 'Перезаписати і завантажити'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'; uk = 'Скасувати'"));
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОПерезаписи", ЭтотОбъект, Выбранные);
	// Кнопка по умолчанию - «Отмена»: без явного подтверждения запись не стартует.
	ПоказатьВопрос(Оповещение, ТекстПредупрежденияПерезаписи(Предупреждение), Кнопки, , КодВозвратаДиалога.Отмена,
		НСтр("ru = 'Перезапись документов'; uk = 'Перезапис документів'"));

КонецПроцедуры

&НаКлиенте
Функция ТекстПредупрежденияПерезаписи(Предупреждение)

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Будет перезаписано документов: %1, из них проведённых: %2.';
		|uk = 'Буде перезаписано документів: %1, з них проведених: %2.'"),
		Предупреждение.КоличествоПерезаписать, Предупреждение.КоличествоПроведенных));
	Тексты.Добавить(НСтр("ru = 'Ручные правки в этих документах будут заменены данными выписки.';
		|uk = 'Ручні правки в цих документах буде замінено даними виписки.'"));
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Автором перезаписанных документов станет текущий пользователь: %1.';
		|uk = 'Автором перезаписаних документів стане поточний користувач: %1.'"), Предупреждение.Автор));
	Если Предупреждение.КоличествоПроведенных > 0 Тогда
		Тексты.Добавить(НСтр("ru = 'У проведённых документов проведение будет отменено и выполнено заново. Если проведение не удастся, документ останется непроведённым, а его движения исчезнут.';
			|uk = 'У проведених документів проведення буде скасовано і виконано заново. Якщо проведення не вдасться, документ залишиться непроведеним, а його рухи зникнуть.'"));
	КонецЕсли;
	Если Предупреждение.КоличествоПомеченныхНаУдаление > 0 Тогда
		Тексты.Добавить(СтрШаблон(НСтр("ru = 'Документы, помеченные на удаление, перезаписаны не будут: %1.';
			|uk = 'Документи, позначені на видалення, перезаписано не буде: %1.'"), Предупреждение.КоличествоПомеченныхНаУдаление));
	КонецЕсли;
	Тексты.Добавить(НСтр("ru = 'Продолжить?'; uk = 'Продовжити?'"));
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ПослеВопросаОПерезаписи(Ответ, Выбранные) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗапуститьЗапись(Выбранные);

КонецПроцедуры

// Запуск записи тривалой операцией БСП (как чтение): один запуск и один забор результата на действие человека. Кнопки «Отменить» нет:
// запись поза транзакцией, остановка посередине оставила бы часть документов (протокол всегда полный). Закрытие формы блокирует
// ПередЗакрытием, а задание от закрытия формы не отменяется.
&НаКлиенте
Процедура ЗапуститьЗапись(Выбранные)

	// Запись идет под блокировкой учетной записи (решение 10 плана 5б, D35.5): занято обменом регламента или чтением другой формы - отказ с текстом.
	// Блокировка снимается в ПослеЗавершенияЗаписи на любом исходе (и самим закрытием формы).
	ТекстЗанято = ВзятьОбменНаСервере();
	Если Не ПустаяСтрока(ТекстЗанято) Тогда
		ПоказатьСводку(ТекстЗанято);
		Возврат;
	КонецЕсли;

	УстановитьСостояниеЗаписи(Истина);
	ПоказатьСводку(НСтр("ru = 'Идёт запись документов. Не закрывайте форму, пока запись не завершится.';
		|uk = 'Триває запис документів. Не закривайте форму, доки запис не завершиться.'"));

	Операция = ЗапуститьЗаписьНаСервере(Выбранные);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ПараметрыОжидания.ОтменятьПриЗакрытииФормыВладельца = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеЗавершенияЗаписи", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Операция, Оповещение, ПараметрыОжидания);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеЗаписи(Идет)

	ЗаписьИдет = Идет;
	Элементы.ГруппаШапка.Доступность = Не Идет;
	Элементы.ГруппаПлан.Доступность = Не Идет;
	Элементы.ЗагрузитьВыбранные.Доступность = Не Идет;
	Элементы.ЗагрузитьТекущуюСтроку.Доступность = Не Идет;

КонецПроцедуры

// Конец записи: дельта в таблицу, оповещение списков (один раз на пакет), форма завершения с протоколом.
&НаКлиенте
Процедура ПослеЗавершенияЗаписи(Результат, ДополнительныеПараметры) Экспорт

	УстановитьСостояниеЗаписи(Ложь);
	// Запись закончена на любом исходе: блокировка учетной записи, взятая на время записи, снимается явно (решение 10 плана 5б).
	ОтпуститьОбменНаСервере();

	Если Результат = Неопределено Тогда
		ПоказатьСводку(НСтр("ru = 'Запись прервана. Прочитайте файл ещё раз, чтобы увидеть, что записано.';
			|uk = 'Запис перервано. Прочитайте файл ще раз, щоб побачити, що записано.'"));
		Возврат;
	КонецЕсли;
	Если Результат.Статус <> "Выполнено" Тогда
		ПоказатьСводку(СтрШаблон(НСтр("ru = 'Запись завершилась ошибкой: %1. Часть документов могла быть записана: прочитайте файл ещё раз.';
			|uk = 'Запис завершився помилкою: %1. Частину документів могло бути записано: прочитайте файл ще раз.'"),
			Результат.КраткоеПредставлениеОшибки));
		Возврат;
	КонецЕсли;

	// Сообщения фонового задания - отдельным блоком протокола (не смешиваются с замечаниями записи).
	СообщенияФона = Новый Массив;
	Если Результат.Свойство("Сообщения") И Результат.Сообщения <> Неопределено Тогда
		Для Каждого Сообщение Из Результат.Сообщения Цикл
			СообщенияФона.Добавить(Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;

	// Один серверный вызов: протокол, дельта в план, сводка.
	Итог = ПрименитьРезультатЗаписиНаСервере(Результат.АдресРезультата);
	Если Не Итог.Принят Тогда
		ПоказатьСводку(Итог.ТекстОтказа);
		Возврат;
	КонецЕсли;

	ПрименитьДельтуКПроекции(ЭтотОбъект, Итог.Строки);
	ПоказатьСводку(Итог.Сводка + ?(ПустаяСтрока(Итог.ТекстОтказа), "", Символы.ПС + Итог.ТекстОтказа));

	Если Итог.ЕстьИзменения Тогда
		ОповеститьСписки();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("АдресПротокола, СообщенияФона", Результат.АдресРезультата, СообщенияФона);
	ОткрытьФорму("Обработка.СМП_ОбменСБанком.Форма.ФормаЗавершения", ПараметрыФормы, ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

// Оповещение открытых списков «Банк и касса» тем же способом, каким это делает форма документа вендора (вимір 0.5, П-З):
// ОповеститьОбИзменении за типами документов и «ОповещениеОбИзмененииДолга». Один раз на пакет. Что оновится в открытом журнале - проверяет
// человек в дев-базе (D10).
&НаКлиенте
Процедура ОповеститьСписки()

	ОповеститьОбИзменении(Тип("ДокументСсылка.ПоступлениеНаСчет"));
	ОповеститьОбИзменении(Тип("ДокументСсылка.РасходСоСчета"));
	Оповестить("ОповещениеОбИзмененииДолга");

КонецПроцедуры

// Пока запись идет, форму закрыть нельзя: протокол и оповещение выполняет обработчик завершения этой формы.
// Закрытие вкладки браузера или F5 в веб-клиенте не удержать (ограничение платформы, в чек-листе приемки).
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не ЗаписьИдет Тогда
		// Форма закрывается: блокировку учетной записи, взятую чтением или записью, снимаем явно, не дожидаясь платформы (решение 10 плана 5б);
		// при завершении работы блокировку снимет конец сеанса.
		Если Не ЗавершениеРаботы Тогда
			ОтпуститьОбменНаСервере();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Отказ = Истина;
	Текст = НСтр("ru = 'Идёт запись документов банка. Дождитесь завершения: иначе протокол записи будет потерян.';
		|uk = 'Триває запис документів банку. Дочекайтеся завершення: інакше протокол запису буде втрачено.'");
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = Текст;
	Иначе
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДанныеПредупрежденияНаСервере(Выбранные)

	Данные = Обработки.СМП_ОбменСБанком.ДанныеПредупрежденияПерезаписи(АдресПлана, Выбранные);
	Данные.Вставить("Автор", Строка(Пользователи.ТекущийПользователь()));
	Возврат Данные;

КонецФункции

// Учетная запись счета для серверных вызовов записи: определяет сервер по счету (ИсточникЧтенияСчета), реквизиту формы
// УчетнаяЗапись (только для показа) сервер не доверяет.
&НаСервере
Функция УчетнаяЗаписьСчета()

	Возврат Обработки.СМП_ОбменСБанком.ИсточникЧтенияСчета(БанковскийСчет).УчетнаяЗапись;

КонецФункции

&НаСервере
Функция ЗапуститьЗаписьНаСервере(Выбранные)

	Вход = Обработки.СМП_ОбменСБанком.НовыйВходЗаписи();
	Вход.АдресПлана = АдресПлана;
	Вход.Выбранные = Выбранные;
	Вход.УчетнаяЗапись = УчетнаяЗаписьСчета();
	Вход.БанковскийСчет = БанковскийСчет;
	// Автор документов - поточный пользователь (D16); задание его не читает, он передан параметром (вимір 0.2).
	Вход.Ответственный = Пользователи.ТекущийПользователь();
	Вход.АдресДанныхЧтения = АдресДанныхЧтения;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Запись документов по выписке банка'; uk = 'Запис документів за випискою банку'");
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Обработки.СМП_ОбменСБанком.ЗаписатьПлан", Вход);

КонецФункции

// Забирает протокол записи, применяет дельту к плану и возвращает дельту проекции массивом структур и короткую сводку.
// Дельта - только колонки, которые меняет запись: найденный документ, его версия и отметки (запись «Загружать» для этих строк закрывает).
&НаСервере
Функция ПрименитьРезультатЗаписиНаСервере(АдресРезультата)

	Итог = Новый Структура("Принят, ТекстОтказа, ЕстьИзменения, Строки, Сводка", Ложь, "", Ложь, Новый Массив, "");

	Протокол = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Протокол) <> Тип("Структура") Или Не Протокол.Свойство("Выполнено") Тогда
		Итог.ТекстОтказа = НСтр("ru = 'Результат записи недоступен. Прочитайте файл ещё раз.'; uk = 'Результат запису недоступний. Прочитайте файл ще раз.'");
		Возврат Итог;
	КонецЕсли;
	Если Не Протокол.Выполнено Тогда
		Итог.ТекстОтказа = Протокол.ТекстОтказа;
		Возврат Итог;
	КонецЕсли;
	Итог.Принят = Истина;

	Дельта = Обработки.СМП_ОбменСБанком.ПрименитьРезультатЗаписи(АдресПлана, Протокол);
	Если Не Дельта.Найден Тогда
		Итог.ТекстОтказа = Дельта.ТекстОтказа;
	КонецЕсли;
	Итог.Строки = СтрокиДельтыПроекции(Дельта.Строки, "ПорядковыйНомер,Загружать,ЗагружатьДоступно,Перезаписать,ПерезаписатьДоступно,"
		+ "ЗагруженныйДокумент,ЗагруженныйПомеченНаУдаление,ВерсияДокумента");
	Итог.ЕстьИзменения = Протокол.Дельта.Количество() > 0;

	Счетчики = Протокол.Счетчики;
	Итог.Сводка = СтрШаблон(
		НСтр("ru = 'Запись завершена. Создано: %1 (не проведено: %2), перезаписано: %3 (не проведено: %4), не перезаписано: %5, уже загружено: %6, ошибок: %7.';
			|uk = 'Запис завершено. Створено: %1 (не проведено: %2), перезаписано: %3 (не проведено: %4), не перезаписано: %5, вже завантажено: %6, помилок: %7.'"),
		Счетчики.Создан + Счетчики.СозданНепроведенным, Счетчики.СозданНепроведенным,
		Счетчики.Перезаписан + Счетчики.ПерезаписанНепроведенным, Счетчики.ПерезаписанНепроведенным,
		Счетчики.НеПерезаписаноПомеченНаУдаление + Счетчики.НеПерезаписаноИзмененПослеПоказа + Счетчики.НеПерезаписаноПрочее,
		Счетчики.УжеЗагружен, Счетчики.Ошибка);
	Возврат Итог;

КонецФункции

#КонецОбласти

// Блокировка обмена учетной записи счета на время чтения по API или записи этой формой (решение 10 плана 5б, D35.5): ключ записи регистра
// состояния, с идентификатором формы; занято обменом регламента или другой формой - текст отказа, иначе пусто. Нет учетной записи счета - блокировать нечего.
&НаСервере
Функция ВзятьОбменНаСервере()

	УчетнаяЗапись = УчетнаяЗаписьСчета();
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Или СМП_ОбменСБанкомКонвейер.ЗаблокироватьУчетнуюЗапись(УчетнаяЗапись, УникальныйИдентификатор) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СМП_ОбменСБанкомКонвейер.ТекстОтказаБлокировки();

КонецФункции

// Снимает блокировку обмена, взятую этой формой (ВзятьОбменНаСервере): явно, на отказе, на конце операции и при закрытии формы.
&НаСервере
Процедура ОтпуститьОбменНаСервере()

	УчетнаяЗапись = УчетнаяЗаписьСчета();
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		СМП_ОбменСБанкомКонвейер.РазблокироватьУчетнуюЗапись(УчетнаяЗапись, УникальныйИдентификатор);
	КонецЕсли;

КонецПроцедуры
