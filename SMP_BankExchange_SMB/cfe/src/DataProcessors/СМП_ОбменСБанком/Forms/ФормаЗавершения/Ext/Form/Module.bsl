#Область ОбработчикиСобытийФормы

// Форма завершения - только просмотр протокола записи (ЗаписатьПлан): данные берутся из временного хранилища одним чтением, расчетов и
// обращений к базе, кроме представлений ссылок, здесь нет. Что показывать, решает код (в макете все группы видимы).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Протокол = Неопределено;
	Если Не ПустаяСтрока(Параметры.АдресПротокола) И ЭтоАдресВременногоХранилища(Параметры.АдресПротокола) Тогда
		Протокол = ПолучитьИзВременногоХранилища(Параметры.АдресПротокола);
	КонецЕсли;
	Если ТипЗнч(Протокол) <> Тип("Структура") Или Не Протокол.Свойство("Выполнено") Или Не Протокол.Выполнено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Протокол записи больше не доступен.'; uk = 'Протокол запису більше не доступний.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПротокола Из Протокол.Строки Цикл
		СтрокаФормы = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, СтрокаПротокола);
		СтрокаФормы.СозданоТекст = ТекстСозданныхОбъектов(СтрокаПротокола);
	КонецЦикла;

	Для Каждого Замечание Из Протокол.Замечания Цикл
		СтрокаФормы = Замечания.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, Замечание);
		СтрокаФормы.УровеньТекст = ТекстУровня(Замечание.Уровень);
	КонецЦикла;

	Чтение = Протокол.Чтение;
	Для Каждого Сообщение Из Чтение.Диагностика Цикл
		СтрокаФормы = Диагностика.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаФормы, Сообщение);
		СтрокаФормы.УровеньТекст = ТекстУровня(Сообщение.Уровень);
	КонецЦикла;

	Итоги = ТекстИтогов(Протокол.Счетчики);
	// Неполное чтение (D36 п. 8) - первым, до счетчиков: иначе человек его не заметит среди итогов.
	Если Чтение.ЧтениеНеполное Тогда
		Итоги = ПредупреждениеНеполногоЧтения() + Символы.ПС + Символы.ПС + Итоги;
	КонецЕсли;
	ТекстНеполногоЧтения = ТекстПредупрежденийЧтения(Чтение);
	Если ТипЗнч(Параметры.СообщенияФона) = Тип("Массив") Тогда
		СообщенияФона = СтрСоединить(Параметры.СообщенияФона, Символы.ПС);
	КонецЕсли;

	Элементы.ГруппаЗамечания.Видимость = Замечания.Количество() > 0;
	Элементы.ГруппаЧтение.Видимость = Диагностика.Количество() > 0 Или Не ПустаяСтрока(ТекстНеполногоЧтения);
	Элементы.ТекстНеполногоЧтения.Видимость = Не ПустаяСтрока(ТекстНеполногоЧтения);
	Элементы.Диагностика.Видимость = Диагностика.Количество() > 0;
	Элементы.ГруппаСообщенияФона.Видимость = Не ПустаяСтрока(СообщенияФона);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Документ строки открывается по двойному щелчку на колонке «Документ».
&НаКлиенте
Процедура СтрокиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле <> Элементы.СтрокиДокумент Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Внутренние литералы людям не показываются (П-И): тексты счетчиков - здесь, тексты результатов строк - в модуле менеджера.
&НаСервереБезКонтекста
Функция ТекстИтогов(Счетчики)

	Тексты = Новый Массив;
	Тексты.Добавить(СтрШаблон(НСтр("ru = 'Строк в протоколе: %1'; uk = 'Рядків у протоколі: %1'"), Счетчики.Всего));

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Имя, Шаблон", "Создан", НСтр("ru = 'Создано и проведено: %1'; uk = 'Створено і проведено: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "СозданНепроведенным",
		НСтр("ru = 'Создано, но не проведено: %1'; uk = 'Створено, але не проведено: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "Перезаписан",
		НСтр("ru = 'Перезаписано и проведено: %1'; uk = 'Перезаписано і проведено: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "ПерезаписанНепроведенным",
		НСтр("ru = 'Перезаписано, но не проведено: %1'; uk = 'Перезаписано, але не проведено: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "НеПерезаписаноПомеченНаУдаление",
		НСтр("ru = 'Не перезаписано: документ помечен на удаление: %1'; uk = 'Не перезаписано: документ позначено на видалення: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "НеПерезаписаноИзмененПослеПоказа",
		НСтр("ru = 'Не перезаписано: документ изменён после показа: %1'; uk = 'Не перезаписано: документ змінено після показу: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "НеПерезаписаноПрочее",
		НСтр("ru = 'Не перезаписано по другой причине: %1'; uk = 'Не перезаписано з іншої причини: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "УжеЗагружен",
		НСтр("ru = 'Уже загружено ранее: %1'; uk = 'Вже завантажено раніше: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "Ошибка",
		НСтр("ru = 'Не записано из-за ошибки: %1'; uk = 'Не записано через помилку: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "ПрочийРезультат", НСтр("ru = 'Прочий результат: %1'; uk = 'Інший результат: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "СозданоКонтрагентов",
		НСтр("ru = 'Создано контрагентов: %1'; uk = 'Створено контрагентів: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "СозданоСчетов",
		НСтр("ru = 'Создано банковских счетов: %1'; uk = 'Створено банківських рахунків: %1'")));
	Описания.Добавить(Новый Структура("Имя, Шаблон", "СозданоДоговоров", НСтр("ru = 'Создано договоров: %1'; uk = 'Створено договорів: %1'")));

	Для Каждого Описание Из Описания Цикл
		Количество = Счетчики[Описание.Имя];
		Если Количество > 0 Тогда
			Тексты.Добавить(СтрШаблон(Описание.Шаблон, Количество));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

// Предупреждения, относящиеся к чтению файла: неполное чтение, отброшенные строки, число замечаний.
&НаСервереБезКонтекста
Функция ТекстПредупрежденийЧтения(Чтение)

	Тексты = Новый Массив;
	Если Чтение.ЧтениеНеполное Тогда
		Тексты.Добавить(ПредупреждениеНеполногоЧтения());
	КонецЕсли;
	Если Чтение.ЕстьНевалидныеСтроки Тогда
		Тексты.Добавить(НСтр("ru = 'Часть строк файла отброшена как невалидная.'; uk = 'Частину рядків файлу відкинуто як невалідні.'"));
	КонецЕсли;
	Если Чтение.КоличествоОшибок > 0 Или Чтение.КоличествоПредупреждений > 0 Тогда
		Тексты.Добавить(СтрШаблон(
			НСтр("ru = 'Замечания к чтению: ошибок %1, предупреждений %2.'; uk = 'Зауваження до читання: помилок %1, попереджень %2.'"),
			Чтение.КоличествоОшибок, Чтение.КоличествоПредупреждений));
	КонецЕсли;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстУровня(Уровень)

	Если Уровень = СМП_ВыпискаБанка.УровеньОшибка() Тогда
		Возврат НСтр("ru = 'Ошибка'; uk = 'Помилка'");
	ИначеЕсли Уровень = СМП_ВыпискаБанка.УровеньПредупреждение() Тогда
		Возврат НСтр("ru = 'Предупреждение'; uk = 'Попередження'");
	КонецЕсли;
	Возврат Уровень;

КонецФункции

// Объекты, созданные записью для строки (контрагент, счет, договор), - текстом.
&НаСервереБезКонтекста
Функция ТекстСозданныхОбъектов(СтрокаПротокола)

	Части = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаПротокола.СозданКонтрагент) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'контрагент: %1'; uk = 'контрагент: %1'"), СтрокаПротокола.СозданКонтрагент));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПротокола.СозданСчет) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'банковский счет: %1'; uk = 'банківський рахунок: %1'"), СтрокаПротокола.СозданСчет));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПротокола.СозданДоговор) Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'договор: %1'; uk = 'договір: %1'"), СтрокаПротокола.СозданДоговор));
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ПредупреждениеНеполногоЧтения()

	Возврат НСтр("ru = 'Чтение было неполным: часть операций банка могла не попасть в план. Прочитайте выписку ещё раз.';
		|uk = 'Читання було неповним: частина операцій банку могла не потрапити до плану. Прочитайте виписку ще раз.'");

КонецФункции
