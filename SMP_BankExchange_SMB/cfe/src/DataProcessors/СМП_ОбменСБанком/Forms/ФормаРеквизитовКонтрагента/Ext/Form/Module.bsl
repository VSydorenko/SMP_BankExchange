#Область ОбработчикиСобытийФормы

// Помощник реквизитов контрагента для одной строки плана (D10, D6). Форма только собирает решения человека (контрагент, счет, договор,
// банк нового счета, «для всех») и возвращает их владельцу; применяет их фасад обработки через функцию распознавания, учетных правил здесь
// нет. «Создать сейчас» открывает форму нового объекта вендора - объект создает она, а не эта форма.
//
// Параметры формы:
//  АдресПлана - Строка - адрес плана загрузки во временном хранилище.
//  ПорядковыйНомер - Число - ключ строки плана.
//
// Результат закрытия: Структура(Решения, ДляВсех) - решения для ПрименитьРешенияЧеловека обработки и признак «ко всем строкам с тем же
// кодом и счетом» (множество определяет сервер); Неопределено - ничего не менялось.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресПлана = Параметры.АдресПлана;
	ПорядковыйНомер = Параметры.ПорядковыйНомер;

	Данные = Обработки.СМП_ОбменСБанком.ДанныеПомощникаКонтрагента(АдресПлана, ПорядковыйНомер);
	Если Не Данные.Найдена Тогда
		ОбщегоНазначения.СообщитьПользователю(Данные.ТекстОтказа);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заголовок = Данные.Заголовок;
	ФактНаименование = Данные.Наименование;
	ФактКод = Данные.Код;
	ФактНомерСчета = Данные.НомерСчета;
	ФактМФО = Данные.МФО;

	Контрагент = Данные.Контрагент;
	СчетКонтрагента = Данные.СчетКонтрагента;
	Договор = Данные.Договор;
	БанкНовогоСчета = Данные.БанкНовогоСчета;
	НачальныйБанк = Данные.БанкНовогоСчета;
	// Выбор банка - только среди банков с МФО номера счета; единственный такой банк показывается и не выбирается (решение не нужно).
	Если ЗначениеЗаполнено(Данные.БанкПоМФО) И Не ЗначениеЗаполнено(БанкНовогоСчета) Тогда
		БанкНовогоСчета = Данные.БанкПоМФО;
		НачальныйБанк = Данные.БанкПоМФО;
		Элементы.БанкНовогоСчета.ТолькоПросмотр = Истина;
	ИначеЕсли Не ПустаяСтрока(Данные.МФОСчета) Тогда
		Элементы.БанкНовогоСчета.ПараметрыВыбора = Новый ФиксированныйМассив(ЗначениеВМассивПараметраВыбора("Отбор.Код", Данные.МФОСчета));
	КонецЕсли;
	НеСоздаватьСейчас = Данные.НеСоздаватьСейчас;

	// Начальный режим - то, что сейчас в строке: «не создавать» (решение человека), выбранный или найденный контрагент, иначе создание по правилам.
	Если Данные.НеСоздаватьСейчас Тогда
		РежимКонтрагента = "НеСоздавать";
	ИначеЕсли ЗначениеЗаполнено(Данные.Контрагент) Тогда
		РежимКонтрагента = "Выбрать";
	Иначе
		РежимКонтрагента = "Создать";
	КонецЕсли;

	Пояснения = Новый Массив;
	Если Данные.ЭтоСотрудник Тогда
		Пояснения.Добавить(НСтр("ru = 'Контрагент строки - сотрудник; помощник его не меняет. Выбор контрагента из справочника заменит сотрудника.';
			|uk = 'Контрагент рядка - працівник; помічник його не змінює. Вибір контрагента з довідника замінить працівника.'"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.Контрагент) И Данные.КонтрагентНайден Тогда
		Пояснения.Добавить(НСтр("ru = 'Контрагент найден в базе по правилам; «создать при загрузке» ничего не меняет - чтобы заменить его, выберите другого.';
			|uk = 'Контрагента знайдено в базі за правилами; «створити під час завантаження» нічого не змінює - щоб замінити його, оберіть іншого.'"));
	КонецЕсли;
	Если Не Данные.ТребуетсяКонтрагент Тогда
		Пояснения.Добавить(НСтр("ru = 'Виду операции строки контрагент не нужен: выбор контрагента к строке не применится.';
			|uk = 'Виду операції рядка контрагент не потрібен: вибір контрагента до рядка не застосується.'"));
	ИначеЕсли Не Данные.ТребуетсяДоговор Тогда
		Пояснения.Добавить(НСтр("ru = 'Виду операции строки договор не нужен: выбор договора к строке не применится.';
			|uk = 'Виду операції рядка договір не потрібен: вибір договору до рядка не застосується.'"));
	КонецЕсли;
	Элементы.Состояние.Заголовок = Данные.Состояние;
	Элементы.Пояснение.Заголовок = ?(Пояснения.Количество() > 0, СтрСоединить(Пояснения, Символы.ПС), " ");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьДоступность();

КонецПроцедуры

// Оповещение формы нового контрагента вендора («Запись_Контрагент», параметр - ссылка): надежнее, чем результат закрытия формы, который
// для стандартной команды «Записать и закрыть» не гарантирован. Берется только оповещение формы, открытой этим помощником.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "Запись_Контрагент" Или ТипЗнч(Параметр) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Источник) <> Тип("ФормаКлиентскогоПриложения") Или Источник.ВладелецФормы <> ЭтотОбъект Тогда
		Возврат;
	КонецЕсли;
	ПодставитьКонтрагента(Параметр);

КонецПроцедуры

// Выбор из формы нового договора вендора (форма оповещает владельца через ОповеститьОВыборе, когда открыта с «ОповеститьОЗаписиДоговора»).
&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Договор = ВыбранноеЗначение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РежимКонтрагентаПриИзменении(Элемент)

	ОбновитьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	// Счет и договор принадлежат прежнему контрагенту (связь параметров выбора их очищает, здесь - для явности и доступности).
	СчетКонтрагента = ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");
	Договор = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	ОбновитьДоступность();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Результат - только то, что человек действительно задал: выбранный контрагент со счетом и договором, «не создавать» или снятие «не создавать»,
// банк нового счета (если изменился). Режим «по правилам» без изменений ничего не возвращает.
&НаКлиенте
Процедура Применить(Команда)

	Решения = Новый Структура;
	Если РежимКонтрагента = "Выбрать" Тогда
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите контрагента или другой режим.';
				|uk = 'Оберіть контрагента або інший режим.'"), , "Контрагент");
			Возврат;
		КонецЕсли;
		Решения.Вставить("Контрагент", Контрагент);
		Если ЗначениеЗаполнено(СчетКонтрагента) Тогда
			Решения.Вставить("СчетКонтрагента", СчетКонтрагента);
		КонецЕсли;
		Если ЗначениеЗаполнено(Договор) Тогда
			Решения.Вставить("Договор", Договор);
		КонецЕсли;
	ИначеЕсли РежимКонтрагента = "НеСоздавать" Тогда
		Решения.Вставить("НеСоздаватьКонтрагента", Истина);
	ИначеЕсли НеСоздаватьСейчас Тогда
		// «По правилам» после прежнего «не создавать»: решение снимается, контрагент снова считается правилами.
		Решения.Вставить("НеСоздаватьКонтрагента", Ложь);
	КонецЕсли;

	Если РежимКонтрагента <> "НеСоздавать" И БанкНовогоСчета <> НачальныйБанк Тогда
		Решения.Вставить("БанкНовогоСчета", БанкНовогоСчета);
	КонецЕсли;

	Если Решения.Количество() = 0 Тогда
		Закрыть(Неопределено);
		Возврат;
	КонецЕсли;

	Закрыть(Новый Структура("Решения, ДляВсех", Решения, ДляВсех));

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

// «Создать сейчас»: форма нового объекта вендора, заполненная данными строки. Форма открывается с этим помощником владельцем и блокирует его
// окно; созданный объект возвращается оповещением формы вендора (контрагент, договор) или поиском по номеру после закрытия (счет).
&НаКлиенте
Процедура СоздатьКонтрагентаСейчас(Команда)

	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполненияНаСервере("Контрагент"));
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияКонтрагента", ЭтотОбъект);
	ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьСчетСейчас(Команда)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполненияНаСервере("СчетКонтрагента"));
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияСчета", ЭтотОбъект, Контрагент);
	ОткрытьФорму("Справочник.БанковскиеСчета.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорСейчас(Команда)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполненияНаСервере("Договор"));
	ПараметрыФормы.Вставить("ОповеститьОЗаписиДоговора", Истина);
	Оповещение = Новый ОписаниеОповещения("ПослеСозданияДоговора", ЭтотОбъект);
	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Форма вендора закрыта: если закрыта с результатом-ссылкой (на случай, когда форма вернула ее), подставляется она; иначе объект уже
// подставило оповещение при записи, а при закрытии без записи ничего не меняется.
&НаКлиенте
Процедура ПослеСозданияКонтрагента(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПодставитьКонтрагента(Результат);
	КонецЕсли;

КонецПроцедуры

// Счет вендорская форма не возвращает ничем надежным (оповещение «УстановкаОсновногоСчета» идет только для единственного счета владельца),
// поэтому после закрытия счет контрагента с номером строки ищется на сервере; не найден (закрыли без записи) - ничего не меняется.
&НаКлиенте
Процедура ПослеСозданияСчета(Результат, Владелец) Экспорт

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
		СчетКонтрагента = Результат;
		Возврат;
	КонецЕсли;
	Найденный = СчетКонтрагентаСтрокиНаСервере(Владелец);
	Если ЗначениеЗаполнено(Найденный) Тогда
		СчетКонтрагента = Найденный;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияДоговора(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Договор = Результат;
	КонецЕсли;

КонецПроцедуры

// Новый контрагент выбран: режим «выбрать существующего», счет и договор прежнего контрагента сбрасываются.
&НаКлиенте
Процедура ПодставитьКонтрагента(НовыйКонтрагент)

	Контрагент = НовыйКонтрагент;
	РежимКонтрагента = "Выбрать";
	СчетКонтрагента = ПредопределенноеЗначение("Справочник.БанковскиеСчета.ПустаяСсылка");
	Договор = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	ОбновитьДоступность();

КонецПроцедуры

// Доступность - показ, а не правило: поля выбора действуют в режиме «выбрать существующего», счет и договор - когда контрагент выбран.
&НаКлиенте
Процедура ОбновитьДоступность()

	РежимВыбора = РежимКонтрагента = "Выбрать";
	РежимНеСоздавать = РежимКонтрагента = "НеСоздавать";
	КонтрагентВыбран = РежимВыбора И ЗначениеЗаполнено(Контрагент);

	Элементы.Контрагент.Доступность = РежимВыбора;
	Элементы.СоздатьКонтрагентаСейчасКнопка.Доступность = Не РежимНеСоздавать;
	Элементы.СчетКонтрагента.Доступность = КонтрагентВыбран;
	Элементы.СоздатьСчетСейчасКнопка.Доступность = КонтрагентВыбран;
	Элементы.Договор.Доступность = КонтрагентВыбран;
	Элементы.СоздатьДоговорСейчасКнопка.Доступность = КонтрагентВыбран;
	Элементы.БанкНовогоСчета.Доступность = Не РежимНеСоздавать;

КонецПроцедуры

&НаСервере
Функция ЗначенияЗаполненияНаСервере(Что)

	Возврат Обработки.СМП_ОбменСБанком.ЗначенияЗаполненияДляСоздания(АдресПлана, ПорядковыйНомер, Что, Контрагент, БанкНовогоСчета);

КонецФункции

&НаСервере
Функция СчетКонтрагентаСтрокиНаСервере(ВладелецСчета)

	Возврат Обработки.СМП_ОбменСБанком.СчетКонтрагентаСтроки(АдресПлана, ПорядковыйНомер, ВладелецСчета);

КонецФункции

#КонецОбласти

&НаСервереБезКонтекста
Функция ЗначениеВМассивПараметраВыбора(Имя, Значение)

	Массив = Новый Массив;
	Массив.Добавить(Новый ПараметрВыбора(Имя, Значение));
	Возврат Массив;

КонецФункции
