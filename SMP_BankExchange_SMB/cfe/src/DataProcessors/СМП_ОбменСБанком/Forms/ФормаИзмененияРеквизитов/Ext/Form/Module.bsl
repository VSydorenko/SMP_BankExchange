#Область ОбработчикиСобытийФормы

// Диалог только собирает решения человека: какие поля менять и на что. Применяет их форма-владелец (серверный вызов
// ПрименитьРешенияЧеловека обработки); учетных правил здесь нет. Доступность полей зависит от вида операции
// (см. ОбновитьДоступностьНаСервере) - это показ, а не правило: правило остается в СМП_РаспознаваниеОпераций.
//
// Параметры формы:
//  КоличествоСтрок - Число - число выбранных строк.
//  ЕстьПоступление, ЕстьСписание - Булево - направления выбранных строк (по суммам проекции).
//  ВидыСтрок - Массив - виды операции выбранных строк (без повторов; пустые пропускаются).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЕстьПоступление = Параметры.ЕстьПоступление;
	ЕстьСписание = Параметры.ЕстьСписание;
	Для Каждого Вид Из Параметры.ВидыСтрок Цикл
		ВидыСтрок.Добавить(Вид);
	КонецЦикла;

	Элементы.Информация.Заголовок = СтрШаблон(НСтр("ru = 'Выбрано строк: %1. Изменятся только отмеченные поля.';
		|uk = 'Обрано рядків: %1. Зміняться лише позначені поля.'"), Параметры.КоличествоСтрок);

	ЗаполнитьСписокВидов();
	ОбновитьДоступностьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИзменитьВидПриИзменении(Элемент)

	ОбновитьДоступностьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)

	ИзменитьВид = ЗначениеЗаполнено(ВидОперации);
	ОбновитьДоступностьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СтатьяДДСПриИзменении(Элемент)

	ИзменитьСтатью = Истина;

КонецПроцедуры

&НаКлиенте
Процедура КорреспонденцияПриИзменении(Элемент)

	ИзменитьКорреспонденцию = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ВидНалогаПриИзменении(Элемент)

	ИзменитьВидНалога = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Результат закрытия - структура решений только по отмеченным полям (имена - как у решений ПрименитьРешенияЧеловека).
// Пустая статья, корреспонденция и вид налога допустимы: решение снимается и значение считается по правилам.
&НаКлиенте
Процедура Применить(Команда)

	Решения = Новый Структура;
	Если ИзменитьВид Тогда
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выберите вид операции или снимите отметку.';
				|uk = 'Оберіть вид операції або зніміть позначку.'"), , "ВидОперации");
			Возврат;
		КонецЕсли;
		Решения.Вставить("ВидОперации", ВидОперации);
	КонецЕсли;
	Если ИзменитьСтатью Тогда
		Решения.Вставить("СтатьяДДС", СтатьяДДС);
	КонецЕсли;
	Если ИзменитьКорреспонденцию Тогда
		Решения.Вставить("Корреспонденция", Корреспонденция);
	КонецЕсли;
	Если ИзменитьВидНалога Тогда
		Решения.Вставить("ВидНалога", ВидНалога);
	КонецЕсли;

	Если Решения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Отметьте хотя бы одно поле для изменения.';
			|uk = 'Позначте хоча б одне поле для зміни.'"));
		Возврат;
	КонецЕсли;

	Закрыть(Решения);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список видов - по направлению выбранных строк; при строках обоих направлений вид не выбирается.
&НаСервере
Процедура ЗаполнитьСписокВидов()

	СписокВидов = Элементы.ВидОперации.СписокВыбора;
	СписокВидов.Очистить();
	Если ЕстьПоступление И Не ЕстьСписание Тогда
		ДобавитьЗначенияПеречисления(СписокВидов, Метаданные.Перечисления.ВидыОперацийПоступлениеНаСчет, Перечисления.ВидыОперацийПоступлениеНаСчет);
	ИначеЕсли ЕстьСписание И Не ЕстьПоступление Тогда
		ДобавитьЗначенияПеречисления(СписокВидов, Метаданные.Перечисления.ВидыОперацийРасходСоСчета, Перечисления.ВидыОперацийРасходСоСчета);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЗначенияПеречисления(СписокВидов, ОбъектМетаданных, МенеджерПеречисления)

	Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
		Значение = МенеджерПеречисления[ЗначениеПеречисления.Имя];
		СписокВидов.Добавить(Значение, Строка(Значение));
	КонецЦикла;

КонецПроцедуры

// Доступность полей и пояснение. Одно обращение к серверу на смену вида; правила (какой вид имеет корреспонденцию) берутся
// из СМП_РаспознаваниеОпераций, на клиенте они не дублируются.
// Вид, по которому судим: выбранный в диалоге (если отмечен), иначе виды выбранных строк.
&НаСервере
Процедура ОбновитьДоступностьНаСервере()

	Пояснения = Новый Массив;

	// Вид операции: строки обоих направлений - вида нет; ни одного направления - тоже (нечем ограничить список).
	ВидДоступен = ЕстьПоступление <> ЕстьСписание;
	Если Не ВидДоступен Тогда
		ИзменитьВид = Ложь;
		ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.ПустаяСсылка();
		Пояснения.Добавить(?(ЕстьПоступление И ЕстьСписание,
			НСтр("ru = 'Выбраны строки поступления и списания: вид операции для них общий выбрать нельзя. Выделите строки одного направления.';
				|uk = 'Вибрано рядки надходження і списання: спільний вид операції для них обрати не можна. Виділіть рядки одного напряму.'"),
			НСтр("ru = 'Направление выбранных строк не определено: вид операции недоступен.';
				|uk = 'Напрям вибраних рядків не визначено: вид операції недоступний.'")));
	КонецЕсли;
	УстановитьДоступностьПары("ИзменитьВид", "ВидОперации", ВидДоступен);

	Виды = Новый Массив;
	Если ИзменитьВид И ЗначениеЗаполнено(ВидОперации) Тогда
		Виды.Добавить(ВидОперации);
	Иначе
		Виды = ВидыСтрок.ВыгрузитьЗначения();
	КонецЕсли;

	ЕстьКорреспонденция = Ложь;
	ЕстьНалоги = Ложь;
	Для Каждого Вид Из Виды Цикл
		Если СМП_РаспознаваниеОпераций.ВидОперацииИмеетКорреспонденцию(Вид) Тогда
			ЕстьКорреспонденция = Истина;
		КонецЕсли;
		Если СМП_РаспознаваниеОпераций.ВидОперацииИмеетВидНалога(Вид) Тогда
			ЕстьНалоги = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьКорреспонденция Тогда
		ИзменитьКорреспонденцию = Ложь;
		Пояснения.Добавить(НСтр("ru = 'Корреспонденция доступна для видов, у которых она есть (например, ""Прочее"", ""На расходы"").';
			|uk = 'Кореспонденція доступна для видів, у яких вона є (наприклад, ""Інше"", ""На витрати"").'"));
	КонецЕсли;
	УстановитьДоступностьПары("ИзменитьКорреспонденцию", "Корреспонденция", ЕстьКорреспонденция);

	Если Не ЕстьНалоги Тогда
		ИзменитьВидНалога = Ложь;
		Пояснения.Добавить(НСтр("ru = 'Вид налога доступен для вида операции ""Налоги"".';
			|uk = 'Вид податку доступний для виду операції ""Податки"".'"));
	КонецЕсли;
	УстановитьДоступностьПары("ИзменитьВидНалога", "ВидНалога", ЕстьНалоги);

	Элементы.Пояснение.Заголовок = СтрСоединить(Пояснения, Символы.ПС);
	Элементы.Пояснение.Видимость = Пояснения.Количество() > 0;

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПары(ИмяФлажка, ИмяПоля, Доступна)

	Элементы[ИмяФлажка].Доступность = Доступна;
	Элементы[ИмяПоля].Доступность = Доступна;

КонецПроцедуры

#КонецОбласти
