// Справочный транспорт API банков: HTTP с прокси БСП (план 05а, задача 3, спека D36 п. 1).
//
// Транспорт - значение, которое платформа кладет в Параметры.Транспорт конектора. Конектор кличет его
// методы поздним связыванием: ВыполнитьЗапрос, Пауза, ТекущийМомент; на тип транспорта он не
// ссылается и поэтому переносим (D27, D29). Транспорт конфигурационный (прокси БСП), воротами
// переносимости не является. В каждой конфигурации у него своя реализация, а тесты передают
// транспорт воспроизведения записи (в тестовом расширении) с теми же методами.
//
// Исключение наружу не выходит: сбой сети или таймаут - ответ с признаком сбоя. Текст сбоя не содержит
// заголовков запроса: в них учетные данные. Предшественника (КоннекторHTTP_BankExchange) транспорт не
// кличет и его форк библиотеки не копирует: от него взято лишь получение прокси из БСП.

// Таймаут соединения и операций, секунды. Не задан - ТаймаутПоУмолчанию().
Перем Таймаут Экспорт;

#Область ПрограммныйИнтерфейс

// Один HTTP-обмен: метод, адрес, заголовки, тело -> статус, заголовки, тело байтами или ответ со сбоем.
//
// Параметры:
//  Метод - Строка - HTTP-метод ("GET" и подобные).
//  Адрес - Строка - полный адрес со схемой, хостом, путем и строкой запроса.
//  Заголовки - Соответствие, Неопределено - заголовки запроса (имя -> значение).
//  Тело - ДвоичныеДанные, Строка, Неопределено - тело запроса.
//
// Возвращаемое значение:
//  Структура - см. СМП_КоннекторыБанковОбщее.НовыйОтветТранспорта.
Функция ВыполнитьЗапрос(Метод, Адрес, Заголовки = Неопределено, Тело = Неопределено) Экспорт

	Результат = СМП_КоннекторыБанковОбщее.НовыйОтветТранспорта();
	ТекстОшибки = "";

	Попытка
		Части = РазобратьАдрес(Адрес);

		Если ТипЗнч(Таймаут) = Тип("Число") И Таймаут > 0 Тогда
			ТаймаутСекунд = Таймаут;
		Иначе
			ТаймаутСекунд = ТаймаутПоУмолчанию();
		КонецЕсли;

		Защищенное = ?(Части.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
		Соединение = Новый HTTPСоединение(Части.Хост, Части.Порт, , , ПроксиПоУмолчанию(Части.Схема), ТаймаутСекунд,
			Защищенное);

		Запрос = Новый HTTPЗапрос(Части.Ресурс);
		Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
			Для Каждого Заголовок Из Заголовки Цикл
				Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
			КонецЦикла;
		КонецЕсли;
		Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
		ИначеЕсли ТипЗнч(Тело) = Тип("Строка") Тогда
			Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;

		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);

		Результат.Статус = Ответ.КодСостояния;
		Для Каждого Заголовок Из Ответ.Заголовки Цикл
			Результат.Заголовки.Вставить(НРег(Заголовок.Ключ), Заголовок.Значение);
		КонецЦикла;
		ТелоОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Если ТелоОтвета <> Неопределено Тогда
			Результат.Тело = ТелоОтвета;
		КонецЕсли;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		Возврат ОтветСоСбоем(ТекстОшибки, Заголовки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пауза между обменами: серверное ожидание без загрузки процессора (см. СМП_ТранспортHTTPСервер.Пауза).
//
// Параметры:
//  Секунды - Число - длительность паузы.
Процедура Пауза(Секунды) Экспорт

	СМП_ТранспортHTTPСервер.Пауза(Секунды);

КонецПроцедуры

// Текущий момент в UTC. Единственный источник времени для конектора: он серверных часов не читает.
//
// Возвращаемое значение:
//  Дата - текущий момент UTC.
Функция ТекущийМомент() Экспорт

	Возврат ТекущаяУниверсальнаяДата();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таймаут по умолчанию, секунды: как у предшественника (КоннекторHTTP_BankExchange.СтандартныйТаймаут).
Функция ТаймаутПоУмолчанию()

	Возврат 30;

КонецФункции

// Ответ со сбоем: Статус 0, вид сбоя и текст без значений заголовков запроса.
Функция ОтветСоСбоем(ТекстОшибки, ЗаголовкиЗапроса)

	Результат = СМП_КоннекторыБанковОбщее.НовыйОтветТранспорта();
	Результат.Сбой = Истина;

	Нижний = НРег(ТекстОшибки);
	Если СтрНайти(Нижний, "timeout") > 0 Или СтрНайти(Нижний, "timed out") > 0 Или СтрНайти(Нижний, "таймаут") > 0
		Или СтрНайти(Нижний, "время ожидания") > 0 Или СтрНайти(Нижний, "час очікування") > 0 Тогда
		Результат.ВидСбоя = "timeout";
	Иначе
		Результат.ВидСбоя = "network";
	КонецЕсли;

	Текст = ТекстОшибки;
	Если ТипЗнч(ЗаголовкиЗапроса) = Тип("Соответствие") Тогда
		Для Каждого Заголовок Из ЗаголовкиЗапроса Цикл
			Если ТипЗнч(Заголовок.Значение) = Тип("Строка") И Не ПустаяСтрока(Заголовок.Значение) Тогда
				Текст = СтрЗаменить(Текст, СокрЛП(Заголовок.Значение), "***");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат.ТекстСбоя = СтрШаблон(
		НСтр("ru = 'Сбой запроса к банку (%1): %2'; uk = 'Збій запиту до банку (%1): %2'"), Результат.ВидСбоя, Текст);
	Возврат Результат;

КонецФункции

// Прокси из БСП, если подсистема «Получение файлов из интернета» есть, иначе системный прокси.
// Как у предшественника, но без разбора адреса библиотекой: нужна только схема.
Функция ПроксиПоУмолчанию(Схема)

	Прокси = Новый ИнтернетПрокси;
	ИмяМодуляБСП = "ПолучениеФайловИзИнтернета";
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуляБСП) <> Неопределено Тогда
		// BSLLS:ExecuteExternalCodeInCommonModule-off
		Модуль = Вычислить(ИмяМодуляБСП);
		// BSLLS:ExecuteExternalCodeInCommonModule-on
		Прокси = Модуль.ПолучитьПрокси(Схема);
	КонецЕсли;
	Возврат Прокси;

КонецФункции

// Адрес -> Схема, Хост, Порт, Ресурс (путь с запросом).
Функция РазобратьАдрес(Адрес)

	Остаток = Адрес;
	Схема = "https";
	Позиция = СтрНайти(Остаток, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + 3);
	КонецЕсли;

	Ресурс = "/";
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция > 0 Тогда
		Ресурс = Сред(Остаток, Позиция);
		Остаток = Лев(Остаток, Позиция - 1);
	Иначе
		Позиция = СтрНайти(Остаток, "?");
		Если Позиция > 0 Тогда
			Ресурс = "/" + Сред(Остаток, Позиция);
			Остаток = Лев(Остаток, Позиция - 1);
		КонецЕсли;
	КонецЕсли;

	Порт = ?(Схема = "https", 443, 80);
	Позиция = СтрНайти(Остаток, ":");
	Если Позиция > 0 Тогда
		Порт = Число(Сред(Остаток, Позиция + 1));
		Остаток = Лев(Остаток, Позиция - 1);
	КонецЕсли;

	Если ПустаяСтрока(Остаток) Тогда
		ВызватьИсключение НСтр("ru = 'В адресе запроса нет хоста.'; uk = 'В адресі запиту немає хоста.'");
	КонецЕсли;

	Возврат Новый Структура("Схема, Хост, Порт, Ресурс", Схема, Остаток, Порт, Ресурс);

КонецФункции

#КонецОбласти
