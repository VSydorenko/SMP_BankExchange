# Шаблон конфігурації рекордера API. У git лежить лише цей шаблон із заглушками.
# Справжня копія з вашими значеннями — ТІЛЬКИ тут (гітігнорована, поза ворктрі):
#   R:\github\SMP_BankExchange\temp\api-recorder\config.psd1
# Її не комітити, нікому не пересилати, не вставляти в чати й листи.
#
# Заглушки мають вигляд <ВПИШІТЬ_...>. Замініть їх (разом з кутовими дужками) на справжнє значення в одинарних лапках.
# Банк, у якого лишилась хоч одна заглушка в обов'язковому полі, рекордер не запускає (пише, що саме не заповнено).
# Не потрібен банк — поставте йому Enabled = $false.
#
# Формат файлу — PowerShell data file: рядки в одинарних лапках, $true/$false без лапок, коментарі після #.
@{
    # ======================================================================================
    # ПриватБанк, «Автоклієнт»
    # ======================================================================================
    Privat = @{
        Enabled  = $true

        # Ідентифікатор застосунку «Інтеграція (Автоклієнт)». Де взяти: Приват24 для бізнесу / Автоклієнт ->
        # підключити застосунок «Інтеграція (Автоклієнт)» -> налаштування створеного застосунку API ->
        # кнопка «ID i Token». Формат: короткий рядок із цифр і літер (як у кабінеті).
        ClientId = '<ВПИШІТЬ_ІДЕНТИФІКАТОР_АВТОКЛІЄНТА>'

        # Токен того самого застосунку (там само, «ID i Token» або піктограма біля слова token).
        # Формат: довгий рядок із літер і цифр. Якщо ви обмежували сервіси API — залиште доступним
        # розділ «Виписки» (баланси й транзакції).
        Token    = '<ВПИШІТЬ_ТОКЕН_АВТОКЛІЄНТА>'

        # Рахунки: повні IBAN (UA + 27 цифр), по одному в лапках через кому. Для кожного рахунку
        # рекордер зробить повний набір сценаріїв. Для першого пробного прогону вистачить одного.
        Accounts = @(
            '<ВПИШІТЬ_IBAN_РАХУНКУ_UA...>'
        )

        # Основний період сценаріїв: РРРР-ММ-ДД, обидві дати включно, закінчується до сьогоднішнього дня.
        # Оберіть період із кількома десятками операцій; навіть краще, щоб на якусь добу їх було більше,
        # ніж розмір сторінки (SmallLimit).
        Period = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Період, у якому банк скасовував або повертав операцію (сторно, повернення).
        # Не пам'ятаєте — залиште заглушки або порожні рядки: сценарій буде пропущено, вигадувати нічого не треба.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        SmallLimit    = 5     # малий limit, щоб побачити кілька сторінок (документація: за замовчуванням 20)
        WorkLimit     = 100   # робочий limit (документація: рекомендовано не більше 100)
        MaxPages      = 100   # запобіжник: скільки сторінок читати в одному сценарії
        MaxSmallPages = 40    # запобіжник для малого limit

        # Які сценарії вмикати ($false — вимкнути). Усі лише читають.
        Scenarios = @{
            Settings            = $true   # /settings: серверні дати, фаза, регламент
            Balances            = $true   # баланси за період
            BalanceInterimFinal = $true   # баланси: проміжні й підсумкові
            TxSmallLimit        = $true   # транзакції за період, малий limit, усі сторінки (до MaxSmallPages)
            TxWorkLimit         = $true   # транзакції за період, робочий limit
            TxDefaultLimit      = $true   # транзакції без limit (банк дає 20 на сторінку)
            TxNoEndDate         = $true   # запит без endDate (startDate = початок періоду)
            TxFullIban          = $true   # acc повним IBAN (основні сценарії йдуть з 14 останніми цифрами, як у попередника)
            TxInterim           = $true   # проміжна виписка
            TxFinal             = $true   # підсумкова виписка
            TxCp1251            = $true   # той самий запит із Content-Type charset=cp1251
            Reversal            = $true   # період зі скасуванням/поверненням (лише якщо ReversalPeriod заповнений)
            Errors              = $true   # свідомі помилки: вигаданий токен, startDate > endDate, майбутній період, чужий рахунок
        }
    }

    # ======================================================================================
    # monobank для юридичних осіб (corp-api.monobank.ua)
    # ======================================================================================
    MonoCorp = @{
        Enabled  = $true

        # Токен: web.monobank.ua -> вхід у кабінет -> обрати компанію -> «Токени» (web.monobank.ua/?modal=tokens)
        # -> створити токен для персонального використання. Формат: довгий рядок. Токен діє для обраної компанії.
        Token    = '<ВПИШІТЬ_ТОКЕН_КАБІНЕТУ_MONOBANK_ЮРОСІБ>'

        # Рахунки: повні IBAN (UA + 27 цифр).
        Accounts = @(
            '<ВПИШІТЬ_IBAN_РАХУНКУ_UA...>'
        )

        # Основний період: РРРР-ММ-ДД, обидві дати включно, до сьогоднішнього дня. Добові вікна — по запиту на кожну добу
        # періоду, тож не робіть його надто довгим (до 31 доби).
        Period = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Період із реверсом / скасованою (DECLINED) операцією; не пам'ятаєте — залиште заглушки.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        SmallLimit    = 10    # малий limit (документація: за замовчуванням 10, максимум 500)
        MaxPages      = 200   # запобіжник для limit=500
        MaxSmallPages = 60    # запобіжник для малого limit

        Scenarios = @{
            Accounts            = $true   # список рахунків
            Balances            = $true   # баланси з isFinal за період
            StatementLimit500   = $true   # виписка, limit=500, сторінки зсувом верхньої межі
            StatementSmallLimit = $true   # те саме з малим limit
            StatementOrder      = $true   # порядок: без direction, UP, DOWN (по одній сторінці в 5 операцій)
            DailyWindows        = $true   # запит на кожну добу окремо — еталон повноти
            Reversal            = $true   # період зі скасуванням/поверненням (лише якщо ReversalPeriod заповнений)
            Errors              = $true   # свідомі помилки (вигаданий токен, from > to, майбутній період, чужий рахунок)
        }
    }

    # ======================================================================================
    # monobank ФОП (персональне API, api.monobank.ua)
    # УВАГА: банк дозволяє запит виписки не частіше ніж раз на 60 секунд, тому цей прогін повільний
    # (рекордер чекає 61 с між запитами). Орієнтир: див. dry-run (рядок про сумарні паузи).
    # ======================================================================================
    MonoFop = @{
        Enabled = $true

        # Особистий токен: api.monobank.ua -> «Отримати токен» (вхід через застосунок monobank).
        # Формат: рядок із літер і цифр. Токен належить власнику ФОП-рахунку.
        Token   = '<ВПИШІТЬ_ОСОБИСТИЙ_ТОКЕН_MONOBANK_ФОП>'

        # IBAN рахунку ФОП (UA + 27 цифр). Ідентифікатор рахунку рекордер візьме з client-info сам.
        Iban    = '<ВПИШІТЬ_IBAN_РАХУНКУ_ФОП_UA...>'

        # Основний період: РРРР-ММ-ДД, до сьогоднішнього дня. Рекордер ріже його на відрізки по 31 добі
        # (ліміт банку), кожен відрізок — окремий запит із паузою 61 с.
        Period  = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Насичений період (багато операцій; найкраще кілька сотень за 31 добу), щоб побачити,
        # скільки операцій банк віддає за один запит. Не маєте такого — залиште заглушки.
        SaturatedPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        # НЕОБОВ'ЯЗКОВО. Період із поверненням / скасованою операцією; не пам'ятаєте — залиште заглушки.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        ContinueAtLeast    = 100   # якщо сторінка має щонайменше стільки операцій, питаємо наступну (зсув межі)
        MaxPagesPerSegment = 20    # запобіжник на відрізок

        Scenarios = @{
            ClientInfoThenStatement = $true   # client-info і ОДРАЗУ виписка (без паузи): чи дає банк 429 (один запит, свідомо)
            StatementSegments       = $true   # виписка за період відрізками ≤ 31 доби
            Saturated               = $true   # насичений період (лише якщо SaturatedPeriod заповнений)
            Reversal                = $true   # період із поверненням (лише якщо ReversalPeriod заповнений)
            Errors                  = $true   # свідомі помилки (вигаданий токен, from > to, майбутній період, чужий рахунок)
        }
    }
}
