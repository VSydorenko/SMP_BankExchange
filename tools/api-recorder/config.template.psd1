# Шаблон конфігурації рекордера API. У git лежить лише цей шаблон із заглушками.
# Справжня копія з вашими значеннями — ТІЛЬКИ тут (гітігнорована, поза ворктрі):
#   R:\github\SMP_BankExchange\temp\api-recorder\config.psd1
# Її не комітити, нікому не пересилати, не вставляти в чати й листи.
#
# Заглушки мають вигляд <ВПИШІТЬ_...>. Замініть їх (разом з кутовими дужками) на справжнє значення в одинарних лапках.
# Банк, у якого лишилась хоч одна заглушка в обов'язковому полі, рекордер не запускає (пише, що саме не заповнено).
# Не потрібен банк — поставте йому Enabled = $false.
#
# Формат файлу — PowerShell data file: рядки в одинарних лапках, $true/$false без лапок, коментарі після #.
@{
    # ======================================================================================
    # ПриватБанк, «Автоклієнт»
    # ======================================================================================
    Privat = @{
        Enabled  = $true

        # Ідентифікатор застосунку «Інтеграція (Автоклієнт)». Де взяти: Приват24 для бізнесу / Автоклієнт ->
        # підключити застосунок «Інтеграція (Автоклієнт)» -> налаштування створеного застосунку API ->
        # кнопка «ID i Token». Формат: короткий рядок із цифр і літер (як у кабінеті).
        ClientId = '<ВПИШІТЬ_ІДЕНТИФІКАТОР_АВТОКЛІЄНТА>'

        # Токен того самого застосунку (там само, «ID i Token» або піктограма біля слова token).
        # Формат: довгий рядок із літер і цифр. Якщо ви обмежували сервіси API — залиште доступним
        # розділ «Виписки» (баланси й транзакції).
        Token    = '<ВПИШІТЬ_ТОКЕН_АВТОКЛІЄНТА>'

        # Рахунки: повні IBAN (UA + 27 цифр), по одному в лапках через кому. Для кожного рахунку
        # рекордер зробить повний набір сценаріїв. Для першого пробного прогону вистачить одного.
        Accounts = @(
            '<ВПИШІТЬ_IBAN_РАХУНКУ_UA...>'
        )

        # Основний період сценаріїв: РРРР-ММ-ДД, обидві дати включно, закінчується до сьогоднішнього дня.
        # Оберіть період із кількома десятками операцій; навіть краще, щоб на якусь добу їх було більше,
        # ніж розмір сторінки (SmallLimit).
        Period = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Період, у якому банк скасовував або повертав операцію (сторно, повернення).
        # Не пам'ятаєте — залиште заглушки або порожні рядки: сценарій буде пропущено, вигадувати нічого не треба.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        SmallLimit    = 5     # малий limit, щоб побачити кілька сторінок (документація: за замовчуванням 20)
        WorkLimit     = 100   # робочий limit (документація: рекомендовано не більше 100)
        MaxPages      = 100   # запобіжник: скільки сторінок читати в одному сценарії
        MaxSmallPages = 40    # запобіжник для малого limit

        # Які сценарії вмикати ($false — вимкнути). Усі лише читають.
        Scenarios = @{
            Settings            = $true   # /settings: серверні дати, фаза, регламент
            Balances            = $true   # баланси за період
            BalanceInterimFinal = $true   # баланси: проміжні й підсумкові
            TxSmallLimit        = $true   # транзакції за період, малий limit, усі сторінки (до MaxSmallPages)
            TxWorkLimit         = $true   # транзакції за період, робочий limit
            TxDefaultLimit      = $true   # транзакції без limit (банк дає 20 на сторінку)
            TxNoEndDate         = $true   # запит без endDate (startDate = початок періоду)
            TxFullIban          = $true   # acc повним IBAN (основні сценарії йдуть з 14 останніми цифрами, як у попередника)
            TxInterim           = $true   # проміжна виписка
            TxFinal             = $true   # підсумкова виписка
            TxCp1251            = $true   # той самий запит із Content-Type charset=cp1251
            Reversal            = $true   # період зі скасуванням/поверненням (лише якщо ReversalPeriod заповнений)
            Errors              = $true   # свідомі помилки: вигаданий токен, startDate > endDate, майбутній період, чужий рахунок
            DatKlBoundary       = $false  # run3: рекордер сам обирає операцію з днем DAT_KL відмінним від DAT_OD і запитує її день; значень не вписувати; $true — увімкнути
        }
    }

    # ======================================================================================
    # monobank для юридичних осіб (corp-api.monobank.ua)
    # ======================================================================================
    MonoCorp = @{
        Enabled  = $true

        # Токен: web.monobank.ua -> вхід у кабінет -> обрати компанію -> «Токени» (web.monobank.ua/?modal=tokens)
        # -> створити токен для персонального використання. Формат: довгий рядок. Токен діє для обраної компанії.
        Token    = '<ВПИШІТЬ_ТОКЕН_КАБІНЕТУ_MONOBANK_ЮРОСІБ>'

        # Рахунки: повні IBAN (UA + 27 цифр).
        Accounts = @(
            '<ВПИШІТЬ_IBAN_РАХУНКУ_UA...>'
        )

        # Основний період: РРРР-ММ-ДД, обидві дати включно, до сьогоднішнього дня. Добові вікна — по запиту на кожну добу
        # періоду, тож не робіть його надто довгим (до 31 доби).
        Period = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Період із реверсом / скасованою (DECLINED) операцією; не пам'ятаєте — залиште заглушки.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        # НЕОБОВ'ЯЗКОВО (для другого прогону). Найдовший період з найбільшою кількістю операцій на рахунку: рекордер читає його
        # з limit=500 (продовження з to = найраніша time + 1), доки сторінка повна, — так видно максимум, який банк віддає за раз. Немає блоку або заглушки — сценарій
        # вимкнено (це не помилка). Щоб увімкнути, впишіть період тут і додайте Saturated = $true у Scenarios нижче.
        SaturatedPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        SmallLimit    = 10    # малий limit (документація: за замовчуванням 10, максимум 500)
        MaxPages      = 200   # запобіжник для limit=500
        MaxSmallPages = 60    # запобіжник для малого limit

        Scenarios = @{
            Accounts            = $true   # список рахунків
            Balances            = $true   # баланси з isFinal за період
            StatementLimit500   = $true   # виписка, limit=500, сторінки зсувом верхньої межі
            StatementSmallLimit = $true   # те саме з малим limit
            StatementSmallLimitOverlap = $false  # run3: той самий період і малий limit, але продовження з to = найраніша time + 1 (D36 п. 11); $true — увімкнути
            StatementOrder      = $true   # порядок: без direction, UP, DOWN (по одній сторінці в 5 операцій)
            Saturated           = $false  # насичений період (SaturatedPeriod), limit=500 до неповної сторінки, продовження з to = найраніша time + 1 (D36 п. 11), запобіжник stuck_cursor; $true — увімкнути
            BoundaryPairs       = $false  # run3: вимір включності меж from/to — рекордер сам обирає операцію й робить 4 запити (values не вписувати); $true — увімкнути
            DailyWindows        = $true   # запит на кожну добу окремо — еталон повноти
            Reversal            = $true   # період зі скасуванням/поверненням (лише якщо ReversalPeriod заповнений)
            Errors              = $true   # свідомі помилки (вигаданий токен, from > to, майбутній період, чужий рахунок)
        }
    }

    # ======================================================================================
    # monobank ФОП (персональне API, api.monobank.ua)
    # УВАГА: банк дозволяє запит виписки не частіше ніж раз на 60 секунд, тому цей прогін повільний
    # (рекордер чекає 61 с між запитами). Орієнтир: див. dry-run (рядок про сумарні паузи).
    # ======================================================================================
    MonoFop = @{
        Enabled = $true

        # Особистий токен: api.monobank.ua -> «Отримати токен» (вхід через застосунок monobank).
        # Формат: рядок із літер і цифр. Токен належить власнику ФОП-рахунку.
        Token   = '<ВПИШІТЬ_ОСОБИСТИЙ_ТОКЕН_MONOBANK_ФОП>'

        # IBAN рахунку ФОП (UA + 27 цифр). Ідентифікатор рахунку рекордер візьме з client-info сам.
        Iban    = '<ВПИШІТЬ_IBAN_РАХУНКУ_ФОП_UA...>'

        # Основний період: РРРР-ММ-ДД, до сьогоднішнього дня. Рекордер ріже його на відрізки по 31 добі
        # (ліміт банку), кожен відрізок — окремий запит із паузою 61 с.
        Period  = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Насичений період (багато операцій; найкраще кілька сотень за 31 добу), щоб побачити,
        # скільки операцій банк віддає за один запит. Не маєте такого — залиште заглушки (сценарій буде пропущено
        # з рядком у summary-agent.txt). Використовується сценаріями Saturated і SaturatedOverlap.
        SaturatedPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        # НЕОБОВ'ЯЗКОВО. Період із поверненням / скасованою операцією; не пам'ятаєте — залиште заглушки.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        ContinueAtLeast    = 100   # якщо сторінка має щонайменше стільки операцій, питаємо наступну (зсув межі)
        MaxPagesPerSegment = 20    # запобіжник на відрізок
        MaxSaturatedPages  = 40    # запобіжник для SaturatedOverlap: скільки сторінок (запитів по 61 с) читати в сумі

        Scenarios = @{
            ClientInfoThenStatement = $true   # client-info і ОДРАЗУ виписка (без паузи): чи дає банк 429 (один запит, свідомо)
            StatementSegments       = $true   # виписка за період відрізками ≤ 31 доби
            Saturated               = $true   # насичений період (лише якщо SaturatedPeriod заповнений): читає, доки сторінка непорожня
            SaturatedOverlap        = $false  # run3: насичений період до неповної сторінки (< 500), продовження з to = найраніша time + 1, пауза 61 с; $true — увімкнути
            BoundaryPairs           = $false  # run3: вимір включності меж from/to — рекордер сам обирає операцію й робить 4 запити (значень не вписувати); $true — увімкнути
            Reversal                = $true   # період із поверненням (лише якщо ReversalPeriod заповнений)
            Errors                  = $true   # свідомі помилки (вигаданий токен, from > to, майбутній період, чужий рахунок)
        }
    }

    # ======================================================================================
    # ПУМБ (Vega/VegaNet): токен — auth.fuib.com (password grant), API — service.fuib.com:4103.
    # Запускається ЛИШЕ явно: -Bank pumb (у 'all' ПУМБ не входить). Лише читання: форма на токен-ендпоінт,
    # GET /account, POST /document/searcher, POST /document/period-transactions; платіжні методи рекордер відхиляє.
    # Тіло запиту автентифікації (пароль, секрет) у запис не потрапляє; відповідь автентифікації замасковано.
    # ======================================================================================
    Pumb = @{
        Enabled = $true

        # КЛЮЧ «ВХІД ПОГОДЖЕНО». ЗА ЗАМОВЧУВАННЯМ ВИМКНЕНО — з $false рекордер до банку не звертається (код 2).
        # Виставляє ЛИШЕ власник, коли відповів на питання «чи не заважає вхід рекордера (password grant) робочій інтеграції ПУМБ
        # і чи витримує ліміт сесій» (README, розділ «Перед першим запуском»). Агент і скрипти цього ключа не вмикають.
        LoginApproved = $false

        # client_id і client_secret — із файлу налаштувань, який видав банк (settings.txt, тека «ПУМБ / PUMB_API»); значення переписуйте як є.
        ClientId     = '<ВПИШІТЬ_CLIENT_ID_ПУМБ>'
        ClientSecret = '<ВПИШІТЬ_CLIENT_SECRET_ПУМБ>'

        # Логін і пароль користувача інтернет-клієнт-банку ПУМБ (той самий, під яким працює інтеграція). Пароль — лише тут.
        Login    = '<ВПИШІТЬ_ЛОГІН_ІКБ_ПУМБ>'
        Password = '<ВПИШІТЬ_ПАРОЛЬ_ІКБ_ПУМБ>'

        # Рахунки. РЕКОМЕНДОВАНО, коли не знаєте, які рахунки є:  Accounts = 'all'  — рекордер сам візьме всі рахунки з відповіді /account
        # (гривневі й валютні; для валютного додається запит із типом документа CUR) і проганяє для кожного ті самі сценарії.
        # У консоль і summary-agent.txt IBAN, accountId і назви рахунків не потрапляють — лише кількості й валюта.
        # Інакше — повні IBAN (UA + 27 цифр), по одному в лапках; accountId рекордер знайде за IBAN у відповіді /account.
        Accounts = @(
            '<ВПИШІТЬ_IBAN_РАХУНКУ_UA...>'
        )
        # Лише для Accounts = 'all': запобіжник — скільки рахунків узяти (перші за порядком відповіді банку). За замовчуванням 10.
        # ПУМБ: у /account було 14 рахунків (11 IBAN), а їхній порядок між прогонами різний — з 10 різні прогони брали різні набори; тому 14.
        MaxAccounts = 14

        # Основний період: РРРР-ММ-ДД, обидві дати включно, закінчується до сьогоднішнього дня.
        # Бажано період, де операцій більше за SmallPageSize (щоб було кілька сторінок) і є і вхідні, і вихідні.
        Period = @{ From = '<РРРР-ММ-ДД>'; To = '<РРРР-ММ-ДД>' }

        # НЕОБОВ'ЯЗКОВО. Найдовший період із найбільшою кількістю операцій (стеля рядків, обмеження періоду). Немає — залиште заглушки.
        SaturatedPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        # НЕОБОВ'ЯЗКОВО. Період, у якому була скасована/повернена операція. Не пам'ятаєте — залиште заглушки.
        ReversalPeriod = @{ From = '<РРРР-ММ-ДД або порожньо>'; To = '<РРРР-ММ-ДД або порожньо>' }

        SmallPageSize     = 5    # малий pageSize, щоб побачити кілька сторінок
        WorkPageSize      = 100  # робочий pageSize
        MaxPages          = 60   # запобіжник: скільки сторінок читати в одному сценарії
        MaxSaturatedPages = 40   # запобіжник для насиченого періоду

        # run2: читання рівно у формі конектора (searcher без pagingRequest і без фільтрів, межі запиту — цілі календарні доби: початок 00:00:00 … Мин(кінець, момент) 23:59:59,
        # X-Flow-ID у форматі GUID:GUID:EX). Відповідь не менше порога — період ділиться навпіл за добами, як у конектора.
        ConnectorThreshold   = 1191  # поріг ділення (= ПорогОтвета() конектора; найбільша спостережена відповідь, run2)
        ConnectorMaxRequests = 200   # запобіжник: скільки запитів у одному читанні connector_read
        LongestPeriodDays    = 366   # довжина найдовшого періоду (діб, у кінець основного періоду), один запит без ділення

        Scenarios = @{
            SearcherSmall      = $true   # searcher: PROCESSED + UAH, малий pageSize, усі сторінки (продовження за orderedLastId)
            SearcherWork       = $true   # searcher: те саме з робочим pageSize
            SearcherNoPaging   = $true   # searcher без pagingRequest: скільки віддає за раз і чи є ознака «є ще»
            StatesAll          = $true   # searcher без фільтра станів: розподіл state і direction
            TypesNone          = $true   # searcher без фільтра типів
            TypesCurrency      = $true   # searcher з типом CUR — лише для рахунку, чия валюта не UAH
            PagingProbes       = $true   # по одному запиту на форму pagingRequest: orderedLastId/orderedLastValue/sortField/direction/pagingSessionId
            DateFormats        = $true   # інші формати дат запиту (dd.MM.yyyy; ISO із T; ISO лише дата)
            PeriodTransactions = $true   # period-transactions за той самий період — порівняння з searcher (Р4)
            Saturated          = $true   # насичений період (лише якщо SaturatedPeriod заповнений)
            Reversal           = $true   # період із поверненням (лише якщо ReversalPeriod заповнений)
            BoundaryPairs      = $false  # run3: включність меж fromDate/toDate — рекордер сам обирає операцію й робить 4 запити; $true — увімкнути
            Errors             = $true   # свідомі помилки: вигаданий токен, ВИГАДАНІ логін/пароль/секрет (не справжній логін), from > to, майбутній період, чужий рахунок, тіло не JSON

            # --- run2 (читання у формі конектора; усі лише читають; нижче ConnectorRead залежать LongestPeriod, Reconcile, StmSigns, ConnectorBoundary) ---
            ConnectorRead      = $true   # connector_read: для кожного рахунку, тіло й заголовки як у конектора, ділення навпіл при відповіді >= ConnectorThreshold
            XFlowProbe         = $true   # xflow_probe: перший запит connector_read із X-Flow-ID попередника (5:6:EX) — порівняння, чи банк приймає обидві форми
            ConnectorBoundary  = $false  # секундна семантика не потрібна: банк фільтрує цілими добами (run2, вимір); зонд лишено для довідки: boundary_pairs, fromDate = t і t + 1, toDate = t і t - 1
            LongestPeriod      = $true   # longest_period: один запит конектора на LongestPeriodDays діб для найактивнішого рахунку; у зведенні лише кількість документів
            StmSigns           = $true   # ознаки STM(d) - STM(d-1) проти чистого руху дня (лише кількості), по рахунку й для найдовшого періоду
            Reconcile          = $true   # reconcile.txt для власника: найактивніший рахунок, UAH/CUR/STM окремо, кількість і сума вхідних і вихідних (суми лише в owner-only)
        }
    }
}
